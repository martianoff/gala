package test

import (
    "os"
    "slices"
    "time"
)

// T is the test context, similar to Go's *testing.T.
// It tracks test state and provides assertion and logging methods.
type T struct {
    name     string
    failed   bool
    skipped  bool
}

// newT creates a new test context with the given name.
func newT(name string) T {
    return T(name = name, failed = false, skipped = false)
}

// Name returns the name of the test.
func (t T) Name() string = t.name

// Failed returns whether the test has failed.
func (t T) Failed() bool = t.failed

// Skipped returns whether the test was skipped.
func (t T) Skipped() bool = t.skipped

// Fail marks the test as failed.
func (t T) Fail() T {
    return T(name = t.name, failed = true, skipped = t.skipped)
}

// Skip marks the test as skipped.
func (t T) Skip() T {
    return T(name = t.name, failed = t.failed, skipped = true)
}

// Log prints a message to the test output.
func (t T) Log(msg string) {
    Println(s"    ${msg}")
}

// Error logs an error message and marks the test as failed.
func (t T) Error(msg string) T {
    Println(s"    ERROR: ${msg}")
    return T(name = t.name, failed = true, skipped = t.skipped)
}

// Fatal logs an error message, marks the test as failed, and stops execution.
func (t T) Fatal(msg string) {
    Println(s"    FATAL: ${msg}")
    go_builtins.Panic(s"Test ${t.name} fatal error: ${msg}")
}

// Run runs a subtest with the given name and function.
// This enables table-driven testing patterns.
// Panics in subtests are recovered and reported as failures.
func (t T) Run(name string, f func(T) T) T =
    if (runFramed(newT(t.name + "/" + name), f).failed) t.Fail() else t

// runFramed runs f as the test t between its "=== RUN" line and its result
// line, and returns its result.
func runFramed(t T, f func(T) T) T {
    frame(s"=== RUN   ${t.name}")
    val start = time.Now()
    val result = runTest(t, f)
    val status = if (result.failed) "FAIL" else if (result.skipped) "SKIP" else "PASS"
    frame(f"--- ${status}: ${t.name} (${time.Since(start).Seconds()}%.3fs)")
    result
}

// frame prints a framing line (=== RUN, --- PASS/FAIL/SKIP, the final
// PASS/FAIL), led by framing.
func frame(line string) {
    Println(framing + line)
}

// framing is ^V when the binary's output goes to test2json, and "" otherwise.
// test2json takes a ^V as the start of a framing line even mid-line, where a
// test's unterminated output puts it; Go's testing package marks its framing
// the same way. `go test -json` passes -test.v=test2json, as it does to any
// test binary; `gala test` runs a package-main root's test binary with
// GALA_TEST_FRAMING=test2json instead, which leaves the tests' own os.Args as
// they were. The variable is read, and cleared, first, whichever asks.
val framing = if (framingEnv() || slices.Contains(os.Args, "-test.v=test2json")) "\x16" else ""

// framingEnv reports whether GALA_TEST_FRAMING asks for test2json framing,
// and clears it, so a process a test starts does not inherit it. The init of
// a package that initializes before this one still sees it.
func framingEnv() bool {
    val on = os.Getenv(framingEnvVar) == "test2json"
    os.Unsetenv(framingEnvVar)
    on
}

val framingEnvVar = "GALA_TEST_FRAMING"

// runTest runs a test function with panic recovery.
// If the function panics, the panic is caught and reported as a test failure.
func runTest(t T, f func(T) T) T {
    val result = Try[T](() => f(t))
    return result match {
        case Success(v) => v
        case Failure(e) => t.Error(s"PANIC: $e")
    }
}

// ============================================================================
// Test Runner
// ============================================================================

// TestFunc represents a test function that takes a T.
type TestFunc struct {
    Name string
    F    func(T) T
}

// Run executes the test function and returns the result.
func (tf TestFunc) Run() T = runFramed(newT(tf.Name), tf.F)

// RunTests runs all provided test functions and exits with appropriate code.
// This is the main entry point for running tests.
func RunTests(tests ...TestFunc) {
    var passed = 0
    var failed = 0
    var skipped = 0

    Println("=== STARTING TESTS ===")
    for i := 0; i < tests.Size(); i++ {
        val test = tests[i]
        val result = test.Run()
        if result.failed {
            failed++
        } else if result.skipped {
            skipped++
        } else {
            passed++
        }
    }

    Println()
    Println("=== RESULTS ===")
    Println(s"Passed: ${passed}, Failed: ${failed}, Skipped: ${skipped}")

    if failed > 0 {
        frame("FAIL")
        os.Exit(1)
    }
    frame("PASS")
}
