package main

import (
    . "martianoff/gala/test"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
)

// Basic operations tests
func TestHashSetEmpty(t T) T {
    val s = EmptyHashSet[int]()
    val t1 = IsTrue(t, s.IsEmpty())
    val t2 = IsFalse(t1, s.NonEmpty())
    return Eq[int](t2, s.Size(), 0)
}

func TestHashSetOf(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    val t1 = IsFalse(t, s.IsEmpty())
    val t2 = IsTrue(t1, s.NonEmpty())
    return Eq[int](t2, s.Size(), 5)
}

func TestHashSetContains(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    return RunCases[int, bool](t,
        (sub T, input int, expected bool) => Eq(sub, s.Contains(input), expected),
        Case[int, bool](Name = "contains 1", Input = 1, Expected = true),
        Case[int, bool](Name = "contains 3", Input = 3, Expected = true),
        Case[int, bool](Name = "contains 5", Input = 5, Expected = true),
        Case[int, bool](Name = "not contains 0", Input = 0, Expected = false),
        Case[int, bool](Name = "not contains 6", Input = 6, Expected = false),
    )
}

func TestHashSetAdd(t T) T {
    val s = EmptyHashSet[int]()
    val s1 = s.Add(1)
    val s2 = s1.Add(2)
    val s3 = s2.Add(3)

    val t1 = Eq[int](t, s.Size(), 0)
    val t2 = Eq[int](t1, s1.Size(), 1)
    val t3 = Eq[int](t2, s2.Size(), 2)
    val t4 = Eq[int](t3, s3.Size(), 3)
    val t5 = IsTrue(t4, s3.Contains(1))
    val t6 = IsTrue(t5, s3.Contains(2))
    return IsTrue(t6, s3.Contains(3))
}

func TestHashSetAddDuplicate(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val s2 = s.Add(2)
    return Eq[int](t, s2.Size(), 3)
}

func TestHashSetRemove(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    val s2 = s.Remove(3)

    val t1 = Eq[int](t, s2.Size(), 4)
    val t2 = IsFalse(t1, s2.Contains(3))
    val t3 = IsTrue(t2, s2.Contains(1))
    return IsTrue(t3, s2.Contains(5))
}

func TestHashSetRemoveNonExistent(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val s2 = s.Remove(5)
    return Eq[int](t, s2.Size(), 3)
}

// Set operations tests
func TestHashSetUnion(t T) T {
    val s1 = HashSetOf[int](1, 2, 3)
    val s2 = HashSetOf[int](3, 4, 5)
    val union = s1.Union(s2)

    val t1 = Eq[int](t, union.Size(), 5)
    val t2 = IsTrue(t1, union.Contains(1))
    val t3 = IsTrue(t2, union.Contains(3))
    return IsTrue(t3, union.Contains(5))
}

func TestHashSetIntersect(t T) T {
    val s1 = HashSetOf[int](1, 2, 3, 4)
    val s2 = HashSetOf[int](3, 4, 5, 6)
    val intersect = s1.Intersect(s2)

    val t1 = Eq[int](t, intersect.Size(), 2)
    val t2 = IsTrue(t1, intersect.Contains(3))
    return IsTrue(t2, intersect.Contains(4))
}

func TestHashSetDiff(t T) T {
    val s1 = HashSetOf[int](1, 2, 3, 4)
    val s2 = HashSetOf[int](3, 4, 5, 6)
    val diff = s1.Diff(s2)

    val t1 = Eq[int](t, diff.Size(), 2)
    val t2 = IsTrue(t1, diff.Contains(1))
    val t3 = IsTrue(t2, diff.Contains(2))
    val t4 = IsFalse(t3, diff.Contains(3))
    return IsFalse(t4, diff.Contains(4))
}

func TestHashSetSubsetOf(t T) T {
    val s1 = HashSetOf[int](1, 2, 3)
    val s2 = HashSetOf[int](1, 2, 3, 4, 5)
    val s3 = HashSetOf[int](1, 2, 6)

    val t1 = IsTrue(t, s1.SubsetOf(s2))
    return IsFalse(t1, s3.SubsetOf(s2))
}

// Transformation tests
func TestHashSetFilter(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5, 6)
    val even = s.Filter((x) => x % 2 == 0)

    val t1 = Eq[int](t, even.Size(), 3)
    val t2 = IsTrue(t1, even.Contains(2))
    val t3 = IsTrue(t2, even.Contains(4))
    val t4 = IsTrue(t3, even.Contains(6))
    return IsFalse(t4, even.Contains(1))
}

func TestHashSetMap(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val doubled = MapHashSet[int, int](s, (x) => x * 2)

    val t1 = Eq[int](t, doubled.Size(), 3)
    val t2 = IsTrue(t1, doubled.Contains(2))
    val t3 = IsTrue(t2, doubled.Contains(4))
    return IsTrue(t3, doubled.Contains(6))
}

func TestHashSetFoldLeft(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    val sum = s.FoldLeft(0, (acc, x) => acc + x)
    return Eq[int](t, sum, 15)
}

// Predicate tests
func TestHashSetExists(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    val t1 = IsTrue(t, s.Exists((x) => x > 4))
    return IsFalse(t1, s.Exists((x) => x > 5))
}

func TestHashSetForAll(t T) T {
    val s = HashSetOf[int](2, 4, 6, 8)
    val t1 = IsTrue(t, s.ForAll((x) => x % 2 == 0))
    return IsFalse(t1, s.ForAll((x) => x < 5))
}

func TestHashSetCount(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5, 6)
    return Eq[int](t, s.Count((x) => x > 3), 3)
}

func TestHashSetFind(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    val found = s.Find((x) => x > 3)
    return IsSome(t, found)
}

// Conversion tests
func TestHashSetToGoSlice(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val slice = s.ToGoSlice()
    return Eq[int](t, slice.Size(), 3)
}

func TestHashSetToList(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val list = s.ToList()
    return Eq[int](t, list.Size(), 3)
}

func TestHashSetToArray(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val arr = s.ToArray()
    return Eq[int](t, arr.Size(), 3)
}

func TestHashSetCollect(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    // Collect even numbers doubled
    val result = s.Collect((x) => {
        if x % 2 == 0 {
            return Some(x * 2)
        }
        return None[int]()
    })
    // Should have 2 elements (2*2=4, 4*2=8)
    return Eq[int](t, result.Size(), 2)
}

// String tests
func TestHashSetStrings(t T) T {
    val s = HashSetOf[string]("apple", "banana", "cherry")
    val t1 = Eq[int](t, s.Size(), 3)
    val t2 = IsTrue(t1, s.Contains("apple"))
    val t3 = IsTrue(t2, s.Contains("banana"))
    return IsTrue(t3, s.Contains("cherry"))
}

// Large set test
func TestHashSetLarge(t T) T {
    var s = EmptyHashSet[int]()
    for i := 0; i < 1000; i++ {
        s = s.Add(i)
    }
    val t1 = Eq[int](t, s.Size(), 1000)
    val t2 = IsTrue(t1, s.Contains(0))
    val t3 = IsTrue(t2, s.Contains(500))
    return IsTrue(t3, s.Contains(999))
}

// Head and HeadOption tests
func TestHashSetHead(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val head = s.Head()
    return IsTrue(t, s.Contains(head))
}

func TestHashSetHeadOption(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val empty = EmptyHashSet[int]()

    val t1 = IsSome(t, s.HeadOption())
    return IsNone(t1, empty.HeadOption())
}

// Partition test
func TestHashSetPartition(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5, 6)
    val result = s.Partition((x) => x % 2 == 0)
    val even = result.V1
    val odd = result.V2

    val t1 = Eq[int](t, even.Size(), 3)
    return Eq[int](t1, odd.Size(), 3)
}

// Reduce tests
func TestHashSetReduce(t T) T {
    val s = HashSetOf[int](1, 2, 3, 4, 5)
    val sum = s.Reduce((a, b) => a + b)
    return Eq[int](t, sum, 15)
}

func TestHashSetReduceOption(t T) T {
    val s = HashSetOf[int](1, 2, 3)
    val empty = EmptyHashSet[int]()

    val t1 = IsSome(t, s.ReduceOption((a, b) => a + b))
    return IsNone(t1, empty.ReduceOption((a, b) => a + b))
}

// ============ Hashable Interface Tests ============

// Person is a custom type that implements Hashable
type Person struct {
    Name string
    Age  int
}

// Hash implements the Hashable interface for Person
func (p Person) Hash() uint32 {
    return HashCombine(HashString(p.Name), HashInt(int64(p.Age)))
}

func TestHashSetWithHashable(t T) T {
    val p1 = Person(Name = "Alice", Age = 30)
    val p2 = Person(Name = "Bob", Age = 25)
    val p3 = Person(Name = "Charlie", Age = 35)

    val s = EmptyHashSet[Person]()
    val s1 = s.Add(p1)
    val s2 = s1.Add(p2)
    val s3 = s2.Add(p3)

    val t1 = Eq[int](t, s3.Size(), 3)
    val t2 = IsTrue(t1, s3.Contains(p1))
    val t3 = IsTrue(t2, s3.Contains(p2))
    return IsTrue(t3, s3.Contains(p3))
}

func TestHashSetHashableNoDuplicates(t T) T {
    val p1 = Person(Name = "Alice", Age = 30)
    val p1copy = Person(Name = "Alice", Age = 30)

    val s = EmptyHashSet[Person]()
    val s1 = s.Add(p1)
    val s2 = s1.Add(p1copy)

    return Eq[int](t, s2.Size(), 1)
}

func TestHashSetHashableRemove(t T) T {
    val p1 = Person(Name = "Alice", Age = 30)
    val p2 = Person(Name = "Bob", Age = 25)

    val s = HashSetOf[Person](p1, p2)
    val s2 = s.Remove(p1)

    val t1 = Eq[int](t, s2.Size(), 1)
    val t2 = IsFalse(t1, s2.Contains(p1))
    return IsTrue(t2, s2.Contains(p2))
}

// Test that exported hash functions work correctly
func TestHashFunctions(t T) T {
    // HashInt should produce consistent results
    val h1 = HashInt(int64(42))
    val h2 = HashInt(int64(42))
    val t1 = Eq[uint32](t, h1, h2)

    // HashString should produce consistent results
    val h3 = HashString("hello")
    val h4 = HashString("hello")
    val t2 = Eq[uint32](t1, h3, h4)

    // Different values should (usually) produce different hashes
    val h5 = HashInt(int64(1))
    val h6 = HashInt(int64(2))
    val t3 = IsTrue(t2, h5 != h6)

    // HashCombine should work
    val combined = HashCombine(h1, h3)
    return IsTrue(t3, combined != 0)
}

// ============ std Value Type Element Tests ============

func TestHashSetOfTuples(t T) T {
    val s = HashSetOf((1, "a"), (2, "b"), (1, "a"))
    val t1 = Eq(t, s.Size(), 2)
    val t2 = IsTrue(t1, s.Contains((2, "b")))
    val t3 = IsFalse(t2, s.Contains((2, "a")))
    Eq(t3, s.Remove((1, "a")).Size(), 1)
}

func TestHashSetOfNestedTuples(t T) T {
    val s = HashSetOf(((1, 2), 3), ((1, 2), 3), ((2, 1), 3))
    val t1 = Eq(t, s.Size(), 2)
    IsTrue(t1, s.Contains(((2, 1), 3)))
}

func TestHashSetOfOptions(t T) T {
    val s = HashSetOf(Some(1), None[int](), Some(1), None[int]())
    val t1 = Eq(t, s.Size(), 2)
    val t2 = IsTrue(t1, s.Contains(None[int]()))
    IsFalse(t2, s.Contains(Some(2)))
}

func TestHashSetOfEithers(t T) T {
    val s = HashSetOf(Left[int, int](1), Right[int, int](1), Left[int, int](1))
    val t1 = Eq(t, s.Size(), 2)
    IsTrue(t1, s.Contains(Right[int, int](1)))
}

// unhashableKey is neither a primitive nor Hashable.
type unhashableKey struct {
    N int
}

func TestHashSetOfTupleWithUnhashablePanics(t T) T = Panics(t, () => {
    HashSetOf((1, unhashableKey(N = 1)), (2, unhashableKey(N = 2)))
})

func TestHashSetOfPointersComparesByIdentity(t T) T {
    val a = &unhashableKey(N = 1)
    val twin = &unhashableKey(N = 1)
    val s = EmptyHashSet[*unhashableKey]().Add(a).Add(twin).Add(a)
    val t1 = Eq(t, s.Size(), 2)
    val t2 = IsTrue(t1, s.Contains(twin))
    val t3 = IsFalse(t2, s.Contains(&unhashableKey(N = 1)))
    val t4 = Eq(t3, s.Remove(a).Size(), 1)
    IsFalse(t4, s.Remove(a).Contains(a))
}

func TestHashSetOfAnyHoldingPointers(t T) T {
    val a = &unhashableKey(N = 1)
    val twin = &unhashableKey(N = 1)
    Eq(t, EmptyHashSet[any]().Add(a).Add(twin).Add(a).Size(), 2)
}

func TestHashSetOfManyPointers(t T) T {
    val keys = ArrayTabulate(300, (i) => &unhashableKey(N = i))
    val s = keys.FoldLeft(EmptyHashSet[*unhashableKey](), (acc, k) => acc.Add(k))
    val t1 = Eq(t, s.Size(), 300)
    IsTrue(t1, keys.ForAll((k) => s.Contains(k)))
}

func TestHashSetOfPointerSets(t T) T {
    // A set compares its pointer elements by identity, so it hashes them by
    // their addresses and is itself an element.
    val a = &unhashableKey(N = 1)
    val b = &unhashableKey(N = 2)
    val s = HashSetOf(HashSetOf(a, b), HashSetOf(b, a), HashSetOf(a))
    val t1 = Eq(t, s.Size(), 2)
    IsFalse(t1, s.Contains(HashSetOf(&unhashableKey(N = 1))))
}

// A Tuple compares the pointer it holds by its target, so it cannot hash it
// by its address.
func TestHashSetOfTupleWithPointerPanics(t T) T = Panics(t, () => {
    HashSetOf((1, &unhashableKey(N = 1)), (2, &unhashableKey(N = 2)))
})

// ============ Collection Element Tests ============

func TestHashSetOfLists(t T) T {
    // Lists built differently are one element when they hold the same values.
    val s = HashSetOf(ListOf("a", "b"), ListOf("b").Prepend("a"), ListOf("b", "a"))
    val t1 = Eq(t, s.Size(), 2)
    val t2 = IsTrue(t1, s.Contains(ListOf("b", "a")))
    Eq(t2, s.Remove(ListOf("b").Prepend("a")).Size(), 1)
}

func TestHashSetOfArrays(t T) T {
    // Arrays built differently are one element when they hold the same values:
    // from a slice, by appending, and through the prepend buffer.
    val appended = EmptyArray[int]().Append(1).Append(2).Append(3)
    val prepended = ArrayOf(3).Prepend(2).Prepend(1)
    val s = HashSetOf(ArrayOf(1, 2, 3), appended, prepended, ArrayOf(3, 2, 1))
    val t1 = Eq(t, s.Size(), 2)
    val t2 = IsTrue(t1, s.Contains(EmptyArray[int]().Prepend(3).Prepend(2).Prepend(1)))
    val t3 = IsFalse(t2, s.Contains(ArrayOf(1, 2)))
    Eq(t3, s.Remove(prepended).Size(), 1)
}

func TestHashSetOfLargePrependedArrays(t T) T {
    // Past 32 prepends the buffer is folded into the trie; equal arrays on
    // either side of that still meet.
    val n = 100
    val built = ArrayTabulate(n, (i) => i)
    val prepended = ArrayTabulate(n, (i) => n - 1 - i).FoldLeft(EmptyArray[int](), (acc, i) => acc.Prepend(i))
    val s = HashSetOf(built, prepended, prepended.Updated(0, -1))
    val t1 = Eq(t, s.Size(), 2)
    IsTrue(t1, s.Contains(ArrayTabulate(n, (i) => i)))
}

func TestHashSetOfHashSets(t T) T {
    // Sets are equal in any order, so their hash ignores the order too.
    val s = HashSetOf(HashSetOf(1, 2, 3), HashSetOf(3, 1, 2), HashSetOf(1, 2))
    val t1 = Eq(t, s.Size(), 2)
    val t2 = IsTrue(t1, s.Contains(HashSetOf(2, 3, 1)))
    IsFalse(t2, s.Contains(HashSetOf(1, 2, 3, 4)))
}

func TestHashSetOfNestedCollections(t T) T {
    val sets = HashSetOf(HashSetOf(ListOf(1, 2), ListOf(3)), HashSetOf(ListOf(3), ListOf(2).Prepend(1)))
    val t1 = Eq(t, sets.Size(), 1)
    val pairs = HashSetOf((ListOf(1), "x"), (ListOf(1), "x"), (ListOf(2), "x"))
    Eq(t1, pairs.Size(), 2)
}

func TestHashSetOfAnyComparesCollectionsByValue(t T) T {
    // With an interface element type, Equal is found by reflection.
    val s = EmptyHashSet[any]().Add(ListOf(1, 2)).Add(ListOf(2).Prepend(1)).Add(HashSetOf(1)).Add(HashSetOf(1))
    val t1 = Eq(t, s.Size(), 2)
    IsTrue(t1, s.Contains(ListOf(1, 2)))
}

func TestCollectionEqualAndHash(t T) T {
    val built = EmptyArray[int]().Prepend(2).Prepend(1).Append(3)
    val t1 = IsTrue(t, ArrayOf(1, 2, 3).Equal(built))
    val t2 = Eq(t1, ArrayOf(1, 2, 3).Hash(), built.Hash())
    val t3 = IsFalse(t2, ArrayOf(1, 2, 3).Equal(ArrayOf(1, 2)))
    val t4 = IsTrue(t3, ListOf(1, 2).Equal(ListOf(2).Prepend(1)))
    val t5 = Eq(t4, ListOf(1, 2).Hash(), ListOf(2).Prepend(1).Hash())
    val t6 = IsTrue(t5, HashSetOf(1, 2, 3).Equal(HashSetOf(3, 2, 1)))
    val t7 = Eq(t6, HashSetOf(1, 2, 3).Hash(), HashSetOf(3, 2, 1).Hash())
    IsFalse(t7, HashSetOf(1, 2).Equal(HashSetOf(1, 3)))
}
