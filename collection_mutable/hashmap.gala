package collection_mutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
)

// HashMap is a mutable map with effectively constant time operations.
// It uses hash buckets for O(1) average operations.
//
// Keys must be either:
// - Primitive types (int, string, bool, etc.) - hashed automatically
// - Types implementing the std.Hashable interface
//
// Performance characteristics:
// - Put:      O(1) amortized
// - Get:      O(1) average
// - Remove:   O(1) amortized
// - Contains: O(1) average
// - Size:     O(1)
// - Clear:    O(1)

// Initial number of buckets
val hashMapInitialBuckets int = 16
// Load factor threshold for resizing
val hashMapLoadFactor float64 = 0.75

// hashMapEntry represents an entry in a bucket.
type hashMapEntry[K comparable, V any] struct {
    key      K
    var value    V
    hashCode uint32
    var next OptionPtr[hashMapEntry[K, V]]
}

// HashMap represents a mutable hash-based map.
type HashMap[K comparable, V any] struct {
    var buckets    []OptionPtr[hashMapEntry[K, V]]
    var size       int
    var bucketMask uint32
}

// EmptyHashMap returns a new empty HashMap.
func EmptyHashMap[K comparable, V any]() Ptr[HashMap[K, V]] {
    var buckets = go_interop.SliceWithSize[OptionPtr[hashMapEntry[K, V]]](hashMapInitialBuckets)
    return &HashMap[K, V](buckets = buckets, size = 0, bucketMask = uint32(hashMapInitialBuckets - 1))
}

// hashMapHash computes a hash code for a key.
func hashMapHash[K comparable](key K) uint32 {
    val v any = key

    val result = v match {
        case i: int => HashInt(int64(i))
        case s: string => HashString(s)
        case i: int64 => HashInt(i)
        case i: int32 => HashInt(int64(i))
        case u: uint => HashUint(uint64(u))
        case u: uint64 => HashUint(u)
        case u: uint32 => HashUint(uint64(u))
        case b: bool => HashBool(b)
        case i: int8 => HashInt(int64(i))
        case i: int16 => HashInt(int64(i))
        case u: uint8 => HashUint(uint64(u))
        case u: uint16 => HashUint(uint64(u))
        case f: float64 => HashUint(uint64(f))
        case f: float32 => HashUint(uint64(f))
        case h: Hashable => h.Hash()
        case _ => hashMapPanicNotHashable(v)
    }
    return result
}

// hashMapPanicNotHashable panics with a helpful error message.
func hashMapPanicNotHashable(v any) uint32 {
    go_builtins.Panic(f"HashMap: type ${v}%T must implement std.Hashable interface")
}

// === Basic Operations ===

// IsEmpty returns true if the map is empty.
func (m Ptr[HashMap[K, V]]) IsEmpty() bool = m.size == 0

// NonEmpty returns true if the map is not empty.
func (m Ptr[HashMap[K, V]]) NonEmpty() bool = m.size > 0

// Size returns the number of entries. O(1).
func (m Ptr[HashMap[K, V]]) Size() int = m.size

// Length is an alias for Size.
func (m Ptr[HashMap[K, V]]) Length() int = m.size

// === Mutating Operations ===

// Put adds or updates a key-value pair. O(1) amortized.
// Returns true if this is a new key, false if updating existing.
func (m Ptr[HashMap[K, V]]) Put(key K, value V) bool {
    val hashCode = hashMapHash[K](key)
    val idx = int(hashCode & m.bucketMask)

    // Check if key already exists
    var entry = m.buckets[idx]
    for entry.IsDefined() {
        val node = entry.Get()
        if node.hashCode == hashCode && node.key == key {
            node.value = value
            return false
        }
        entry = node.next
    }

    // Add new entry at head of bucket
    m.buckets[idx] = SomePtr(&hashMapEntry[K, V](key = key, value = value, hashCode = hashCode, next = m.buckets[idx]))
    m.size++

    // Check if resize needed
    if float64(m.size) > float64(m.buckets.Size()) * hashMapLoadFactor {
        m.resize()
    }

    return true
}

// resize doubles the bucket array and rehashes all entries.
func (m Ptr[HashMap[K, V]]) resize() {
    var newSize = m.buckets.Size() * 2
    var newBuckets = go_interop.SliceWithSize[OptionPtr[hashMapEntry[K, V]]](newSize)
    var newMask = uint32(newSize - 1)

    // Rehash all entries
    for i := 0; i < m.buckets.Size(); i++ {
        var entry = m.buckets[i]
        for entry.IsDefined() {
            val node = entry.Get()
            var nextEntry = node.next
            val newIdx = int(node.hashCode & newMask)
            node.next = newBuckets[newIdx]
            newBuckets[newIdx] = entry
            entry = nextEntry
        }
    }

    m.buckets = newBuckets
    m.bucketMask = newMask
}

// PutIfAbsent adds a key-value pair only if key is not present.
// Returns true if the entry was added.
func (m Ptr[HashMap[K, V]]) PutIfAbsent(key K, value V) bool {
    if m.Contains(key) {
        return false
    }
    m.Put(key, value)
    return true
}

// GetOrElseUpdate returns the value for a key, or computes and stores it if absent.
func (m Ptr[HashMap[K, V]]) GetOrElseUpdate(key K, f func() V) V {
    val existing = m.Get(key)
    if existing.IsDefined() {
        return existing.Get()
    }
    val value = f()
    m.Put(key, value)
    return value
}

// Update updates the value for a key using a function.
// Returns true if the key existed and was updated.
func (m Ptr[HashMap[K, V]]) Update(key K, f func(V) V) bool {
    val hashCode = hashMapHash[K](key)
    val idx = int(hashCode & m.bucketMask)

    var entry = m.buckets[idx]
    for entry.IsDefined() {
        val node = entry.Get()
        if node.hashCode == hashCode && node.key == key {
            node.value = f(node.value)
            return true
        }
        entry = node.next
    }
    return false
}

// Remove removes a key from the map. O(1) amortized.
// Returns true if the key was removed (was present).
func (m Ptr[HashMap[K, V]]) Remove(key K) bool {
    val hashCode = hashMapHash[K](key)
    val idx = int(hashCode & m.bucketMask)

    var prev = EmptyOptionPtr[hashMapEntry[K, V]]()
    var entry = m.buckets[idx]
    for entry.IsDefined() {
        val node = entry.Get()
        if node.hashCode == hashCode && node.key == key {
            if prev.IsEmpty() {
                m.buckets[idx] = node.next
            } else {
                prev.Get().next = node.next
            }
            m.size--
            return true
        }
        prev = entry
        entry = node.next
    }
    return false
}

// RemoveAllKeys removes all keys from an Array.
func (m Ptr[HashMap[K, V]]) RemoveAllKeys(keys Ptr[Array[K]]) {
    keys.ForEach((k K) => {
        m.Remove(k)
    })
}

// Clear removes all entries. O(n) to clear buckets.
func (m Ptr[HashMap[K, V]]) Clear() {
    m.buckets = go_interop.SliceWithSize[OptionPtr[hashMapEntry[K, V]]](hashMapInitialBuckets)
    m.size = 0
    m.bucketMask = uint32(hashMapInitialBuckets - 1)
}

// === Query Operations ===

// Contains checks if the map contains the given key. O(1) average.
func (m Ptr[HashMap[K, V]]) Contains(key K) bool {
    val hashCode = hashMapHash[K](key)
    val idx = int(hashCode & m.bucketMask)

    var entry = m.buckets[idx]
    for entry.IsDefined() {
        val node = entry.Get()
        if node.hashCode == hashCode && node.key == key {
            return true
        }
        entry = node.next
    }
    return false
}

// Get returns the value for a key wrapped in Option. O(1) average.
func (m Ptr[HashMap[K, V]]) Get(key K) Option[V] {
    val hashCode = hashMapHash[K](key)
    val idx = int(hashCode & m.bucketMask)

    var entry = m.buckets[idx]
    for entry.IsDefined() {
        val node = entry.Get()
        if node.hashCode == hashCode && node.key == key {
            return Some[V](node.value)
        }
        entry = node.next
    }
    return None[V]()
}

// GetOrElse returns the value for a key, or the default if not found.
func (m Ptr[HashMap[K, V]]) GetOrElse(key K, defaultValue V) V {
    return m.Get(key).GetOrElse(defaultValue)
}

// Apply returns the value for a key. Panics if key not found.
func (m Ptr[HashMap[K, V]]) Apply(key K) V {
    return m.Get(key) match {
        case Some(v) => v
        case None() => go_builtins.Panic(s"HashMap: key not found: $key")
    }
}

// ContainsAllKeys returns true if the map contains all keys from an Array.
func (m Ptr[HashMap[K, V]]) ContainsAllKeys(keys Ptr[Array[K]]) bool {
    var result = true
    keys.ForEach((k K) => {
        if !m.Contains(k) {
            result = false
        }
    })
    return result
}

// === Iteration ===

// ForEachKV applies a function to each key-value pair for side effects.
func (m Ptr[HashMap[K, V]]) ForEachKV(f func(K, V)) {
    for i := 0; i < m.buckets.Size(); i++ {
        var entry = m.buckets[i]
        for entry.IsDefined() {
            val node = entry.Get()
            f(node.key, node.value)
            entry = node.next
        }
    }
}

// ForEachKey applies a function to each key for side effects.
func (m Ptr[HashMap[K, V]]) ForEachKey(f func(K)) {
    m.ForEachKV((k K, v V) => {
        f(k)
    })
}

// ForEachValue applies a function to each value for side effects.
func (m Ptr[HashMap[K, V]]) ForEachValue(f func(V)) {
    m.ForEachKV((k K, v V) => {
        f(v)
    })
}

// === Transformation (return new maps) ===

// Filter returns a new HashMap with only entries that satisfy the predicate.
func (m Ptr[HashMap[K, V]]) Filter(p func(K, V) bool) Ptr[HashMap[K, V]] {
    return m.FoldLeftKV[Ptr[HashMap[K, V]]](EmptyHashMap[K, V](), (acc Ptr[HashMap[K, V]], k K, v V) => {
        if p(k, v) {
            acc.Put(k, v)
        }
        return acc
    })
}

// FilterKeys returns a new HashMap with only entries whose keys satisfy the predicate.
func (m Ptr[HashMap[K, V]]) FilterKeys(p func(K) bool) Ptr[HashMap[K, V]] {
    return m.FoldLeftKV[Ptr[HashMap[K, V]]](EmptyHashMap[K, V](), (acc Ptr[HashMap[K, V]], k K, v V) => {
        if p(k) {
            acc.Put(k, v)
        }
        return acc
    })
}

// FilterValues returns a new HashMap with only entries whose values satisfy the predicate.
func (m Ptr[HashMap[K, V]]) FilterValues(p func(V) bool) Ptr[HashMap[K, V]] {
    return m.FoldLeftKV[Ptr[HashMap[K, V]]](EmptyHashMap[K, V](), (acc Ptr[HashMap[K, V]], k K, v V) => {
        if p(v) {
            acc.Put(k, v)
        }
        return acc
    })
}

// Collect applies a partial function to each key-value pair and collects the results.
// Entries for which the function returns None are filtered out.
// Returns a mutable Array since the result type may not be suitable for a HashMap.
func (m Ptr[HashMap[K, V]]) Collect[U any](pf func(K, V) Option[U]) Ptr[Array[U]] {
    var result = EmptyArray[U]()
    m.ForEachKV((k K, v V) => {
        val opt = pf(k, v)
        if opt.IsDefined() {
            result.Append(opt.Get())
        }
    })
    return result
}

// FilterNot returns a new HashMap with entries that do not satisfy the predicate.
func (m Ptr[HashMap[K, V]]) FilterNot(p func(K, V) bool) Ptr[HashMap[K, V]] {
    return m.FoldLeftKV[Ptr[HashMap[K, V]]](EmptyHashMap[K, V](), (acc Ptr[HashMap[K, V]], k K, v V) => {
        if !p(k, v) {
            acc.Put(k, v)
        }
        return acc
    })
}

// MapValues applies a function to each value and returns a new map.
func (m Ptr[HashMap[K, V]]) MapValues[U any](f func(V) U) Ptr[HashMap[K, U]] {
    return m.FoldLeftKV[Ptr[HashMap[K, U]]](EmptyHashMap[K, U](), (acc Ptr[HashMap[K, U]], k K, v V) => {
        acc.Put(k, f(v))
        return acc
    })
}

// === In-place Transformations ===

// FilterInPlace removes entries that do not satisfy the predicate.
func (m Ptr[HashMap[K, V]]) FilterInPlace(p func(K, V) bool) {
    val toRemove = m.FoldLeftKV[Ptr[Array[K]]](EmptyArray[K](), (acc Ptr[Array[K]], k K, v V) => {
        if !p(k, v) {
            acc.Append(k)
        }
        return acc
    })
    m.RemoveAllKeys(toRemove)
}

// UpdateAll updates all values using a function.
func (m Ptr[HashMap[K, V]]) UpdateAll(f func(K, V) V) {
    for i := 0; i < m.buckets.Size(); i++ {
        var entry = m.buckets[i]
        for entry.IsDefined() {
            val node = entry.Get()
            node.value = f(node.key, node.value)
            entry = node.next
        }
    }
}

// === Reduction Operations ===

// FoldLeftKV applies a binary operator from left to right with key-value pairs.
func (m Ptr[HashMap[K, V]]) FoldLeftKV[U any](initial U, f func(U, K, V) U) U {
    var acc = initial
    m.ForEachKV((k K, v V) => {
        acc = f(acc, k, v)
    })
    return acc
}

// === Predicate Operations ===

// Exists returns true if any entry satisfies the predicate.
// Uses early exit for performance.
func (m Ptr[HashMap[K, V]]) Exists(p func(K, V) bool) bool {
    for i := 0; i < m.buckets.Size(); i++ {
        var entry = m.buckets[i]
        for entry.IsDefined() {
            val node = entry.Get()
            if p(node.key, node.value) {
                return true
            }
            entry = node.next
        }
    }
    return false
}

// ForAll returns true if all entries satisfy the predicate.
// Uses early exit for performance.
func (m Ptr[HashMap[K, V]]) ForAll(p func(K, V) bool) bool {
    for i := 0; i < m.buckets.Size(); i++ {
        var entry = m.buckets[i]
        for entry.IsDefined() {
            val node = entry.Get()
            if !p(node.key, node.value) {
                return false
            }
            entry = node.next
        }
    }
    return true
}

// Count returns the number of entries satisfying the predicate.
func (m Ptr[HashMap[K, V]]) Count(p func(K, V) bool) int {
    return m.FoldLeftKV[int](0, (acc int, k K, v V) => {
        if p(k, v) {
            return acc + 1
        }
        return acc
    })
}

// === Key/Value Access ===

// Keys returns a mutable HashSet of all keys.
func (m Ptr[HashMap[K, V]]) Keys() Ptr[HashSet[K]] {
    return m.FoldLeftKV[Ptr[HashSet[K]]](EmptyHashSet[K](), (acc Ptr[HashSet[K]], k K, v V) => {
        acc.Add(k)
        return acc
    })
}

// Values returns a mutable List of all values.
func (m Ptr[HashMap[K, V]]) Values() Ptr[List[V]] {
    return m.FoldLeftKV[Ptr[List[V]]](EmptyList[V](), (acc Ptr[List[V]], k K, v V) => {
        acc.Append(v)
        return acc
    })
}

// KeyArray returns an Array of all keys.
func (m Ptr[HashMap[K, V]]) KeyArray() Ptr[Array[K]] {
    return m.FoldLeftKV[Ptr[Array[K]]](EmptyArray[K](), (acc Ptr[Array[K]], k K, v V) => {
        acc.Append(k)
        return acc
    })
}

// ValueArray returns an Array of all values.
func (m Ptr[HashMap[K, V]]) ValueArray() Ptr[Array[V]] {
    return m.FoldLeftKV[Ptr[Array[V]]](EmptyArray[V](), (acc Ptr[Array[V]], k K, v V) => {
        acc.Append(v)
        return acc
    })
}

// === Conversion ===

// ToGoMap converts the map to a Go map.
func (m Ptr[HashMap[K, V]]) ToGoMap() map[K]V {
    var result = go_interop.MapEmpty[K, V]()
    m.ForEachKV((k K, v V) => {
        go_interop.MapPut[K, V](result, k, v)
    })
    return result
}

// ToArray converts the map to a mutable Array of tuples.
func (m Ptr[HashMap[K, V]]) ToArray() Ptr[Array[Tuple[K, V]]] {
    return m.FoldLeftKV[Ptr[Array[Tuple[K, V]]]](ArrayWithCapacity[Tuple[K, V]](m.Size()), (acc Ptr[Array[Tuple[K, V]]], k K, v V) => {
        acc.Append((k, v))
        return acc
    })
}

// ToList converts the map to a mutable List of tuples.
func (m Ptr[HashMap[K, V]]) ToList() Ptr[List[Tuple[K, V]]] {
    return m.FoldLeftKV[Ptr[List[Tuple[K, V]]]](EmptyList[Tuple[K, V]](), (acc Ptr[List[Tuple[K, V]]], k K, v V) => {
        acc.Append((k, v))
        return acc
    })
}

// Clone creates a shallow copy of the map.
func (m Ptr[HashMap[K, V]]) Clone() Ptr[HashMap[K, V]] {
    return m.FoldLeftKV[Ptr[HashMap[K, V]]](EmptyHashMap[K, V](), (acc Ptr[HashMap[K, V]], k K, v V) => {
        acc.Put(k, v)
        return acc
    })
}

// String returns a string representation of the map.
func (m Ptr[HashMap[K, V]]) String() string {
    if m.Size() == 0 {
        return "HashMap()"
    }
    var result = "HashMap("
    var first = true
    m.ForEachKV((k K, v V) => {
        if !first {
            result = result + ", "
        }
        result = result + s"$k -> $v"
        first = false
    })
    return result + ")"
}

// MkString joins entries into a string with separator.
func (m Ptr[HashMap[K, V]]) MkString(sep string) string {
    if m.Size() == 0 {
        return ""
    }
    var result = ""
    var first = true
    m.ForEachKV((k K, v V) => {
        if !first {
            result = result + sep
        }
        result = result + s"$k -> $v"
        first = false
    })
    return result
}

// KeySet returns a mutable HashSet of all keys.
func (m Ptr[HashMap[K, V]]) KeySet() Ptr[HashSet[K]] = m.Keys()

// === Sorting ===

// Sorted returns a mutable Array of key-value tuples sorted by key in natural order.
func (m Ptr[HashMap[K, V]]) Sorted() Ptr[Array[Tuple[K, V]]] = m.ToArray().SortBy((entry Tuple[K, V]) => entry.V1)

// SortWith returns a mutable Array of key-value tuples sorted using the given comparison function.
func (m Ptr[HashMap[K, V]]) SortWith(less func(Tuple[K, V], Tuple[K, V]) bool) Ptr[Array[Tuple[K, V]]] = m.ToArray().SortWith(less)

// SortBy returns a mutable Array of key-value tuples sorted by a key extracted from each entry.
func (m Ptr[HashMap[K, V]]) SortBy[S comparable](f func(Tuple[K, V]) S) Ptr[Array[Tuple[K, V]]] = m.ToArray().SortBy(f)

// === Merge Operations ===

// PutFrom adds all entries from another HashMap.
func (m Ptr[HashMap[K, V]]) PutFrom(other Ptr[HashMap[K, V]]) {
    other.ForEachKV((k K, v V) => {
        m.Put(k, v)
    })
}

// Merge merges another map, using a function for duplicate keys.
func (m Ptr[HashMap[K, V]]) Merge(other Ptr[HashMap[K, V]], f func(V, V) V) {
    other.ForEachKV((k K, v V) => {
        m.Get(k) match {
            case Some(e) => m.Put(k, f(e, v))
            case None() => m.Put(k, v)
        }
    })
}

// PutAllEntries adds all entries from an Array of tuples.
func (m Ptr[HashMap[K, V]]) PutAllEntries(entries Ptr[Array[Tuple[K, V]]]) {
    entries.ForEach((entry Tuple[K, V]) => {
        m.Put(entry.V1, entry.V2)
    })
}

// === Additional Operations ===

// Find returns the first entry satisfying the predicate.
func (m Ptr[HashMap[K, V]]) Find(p func(K, V) bool) Option[Tuple[K, V]] {
    return m.FoldLeftKV[Option[Tuple[K, V]]](None[Tuple[K, V]](), (acc Option[Tuple[K, V]], k K, v V) => {
        if acc.IsEmpty() && p(k, v) {
            return Some((k, v))
        }
        return acc
    })
}

// Head returns the first entry. Panics if empty.
func (m Ptr[HashMap[K, V]]) Head() Tuple[K, V] {
    return m.HeadOption() match {
        case Some(v) => v
        case None() => go_builtins.Panic("HashMap: head of empty map")
    }
}

// HeadOption returns the first entry as Option.
func (m Ptr[HashMap[K, V]]) HeadOption() Option[Tuple[K, V]] {
    if m.IsEmpty() {
        return None[Tuple[K, V]]()
    }
    return m.FoldLeftKV[Option[Tuple[K, V]]](None[Tuple[K, V]](), (acc Option[Tuple[K, V]], k K, v V) => {
        if acc.IsEmpty() {
            return Some((k, v))
        }
        return acc
    })
}

// Partition partitions the map into two new maps based on predicate.
func (m Ptr[HashMap[K, V]]) Partition(p func(K, V) bool) Tuple[Ptr[HashMap[K, V]], Ptr[HashMap[K, V]]] {
    val initial = (EmptyHashMap[K, V](), EmptyHashMap[K, V]())
    return m.FoldLeftKV[Tuple[Ptr[HashMap[K, V]], Ptr[HashMap[K, V]]]](initial, (acc Tuple[Ptr[HashMap[K, V]], Ptr[HashMap[K, V]]], k K, v V) => {
        if p(k, v) {
            acc.V1.Put(k, v)
        } else {
            acc.V2.Put(k, v)
        }
        return acc
    })
}

// === Factory Functions ===

// HashMapOf creates a HashMap from key-value tuples.
func HashMapOf[K comparable, V any](entries ...Tuple[K, V]) Ptr[HashMap[K, V]] {
    var result = EmptyHashMap[K, V]()
    for i := 0; i < entries.Size(); i++ {
        result.Put(entries[i].V1, entries[i].V2)
    }
    return result
}

// HashMapFromSlice creates a HashMap from a slice of tuples.
func HashMapFromSlice[K comparable, V any](entries []Tuple[K, V]) Ptr[HashMap[K, V]] {
    var result = EmptyHashMap[K, V]()
    for i := 0; i < entries.Size(); i++ {
        result.Put(entries[i].V1, entries[i].V2)
    }
    return result
}

// HashMapFromGoMap creates a HashMap from a Go map.
func HashMapFromGoMap[K comparable, V any](m map[K]V) Ptr[HashMap[K, V]] {
    var result = EmptyHashMap[K, V]()
    for k, v := range m {
        result.Put(k, v)
    }
    return result
}
