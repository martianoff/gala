package collection_mutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
)

// TreeSet is a mutable sorted set implemented as a Red-Black tree.
// It maintains elements in sorted order and provides O(log n) operations.
//
// Elements must be either:
// - Primitive types (int, string, float64, etc.) - compared automatically
// - Types implementing the Ordered[T] interface
//
// Performance characteristics:
// - Add:      O(log n)
// - Remove:   O(log n)
// - Contains: O(log n)
// - Min/Max:  O(log n)
// - Size:     O(1) - cached
//
// Unlike Set, TreeSet maintains sorted order and supports range queries.

// Tree node colors for Red-Black tree
val mutableTreeRed int = 0
val mutableTreeBlack int = 1

// treeSetNode represents a node in the Red-Black tree.
type treeSetNode[T comparable] struct {
    var value  T
    var left   OptionPtr[treeSetNode[T]]
    var right  OptionPtr[treeSetNode[T]]
    var parent OptionPtr[treeSetNode[T]]
    var color  int
}

// TreeSet represents a mutable sorted set.
type TreeSet[T comparable] struct {
    var root OptionPtr[treeSetNode[T]]
    var size int
}

// EmptyTreeSet returns a new empty TreeSet.
func EmptyTreeSet[T comparable]() Ptr[TreeSet[T]] = &TreeSet[T](root = EmptyOptionPtr[treeSetNode[T]](), size = 0)

// TreeSetOf creates a TreeSet from variadic arguments.
// Example: TreeSetOf[int](3, 1, 2) creates TreeSet(1, 2, 3)
func TreeSetOf[T comparable](elements ...T) Ptr[TreeSet[T]] {
    var result = EmptyTreeSet[T]()
    for i := 0; i < elements.Size(); i++ {
        result.Add(elements[i])
    }
    return result
}

// TreeSetFromSlice creates a TreeSet from a slice.
func TreeSetFromSlice[T comparable](elements []T) Ptr[TreeSet[T]] {
    var result = EmptyTreeSet[T]()
    for i := 0; i < elements.Size(); i++ {
        result.Add(elements[i])
    }
    return result
}

// === Basic Operations ===

// IsEmpty returns true if the set is empty.
func (s Ptr[TreeSet[T]]) IsEmpty() bool = s.size == 0

// NonEmpty returns true if the set is not empty.
func (s Ptr[TreeSet[T]]) NonEmpty() bool = s.size > 0

// Size returns the number of elements. O(1) - cached.
func (s Ptr[TreeSet[T]]) Size() int = s.size

// Length is an alias for Size.
func (s Ptr[TreeSet[T]]) Length() int = s.size

// === Comparison ===

// treeSetCompare compares two values and returns -1, 0, or 1.
func treeSetCompare[T comparable](a T, b T) int {
    val va any = a
    val vb any = b

    val result = va match {
        case ai: int => treeSetCompareIntsAny(ai, vb)
        case as: string => treeSetCompareStringsAny(as, vb)
        case ai64: int64 => treeSetCompareInt64sAny(ai64, vb)
        case ai32: int32 => treeSetCompareInt32sAny(ai32, vb)
        case af64: float64 => treeSetCompareFloat64sAny(af64, vb)
        case af32: float32 => treeSetCompareFloat32sAny(af32, vb)
        case au: uint => treeSetCompareUintsAny(au, vb)
        case au64: uint64 => treeSetCompareUint64sAny(au64, vb)
        case au32: uint32 => treeSetCompareUint32sAny(au32, vb)
        case ai16: int16 => treeSetCompareInt16sAny(ai16, vb)
        case ai8: int8 => treeSetCompareInt8sAny(ai8, vb)
        case au16: uint16 => treeSetCompareUint16sAny(au16, vb)
        case au8: uint8 => treeSetCompareUint8sAny(au8, vb)
        case ao: Ordered[T] => ao.Compare(b)
        case _ => treeSetPanicNotOrdered(va)
    }
    return result
}

// Type-specific comparison helpers
func treeSetCompareIntsAny(a int, vb any) int {
    val b = vb match { case bi: int => bi case _ => 0 }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareStringsAny(a string, vb any) int {
    val b = vb match { case bs: string => bs case _ => "" }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareInt64sAny(a int64, vb any) int {
    val b = vb match { case bi: int64 => bi case _ => int64(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareInt32sAny(a int32, vb any) int {
    val b = vb match { case bi: int32 => bi case _ => int32(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareInt16sAny(a int16, vb any) int {
    val b = vb match { case bi: int16 => bi case _ => int16(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareInt8sAny(a int8, vb any) int {
    val b = vb match { case bi: int8 => bi case _ => int8(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareFloat64sAny(a float64, vb any) int {
    val b = vb match { case bf: float64 => bf case _ => float64(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareFloat32sAny(a float32, vb any) int {
    val b = vb match { case bf: float32 => bf case _ => float32(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareUintsAny(a uint, vb any) int {
    val b = vb match { case bu: uint => bu case _ => uint(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareUint64sAny(a uint64, vb any) int {
    val b = vb match { case bu: uint64 => bu case _ => uint64(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareUint32sAny(a uint32, vb any) int {
    val b = vb match { case bu: uint32 => bu case _ => uint32(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareUint16sAny(a uint16, vb any) int {
    val b = vb match { case bu: uint16 => bu case _ => uint16(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetCompareUint8sAny(a uint8, vb any) int {
    val b = vb match { case bu: uint8 => bu case _ => uint8(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeSetPanicNotOrdered(v any) int {
    go_builtins.Panic(f"TreeSet: type ${v}%T must implement std.Ordered interface")
}

// isRedTreeSetNode checks if a node is red (empty nodes are black).
func isRedTreeSetNode[T comparable](tree OptionPtr[treeSetNode[T]]) bool =
    tree.IsDefined() && tree.Get().color == mutableTreeRed

// === Query Operations ===

// Contains checks if the set contains the given element. O(log n).
// It walks the tree itself: findNode is too large to inline.
func (s Ptr[TreeSet[T]]) Contains(elem T) bool {
    var current = s.root
    for current.IsDefined() {
        val node = current.Get()
        val cmp = treeSetCompare[T](elem, node.value)
        if cmp < 0 {
            current = node.left
        } else if cmp > 0 {
            current = node.right
        } else {
            return true
        }
    }
    return false
}

// === Mutating Operations ===

// Add adds an element to the set. O(log n).
// Returns true if the element was added (not already present).
func (s Ptr[TreeSet[T]]) Add(elem T) bool {
    if s.root.IsEmpty() {
        s.root = SomePtr(&treeSetNode[T](value = elem, color = mutableTreeBlack))
        s.size = 1
        return true
    }

    // Find insertion point: the last node on the search path
    var parent = s.root.Get()
    var cmp = 0
    for {
        cmp = treeSetCompare[T](elem, parent.value)
        if cmp == 0 {
            return false // Already exists
        }
        val next = if (cmp < 0) parent.left else parent.right
        if next.IsEmpty() {
            break
        }
        parent = next.Get()
    }

    // Insert new node
    val newNode = &treeSetNode[T](value = elem, parent = SomePtr(parent), color = mutableTreeRed)
    if cmp < 0 {
        parent.left = SomePtr(newNode)
    } else {
        parent.right = SomePtr(newNode)
    }
    s.size++

    // Rebalance
    s.fixAfterInsert(newNode)
    return true
}

// fixAfterInsert rebalances the tree after insertion. A red node is never the
// root, so a node whose parent is red has a grandparent.
func (s Ptr[TreeSet[T]]) fixAfterInsert(var node Ptr[treeSetNode[T]]) {
    for isRedTreeSetNode[T](node.parent) {
        val parent = node.parent.Get()
        val grand = parent.parent.Get()
        if grand.left == node.parent {
            val uncle = grand.right
            if isRedTreeSetNode[T](uncle) {
                // Case 1: Uncle is red
                parent.color = mutableTreeBlack
                uncle.Get().color = mutableTreeBlack
                grand.color = mutableTreeRed
                node = grand
            } else {
                if parent.right == SomePtr(node) {
                    // Case 2: Node is right child
                    node = parent
                    s.rotateLeft(node)
                }
                // Case 3: Node is left child
                val p = node.parent.Get()
                p.color = mutableTreeBlack
                val g = p.parent.Get()
                g.color = mutableTreeRed
                s.rotateRight(g)
            }
        } else {
            val uncle = grand.left
            if isRedTreeSetNode[T](uncle) {
                // Case 1: Uncle is red
                parent.color = mutableTreeBlack
                uncle.Get().color = mutableTreeBlack
                grand.color = mutableTreeRed
                node = grand
            } else {
                if parent.left == SomePtr(node) {
                    // Case 2: Node is left child
                    node = parent
                    s.rotateRight(node)
                }
                // Case 3: Node is right child
                val p = node.parent.Get()
                p.color = mutableTreeBlack
                val g = p.parent.Get()
                g.color = mutableTreeRed
                s.rotateLeft(g)
            }
        }
    }
    s.root.Get().color = mutableTreeBlack
}

// replaceChild points whatever pointed at old (its parent, or the root) at
// replacement instead.
func (s Ptr[TreeSet[T]]) replaceChild(old Ptr[treeSetNode[T]], replacement OptionPtr[treeSetNode[T]]) {
    if old.parent.IsEmpty() {
        s.root = replacement
        return
    }
    val parent = old.parent.Get()
    if parent.left == SomePtr(old) {
        parent.left = replacement
    } else {
        parent.right = replacement
    }
}

// rotateLeft performs a left rotation. x has a right child.
func (s Ptr[TreeSet[T]]) rotateLeft(x Ptr[treeSetNode[T]]) {
    val y = x.right.Get()
    x.right = y.left
    if y.left.IsDefined() {
        y.left.Get().parent = SomePtr(x)
    }
    y.parent = x.parent
    s.replaceChild(x, SomePtr(y))
    y.left = SomePtr(x)
    x.parent = SomePtr(y)
}

// rotateRight performs a right rotation. x has a left child.
func (s Ptr[TreeSet[T]]) rotateRight(x Ptr[treeSetNode[T]]) {
    val y = x.left.Get()
    x.left = y.right
    if y.right.IsDefined() {
        y.right.Get().parent = SomePtr(x)
    }
    y.parent = x.parent
    s.replaceChild(x, SomePtr(y))
    y.right = SomePtr(x)
    x.parent = SomePtr(y)
}

// AddAll adds all elements from a slice.
func (s Ptr[TreeSet[T]]) AddAll(elements []T) {
    for i := 0; i < elements.Size(); i++ {
        s.Add(elements[i])
    }
}

// AddFrom adds all elements from another TreeSet.
func (s Ptr[TreeSet[T]]) AddFrom(other Ptr[TreeSet[T]]) {
    other.ForEach((elem T) => {
        s.Add(elem)
    })
}

// Remove removes an element from the set. O(log n).
// Returns true if the element was removed (was present).
func (s Ptr[TreeSet[T]]) Remove(elem T) bool {
    val found = s.findNode(elem)
    if found.IsEmpty() {
        return false
    }
    s.deleteNode(found.Get())
    s.size--
    return true
}

// findNode finds the node containing the element.
func (s Ptr[TreeSet[T]]) findNode(elem T) OptionPtr[treeSetNode[T]] {
    var current = s.root
    for current.IsDefined() {
        val node = current.Get()
        val cmp = treeSetCompare[T](elem, node.value)
        if cmp < 0 {
            current = node.left
        } else if cmp > 0 {
            current = node.right
        } else {
            return current
        }
    }
    return current
}

// deleteNode removes a node from the tree.
func (s Ptr[TreeSet[T]]) deleteNode(var node Ptr[treeSetNode[T]]) {
    // If node has two children, replace with successor
    if node.left.IsDefined() && node.right.IsDefined() {
        val successor = s.minNode(node.right.Get())
        node.value = successor.value
        node = successor
    }

    // Node has at most one child
    val child = if (node.left.IsDefined()) node.left else node.right

    if child.IsDefined() {
        child.Get().parent = node.parent
        s.replaceChild(node, child)
        if node.color == mutableTreeBlack {
            s.fixAfterDelete(child.Get())
        }
    } else if node.parent.IsEmpty() {
        s.root = EmptyOptionPtr[treeSetNode[T]]()
    } else {
        // The leaf stands in for its missing child while the tree is fixed up
        if node.color == mutableTreeBlack {
            s.fixAfterDelete(node)
        }
        s.replaceChild(node, EmptyOptionPtr[treeSetNode[T]]())
    }
}

// fixAfterDelete rebalances the tree after deletion. Rotations on node's parent
// or sibling keep node's parent link, so each pass reads it once.
func (s Ptr[TreeSet[T]]) fixAfterDelete(var node Ptr[treeSetNode[T]]) {
    for node.parent.IsDefined() && node.color == mutableTreeBlack {
        val parent = node.parent.Get()
        if parent.left == SomePtr(node) {
            var sibling = parent.right
            if isRedTreeSetNode[T](sibling) {
                sibling.Get().color = mutableTreeBlack
                parent.color = mutableTreeRed
                s.rotateLeft(parent)
                sibling = parent.right
            }

            if sibling.IsEmpty() {
                node = parent
            } else if !isRedTreeSetNode[T](sibling.Get().left) && !isRedTreeSetNode[T](sibling.Get().right) {
                sibling.Get().color = mutableTreeRed
                node = parent
            } else {
                if !isRedTreeSetNode[T](sibling.Get().right) {
                    val sib = sibling.Get()
                    if sib.left.IsDefined() {
                        sib.left.Get().color = mutableTreeBlack
                    }
                    sib.color = mutableTreeRed
                    s.rotateRight(sib)
                    sibling = parent.right
                }
                if sibling.IsDefined() {
                    sibling.Get().color = parent.color
                }
                parent.color = mutableTreeBlack
                if sibling.IsDefined() && sibling.Get().right.IsDefined() {
                    sibling.Get().right.Get().color = mutableTreeBlack
                }
                s.rotateLeft(parent)
                node = s.root.Get()
            }
        } else {
            var sibling = parent.left
            if isRedTreeSetNode[T](sibling) {
                sibling.Get().color = mutableTreeBlack
                parent.color = mutableTreeRed
                s.rotateRight(parent)
                sibling = parent.left
            }

            if sibling.IsEmpty() {
                node = parent
            } else if !isRedTreeSetNode[T](sibling.Get().right) && !isRedTreeSetNode[T](sibling.Get().left) {
                sibling.Get().color = mutableTreeRed
                node = parent
            } else {
                if !isRedTreeSetNode[T](sibling.Get().left) {
                    val sib = sibling.Get()
                    if sib.right.IsDefined() {
                        sib.right.Get().color = mutableTreeBlack
                    }
                    sib.color = mutableTreeRed
                    s.rotateLeft(sib)
                    sibling = parent.left
                }
                if sibling.IsDefined() {
                    sibling.Get().color = parent.color
                }
                parent.color = mutableTreeBlack
                if sibling.IsDefined() && sibling.Get().left.IsDefined() {
                    sibling.Get().left.Get().color = mutableTreeBlack
                }
                s.rotateRight(parent)
                node = s.root.Get()
            }
        }
    }
    node.color = mutableTreeBlack
}

// RemoveAll removes all elements from a slice.
func (s Ptr[TreeSet[T]]) RemoveAll(elements []T) {
    for i := 0; i < elements.Size(); i++ {
        s.Remove(elements[i])
    }
}

// Clear removes all elements. O(1).
func (s Ptr[TreeSet[T]]) Clear() {
    s.root = EmptyOptionPtr[treeSetNode[T]]()
    s.size = 0
}

// === Min/Max Operations ===

// Min returns the minimum element in the set. O(log n).
// Panics if the set is empty.
func (s Ptr[TreeSet[T]]) Min() T {
    if s.size == 0 {
        go_builtins.Panic("TreeSet.Min on empty set")
    }
    return s.minNode(s.root.Get()).value
}

// minNode finds the node with minimum value in subtree.
func (s Ptr[TreeSet[T]]) minNode(var node Ptr[treeSetNode[T]]) Ptr[treeSetNode[T]] {
    for node.left.IsDefined() {
        node = node.left.Get()
    }
    return node
}

// MinOption returns the minimum element wrapped in Option. O(log n).
func (s Ptr[TreeSet[T]]) MinOption() Option[T] {
    if s.size == 0 {
        return None[T]()
    }
    return Some[T](s.Min())
}

// Max returns the maximum element in the set. O(log n).
// Panics if the set is empty.
func (s Ptr[TreeSet[T]]) Max() T {
    if s.size == 0 {
        go_builtins.Panic("TreeSet.Max on empty set")
    }
    return s.maxNode(s.root.Get()).value
}

// maxNode finds the node with maximum value in subtree.
func (s Ptr[TreeSet[T]]) maxNode(var node Ptr[treeSetNode[T]]) Ptr[treeSetNode[T]] {
    for node.right.IsDefined() {
        node = node.right.Get()
    }
    return node
}

// MaxOption returns the maximum element wrapped in Option. O(log n).
func (s Ptr[TreeSet[T]]) MaxOption() Option[T] {
    if s.size == 0 {
        return None[T]()
    }
    return Some[T](s.Max())
}

// PopMin removes and returns the minimum element. O(log n).
// Panics if the set is empty.
func (s Ptr[TreeSet[T]]) PopMin() T {
    if s.size == 0 {
        go_builtins.Panic("TreeSet.PopMin on empty set")
    }
    var minVal = s.Min()
    s.Remove(minVal)
    return minVal
}

// PopMax removes and returns the maximum element. O(log n).
// Panics if the set is empty.
func (s Ptr[TreeSet[T]]) PopMax() T {
    if s.size == 0 {
        go_builtins.Panic("TreeSet.PopMax on empty set")
    }
    var maxVal = s.Max()
    s.Remove(maxVal)
    return maxVal
}

// === Set Operations ===

// Union returns a new set containing all elements from both sets.
func (s Ptr[TreeSet[T]]) Union(other Ptr[TreeSet[T]]) Ptr[TreeSet[T]] {
    var result = s.Clone()
    result.AddFrom(other)
    return result
}

// Intersect returns a new set containing only elements present in both sets.
func (s Ptr[TreeSet[T]]) Intersect(other Ptr[TreeSet[T]]) Ptr[TreeSet[T]] {
    // Iterate over the smaller set for efficiency
    if s.Size() <= other.Size() {
        return s.FoldLeft[Ptr[TreeSet[T]]](EmptyTreeSet[T](), (acc Ptr[TreeSet[T]], elem T) => {
            if other.Contains(elem) {
                acc.Add(elem)
            }
            return acc
        })
    }
    return other.FoldLeft[Ptr[TreeSet[T]]](EmptyTreeSet[T](), (acc Ptr[TreeSet[T]], elem T) => {
        if s.Contains(elem) {
            acc.Add(elem)
        }
        return acc
    })
}

// Diff returns a new set containing elements in this set but not in other.
func (s Ptr[TreeSet[T]]) Diff(other Ptr[TreeSet[T]]) Ptr[TreeSet[T]] {
    return s.FoldLeft[Ptr[TreeSet[T]]](EmptyTreeSet[T](), (acc Ptr[TreeSet[T]], elem T) => {
        if !other.Contains(elem) {
            acc.Add(elem)
        }
        return acc
    })
}

// SubsetOf returns true if this set is a subset of other.
func (s Ptr[TreeSet[T]]) SubsetOf(other Ptr[TreeSet[T]]) bool {
    if s.Size() > other.Size() {
        return false
    }
    return s.FoldLeft[bool](true, (acc bool, elem T) => acc && other.Contains(elem))
}

// SupersetOf returns true if this set is a superset of other.
func (s Ptr[TreeSet[T]]) SupersetOf(other Ptr[TreeSet[T]]) bool = other.SubsetOf(s)

// === In-place Set Operations ===

// UnionInPlace adds all elements from other to this set.
func (s Ptr[TreeSet[T]]) UnionInPlace(other Ptr[TreeSet[T]]) {
    s.AddFrom(other)
}

// IntersectInPlace removes elements not in other.
func (s Ptr[TreeSet[T]]) IntersectInPlace(other Ptr[TreeSet[T]]) {
    var toRemove []T
    s.ForEach((elem T) => {
        if !other.Contains(elem) {
            toRemove = go_interop.SliceAppend(toRemove, elem)
        }
    })
    s.RemoveAll(toRemove)
}

// DiffInPlace removes elements that are in other.
func (s Ptr[TreeSet[T]]) DiffInPlace(other Ptr[TreeSet[T]]) {
    var toRemove []T
    s.ForEach((elem T) => {
        if other.Contains(elem) {
            toRemove = go_interop.SliceAppend(toRemove, elem)
        }
    })
    s.RemoveAll(toRemove)
}

// === Range Operations ===

// Range returns elements in the range [from, to] inclusive as a new TreeSet.
func (s Ptr[TreeSet[T]]) Range(from T, to T) Ptr[TreeSet[T]] {
    var result = EmptyTreeSet[T]()
    s.rangeInOrder(s.root, from, to, (elem T) => {
        result.Add(elem)
    })
    return result
}

// rangeInOrder traverses nodes within the range in order.
func (s Ptr[TreeSet[T]]) rangeInOrder(tree OptionPtr[treeSetNode[T]], from T, to T, f func(T)) {
    if tree.IsEmpty() {
        return
    }
    val node = tree.Get()
    val cmpFrom = treeSetCompare[T](node.value, from)
    val cmpTo = treeSetCompare[T](node.value, to)

    if cmpFrom > 0 {
        s.rangeInOrder(node.left, from, to, f)
    }
    if cmpFrom >= 0 && cmpTo <= 0 {
        f(node.value)
    }
    if cmpTo < 0 {
        s.rangeInOrder(node.right, from, to, f)
    }
}

// RangeFrom returns all elements >= from.
func (s Ptr[TreeSet[T]]) RangeFrom(from T) Ptr[TreeSet[T]] {
    var result = EmptyTreeSet[T]()
    s.rangeFromInOrder(s.root, from, (elem T) => {
        result.Add(elem)
    })
    return result
}

// rangeFromInOrder traverses nodes >= from in order.
func (s Ptr[TreeSet[T]]) rangeFromInOrder(tree OptionPtr[treeSetNode[T]], from T, f func(T)) {
    if tree.IsEmpty() {
        return
    }
    val node = tree.Get()
    val cmp = treeSetCompare[T](node.value, from)
    if cmp > 0 {
        s.rangeFromInOrder(node.left, from, f)
    }
    if cmp >= 0 {
        f(node.value)
    }
    s.rangeFromInOrder(node.right, from, f)
}

// RangeTo returns all elements <= to.
func (s Ptr[TreeSet[T]]) RangeTo(to T) Ptr[TreeSet[T]] {
    var result = EmptyTreeSet[T]()
    s.rangeToInOrder(s.root, to, (elem T) => {
        result.Add(elem)
    })
    return result
}

// rangeToInOrder traverses nodes <= to in order.
func (s Ptr[TreeSet[T]]) rangeToInOrder(tree OptionPtr[treeSetNode[T]], to T, f func(T)) {
    if tree.IsEmpty() {
        return
    }
    val node = tree.Get()
    val cmp = treeSetCompare[T](node.value, to)
    s.rangeToInOrder(node.left, to, f)
    if cmp <= 0 {
        f(node.value)
    }
    if cmp < 0 {
        s.rangeToInOrder(node.right, to, f)
    }
}

// === Iteration ===

// ForEach applies a function to each element in sorted order.
func (s Ptr[TreeSet[T]]) ForEach(f func(T)) {
    s.inOrder(s.root, f)
}

// inOrder traverses the tree in sorted order.
func (s Ptr[TreeSet[T]]) inOrder(tree OptionPtr[treeSetNode[T]], f func(T)) {
    if tree.IsEmpty() {
        return
    }
    val node = tree.Get()
    s.inOrder(node.left, f)
    f(node.value)
    s.inOrder(node.right, f)
}

// ForEachReverse applies a function to each element in reverse sorted order.
func (s Ptr[TreeSet[T]]) ForEachReverse(f func(T)) {
    s.reverseOrder(s.root, f)
}

// reverseOrder traverses the tree in reverse sorted order.
func (s Ptr[TreeSet[T]]) reverseOrder(tree OptionPtr[treeSetNode[T]], f func(T)) {
    if tree.IsEmpty() {
        return
    }
    val node = tree.Get()
    s.reverseOrder(node.right, f)
    f(node.value)
    s.reverseOrder(node.left, f)
}

// === Transformation ===

// Filter returns a new TreeSet with only elements that satisfy the predicate.
func (s Ptr[TreeSet[T]]) Filter(p func(T) bool) Ptr[TreeSet[T]] {
    return s.FoldLeft[Ptr[TreeSet[T]]](EmptyTreeSet[T](), (acc Ptr[TreeSet[T]], elem T) => {
        if p(elem) {
            acc.Add(elem)
        }
        return acc
    })
}

// FilterNot returns a new TreeSet with elements that do not satisfy the predicate.
func (s Ptr[TreeSet[T]]) FilterNot(p func(T) bool) Ptr[TreeSet[T]] = s.Filter((elem T) => !p(elem))

// Collect applies a partial function to each element and collects the results.
// Elements for which the function returns None are filtered out.
// Returns a mutable Array since the result type may not be comparable.
func (s Ptr[TreeSet[T]]) Collect[U any](pf func(T) Option[U]) Ptr[Array[U]] {
    var result = EmptyArray[U]()
    s.ForEach((elem T) => {
        val opt = pf(elem)
        if opt.IsDefined() {
            result.Append(opt.Get())
        }
    })
    return result
}

// Partition splits the set into two sets based on a predicate.
func (s Ptr[TreeSet[T]]) Partition(p func(T) bool) Tuple[Ptr[TreeSet[T]], Ptr[TreeSet[T]]] {
    val left = s.Filter(p)
    val right = s.FilterNot(p)
    return (left, right)
}

// Map applies a function to each element and returns a new set.
func (s Ptr[TreeSet[T]]) Map[U comparable](f func(T) U) Ptr[TreeSet[U]] {
    return s.FoldLeft[Ptr[TreeSet[U]]](EmptyTreeSet[U](), (acc Ptr[TreeSet[U]], elem T) => {
        acc.Add(f(elem))
        return acc
    })
}

// FlatMap applies a function that returns a set to each element and flattens.
func (s Ptr[TreeSet[T]]) FlatMap[U comparable](f func(T) Ptr[TreeSet[U]]) Ptr[TreeSet[U]] {
    return s.FoldLeft[Ptr[TreeSet[U]]](EmptyTreeSet[U](), (acc Ptr[TreeSet[U]], elem T) => {
        acc.AddFrom(f(elem))
        return acc
    })
}

// === Reduction Operations ===

// FoldLeft applies a binary operator from left to right (in sorted order).
func (s Ptr[TreeSet[T]]) FoldLeft[U any](initial U, f func(U, T) U) U {
    var acc = initial
    s.ForEach((elem T) => {
        acc = f(acc, elem)
    })
    return acc
}

// Reduce applies a binary operator, starting with the first element.
// Panics if the set is empty.
func (s Ptr[TreeSet[T]]) Reduce(f func(T, T) T) T {
    if s.size == 0 {
        go_builtins.Panic("TreeSet.Reduce on empty set")
    }
    var first = true
    var acc T
    s.ForEach((elem T) => {
        if first {
            acc = elem
            first = false
        } else {
            acc = f(acc, elem)
        }
    })
    return acc
}

// ReduceOption is like Reduce but returns None for empty set.
func (s Ptr[TreeSet[T]]) ReduceOption(f func(T, T) T) Option[T] {
    if s.size == 0 {
        return None[T]()
    }
    return Some[T](s.Reduce(f))
}

// === Predicate Operations ===

// Exists returns true if any element satisfies the predicate.
func (s Ptr[TreeSet[T]]) Exists(p func(T) bool) bool {
    return s.FoldLeft[bool](false, (acc bool, elem T) => acc || p(elem))
}

// ForAll returns true if all elements satisfy the predicate.
func (s Ptr[TreeSet[T]]) ForAll(p func(T) bool) bool {
    return s.FoldLeft[bool](true, (acc bool, elem T) => acc && p(elem))
}

// Find returns the first element (in sorted order) that satisfies the predicate.
func (s Ptr[TreeSet[T]]) Find(p func(T) bool) Option[T] {
    return s.FoldLeft[Option[T]](None[T](), (acc Option[T], elem T) => {
        if acc.IsEmpty() && p(elem) {
            return Some[T](elem)
        }
        return acc
    })
}

// Count returns the number of elements satisfying the predicate.
func (s Ptr[TreeSet[T]]) Count(p func(T) bool) int {
    return s.FoldLeft[int](0, (acc int, elem T) => {
        if p(elem) {
            return acc + 1
        }
        return acc
    })
}

// === Element Access ===

// Head returns the minimum element (alias for Min).
// Panics if the set is empty.
func (s Ptr[TreeSet[T]]) Head() T = s.Min()

// HeadOption returns the minimum element wrapped in Option.
func (s Ptr[TreeSet[T]]) HeadOption() Option[T] = s.MinOption()

// Last returns the maximum element (alias for Max).
// Panics if the set is empty.
func (s Ptr[TreeSet[T]]) Last() T = s.Max()

// LastOption returns the maximum element wrapped in Option.
func (s Ptr[TreeSet[T]]) LastOption() Option[T] = s.MaxOption()

// === Conversion ===

// ToGoSlice converts the set to a Go slice in sorted order.
func (s Ptr[TreeSet[T]]) ToGoSlice() []T {
    var result []T
    s.ForEach((elem T) => {
        result = go_interop.SliceAppend(result, elem)
    })
    return result
}

// ToArray converts the set to a mutable Array (in sorted order).
func (s Ptr[TreeSet[T]]) ToArray() Ptr[Array[T]] {
    var result = ArrayWithCapacity[T](s.Size())
    s.ForEach((elem T) => {
        result.Append(elem)
    })
    return result
}

// ToList converts the set to a mutable List (in sorted order).
func (s Ptr[TreeSet[T]]) ToList() Ptr[List[T]] {
    // Traverse in reverse order so prepending gives sorted order
    var result = EmptyList[T]()
    s.ForEachReverse((elem T) => {
        result.Prepend(elem)
    })
    return result
}

// ToHashSet converts the set to a mutable HashSet (loses ordering but gains O(1) lookup).
func (s Ptr[TreeSet[T]]) ToHashSet() Ptr[HashSet[T]] {
    var result = EmptyHashSet[T]()
    s.ForEach((elem T) => {
        result.Add(elem)
    })
    return result
}

// Clone creates a shallow copy of the set.
func (s Ptr[TreeSet[T]]) Clone() Ptr[TreeSet[T]] {
    var result = EmptyTreeSet[T]()
    s.ForEach((elem T) => {
        result.Add(elem)
    })
    return result
}

// String returns a string representation of the set in sorted order.
func (s Ptr[TreeSet[T]]) String() string {
    if s.size == 0 {
        return "TreeSet()"
    }
    var result = "TreeSet("
    var first = true
    s.ForEach((elem T) => {
        if !first {
            result = result + ", "
        }
        result = result + s"$elem"
        first = false
    })
    return result + ")"
}

// MkString joins elements into a string with separator.
func (s Ptr[TreeSet[T]]) MkString(sep string) string {
    if s.size == 0 {
        return ""
    }
    var result = ""
    var first = true
    s.ForEach((elem T) => {
        if !first {
            result = result + sep
        }
        result = result + s"$elem"
        first = false
    })
    return result
}

// === Sorting ===

// Sorted returns a mutable Array of elements in natural sorted order (already sorted).
func (s Ptr[TreeSet[T]]) Sorted() Ptr[Array[T]] = s.ToArray()

// SortWith returns a mutable Array of elements sorted using the given comparison function.
func (s Ptr[TreeSet[T]]) SortWith(less func(T, T) bool) Ptr[Array[T]] = s.ToArray().SortWith(less)

// SortBy returns a mutable Array of elements sorted by a key extracted from each element.
func (s Ptr[TreeSet[T]]) SortBy[K comparable](f func(T) K) Ptr[Array[T]] = s.ToArray().SortBy(f)
