package collection_mutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
)

// List is a mutable doubly-linked list with O(1) operations at both ends.
//
// Performance characteristics:
// - Head:       O(1)
// - Last:       O(1)
// - Prepend:    O(1)
// - Append:     O(1)
// - Get:        O(n)
// - Set:        O(n)
// - Remove:     O(n)
// - Length:     O(1) - cached

// listNode represents a node in the doubly-linked list.
type listNode[T any] struct {
    var value T
    var prev  OptionPtr[listNode[T]]
    var next  OptionPtr[listNode[T]]
}

// List represents a mutable doubly-linked list. head and tail are empty
// exactly when the list is.
type List[T any] struct {
    var head   OptionPtr[listNode[T]]
    var tail   OptionPtr[listNode[T]]
    var length int
}

// EmptyList returns a new empty List.
func EmptyList[T any]() Ptr[List[T]] = &List[T](head = EmptyOptionPtr[listNode[T]](), tail = EmptyOptionPtr[listNode[T]](), length = 0)

// ListOf creates a List from variadic arguments.
func ListOf[T any](elements ...T) Ptr[List[T]] {
    var list = EmptyList[T]()
    for i := 0; i < elements.Size(); i++ {
        list.Append(elements[i])
    }
    return list
}

// ListFromSlice creates a List from a slice.
func ListFromSlice[T any](elements []T) Ptr[List[T]] {
    var list = EmptyList[T]()
    for i := 0; i < elements.Size(); i++ {
        list.Append(elements[i])
    }
    return list
}

// === Basic Operations ===

// IsEmpty returns true if the list is empty.
func (l Ptr[List[T]]) IsEmpty() bool = l.length == 0

// NonEmpty returns true if the list is not empty.
func (l Ptr[List[T]]) NonEmpty() bool = l.length > 0

// Length returns the number of elements. O(1) - cached.
func (l Ptr[List[T]]) Length() int = l.length

// Size is an alias for Length.
func (l Ptr[List[T]]) Size() int = l.length

// === Access Operations ===

// nodeAt returns the node at the given index, which the caller has checked is
// in bounds. O(n).
func (l Ptr[List[T]]) nodeAt(index int) Ptr[listNode[T]] {
    // Optimize by starting from head or tail depending on index
    if index < l.length / 2 {
        var current = l.head.Get()
        for i := 0; i < index; i++ {
            current = current.next.Get()
        }
        return current
    }
    var current = l.tail.Get()
    for i := l.length - 1; i > index; i-- {
        current = current.prev.Get()
    }
    return current
}

// Get returns the element at the given index. O(n).
// Panics if index is out of bounds.
func (l Ptr[List[T]]) Get(index int) T {
    if (index < 0) || (index >= l.length) {
        go_builtins.Panic(f"List.Get: index $index out of bounds [0, ${l.length})")
    }
    var node = l.nodeAt(index)
    return node.value
}

// GetOption returns the element at index wrapped in Option.
func (l Ptr[List[T]]) GetOption(index int) Option[T] {
    if (index < 0) || (index >= l.length) {
        return None[T]()
    }
    return Some[T](l.Get(index))
}

// Head returns the first element. O(1).
// Panics if the list is empty.
func (l Ptr[List[T]]) Head() T {
    if l.length == 0 {
        go_builtins.Panic("List.Head on empty list")
    }
    return l.head.Get().value
}

// HeadOption returns the first element wrapped in Option.
func (l Ptr[List[T]]) HeadOption() Option[T] {
    if l.length == 0 {
        return None[T]()
    }
    return Some[T](l.head.Get().value)
}

// Last returns the last element. O(1).
// Panics if the list is empty.
func (l Ptr[List[T]]) Last() T {
    if l.length == 0 {
        go_builtins.Panic("List.Last on empty list")
    }
    return l.tail.Get().value
}

// LastOption returns the last element wrapped in Option.
func (l Ptr[List[T]]) LastOption() Option[T] {
    if l.length == 0 {
        return None[T]()
    }
    return Some[T](l.tail.Get().value)
}

// === Mutating Operations ===

// Set updates the element at index in place. O(n).
// Panics if index is out of bounds.
func (l Ptr[List[T]]) Set(index int, value T) {
    if (index < 0) || (index >= l.length) {
        go_builtins.Panic(f"List.Set: index $index out of bounds [0, ${l.length})")
    }
    var node = l.nodeAt(index)
    node.value = value
}

// Prepend adds an element to the front. O(1).
func (l Ptr[List[T]]) Prepend(value T) {
    // prev is left out: an OptionPtr field's zero value is empty
    val newNode = SomePtr(&listNode[T](value = value, next = l.head))
    if l.length == 0 {
        l.tail = newNode
    } else {
        l.head.Get().prev = newNode
    }
    l.head = newNode
    l.length++
}

// Append adds an element to the end. O(1).
func (l Ptr[List[T]]) Append(value T) {
    // next is left out: an OptionPtr field's zero value is empty
    val newNode = SomePtr(&listNode[T](value = value, prev = l.tail))
    if l.length == 0 {
        l.head = newNode
    } else {
        l.tail.Get().next = newNode
    }
    l.tail = newNode
    l.length++
}

// PrependAll prepends all elements from a slice. O(m) where m is slice length.
func (l Ptr[List[T]]) PrependAll(values []T) {
    for i := values.Size() - 1; i >= 0; i-- {
        l.Prepend(values[i])
    }
}

// AppendAll appends all elements from a slice. O(m) where m is slice length.
func (l Ptr[List[T]]) AppendAll(values []T) {
    for i := 0; i < values.Size(); i++ {
        l.Append(values[i])
    }
}

// AppendFrom appends all elements from another List. O(m).
func (l Ptr[List[T]]) AppendFrom(other Ptr[List[T]]) {
    var current = other.head
    for current.IsDefined() {
        val node = current.Get()
        l.Append(node.value)
        current = node.next
    }
}

// Insert inserts an element at the given index. O(n).
// Panics if index is out of bounds (0 <= index <= length).
func (l Ptr[List[T]]) Insert(index int, value T) {
    if (index < 0) || (index > l.length) {
        go_builtins.Panic(f"List.Insert: index $index out of bounds [0, ${l.length}]")
    }
    if index == 0 {
        l.Prepend(value)
        return
    }
    if index == l.length {
        l.Append(value)
        return
    }
    // 0 < index < length, so the node at index has a previous node
    val nextNode = l.nodeAt(index)
    val prevNode = nextNode.prev.Get()
    val newNode = SomePtr(&listNode[T](value = value, prev = nextNode.prev, next = prevNode.next))
    prevNode.next = newNode
    nextNode.prev = newNode
    l.length++
}

// RemoveAt removes the element at the given index. O(n).
// Panics if index is out of bounds.
func (l Ptr[List[T]]) RemoveAt(index int) T {
    if (index < 0) || (index >= l.length) {
        go_builtins.Panic(f"List.RemoveAt: index $index out of bounds [0, ${l.length})")
    }
    var node = l.nodeAt(index)
    var removed = node.value
    l.unlinkNode(node)
    return removed
}

// unlinkNode removes a node from the list.
func (l Ptr[List[T]]) unlinkNode(node Ptr[listNode[T]]) {
    if node.prev.IsDefined() {
        node.prev.Get().next = node.next
    } else {
        l.head = node.next
    }
    if node.next.IsDefined() {
        node.next.Get().prev = node.prev
    } else {
        l.tail = node.prev
    }
    l.length--
}

// RemoveFirst removes the first element. O(1).
// Panics if the list is empty.
func (l Ptr[List[T]]) RemoveFirst() T {
    if l.length == 0 {
        go_builtins.Panic("List.RemoveFirst on empty list")
    }
    val first = l.head.Get()
    val next = first.next
    l.head = next
    if l.length == 1 {
        l.tail = next
    } else {
        next.Get().prev = EmptyOptionPtr[listNode[T]]()
    }
    l.length--
    return first.value
}

// RemoveLast removes the last element. O(1).
// Panics if the list is empty.
func (l Ptr[List[T]]) RemoveLast() T {
    if l.length == 0 {
        go_builtins.Panic("List.RemoveLast on empty list")
    }
    val last = l.tail.Get()
    val prev = last.prev
    l.tail = prev
    if l.length == 1 {
        l.head = prev
    } else {
        prev.Get().next = EmptyOptionPtr[listNode[T]]()
    }
    l.length--
    return last.value
}

// Clear removes all elements. O(1).
func (l Ptr[List[T]]) Clear() {
    l.head = EmptyOptionPtr[listNode[T]]()
    l.tail = EmptyOptionPtr[listNode[T]]()
    l.length = 0
}

// Reverse reverses the list in place. O(n).
func (l Ptr[List[T]]) Reverse() {
    if l.length <= 1 {
        return
    }
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        val temp = node.next
        node.next = node.prev
        node.prev = temp
        current = temp
    }
    val temp = l.head
    l.head = l.tail
    l.tail = temp
}

// === Search Operations ===

// Contains checks if the list contains the given element. O(n).
func (l Ptr[List[T]]) Contains(elem T) bool {
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if Equal(node.value, elem) {
            return true
        }
        current = node.next
    }
    return false
}

// IndexOf returns the index of the first occurrence of elem, or -1 if not found.
func (l Ptr[List[T]]) IndexOf(elem T) int {
    var current = l.head
    var index = 0
    for current.IsDefined() {
        val node = current.Get()
        if Equal(node.value, elem) {
            return index
        }
        current = node.next
        index++
    }
    return -1
}

// LastIndexOf returns the index of the last occurrence of elem, or -1 if not found.
func (l Ptr[List[T]]) LastIndexOf(elem T) int {
    var current = l.tail
    var index = l.length - 1
    for current.IsDefined() {
        val node = current.Get()
        if Equal(node.value, elem) {
            return index
        }
        current = node.prev
        index--
    }
    return -1
}

// === Structural Operations (return new lists) ===

// Take returns a new List with the first n elements.
func (l Ptr[List[T]]) Take(n int) Ptr[List[T]] {
    if n <= 0 {
        return EmptyList[T]()
    }
    var result = EmptyList[T]()
    var current = l.head
    var count = 0
    for current.IsDefined() && count < n {
        val node = current.Get()
        result.Append(node.value)
        current = node.next
        count++
    }
    return result
}

// Drop returns a new List without the first n elements.
func (l Ptr[List[T]]) Drop(n int) Ptr[List[T]] {
    if n <= 0 {
        return l.Clone()
    }
    if n >= l.length {
        return EmptyList[T]()
    }
    var result = EmptyList[T]()
    var current = SomePtr(l.nodeAt(n))
    for current.IsDefined() {
        val node = current.Get()
        result.Append(node.value)
        current = node.next
    }
    return result
}

// Slice returns a new List from start (inclusive) to end (exclusive).
func (l Ptr[List[T]]) Slice(var start int, var end int) Ptr[List[T]] {
    if start < 0 {
        start = 0
    }
    if end > l.length {
        end = l.length
    }
    if start >= end {
        return EmptyList[T]()
    }
    var result = EmptyList[T]()
    var current = SomePtr(l.nodeAt(start))
    var count = 0
    for current.IsDefined() && count < end - start {
        val node = current.Get()
        result.Append(node.value)
        current = node.next
        count++
    }
    return result
}

// Clone creates a shallow copy of the list.
func (l Ptr[List[T]]) Clone() Ptr[List[T]] {
    val result = EmptyList[T]()
    result.AppendFrom(l)
    result
}

// Tail returns all elements except the first.
func (l Ptr[List[T]]) Tail() Ptr[List[T]] {
    if l.length == 0 {
        go_builtins.Panic("List.Tail on empty list")
    }
    return l.Drop(1)
}

// Init returns all elements except the last.
func (l Ptr[List[T]]) Init() Ptr[List[T]] {
    if l.length == 0 {
        go_builtins.Panic("List.Init on empty list")
    }
    return l.Take(l.length - 1)
}

// Reversed returns a new List with elements in reverse order.
func (l Ptr[List[T]]) Reversed() Ptr[List[T]] {
    var result = l.Clone()
    result.Reverse()
    return result
}

// === Functional Operations (return new lists) ===

// Map applies a function to each element and returns a new List.
func (l Ptr[List[T]]) Map[U any](f func(T) U) Ptr[List[U]] {
    var result = EmptyList[U]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        result.Append(f(node.value))
        current = node.next
    }
    return result
}

// FlatMap applies a function that returns a List to each element and flattens.
func (l Ptr[List[T]]) FlatMap[U any](f func(T) Ptr[List[U]]) Ptr[List[U]] {
    var result = EmptyList[U]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        result.AppendFrom(f(node.value))
        current = node.next
    }
    return result
}

// Collect applies a partial function to each element and collects the results.
func (l Ptr[List[T]]) Collect[U any](pf func(T) Option[U]) Ptr[List[U]] {
    var result = EmptyList[U]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        val opt = pf(node.value)
        if opt.IsDefined() {
            result.Append(opt.Get())
        }
        current = node.next
    }
    return result
}

// Filter returns a new List with only elements that satisfy the predicate.
func (l Ptr[List[T]]) Filter(p func(T) bool) Ptr[List[T]] {
    var result = EmptyList[T]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if p(node.value) {
            result.Append(node.value)
        }
        current = node.next
    }
    return result
}

// FilterNot returns a new List with elements that do not satisfy the predicate.
func (l Ptr[List[T]]) FilterNot(p func(T) bool) Ptr[List[T]] = l.Filter((elem T) => !p(elem))

// Partition splits the list into two based on a predicate. O(n).
//
// The obvious implementation — `(l.Filter(p), l.FilterNot(p))` — walks the
// list twice (2n) and builds two intermediate structures. Single-pass version
// walks once, Append is O(1) on mutable lists (tail pointer), so total is O(n).
func (l Ptr[List[T]]) Partition(p func(T) bool) Tuple[Ptr[List[T]], Ptr[List[T]]] {
    var left = EmptyList[T]()
    var right = EmptyList[T]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if p(node.value) {
            left.Append(node.value)
        } else {
            right.Append(node.value)
        }
        current = node.next
    }
    return (left, right)
}

// TakeWhile returns the longest prefix of elements that satisfy the predicate.
func (l Ptr[List[T]]) TakeWhile(p func(T) bool) Ptr[List[T]] {
    var result = EmptyList[T]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if !p(node.value) {
            return result
        }
        result.Append(node.value)
        current = node.next
    }
    return result
}

// DropWhile drops the longest prefix of elements that satisfy the predicate.
func (l Ptr[List[T]]) DropWhile(p func(T) bool) Ptr[List[T]] {
    var current = l.head
    var index = 0
    for current.IsDefined() {
        val node = current.Get()
        if !p(node.value) {
            break
        }
        current = node.next
        index++
    }
    return l.Drop(index)
}

// === Reduction Operations ===

// FoldLeft applies a binary operator from left to right.
func (l Ptr[List[T]]) FoldLeft[U any](initial U, f func(U, T) U) U {
    var acc = initial
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        acc = f(acc, node.value)
        current = node.next
    }
    return acc
}

// FoldRight applies a binary operator from right to left.
func (l Ptr[List[T]]) FoldRight[U any](initial U, f func(T, U) U) U {
    var acc = initial
    var current = l.tail
    for current.IsDefined() {
        val node = current.Get()
        acc = f(node.value, acc)
        current = node.prev
    }
    return acc
}

// Reduce applies a binary operator from left to right, starting with the first element.
// Panics if the list is empty.
func (l Ptr[List[T]]) Reduce(f func(T, T) T) T {
    if l.length == 0 {
        go_builtins.Panic("List.Reduce on empty list")
    }
    val first = l.head.Get()
    var acc = first.value
    var current = first.next
    for current.IsDefined() {
        val node = current.Get()
        acc = f(acc, node.value)
        current = node.next
    }
    return acc
}

// ReduceOption is like Reduce but returns None for empty list.
func (l Ptr[List[T]]) ReduceOption(f func(T, T) T) Option[T] {
    if l.length == 0 {
        return None[T]()
    }
    return Some[T](l.Reduce(f))
}

// === Predicate Operations ===

// ForEach applies a function to each element for side effects.
func (l Ptr[List[T]]) ForEach(f func(T)) {
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        f(node.value)
        current = node.next
    }
}

// Exists returns true if any element satisfies the predicate.
func (l Ptr[List[T]]) Exists(p func(T) bool) bool {
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if p(node.value) {
            return true
        }
        current = node.next
    }
    return false
}

// ForAll returns true if all elements satisfy the predicate.
func (l Ptr[List[T]]) ForAll(p func(T) bool) bool {
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if !p(node.value) {
            return false
        }
        current = node.next
    }
    return true
}

// Find returns the first element that satisfies the predicate.
func (l Ptr[List[T]]) Find(p func(T) bool) Option[T] {
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if p(node.value) {
            return Some[T](node.value)
        }
        current = node.next
    }
    return None[T]()
}

// FindLast returns the last element that satisfies the predicate.
func (l Ptr[List[T]]) FindLast(p func(T) bool) Option[T] {
    var current = l.tail
    for current.IsDefined() {
        val node = current.Get()
        if p(node.value) {
            return Some[T](node.value)
        }
        current = node.prev
    }
    return None[T]()
}

// Count returns the number of elements satisfying the predicate.
func (l Ptr[List[T]]) Count(p func(T) bool) int {
    return l.FoldLeft[int](0, (acc int, elem T) => {
        if p(elem) {
            return acc + 1
        }
        return acc
    })
}

// === Utility Operations ===

// Zip combines two lists into a list of tuples. Result length is the minimum.
func (l Ptr[List[T]]) Zip[U any](other Ptr[List[U]]) Ptr[List[Tuple[T, U]]] {
    var result = EmptyList[Tuple[T, U]]()
    var currentL = l.head
    var currentO = other.head
    for currentL.IsDefined() && currentO.IsDefined() {
        val nodeL = currentL.Get()
        val nodeO = currentO.Get()
        result.Append((nodeL.value, nodeO.value))
        currentL = nodeL.next
        currentO = nodeO.next
    }
    return result
}

// ZipWithIndex pairs each element with its index.
func (l Ptr[List[T]]) ZipWithIndex() Ptr[List[Tuple[T, int]]] {
    var result = EmptyList[Tuple[T, int]]()
    var current = l.head
    var index = 0
    for current.IsDefined() {
        val node = current.Get()
        result.Append((node.value, index))
        current = node.next
        index++
    }
    return result
}

// Distinct returns a new list with duplicate elements removed.
func (l Ptr[List[T]]) Distinct() Ptr[List[T]] {
    var result = EmptyList[T]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        if !result.Contains(node.value) {
            result.Append(node.value)
        }
        current = node.next
    }
    return result
}

// SplitAt splits the list at the given index.
func (l Ptr[List[T]]) SplitAt(n int) Tuple[Ptr[List[T]], Ptr[List[T]]] {
    return (l.Take(n), l.Drop(n))
}

// GroupBy partitions this list into a map of lists according to a discriminator function.
func (l Ptr[List[T]]) GroupBy[K comparable](f func(T) K) map[K]Ptr[List[T]] {
    var result = go_interop.MapEmpty[K, Ptr[List[T]]]()
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        val key = f(node.value)
        val existing, ok = go_interop.MapGet(result, key)
        if ok {
            existing.Append(node.value)
        } else {
            val group = EmptyList[T]()
            group.Append(node.value)
            result[key] = group
        }
        current = node.next
    }
    return result
}

// === Conversion ===

// ToGoSlice converts the list to a Go slice.
func (l Ptr[List[T]]) ToGoSlice() []T {
    var result []T
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        result = go_interop.SliceAppend(result, node.value)
        current = node.next
    }
    return result
}

// ToArray converts the list to a Array.
func (l Ptr[List[T]]) ToArray() Ptr[Array[T]] {
    var result = ArrayWithCapacity[T](l.length)
    var current = l.head
    for current.IsDefined() {
        val node = current.Get()
        result.Append(node.value)
        current = node.next
    }
    return result
}

// String returns a string representation of the list.
func (l Ptr[List[T]]) String() string {
    if l.length == 0 {
        return "List()"
    }
    var result = "List("
    var current = l.head
    var first = true
    for current.IsDefined() {
        val node = current.Get()
        if !first {
            result = result + ", "
        }
        result = result + s"${node.value}"
        current = node.next
        first = false
    }
    return result + ")"
}

// MkString joins elements into a string with separator.
func (l Ptr[List[T]]) MkString(sep string) string {
    if l.length == 0 {
        return ""
    }
    var result = ""
    var current = l.head
    var first = true
    for current.IsDefined() {
        val node = current.Get()
        if !first {
            result = result + sep
        }
        result = result + s"${node.value}"
        current = node.next
        first = false
    }
    return result
}

// === Sorting ===

// Sorted returns a new List with elements sorted in natural order.
func (l Ptr[List[T]]) Sorted() Ptr[List[T]] = l.ToArray().Sorted().ToList()

// SortWith returns a new List sorted using the given comparison function.
func (l Ptr[List[T]]) SortWith(less func(T, T) bool) Ptr[List[T]] = l.ToArray().SortWith(less).ToList()

// SortBy returns a new List sorted by a key extracted from each element.
func (l Ptr[List[T]]) SortBy[K comparable](f func(T) K) Ptr[List[T]] = l.ToArray().SortBy(f).ToList()

// SeqDrop implements the Seq interface for sequence pattern matching.
func (l Ptr[List[T]]) SeqDrop(n int) any = l.Drop(n)
