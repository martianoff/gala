load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "galaerr",
    srcs = [
        "bom.go",
        "errors.go",
        "json.go",
        "render.go",
    ],
    importpath = "martianoff/gala/galaerr",
    visibility = ["//visibility:public"],
)

# errors.go as test data, for the completeness guard in
# //internal/transpiler/transformer that parses the declared ErrorCode
# constants and asserts each one has a page under docs/errors/. It reads the
# declarations rather than the compiled constants so it can also catch a page
# left behind by a code that was removed.
filegroup(
    name = "errors_src",
    srcs = ["errors.go"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "galaerr_test",
    srcs = [
        "bom_test.go",
        "errors_test.go",
        "json_test.go",
        "render_test.go",
        "syntax_filepath_test.go",
    ],
    deps = [
        ":galaerr",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
