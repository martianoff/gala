package json

import (
    "bytes"
    "encoding/json"
    "math"
    "strconv"
    "strings"
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
    . "martianoff/gala/collection_immutable"
)

// --- JsonEncoderImpl: implements std.FieldEncoder for JSON output. ---

// JsonEncoderImpl writes JSON bytes via the typed FieldEncoder interface.
// Produced by NewJsonEncoder(); consumed by _StructMeta_T.EncodeFields.
type JsonEncoderImpl struct {
    var buf        bytes.Buffer
    var needsComma bool
    var keyPending bool
}

func NewJsonEncoder() *JsonEncoderImpl = &JsonEncoderImpl{}

func (e *JsonEncoderImpl) WriteStartObject() {
    e.writeCommaIfNeeded()
    e.buf.WriteByte('{')
    e.needsComma = false
}

func (e *JsonEncoderImpl) WriteEndObject() {
    e.buf.WriteByte('}')
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteStartArray() {
    e.writeCommaIfNeeded()
    e.buf.WriteByte('[')
    e.needsComma = false
}

func (e *JsonEncoderImpl) WriteEndArray() {
    e.buf.WriteByte(']')
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteKey(name string) {
    e.writeCommaIfNeeded()
    e.writeEscapedJsonString(name)
    e.buf.WriteByte(':')
    e.needsComma = false
}

func (e *JsonEncoderImpl) WriteString(v string) {
    e.writeCommaIfNeeded()
    e.writeEscapedJsonString(v)
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteInt(v int) {
    e.writeCommaIfNeeded()
    e.buf.WriteString(strconv.Itoa(v))
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteInt64(v int64) {
    e.writeCommaIfNeeded()
    e.buf.WriteString(strconv.FormatInt(v, 10))
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteUint64(v uint64) {
    e.writeCommaIfNeeded()
    e.buf.WriteString(strconv.FormatUint(v, 10))
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteFloat64(v float64) {
    e.writeFloat(v, 64)
}

func (e *JsonEncoderImpl) WriteFloat32(v float32) {
    e.writeFloat(float64(v), 32)
}

// writeFloat renders v in the shortest decimal form that parses back to the
// same value at bitSize. JSON has no spelling for NaN or the infinities, so
// they fail the encode (the Encode Try becomes a Failure) instead of
// producing a document no JSON parser accepts.
func (e *JsonEncoderImpl) writeFloat(v float64, bitSize int) {
    if math.IsNaN(v) || math.IsInf(v, 0) {
        go_builtins.Panic(s"json: unsupported float value ${strconv.FormatFloat(v, 'g', -1, 64)}: JSON has no NaN or Infinity")
    }
    e.writeCommaIfNeeded()
    e.buf.WriteString(strconv.FormatFloat(v, 'f', -1, bitSize))
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteBool(v bool) {
    e.writeCommaIfNeeded()
    e.buf.WriteString(if (v) "true" else "false")
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteRune(v rune) {
    e.writeCommaIfNeeded()
    e.writeEscapedJsonString(RuneToString(v))
    e.needsComma = true
}

func (e *JsonEncoderImpl) WriteNull() {
    e.writeCommaIfNeeded()
    e.buf.WriteString("null")
    e.needsComma = true
}

func (e *JsonEncoderImpl) String() string = e.buf.String()

func (e *JsonEncoderImpl) writeCommaIfNeeded() {
    if e.needsComma {
        e.buf.WriteByte(',')
        e.needsComma = false
    }
}

func (e *JsonEncoderImpl) writeEscapedJsonString(s string) {
    e.buf.WriteByte('"')
    // Byte-level loop: s[i] byte-indexes and WriteByte writes bytes, so the bound
    // must be the byte length (.ByteSize() -> len(s)), NOT the rune count
    // (.Size() -> utf8.RuneCountInString) — the latter truncates multibyte input.
    for i := 0; i < s.ByteSize(); i++ {
        val c = s[i]
        if c == '"' {
            e.buf.WriteString("\\\"")
        } else if c == '\\' {
            e.buf.WriteString("\\\\")
        } else if c == '\n' {
            e.buf.WriteString("\\n")
        } else if c == '\r' {
            e.buf.WriteString("\\r")
        } else if c == '\t' {
            e.buf.WriteString("\\t")
        } else if c < 32 {
            e.buf.WriteString(f"\\u${c}%04x")
        } else {
            e.buf.WriteByte(c)
        }
    }
    e.buf.WriteByte('"')
}

// PrettyIndent re-indents a compact JSON string.
func PrettyIndent(compact string, indent string) Try[string] {
    var out bytes.Buffer
    val err = json.Indent(&out, toBytes(compact), "", indent)
    if err != nil {
        return Failure[string](err)
    }
    return Success[string](out.String())
}

// --- JsonDecoderImpl: implements std.FieldDecoder for JSON input. ---

// JsonDecoderImpl is a pull-style JSON parser. Unlike the legacy Reader it
// exposes plain primitive returns from its Read* methods — errors are
// surfaced by panicking out to the surrounding Try block (callers wrap the
// Decode invocation in Try(() => { ... })).
type JsonDecoderImpl struct {
    var data          []byte
    var pos           int
    var stack         []byte
    var firstConsumed []bool
    var pendingKey    string
    var hasPendingKey bool
}

func NewJsonDecoder(s string) *JsonDecoderImpl = &JsonDecoderImpl{data: toBytes(s), pos: 0}

func (d *JsonDecoderImpl) StartObject() {
    // Container openers must consume the inter-element comma when the
    // enclosing context is an array — otherwise Array[Foo] of structs
    // panics on the leading ',' of element 2+. The primitive Read* paths
    // already do this; objects/arrays were missing the same hook.
    d.consumeElemComma()
    d.skipWs()
    if d.pos >= d.data.Size() || d.data[d.pos] != '{' {
        go_builtins.Panic(s"json at pos ${d.pos}: expected '{'")
    }
    d.pos = d.pos + 1
    d.stack = go_interop.SliceAppend(d.stack, 'o')
    d.firstConsumed = go_interop.SliceAppend(d.firstConsumed, false)
}

func (d *JsonDecoderImpl) EndObject() {
    d.skipWs()
    if d.pos >= d.data.Size() || d.data[d.pos] != '}' {
        go_builtins.Panic(s"json at pos ${d.pos}: expected '}'")
    }
    d.pos = d.pos + 1
    d.stack = TruncateBytes(d.stack, d.stack.Size() - 1)
    d.firstConsumed = TruncateBools(d.firstConsumed, d.firstConsumed.Size() - 1)
}

func (d *JsonDecoderImpl) StartArray() {
    // See StartObject — the enclosing array context's leading ',' must be
    // consumed before we can recognise the '[' of a nested array element.
    d.consumeElemComma()
    d.skipWs()
    if d.pos >= d.data.Size() || d.data[d.pos] != '[' {
        go_builtins.Panic(s"json at pos ${d.pos}: expected '['")
    }
    d.pos = d.pos + 1
    d.stack = go_interop.SliceAppend(d.stack, 'a')
    d.firstConsumed = go_interop.SliceAppend(d.firstConsumed, false)
}

func (d *JsonDecoderImpl) EndArray() {
    d.skipWs()
    if d.pos >= d.data.Size() || d.data[d.pos] != ']' {
        go_builtins.Panic(s"json at pos ${d.pos}: expected ']'")
    }
    d.pos = d.pos + 1
    d.stack = TruncateBytes(d.stack, d.stack.Size() - 1)
    d.firstConsumed = TruncateBools(d.firstConsumed, d.firstConsumed.Size() - 1)
}

func (d *JsonDecoderImpl) HasMoreFields() bool {
    d.skipWs()
    if d.pos >= d.data.Size() { return false }
    return d.data[d.pos] != '}'
}

func (d *JsonDecoderImpl) HasMoreElements() bool {
    d.skipWs()
    if d.pos >= d.data.Size() { return false }
    return d.data[d.pos] != ']'
}

func (d *JsonDecoderImpl) ReadKey() string {
    d.skipWs()
    val depth = d.firstConsumed.Size() - 1
    if depth >= 0 && d.firstConsumed[depth] {
        if d.pos < d.data.Size() && d.data[d.pos] == ',' {
            d.pos = d.pos + 1
            d.skipWs()
        }
    }
    if depth >= 0 { d.firstConsumed[depth] = true }

    val key = d.readJsonString()
    d.skipWs()
    if d.pos >= d.data.Size() || d.data[d.pos] != ':' {
        go_builtins.Panic(s"json at pos ${d.pos}: expected ':'")
    }
    d.pos = d.pos + 1
    return key
}

func (d *JsonDecoderImpl) ReadString() string {
    d.consumeElemComma()
    d.skipWs()
    return d.readJsonString()
}

func (d *JsonDecoderImpl) ReadInt() int {
    d.consumeElemComma()
    d.skipWs()
    val s = d.readNumberStr()
    val v, err = strconv.Atoi(s)
    if err != nil {
        go_builtins.Panic(f"json at pos ${d.pos}: invalid int ${s}%q")
    }
    return v
}

func (d *JsonDecoderImpl) ReadInt64() int64 {
    d.consumeElemComma()
    d.skipWs()
    val s = d.readNumberStr()
    val v, err = strconv.ParseInt(s, 10, 64)
    if err != nil {
        go_builtins.Panic(f"json at pos ${d.pos}: invalid int64 ${s}%q")
    }
    return v
}

// ReadIntN reads a signed integer that must fit in bitSize bits. A value
// outside the range is a decode error, never a silent wrap.
func (d *JsonDecoderImpl) ReadIntN(bitSize int) int64 {
    d.consumeElemComma()
    d.skipWs()
    val s = d.readNumberStr()
    val v, err = strconv.ParseInt(s, 10, bitSize)
    if err != nil {
        go_builtins.Panic(f"json at pos ${d.pos}: invalid ${intKindName("int", bitSize)} ${s}%q")
    }
    return v
}

// ReadUintN reads an unsigned integer that must fit in bitSize bits (0 is
// the platform uint size). Negative and out-of-range values are errors.
func (d *JsonDecoderImpl) ReadUintN(bitSize int) uint64 {
    d.consumeElemComma()
    d.skipWs()
    val s = d.readNumberStr()
    val v, err = strconv.ParseUint(s, 10, bitSize)
    if err != nil {
        go_builtins.Panic(f"json at pos ${d.pos}: invalid ${intKindName("uint", bitSize)} ${s}%q")
    }
    return v
}

// ReadFloat32 reads a float that fits a finite float32; a literal that
// overflows it is an error rather than a silent infinity.
func (d *JsonDecoderImpl) ReadFloat32() float32 {
    d.consumeElemComma()
    d.skipWs()
    val s = d.readNumberStr()
    val v, err = strconv.ParseFloat(s, 32)
    if err != nil {
        go_builtins.Panic(f"json at pos ${d.pos}: invalid float32 ${s}%q")
    }
    return float32(v)
}

func (d *JsonDecoderImpl) ReadFloat64() float64 {
    d.consumeElemComma()
    d.skipWs()
    val s = d.readNumberStr()
    val v, err = strconv.ParseFloat(s, 64)
    if err != nil {
        go_builtins.Panic(f"json at pos ${d.pos}: invalid float ${s}%q")
    }
    return v
}

func (d *JsonDecoderImpl) ReadBool() bool {
    d.consumeElemComma()
    d.skipWs()
    if d.pos + 4 <= d.data.Size() && BytesToString(d.data, d.pos, d.pos + 4) == "true" {
        d.pos = d.pos + 4
        return true
    }
    if d.pos + 5 <= d.data.Size() && BytesToString(d.data, d.pos, d.pos + 5) == "false" {
        d.pos = d.pos + 5
        return false
    }
    go_builtins.Panic(s"json at pos ${d.pos}: expected boolean")
}

func (d *JsonDecoderImpl) ReadRune() rune {
    val s = d.ReadString()
    val rs = go_interop.ToRunes(s)
    if rs.Size() == 0 {
        return rune(0)
    }
    return rs[0]
}

func (d *JsonDecoderImpl) IsNull() bool {
    // Inside an array the next value sits behind the element separator, so
    // step over it first: without this `[1,null]` reads `,null` as not-null
    // and an Array[Option[T]] fails on its second element. Consuming the
    // separator here is safe because the read that follows would consume it
    // anyway, and consumeElemComma is a no-op once it has.
    d.consumeElemComma()
    d.skipWs()
    return d.pos + 4 <= d.data.Size() && BytesToString(d.data, d.pos, d.pos + 4) == "null"
}

func (d *JsonDecoderImpl) ReadNull() {
    d.consumeElemComma()
    d.skipWs()
    if d.pos + 4 <= d.data.Size() && BytesToString(d.data, d.pos, d.pos + 4) == "null" {
        d.pos = d.pos + 4
        return
    }
    go_builtins.Panic(s"json at pos ${d.pos}: expected null")
}

func (d *JsonDecoderImpl) Skip() {
    d.consumeElemComma()
    d.skipWs()
    if d.pos >= d.data.Size() { return }
    val c = d.data[d.pos]
    c match {
        case '"' => { d.readJsonString() }
        case '{' => { d.skipBetween('{', '}') }
        case '[' => { d.skipBetween('[', ']') }
        case 't' => { d.ReadBool() }
        case 'f' => { d.ReadBool() }
        case 'n' => { d.ReadNull() }
        case _ => { d.readNumberStr() }
    }
}

// --- decoder internal helpers ---

func (d *JsonDecoderImpl) skipWs() {
    for d.pos < d.data.Size() {
        val c = d.data[d.pos]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            d.pos = d.pos + 1
        } else {
            return
        }
    }
}

func (d *JsonDecoderImpl) consumeElemComma() {
    val depth = d.firstConsumed.Size() - 1
    if depth >= 0 && d.stack.Size() > 0 && d.stack[depth] == 'a' && d.firstConsumed[depth] {
        d.skipWs()
        if d.pos < d.data.Size() && d.data[d.pos] == ',' {
            d.pos = d.pos + 1
        }
    }
    if depth >= 0 && d.stack.Size() > 0 && d.stack[depth] == 'a' {
        d.firstConsumed[depth] = true
    }
}

func (d *JsonDecoderImpl) readJsonString() string {
    d.skipWs()
    if d.pos >= d.data.Size() || d.data[d.pos] != '"' {
        go_builtins.Panic(s"json at pos ${d.pos}: expected '\"'")
    }
    d.pos = d.pos + 1

    var sb strings.Builder
    for d.pos < d.data.Size() {
        val c = d.data[d.pos]
        if c == '"' {
            d.pos = d.pos + 1
            return sb.String()
        }
        if c == '\\' {
            d.pos = d.pos + 1
            if d.pos >= d.data.Size() {
                go_builtins.Panic("json: unexpected end of escape")
            }
            val esc = d.data[d.pos]
            d.pos = d.pos + 1
            esc match {
                case '"' => { sb.WriteByte('"') }
                case '\\' => { sb.WriteByte('\\') }
                case '/' => { sb.WriteByte('/') }
                case 'n' => { sb.WriteByte('\n') }
                case 'r' => { sb.WriteByte('\r') }
                case 't' => { sb.WriteByte('\t') }
                case 'u' => {
                    if d.pos + 4 > d.data.Size() {
                        go_builtins.Panic("json: incomplete unicode escape")
                    }
                    val hexStr = BytesToString(d.data, d.pos, d.pos + 4)
                    d.pos = d.pos + 4
                    val cp, hexErr = strconv.ParseUint(hexStr, 16, 32)
                    if hexErr != nil {
                        go_builtins.Panic("json: invalid unicode escape")
                    }
                    sb.WriteString(RuneToString(rune(cp)))
                }
                case _ => { go_builtins.Panic("json: invalid escape sequence") }
            }
        } else {
            sb.WriteByte(c)
            d.pos = d.pos + 1
        }
    }
    go_builtins.Panic("json: unterminated string")
}

// intKindName names the Go integer kind a strconv bit size stands for; 0 is
// the platform-sized int or uint.
func intKindName(prefix string, bitSize int) string =
    if (bitSize == 0) prefix else prefix + strconv.Itoa(bitSize)

func (d *JsonDecoderImpl) readNumberStr() string {
    val start = d.pos
    for d.pos < d.data.Size() {
        val c = d.data[d.pos]
        if (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E' {
            d.pos = d.pos + 1
        } else {
            break
        }
    }
    return BytesToString(d.data, start, d.pos)
}

func (d *JsonDecoderImpl) skipBetween(open byte, close byte) {
    if d.pos >= d.data.Size() || d.data[d.pos] != open {
        go_builtins.Panic("json: expected container start")
    }
    d.pos = d.pos + 1
    var depth = 1
    var inString = false
    for d.pos < d.data.Size() && depth > 0 {
        val c = d.data[d.pos]
        if inString {
            if c == '\\' {
                d.pos = d.pos + 1
            } else if c == '"' {
                inString = false
            }
        } else {
            if c == '"' { inString = true }
            else if c == open { depth = depth + 1 }
            else if c == close { depth = depth - 1 }
        }
        d.pos = d.pos + 1
    }
    if depth != 0 {
        go_builtins.Panic("json: unterminated container")
    }
}
