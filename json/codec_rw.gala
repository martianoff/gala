package json

import (
    "bytes"
    "encoding/json"
    "fmt"
    "strconv"
    "strings"
)

// Writer implements FieldWriter for JSON format.
// Builds JSON using direct byte manipulation — no encoding/json for value serialization.
type Writer struct {
    var buf        bytes.Buffer
    var needsComma bool
}

func NewWriter() *Writer = &Writer{}

func (w *Writer) BeginObject() {
    w.writeCommaIfNeeded()
    w.buf.WriteByte('{')
    w.needsComma = false
}

func (w *Writer) EndObject() {
    w.buf.WriteByte('}')
    w.needsComma = true
}

func (w *Writer) BeginArray() {
    w.writeCommaIfNeeded()
    w.buf.WriteByte('[')
    w.needsComma = false
}

func (w *Writer) EndArray() {
    w.buf.WriteByte(']')
    w.needsComma = true
}

func (w *Writer) WriteKey(key string) {
    w.writeCommaIfNeeded()
    w.writeEscapedString(key)
    w.buf.WriteByte(':')
    w.needsComma = false
}

func (w *Writer) WriteString(v string) {
    w.writeCommaIfNeeded()
    w.writeEscapedString(v)
    w.needsComma = true
}

func (w *Writer) WriteInt(v int) {
    w.writeCommaIfNeeded()
    w.buf.WriteString(strconv.Itoa(v))
    w.needsComma = true
}

func (w *Writer) WriteFloat64(v float64) {
    w.writeCommaIfNeeded()
    w.buf.WriteString(strconv.FormatFloat(v, 'f', -1, 64))
    w.needsComma = true
}

func (w *Writer) WriteBool(v bool) {
    w.writeCommaIfNeeded()
    if v {
        w.buf.WriteString("true")
    } else {
        w.buf.WriteString("false")
    }
    w.needsComma = true
}

func (w *Writer) WriteNull() {
    w.writeCommaIfNeeded()
    w.buf.WriteString("null")
    w.needsComma = true
}

func (w *Writer) String() string = w.buf.String()

func (w *Writer) PrettyString() Try[string] {
    var out bytes.Buffer
    val err = json.Indent(&out, toBytes(w.buf.String()), "", "  ")
    if err != nil {
        return Failure[string](err)
    }
    return Success[string](out.String())
}

func (w *Writer) writeCommaIfNeeded() {
    if w.needsComma {
        w.buf.WriteByte(',')
        w.needsComma = false
    }
}

func (w *Writer) writeEscapedString(s string) {
    w.buf.WriteByte('"')
    for i := 0; i < len(s); i++ {
        val c = s[i]
        if c == '"' {
            w.buf.WriteString("\\\"")
        } else if c == '\\' {
            w.buf.WriteString("\\\\")
        } else if c == '\n' {
            w.buf.WriteString("\\n")
        } else if c == '\r' {
            w.buf.WriteString("\\r")
        } else if c == '\t' {
            w.buf.WriteString("\\t")
        } else if c < 32 {
            w.buf.WriteString(fmt.Sprintf("\\u%04x", c))
        } else {
            w.buf.WriteByte(c)
        }
    }
    w.buf.WriteByte('"')
}

// PrettyIndent re-indents a compact JSON string.
func PrettyIndent(compact string, indent string) Try[string] {
    var out bytes.Buffer
    val err = json.Indent(&out, toBytes(compact), "", indent)
    if err != nil {
        return Failure[string](err)
    }
    return Success[string](out.String())
}

// --- Reader ---

// Reader implements FieldReader for JSON format.
// Pull-based tokenizer using Try[T] for idiomatic GALA error handling.
type Reader struct {
    var data          []byte
    var pos           int
    var stack         []byte
    var firstConsumed []bool
}

func NewReader(s string) *Reader = &Reader{data: toBytes(s), pos: 0}

func (r *Reader) BeginObject() Try[bool] {
    r.skipWhitespace()
    if r.pos >= len(r.data) || r.data[r.pos] != '{' {
        return Failure[bool](fmt.Errorf("json at pos %d: expected '{'", r.pos))
    }
    r.pos = r.pos + 1
    r.stack = append(r.stack, 'o')
    r.firstConsumed = append(r.firstConsumed, false)
    return Success[bool](true)
}

func (r *Reader) EndObject() Try[bool] {
    r.skipWhitespace()
    if r.pos >= len(r.data) || r.data[r.pos] != '}' {
        return Failure[bool](fmt.Errorf("json at pos %d: expected '}'", r.pos))
    }
    r.pos = r.pos + 1
    r.stack = TruncateBytes(r.stack, len(r.stack) - 1)
    r.firstConsumed = TruncateBools(r.firstConsumed, len(r.firstConsumed) - 1)
    return Success[bool](true)
}

func (r *Reader) BeginArray() Try[bool] {
    r.skipWhitespace()
    if r.pos >= len(r.data) || r.data[r.pos] != '[' {
        return Failure[bool](fmt.Errorf("json at pos %d: expected '['", r.pos))
    }
    r.pos = r.pos + 1
    r.stack = append(r.stack, 'a')
    r.firstConsumed = append(r.firstConsumed, false)
    return Success[bool](true)
}

func (r *Reader) EndArray() Try[bool] {
    r.skipWhitespace()
    if r.pos >= len(r.data) || r.data[r.pos] != ']' {
        return Failure[bool](fmt.Errorf("json at pos %d: expected ']'", r.pos))
    }
    r.pos = r.pos + 1
    r.stack = TruncateBytes(r.stack, len(r.stack) - 1)
    r.firstConsumed = TruncateBools(r.firstConsumed, len(r.firstConsumed) - 1)
    return Success[bool](true)
}

func (r *Reader) HasNextField() bool {
    r.skipWhitespace()
    if r.pos >= len(r.data) { return false }
    return r.data[r.pos] != '}'
}

func (r *Reader) HasNextElement() bool {
    r.skipWhitespace()
    if r.pos >= len(r.data) { return false }
    return r.data[r.pos] != ']'
}

func (r *Reader) NextKey() Try[string] {
    r.skipWhitespace()
    val depth = len(r.firstConsumed) - 1
    if depth >= 0 && r.firstConsumed[depth] {
        if r.pos < len(r.data) && r.data[r.pos] == ',' {
            r.pos = r.pos + 1
            r.skipWhitespace()
        }
    }
    if depth >= 0 { r.firstConsumed[depth] = true }

    val keyResult = r.readStringValue()
    if keyResult.IsFailure() { return keyResult }
    r.skipWhitespace()
    if r.pos >= len(r.data) || r.data[r.pos] != ':' {
        return Failure[string](fmt.Errorf("json at pos %d: expected ':'", r.pos))
    }
    r.pos = r.pos + 1
    return keyResult
}

func (r *Reader) ReadString() Try[string] {
    r.consumeArrayComma()
    r.skipWhitespace()
    return r.readStringValue()
}

func (r *Reader) ReadInt() Try[int] {
    r.consumeArrayComma()
    r.skipWhitespace()
    val numStr = r.readNumber()
    val v, err = strconv.Atoi(numStr)
    if err != nil {
        return Failure[int](fmt.Errorf("json at pos %d: invalid int: %s", r.pos, numStr))
    }
    return Success[int](v)
}

func (r *Reader) ReadFloat64() Try[float64] {
    r.consumeArrayComma()
    r.skipWhitespace()
    val numStr = r.readNumber()
    val v, err = strconv.ParseFloat(numStr, 64)
    if err != nil {
        return Failure[float64](fmt.Errorf("json at pos %d: invalid float64: %s", r.pos, numStr))
    }
    return Success[float64](v)
}

func (r *Reader) ReadBool() Try[bool] {
    r.consumeArrayComma()
    r.skipWhitespace()
    if r.pos + 4 <= len(r.data) && BytesToString(r.data, r.pos, r.pos + 4) == "true" {
        r.pos = r.pos + 4
        return Success[bool](true)
    }
    if r.pos + 5 <= len(r.data) && BytesToString(r.data, r.pos, r.pos + 5) == "false" {
        r.pos = r.pos + 5
        return Success[bool](false)
    }
    return Failure[bool](fmt.Errorf("json at pos %d: expected boolean", r.pos))
}

func (r *Reader) IsNull() bool {
    r.skipWhitespace()
    return r.pos + 4 <= len(r.data) && BytesToString(r.data, r.pos, r.pos + 4) == "null"
}

func (r *Reader) ReadNull() Try[bool] {
    r.consumeArrayComma()
    r.skipWhitespace()
    if r.pos + 4 <= len(r.data) && BytesToString(r.data, r.pos, r.pos + 4) == "null" {
        r.pos = r.pos + 4
        return Success[bool](true)
    }
    return Failure[bool](fmt.Errorf("json at pos %d: expected null", r.pos))
}

func (r *Reader) SkipValue() Try[bool] {
    r.consumeArrayComma()
    r.skipWhitespace()
    if r.pos >= len(r.data) {
        return Failure[bool](fmt.Errorf("json: unexpected end of input"))
    }
    val c = r.data[r.pos]
    if c == '"' {
        val res = r.readStringValue()
        if res.IsFailure() { return Failure[bool](res.GetError()) }
        return Success[bool](true)
    }
    if c == '{' { return r.skipContainer('{', '}') }
    if c == '[' { return r.skipContainer('[', ']') }
    if c == 't' || c == 'f' { return r.ReadBool() }
    if c == 'n' { return r.ReadNull() }
    r.readNumber()
    return Success[bool](true)
}

// --- internal helpers ---

func (r *Reader) skipWhitespace() {
    for r.pos < len(r.data) {
        val c = r.data[r.pos]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            r.pos = r.pos + 1
        } else {
            return
        }
    }
}

func (r *Reader) consumeArrayComma() {
    val depth = len(r.firstConsumed) - 1
    if depth >= 0 && len(r.stack) > 0 && r.stack[depth] == 'a' && r.firstConsumed[depth] {
        r.skipWhitespace()
        if r.pos < len(r.data) && r.data[r.pos] == ',' {
            r.pos = r.pos + 1
        }
    }
    if depth >= 0 && len(r.stack) > 0 && r.stack[depth] == 'a' {
        r.firstConsumed[depth] = true
    }
}

func (r *Reader) readStringValue() Try[string] {
    r.skipWhitespace()
    if r.pos >= len(r.data) || r.data[r.pos] != '"' {
        return Failure[string](fmt.Errorf("json at pos %d: expected '\"'", r.pos))
    }
    r.pos = r.pos + 1

    var sb strings.Builder
    for r.pos < len(r.data) {
        val c = r.data[r.pos]
        if c == '"' {
            r.pos = r.pos + 1
            return Success[string](sb.String())
        }
        if c == '\\' {
            r.pos = r.pos + 1
            if r.pos >= len(r.data) {
                return Failure[string](fmt.Errorf("json: unexpected end of escape"))
            }
            val esc = r.data[r.pos]
            r.pos = r.pos + 1
            if esc == '"' { sb.WriteByte('"') }
            else if esc == '\\' { sb.WriteByte('\\') }
            else if esc == '/' { sb.WriteByte('/') }
            else if esc == 'n' { sb.WriteByte('\n') }
            else if esc == 'r' { sb.WriteByte('\r') }
            else if esc == 't' { sb.WriteByte('\t') }
            else if esc == 'u' {
                if r.pos + 4 > len(r.data) {
                    return Failure[string](fmt.Errorf("json: incomplete unicode escape"))
                }
                val hexStr = BytesToString(r.data, r.pos, r.pos + 4)
                r.pos = r.pos + 4
                val cp, hexErr = strconv.ParseUint(hexStr, 16, 32)
                if hexErr != nil {
                    return Failure[string](fmt.Errorf("json: invalid unicode escape"))
                }
                sb.WriteString(RuneToString(rune(cp)))
            } else {
                return Failure[string](fmt.Errorf("json: invalid escape sequence"))
            }
        } else {
            sb.WriteByte(c)
            r.pos = r.pos + 1
        }
    }
    return Failure[string](fmt.Errorf("json: unterminated string"))
}

func (r *Reader) readNumber() string {
    val start = r.pos
    for r.pos < len(r.data) {
        val c = r.data[r.pos]
        if (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E' {
            r.pos = r.pos + 1
        } else {
            break
        }
    }
    return BytesToString(r.data, start, r.pos)
}

func (r *Reader) skipContainer(open byte, close byte) Try[bool] {
    if r.pos >= len(r.data) || r.data[r.pos] != open {
        return Failure[bool](fmt.Errorf("json: expected container start"))
    }
    r.pos = r.pos + 1
    var depth = 1
    var inString = false
    for r.pos < len(r.data) && depth > 0 {
        val c = r.data[r.pos]
        if inString {
            if c == '\\' {
                r.pos = r.pos + 1
            } else if c == '"' {
                inString = false
            }
        } else {
            if c == '"' { inString = true }
            else if c == open { depth = depth + 1 }
            else if c == close { depth = depth - 1 }
        }
        r.pos = r.pos + 1
    }
    if depth != 0 {
        return Failure[bool](fmt.Errorf("json: unterminated container"))
    }
    return Success[bool](true)
}
