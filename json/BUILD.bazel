load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_gala//gala:defs.bzl", "gala_bootstrap_transpile", "gala_test")
load("//internal/stdlib:shipped_sources.bzl", "stdlib_shipped_sources")

exports_files([
    "json.gala",
    "codec.gala",
    "helpers.gala",
    "naming.gala",
    "byte_utils.go",
])

filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

gala_bootstrap_transpile(
    name = "json_go",
    src = "json.gala",
    out = "json.gen.go",
)

gala_bootstrap_transpile(
    name = "codec_go",
    src = "codec.gala",
    out = "codec.gen.go",
)

gala_bootstrap_transpile(
    name = "naming_go",
    src = "naming.gala",
    out = "naming.gen.go",
)

gala_bootstrap_transpile(
    name = "helpers_go",
    src = "helpers.gala",
    out = "helpers.gen.go",
)

go_library(
    name = "json",
    srcs = [
        "byte_utils.go",
        "codec.gen.go",
        "helpers.gen.go",
        "json.gen.go",
        "naming.gen.go",
    ],
    importpath = "martianoff/gala/json",
    visibility = ["//visibility:public"],
    deps = [
        "//collection_immutable",
        "//go_interop",
        "//std",
    ],
)

go_test(
    name = "json_go_unit_test",
    srcs = ["codec_test.go"],
    embed = [":json"],
)

gala_test(
    name = "codec_roundtrip_test",
    srcs = ["codec_roundtrip_test.gala"],
    deps = [
        ":json",
        "//collection_immutable",
        "//yaml",
    ],
)

gala_test(
    name = "codec_omit_empty_test",
    srcs = ["codec_omit_empty_test.gala"],
    deps = [
        ":json",
        "//collection_immutable",
        "//yaml",
    ],
)

gala_test(
    name = "codec_root_shapes_test",
    srcs = ["codec_root_shapes_test.gala"],
    deps = [
        ":json",
        "//collection_immutable",
        "//yaml",
    ],
)

# Declares :shipped_sources for the stdlib embed completeness test.
stdlib_shipped_sources()
