package json

// Codec[T] is a type-safe, zero-reflection JSON codec.
// Uses builder pattern for configuration.
//
// The transpiler auto-injects StructMeta[T] when Codec[T]'s Apply method
// has a StructMetaOps parameter as its first argument. This means the user
// writes Codec[Person](SnakeCase()) and the transpiler expands it to:
//
//     Codec[Person]{}.Apply(_StructMeta_Person{}, SnakeCase{}.Apply())
//
// The _StructMeta_Person struct is generated by the StructMeta[T] compiler
// intrinsic and implements the StructMetaOps interface with typed field
// access methods (WriteTo, ReadFrom, WriteToAny, ReadFromAny).
//
// Usage:
//   val codec = Codec[Person](SnakeCase())
//       .Omit("Password")
//       .Rename("Email", "email_address")
//       .OmitEmpty("Bio")
//
//   codec.Encode(person)           // Try[string]
//   codec.Decode(jsonStr)          // Try[Person]
//   codec.EncodePretty(person)     // Try[string]
//
//   jsonStr match {
//       case codec(p) => s"Hello ${p.Name}"
//       case _ => "invalid"
//   }
type Codec[T any] struct {}

// Apply creates a typed JsonEncoder[T].
// The first parameter (meta StructMetaOps) is auto-injected by the transpiler
// when the user calls Codec[T](naming). The transpiler detects that Apply's
// first param is StructMetaOps, generates StructMeta[T], and prepends it.
func (c Codec[T]) Apply(meta StructMetaOps, naming Naming) JsonEncoder[T] {
    val config = NewKeyConfig().WithNaming(naming)
    return JsonEncoder[T]{
        Meta:   meta,
        Config: config,
        Keys:   BuildKeysSimple(meta.NumFields(), meta.FieldName, naming),
    }
}

// JsonEncoder[T] is a fully typed JSON codec instance.
// Created by Codec[T](naming) and configured via builder methods.
// All methods return new instances — JsonEncoder is immutable.
type JsonEncoder[T any] struct {
    Meta   StructMetaOps
    Config KeyConfig
    Keys   KeysConfig
}

// Naming sets the field naming strategy and returns a new encoder.
func (c JsonEncoder[T]) Naming(n Naming) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithNaming(n))

// Omit excludes a field from serialization/deserialization.
func (c JsonEncoder[T]) Omit(field string) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithOmit(field))

// Rename maps a GALA field name to a custom JSON key.
func (c JsonEncoder[T]) Rename(field string, key string) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithRename(field, key))

// OmitEmpty excludes a field when its value is zero.
func (c JsonEncoder[T]) OmitEmpty(field string) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithOmitEmpty(field))

func rebuildEncoder[T any](meta StructMetaOps, config KeyConfig) JsonEncoder[T] =
    JsonEncoder[T]{
        Meta:   meta,
        Config: config,
        Keys:   BuildKeys(meta.NumFields(), meta.FieldName, config.NamingStrategy, config),
    }

// Encode serializes a value to a compact JSON string (zero-reflection).
func (c JsonEncoder[T]) Encode(v T) Try[string] {
    val w = NewWriter()
    c.Meta.WriteToAny(v, w, c.Keys.Keys)
    return Success[string](w.String())
}

// EncodePretty serializes a value to a pretty-printed JSON string.
func (c JsonEncoder[T]) EncodePretty(v T) Try[string] {
    val result = c.Encode(v)
    if result.IsFailure() { return result }
    return PrettyIndent(result.Get(), "  ")
}

// Decode deserializes a JSON string into Try[T] (zero-reflection).
func (c JsonEncoder[T]) Decode(s string) Try[T] {
    val r = NewReader(s)
    val result = c.Meta.ReadFromAny(r, c.Keys.ReverseKeys)
    return Success[T](CastAny[T](result))
}

// Unapply attempts to decode a JSON string using the codec's naming config.
// Returns Option[T] for pattern matching support.
func (c JsonEncoder[T]) Unapply(s string) Option[T] {
    val r = NewReader(s)
    val beginResult = r.BeginObject()
    if beginResult.IsFailure() {
        return None[T]()
    }
    val result = c.Meta.ReadFromAny(r, c.Keys.ReverseKeys)
    return Some[T](CastAny[T](result))
}
