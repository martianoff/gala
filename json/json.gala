package json

import (
    . "martianoff/gala/std"
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/go_interop"
)

// Codec[T] is a type-safe, zero-reflection JSON codec.
// Uses builder pattern for configuration.
//
// The transpiler auto-injects StructMeta[T] when Codec[T]'s Apply method
// declares StructMeta[T] as its first parameter. This means the user
// writes Codec[Person](SnakeCase()) and the transpiler expands it to:
//
//     Codec[Person]{}.Apply(_StructMeta_Person{}, SnakeCase())
//
// _StructMeta_Person is generated by the StructMeta[T] compiler intrinsic
// and satisfies StructMeta[Person] — every method is fully typed end to
// end (no `any`, no runtime type assertions on user data).  The codec is
// a thin, format-agnostic library wrapper around that typed dispatch.
//
// Usage:
//   val codec = Codec[Person](SnakeCase())
//       .Omit("Password")
//       .Rename("Email", "email_address")
//       .OmitEmpty("Bio")
//
//   codec.Encode(person)           // Try[string]
//   codec.Decode(jsonStr)          // Try[Person]
//   codec.EncodePretty(person)     // Try[string]
//
//   jsonStr match {
//       case codec(p) => s"Hello ${p.Name}"
//       case _ => "invalid"
//   }
type Codec[T any] struct {}

// Apply creates a typed JsonEncoder[T].
// The first parameter (meta StructMeta[T]) is auto-injected by the transpiler
// when the user calls Codec[T](naming).
func (c Codec[T]) Apply(meta StructMeta[T], naming Naming) JsonEncoder[T] {
    val config = NewKeyConfig().WithNaming(naming)
    return JsonEncoder[T](
        Meta = meta,
        Config = config,
        Keys = BuildKeysSimple(meta.NumFields(), meta.FieldName, naming),
    )
}

// JsonEncoder[T] is a fully typed JSON codec instance.
// Created by Codec[T](naming) and configured via builder methods.
// All methods return new instances — JsonEncoder is immutable.
type JsonEncoder[T any] struct {
    Meta   StructMeta[T]
    Config KeyConfig
    Keys   KeysConfig
}

// Naming sets the field naming strategy and returns a new encoder.
func (c JsonEncoder[T]) Naming(n Naming) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithNaming(n))

// Omit excludes a field from serialization/deserialization.
func (c JsonEncoder[T]) Omit(field string) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithOmit(field))

// Rename maps a GALA field name to a custom JSON key.
func (c JsonEncoder[T]) Rename(field string, key string) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithRename(field, key))

// OmitEmpty leaves a field out of the encoded output whenever its value is
// empty: "" for a string kind, 0 for a numeric kind, false for bool, None for
// an Option, and no elements for an Array, List or HashMap. A nested struct is
// never empty. Decoding a document without the field gives it that empty
// value, so an omitted field round-trips.
func (c JsonEncoder[T]) OmitEmpty(field string) JsonEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithOmitEmpty(field))

func rebuildEncoder[T any](meta StructMeta[T], config KeyConfig) JsonEncoder[T] =
    JsonEncoder[T](
        Meta = meta,
        Config = config,
        Keys = BuildKeys(meta.NumFields(), meta.FieldName, config.NamingStrategy, config),
    )

// nameFnFromKeys returns a function that maps a field index to its serialized
// key.  An empty key signals an omitted field.
func nameFnFromKeys(keys Array[string]) func(int) string =
    (i int) => keys.GetOption(i).GetOrElse("")

// omitFnFromKeys returns a function that tests whether a field index is
// omitted — keys are pre-computed by BuildKeys and set to "" for omits.
func omitFnFromKeys(keys Array[string]) func(int) bool =
    (i int) => keys.GetOption(i).GetOrElse("") == ""

// namingFn is the codec's naming strategy as the key converter StructMeta
// threads into nested structs.
func namingFn(n Naming) func(string) string = (name) => ApplyNaming(name, n)

// writer returns the function that writes one T as a JSON object, with the
// codec's Naming/Rename/Omit/OmitEmpty applied. Array() and List() call it per
// element. Omit is settled once per codec; OmitEmpty depends on the value, so
// it is tested per value written.
func (c JsonEncoder[T]) writer() func(FieldEncoder, T) {
    val nameFn = nameFnFromKeys(c.Keys.Keys)
    val omitFn = omitFnFromKeys(c.Keys.Keys)
    val naming = namingFn(c.Config.NamingStrategy)
    val omitIfEmpty = c.Keys.OmitIfEmpty
    if !omitIfEmpty.Exists((b) => b) {
        return (w, v) => c.Meta.EncodeFields(w, v, nameFn, omitFn, naming)
    }
    (w, v) => {
        val omitValueFn = (i int) => omitFn(i) || (omitIfEmpty.Get(i) && c.Meta.FieldIsEmpty(v, i))
        c.Meta.EncodeFields(w, v, nameFn, omitValueFn, naming)
    }
}

// reader returns the function that reads one T from a JSON object. The key
// lookup is built once, so decoding an array of T pays for it once.
func (c JsonEncoder[T]) reader() func(FieldDecoder) T {
    val lookup = buildLookup(c.Keys.ReverseKeys, c.Meta.NumFields(), c.Meta.FieldName)
    val naming = namingFn(c.Config.NamingStrategy)
    (r) => c.Meta.DecodeFields(r, lookup, naming)
}

// encodeJson runs write against a fresh encoder and returns the document. An
// encoder panic (NaN, say) becomes a Failure.
func encodeJson(write func(FieldEncoder)) Try[string] = Try(() => {
    val w = NewJsonEncoder()
    write(w)
    w.String()
})

// decodeJson runs read over the whole of s: the read must consume the
// document, so trailing content is an error. A decoder panic (malformed
// input, wrong shape, out-of-range number) becomes a Failure.
func decodeJson[V any](s string, read func(FieldDecoder) V) Try[V] = Try(() => {
    val r = NewJsonDecoder(s)
    val v = read(r)
    r.End()
    v
})

// Encode serializes a value to a compact JSON string (zero-reflection).
func (c JsonEncoder[T]) Encode(v T) Try[string] {
    val write = c.writer()
    encodeJson((w) => write(w, v))
}

// EncodePretty serializes a value to a pretty-printed JSON string.
func (c JsonEncoder[T]) EncodePretty(v T) Try[string] =
    c.Encode(v).FlatMap((s) => PrettyIndent(s, "  "))

// Decode deserializes a JSON string into Try[T] (zero-reflection).
// DecodeFields panics on malformed input; Try() catches the panic and
// surfaces it as a Failure.
func (c JsonEncoder[T]) Decode(s string) Try[T] = decodeJson(s, (r) => {
    // Built inside the Try: a codec without metadata fails, not panics.
    val read = c.reader()
    read(r)
})

// Unapply attempts to decode a JSON string using the codec's naming config.
// Returns Option[T] for pattern matching support.
func (c JsonEncoder[T]) Unapply(s string) Option[T] = c.Decode(s).ToOption()

// Array returns a codec for a JSON document whose root is an array of T —
// `[{"id":1},{"id":2}]` — with this codec's Naming/Rename/Omit/OmitEmpty applied to
// every element.
func (c JsonEncoder[T]) Array() JsonArrayEncoder[T] = JsonArrayEncoder[T](Elem = c)

// List is Array for a List[T].
func (c JsonEncoder[T]) List() JsonListEncoder[T] = JsonListEncoder[T](Elem = c)

// JsonArrayEncoder[T] encodes and decodes a root JSON array of T objects.
// Created by Codec[T](naming).Array(); configure the element codec first.
type JsonArrayEncoder[T any] struct {
    Elem JsonEncoder[T]
}

// encodeElems writes the elements as a JSON array.
func (c JsonEncoder[T]) encodeElems(vs Traversable[T]) Try[string] {
    val write = c.writer()
    encodeJson((w) => {
        w.WriteStartArray()
        vs.ForEach((v) => write(w, v))
        w.WriteEndArray()
    })
}

// readElems reads a JSON array of objects, in order. Like the generated
// decoder of an Array or List field, it collects into a Go slice and builds
// the collection once, instead of a persistent Append per element.
func readElems[T any](r FieldDecoder, read func(FieldDecoder) T) []T {
    r.StartArray()
    // A pull parser: the element count is unknown until the decoder reports
    // the end of the array, so there is no combinator to fold over.
    var buf = go_interop.SliceEmpty[T]()
    for r.HasMoreElements() {
        buf = go_interop.SliceAppend(buf, read(r))
    }
    r.EndArray()
    buf
}

// Encode serializes the elements as a compact JSON array.
func (c JsonArrayEncoder[T]) Encode(vs Array[T]) Try[string] = c.Elem.encodeElems(vs)

// EncodePretty serializes the elements as a pretty-printed JSON array.
func (c JsonArrayEncoder[T]) EncodePretty(vs Array[T]) Try[string] =
    c.Encode(vs).FlatMap((s) => PrettyIndent(s, "  "))

// Decode reads a JSON array of objects. Anything else at the root — an
// object, a scalar, null — is a Failure.
func (c JsonArrayEncoder[T]) Decode(s string) Try[Array[T]] =
    decodeJson(s, (r) => ArrayFromSlice(readElems(r, c.Elem.reader())))

// Unapply decodes for pattern matching.
func (c JsonArrayEncoder[T]) Unapply(s string) Option[Array[T]] = c.Decode(s).ToOption()

// JsonListEncoder[T] is JsonArrayEncoder[T] over List[T].
// Created by Codec[T](naming).List().
type JsonListEncoder[T any] struct {
    Elem JsonEncoder[T]
}

// Encode serializes the elements as a compact JSON array.
func (c JsonListEncoder[T]) Encode(vs List[T]) Try[string] = c.Elem.encodeElems(vs)

// EncodePretty serializes the elements as a pretty-printed JSON array.
func (c JsonListEncoder[T]) EncodePretty(vs List[T]) Try[string] =
    c.Encode(vs).FlatMap((s) => PrettyIndent(s, "  "))

// Decode reads a JSON array of objects into a List.
func (c JsonListEncoder[T]) Decode(s string) Try[List[T]] =
    decodeJson(s, (r) => ListFromSlice(readElems(r, c.Elem.reader())))

// Unapply decodes for pattern matching.
func (c JsonListEncoder[T]) Unapply(s string) Option[List[T]] = c.Decode(s).ToOption()

// Value[T] is a codec for a JSON document of any shape a codec field can
// have — a scalar (`42`, `"abc"`, `true`), an Option (None is `null`), an
// Array or List (`[1,2,3]`), a HashMap[string, _], a struct, nested to any
// depth. The transpiler auto-injects ValueMeta[T]:
//
//     Value[Array[int]]()  →  Value[Array[int]]{}.Apply(_ValueMeta_Array_int{})
//
// Usage:
//   Value[int]().Decode("42")                     // Success(42)
//   Value[Array[string]]().Encode(ArrayOf("a"))   // Success(["a"])
//   Value[Array[User]]().Naming(SnakeCase())      // structs inside the value
//
// To Rename or Omit fields of a struct element, use Codec[T](naming).Array().
type Value[T any] struct {}

// Apply creates a JsonValueEncoder[T]. The meta parameter is auto-injected by
// the transpiler when the user calls Value[T]().
func (c Value[T]) Apply(meta ValueMeta[T]) JsonValueEncoder[T] =
    JsonValueEncoder[T](Meta = meta, NamingStrategy = AsIs())

// JsonValueEncoder[T] is a fully typed JSON codec for a value of any codec
// shape. Created by Value[T](); immutable.
type JsonValueEncoder[T any] struct {
    Meta           ValueMeta[T]
    NamingStrategy Naming
}

// Naming sets the key naming for structs reached inside the value.
func (c JsonValueEncoder[T]) Naming(n Naming) JsonValueEncoder[T] = c.Copy(NamingStrategy = n)

// Encode serializes the value to compact JSON.
func (c JsonValueEncoder[T]) Encode(v T) Try[string] =
    encodeJson((w) => c.Meta.EncodeValue(w, v, namingFn(c.NamingStrategy)))

// EncodePretty serializes the value to pretty-printed JSON.
func (c JsonValueEncoder[T]) EncodePretty(v T) Try[string] =
    c.Encode(v).FlatMap((s) => PrettyIndent(s, "  "))

// Decode reads a JSON document of T's shape. A document of another shape, or
// a number outside T's range, is a Failure.
func (c JsonValueEncoder[T]) Decode(s string) Try[T] =
    decodeJson(s, (r) => c.Meta.DecodeValue(r, namingFn(c.NamingStrategy)))

// Unapply decodes for pattern matching.
func (c JsonValueEncoder[T]) Unapply(s string) Option[T] = c.Decode(s).ToOption()

// buildLookup turns the precomputed reverseKeys map (serialized key → GALA
// field name) into the index-lookup function DecodeFields expects.
func buildLookup(
    reverseKeys HashMap[string, string],
    numFields int,
    fieldName func(int) string,
) func(string) int {
    var nameToIdx = EmptyHashMap[string, int]()
    var i = 0
    for i < numFields {
        nameToIdx = nameToIdx.Put(fieldName(i), i)
        i = i + 1
    }
    return (key string) =>
        reverseKeys.Get(key).FlatMap((gName) => nameToIdx.Get(gName)).GetOrElse(-1)
}
