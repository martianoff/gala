package json

import (
    . "martianoff/gala/collection_immutable"
)

// KeyConfig holds field-level configuration for JSON serialization.
type KeyConfig struct {
    NamingStrategy Naming
    Renames        HashMap[string, string]
    Omits          HashMap[string, bool]
    OmitEmpties    HashMap[string, bool]
}

func NewKeyConfig() KeyConfig = KeyConfig(
    NamingStrategy = AsIs(),
    Renames = EmptyHashMap[string, string](),
    Omits = EmptyHashMap[string, bool](),
    OmitEmpties = EmptyHashMap[string, bool](),
)

func (c KeyConfig) WithNaming(n Naming) KeyConfig = c.Copy(NamingStrategy = n)

func (c KeyConfig) WithRename(field string, key string) KeyConfig =
    c.Copy(Renames = c.Renames.Put(field, key))

func (c KeyConfig) WithOmit(field string) KeyConfig =
    c.Copy(Omits = c.Omits.Put(field, true))

func (c KeyConfig) WithOmitEmpty(field string) KeyConfig =
    c.Copy(OmitEmpties = c.OmitEmpties.Put(field, true))

// KeysConfig holds the computed per-field encoding plan: Keys(i) is field i's
// serialized key ("" when the field is omitted), and OmitIfEmpty(i) says
// whether field i is left out of the output when its value is empty (never
// true for an omitted field).
type KeysConfig struct {
    Keys        Array[string]
    ReverseKeys HashMap[string, string]
    OmitIfEmpty Array[bool]
}

// BuildKeys computes serialization keys from metadata, naming, and config.
func BuildKeys(numFields int, fieldName func(int) string, naming Naming, config KeyConfig) KeysConfig {
    var keys = EmptyArray[string]()
    var reverseKeys = EmptyHashMap[string, string]()
    var omitIfEmpty = EmptyArray[bool]()
    var i = 0
    for i < numFields {
        val name = fieldName(i)
        if config.Omits.Contains(name) {
            keys = keys.Append("")
            omitIfEmpty = omitIfEmpty.Append(false)
        } else {
            val renamed = config.Renames.Get(name)
            val key = renamed.GetOrElse(ApplyNaming(name, naming))
            keys = keys.Append(key)
            reverseKeys = reverseKeys.Put(key, name)
            omitIfEmpty = omitIfEmpty.Append(config.OmitEmpties.Contains(name))
        }
        i = i + 1
    }
    KeysConfig(Keys = keys, ReverseKeys = reverseKeys, OmitIfEmpty = omitIfEmpty)
}

// BuildKeysSimple computes keys with a naming strategy and no overrides.
func BuildKeysSimple(numFields int, fieldName func(int) string, naming Naming) KeysConfig =
    BuildKeys(numFields, fieldName, naming, NewKeyConfig())
