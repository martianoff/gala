load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_gala//gala:defs.bzl", "gala_bootstrap_transpile", "gala_test")

exports_files([
    "subprocess.gala",
    "async.gala",
    "subprocess.go",
])

filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

gala_bootstrap_transpile(
    name = "subprocess_go",
    src = "subprocess.gala",
    out = "subprocess.gen.go",
)

gala_bootstrap_transpile(
    name = "async_go",
    src = "async.gala",
    out = "async.gen.go",
)

go_library(
    name = "subprocess",
    srcs = [
        "async.gen.go",
        "subprocess.gen.go",
        "subprocess.go",
    ],
    importpath = "martianoff/gala/subprocess",
    visibility = ["//visibility:public"],
    deps = [
        "//concurrent",
        "//go_interop",
        "//resource",
        "//std",
        "//time_utils",
    ],
)

go_test(
    name = "subprocess_test",
    srcs = ["subprocess_test.go"],
    data = ["//subprocess/testdata/echoecho"],
    embed = [":subprocess"],
    deps = ["@rules_go//go/runfiles"],
)

gala_test(
    name = "async_test",
    srcs = ["async_test.gala"],
    deps = [
        ":subprocess",
        "//concurrent",
        "//go_interop",
        "//time_utils",
    ],
)

# Every non-test source file this package ships. The released CLI embeds a
# snapshot of the stdlib (//internal/stdlib:generate_embedded); its
# completeness test compares that snapshot against this glob, so a new file
# here that is not added to the embed fails bazel test, not the released CLI.
filegroup(
    name = "shipped_sources",
    srcs = glob(
        [
            "*.gala",
            "*.go",
        ],
        exclude = [
            "*_test.gala",
            "*_test.go",
            "*.gen.go",
        ],
        # A pure-Go or pure-GALA package leaves one pattern empty.
        allow_empty = True,
    ),
    visibility = ["//internal/stdlib:__pkg__"],
)
