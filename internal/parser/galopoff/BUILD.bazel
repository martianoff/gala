load("@rules_go//go:def.bzl", "go_library")

# Stands in for //internal/parser/galop, under its import path, in builds
# without galop's parser (see //internal/parser:parser).
go_library(
    name = "galopoff",
    srcs = ["galop.go"],
    importpath = "martianoff/gala/internal/parser/galop",  # keep
    visibility = ["//internal/parser:__pkg__"],
    deps = [
        "//internal/parser/grammar",
        "//internal/parser/nativeoff",  # keep: stands in for //internal/parser/native
        "@com_github_antlr4_go_antlr_v4//:antlr",
    ],
)
