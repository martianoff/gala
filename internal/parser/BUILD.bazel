load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "parser",
    srcs = [
        "docs.go",
        "expr_native.go",
        "go_directive.go",
        "go_func_literal.go",
        "go_habits.go",
        "native_errors.go",
        "native_lex.go",
        "native_tree.go",
        "newline.go",
        "panic.go",
        "parser.go",
        "source_chars.go",
        "type_text_native.go",
    ],
    importpath = "martianoff/gala/internal/parser",
    visibility = ["//:__subpackages__"],
    deps = [
        "//galaerr",
        "//internal/parser/native",  # keep: generated, gazelle cannot resolve it
    ],
)

go_test(
    name = "parser_test",
    # TestParserGolden re-parses every file of the frozen corpus about a dozen
    # ways, and the corpus tests read every GALA source of the repository:
    # well under a minute on a 32-thread machine, more on CI's 4-core runners.
    size = "large",
    srcs = [
        "bare_lambda_param_test.go",
        "bom_test.go",
        "broken_parse_bench_test.go",
        "docs_test.go",
        "empty_line_unicode_test.go",
        "fuzz_test.go",
        "go_func_literal_test.go",
        "go_habits_test.go",
        "go_type_in_expression_test.go",
        "golden_test.go",
        "grammar_test.go",
        "inputs_test.go",
        "native_lex_test.go",
        "native_tree_test.go",
        "newline_test.go",
        "parser_concurrent_test.go",
        "parser_test.go",
        "source_chars_test.go",
        "struct_tag_test.go",
        "type_text_native_test.go",
        "type_text_test.go",
    ],
    # The corpus tests (TestNativeLexCorpus, TestRecoveredTrees) and the fuzz
    # seeds read every GALA source of the repository.
    data = glob(["testdata/**"]) + [
        "//:all_gala_sources",
        "//examples:all_gala_sources",
        "//lazy:gala_sources",
        "//resource:gala_sources",
        "//std:gala_sources",
        "//stream:gala_sources",
        "//subprocess:gala_sources",
        "//test:gala_sources",
    ],
    embed = [":parser"],
    deps = [
        "//galaerr",
        "//internal/digestgolden",
        "//internal/parser/native",  # keep
        "//internal/testcorpus",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/tools/bazel",
    ],
)
