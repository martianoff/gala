load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# `bazel build --//internal/parser:antlr ...` builds GALA to parse with ANTLR's
# parser by default (see engine.go). galop's parser is built in either way, so
# the CLI's --parser flag and GALA_PARSER still choose per process.
bool_flag(
    name = "antlr",
    build_setting_default = False,
)

config_setting(
    name = "antlr_default",
    flag_values = {":antlr": "true"},
)

go_library(
    name = "parser",
    srcs = [
        "docs.go",
        "engine.go",
        "expr_native.go",
        "native_tree.go",
        "newline.go",
        "parser.go",
        "source_chars.go",
        "type_text.go",
        "type_text_native.go",
    ],
    importpath = "martianoff/gala/internal/parser",
    visibility = ["//:__subpackages__"],
    x_defs = select({
        ":antlr_default": {"martianoff/gala/internal/parser.defaultEngine": "antlr"},
        "//conditions:default": {},
    }),
    deps = [
        "//galaerr",
        "//internal/parser/galop",
        "//internal/parser/grammar",
        "//internal/parser/native",  # keep: generated, gazelle cannot resolve it
        "@com_github_antlr4_go_antlr_v4//:antlr",
    ],
)

go_test(
    name = "parser_test",
    srcs = [
        "bare_lambda_param_test.go",
        "bom_test.go",
        "docs_test.go",
        "empty_line_unicode_test.go",
        "engine_test.go",
        "go_type_in_expression_test.go",
        "grammar_test.go",
        "native_handle_test.go",
        "native_tree_test.go",
        "newline_test.go",
        "parse_expression_at_test.go",
        "parser_concurrent_test.go",
        "parser_test.go",
        "source_chars_test.go",
        "struct_tag_test.go",
        "type_text_native_test.go",
        "type_text_test.go",
    ],
    # engine_test.go parses every GALA source of the repository with both
    # engines.
    data = [
        "//:all_gala_sources",
        "//examples:all_gala_sources",
        "//lazy:gala_sources",
        "//resource:gala_sources",
        "//std:gala_sources",
        "//stream:gala_sources",
        "//subprocess:gala_sources",
        "//test:gala_sources",
    ],
    embed = [":parser"],
    deps = [
        "//galaerr",
        "//internal/parser/grammar",
        "//internal/parser/native",  # keep
        "@com_github_antlr4_go_antlr_v4//:antlr",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/tools/bazel",
    ],
)

# The fallback test compiles a file through the whole pipeline with its
# native tree's bridge broken, so it needs the transpiler; it stays out of
# parser_test, which the race lane runs.
# gazelle:exclude misbridge_export_test.go
# gazelle:exclude native_fallback_test.go
go_test(
    # keep
    name = "native_fallback_test",
    srcs = [
        "misbridge_export_test.go",
        "native_fallback_test.go",
    ],
    data = [
        "//go_builtins:builtins.go",
        "//go_interop:types.go",
        "//std:gala_sources",
    ],
    embed = [":parser"],
    deps = [
        "//internal/parser/native",  # keep
        "//internal/transpiler",
        "//internal/transpiler/analyzer",
        "//internal/transpiler/generator",
        "//internal/transpiler/transformer",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/tools/bazel",
    ],
)
