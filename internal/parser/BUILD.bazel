load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# `bazel build --//internal/parser:antlr ...` builds GALA with ANTLR's parser
# alone, leaving galop's out (see engine.go). Without it, galop's parser is
# built in (//internal/parser/grammar:galop_enabled), which needs a galop
# toolchain for the build host; the CLI's --parser flag and GALA_PARSER then
# choose per process.
bool_flag(
    name = "antlr",
    build_setting_default = False,
)

config_setting(
    name = "galop_wanted",
    flag_values = {":antlr": "false"},
    visibility = ["//internal/parser:__subpackages__"],
)

go_library(
    name = "parser",
    srcs = [
        "docs.go",
        "engine.go",
        "newline.go",
        "parser.go",
        "source_chars.go",
        "type_text.go",
    ],
    importpath = "martianoff/gala/internal/parser",
    visibility = ["//:__subpackages__"],
    deps = [
        "//galaerr",
        "//internal/parser/grammar",
        "@com_github_antlr4_go_antlr_v4//:antlr",
    ] + select({
        # internal/parser/galop, or its stand-in under the same import path.
        "//internal/parser/grammar:galop_enabled": ["//internal/parser/galop"],
        "//conditions:default": ["//internal/parser/galopoff"],
    }),
)

go_test(
    name = "parser_test",
    srcs = [
        "bare_lambda_param_test.go",
        "bom_test.go",
        "docs_test.go",
        "empty_line_unicode_test.go",
        "engine_test.go",
        "go_type_in_expression_test.go",
        "grammar_test.go",
        "newline_test.go",
        "parse_expression_at_test.go",
        "parser_concurrent_test.go",
        "parser_test.go",
        "source_chars_test.go",
        "struct_tag_test.go",
        "type_text_test.go",
    ],
    # engine_test.go parses every GALA source of the repository with both
    # engines.
    data = [
        "//:all_gala_sources",
        "//examples:all_gala_sources",
        "//lazy:gala_sources",
        "//resource:gala_sources",
        "//std:gala_sources",
        "//stream:gala_sources",
        "//subprocess:gala_sources",
        "//test:gala_sources",
    ],
    embed = [":parser"],
    deps = [
        "//galaerr",
        "//internal/parser/grammar",
        "@com_github_antlr4_go_antlr_v4//:antlr",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/tools/bazel",
    ],
)
