load("@rules_gala//galop:defs.bzl", "galop_parser")
load("@rules_go//go:def.bzl", "go_library")

# galop's native parser and tree for gala.g4: compact tokens and nodes with
# typed handles, Kind(), Typed(), a listener and a visitor. galop's antlr
# flavor writes the converter from ANTLR's trees to it (see
# internal/parser/grammar); internal/parser hands it out with each parse
# (parser.Native).
galop_parser(
    name = "gala_native_galop",
    galop_opts = ["-visitor"],
    grammar = "//internal/parser/grammar:gala.g4",
    package = "native",
)

# keep: its sources are generated, so gazelle sees none.
go_library(
    name = "native",
    srcs = [":gala_native_galop"],
    importpath = "martianoff/gala/internal/parser/native",
    visibility = ["//visibility:public"],
)
