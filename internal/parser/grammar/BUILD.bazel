load("@rules_gala//galop:defs.bzl", "galop_parser")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

genrule(
    name = "gala_grammar_go",
    srcs = ["gala.g4"],
    outs = [
        "gala_base_listener.go",
        "gala_lexer.go",
        "gala_listener.go",
        "gala_parser.go",
    ],
    cmd = """
        set -e && \
        export PATH="/usr/bin:/bin:$$PATH" && \
        ANTLR_OUT=antlr_tmp_$$$$ && \
        mkdir -p $$ANTLR_OUT && \
        "$(JAVA)" -jar $(location @antlr4_tool//jar) -Dlanguage=Go -package grammar -o $$ANTLR_OUT $(location gala.g4) && \
        find $$ANTLR_OUT -name '*.go' -type f | while read f; do \
            sed 's|github.com/antlr/antlr4/runtime/Go/antlr|github.com/antlr4-go/antlr/v4|g' "$$f" > "$(@D)/$$(basename $$f)"; \
        done && \
        rm -rf $$ANTLR_OUT
    """,
    toolchains = ["@bazel_tools//tools/jdk:current_host_java_runtime"],
    tools = ["@antlr4_tool//jar"],
)

# galop's lexer and parser for the same grammar, in its antlr flavor: they build
# the context types ANTLR generates above, so they share this package and every
# consumer of the tree works with either parser (see internal/parser). With
# nativePackage galop also writes gala_galop_native.go, the converter from
# these trees (and ANTLR's, error-recovered ones included) to the native tree
# of internal/parser/native.
#
# galop runs on the build host, from the prebuilt binaries rules_gala
# registers; building GALA needs one (see CONTRIBUTING.MD for the hosts).
galop_parser(
    name = "gala_grammar_galop",
    defines = {"nativePackage": "martianoff/gala/internal/parser/native"},
    flavor = "antlr",
    grammar = "gala.g4",
    package = "grammar",
)

go_library(
    name = "grammar",
    srcs = [
        "gala_base_listener.go",
        "gala_lexer.go",
        "gala_listener.go",
        "gala_parser.go",
        ":gala_grammar_galop",  # keep
    ],
    importpath = "martianoff/gala/internal/parser/grammar",
    visibility = ["//visibility:public"],
    deps = [
        # gala_galop_native.go, generated, imports the native tree.
        "//internal/parser/native",  # keep
        "@com_github_antlr4_go_antlr_v4//:antlr",
    ],
)

exports_files(["gala.g4"])

# --- IntelliJ Plugin: Generate Java lexer/parser from patched grammar ---
# The antlr4-intellij-adaptor requires WS/comments on channel(HIDDEN), not skipped.

genrule(
    name = "gala_grammar_java",
    srcs = ["gala.g4"],
    outs = [
        "galaBaseListener.java",
        "galaBaseVisitor.java",
        "galaLexer.java",
        "galaListener.java",
        "galaParser.java",
        "galaVisitor.java",
    ],
    cmd = """
        set -e && \
        export PATH="/usr/bin:/bin:$$PATH" && \
        ANTLR_OUT=antlr_java_out_$$$$ && \
        mkdir -p $$ANTLR_OUT && \
        sed 's/-> skip/-> channel(HIDDEN)/g' $(location gala.g4) > $$ANTLR_OUT/gala.g4 && \
        "$(JAVA)" -jar $(location @antlr4_tool//jar) \
            -Dlanguage=Java \
            -package org.gala.ide.intellij.parser \
            -visitor \
            -listener \
            -Xexact-output-dir \
            -o $$ANTLR_OUT \
            $$ANTLR_OUT/gala.g4 && \
        cp $$ANTLR_OUT/*.java "$(@D)/" && \
        rm -rf $$ANTLR_OUT
    """,
    toolchains = ["@bazel_tools//tools/jdk:current_host_java_runtime"],
    tools = ["@antlr4_tool//jar"],
    visibility = ["//visibility:public"],
)

# Copy generated Java sources into the IntelliJ plugin's gen directory.
# Usage: bazel run //internal/parser/grammar:copy_java_to_ide
sh_binary(
    name = "copy_java_to_ide",
    srcs = ["copy_java_to_ide.sh"],
    data = [
        ":galaBaseListener.java",
        ":galaBaseVisitor.java",
        ":galaLexer.java",
        ":galaListener.java",
        ":galaParser.java",
        ":galaVisitor.java",
    ],
)
