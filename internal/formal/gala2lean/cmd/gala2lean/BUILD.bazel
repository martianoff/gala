load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gala2lean_lib",
    srcs = ["main.go"],
    importpath = "martianoff/gala/internal/formal/gala2lean/cmd/gala2lean",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/formal/coreexport",
        "//internal/formal/coreexport/analyzerhints",
        "//internal/formal/gala2lean",
    ],
)

# Translates .gala files to Lean. A development tool only, never part of the
# gala CLI.
go_binary(
    name = "gala2lean",
    embed = [":gala2lean_lib"],
    visibility = ["//internal/formal:__subpackages__"],
)
