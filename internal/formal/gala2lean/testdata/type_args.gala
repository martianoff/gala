package main

import . "martianoff/gala/collection_immutable"

// Explicit type arguments, `F[T](args)`, are passed to Lean as written. In
// some calls nothing else says what the type is: an empty collection
// printed, a None compared.

struct Box[T any](Value T)

func id[T any](x T) T = x

func second[A any, B any](a A, b B) B = b

func firsts[T any](xs Array[T], n int) Array[T] = xs.Take(n)

func main() {
    Println(id[int](3), id[string]("s"))
    Println(second[int, string](1, "one"))
    Println(EmptyArray[int](), EmptyList[string]().Size())
    Println(ArrayOf[int](1, 2), ListOf[string]("a"))
    Println(None[string]() == None[string](), Some[int](2) == Some(2))
    Println(None[int](), Some[string]("x"), Left[string, int]("l"), Right[string, int](4))
    Println(Box[int](5).Value, Box[string]("b"))
    Println(firsts[int](ArrayOf(7, 8, 9), 2))
}
