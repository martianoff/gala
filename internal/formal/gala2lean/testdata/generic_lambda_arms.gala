package main

// Lambdas that reach a generic function's parameter as the arms of a match
// take that parameter's type, its type arguments read from the arms.

func run[A any, B any](f func(A) B) func(A) B = f

func apply[T any](x T, f func(T) T) T = f(x)

sealed type Shape {
    case Circle(R int)
    case Square(S int)
}

func pick(n int) func(int) int = run(n match {
    case 1 => (k int) => {
        val q = k + 1
        q * q
    }
    case _ => (k int) => {
        val q = k + n
        q * q
    }
})

// An arm's binder shadows a parameter of another type.
func label(n int, o Option[string]) func(int) string = run(o match {
    case Some(n) => (k int) => {
        val r = n + "!"
        r + r
    }
    case _ => (k int) => {
        val r = s"$k/$n"
        r
    }
})

// An arm's lambda ends in a literal, the other in an int64: both are
// func(int64) int64.
func widened(n int, big int64) int64 = apply(big, n match {
    case 1 => (v int64) => 0
    case _ => (v int64) => {
        val w = v + 1
        w
    }
})

// Arms that build different cases of one sealed type.
func shape(n int) func(int) Shape = run(n match {
    case 1 => (k int) => Circle(k)
    case _ => (k int) => Square(k * 2)
})

func area(s Shape) int = s match {
    case Circle(r) => 3 * r * r
    case Square(x) => x * x
}

func main() {
    Println(pick(1)(3), pick(2)(3))
    Println(label(7, Some("a"))(1), label(7, None[string]())(2))
    Println(widened(1, 1 << 40), widened(2, 1 << 40))
    Println(area(shape(1)(2)), area(shape(2)(2)))
}
