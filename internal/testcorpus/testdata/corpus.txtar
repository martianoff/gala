-- examples/some_type_inference.gala --
package main

import "fmt"

// externalCall simulates an external Go function whose return type
// the GALA transpiler cannot statically infer.
func externalCall(key string) string {
    return fmt.Sprintf("value_%s", key)
}

// Some(v) should infer Option[string] from the function return type
// when the argument type cannot be determined from the expression.
func findValue(name string) Option[string] {
    val v = externalCall(name)
    if v == "" {
        return None[string]()
    }
    return Some(v)
}

// Also test with Either sealed type
func classify(n int) Either[string, int] {
    if n < 0 {
        return Left(externalCall("negative"))
    }
    return Right(n)
}

func main() {
    val result = findValue("test")
    result match {
        case Some(v) => Println(s"Found: $v")
        case None() => Println("Not found")
    }

    val classified = classify(42)
    classified match {
        case Left(msg) => Println(s"Left: $msg")
        case Right(n) => Println(s"Right: $n")
    }
}
-- examples/sort_stable.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    m "martianoff/gala/collection_mutable"
)

// Sorted, SortWith and SortBy are stable in both collection libraries: elements
// whose keys compare equal keep their original relative order.

struct Row(Name string, K int)

func main() {
    val rows = ArrayOf(Row("a", 1), Row("b", 0), Row("c", 1), Row("d", 0))
    Println(rows.SortBy((r) => r.K).Map((r) => r.Name))

    // With every key equal, a stable sort returns the input unchanged.
    val same = ArrayOf(Row("a", 0), Row("b", 0), Row("c", 0), Row("d", 0))
    Println(same.SortBy((r) => r.K).Map((r) => r.Name))
    Println(same.SortWith((x, y) => x.K < y.K).Map((r) => r.Name))
    Println(same.ToList().SortBy((r) => r.K).Map((r) => r.Name))

    // More than 12 elements, so the mutable sort goes past insertion sort.
    val big = ArrayTabulate(40, (i) => Row(string(rune('A' + i % 26)), i % 2))
    val sorted = m.ArrayFromSlice(big.ToGoSlice()).SortBy((r) => r.K)
    Println(sorted.Map((r) => r.Name).MkString(""))
}
-- examples/sorted.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"

func main() {
    // Array.Sorted
    val arr = ArrayOf(3, 1, 4, 1, 5, 9)
    fmt.Println(arr.Sorted())

    // Array.SortWith (descending)
    fmt.Println(arr.SortWith((a, b) => a > b))

    // Array.SortBy (by absolute distance from 5)
    val arr2 = ArrayOf(1, 9, 3, 7, 5)
    fmt.Println(arr2.SortBy((x) => x))

    // List.Sorted
    val list = ListOf("banana", "apple", "cherry")
    fmt.Println(list.Sorted())

    // TreeSet.Sorted (already sorted)
    val tree = TreeSetOf(30, 10, 20)
    fmt.Println(tree.Sorted())

    // HashSet.Sorted
    val set = HashSetOf(5, 3, 1)
    fmt.Println(set.Sorted())

    // Empty
    fmt.Println(EmptyArray[int]().Sorted())
}
-- examples/sorted_mutable.gala --
package main

import "fmt"
import . "martianoff/gala/collection_mutable"

func main() {
    // Array.Sorted
    var arr = ArrayOf(3, 1, 4, 1, 5, 9)
    fmt.Println(arr.Sorted())

    // Array.SortWith (descending)
    fmt.Println(arr.SortWith((a, b) => a > b))

    // Array.SortBy
    var arr2 = ArrayOf(1, 9, 3, 7, 5)
    fmt.Println(arr2.SortBy((x) => x))

    // List.Sorted
    var list = ListOf("banana", "apple", "cherry")
    fmt.Println(list.Sorted())

    // List.SortWith (descending)
    fmt.Println(list.SortWith((a, b) => a > b))

    // TreeSet.Sorted (already sorted)
    var tree = TreeSetOf(30, 10, 20)
    fmt.Println(tree.Sorted())

    // HashSet.Sorted
    var set = HashSetOf(5, 3, 1)
    fmt.Println(set.Sorted())

    // HashMap.SortBy (by key)
    var m = EmptyHashMap[int, string]()
    m.Put(3, "three")
    m.Put(1, "one")
    m.Put(2, "two")
    fmt.Println(m.SortBy((t) => t.V1))

    // Empty
    fmt.Println(EmptyArray[int]().Sorted())

    // Original unchanged after sorting
    fmt.Println(arr)
}
-- examples/sourcemap_imports_demo.gala --
package main

import . "martianoff/gala/std"
import . "martianoff/gala/go_interop"

// Verification: source-mapped //line directives work for programs that USE
// imports. Bazel builds this with a real .gala file path, so //line directives
// are injected while the full dependency graph (std + go_interop) is resolved
// and compiled — the generated binary still runs correctly. Exercises a GALA std
// export (Option.GetOrElse) and Go interop (SliceOf / slice .Size()).
func main() {
    val nums = SliceOf(10, 20, 30)
    val tag = Some("imports").GetOrElse("none")
    Println(s"sourcemap $tag demo: size=${nums.Size()}")
}
-- examples/spread_operator.gala --
package main

import "fmt"
import . "martianoff/gala/go_interop"

func printAll(items ...string) {
    for _, item := range items {
        fmt.Println(item)
    }
}

func wrap(items ...string) {
    printAll(items...)
}

func main() {
    val args = SliceOf("hello", "world", "spread")
    printAll(args...)
    wrap("a", "b", "c")
