-- examples/interface_literal.gala --
package main

import (
    "fmt"
    "io"
    "sort"
    . "martianoff/gala/collection_mutable"
)

// An interface literal builds a value of an interface from one function per
// method, each argument named after the method it implements.

struct User(Id int, Name string)

type UserRepo interface {
    Find(id int) Option[User]
    Count() int
}

type Box[T any] interface {
    Get() T
    Map(f func(T) T) T
}

type Logger interface {
    Log(prefix string, parts ...string)
}

struct MemRepo(name string)
func (r MemRepo) Find(id int) Option[User] = Some(User(id, r.name))

func describe(r UserRepo, id int) string = r.Find(id) match {
    case Some(u) => s"${u.Name} of ${r.Count()}"
    case None() => s"no user $id"
}

// The expected result type gives the generic interface its type argument.
func constant[T any](v T) Box[T] = Box(Get = () => v, Map = (f) => f(v))

func main() {
    // Lambda parameter types come from the method signatures.
    val repo = UserRepo(
        Find = (id) => When(id == 1, User(1, "Ada")),
        Count = () => 1,
    )
    Println(describe(repo, 1))
    Println(describe(repo, 2))

    // A method value implements a method too.
    val mem = MemRepo("mem")
    Println(describe(UserRepo(Find = mem.Find, Count = () => 7), 3))

    // A literal can close over local state.
    var calls = 0
    val counting = UserRepo(
        Find = (id) => {
            calls = calls + 1
            None()
        },
        Count = () => calls,
    )
    counting.Find(1)
    counting.Find(2)
    Println(s"calls: ${counting.Count()}")

    // Generic interfaces: type arguments written, or expected.
    val word = Box[string](Get = () => "gala", Map = (f) => f("gala"))
    Println(word.Get(), word.Map((s) => s + "!"))
    Println(constant(20).Map((x) => x * 2))

    // A variadic method's function takes the slice.
    val logger = Logger(Log = (prefix, parts) => Println(prefix, parts.Size()))
    logger.Log("parts:", "a", "b", "c")

    // Go interfaces work the same way. A method with a Go result list, such as
    // io.Writer's Write, takes a lambda returning a Try.
    Println(fmt.Stringer(String = () => "a Stringer"))
    var written = 0
    val w = io.Writer(Write = (p) => {
        written = written + p.Size()
        Success(p.Size())
    })
    io.WriteString(w, "hello")
    Println(s"written: $written")

    val xs = ArrayOf("c", "a", "b")
    sort.Sort(sort.Interface(
        Len = () => xs.Size(),
        Less = (i, j) => xs.Get(i) < xs.Get(j),
        Swap = (i, j) => {
            val tmp = xs.Get(i)
            xs.Set(i, xs.Get(j))
            xs.Set(j, tmp)
        },
    ))
    Println(xs)
}
-- examples/interface_val_field.gala --
package main

// A struct whose immutable field is an interface — `error`, an interface the
// program declares, or one with no methods that holds any value — is built
// from a value of a concrete type that implements it, positionally, by name,
// from a variable, through Copy, or from a field default.
type Shape interface {
    Area() float64
}

type Marker interface {}

struct Square(Side float64)

func (s Square) Area() float64 = s.Side * s.Side

struct Rect(W float64, H float64)

func (r Rect) Area() float64 = r.W * r.H

struct NotFound(Key string)

func (e NotFound) Error() string = s"not found: ${e.Key}"

struct Holder(S Shape)

struct Boxed(V Marker)

struct Report(Code int, Cause error)

struct Framed(Label string, S Shape = Square(1.0))

func main() {
    Println(Holder(Square(2.0)).S.Area())

    val sq = Square(3.0)
    val named = Holder(S = sq)
    Println(named.S.Area())

    Println(named.Copy(S = Rect(2.0, 5.0)).S.Area())

    Println(Boxed(Square(4.0)).V)

    val r = Report(Code = 404, Cause = NotFound(Key = "k"))
    Println(s"${r.Code} ${r.Cause.Error()}")

    val f = Framed("default")
    Println(s"${f.Label} ${f.S.Area()}")
}
-- examples/interface_val_field_crosspkg.gala --
package main

import (
    "strings"

    lib "martianoff/gala/examples/interface_val_field_lib"
)

// A struct from another package whose immutable field is an interface — a Go
// interface this file does not import, an interface of that package, or
// `error` — is built from a value of a concrete type that implements it.
struct Square(Side float64)

func (s Square) Area() float64 = s.Side * s.Side

struct NotFound(Key string)

func (e NotFound) Error() string = s"not found: ${e.Key}"

func main() {
    Println(lib.Source(strings.NewReader("text")).R != nil)

    Println(lib.Holder(Square(2.0)).S.Area())

    Println(lib.Report(Code = 404, Cause = NotFound(Key = "k")).Cause.Error())
}
