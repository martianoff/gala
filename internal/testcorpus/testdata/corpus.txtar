-- examples/cross_pkg_copy_overrides_test.gala --
package main

import sh "martianoff/gala/examples/cross_pkg_copy_overrides/shapes"
import "martianoff/gala/examples/cross_pkg_copy_overrides/shapes"

// `.Copy(field = value)` on another package's struct, through an import alias
// and the package's own name. Through the alias a constructor-call receiver was
// rejected with "Copy overrides only supported for struct types"; a sealed
// value, or a struct with a private field, compiled to Go that read fields the
// importing package cannot name.
func describe(s shapes.Shape) string = s match {
    case shapes.Circle(r) => s"circle $r"
    case shapes.Square(n) => s"square $n"
}

func main() {
    val a = sh.Point(2, 3).Copy(Y = 2)
    val p = shapes.Point(2, 3)
    Println(a, p.Copy(X = 9), shapes.Point(1, 1).Copy(Y = 4))

    val h = sh.Holder(sh.Point(1, 2), "h")
    Println(h.P.Copy(X = 7), sh.Origin().Copy(Y = 5), sh.Point(4, 4).Copy(X = 0, Y = 1))

    val pr = sh.Pair(1, "a")
    Println(pr.Copy(Second = "b"), sh.Pair(true, 2.5).Copy(First = false))

    val c = sh.Circle(1)
    val bigger = c.Copy(R = 10)
    Println(describe(c), describe(bigger), describe(shapes.Square(3).Copy(S = 4)))

    val acc = sh.NewAccount("alice", 100)
    val renamed = acc.Copy(Name = "bob")
    Println(renamed.Name, renamed.Balance(), acc.Name)
}
-- examples/cross_pkg_field_eq/lib/lib.gala --
package lib

import . "martianoff/gala/collection_immutable"

struct Team(
    Key     string,
    Name    string,
    Members Array[string],
    Counts  HashMap[string, int],
)

func MakeTeams() Array[Team] = ArrayOf(
    Team(
        Key     = "alpha",
        Name    = "Alpha team",
        Members = ArrayOf("a", "b", "c"),
        Counts  = HashMapOf(("a", 1), ("b", 2), ("c", 3)),
    ),
    Team(
        Key     = "beta",
        Name    = "Beta team",
        Members = ArrayOf("x"),
        Counts  = HashMapOf(("x", 9)),
    ),
)

struct AppModel(
    Teams Array[Team],
)
-- examples/cross_pkg_field_eq/main.gala --
package main

import . "martianoff/gala/collection_immutable"
import "martianoff/gala/examples/cross_pkg_field_eq/lib"

// Verifies that `==` and `!=` on a struct field accessed across package
// boundaries auto-unwraps the std.Immutable[T] wrapper the same way
// same-package field access does. Before the fix the wrapper leaked
// through to Go and the comparison wouldn't typecheck.
func FindTeamByKey(teams Array[lib.Team], key string) Option[lib.Team] =
    teams.Find((tm) => tm.Key == key)

// Same story for `!=` and for direct method calls on a cross-package
// field that's an Immutable[Array[T]] under the hood: the lambda body
// must auto-unwrap through `tm.Members` before calling `.Size()`.
func TeamsLargerThan(teams Array[lib.Team], threshold int) Array[lib.Team] =
    teams.Filter((tm) => tm.Members.Size() > threshold)

// Equality between two cross-package fields (Immutable[T] on both
// sides) — the previous regression specifically about wrapper-vs-raw
// produced a Go type mismatch.
func SameKey(a lib.Team, b lib.Team) bool = a.Key == b.Key

// Chained method on cross-package field: `model.Teams.Map(...)`
// requires unwrapping `model.Teams` (Immutable[Array[Team]]) before
// the .Map() call.
func KeysOf(m lib.AppModel) Array[string] =
    m.Teams.Map((t) => t.Key)

// Cross-package HashMap field: `team.Counts.Get(name)` must unwrap
// `team.Counts` (Immutable[HashMap[...]]) before calling .Get(name).
func LookupCount(team lib.Team, name string) Option[int] =
    team.Counts.Get(name)

func main() {
    val teams = lib.MakeTeams()

    val a = FindTeamByKey(teams, "alpha")
    Println(s"alpha=${a.IsDefined()}")

    val b = FindTeamByKey(teams, "beta")
    Println(s"beta=${b.IsDefined()}")

    val miss = FindTeamByKey(teams, "ghost")
    Println(s"miss=${miss.IsDefined()}")

    val first = teams.Get(0)
    Println(s"firstNameLen=${first.Name.Size()}")

    val big = TeamsLargerThan(teams, 1)
    Println(s"big=${big.Length()}")

    val same = SameKey(first, first)
    Println(s"same=${same}")

    val model = lib.AppModel(Teams = teams)
    val keys = KeysOf(model)
    Println(s"keys=${keys.MkString(\",\")}")

    val cnt = LookupCount(first, "b")
    Println(s"cntB=${cnt.GetOrElse(-1)}")
}
-- examples/cross_pkg_generic_ctor_lambda/lib/lib.gala --
package lib

import . "martianoff/gala/collection_immutable"

// Cell holds a value and a function over its type.
struct Cell[T any](Value T, Map func(T) T)

// Bag holds items and a step applied to each; T is reached only through Array[T].
struct Bag[T any](Items Array[T], Step func(T) T)
-- examples/cross_pkg_generic_ctor_lambda/main.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/cross_pkg_generic_ctor_lambda/lib"
)

// A lambda passed to a generic struct from another package takes the type
// arguments the constructor's other arguments determine.
func main() {
    val named = lib.Cell(Value = 5, Map = (v) => v * 3)
    val positional = lib.Cell(7, (v) => v - 1)
    val bag = lib.Bag(Items = ArrayOf(1, 2), Step = (v) => v + 10)
    Println(named.Map(named.Value))
    Println(positional.Map(positional.Value))
    Println(bag.Items.Map(bag.Step))
}
-- examples/cross_pkg_lambda_infer/lib/lib.gala --
package lib

struct Res(V string)

func MkRes(s string) Res = Res(s)

// Higher-order function: parameter has a concrete function type.
func Apply(f func(int) Res) Res = f(7)
-- examples/cross_pkg_lambda_infer/main.gala --
package main

import . "martianoff/gala/examples/cross_pkg_lambda_infer/lib"

func main() {
    val r = Apply((x) => MkRes("hi"))
    Println(r.V)
}
-- examples/cross_pkg_namedarg/lib/lib.gala --
package lib

import . "martianoff/gala/collection_immutable"

// ConversationLine mirrors gala_team's session.ConversationLine — a
// plain struct used as the element type of an Array field on Snapshot.
struct ConversationLine(Speaker string, Text string, At int64)

// Snapshot mirrors gala_team's session.Snapshot — a plain struct with
// mixed primitive and Array[<custom-struct>] fields.
struct Snapshot(
    ProjectName    string,
    SavedAt        int64,
    Conversation   Array[ConversationLine],
    ActiveMembers  Array[string],
)
-- examples/cross_pkg_namedarg/main.gala --
package main

import . "martianoff/gala/collection_immutable"
import "martianoff/gala/examples/cross_pkg_namedarg/lib"
import "martianoff/gala/examples/cross_pkg_namedarg/widget"

// Verifies that named-arg construction works on a struct imported from
// another package via a qualified reference: `lib.Snapshot(field = ...)`.
// The reporter cited gala_team/app/ui/update_test.gala:1900-1902 — the
// test fell back to positional args under the assumption that the
// qualified named-arg form didn't transpile.
func makeSnap() lib.Snapshot {
    val convo = EmptyArray[lib.ConversationLine]()
    return lib.Snapshot(
        ProjectName   = "demo",
        SavedAt       = int64(12345),
        Conversation  = convo,
        ActiveMembers = ArrayOf("alice", "bob"),
    )
}

// Reordered named args — the transpiler must reorder them to match the
// declared field order.
func makeSnapReordered() lib.Snapshot {
    val convo = EmptyArray[lib.ConversationLine]()
    return lib.Snapshot(
        ActiveMembers = ArrayOf("zoe"),
        ProjectName   = "reorder",
        Conversation  = convo,
        SavedAt       = int64(99),
    )
}

// Cross-package construction of a struct with all fields named.
func makeLine() lib.ConversationLine = lib.ConversationLine(
    Speaker = "user",
    Text    = "hi",
    At      = int64(7),
)

func main() {
    val a = makeSnap()
    Println(s"project=${a.ProjectName} saved=${a.SavedAt} members=${a.ActiveMembers.Length()}")

    val b = makeSnapReordered()
    Println(s"project=${b.ProjectName} saved=${b.SavedAt} members=${b.ActiveMembers.Length()}")

    val l = makeLine()
    Println(s"line=${l.Speaker}/${l.Text}/${l.At}")

    // Co-importing a different `Snapshot` (a function) from another
    // package must NOT shadow `lib.Snapshot` — the qualified form
    // disambiguates by package.
    val w = widget.Snapshot("widget-1", 80)
    Println(s"widget=${w}")
}
-- examples/cross_pkg_namedarg/widget/widget.gala --
package widget

// Snapshot is a function (not a struct), mimicking the gala-tui collision
// the reporter cited: `gala_tui.Snapshot(widget, w, h) string` is a
// utility, while `session.Snapshot(...)` is a struct in another package.
// The transpiler must keep these straight when both are imported in the
// same file.
func Snapshot(label string, width int) string = label
-- examples/cross_pkg_sealed_qualified_match/event/event.gala --
package event

// A sealed type defined in its own package, imported QUALIFIED by the consumer
// (no dot-import). Used to verify that package-qualified case patterns such as
// `case event.Tick(n)` are recognized as constructor patterns rather than
// mis-parsed as a simple binding of the package identifier `event`.
sealed type Event {
    case Tick(N int)
    case Message(Text string)
    case Stop()
}
-- examples/cross_pkg_sealed_qualified_match_test.gala --
package main

import "martianoff/gala/examples/cross_pkg_sealed_qualified_match/event"

// Verifies package-qualified case patterns in a match expression. The sealed
// type is imported QUALIFIED (not dot-imported), so its cases are referenced as
// `event.Tick`, `event.Message`, `event.Stop`. Previously `case event.Tick(n)`
// was parsed as a binding of `event` (the postfix `event.Tick(...)` has two
// suffixes — a member access then a call — which the call-pattern detector only
// handled for the `Ctor[T](...)` shape), producing
// "unused variable 'event' in match branch". Both zero-field and field-bearing
// qualified cases must now destructure correctly.
func describe(e event.Event) string =
    e match {
        case event.Tick(n)       => s"tick ${n}"
        case event.Message(text) => s"message ${text}"
        case event.Stop()        => "stop"
    }

func main() {
    Println(describe(event.Tick(N = 7)))
    Println(describe(event.Message(Text = "hi")))
    Println(describe(event.Stop()))
}
-- examples/cross_pkg_sealed_var/step/step.gala --
package step

// A generic sealed type whose type parameter does not appear in any case
// field. The transpiler must still infer the parameter at the call site by
// looking at the enclosing element type (e.g., ArrayOf[step.Step[int]](...)).
sealed type Step[T any] {
    case StepA(N int)
    case StepB(Text string)
}
-- examples/cross_pkg_sealed_var_test.gala --
package main

import . "martianoff/gala/collection_immutable"
import "martianoff/gala/examples/cross_pkg_sealed_var/step"

// Verifies that a generic sealed type imported from another package picks up
// its type parameter from the enclosing call context. Without the fix, the
// bare `step.StepA(...)` reference fell through the type-arg injection (the
// helper only handled bare *ast.Ident shapes) and Go rejected the result with
// "cannot use generic type without instantiation".
func main() {
    val named = ArrayOf[step.Step[int]](
        step.StepA(N = 1),
        step.StepB(Text = "x"),
    )
    Println(s"named=${named.Length()}")

    val positional = ArrayOf[step.Step[int]](
        step.StepA(2),
        step.StepB("y"),
    )
    Println(s"positional=${positional.Length()}")

    val explicit = ArrayOf[step.Step[int]](
        step.StepA[int](3),
        step.StepB[int](Text = "z"),
    )
    Println(s"explicit=${explicit.Length()}")
}
-- examples/cross_pkg_try_chain/main/main.gala --
package main

// Driver for the cross-package chained Try.FlatMap repro. Both pkg_proc
// (defining Process) and pkg_session (defining Session + CloseSession)
// are separate gala_library targets, so all three CloseSession variants
// run in batch transpilation context with cross-package metadata lookups.

import (
    "martianoff/gala/examples/cross_pkg_try_chain/pkg_proc"
    "martianoff/gala/examples/cross_pkg_try_chain/pkg_session"
)

func main() {
    val s = pkg_session.Session(Proc = pkg_proc.NewProcess(1))
    pkg_session.CloseSession(s) match {
        case Success(b) => Println(s"flatmap: $b")
        case Failure(e) => Println(s"flatmap err: ${e.Error()}")
    }
    pkg_session.CloseSessionMatch(s) match {
        case Success(b) => Println(s"match: $b")
        case Failure(e) => Println(s"match err: ${e.Error()}")
    }
    pkg_session.CloseSessionWorkaround(s) match {
        case Success(b) => Println(s"workaround: $b")
        case Failure(e) => Println(s"workaround err: ${e.Error()}")
    }
}
-- examples/cross_pkg_try_chain/pkg_proc/proc.gala --
package pkg_proc

// Process lives in its own package and uses the Go-style block-form
// struct shape with a var-pointer to state — the same shape that
// surfaced the original cross-package regression in subprocess.Process
// (a value-type handle wrapping a pointer to mutable state).
//
// Kill() returns Try[bool] and Wait() returns Try[int] — the asymmetric
// element types let pkg_session's CloseSession exercise a chained
// FlatMap((_) => Map((_) => v)) whose synthesized closure return type
// must preserve the [bool] type argument across both Try methods.

type processState struct {
    var pid      int
    var exitCode int
}

type Process struct {
    var state *processState
}

func NewProcess(pid int) Process = Process(state = &processState{
    pid:      pid,
    exitCode: 0,
})

func (p Process) Kill() Try[bool] = Success[bool](true)
func (p Process) Wait() Try[int]  = Success[int](0)
-- examples/cross_pkg_try_chain/pkg_session/session.gala --
package pkg_session

import (
    "martianoff/gala/examples/cross_pkg_try_chain/pkg_proc"
)

// Session wraps a Process whose static type lives in a *different* GALA
// package (pkg_proc.Process). The chained Try.FlatMap/Map pattern below
// must propagate the inner Try[bool] type argument through the synthesized
// closure return type even though the method-return-type lookup for
// Kill()/Wait() now goes through the cross-package metadata path.

struct Session(Proc pkg_proc.Process)

// CloseSession exercises Try[bool].FlatMap((_) => Try[int].Map((_) => true))
// where the receiver methods are defined in pkg_proc. Generated Go must
// spell the outer closure return type as Try[bool], not bare Try.
func CloseSession(s Session) Try[bool] =
    s.Proc.Kill().FlatMap((_) => s.Proc.Wait().Map((_) => true))

// CloseSessionMatch covers the same propagation through a match expression:
// both arms must agree on Try[bool], so Wait().Map((_) => true) must be
// typed as Try[bool] when the analyzer compares branch types.
func CloseSessionMatch(s Session) Try[bool] = s.Proc.Kill() match {
    case Success(_)   => s.Proc.Wait().Map((_) => true)
    case Failure(err) => Failure[bool](err)
}

// CloseSessionWorkaround is the manual two-arm form (no .Map). It already
// compiles on master and acts as a parity check against the failing forms.
func CloseSessionWorkaround(s Session) Try[bool] = s.Proc.Kill() match {
    case Success(_)   => Success[bool](true)
    case Failure(err) => Failure[bool](err)
}
-- examples/cross_pkg_try_match/corelib/corelib.gala --
package corelib

import . "martianoff/gala/std"

// BridgeResponse is a simple response type (like httpcore.BridgeResponse in gala-server)
struct BridgeResponse(Code int, Body string)

// NewBridgeResponse creates a BridgeResponse (like httpcore.NewBridgeResponse)
func NewBridgeResponse(code int, body string) BridgeResponse = BridgeResponse(Code = code, Body = body)

// Response is a higher-level response that can be converted to BridgeResponse
struct Response(Status int, Message string)

// NewResponse creates a Response
func NewResponse(status int, message string) Response = Response(Status = status, Message = message)

// ToBridge converts Response to BridgeResponse (like resp.ToBridge() in gala-server)
func (r Response) ToBridge() BridgeResponse = NewBridgeResponse(r.Status, r.Message)
-- examples/cross_pkg_try_match/main.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    "martianoff/gala/examples/cross_pkg_try_match/corelib"
)

func doWork() Future[corelib.Response] = FutureOf(corelib.NewResponse(200, "OK"))

// Repro: match on Try with cross-package return type
// This matches the gala-server pattern: handler(req).Await() match { ... }
func makeBridgeHandler() func() corelib.BridgeResponse {
    return () => {
        return doWork().Await() match {
            case Success(resp) => resp.ToBridge()
            case Failure(err) => corelib.NewBridgeResponse(500, s"Error: $err")
        }
    }
}

func main() {
    val handler = makeBridgeHandler()
    val result = handler()
    Println(s"${result.Code}: ${result.Body}")
}
-- examples/crossfile_package_val/main.gala --
package main

func main() {
    // Cross-file references to package-level `val`s: each must auto-unwrap
    // from std.Immutable[T] when passed to a plain-T parameter.
    Println(formatError(parseErrorCode))
    Println(tagName(protocolName))
    Println(withinLimit(10, maxBatch))

    // Cross-file `val` read directly in a string interpolation.
    Println(s"protocol=$protocolName code=$parseErrorCode")
}
-- examples/crossfile_package_val/protocol.gala --
package main

// Shared constants declared as package-level `val`s in a dedicated file — a
// common layout for protocol error codes, version strings, and limits. Each
// lowers to a std.Immutable[T] wrapper; references from another file in the
// same package must unwrap it to plain T at the use site.
val parseErrorCode = -32700
val protocolName = "jsonrpc"
val maxBatch = 50

func formatError(code int) string = s"error($code)"

func tagName(name string) string = s"[$name]"

func withinLimit(n int, limit int) bool = n <= limit
-- examples/crosspkg_funcref_chain.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/crosspkg_funcref_lib"
)

// A bare reference to a function in ANOTHER package, passed to a generic
// method (Array.Map) whose result is then consumed by a SECOND generic method
// (ForEach / Map). The transpiler must resolve the cross-package function's
// signature to bind Map's result type parameter; otherwise the uninstantiated
// method type parameter leaks into the generated Go.
func main() {
    // Cross-package bare ref chained into a generic consumer.
    ArrayOf("a", "b").Map(crosspkg_funcref_lib.Shout).ForEach((g) => Println(g))

    // Cross-package bare ref whose result type differs from the element type,
    // chained into another generic method.
    val lengths = ArrayOf("aa", "bbb").Map(crosspkg_funcref_lib.Length)
    Println(lengths.Map(_ * 2).String())

    // Cross-package bare ref with a non-generic consumer.
    Println(ArrayOf("c").Map(crosspkg_funcref_lib.Shout).String())

    // Explicit lambda over the same cross-package function.
    ArrayOf("d").Map((s) => crosspkg_funcref_lib.Shout(s)).ForEach((g) => Println(g))
}
-- examples/crosspkg_package_val.gala --
package main

import "martianoff/gala/examples/crosspkg_package_val/colors"
import . "martianoff/gala/examples/crosspkg_package_val/palette"

// Package-level `val`s read from ANOTHER package must unwrap from
// std.Immutable[T] at every use site, the way same-package references do.
// Without that, each reference below emitted the raw wrapper where a plain T
// was expected and `go build` rejected it.

func show(c colors.Color) string = colors.ToSgr(c)

func identity[T any](x T) T = x

func main() {
    // Passed straight to a function parameter.
    Println(show(colors.Green))

    // Passed through a generic function: the element type must be known.
    val passed = identity(colors.Green)
    Println(show(passed))

    // Assigned to a typed val.
    val typed colors.Color = colors.Green
    Println(show(typed))

    // Read in string interpolation.
    Println(s"greeting=${colors.Greeting} sgr=${colors.ToSgr(colors.Green)}")

    // A struct-typed val: field access goes through the unwrapped value.
    Println(s"theme=${colors.Default.Name} accent=${show(colors.Default.Accent)}")

    // Pattern matching on an imported val.
    val idx = colors.Green match {
        case colors.NamedColor(i) => i
        case _ => -1
    }
    Println(s"idx=$idx")

    // Calling a val whose type defines Apply, and matching with a val extractor.
    Println(s"added=${colors.AddTen(5)}")
    val half = 8 match {
        case colors.Halve(h) => h
        case _ => -1
    }
    Println(s"half=$half")

    // Dot-imported package: bare references.
    Println(show(Blue))
    Println(s"label=$Label accent=${Accent.Name}")

    // A package-level `var` stays a plain, mutable variable.
    colors.Hit()
    colors.Hit()
    Println(s"hits=${colors.Hits}")
    colors.Hits = colors.Hits + 10
    Println(s"hits=${colors.Hits}")
}
-- examples/crosspkg_package_val/colors/colors.gala --
package colors

// Package-level bindings read from another package. Each `val` lowers to a
// std.Immutable[T] wrapper, so an importer's `colors.Green` must unwrap it to
// plain T at the use site, exactly as a same-package reference does.

// Color is a terminal color: the default red, or an indexed named color.
sealed type Color {
    case Red()
    case NamedColor(Idx int)
}

// Theme pairs a display name with its accent color.
struct Theme(Name string, Accent Color)

// Adder adds N to its argument when called.
struct Adder(N int)

// Apply returns x plus the adder's N.
func (a Adder) Apply(x int) int = a.N + x

// Halver extracts half of an even number.
struct Halver()

// Unapply yields n / 2 for an even n.
func (h Halver) Unapply(n int) Option[int] = When(n % 2 == 0, n / 2)

// Green is a sealed-variant val whose element type is the parent Color.
val Green = NamedColor(2)

// Default is a struct-typed val; importers read its fields through the unwrap.
val Default = Theme("classic", Red())

// Greeting is a string val.
val Greeting = "hello"

// AddTen is a callable val: importers call it as `colors.AddTen(5)`.
val AddTen = Adder(10)

// Halve is an extractor val: importers match with `case colors.Halve(h)`.
val Halve = Halver()

// Hits is a `var`: a plain, reassignable Go variable. It is never wrapped, so
// it must never be unwrapped either.
var Hits = 0

// Hit increments Hits from inside its own package.
func Hit() {
    Hits = Hits + 1
}

// ToSgr returns the SGR foreground code for c.
func ToSgr(c Color) string = c match {
    case Red() => "31"
    case NamedColor(i) => s"3$i"
}
-- examples/crosspkg_package_val/palette/palette.gala --
package palette

import "martianoff/gala/examples/crosspkg_package_val/colors"

// Dot-imported by the consumer, so these are read as bare names there. Their
// initializers also reach into another package, so their element types come
// from that package's metadata.

// Blue is a val built from another package's sealed-variant constructor.
val Blue = colors.NamedColor(4)

// Accent re-exports another package's struct-typed val.
val Accent = colors.Default

// Label is a string val.
val Label = "palette"
-- examples/custom_seq_pattern.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
)

// Custom sequence type - not predefined in the transpiler
type IntStack struct {
    var elements []int
}

func NewIntStack(elems ...int) IntStack {
    return IntStack{elements: elems}
}

// Implement Seq interface
func (s IntStack) Size() int = s.elements.Size()

func (s IntStack) Get(index int) int = s.elements[index]

func (s IntStack) SeqDrop(n int) any {
    if n >= s.elements.Size() {
        return IntStack{elements: go_interop.SliceEmpty[int]()}
    }
    var result = go_interop.SliceEmpty[int]()
    for i := n; i < s.elements.Size(); i++ {
        result = go_interop.SliceAppend(result, s.elements[i])
    }
    return IntStack{elements: result}
}

func main() {
    val stack = NewIntStack(10, 20, 30, 40)

    // Test 1: Extract first two elements
    val res1 = stack match {
        case IntStack(first, second, _...) => fmt.Sprintf("First: %d, Second: %d", first, second)
        case _ => "Not enough elements"
    }
    fmt.Println(res1)

    // Test 2: Extract head and capture rest
    val res2 = stack match {
        case IntStack(head, tail...) => fmt.Sprintf("Head: %d, Tail size: %d", head, tail.Size())
        case _ => "Empty"
    }
    fmt.Println(res2)

    // Test 3: Empty stack
    val emptyStack = NewIntStack()
    val res3 = emptyStack match {
        case IntStack(first, _...) => fmt.Sprintf("First: %d", first)
        case _ => "Empty stack"
    }
    fmt.Println(res3)

    // Test 4: Single element
    val singleStack = NewIntStack(99)
    val res4 = singleStack match {
        case IntStack(only, rest...) => fmt.Sprintf("Only: %d, Rest size: %d", only, rest.Size())
        case _ => "Empty"
    }
    fmt.Println(res4)
}
-- examples/deeply_nested_pattern.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// T2: Deeply nested pattern matching — Some(Right((a, b))) 3+ levels.
// Exercises pattern extraction through Option, Either, and Tuple layers.
func classify(x Option[Either[string, Tuple[int, int]]]) string = x match {
    case None() => "none"
    case Some(Left(msg)) => fmt.Sprintf("left=%s", msg)
    case Some(Right((a, b))) => fmt.Sprintf("right=(%d,%d)", a, b)
}

func main() {
    fmt.Println(classify(None[Either[string, Tuple[int, int]]]()))
    fmt.Println(classify(Some(Left[string, Tuple[int, int]]("oops"))))
    fmt.Println(classify(Some(Right[string, Tuple[int, int]]((3, 4)))))
}
-- examples/default_go_dot_import/caller/caller.gala --
package caller

import "martianoff/gala/examples/default_go_dot_import/lib"

// Another package that imports neither strings nor unicode/utf8: lib's
// defaults lowered here import them.
func Call() string = s"${lib.Box(3).Label()} ${lib.Tag()} ${lib.Width()}"
-- examples/default_go_dot_import/lib/a.gala --
package lib

import (
    . "strings"
    . "unicode/utf8"
)

// Defaults naming functions of Go packages this file dot-imports. A default
// is lowered at each call that omits the argument, in the calling file: there
// ToUpper, Repeat and RuneCountInString are qualified as that file reaches
// strings and unicode/utf8 (whose name, utf8, is not its import path).
struct Box(N int)

func (b Box) Label(prefix string = ToUpper("box")) string = s"${prefix}-${b.N}"

func Tag(s string = Repeat("ab", 2)) string = s

func Width(n int = RuneCountInString("héllo")) int = n
-- examples/default_go_dot_import/lib/b.gala --
package lib

// lib's other file imports neither package. a.gala's defaults, lowered here,
// still resolve their names through a.gala's Go dot imports. They used to be
// lowered bare and fail to compile.
func Describe(b Box) string = b.Label()

func DescribeTag() string = s"${Tag()} ${Width()}"
-- examples/default_go_dot_import_test.gala --
package main

import (
    gostrings "strings"

    "martianoff/gala/examples/default_go_dot_import/caller"
    "martianoff/gala/examples/default_go_dot_import/lib"
)

// lib's defaults name ToUpper and Repeat through lib's dot import of the Go
// package strings. This file imports strings under another name; the
// defaults lowered here use that name. They used to be lowered bare and fail
// to compile, here, in lib's other file and in caller.
func main() {
    val b = lib.Box(2)
    Println(b.Label())
    Println(lib.Tag())
    Println(lib.Describe(b))
    Println(lib.DescribeTag())
    Println(caller.Call())
    Println(gostrings.ToLower(b.Label("Own")))
}
-- examples/default_params.gala --
package main

func greet(name string, greeting string = "Hello", punctuation string = "!") string =
    s"$greeting, $name$punctuation"

func add(a int, b int = 10) int = a + b

func main() {
    // Positional args - skip defaults
    Println(greet("World"))
    Println(greet("World", "Hi"))
    Println(greet("World", "Hey", "..."))

    // Named args with defaults
    Println(greet("World", punctuation = "?"))
    Println(greet(name = "World", greeting = "Yo"))

    // Simple default
    Println(add(5))
    Println(add(5, 20))
}
-- examples/default_params_expr.gala --
package main

var counter = 0

func nextId() int {
    counter = counter + 1
    return counter
}

func createItem(name string, id int = nextId()) string =
    s"$name#$id"

func withFlag(label string, enabled bool = true) string =
    if (enabled) s"$label: ON" else s"$label: OFF"

func main() {
    // Expression defaults: nextId() is called each time
    Println(createItem("A"))
    Println(createItem("B"))
    Println(createItem("C", 99))

    // Boolean defaults
    Println(withFlag("feature"))
    Println(withFlag("debug", false))
}
-- examples/default_type_param_binding.gala --
package main

// Defaults that name their declaration's type parameter take the type
// argument of each use site: explicit, inferred from another argument, from
// the slot, from a struct's type arguments or from the receiver.

func describe[T any](v Option[T] = None[T]()) string = v match {
    case Some(x) => s"some $x"
    case None() => "none"
}

func orFallback[T any](x T, fallback Option[T] = None[T]()) Option[T] = fallback.OrElse(Some(x))

func pick[T any](d Option[T] = None[T]()) Option[T] = d

// Slot holds an optional value, empty unless one is given.
struct Slot[T any](Value Option[T] = None[T](), Label string = "slot")

// Box holds one value.
struct Box[T any](V T)

// Or is alt, or else the boxed value.
func (b Box[T]) Or(alt Option[T] = None[T]()) Option[T] = alt.OrElse(Some(b.V))

// A caller with a type parameter of its own named like the callee's.
func inner[T any](t T) string = describe[int]() + s" $t"

func viaParam[U any](u U) Option[U] = orFallback(u)

func main() {
    Println(describe[int]())
    Println(describe(Some(3)))
    Println(orFallback(5))
    Println(orFallback("a"))
    val p Option[int] = pick()
    Println(p)
    Println(Slot[int](Label = "a").Value.IsDefined())
    Println(Box(V = 7).Or())
    Println(inner("x"))
    Println(viaParam(true))
}
-- examples/default_vals_cross_pkg.gala --
package main

import lim "martianoff/gala/examples/default_vals_lib"

// Defaults declared in another package that read that package's own vals and
// vars, and its own imports: each is evaluated here, at the call or
// construction site, against the declaring package's bindings.

func main() {
    // A caller binding of the same name was not in scope where the default
    // was written, so it does not stand in for the declaring package's val.
    val MaxK = 100
    Println(s"Analyze(2) = ${lim.Analyze(2)}, local MaxK = $MaxK")
    Println(s"Leveled(2) = ${lim.Leveled(2)}")
    Println(s"Scaled(2) = ${lim.Scaled(2)}")
    Println(lim.Rule("rule"))
    Println(s"Box(4).Times() = ${lim.Box(4).Times()}")

    val positional = lim.Item("x")
    val named = lim.Item(Name = "y", Depth = 1)
    Println(s"${positional.Name} at ${positional.At.Line}:${positional.At.Col} depth ${positional.Depth}")
    Println(s"${named.Name} at ${named.At.Line}:${named.At.Col} depth ${named.Depth}")
}
-- examples/default_values.gala --
package main

// Where GALA code needs a value and none is written (an uninitialized var, a
// field a construction leaves out), it uses the type's default value: a
// sealed type's default case built with its field defaults, a struct's
// declared field defaults, and Go's zero value for everything else.

sealed type Light {
    case Off()
    default case On(Power int = 30, Room string = "Living")
}

struct Home(Name string, L Light, Rooms int = 1, Note Option[string])

type Point struct {
    X int
    Y int
}

func main() {
    var l Light
    Println(l)

    val h = Home{Name: "flat"}
    Println(h.Name, h.L, h.Rooms, h.Note)

    var p Point
    Println(p.X, p.Y, Point{X: 3}.Y)
}
-- examples/dependency_injection.gala --
package main

import . "martianoff/gala/collection_immutable"

// Dependency injection in GALA: dependencies are interfaces taken as
// constructor parameters, wired once in a composition root. Tests swap them
// with interface literals and Copy. Nothing is resolved implicitly.

struct User(Id int, Name string)

// Ports: what the service needs, as interfaces.
type UserRepo interface {
    Find(id int) Option[User]
}

type Clock interface {
    Year() int
}

type Logger interface {
    Info(msg string)
}

// An optional dependency gets a default.
func NoopLogger() Logger = Logger(Info = (msg) => {})

struct Greeter(repo UserRepo, clock Clock, log Logger = NoopLogger())

func (g Greeter) Greet(id int) string = g.repo.Find(id) match {
    case Some(u) => {
        g.log.Info(s"greeting ${u.Name}")
        s"Hello, ${u.Name} (${g.clock.Year()})"
    }
    case None() => s"no user $id"
}

// Adapters: production implementations.
struct MemRepo(users HashMap[int, User])
func (r MemRepo) Find(id int) Option[User] = r.users.Get(id)

struct FixedClock(year int)
func (c FixedClock) Year() int = c.year

struct PrefixLogger(prefix string)
func (l PrefixLogger) Info(msg string) = Println(s"${l.prefix} $msg")

func main() {
    // Composition root: the one place that names concrete implementations.
    val greeter = Greeter(
        repo = MemRepo(users = HashMapOf((1, User(1, "Ada")))),
        clock = FixedClock(2026),
        log = PrefixLogger("[info]"),
    )
    Println(greeter.Greet(1))
    Println(greeter.Greet(2))

    // In a test: fakes are interface literals, and Copy swaps one dependency.
    val fakeRepo = UserRepo(Find = (id) => Some(User(id, s"user$id")))
    val testGreeter = greeter.Copy(repo = fakeRepo, clock = Clock(Year = () => 2030))
    Println(testGreeter.Greet(7))

    // A default stays in place unless a construction gives the dependency.
    val quiet = Greeter(repo = fakeRepo, clock = FixedClock(2026))
    Println(quiet.Greet(3))

    // A recording fake checks how a dependency was used.
    var messages = ListOf[string]()
    val recording = greeter.Copy(log = Logger(Info = (msg) => { messages = messages.Append(msg) }))
    recording.Greet(1)
    Println(s"logged: $messages")
}
-- examples/doc_io_verify.gala --
package main

import (
    "errors"
    "martianoff/gala/io"
    . "martianoff/gala/std"
)

func fetchData() int = 42
func process(n int) int = n * 2
func save(n int) bool {
    Println(s"Saving $n")
    return true
}

func main() {
    // Verify io.Suspend with function reference (not lambda wrapper)
    val program = io.FlatMap[int, bool](
        io.Suspend(fetchData),
        (data int) => io.FlatMap[int, bool](
            io.Of(process(data)),
            (result int) => io.Suspend(() => save(result)),
        ),
    )
    program.Run()

    // Verify Map
    val doubled = io.Map[int, int](io.Of(21), (x int) => x * 2)
    Println(s"Doubled: ${doubled.Run().Get()}")

    // Verify FlatMap
    val chained = io.FlatMap[int, int](io.Of(10), (x int) => io.Of(x + 32))
    Println(s"Chained: ${chained.Run().Get()}")

    // Verify AndThen
    val seq = io.AndThen[bool, string](
        io.Effect(() => { Println("Step 1") }),
        io.Of("done"),
    )
    Println(s"Seq: ${seq.Run().Get()}")

    // Verify Recover
    val safe = io.Recover(
        io.Fail[int](errors.New("oops")),
        (err) => -1,
    )
    Println(s"Recovered: ${safe.Run().Get()}")

    // Verify ForEach
    io.ForEach(io.Of(42), (v) => { Println(s"ForEach: $v") }).Run()

    // Verify failure propagation
    val failChain = io.FlatMap[int, int](
        io.Fail[int](errors.New("initial error")),
        (x int) => io.Of(x * 2),
    )
    Println(s"Fail chain is failure: ${failChain.Run().IsFailure()}")
}
-- examples/doc_verify/concurrent_cancellation.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/time_utils"
)

// Verifies the API-level cancellation added to CONCURRENT.MD. User code never
// touches a token — it cancels via Future.Cancel / WithTimeout / Race.

// Cancelling a chain short-circuits its pending stages with a CancellationError.
// A Promise gate holds the root pending until after Cancel, so the Map boundary
// deterministically observes the cancellation.
func testCancelChain() {
    val gate = NewPromise[int]()
    val mapped = gate.Future().Map((x) => x * 2)
    mapped.Cancel()
    gate.Success(21)
    val result = mapped.Await()
    Println(s"Cancelled failure=${result.IsFailure()}")
}

// WithTimeout fails the bounded Future and cancels the underlying chain.
func testTimeout() {
    val gate = NewPromise[int]()
    val bounded = gate.Future().WithTimeout(Milliseconds(50))
    Println(s"Timeout failed=${bounded.Await().IsFailure()}")
}

// Race returns the first result and cancels the losers.
func testRace() {
    val winnerGate = NewPromise[string]()
    val loserGate = NewPromise[string]()
    winnerGate.Success("fast")
    val first = Race[string](ArrayOf[Future[string]](winnerGate.Future(), loserGate.Future()))
    Println(s"Race winner=${first.Get()}")
}

func main() {
    testCancelChain()
    testTimeout()
    testRace()
}
-- examples/doc_verify/concurrent_md.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
)

// Test examples from CONCURRENT.MD

// Creating Futures (line 19-27)
func testCreatingFutures() {
    val immediate = FutureOf[int](42)
    Println(s"Immediate value=${immediate.Get()}")

    val failed = FutureFailed[int](NoSuchElementError(Message = "oops"))
    Println(s"Failed isCompleted=${failed.IsCompleted()}")
}

// Async constructor — the type name itself runs body asynchronously on GlobalEC().
func testAsyncConstructor() {
    val f = Future[int](() => 21 * 2)
    Println(s"Async=${f.Get()}")
}

// Blocking Operations (line 32-36)
func testBlockingOps() {
    val f = FutureOf[int](100)

    val result = f.Await()
    Println(s"Await=$result")

    val value = f.Get()
    Println(s"Get=$value")

    val safe = f.GetOrElse(0)
    Println(s"GetOrElse=$safe")
}

// Monadic Operations (line 49-51)
func testMonadicOps() {
    val f = FutureOf[int](10)

    val doubled = f.Map((v) => v * 2)
    Println(s"Map=${doubled.Get()}")
}

// Error Recovery (line 55-57)
func testErrorRecovery() {
    val failed = FutureFailed[int](NoSuchElementError(Message = "error"))

    val recovered = failed.Recover((e) => 0)
    Println(s"Recover=${recovered.Get()}")

    val recoveredWith = failed.RecoverWith((e) => FutureOf[int](99))
    Println(s"RecoverWith=${recoveredWith.Get()}")
}

// Pattern Matching (line 75-88)
func testPatternMatch() {
    val f = FutureOf[int](42)

    val msg = f match {
        case Succeeded(v) => s"Got: $v"
        case Failed(e) => s"Error: ${e.Error()}"
        case _ => "Unknown"
    }
    Println(s"Pattern match: $msg")
}

// Combining Futures (line 62-64)
func testCombiningFutures() {
    val f1 = FutureOf[int](10)
    val f2 = FutureOf[string]("hello")

    val zipped = f1.Zip(f2)
    val result = zipped.Get()
    Println(s"Zip=(${result.V1}, ${result.V2})")
}

// Promise (line 132-142)
func testPromise() {
    val promise = NewPromise[int]()
    val future = promise.Future()

    Println(s"Before complete: isCompleted=${promise.IsCompleted()}")

    promise.Success(42)

    Println(s"After complete: isCompleted=${promise.IsCompleted()}")
    Println(s"Future value=${future.Get()}")
}

func main() {
    testCreatingFutures()
    testAsyncConstructor()
    testBlockingOps()
    testMonadicOps()
    testErrorRecovery()
    testPatternMatch()
    testCombiningFutures()
    testPromise()
}
-- examples/doc_verify/examples_md.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/strings"
    "os"
)

// Verifies the runnable examples in docs/EXAMPLES.MD. Each function mirrors one
// documented section; main() runs them in document order. Kept in sync with the
// markdown so the examples stay executable.

// Complete Example
struct Point(X int, Y int)

func moveX(p Point, delta int) Point = p.Copy(X = p.X + delta)

func testCompleteExample() {
    val p1 = Point(10, 20)
    val p2 = moveX(p1, 5)
    val msg = if (p2.X > 10) "moved" else "static"
    Println(msg, p2)
}

// Named Arguments
func describe(name string, age int, role string) string = s"$name ($role, age $age)"

func testNamedArguments() {
    Println(describe("Alice", 30, "engineer"))
    Println(describe(role = "designer", name = "Bob", age = 25))
}

// Default Parameter Values
func greet(name string, greeting string = "Hello", punctuation string = "!") string =
    s"$greeting, $name$punctuation"

func testDefaultParams() {
    Println(greet("World"))
    Println(greet("World", "Hi"))
    Println(greet("World", punctuation = "?"))
}

// Option Monad
func testOptionMonad() {
    val x = Some(10)
    val y = x.Map((v) => v * 2)
    val z = None[int]().GetOrElse(42)
    val res = y match {
        case Some(v) => v
        case _       => 0
    }
    Println(res, z)
}

// Sealed Types (ADT)
sealed type Shape {
    case Circle(Radius float64)
    case Rectangle(Width float64, Height float64)
    case Point2()
}

func area(s Shape) float64 = s match {
    case Circle(r)       => 3.14159 * r * r
    case Rectangle(w, h) => w * h
    case Point2()        => 0.0
}

func testSealedTypes() {
    val shapes = ArrayOf[Shape](Circle(2.0), Rectangle(3.0, 4.0), Point2())
    shapes.ForEach((s) => Println(s, "=> area", area(s)))
}

// Either Monad
func parseEven(n int) Either[string, int] =
    if (n % 2 == 0) Right[string, int](n) else Left[string, int](s"$n is odd")

func testEither() {
    val a = parseEven(10)
    val b = parseEven(7)
    Println(a.Map((v) => v * 2))
    val r = b match {
        case Right(v) => s"got $v"
        case Left(e)  => s"error: $e"
    }
    Println(r)
}

// Generic Methods
type Box[T any] struct { Value T }
func (b Box[T]) Transform[U any](f func(T) U) Box[U] = Box[U](Value = f(b.Value))

func testGenericMethods() {
    val b = Box[int](Value = 10)
    val s = b.Transform((i int) => s"Value is $i")
    Println(s.Value)
}

// Pattern Matching with Filters (Guards)
struct Person(Name string, Age int)

func testPatternFilters() {
    val people = ArrayOf(
        Person("Alice", 25),
        Person("Bob", 15),
        Person("Charlie", 70),
    )
    people.ForEach((p) => {
        val status = p match {
            case Person(name, age) if age < 18 => name + " is a minor"
            case Person(name, age) if age > 65 => name + " is a senior"
            case Person(name, _)               => name + " is an adult"
            case _                             => "Unknown"
        }
        Println(status)
    })
}

// Pattern Matching with Extractors
type Even struct {}
func (e Even) Unapply(i int) Option[int] = if (i % 2 == 0) Some(i) else None[int]()

func testExtractors() {
    val number = 42
    val description = number match {
        case Even(n) => s"$n is an even number"
        case _       => s"$number is odd"
    }
    Println(description)
}

// Type-Based Pattern Matching
func testTypeMatch() {
    val x any = "hello"
    val res = x match {
        case s: string => s"string: $s"
        case i: int    => s"int: $i"
        case _         => "unknown"
    }
    Println(res)
}

// Interface
type Shaper interface {
    Area() float64
}
struct Rect(width float64, height float64)
func (r Rect) Area() float64 = r.width * r.height
struct Circ(radius float64)
func (c Circ) Area() float64 = 3.14159 * c.radius * c.radius

func testInterface() {
    val s1 Shaper = Rect(10.0, 5.0)
    val s2 Shaper = Circ(10.0)
    Println("Area 1:", s1.Area())
    Println("Area 2:", s2.Area())
}

// Apply Method
type Adder struct { Delta int }
func (a Adder) Apply(x int) int = x + a.Delta
type Multiply struct {}
func (m Multiply) Apply(x int, y int) int = x * y

func testApply() {
    val add5 = Adder(Delta = 5)
    Println(add5(10), Multiply(3, 4))
}

// For Loops
func testForLoops() {
    for i := 0; i < 3; i++ {
        Println(s"i = $i")
    }
    var n = 3
    for n > 0 {
        Println(s"countdown $n")
        n = n - 1
    }
}

// String Interpolation
func testStringInterpolation() {
    val name = "Alice"
    val age = 30
    val pi = 3.14159
    Println(s"$name is $age years old")
    Println(s"Next year: ${age + 1}")
    Println(s"Price: $$99")
    Println(f"Padded: $age%05d")
    Println(f"Fixed point: $pi%.2f")
}

// Variadic + Spread
func sum(nums ...int) int = ArrayOf(nums...).FoldLeft(0, (acc, n) => acc + n)

func testVariadicSpread() {
    Println(sum(1, 2, 3))
    Println(sum())
    val more = ArrayOf(4, 5, 6)
    Println(sum(more.ToGoSlice()...))
}

// Void Closures / Lambda Inference
func testVoidClosures() {
    val opt = Some(42)
    opt.ForEach((x) => {
        Println(x)
    })
    val positive = opt.Filter((x) => x > 0)
    val doubled = opt.Map((x) => x * 2)
    val list = ArrayOf(1, 2, 3)
    val total = list.FoldLeft(0, (acc, x) => acc + x)
    val str = S("hello")
    val hasVowel = str.Exists((r) => r == 'a' || r == 'e' || r == 'i' || r == 'o' || r == 'u')
    Println(positive, doubled, total, hasVowel)
}

// Collect
func testCollect() {
    val nums = ArrayOf(1, 2, 3, 4, 5, 6)
    Println(nums.Collect({ case n if n % 2 == 0 => n * 2 }))
    val options = ArrayOf(Some(1), None[int](), Some(2), None[int](), Some(3))
    Println(options.Collect({ case Some(v) => v * 10 }))
}

// Option.OrElse
func testOrElse() {
    val primary = None[string]()
    val fallback = Some("default")
    Println(primary.OrElse(fallback).Get())
    Println(Some("actual").OrElse(fallback).Get())
}

// Try with Function References
func testTryFuncRef() {
    val dir = Try(os.TempDir)
    dir.OnSuccess((d) => Println(s"Temp dir ok: ${d != ""}"))
}

// Future
func testFuture() {
    val f = Future(21 * 2)
    val g = f.Map((x) => x + 1)
    Println(g.Get())
    val result = g match {
        case Succeeded(v) => s"ok: $v"
        case Failed(e)    => s"err: ${e.Error()}"
        case _            => "pending"
    }
    Println(result)
}

// MkString
func testMkString() {
    val nums = ArrayOf(1, 2, 3, 4, 5)
    Println(nums.MkString(", "))
    val words = ListOf("hello", "world")
    Println(words.MkString(" "))
    Println(EmptyArray[int]().MkString(", "))
}

// HashMap
func testHashMap() {
    val scores = HashMapOf(("Alice", 85), ("Bob", 92))
    val updated = scores.Put("Carol", 78)
    Println(updated.GetOrElse("Bob", 0))
    Println(updated.Get("Dave"))
    val grades = updated.MapValues((v) => v match {
        case n if n >= 90 => "A"
        case _            => "B"
    })
    Println(grades.GetOrElse("Bob", "?"))
}

// Sorted
func testSorted() {
    val arr = ArrayOf(3, 1, 4, 1, 5, 9)
    Println(arr.Sorted())
    Println(arr.SortWith((a, b) => a > b))
    Println(ArrayOf(1, 9, 3, 7, 5).SortBy((x) => x))
    Println(ListOf("banana", "apple", "cherry").Sorted())
    Println(TreeSetOf(30, 10, 20).Sorted())
    Println(HashSetOf(5, 3, 1).Sorted())
    Println(EmptyArray[int]().Sorted())
}

// Type Aliases
type MyString string
func testTypeAlias() {
    val s MyString = "hello"
    Println(s)
}

func main() {
    testCompleteExample()
    testNamedArguments()
    testDefaultParams()
    testOptionMonad()
    testSealedTypes()
    testEither()
    testGenericMethods()
    testPatternFilters()
    testExtractors()
    testTypeMatch()
    testInterface()
    testApply()
    testForLoops()
    testStringInterpolation()
    testVariadicSpread()
    testVoidClosures()
    testCollect()
    testOrElse()
    testTryFuncRef()
    testFuture()
    testMkString()
    testHashMap()
    testSorted()
    testTypeAlias()
}
-- examples/doc_verify/gala_md_basics.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Test examples from GALA.MD - Variable Declarations, Functions, Structs

// Test: Variable declarations (line 66-68)
func testVariableDeclarations() {
    val x = 10
    val a, b = 1, 2
    fmt.Printf("x=%d, a=%d, b=%d\n", x, a, b)
}

// Test: Mutable variables (line 75-77)
func testMutableVariables() {
    var y = 20
    y = 30
    fmt.Printf("y=%d\n", y)
}

// Test: Short variable declaration (line 84-87)
func testShortDeclaration() {
    z := 40
    fmt.Printf("z=%d\n", z)
}

// Test: Expression function (line 105)
func square(x int) int = x * x

// Test: Function with parameters (line 112-115)
func process(data string, var count int) {
    count = count + 1
    fmt.Printf("data=%s, count=%d\n", data, count)
}

// Test: Higher-order function (line 125-130)
func apply(x int, f func(int) int) int = f(x)

// Test: Function returning function (line 148-155)
func multiplier(factor int) func(int) int {
    return (x int) => x * factor
}

// Test: Shorthand struct (line 257)
struct Person(name string, age int, var score int)

// Test: Generic struct (line 174)
type Box[T any] struct { Value T }

func (b Box[T]) Transform[U any](f func(T) U) Box[U] = Box[U](Value = f(b.Value))

// Test: Interface (line 333-345)
type Shaper interface {
    Area() float64
}

struct Rect(width float64, height float64)

func (r Rect) Area() float64 = r.width * r.height

func main() {
    testVariableDeclarations()
    testMutableVariables()
    testShortDeclaration()

    // Test square function
    fmt.Printf("square(5)=%d\n", square(5))

    // Test process
    process("test", 0)

    // Test higher-order function
    val double = (x int) => x * 2
    val result = apply(5, double)
    fmt.Printf("apply(5, double)=%d\n", result)

    // Test multiplier
    val triple = multiplier(3)
    fmt.Printf("triple(10)=%d\n", triple(10))

    // Test struct construction
    val p1 = Person("Alice", 30, 100)
    val p2 = p1.Copy(age = 31)
    fmt.Printf("p1=%s, age=%d; p2 age=%d\n", p1.name, p1.age, p2.age)

    // Test generic struct
    val intBox = Box[int](Value = 42)
    val strBox = intBox.Transform((x int) => fmt.Sprintf("Value: %d", x))
    fmt.Printf("strBox.Value=%s\n", strBox.Value)

    // Test interface
    val r = Rect(10.0, 5.0)
    val s Shaper = r
    fmt.Printf("Area=%f\n", s.Area())
}
-- examples/doc_verify/gala_md_monads.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    . "martianoff/gala/go_interop"
)

// Test monadic types from GALA.MD

// Test: If expression (line 378)
func testIfExpr() {
    val score = 60
    val status = if (score > 50) "pass" else "fail"
    fmt.Printf("If expr: %s\n", status)
}

// Test: Option monad (line 764-768)
func testOption() {
    val x Option[int] = Some(10)
    val y Option[int] = None[int]()

    val result = x.Map((i) => i * 2)
    fmt.Printf("Option mapped: %v\n", result.Get())

    val fallback = y.GetOrElse(42)
    fmt.Printf("Option fallback: %d\n", fallback)
}

// Test: Either monad (line 800-809)
func testEither() {
    val e Either[int, string] = Right[int, string]("success")
    val msg = e match {
        case Left(code) => s"Error code: $code"
        case Right(s)   => "Result: " + s
        case _          => "Unknown"
    }
    fmt.Printf("Either match: %s\n", msg)

    val length = e.Map((s) => s.Size())
    fmt.Printf("Either mapped: %v\n", length)
}

// Test: Try monad (line 815-841)
func testTry() {
    val success Try[int] = Success(42)
    val failure Try[int] = Failure[int](NoSuchElementError(Message = "not found"))

    val msg = success match {
        case Success(n) => s"Got: $n"
        case Failure(e) => s"Error: ${e.Error()}"
        case _          => "Unknown"
    }
    fmt.Printf("Try match: %s\n", msg)

    val doubled = success.Map((n) => n * 2)
    fmt.Printf("Try mapped: %d\n", doubled.Get())

    val recovered = failure.Recover((e) => 0)
    fmt.Printf("Try recovered: %d\n", recovered.Get())

    val value = failure.GetOrElse(100)
    fmt.Printf("Try fallback: %d\n", value)
}

// Test: Tuple short syntax (line 773-794)
func testTuple() {
    val t = (1, "hello")
    val triple = (1, "hello", true)

    fmt.Printf("Tuple: (%d, %s)\n", t.V1, t.V2)
    fmt.Printf("Triple: (%d, %s, %v)\n", triple.V1, triple.V2, triple.V3)

    val (a, b) = t
    fmt.Printf("Destructured: a=%d, b=%s\n", a, b)
}

// Test: Lambdas (line 679-685)
func testLambdas() {
    val f = (x int) => x * x
    val g = (a int, b int) => {
        val sum = a + b
        return sum * sum
    }

    fmt.Printf("Lambda f(5)=%d\n", f(5))
    fmt.Printf("Lambda g(2,3)=%d\n", g(2, 3))
}

// Test: For loop (line 618-622)
func testForLoop() {
    fmt.Print("For loop:")
    for i := 0; i < 5; i++ {
        fmt.Printf(" %d", i)
    }
    fmt.Println()
}

// Test: Range loop (line 652-656)
func testRangeLoop() {
    val items = SliceOf(10, 20, 30)
    fmt.Print("Range loop: ")
    for i, v := range items {
        fmt.Printf("(%d:%d) ", i, v)
    }
    fmt.Println()
}

func main() {
    testIfExpr()
    testOption()
    testEither()
    testTry()
    testTuple()
    testLambdas()
    testForLoop()
    testRangeLoop()
}
-- examples/doc_verify/gala_md_patterns.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Test pattern matching examples from GALA.MD

// Test: Basic match expression (line 385-390)
func testBasicMatch() {
    val x = 2
    val result = x match {
        case 1 => "one"
        case 2 => "two"
        case n => "Value is " + fmt.Sprintf("%d", n)
        case _ => "other"
    }
    fmt.Printf("Basic match: %s\n", result)
}

// Test: Type-based pattern matching (line 397-402)
func testTypeMatch() {
    val x any = "hello"
    val res = x match {
        case s: string => "Found string: " + s
        case i: int    => "Found int: " + fmt.Sprintf("%d", i)
        case _         => "Unknown type"
    }
    fmt.Printf("Type match: %s\n", res)
}

// Test: Generic type pattern matching (line 408-416)
type Wrap[T any] struct { Value T }

func testGenericMatch() {
    val w = Wrap[int](Value = 42)
    val res = w match {
        case _: Wrap[int]    => "Wrapped int"
        case _: Wrap[string] => "Wrapped string"
        case _               => "Other"
    }
    fmt.Printf("Generic match: %s\n", res)
}

// Test: Option pattern matching (line 421-427)
func testOptionMatch() {
    val opt = Some(42)
    opt match {
        case Some(i: int) => fmt.Printf("Integer: %d\n", i)
        case Some(_: string) => fmt.Println("String")
        case _ => fmt.Println("Other")
    }
}

// Test: Extractor pattern matching (line 459-467)
struct TestPerson(Name string, Age int)

func testExtractorMatch() {
    val p = TestPerson("Alice", 30)
    val msg = p match {
        case TestPerson(_, 30) => "Alice is 30"
        case TestPerson(_, age) => "Someone else is " + fmt.Sprintf("%d", age)
        case _                  => "Unknown"
    }
    fmt.Printf("Extractor match: %s\n", msg)
}

// Test: Custom extractor (line 476-477)
type Even struct {}
func (e Even) Unapply(i int) Option[int] = if (i % 2 == 0) Some(i) else None[int]()

func testCustomExtractor() {
    val n = 10
    val res = n match {
        case Even(e) => fmt.Sprintf("%d is even", e)
        case _ => "odd"
    }
    fmt.Printf("Custom extractor: %s\n", res)
}

// Test: Pattern with filter (line 546-551)
func testPatternWithFilter() {
    val x = 150
    val res = x match {
        case i: int if i > 100 => "Large integer"
        case i: int if i > 0   => "Positive integer"
        case _ => "Other"
    }
    fmt.Printf("Filter match: %s\n", res)
}

// Test: Tuple pattern matching (line 782-786)
func testTupleMatch() {
    val t = (1, "hello")
    val msg = t match {
        case (a, b) => s"Got $a and $b"
        case _      => "Unknown"
    }
    fmt.Printf("Tuple match: %s\n", msg)
}

// Test: Tuple destructuring (line 788-789)
func testTupleDestruct() {
    val t = (1, "hello")
    val (a, b) = t
    fmt.Printf("Destructured: a=%d, b=%s\n", a, b)
}

func main() {
    testBasicMatch()
    testTypeMatch()
    testGenericMatch()
    testOptionMatch()
    testExtractorMatch()
    testCustomExtractor()
    testPatternWithFilter()
    testTupleMatch()
    testTupleDestruct()
}
-- examples/doc_verify/immutable_collections_md.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    . "martianoff/gala/collection_immutable"
)

// Test examples from IMMUTABLE_COLLECTIONS.MD

// List Construction (line 96-108)
func testListConstruction() {
    val empty = EmptyList[int]()
    val list = ListOf(1, 2, 3, 4, 5)
    val list2 = EmptyList[int]().Prepend(3).Prepend(2).Prepend(1)

    fmt.Printf("empty.IsEmpty=%v\n", empty.IsEmpty())
    fmt.Printf("list.Length=%d\n", list.Length())
    fmt.Printf("list2=%s\n", list2.String())
}

// List Head/Tail Operations (line 124-140)
func testListHeadTail() {
    val list = ListOf(1, 2, 3)

    fmt.Printf("Head=%d\n", list.Head())
    fmt.Printf("HeadOption=%v\n", list.HeadOption())
    fmt.Printf("Tail=%s\n", list.Tail().String())
    fmt.Printf("Last=%d\n", list.Last())
}

// List Transformations (line 199-222)
func testListTransformations() {
    val list = ListOf(1, 2, 3)

    val mapped = list.Map((x) => x * 2)
    fmt.Printf("Map=%s\n", mapped.String())

    val filtered = list.Filter((x) => x % 2 == 1)
    fmt.Printf("Filter=%s\n", filtered.String())

    val reversed = list.Reverse()
    fmt.Printf("Reverse=%s\n", reversed.String())
}

// List Folding (line 227-240)
func testListFolding() {
    val list = ListOf(1, 2, 3, 4)

    val sum = list.FoldLeft(0, (acc, x) => acc + x)
    fmt.Printf("FoldLeft sum=%d\n", sum)

    val reduced = list.Reduce((a, b) => a + b)
    fmt.Printf("Reduce=%d\n", reduced)
}

// List Pattern Matching (line 287-294)
func testListPatternMatch() {
    val list = ListOf(1, 2, 3)

    val result = list match {
        case Cons(head, tail) => s"head=$head, tail.Length=${tail.Length()}"
        case Nil() => "empty"
        case _ => "other"
    }
    fmt.Printf("Pattern match: %s\n", result)
}

// Array Construction (line 313-322)
func testArrayConstruction() {
    val empty = EmptyArray[int]()
    val arr = ArrayOf(1, 2, 3, 4, 5)

    fmt.Printf("empty.Length=%d\n", empty.Length())
    fmt.Printf("arr.Length=%d\n", arr.Length())
    fmt.Printf("arr.Get(2)=%d\n", arr.Get(2))
}

// Array Operations (line 369-382)
func testArrayOperations() {
    val arr = ArrayOf(2, 3, 4)

    val appended = arr.Append(5)
    fmt.Printf("Append=%s\n", appended.String())

    val prepended = arr.Prepend(1)
    fmt.Printf("Prepend=%s\n", prepended.String())
}

// HashSet Operations (line 572-583)
func testHashSetOperations() {
    val set = HashSetOf(1, 2, 3)

    val added = set.Add(4)
    fmt.Printf("Add=%d\n", added.Size())

    val contains = set.Contains(2)
    fmt.Printf("Contains(2)=%v\n", contains)
}

// HashSet Set Operations (line 587-602)
func testHashSetSetOps() {
    val a = HashSetOf(1, 2, 3, 4)
    val b = HashSetOf(3, 4, 5, 6)

    val union = a.Union(b)
    fmt.Printf("Union size=%d\n", union.Size())

    val inter = a.Intersect(b)
    fmt.Printf("Intersect size=%d\n", inter.Size())

    val diff = a.Diff(b)
    fmt.Printf("Diff size=%d\n", diff.Size())
}

// TreeSet Min/Max (line 764-777)
func testTreeSetMinMax() {
    val set = TreeSetOf(5, 3, 1, 4, 2)

    fmt.Printf("Min=%d\n", set.Min())
    fmt.Printf("Max=%d\n", set.Max())
    fmt.Printf("Head=%d\n", set.Head())
    fmt.Printf("Last=%d\n", set.Last())
}

func main() {
    testListConstruction()
    testListHeadTail()
    testListTransformations()
    testListFolding()
    testListPatternMatch()
    testArrayConstruction()
    testArrayOperations()
    testHashSetOperations()
    testHashSetSetOps()
    testTreeSetMinMax()
}
