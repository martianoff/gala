-- examples/multi_file_codec/main.gala --
package main

// Two files of the main package use the same codecs. Each declares the
// metadata it generates on demand (_StructMeta_Point, _ValueMeta_int) under a
// file-specific name; with shared names the package did not compile
// ("redeclared in this block").

import "martianoff/gala/json"

func main() {
    Println(json.Codec[Point](json.SnakeCase()).Encode(Point(1, 2)))
    Println(json.Value[int]().Decode("3"))
    Println(encodeElsewhere())
}
-- examples/multi_file_codec/points.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/json"
)

// Point is encoded from both files of the package.
struct Point(X int, Y int)

// encodeElsewhere uses the same codecs as main.gala.
func encodeElsewhere() string {
    val p = json.Codec[Point](json.SnakeCase()).Decode("{\"x\":4,\"y\":5}").Map(_.Y).GetOrElse(-1)
    val n = json.Value[int]().Encode(6).GetOrElse("<failure>")
    val ps = json.Value[Array[Point]]().Encode(ArrayOf(Point(7, 8))).GetOrElse("<failure>")
    s"$p $n $ps"
}
