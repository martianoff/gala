-- examples/val_param_plain.gala --
package main

import . "martianoff/gala/collection_immutable"

// A `val` on a parameter is a no-op marker: the parameter is the same plain
// Go parameter as an unmarked one, so every call shape passes its argument as
// it is — a function, a method, a pointer-receiver method, a method value, a
// function-typed parameter given a lambda, a generic function, a default and
// an interface method.

type Conv[A any, B any] func(A) B

struct Parser(Base int)

func (p Parser) Parse(val s string) Try[int] = Success(s.Size() + p.Base)

struct Counter(var N int)

func (c *Counter) Add(val by int) int = c.N + by

type Greeter interface {
    Greet(val name string) string
}

struct English()

func (e English) Greet(val name string) string = s"hi $name"

func size(val s string) int = s.Size()

func applyPlain(val f func(int) int) int = f(1)

func applyConv(val f Conv[int, int]) int = f(10)

func pick[T any](val a T, b T) T = a

func greet(val name string = "world") string = s"hello $name"

func greetVia(g Greeter) string = g.Greet("bob")

// clamp reassigns its parameter, so the parameter is declared `var`.
func clamp(var n int) int {
    if (n < 0) {
        n = 0
    }
    n
}

func main() {
    val p = Parser(10)
    Println(p.Parse("five"))
    Println(Success("abc").FlatMap(p.Parse))
    Println(ArrayOf("a", "bb").Map(p.Parse))
    Println((&Counter(1)).Add(2))
    Println(size("four"))
    Println(applyPlain((x) => x + 2))
    Println(applyConv((x) => x * 3))
    Println(pick("left", "right"))
    Println(greet())
    Println(greet("gala"))
    Println(greetVia(English()))
    Println(clamp(-5))
}
-- examples/val_pointer_field_mutation.gala --
package main

import "fmt"
import . "martianoff/gala/go_interop"

type Value struct {
    var data float64
    var grad float64
}

// Test 1: val binding with pointer to struct with var fields
func testValPointerFieldMutation() {
    var v1 = Value(data = 1.0, grad = 0.0)
    val ptr = &v1

    fmt.Printf("Before: data=%.1f, grad=%.1f\n", ptr.data, ptr.grad)
    ptr.data = 5.0
    ptr.grad = 2.5
    fmt.Printf("After: data=%.1f, grad=%.1f\n", ptr.data, ptr.grad)
}

// Test 2: val binding with slice of pointers (MicroGPT pattern)
func testValFromSlice(values []*Value) {
    val v = values[0]
    v.data = 42.0
    v.grad = 3.14
    fmt.Printf("Slice element: data=%.1f, grad=%.2f\n", v.data, v.grad)
}

// Test 3: compound assignment operators through val pointer binding
func testCompoundAssignment() {
    var v = Value(data = 10.0, grad = 1.0)
    val ptr = &v

    ptr.data += 5.0
    ptr.grad -= 0.5
    fmt.Printf("Compound: data=%.1f, grad=%.1f\n", ptr.data, ptr.grad)
}

func main() {
    fmt.Println("=== val pointer field mutation ===")

    testValPointerFieldMutation()

    var vals []*Value = nil
    vals = SliceAppend(vals, &Value{data: 1.0, grad: 0.0})
    testValFromSlice(vals)

    testCompoundAssignment()

    fmt.Println("=== All tests passed ===")
}
-- examples/value_match_control_flow.gala --
package main

// Control flow in an arm of a match, or a branch of an if-expression, whose
// value is bound to a `val`: a `return` is typed by the enclosing function's
// result, not by the match, a bare `return` leaves a function with no result,
// and `break` / `continue` act on the loop around the declaration.

func typedVal(o Option[int]) string {
    val x int = o match {
        case Some(v) => v
        case None() => { return "none" }
    }
    s"some $x"
}

func voidReturn(o Option[int]) {
    val x = o match {
        case Some(v) => v
        case None() => {
            Println("  voidReturn: none, leaving")
            return
        }
    }
    Println(s"  voidReturn: $x")
}

func assigned(o Option[int]) int {
    var x = 0
    x = o match {
        case Some(v) => v
        case None() => { return -1 }
    }
    x * 10
}

func half(n int) Option[int] = When(n % 2 == 0, n / 2)

func bindPick(n int) Option[int] {
    bind a = half(n)
    val b = a match {
        case 0 => { return Some(-1) }
        case m => m
    }
    Some(b * 10)
}

func breakAndContinue() {
    for i := 0; i < 6; i++ {
        val x = i match {
            case 1 => { continue }
            case 4 => { break }
            case n => n * 10
        }
        val y = if (x == 20) { continue } else x + 1
        Println(s"  loop: $y")
    }
    Println("  loop: done")
}

func main() {
    Println(s"typedVal: ${typedVal(Some(2))} / ${typedVal(None())}")
    Println("voidReturn:")
    voidReturn(Some(2))
    voidReturn(None())
    Println(s"assigned: ${assigned(Some(2))} ${assigned(None())}")
    Println(s"bindPick: ${bindPick(4)} ${bindPick(0)} ${bindPick(3)}")
    Println("breakAndContinue:")
    breakAndContinue()
}
-- examples/value_match_return.gala --
package main

import . "martianoff/gala/go_builtins"

// A `return` in an arm of a match, or a branch of an if-expression, whose
// value is bound to a `val` or `var` returns from the enclosing function — it
// does not just end the match. Each function prints what it computed, so a
// return that only left the match shows up as a wrong number.

func matchVal(o Option[int]) int {
    val x = o match {
        case Some(v) => v
        case None() => { return -1 }
    }
    x * 10
}

func ifVal(n int) int {
    val x = if (n > 0) n else { return -1 }
    x * 10
}

func matchVar(o Option[int]) int {
    var x = o match {
        case Some(v) => v
        case None() => { return -1 }
    }
    x = x + 1
    x * 10
}

func nestedMatch(o Option[int], ok bool) int {
    val x = o match {
        case Some(v) => ok match {
            case true => v
            case false => { return -2 }
        }
        case None() => { return -1 }
    }
    x * 10
}

func ifInMatchArm(o Option[int]) int {
    val x = o match {
        case Some(v) => if (v > 0) v else { return -2 }
        case None() => { return -1 }
    }
    x * 10
}

func returnInBlockArm(o Option[int]) int {
    val x = o match {
        case Some(v) => {
            if (v > 100) {
                return 100
            }
            v
        }
        case None() => -1
    }
    x * 10
}

func firstZero(limit int) int {
    for i := 0; i < limit; i++ {
        val v = (i - 3) match {
            case n if n < 0 => n * -1
            case 0 => { return i }
            case n => n
        }
        Println(s"  firstZero: $v")
    }
    -1
}

func lambdaLocal(n int) int {
    val f = (k int) int => {
        val x = k match {
            case 0 => { return -1 }
            case _ => k
        }
        x * 10
    }
    f(n) + 1000
}

func lambdaTail(n int) int {
    val f = (k int) int => k match {
        case 0 => { return -1 }
        case _ => k * 10
    }
    f(n) + 1000
}

func ifElseLeaves(n int) int {
    val x = if (n > 0) n else {
        if (n == 0) { return 0 } else { return -1 }
    }
    x * 10
}

func returnOrPanic(o Option[int]) int {
    val r = o match {
        case Some(v) => { return v * 10 }
        case None() => Panic("none")
    }
    r
}

func returnOfMatch(o Option[int]) int {
    return o match {
        case Some(v) => v * 10
        case None() => { return -1 }
    }
}

func tupleVal(o Option[int]) Tuple[int, int] {
    val (a, b) = o match {
        case Some(v) => (v, v + 1)
        case None() => { return (-1, -1) }
    }
    (a * 10, b * 10)
}

func tupleVar(n int) int {
    var (a, b) = if (n > 0) (n, n * 2) else { return -1 }
    a = a + 1
    a + b
}

func main() {
    Println(s"matchVal: ${matchVal(Some(2))} ${matchVal(None())}")
    Println(s"ifVal: ${ifVal(2)} ${ifVal(-5)}")
    Println(s"matchVar: ${matchVar(Some(2))} ${matchVar(None())}")
    Println(s"nestedMatch: ${nestedMatch(Some(2), true)} ${nestedMatch(Some(2), false)} ${nestedMatch(None(), true)}")
    Println(s"ifInMatchArm: ${ifInMatchArm(Some(2))} ${ifInMatchArm(Some(-2))} ${ifInMatchArm(None())}")
    Println(s"returnInBlockArm: ${returnInBlockArm(Some(2))} ${returnInBlockArm(Some(200))} ${returnInBlockArm(None())}")
    Println("firstZero:")
    Println(s"  result ${firstZero(10)}")
    Println(s"lambdaLocal: ${lambdaLocal(2)} ${lambdaLocal(0)}")
    Println(s"lambdaTail: ${lambdaTail(2)} ${lambdaTail(0)}")
    Println(s"ifElseLeaves: ${ifElseLeaves(2)} ${ifElseLeaves(0)} ${ifElseLeaves(-2)}")
    Println(s"returnOrPanic: ${returnOrPanic(Some(2))}")
    Println(s"returnOfMatch: ${returnOfMatch(Some(2))} ${returnOfMatch(None())}")
    Println(s"tupleVal: ${tupleVal(Some(2))} ${tupleVal(None())}")
    Println(s"tupleVar: ${tupleVar(2)} ${tupleVar(-2)}")
}
-- examples/value_match_use_release.gala --
package main

// A `use` in an arm of a match, or a branch of an if-expression, that a local
// `val` is initialized with releases its resource at the end of the match —
// not when the enclosing function returns — even when another arm has a
// `return`, `break` or `continue` that leaves the function or loop. Each
// resource prints when it closes, so a release that waits for the end of the
// function shows up after the lines printed between.

type Res struct {
    Name string
}

func (r Res) Close() error {
    Println(s"  close ${r.Name}")
    nil
}

func open(i int) Option[Res] = When(i >= 0, Res(Name = s"r$i"))

// Each iteration's resource is released before the next one opens.
func inLoop(n int) int {
    var total = 0
    for i := 0; i < n; i++ {
        val k = open(i) match {
            case Some(r) => {
                use f = r
                Println(s"  use ${f.Name}")
                i + 1
            }
            case None() => { return -1 }
        }
        total = total + k
        Println(s"  after match $i")
    }
    Println("  end of inLoop")
    total
}

// A `return` in the arm that holds the `use` releases the resource, then
// leaves the function with its value.
func returnAfterUse(i int) int {
    val k = open(i) match {
        case Some(r) => {
            use f = r
            if (i > 5) {
                return i * 100
            }
            i
        }
        case None() => -1
    }
    Println(s"  after match $k")
    k * 10
}

// `break` and `continue` in the arm that holds the `use` act on the loop
// around the match, after the release.
func loopControl(n int) int {
    var total = 0
    for i := 0; i < n; i++ {
        val k = open(i) match {
            case Some(r) => {
                use f = r
                if (i == 1) {
                    continue
                }
                if (i == 3) {
                    break
                }
                i
            }
            case None() => { return -1 }
        }
        Println(s"  after match $i")
        total = total + k
    }
    total
}

// So does a match used as a statement whose other arm returns.
func statementMatch(n int) int {
    for i := 0; i < n; i++ {
        open(i) match {
            case Some(r) => {
                use f = r
                Println(s"  use ${f.Name}")
            }
            case None() => { return -1 }
        }
        Println(s"  after match $i")
    }
    n
}

func ifBranch(i int) int {
    val k = if (i >= 0) {
        use f = Res(Name = s"if$i")
        i * 2
    } else {
        return -1
    }
    Println(s"  after if $k")
    k
}

// A `use` in a nested match is released at the end of that match.
func nested(i int, ok bool) int {
    val k = open(i) match {
        case Some(r) => {
            use outer = r
            val inner = ok match {
                case true => {
                    use f = Res(Name = s"inner$i")
                    i + 1
                }
                case false => { return -2 }
            }
            Println(s"  after inner match $inner")
            inner
        }
        case None() => { return -1 }
    }
    Println(s"  after outer match $k")
    k
}

func inLambda(n int) int {
    val f = (i int) int => {
        val k = open(i) match {
            case Some(r) => {
                use g = r
                i
            }
            case None() => { return -1 }
        }
        Println(s"  after match in lambda $k")
        k + 1
    }
    f(n) + f(-1)
}

// A lambda whose result type its own `return`s give: the first one, lowered
// before that type is known, is completed once the second one gives it.
func inUntypedLambda(o Option[Res]) Option[int] {
    val g = (p Option[Res]) => {
        val k = p match {
            case None() => { return None() }
            case Some(r) => {
                use h = r
                if (h.Name == "r9") {
                    return Some(-1)
                }
                h.Name.Size()
            }
        }
        Println("  after match in untyped lambda")
        return Some(k)
    }
    g(o)
}

func main() {
    Println("inLoop:")
    Println(s"  result ${inLoop(2)}")
    Println("returnAfterUse:")
    Println(s"  result ${returnAfterUse(2)}")
    Println(s"  result ${returnAfterUse(7)}")
    Println("loopControl:")
    Println(s"  result ${loopControl(5)}")
    Println("statementMatch:")
    Println(s"  result ${statementMatch(2)}")
    Println("ifBranch:")
    Println(s"  result ${ifBranch(3)} ${ifBranch(-3)}")
    Println("nested:")
    Println(s"  result ${nested(1, true)}")
    Println(s"  result ${nested(1, false)}")
    Println("inLambda:")
    Println(s"  result ${inLambda(4)}")
    Println("inUntypedLambda:")
    Println(s"  result ${inUntypedLambda(open(1))} ${inUntypedLambda(open(9))} ${inUntypedLambda(open(-1))}")
}
-- examples/value_receiver_bind_ptr.gala --
package main

import . "martianoff/gala/validation"

// A pointer to a monad value binds as the value it points to when the monad's
// FlatMap or ZipN takes a value: `bind a = &x` runs `x.FlatMap(...)`, as the
// written-out `(&x).FlatMap(...)` does, and a pointer filling a value
// parameter of a Zip is its pointee.

struct Box[T any](V T)

func (b Box[T]) FlatMap[U any](f func(T) Box[U]) Box[U] = f(b.V)

func (b Box[T]) Zip2[U any](o Box[U]) Box[Tuple[T, U]] = Box(Tuple(b.V, o.V))

func (b Box[T]) Zip3[U any, V any](o Box[U], p Box[V]) Box[Tuple3[T, U, V]] = Box(Tuple3(b.V, o.V, p.V))

func viaAddress() Box[int] {
    var x = Box(1)
    bind a = &x
    Box(a + 1)
}

func viaPtr(p Ptr[Box[int]]) Box[int] {
    bind a = p
    bind b = p
    Box(a * 10 + b)
}

// A Go-style lookup: its pointer may be nil.
func find(found bool) *Box[int] = if (found) &Box(4) else nil

func viaRequirePtr() Box[int] {
    bind a = RequirePtr(find(true))
    Box(a * 3)
}

func written(p Ptr[Box[int]]) Box[int] = p.FlatMap((a) => Box(a + 100))

func zipped() Box[int] {
    var x = Box(1)
    var y = Box(2)
    bind a = &x
    also b = &y
    Box(a * 10 + b)
}

func zipped3(p Ptr[Box[int]]) Box[int] {
    var z = Box(3)
    bind a = Box(1)
    also b = p
    also c = &z
    Box(a * 100 + b * 10 + c)
}

// A FlatMap and Zip on Ptr receivers with a value parameter: the first clause
// is addressed, a pointer in the second fills the value parameter.
struct Cell[T any](V T)

func (c Ptr[Cell[T]]) FlatMap[U any](f func(T) Cell[U]) Cell[U] = f(c.V)

func (c Ptr[Cell[T]]) Zip2[U any](o Cell[U]) Cell[Tuple[T, U]] = Cell(Tuple(c.V, o.V))

func cellZipped() Cell[int] {
    var y = Cell(2)
    bind a = Cell(1)
    also b = &y
    Cell(a + b)
}

// A monad from another package: Validated's FlatMap and Zip2 take values.
func two() Validated[string, int] = Valid(2)

func validated() Validated[string, int] {
    var x = two()
    var y = two()
    bind a = &x
    also b = &y
    Valid(a * 10 + b)
}

func optionAddress() Option[int] {
    var o = Some(7)
    bind a = &o
    Some(a * 6)
}

func main() {
    var shared = Box(4)
    Println(s"address: ${viaAddress().V}")
    Println(s"ptr: ${viaPtr(&shared).V}")
    Println(s"require: ${viaRequirePtr().V}")
    Println(s"written: ${written(&shared).V}")
    Println(s"zipped: ${zipped().V}")
    Println(s"zipped3: ${zipped3(&shared).V}")
    Println(s"cell: ${cellZipped().V}")
    Println(s"validated: ${validated()}")
    Println(s"option: ${optionAddress()}")
}
-- examples/var_tuple_destructuring.gala --
package main

// `var (a, b) = tuple` destructures like `val (a, b) = tuple`, but each name
// is a mutable variable that can be reassigned afterwards.

var (hits, misses) = (0, 0)

func record(hit bool) {
    if (hit) {
        hits = hits + 1
    } else {
        misses = misses + 1
    }
}

func divmod(a int, b int) Tuple[int, int] = (a / b, a % b)

func main() {
    var (lo, hi) = (3, 9)
    Println(s"lo=$lo hi=$hi")
    lo = lo * 2
    hi += 1
    Println(s"lo=$lo hi=$hi")

    // Reassign both bindings, here swapping them through a tuple.
    var (left, right) = ("a", "b")
    val swapped = (right, left)
    left = swapped.V1
    right = swapped.V2
    Println(s"left=$left right=$right")

    // From a function result; the bindings take its component types.
    var (q, r) = divmod(17, 5)
    r += 5
    q -= 1
    Println(s"q=$q r=$r")

    // Package-level bindings, reassigned from another function.
    record(true)
    record(true)
    record(false)
    Println(s"hits=$hits misses=$misses")
}
-- examples/variadic_functions.gala --
package main

import "fmt"

// Simple variadic function
func sum(numbers ...int) int {
    var total = 0
    for _, n := range numbers {
        total = total + n
    }
    return total
}

// Variadic with regular params
func formatList(prefix string, items ...string) string {
    var result = prefix
    for i, item := range items {
        if i > 0 {
            result = result + ", "
        }
        result = result + item
    }
    return result
}

func main() {
    // Basic variadic calls
    fmt.Println(sum(1, 2, 3))
    fmt.Println(sum(10, 20, 30, 40))
    fmt.Println(sum())

    // Mixed params + variadic
    fmt.Println(formatList("Items: ", "a", "b", "c"))

    // Single argument
    fmt.Println(sum(42))
}
-- examples/variadic_generic_spread.gala --
package main

import "fmt"

// T7: Variadic + generics combined.
// Exercises:
//   - generic variadic function definition
//   - type-parameter inference from the variadic argument
//   - multiple distinct type instantiations of the same generic
//   - non-generic variadic as a baseline
func headOr[T any](fallback T, xs ...T) T {
    if xs.Size() == 0 {
        return fallback
    }
    return xs[0]
}

func sumAll(xs ...int) int {
    var total = 0
    for _, n := range xs {
        total = total + n
    }
    return total
}

func main() {
    // Generic variadic with multiple int args.
    fmt.Println(headOr[int](-1, 10, 20, 30))
    fmt.Println(headOr[int](-1))

    // Non-generic variadic.
    fmt.Println(sumAll(10, 20, 30))

    // String instantiation exercises a different type parameter.
    fmt.Println(headOr[string]("?", "a", "b", "c"))
}
-- examples/variadic_tail_args.gala --
package main

import . "martianoff/gala/collection_immutable"
import . "martianoff/gala/go_interop"

// Counter is a mutable count.
struct Counter(var N int)

// Count is the counter's value.
func (c Ptr[Counter]) Count() int = c.N

func total(cs ...Ptr[Counter]) int = ArrayOf(cs...).FoldLeft(0, (acc, c) => acc + c.Count())

func pipe(fs ...func(int) int) int = ArrayOf(fs...).FoldLeft(1, (acc, f) => f(acc))

// Group names a set of counters.
struct Group(Name string)

// Total labels the sum of the counters.
func (g Group) Total(label string, cs ...Ptr[Counter]) string = s"$label: ${total(cs...)}"

// Pipe applies each function in turn, starting from 1.
func (g Group) Pipe(fs ...func(int) int) int = pipe(fs...)

func sizes[T any](f func(T) int, xs ...Option[T]) int = ArrayOf(xs...).FoldLeft(0, (acc, o) => acc + o.Map(f).GetOrElse(0))

func lookup(found bool) *Counter = if (found) &Counter(5) else nil

func main() {
    var a = Counter(1)
    var b = Counter(2)
    // Every argument filling a ...Ptr[Counter] is a Ptr: `&x`, or a Go
    // pointer checked by RequirePtr.
    Println(total(&a, &b, RequirePtr(lookup(true))))
    Println(Group("g").Total("group", &a, &b))
    val cs = SliceOf(&a, &b)
    Println(total(cs...))
    // A pointer that may be nil is kept as an OptionPtr.
    Println(OptionPtrOf(lookup(false)).IsEmpty())
    // Each lambda filling a variadic parameter takes its parameter types from
    // the element type.
    Println(pipe((x) => x + 1, (x) => x * 10, _ + 5))
    Println(Group("g").Pipe((x) => x * 3, (x) => x - 1))
    // A later variadic argument binds the type the lambda needs.
    Println(sizes((s) => s.Size(), None(), Some("abc")))
}
-- examples/void_expression_function.gala --
package main

// An expression-bodied function with no result type is void: the expression
// after `=` runs as a statement, exactly as in `func f() { <expr> }`.

func fortyTwo() int {
    Println("computing 42")
    42
}

// A call whose result is discarded.
func warmUp() = fortyTwo()

func greet(name string) = Println(s"hello $name")

func describe(n int) = n match {
    case 0 => Println("zero")
    case _ => Println(s"n = $n")
}

func sign(n int) = if (n < 0) Println("negative") else Println("non-negative")

func countdown(n int) = if (n == 0) Println("liftoff") else countdown(n - 1)

func main() {
    warmUp()
    greet("gala")
    describe(0)
    describe(5)
    sign(-1)
    sign(1)
    countdown(3)
}
-- examples/void_match.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"
import "martianoff/gala/go_interop"

sealed type Classify {
    case Even()
    case Odd()
}

func classify(n int) Classify = if (n % 2 == 0) Even() else Odd()

// Verifies that match expressions with assignment-only branches work correctly.
// Previously, the transpiler would error when the last statement in a case body
// was an assignment (not an expression).
func main() {
    var evens = ArrayOf[int]()
    var odds = ArrayOf[int]()

    val numbers = go_interop.SliceOf(1, 2, 3, 4, 5)
    for _, n := range numbers {
        classify(n) match {
            case Even() => {
                evens = evens.Append(n)
            }
            case Odd() => {
                odds = odds.Append(n)
            }
        }
    }

    fmt.Println(evens)
    fmt.Println(odds)
}
-- examples/when_flatmap_regress/logic.gala --
package when_flatmap_regress

// Regression: When[T] inside generic lambda generates undefined: T (or Option[any]).
// In multi-file batch mode, calling When(cond, val) inside a FlatMap lambda
// fails to resolve T to the concrete type.

// Test with GALA types (cross-file)
func LookupWithCrossFileType(key string) Option[string] {
    val opt = Some(NewUser("alice", "alice@example.com"))
    return opt.FlatMap((user) => {
        val found = user.Name != ""
        return When(found, user.Email)
    })
}

// Test with simple types
func LookupSimple(key string) Option[string] {
    val opt = Some("data")
    return opt.FlatMap((data) => {
        val found = key != ""
        return When(found, s"value-for-$key")
    })
}

// Test with nested When inside Map
func TransformIfFound(key string) Option[string] {
    val opt = Some(NewUser("bob", "bob@test.com"))
    return opt.Map((user) => user.Email).FlatMap((email) => {
        val found = email != ""
        return When(found, email)
    })
}
-- examples/when_flatmap_regress/types.gala --
package when_flatmap_regress

// Second file to force multi-file batch transpilation.

type UserInfo struct {
    Name  string
    Email string
}

func NewUser(name string, email string) UserInfo = UserInfo(Name = name, Email = email)
-- examples/when_flatmap_regress_test.gala --
package main

import "martianoff/gala/examples/when_flatmap_regress"

func main() {
    // When with cross-file GALA type in FlatMap
    Println(when_flatmap_regress.LookupWithCrossFileType("test").GetOrElse("none"))

    // When with simple types in FlatMap
    Println(when_flatmap_regress.LookupSimple("test-key").GetOrElse("none"))

    // Nested Map + FlatMap with When
    Println(when_flatmap_regress.TransformIfFound("test").GetOrElse("none"))
}
