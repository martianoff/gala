    fmt.Println(lookup(db, "test"))
    fmt.Println(lookup(db, "missing"))
}
-- examples/match_nested_subject_unread.gala --
package main

// A match whose arms never read its subject, while a nested match reads its
// own: the outer subject is bound only when an arm reads it, and the inner
// match's `obj` or a field named `obj` is no read of the outer one.

struct Box(obj int)

func pick(x int, y int, flag bool) string = x match {
    case _ if flag => y match {
        case 1 => "one"
        case _ => "other"
    }
    case _ => "z"
}

func field(x int, b Box) int = x match {
    case _ if b.obj > 0 => b.obj
    case _ => -1
}

func main() {
    Println(pick(5, 1, true))
    Println(pick(5, 2, true))
    Println(pick(5, 1, false))
    Println(field(0, Box(7)))
    Println(field(0, Box(0)))
}
-- examples/match_return_iife.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

func classify(opt Option[int]) string {
    val x = opt.GetOrElse(0)
    x match {
        case 0 => "zero"
        case 1 => "one"
        case _ => "other"
    }
}

func main() {
    fmt.Println(classify(Some(0)))
    fmt.Println(classify(Some(1)))
    fmt.Println(classify(Some(42)))
    fmt.Println(classify(None[int]()))
}
-- examples/match_return_statement.gala --
package main

import . "martianoff/gala/collection_immutable"

// Regression: `return X` inside a `match` arm body at statement position
// (i.e. the match's value is discarded; the match is being used as a
// statement, not as the value of an expression) must return from the
// enclosing function, not just from the IIFE that lowers the match.
//
// Two shapes are exercised here:
//   1. firstOdd: simple match-as-statement with a return inside an `if`
//      inside the case body.
//   2. parseImpl: mirrors the real-world stateful tape walk shape from
//      gala_team's directive parser — a `for` loop where the trailing
//      statement is a match, the case body is a block containing more
//      `val` bindings, an `if` whose `then` arm wants to bail out via
//      `return out`, and an `else` arm that contains *another* nested
//      match. Without the fix, the `return out` only escapes the IIFE,
//      the cursor `i` never advances past the early-exit branch, and
//      the for loop spins forever.


func firstOdd(xs Array[int]) int {
    var i = 0
    val n = xs.Size()
    for i < n {
        val v = xs.Get(i)
        Some(v) match {
            case Some(x) => {
                if x % 2 == 1 {
                    return x
                }
                i = i + 1
            }
            case None() => i = i + 1
        }
    }
    return -1
}

func parseImpl(lines Array[int], stopAtNegative bool) Array[int] {
    var out = EmptyArray[int]()
    var i = 0
    val n = lines.Size()
    for i < n {
        val line = lines.Get(i)
        Some(line) match {
            case Some(v) => {
                val doubled = v * 2
                if stopAtNegative && v < 0 {
                    return out
                } else {
                    Some(doubled) match {
                        case Some(d) => out = out.Append(d)
                        case None()  => {}
                    }
                    i = i + 1
                }
            }
            case None() => i = i + 1
        }
    }
    return out
}

func main() {
    val xs = ArrayOf(2, 4, 6, 7, 8, 9)
    Println(firstOdd(xs))
    val ys = ArrayOf(2, 4, 6)
    Println(firstOdd(ys))
    val zs = ArrayOf(1, 2, 3, -1, 99)
    Println(parseImpl(zs, true).MkString(","))
    Println(parseImpl(zs, false).MkString(","))
}
-- examples/match_sealed_branch_infer.gala --
package main

func main() {
    val x = Some(42)

    // A branch returning None() takes its type from its sibling branch:
    // Some(v * 2) is an Option[int], so None() is None[int]()
    val result = x match {
        case Some(v) => Some(v * 2)
        case None() => None()
    }

    Println(result)

    // Verify None() branch works correctly when None is matched
    val y = result match {
        case Some(_) => None()
        case None() => Some(0)
    }

    Println(y)
}
-- examples/match_standalone_stmt.gala --
package main

func main() {
    var sideEffect = 0

    // Test 1: match as standalone statement with assignment body (no block needed)
    val x = Some(42)
    x match {
        case Some(v) => sideEffect = v
        case _ => sideEffect = -1
    }
    Println(s"test1: $sideEffect")

    // Test 2: match as standalone statement with block bodies
    val y = Some(100)
    y match {
        case Some(v) => { sideEffect = v + 1 }
        case _ => { sideEffect = -1 }
    }
    Println(s"test2: $sideEffect")

    // Test 3: match as standalone statement with function call body
    val z = Some("hello")
    z match {
        case Some(v) => Println(s"value: $v")
        case _ => Println("none")
    }
}
-- examples/match_stmt_guard_dispatch.gala --
package main

// A statement-position match (its value is discarded) dispatches purely for
// side effects, so its arms may call functions with different return types.
func record(c int) {
    c match {
        case 1 => { Println("one") }
        case 2 => { Println(s"two=${2}") }
        case _ => { Println("many") }
    }
}

// A guarded wildcard `case _ if g` is conditional, so it can precede a real
// `case _` default without being treated as a duplicate default.
func size(n int) string = n match {
    case 0          => "empty"
    case _ if n < 10 => "small"
    case _          => "large"
}

func main() {
    record(1)
    record(2)
    record(9)
    Println(size(0))
    Println(size(5))
    Println(size(42))
}
-- examples/match_stmt_mixed_void.gala --
package main

// Regression: a `subject match { ... }` used as a *statement* (its value
// discarded) where one arm calls a value-returning function and another
// arm calls a void-returning function. Without the statement-position
// fix, the IIFE inherited the value arm's return type, and the void arm
// was emitted as `return d.Skip()` — which Go rejects with
// "no value used as value".
//
// The fix lowers the IIFE as void when the match's value is discarded
// (statement position), so void-returning arm calls are emitted as bare
// expression statements, not return statements.

func readValue() bool {
    Println("read")
    return true
}

func skip() {
    Println("skipped")
}

func dispatch(key string) {
    var unhandled = 0
    // Statement-position match: value discarded.
    // - "value" arm calls a function returning bool (typed value).
    // - "skip" arm calls a function returning nothing (void).
    // - default arm (assignment) returns void via simple statement.
    // Result type would otherwise widen to bool, forcing the void
    // arms into `return <voidCall>` which fails Go compilation.
    key match {
        case "value" => readValue()
        case "skip"  => skip()
        case _       => unhandled = unhandled + 1
    }
    if unhandled > 0 {
        Println(s"unhandled: $unhandled")
    }
}

func main() {
    dispatch("value")
    dispatch("skip")
    dispatch("other")
}
-- examples/match_stmt_true_dangle.gala --
package main

// Regression: a `subject match { ... }` used as a *statement* (its value
// discarded) whose arms end in an assignment, with no value of their own.
//
// In statement position the match is lowered as void, so arms that produce
// no value are fine. An arm that ends in a plain value instead — a literal or
// a name, as in `case Read() => { seen = 1; true }` — is rejected as evaluated
// but not used, like any other value written as a statement.

sealed type Mode {
    case Read()
    case Write()
    case Append()
}

func observeSeen(m Mode) int {
    var seen = 0
    m match {
        case Read() => {
            seen = 1
        }
        case Write() => {
            seen = 2
        }
        case Append() => {
            seen = 3
        }
    }
    seen
}

func observePicked(m Mode) string {
    var picked = ""
    m match {
        case Read() => {
            picked = "r"
        }
        case Write() => {
            picked = "w"
        }
        case Append() => {
            picked = "a"
        }
    }
    picked
}

func main() {
    Println(observeSeen(Read()))
    Println(observeSeen(Write()))
    Println(observeSeen(Append()))
    Println(observePicked(Read()))
    Println(observePicked(Write()))
    Println(observePicked(Append()))
}
-- examples/match_type_inference.gala --
package main

import "os"

// Case 4: Match on string for val assignment with string literal and identifier branches
func getPort() string {
    val envPort = os.Getenv("PORT")
    val port = envPort match {
        case "" => "3000"
        case _ => envPort
    }
    return port
}

// Case: Match with all branches returning string literals
func describeEnv(key string) string {
    return key match {
        case "HOME" => "home directory"
        case "PATH" => "executable search path"
        case _ => "unknown"
    }
}

func main() {
    Println(getPort())
    Println(describeEnv("HOME"))
    Println(describeEnv("OTHER"))
}
-- examples/match_type_switch.gala --
package main

import "fmt"

// A match over the dynamic type of a type parameter or an interface value,
// whose arms are type patterns, `_` and bindings, is dispatched by one Go type
// switch. It matches exactly as a type pattern always does: arms in order, a
// value inside an Immutable and the error of a recovered panic looked through.

// Label is a plain struct a concrete arm matches.
struct Label(Text string)

// Point is Hashable.
struct Point(X int, Y int)

// Hash makes Point Hashable.
func (p Point) Hash() uint32 = uint32(p.X * 31 + p.Y)

// Oops is an error of its own type.
struct Oops(Code int)

// Error makes Oops an error.
func (o Oops) Error() string = s"oops ${o.Code}"

// String makes Oops a fmt.Stringer.
func (o Oops) String() string = s"Oops#${o.Code}"

// classify mixes concrete and interface arms, a guarded `_` and a default.
func classify[T any](v T, loud bool) string = v match {
    case i: int => s"int $i"
    case s: string => s"string $s"
    case l: Label => s"label ${l.Text}"
    case o: Oops => s"oops ${o.Code}"
    case e: error => s"error ${e.Error()}"
    case h: Hashable => s"hashable ${h.Hash()}"
    case _ if loud => "LOUD OTHER"
    case _ => "other"
}

// stringerFirst matches an error, an interface value, and lists an interface
// before a type that implements it: the first arm that matches wins.
func stringerFirst(err error) string = err match {
    case s: fmt.Stringer => s"stringer first: ${s.String()}"
    case o: Oops => s"oops second: ${o.Code}"
    case other => s"bound: ${other.Error()}"
}

// guardedInt has a guard on a type arm, which a type switch cannot express:
// it keeps testing each pattern in turn.
func guardedInt[T any](v T) string = v match {
    case i: int if i > 10 => s"big $i"
    case i: int => s"small $i"
    case _ => "not an int"
}

// Celsius names int itself, so its arm tests int a second time, which a type
// switch cannot list twice: this match, too, tests each pattern in turn.
type Celsius int

// temperature matches int and Celsius, the same type.
func temperature[T any](v T) string = v match {
    case i: int => s"int $i"
    case c: Celsius => s"celsius $c"
    case _ => "no temperature"
}

// firstInt leaves the function from an arm.
func firstInt[T any](v T) int {
    v match {
        case i: int => { return i }
        case _ => Println("not an int")
    }
    return -1
}

// doubled stores the match's value; one arm leaves the function instead.
func doubled[T any](v T) int {
    val n = v match {
        case i: int => i * 2
        case s: string => s.Size()
        case _ => { return -1 }
    }
    n + 1
}

// explode panics with an Oops for a positive code.
func explode(code int) int {
    if code > 0 {
        Panic(Oops(Code = code))
    }
    code
}

// boom panics with a string when asked to.
func boom(fail bool) int {
    if fail {
        Panic("boom")
    }
    0
}

// recovered is the error of the panic body raises.
func recovered(body func() int) error = Try(body) match {
    case Failure(e) => e
    case Success(n) => fmt.Errorf("no panic: %d", n)
}

func main() {
    Println(classify(1000, false))
    Println(classify("hi", false))
    Println(classify(Label(Text = "tag"), false))
    Println(classify(Oops(Code = 1), false))
    Println(classify(fmt.Errorf("plain"), false))
    Println(classify(Point(X = 1, Y = 2), false))
    Println(classify(2.5, false))
    Println(classify(2.5, true))

    // nil holds no type: no type arm matches it.
    val noError error = nil
    Println(classify(noError, false))

    // An Immutable is matched by the value it holds.
    Println(classify(NewImmutable(1000), false))
    Println(classify(NewImmutable(Label(Text = "kept")), false))

    // A recovered panic's error is matched by the error it holds, and is an
    // error itself.
    Println(classify(recovered(explode(7)), false))
    Println(classify(recovered(boom(true)), false))

    Println(stringerFirst(Oops(Code = 3)))
    Println(stringerFirst(recovered(explode(4))))
    Println(stringerFirst(fmt.Errorf("plain")))
    Println(stringerFirst(recovered(explode(0))))

    Println(guardedInt(42))
    Println(guardedInt(3))
    Println(guardedInt("3"))

    Println(temperature(Celsius(21)))
    Println(temperature("warm"))

    Println(firstInt(9))
    Println(firstInt("nine"))

    Println(doubled(21))
    Println(doubled("abc"))
    Println(doubled(true))
}
-- examples/match_var_fields.gala --
package main

// A struct pattern reads each field straight off the matched value. A `var`
// field is a plain Go field, and a non-`var` field is a `std.Immutable[T]`, so
// only the latter may be unwrapped with `.Get()`. Every shape below mixes the
// two kinds so that a wrong unwrap in either direction fails to build.

struct Point(var X int, var Y int)

struct Labeled(var Name string, Weight int)

struct Segment(From Point, var To Point)

struct Box[T any](var Item T, Tag string)

func describePoint(p Point) string = p match {
    case Point(0, 0) => "origin"
    case Point(0, y) => s"on y-axis at $y"
    case Point(x, y) if x == y => s"diagonal $x"
    case Point(x, y) => s"point $x,$y"
    case _ => "unreachable"
}

func describeLabeled(l Labeled) string = l match {
    case Labeled("heavy", w) => s"named heavy, weight $w"
    case Labeled(n, 0) => s"$n weighs nothing"
    case Labeled(n, w) => s"$n weighs $w"
    case _ => "unreachable"
}

func describeSegment(s Segment) string = s match {
    case Segment(Point(0, 0), Point(x, y)) => s"from origin to $x,$y"
    case Segment(Point(a, b), Point(c, d)) if a == c => s"vertical at $a from $b to $d"
    case Segment(Point(a, b), _) => s"starts at $a,$b"
    case _ => "unreachable"
}

func describeBox[T any](b Box[T]) string = b match {
    case Box(item, "pinned") => s"pinned $item"
    case Box(item, tag) => s"$tag holds $item"
    case _ => "unreachable"
}

func typedX(v any) string = v match {
    case Point(x: int, _) => s"typed x $x"
    case _ => "not a point"
}

func main() {
    Println(describePoint(Point(0, 0)))
    Println(describePoint(Point(0, 7)))
    Println(describePoint(Point(4, 4)))
    Println(describePoint(Point(3, 5)))

    Println(describeLabeled(Labeled("heavy", 90)))
    Println(describeLabeled(Labeled("feather", 0)))
    Println(describeLabeled(Labeled("stone", 12)))

    Println(describeSegment(Segment(Point(0, 0), Point(2, 3))))
    Println(describeSegment(Segment(Point(1, 2), Point(1, 9))))
    Println(describeSegment(Segment(Point(5, 6), Point(7, 8))))

    Println(describeBox(Box(42, "pinned")))
    Println(describeBox(Box("tea", "shelf")))

    Println(typedX(Point(11, 12)))
    Println(typedX("text"))

    // A `var` field stays reassignable, and the match sees the new value.
    var moving = Point(1, 1)
    moving.X = 9
    Println(describePoint(moving))
}
-- examples/match_void_branches.gala --
package main

func greet(name string) {
    Println(s"Hello, $name!")
}

func farewell(name string) {
    Println(s"Goodbye, $name!")
}

func main() {
    val result = Some("World")
    result match {
        case Some(name) => greet(name)
        case None() => farewell("nobody")
    }

    Println("Done")
}
-- examples/match_void_dispatch.gala --
package main

sealed type Shape {
    case Point()
    case Line()
    case Nothing()
    case Nested(Inner Shape)
}

func doStuff() {
    Println("side effect")
}

func log(s Shape) {
    s match {
        case Point()       => doStuff()
        case Line()        => Println("line")
        case Nothing()     => {}
        case Nested(inner) => log(inner)
    }
}

func main() {
    log(Nested(Line()))
}
-- examples/match_void_pointer_arg.gala --
package main

// Regression example for: pointer-receiver void method calls inside a
// statement-form match arm must not panic the transpiler.
//
// The combination that previously broke inference:
//   - A sealed-type `match` used as a statement (no result bound to val/var).
//   - Arms that call pointer-receiver methods declared with no return type.
//   - And/or arms that call free functions taking a `*T` as an argument.
//
// During per-arm result-type inference, resolveMethodCallType returned the
// method's raw nil ReturnType interface; the caller's `!result.IsNil()` check
// then nil-derefs. The resolver now normalises absent ReturnType to VoidType.

sealed type W {
    case TextW(Content string)
    case FillW(Ch rune)
}

type Buf struct {
    var count int
}

func (b *Buf) Bump() {
    b.count = b.count + 1
}

func renderText(s string, buf *Buf) {
    buf.Bump()
}

func render(w W, buf *Buf) {
    w match {
        case TextW(s) => renderText(s, buf)
        case FillW(_) => buf.Bump()
    }
}

func main() {
    var b = Buf{count: 0}
    render(TextW("hi"), &b)
    render(FillW('x'), &b)
    Println(b.count)
}
-- examples/mathlib/math.gala --
package mathlib

func Add(a int, b int) int = a + b
-- examples/method_default_params.gala --
package main

type Config struct {
    host string
    port int
    debug bool
}

func (c Config) copy(host string = c.host, port int = c.port, debug bool = c.debug) Config =
    Config(host, port, debug)

func (c Config) WithHost(host string) Config = c.copy(host = host)
func (c Config) WithPort(port int) Config = c.copy(port = port)
func (c Config) WithDebug(debug bool) Config = c.copy(debug = debug)

func main() {
    val config = Config("localhost", 8080, false)
    Println(s"${config.host}:${config.port} debug=${config.debug}")

    val c2 = config.WithPort(9090)
    Println(s"${c2.host}:${c2.port} debug=${c2.debug}")

    val c3 = config.WithHost("example.com")
    Println(s"${c3.host}:${c3.port} debug=${c3.debug}")

    val c4 = config.WithDebug(true)
    Println(s"${c4.host}:${c4.port} debug=${c4.debug}")

    // Named args with multiple overrides
    val c5 = config.copy(host = "prod.com", debug = true)
    Println(s"${c5.host}:${c5.port} debug=${c5.debug}")

    // Positional defaults (fewer args than params)
    val c6 = config.copy("staging.com")
    Println(s"${c6.host}:${c6.port} debug=${c6.debug}")
}
-- examples/method_result_field_chain.gala --
package main

import . "martianoff/gala/collection_immutable"

// Field chains through the result of a method call must unwrap each
// immutable field, whether the method has a value or a pointer receiver and
// whether the receiver is bound with val or var. A method named Get is the
// sharpest case because it shares its name with the Immutable accessor. The
// `var` bindings are never reassigned on purpose: they exercise that path.

// Style is the innermost struct of the field chain.
struct Style(Bold bool)

// Cell nests a Style, so reading St.Bold crosses two immutable fields.
struct Cell(Ch rune, St Style)

// MakeCell builds a Cell.
func MakeCell(ch rune, bold bool) Cell = Cell(Ch = ch, St = Style(Bold = bold))

func same[V comparable](a V, b V) bool = a == b

// PtrBuffer has a pointer-receiver method named like the Immutable accessor.
type PtrBuffer struct {
    cell Cell
}

func (b *PtrBuffer) Get() Cell = b.cell

// Grid has a pointer-receiver Get backed by a GALA collection, taking an index.
type Grid struct {
    cells Array[Cell]
}

func (g *Grid) Get(i int) Cell = g.cells.Get(i)

// ValBuffer has a value-receiver Get.
type ValBuffer struct {
    cell Cell
}

func (b ValBuffer) Get() Cell = b.cell

// Holder is a shorthand struct with a pointer-receiver method under another name.
struct Holder(cell Cell)

func (h *Holder) Current() Cell = h.cell

func main() {
    var pvar = &PtrBuffer(cell = MakeCell('a', true))
    Println(s"ptr var:   ${pvar.Get().St.Bold} ${same(pvar.Get().Ch, 'a')}")
    val fromVar = pvar.Get()
    Println(s"ptr bound: ${fromVar.St.Bold} ${same(fromVar.Ch, 'a')}")

    val pval = &PtrBuffer(cell = MakeCell('b', false))
    Println(s"ptr val:   ${pval.Get().St.Bold} ${same(pval.Get().Ch, 'b')}")

    val grid = &Grid(cells = ArrayOf(MakeCell('c', true), MakeCell('d', false)))
    Println(s"grid:      ${grid.Get(0).St.Bold} ${grid.Get(1).St.Bold} ${same(grid.Get(1).Ch, 'd')}")

    val vval = ValBuffer(cell = MakeCell('e', true))
    Println(s"value val: ${vval.Get().St.Bold} ${same(vval.Get().Ch, 'e')}")
    var vvar = ValBuffer(cell = MakeCell('f', false))
    Println(s"value var: ${vvar.Get().St.Bold} ${same(vvar.Get().Ch, 'f')}")

    val holder = &Holder(MakeCell('g', true))
    Println(s"holder:    ${holder.Current().St.Bold} ${same(holder.Current().Ch, 'g')}")
}
-- examples/mixed_guard_extractor.gala --
package main

// L2 from the transpiler-chief audit: a single match expression can
// combine bool-returning guards (IsZero) and Option-returning
// extractors (NonZero) in its case list. The transpiler dispatches
// each case on the method's return type — bool becomes an if-guard,
// Option becomes IsDefined + Get — and both flows share the same
// match body.

type IsZero struct {}

func (_ IsZero) Unapply(n int) bool = n == 0

type NonZero struct {}

func (_ NonZero) Unapply(n int) Option[int] {
    if n == 0 {
        return None[int]()
    }
    return Some(n)
}

func classify(n int) string = n match {
    case IsZero()     => "zero"
    case NonZero(v) if v < 0 => s"negative($v)"
    case NonZero(v)   => s"positive($v)"
    case _            => "impossible"
}

func main() {
    Println(classify(0))
    Println(classify(7))
    Println(classify(-3))
    Println(classify(1))
}
-- examples/mkstring.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"

func main() {
    // List
    val list = ListOf(1, 2, 3)
    fmt.Println(list.MkString(", "))
    fmt.Println(list.MkString(" | "))
    fmt.Println(EmptyList[int]().MkString(", "))

    // Array
    val arr = ArrayOf("a", "b", "c")
    fmt.Println(arr.MkString("-"))
    fmt.Println(EmptyArray[string]().MkString("-"))

    // TreeSet (sorted, deterministic)
    val tree = TreeSetOf(3, 1, 2)
    fmt.Println(tree.MkString(", "))
    fmt.Println(EmptyTreeSet[int]().MkString(", "))
}
