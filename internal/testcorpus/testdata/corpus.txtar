A frozen copy of GALA sources: the input of the analyzer, `gala imports`,
`gala doc`, broken-buffer LSP and scope-walk goldens. It is a copy so that a
change to the standard library or to an example changes no golden; those
tests read only this archive. Every file is LF-only.

It holds the .gala sources of //:all_gala_sources, //examples:all_gala_sources,
//collection_immutable, //lazy, //resource, //std, //stream, //subprocess and
//test, go_interop/types.go, go_builtins/builtins.go, the repository's
gala.mod (so that the extracted corpus is a module of its own, as the
repository is, and an analysis of it reads nothing outside it) and the error
reference pages docs/errors/GALA-E*.md, as they were when it was added.
Changing it changes the goldens' inputs: regenerate them and review the
change.
-- collection_immutable/array.gala --
package collection_immutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
    "martianoff/gala/go_builtins"
    "sync/atomic"
)

// Array is an immutable indexed sequence with effectively constant time operations.
// It uses a 32-way branching trie structure (similar to Scala's Vector).
//
// Performance characteristics (eC = effectively constant, log32(n)):
// - Head:    O(eC)
// - Last:    O(eC)
// - Tail:    O(eC)
// - Init:    O(eC)
// - Prepend: O(eC)
// - Append:  O(eC)
// - Lookup:  O(eC)
// - Update:  O(eC)
// - Length:  O(1) - cached

// branchingFactor is the number of children per node (32 = 2^5)
val branchingBits = 5
val branchingFactor = 32
val branchingMask = 31

// arrayNode represents a node in the trie structure (internal).
// Leaf nodes have nil children and store values directly.
// Internal nodes have children and nil values.
//
// hashCache is, once a root node has been hashed, hashCached | the hash of
// the elements under it (see trieHash); 0 before. Nodes are never changed
// once built, so it never goes stale. It is the first field because 64-bit
// atomics need 8-byte alignment, which 32-bit platforms guarantee only for
// the first word of an allocated struct.
type arrayNode[T any] struct {
    var hashCache uint64
    var children []Ptr[arrayNode[T]]
    var values   []T
    isLeaf   bool
}

// arrayPrefix is an Array's prepend buffer: the prepended elements in forward
// order, so elems[0] is logical index 0. It is never modified once built;
// Prepend and Updated copy it.
type arrayPrefix[T any] struct {
    elems []T
}

// Array represents an immutable indexed sequence.
// Uses a prefix buffer for amortized O(1) prepend (Scala-inspired).
//
// Every field is comparable, so an Array is a valid HashSet element and
// HashMap key; that is why the prefix buffer sits behind a pointer rather
// than in a slice field.
//
// root and prefix are never reassigned; they are `var` for the reason
// List's tail is.
type Array[T any] struct {
    var root   OptionPtr[arrayNode[T]]   // empty while the tree holds no elements
    length     int                       // Total logical length (prefix + tree)
    depth      int
    var prefix OptionPtr[arrayPrefix[T]] // empty until the first Prepend
}

// EmptyArray returns an empty Array.
func EmptyArray[T any]() Array[T] =
    Array[T](root = EmptyOptionPtr[arrayNode[T]](), length = 0, depth = 0, prefix = noPrefix[T]())

// prefixElems returns the prepend buffer's elements, in forward order; nil
// when nothing has been prepended.
func (a Array[T]) prefixElems() []T {
    if a.prefix.IsDefined() {
        return a.prefix.Get().elems
    }
    var none []T
    none
}

// prefixOf wraps elems, already in forward order, as a prepend buffer.
func prefixOf[T any](elems []T) OptionPtr[arrayPrefix[T]] = SomePtr(&arrayPrefix[T](elems = elems))

// noPrefix is the prepend buffer of an Array nothing has been prepended to.
func noPrefix[T any]() OptionPtr[arrayPrefix[T]] = EmptyOptionPtr[arrayPrefix[T]]()

// ArrayOf creates an Array from variadic arguments.
// Example: ArrayOf[int](1, 2, 3) creates Array(1, 2, 3)
func ArrayOf[T any](elements ...T) Array[T] = ArrayFromSlice(elements)

// ArrayTabulate creates an Array of size n where each element is computed by f(index).
// Uses arrayBuilder internally for O(n) construction.
// Example: ArrayTabulate(5, (i) => i * 2) creates Array(0, 2, 4, 6, 8)
func ArrayTabulate[T any](n int, f func(int) T) Array[T] {
    var builder = newArrayBuilder[T]()
    for i := 0; i < n; i++ {
        builder.Add(f(i))
    }
    return builder.Result()
}

// ArrayFill creates an Array of size n where every element is the same value.
// Uses arrayBuilder internally for O(n) construction.
// Example: ArrayFill(3, "x") creates Array("x", "x", "x")
func ArrayFill[T any](n int, value T) Array[T] {
    var builder = newArrayBuilder[T]()
    for i := 0; i < n; i++ {
        builder.Add(value)
    }
    return builder.Result()
}

// ArrayFromSlice creates an Array from a slice. The elements are copied once, so
// later changes to the slice do not affect the Array.
func ArrayFromSlice[T any](elements []T) Array[T] = arrayFromOwnedSlice(go_interop.SliceCopy(elements))

// arrayFromOwnedSlice builds an Array on top of elements without copying them:
// each leaf is a window of the slice with its capacity clipped, so appending to
// a leaf can never write into its neighbour. Every operation that changes a leaf
// copies it first. Only pass a slice nothing else holds or changes afterwards.
func arrayFromOwnedSlice[T any](elements []T) Array[T] {
    val n = elements.Size()
    if n == 0 {
        return EmptyArray[T]()
    }
    var leaves = go_interop.SliceWithCapacity[Ptr[arrayNode[T]]](chunkCount(n))
    for i := 0; i < n; i += branchingFactor {
        val values = go_interop.SliceClip(go_interop.Slice(elements, i, chunkEnd(i, n)))
        leaves = go_interop.SliceAppend(leaves, &arrayNode[T](values = values, isLeaf = true))
    }
    return arrayFromLeaves(leaves, n)
}

// arrayFromLeaves builds the tree above leaves, which hold the elements in index
// order with every leaf full except possibly the last, and returns the Array.
// depth counts the levels from the leaves up, so a lone leaf is depth 1.
func arrayFromLeaves[T any](leaves []Ptr[arrayNode[T]], length int) Array[T] {
    var level = leaves
    var depth = 1
    for level.Size() > 1 {
        level = groupNodes(level)
        depth++
    }
    return Array[T](root = SomePtr(level[0]), length = length, depth = depth, prefix = noPrefix[T]())
}

// chunkCount is the number of branchingFactor-sized chunks needed to hold n items.
func chunkCount(n int) int = (n + branchingMask) / branchingFactor

// chunkEnd is the exclusive end of the chunk that starts at i, given n items.
func chunkEnd(i int, n int) int = if (i + branchingFactor < n) i + branchingFactor else n

// groupNodes builds the next tree level up: one parent per branchingFactor nodes,
// each holding a capacity-clipped window of level, like the leaves.
func groupNodes[T any](level []Ptr[arrayNode[T]]) []Ptr[arrayNode[T]] {
    var parents = go_interop.SliceWithCapacity[Ptr[arrayNode[T]]](chunkCount(level.Size()))
    for i := 0; i < level.Size(); i += branchingFactor {
        val children = go_interop.SliceClip(go_interop.Slice(level, i, chunkEnd(i, level.Size())))
        parents = go_interop.SliceAppend(parents, &arrayNode[T](children = children, isLeaf = false))
    }
    return parents
}

// arrayBuilder builds an Array incrementally without intermediate slice conversion.
// Uses Scala-inspired display arrays for O(1) amortized append.
type arrayBuilder[T any] struct {
    var display0 []T                 // Current leaf being built (up to 32 elements)
    var display1 []Ptr[arrayNode[T]]     // Completed leaf nodes
    var display2 [][]Ptr[arrayNode[T]]   // Groups of 32 leaf nodes
    var length   int                 // Total elements added
}

// newArrayBuilder creates a new arrayBuilder.
func newArrayBuilder[T any]() Ptr[arrayBuilder[T]] {
    var d0 []T
    var d1 []Ptr[arrayNode[T]]
    var d2 [][]Ptr[arrayNode[T]]
    return &arrayBuilder[T](display0 = d0, display1 = d1, display2 = d2, length = 0)
}

// Add appends an element to the builder. O(1) amortized.
func (b Ptr[arrayBuilder[T]]) Add(elem T) {
    b.display0 = go_interop.SliceAppend(b.display0, elem)
    b.length++

    // If display0 is full, flush to display1
    if b.display0.Size() >= branchingFactor {
        b.flushDisplay0()
    }
}

// flushDisplay0 creates a leaf node from display0 and adds to display1.
func (b Ptr[arrayBuilder[T]]) flushDisplay0() {
    if b.display0.Size() == 0 {
        return
    }
    var leaf = &arrayNode[T](values = b.display0, isLeaf = true)
    b.display1 = go_interop.SliceAppend(b.display1, leaf)
    var newD0 []T
    b.display0 = newD0

    // If display1 is full, flush to display2
    if b.display1.Size() >= branchingFactor {
        b.flushDisplay1()
    }
}

// flushDisplay1 groups display1 nodes and adds to display2.
func (b Ptr[arrayBuilder[T]]) flushDisplay1() {
    if b.display1.Size() == 0 {
        return
    }
    b.display2 = go_interop.SliceAppend(b.display2, b.display1)
    var newD1 []Ptr[arrayNode[T]]
    b.display1 = newD1
}

// Result builds and returns the final Array.
func (b Ptr[arrayBuilder[T]]) Result() Array[T] {
    if b.length == 0 {
        return EmptyArray[T]()
    }

    // Flush any remaining elements in display0
    if b.display0.Size() > 0 {
        var leaf = &arrayNode[T](values = b.display0, isLeaf = true)
        b.display1 = go_interop.SliceAppend(b.display1, leaf)
    }

    // If we only have display1 (no display2), build directly
    if b.display2.Size() == 0 {
        if b.display1.Size() == 1 {
            // Single leaf node
            return Array[T](root = SomePtr(b.display1[0]), length = b.length, depth = 1, prefix = noPrefix[T]())
        }
        // Multiple leaves, need internal node
        var root = &arrayNode[T](children = b.display1, isLeaf = false)
        return Array[T](root = SomePtr(root), length = b.length, depth = 2, prefix = noPrefix[T]())
    }

    // We have display2 - need to build deeper tree
    // First, add remaining display1 to display2
    if b.display1.Size() > 0 {
        b.display2 = go_interop.SliceAppend(b.display2, b.display1)
    }

    // Build internal nodes from display2 groups
    var level2Nodes []Ptr[arrayNode[T]]
    for i := 0; i < b.display2.Size(); i++ {
        var node = &arrayNode[T](children = b.display2[i], isLeaf = false)
        level2Nodes = go_interop.SliceAppend(level2Nodes, node)
    }

    // Continue building up the tree. Each level2 node has leaf children, so a
    // tree whose root is one of them has depth 2.
    var currentLevel = level2Nodes
    var depth = 2

    for currentLevel.Size() > 1 {
        var nextLevel []Ptr[arrayNode[T]]
        for i := 0; i < currentLevel.Size(); i += branchingFactor {
            var end = i + branchingFactor
            if end > currentLevel.Size() {
                end = currentLevel.Size()
            }
            var children []Ptr[arrayNode[T]]
            for j := i; j < end; j++ {
                children = go_interop.SliceAppend(children, currentLevel[j])
            }
            var node = &arrayNode[T](children = children, isLeaf = false)
            nextLevel = go_interop.SliceAppend(nextLevel, node)
        }
        currentLevel = nextLevel
        depth++
    }

    return Array[T](root = SomePtr(currentLevel[0]), length = b.length, depth = depth, prefix = noPrefix[T]())
}

// IsEmpty returns true if the array is empty.
func (a Array[T]) IsEmpty() bool = a.length == 0

// NonEmpty returns true if the array is not empty.
func (a Array[T]) NonEmpty() bool = a.length > 0

// Length returns the number of elements. O(1) - cached.
func (a Array[T]) Length() int = a.length

// Size is an alias for Length.
func (a Array[T]) Size() int = a.length

// Equal reports whether other holds Equal elements in the same order.
func (a Array[T]) Equal(other Array[T]) bool {
    if a.length != other.length {
        return false
    }
    for i := 0; i < a.length; i++ {
        if !Equal(a.Get(i), other.Get(i)) {
            return false
        }
    }
    true
}

// Hash hashes the elements in order (std.Hashable), so Equal Arrays hash
// alike, and an Array can be a HashSet element or a HashMap key. Each element
// must be a primitive or Hashable.
//
// It is a polynomial hash, the sum of mix(hash(element i)) * P^i, so it
// splits at any position: the hash of the trie's elements is computed once,
// on the first Hash, and kept in the root node, which the Arrays sharing the
// trie share too. Only the prepend buffer, under 32 elements, is hashed each
// time. Like a HashSet element's, an element's hash must not change.
func (a Array[T]) Hash() uint32 {
    val prefixed = addValuesHash(a.prefixElems(), (uint32(0), uint32(1)))
    val sum = if (a.root.IsDefined()) prefixed.V1 + trieHash(a.root.Get()) * prefixed.V2 else prefixed.V1
    HashCombine(HashInt(int64(a.length)), mixHash(sum))
}

// polyHashPrime is the base of Array's polynomial hash (the 32-bit FNV prime).
val polyHashPrime = uint32(16777619)

// hashCached marks an arrayNode's hashCache as holding a hash.
val hashCached = uint64(1) << 32

// trieHash returns the polynomial hash of the elements under root, computing
// it on the first call and keeping it in root. Arrays are shared between
// goroutines, so the cache is read and written atomically; two goroutines
// that both miss compute and store the same value.
func trieHash[T any](root Ptr[arrayNode[T]]) uint32 {
    val cached = atomic.LoadUint64(&root.hashCache)
    if cached != uint64(0) {
        return uint32(cached)
    }
    val (sum, _) = addNodeHash(root, (uint32(0), uint32(1)))
    atomic.StoreUint64(&root.hashCache, hashCached | uint64(sum))
    sum
}

// addNodeHash adds the elements under node, in order, to a polynomial hash
// (see addValuesHash).
func addNodeHash[T any](node Ptr[arrayNode[T]], acc Tuple[uint32, uint32]) Tuple[uint32, uint32] {
    if node.isLeaf {
        return addValuesHash(node.values, acc)
    }
    var next = acc
    for i := 0; i < node.children.Size(); i++ {
        next = addNodeHash(node.children[i], next)
    }
    next
}

// addValuesHash adds values, in order, to a polynomial hash: acc is the sum
// so far and the power of P the next element is multiplied by, and the result
// is both after values. A loop rather than a fold, as Hash runs per key and
// the fold's closure would cost a call per element.
func addValuesHash[T any](values []T, acc Tuple[uint32, uint32]) Tuple[uint32, uint32] {
    var sum = acc.V1
    var pow = acc.V2
    for i := 0; i < values.Size(); i++ {
        sum = sum + mixHash(HashOf(values[i])) * pow
        pow = pow * polyHashPrime
    }
    (sum, pow)
}

// mixHash scrambles a hash (the murmur3 finalizer). Applied to each element
// hash, it keeps close element hashes (small ints, bools) from cancelling out
// in the linear polynomial sum; applied to the sum, it brings every bit of it
// to the low bits a HashSet routes by.
func mixHash(h uint32) uint32 {
    val a = (h ^ (h >> 16)) * uint32(2246822507)
    val b = (a ^ (a >> 13)) * uint32(3266489909)
    b ^ (b >> 16)
}

// Helper function to calculate required depth for a given size.
func requiredDepth(size int) int {
    if size <= branchingFactor {
        return 1
    }
    var d = 1
    for capacity := branchingFactor; capacity < size; d++ {
        capacity = capacity * branchingFactor
    }
    return d
}

// Helper to copy a node.
func copyNode[T any](node Ptr[arrayNode[T]]) Ptr[arrayNode[T]] {
    var newNode = &arrayNode[T](isLeaf = node.isLeaf)
    if node.isLeaf {
        newNode.values = copySlice[T](node.values)
    } else {
        newNode.children = copyNodeSlice[T](node.children)
    }
    return newNode
}

// Helper to copy a slice.
func copySlice[T any](src []T) []T {
    var dst []T
    for i := 0; i < src.Size(); i++ {
        dst = go_interop.SliceAppend(dst, src[i])
    }
    return dst
}

// Helper to copy a node slice.
func copyNodeSlice[T any](src []Ptr[arrayNode[T]]) []Ptr[arrayNode[T]] {
    var dst []Ptr[arrayNode[T]]
    for i := 0; i < src.Size(); i++ {
        dst = go_interop.SliceAppend(dst, src[i])
    }
    return dst
}

// Helper to get value at index from tree. A loop rather than recursion: this is
// the descent behind every Get, so it avoids a call per level.
func getFromNode[T any](root Ptr[arrayNode[T]], index int, depth int) T {
    var node = root
    var level = depth
    for !node.isLeaf {
        node = node.children[(index >> (branchingBits * (level - 1))) & branchingMask]
        level--
    }
    node.values[index & branchingMask]
}

// Get returns the element at the given index. O(log32 n) = effectively constant.
// Panics if index is out of bounds.
func (a Array[T]) Get(index int) T {
    if (index < 0) || (index >= a.length) {
        go_builtins.Panic(f"Array.Get: index $index out of bounds [0, ${a.length})")
    }

    // Check if index is in prefix (prefix is stored in forward order)
    val prefix = a.prefixElems()
    val prefixLen = prefix.Size()
    if index < prefixLen {
        // Prefix stores elements in forward order: prefix[0] is logical index 0
        return prefix[index]
    }

    // Otherwise, get from tree (adjusting index for prefix)
    var treeIndex = index - prefixLen
    return getFromNode[T](a.root.Get(), treeIndex, a.depth)
}

// GetOption returns the element at index wrapped in Option.
func (a Array[T]) GetOption(index int) Option[T] {
    if (index < 0) || (index >= a.length) {
        return None[T]()
    }
    return Some[T](a.Get(index))
}

// Head returns the first element. O(log32 n) = effectively constant.
// Panics if the array is empty.
func (a Array[T]) Head() T {
    if a.length == 0 {
        go_builtins.Panic("Array.Head on empty array")
    }
    return a.Get(0)
}

// HeadOption returns the first element wrapped in Option.
func (a Array[T]) HeadOption() Option[T] {
    if a.length == 0 {
        return None[T]()
    }
    return Some[T](a.Get(0))
}

// Last returns the last element. O(log32 n) = effectively constant.
// Panics if the array is empty.
func (a Array[T]) Last() T {
    if a.length == 0 {
        go_builtins.Panic("Array.Last on empty array")
    }
    return a.Get(a.length - 1)
}

// LastOption returns the last element wrapped in Option.
func (a Array[T]) LastOption() Option[T] {
    if a.length == 0 {
        return None[T]()
    }
    return Some[T](a.Get(a.length - 1))
}

// Helper to update a value in the tree, returning new tree.
func updateInNode[T any](node Ptr[arrayNode[T]], index int, value T, depth int) Ptr[arrayNode[T]] {
    val newNode = copyNode[T](node)
    var isNodeLeaf = newNode.isLeaf
    if isNodeLeaf {
        newNode.values[index & branchingMask] = value
        return newNode
    }
    var childIndex = (index >> (branchingBits * (depth - 1))) & branchingMask
    newNode.children[childIndex] = updateInNode[T](node.children[childIndex], index, value, depth - 1)
    return newNode
}

// Updated returns a new array with the element at index replaced. O(log32 n).
func (a Array[T]) Updated(index int, value T) Array[T] {
    if (index < 0) || (index >= a.length) {
        go_builtins.Panic(f"Array.Updated: index $index out of bounds [0, ${a.length})")
    }

    val prefix = a.prefixElems()
    val prefixLen = prefix.Size()
    if index < prefixLen {
        // Update is in prefix - copy it, never write to the shared buffer
        val newPrefix = go_interop.SliceCopy(prefix)
        newPrefix[index] = value
        return Array[T](root = a.root, length = a.length, depth = a.depth, prefix = prefixOf(newPrefix))
    }

    // Update is in tree
    var treeIndex = index - prefixLen
    val newRoot = updateInNode[T](a.root.Get(), treeIndex, value, a.depth)
    return Array[T](root = SomePtr(newRoot), length = a.length, depth = a.depth, prefix = a.prefix)
}

// Helper to append to tree, potentially growing it.
func appendToTree[T any](root Ptr[arrayNode[T]], index int, value T, depth int) Tuple[Ptr[arrayNode[T]], int] {
    // Check if we need to grow the tree
    var maxCapacity = 1
    for i := 0; i < depth; i++ {
        maxCapacity = maxCapacity * branchingFactor
    }

    if index >= maxCapacity {
        // Need to add a new level
        val newRoot = &arrayNode[T](children = go_interop.SliceOf(root), isLeaf = false)
        return appendToTree[T](newRoot, index, value, depth + 1)
    }

    return Tuple[Ptr[arrayNode[T]], int](V1 = appendToNode[T](root, index, value, depth), V2 = depth)
}

// Helper to append to a node at specific depth.
func appendToNode[T any](node Ptr[arrayNode[T]], index int, value T, depth int) Ptr[arrayNode[T]] {
    val newNode = copyNode[T](node)
    if depth == 1 {
        // Leaf level
        newNode.values = go_interop.SliceAppend(newNode.values, value)
        return newNode
    }

    // Internal node
    val childIndex = (index >> (branchingBits * (depth - 1))) & branchingMask
    if childIndex < node.children.Size() {
        newNode.children[childIndex] = appendToNode[T](node.children[childIndex], index, value, depth - 1)
    } else if childIndex == node.children.Size() {
        // The tree fills left to right, so a missing child is the next one
        newNode.children = go_interop.SliceAppend(newNode.children, newSubtree[T](value, depth - 1))
    } else {
        go_builtins.Panic(f"Array: append at index $index skips child slot ${node.children.Size()}")
    }
    return newNode
}

// newSubtree builds the fresh path of nodes, depth levels down to a leaf, for
// an element that starts a new subtree. The tree fills left to right, so the
// element is the subtree's first and each node on the path has one child.
func newSubtree[T any](value T, depth int) Ptr[arrayNode[T]] =
    if (depth == 1) &arrayNode[T](values = go_interop.SliceOf(value), isLeaf = true)
    else &arrayNode[T](children = go_interop.SliceOf(newSubtree[T](value, depth - 1)), isLeaf = false)

// Append adds an element to the end. O(log32 n) = effectively constant.
func (a Array[T]) Append(value T) Array[T] {
    // Calculate tree length (excluding prefix)
    val treeLen = a.length - a.prefixElems().Size()

    if treeLen == 0 {
        return Array[T](root = SomePtr(newSubtree[T](value, 1)), length = a.length + 1, depth = 1, prefix = a.prefix)
    }

    var result = appendToTree[T](a.root.Get(), treeLen, value, a.depth)
    var newRoot = result.V1
    var newDepth = result.V2
    return Array[T](root = SomePtr(newRoot), length = a.length + 1, depth = newDepth, prefix = a.prefix)
}

// AppendAll appends all elements from another array.
func (a Array[T]) AppendAll(other Array[T]) Array[T] {
    var builder = newArrayBuilder[T]()
    for i := 0; i < a.length; i++ {
        builder.Add(a.Get(i))
    }
    for i := 0; i < other.length; i++ {
        builder.Add(other.Get(i))
    }
    return builder.Result()
}

// Prepend adds an element to the front. O(1) amortized - uses prefix buffer.
// The prefix buffer is consolidated into the tree when it reaches 32 elements.
func (a Array[T]) Prepend(value T) Array[T] {
    // Copy the prefix with value at front (forward order: prefix[0] is logical
    // index 0); the old buffer may be shared, so it is never written to.
    val prefix = a.prefixElems()
    val newPrefix = go_interop.SliceAppendAll(go_interop.SliceAppend(go_interop.SliceWithCapacity[T](prefix.Size() + 1), value), prefix)

    // If prefix is getting too large, consolidate into tree
    if newPrefix.Size() >= branchingFactor {
        return a.consolidateWithPrefix(newPrefix)
    }

    // Otherwise, just update prefix
    return Array[T](root = a.root, length = a.length + 1, depth = a.depth, prefix = prefixOf(newPrefix))
}

// consolidateWithPrefix merges the prefix buffer into a new tree.
// Uses arrayBuilder to avoid intermediate slice conversion.
func (a Array[T]) consolidateWithPrefix(newPrefix []T) Array[T] {
    var builder = newArrayBuilder[T]()

    // Add prefix elements (already in forward order)
    for i := 0; i < newPrefix.Size(); i++ {
        builder.Add(newPrefix[i])
    }

    // Add tree elements
    val treeLen = a.length - a.prefixElems().Size()
    a.root.ForEach((root) => {
        for i := 0; i < treeLen; i++ {
            builder.Add(getFromNode[T](root, i, a.depth))
        }
    })

    return builder.Result()
}

// PrependAll prepends all elements from another array.
func (a Array[T]) PrependAll(other Array[T]) Array[T] = other.AppendAll(a)

// Tail returns all elements except the first. O(n) for rebuilding.
func (a Array[T]) Tail() Array[T] {
    if a.length == 0 {
        go_builtins.Panic("Array.Tail on empty array")
    }
    return a.Drop(1)
}

// TailOption returns the tail wrapped in Option.
func (a Array[T]) TailOption() Option[Array[T]] {
    if a.length == 0 {
        return None[Array[T]]()
    }
    return Some[Array[T]](a.Tail())
}

// Init returns all elements except the last. O(n) for rebuilding.
func (a Array[T]) Init() Array[T] {
    if a.length == 0 {
        go_builtins.Panic("Array.Init on empty array")
    }
    return a.Take(a.length - 1)
}

// Take returns the first n elements. Uses arrayBuilder.
func (a Array[T]) Take(n int) Array[T] {
    if n <= 0 {
        return EmptyArray[T]()
    }
    if n >= a.length {
        return a
    }
    var builder = newArrayBuilder[T]()
    for i := 0; i < n; i++ {
        builder.Add(a.Get(i))
    }
    return builder.Result()
}

// Drop returns all elements except the first n. Uses arrayBuilder.
func (a Array[T]) Drop(n int) Array[T] {
    if n <= 0 {
        return a
    }
    if n >= a.length {
        return EmptyArray[T]()
    }
    var builder = newArrayBuilder[T]()
    for i := n; i < a.length; i++ {
        builder.Add(a.Get(i))
    }
    return builder.Result()
}

// TakeWhile returns the longest prefix of elements that satisfy the predicate.
// Uses arrayBuilder.
func (a Array[T]) TakeWhile(p func(T) bool) Array[T] {
    var builder = newArrayBuilder[T]()
    for i := 0; i < a.length; i++ {
        var elem = a.Get(i)
        if !p(elem) {
            return builder.Result()
        }
        builder.Add(elem)
    }
    return builder.Result()
}

// DropWhile drops the longest prefix of elements that satisfy the predicate.
func (a Array[T]) DropWhile(p func(T) bool) Array[T] {
    var start = 0
    for start < a.length && p(a.Get(start)) {
        start++
    }
    return a.Drop(start)
}

// Slice returns a subarray from start (inclusive) to end (exclusive).
func (a Array[T]) Slice(var start int, var end int) Array[T] {
    if start < 0 {
        start = 0
    }
    if end > a.length {
        end = a.length
    }
    if start >= end {
        return EmptyArray[T]()
    }
    return a.Drop(start).Take(end - start)
}

// Contains checks if the array contains the given element. O(n).
func (a Array[T]) Contains(elem T) bool {
    for i := 0; i < a.length; i++ {
        if Equal(a.Get(i), elem) {
            return true
        }
    }
    return false
}

// IndexOf returns the index of the first occurrence of elem, or -1 if not found.
func (a Array[T]) IndexOf(elem T) int {
    for i := 0; i < a.length; i++ {
        if Equal(a.Get(i), elem) {
            return i
        }
    }
    return -1
}

// LastIndexOf returns the index of the last occurrence of elem, or -1 if not found.
func (a Array[T]) LastIndexOf(elem T) int {
    for i := a.length - 1; i >= 0; i-- {
        if Equal(a.Get(i), elem) {
            return i
        }
    }
    return -1
}

// Reverse returns a new array with elements in reverse order. Uses arrayBuilder.
func (a Array[T]) Reverse() Array[T] {
    var builder = newArrayBuilder[T]()
    for i := a.length - 1; i >= 0; i-- {
        builder.Add(a.Get(i))
    }
    return builder.Result()
}

// Map applies a function to each element and returns a new array.
// Uses arrayBuilder to avoid intermediate slice conversion.
func (a Array[T]) Map[U any](f func(T) U) Array[U] {
    var builder = newArrayBuilder[U]()
    for i := 0; i < a.length; i++ {
        builder.Add(f(a.Get(i)))
    }
    return builder.Result()
}

// FlatMap applies a function that returns an array to each element and flattens.
// Uses arrayBuilder to avoid intermediate slice conversion.
func (a Array[T]) FlatMap[U any](f func(T) Array[U]) Array[U] {
    var builder = newArrayBuilder[U]()
    for i := 0; i < a.length; i++ {
        var inner = f(a.Get(i))
        for j := 0; j < inner.Length(); j++ {
            builder.Add(inner.Get(j))
        }
    }
    return builder.Result()
}

// Collect applies a partial function to each element and collects the results.
// Elements for which the function returns None are filtered out.
// Uses arrayBuilder to avoid intermediate slice conversion.
func (a Array[T]) Collect[U any](pf func(T) Option[U]) Array[U] {
    var builder = newArrayBuilder[U]()
    for i := 0; i < a.length; i++ {
        val opt = pf(a.Get(i))
        if opt.IsDefined() {
            builder.Add(opt.Get())
        }
    }
    return builder.Result()
}

// Concat returns a new array containing all elements of this array followed by
// all elements of the other iterable. Uses arrayBuilder.
func (a Array[T]) Concat(other Iterable[T]) Array[T] {
    var builder = newArrayBuilder[T]()
    for i := 0; i < a.length; i++ {
        builder.Add(a.Get(i))
    }
    other.ForEach((elem T) => {
        builder.Add(elem)
    })
    return builder.Result()
}

// Filter returns a new array with only elements that satisfy the predicate.
// Uses arrayBuilder to avoid intermediate slice conversion.
func (a Array[T]) Filter(p func(T) bool) Array[T] {
    var builder = newArrayBuilder[T]()
    for i := 0; i < a.length; i++ {
        var elem = a.Get(i)
        if p(elem) {
            builder.Add(elem)
        }
    }
    return builder.Result()
}

// FilterNot returns a new array with elements that do not satisfy the predicate.
func (a Array[T]) FilterNot(p func(T) bool) Array[T] = a.Filter((elem T) => !p(elem))

// Partition splits the array into two arrays based on a predicate.
func (a Array[T]) Partition(p func(T) bool) Tuple[Array[T], Array[T]] {
    val left = a.Filter(p)
    val right = a.FilterNot(p)
    return (left, right)
}

// FoldLeft applies a binary operator from left to right.
func (a Array[T]) FoldLeft[U any](initial U, f func(U, T) U) U {
    var acc = initial
    for i := 0; i < a.length; i++ {
        acc = f(acc, a.Get(i))
    }
    return acc
}

// FoldRight applies a binary operator from right to left.
func (a Array[T]) FoldRight[U any](initial U, f func(T, U) U) U {
    var acc = initial
    for i := a.length - 1; i >= 0; i-- {
        acc = f(a.Get(i), acc)
    }
    return acc
}

// Reduce applies a binary operator from left to right, starting with the first element.
// Panics if the array is empty.
func (a Array[T]) Reduce(f func(T, T) T) T {
    if a.length == 0 {
        go_builtins.Panic("Array.Reduce on empty array")
    }
    var tail = a.Tail()
    var head = a.Head()
    return Array_FoldLeft[T](tail, head, f)
}

// ReduceOption is like Reduce but returns None for empty array.
func (a Array[T]) ReduceOption(f func(T, T) T) Option[T] {
    if a.length == 0 {
        return None[T]()
    }
    return Some[T](a.Reduce(f))
}

// ForEach applies a function to each element for side effects.
func (a Array[T]) ForEach(f func(T)) {
    for i := 0; i < a.length; i++ {
        f(a.Get(i))
    }
}

// Exists returns true if any element satisfies the predicate.
func (a Array[T]) Exists(p func(T) bool) bool {
    for i := 0; i < a.length; i++ {
        if p(a.Get(i)) {
            return true
        }
    }
    return false
}

// ForAll returns true if all elements satisfy the predicate.
func (a Array[T]) ForAll(p func(T) bool) bool {
    for i := 0; i < a.length; i++ {
        if !p(a.Get(i)) {
            return false
        }
    }
    return true
}

// Find returns the first element that satisfies the predicate.
func (a Array[T]) Find(p func(T) bool) Option[T] {
    for i := 0; i < a.length; i++ {
        var elem = a.Get(i)
        if p(elem) {
            return Some[T](elem)
        }
    }
    return None[T]()
}

// FindLast returns the last element that satisfies the predicate.
func (a Array[T]) FindLast(p func(T) bool) Option[T] {
    for i := a.length - 1; i >= 0; i-- {
        var elem = a.Get(i)
        if p(elem) {
            return Some[T](elem)
        }
    }
    return None[T]()
}

// Count returns the number of elements satisfying the predicate.
func (a Array[T]) Count(p func(T) bool) int {
    return a.FoldLeft[int](0, (acc int, elem T) => {
        if p(elem) {
            return acc + 1
        }
        return acc
    })
}

// Zip combines two arrays into an array of tuples. Result length is the minimum.
func (a Array[T]) Zip[U any](other Array[U]) Array[Tuple[T, U]] {
    var minLen = a.length
    if other.length < minLen {
        minLen = other.length
    }
    var builder = newArrayBuilder[Tuple[T, U]]()
    for i := 0; i < minLen; i++ {
        builder.Add((a.Get(i), other.Get(i)))
    }
    return builder.Result()
}

// ZipWithIndex pairs each element with its index.
func (a Array[T]) ZipWithIndex() Array[Tuple[T, int]] {
    var builder = newArrayBuilder[Tuple[T, int]]()
    for i := 0; i < a.length; i++ {
        builder.Add((a.Get(i), i))
    }
    return builder.Result()
}

// Distinct returns a new array with duplicate elements removed, keeping the
// first occurrence of each element in its original position. Elements are
// compared with Equal: through a HashSet when T is a primitive type (a number,
// string or bool), and against each kept element otherwise.
func (a Array[T]) Distinct() Array[T] = a.Filter(firstOccurrence[T]())

// SplitAt splits the array at the given index.
func (a Array[T]) SplitAt(n int) Tuple[Array[T], Array[T]] = (a.Take(n), a.Drop(n))

// Span splits the array into a prefix/suffix pair according to a predicate.
// The first element contains the longest prefix of elements that satisfy p.
func (a Array[T]) Span(p func(T) bool) Tuple[Array[T], Array[T]] {
    var idx = 0
    for idx < a.length && p(a.Get(idx)) {
        idx++
    }
    return a.SplitAt(idx)
}

// PartitionMap applies a function to each element and partitions results into Left and Right.
func (a Array[T]) PartitionMap[A any, B any](f func(T) Either[A, B]) Tuple[Array[A], Array[B]] {
    var leftBuilder = newArrayBuilder[A]()
    var rightBuilder = newArrayBuilder[B]()
    for i := 0; i < a.length; i++ {
        f(a.Get(i)) match {
            case Left(l) => leftBuilder.Add(l)
            case Right(r) => rightBuilder.Add(r)
        }
    }
    return (leftBuilder.Result(), rightBuilder.Result())
}

// GroupBy partitions this array into a map of arrays according to a discriminator function.
func (a Array[T]) GroupBy[K comparable](f func(T) K) map[K]Array[T] {
    var result = go_interop.MapEmpty[K, Array[T]]()
    for i := 0; i < a.length; i++ {
        val elem = a.Get(i)
        val key = f(elem)
        val existing = result[key]
        result[key] = existing.Append(elem)
    }
    return result
}

// GroupMap partitions elements and maps values according to discriminator and value functions.
func (a Array[T]) GroupMap[K comparable, V any](key func(T) K, value func(T) V) map[K]Array[V] {
    var result = go_interop.MapEmpty[K, Array[V]]()
    for i := 0; i < a.length; i++ {
        val elem = a.Get(i)
        val k = key(elem)
        val v = value(elem)
        val existing = result[k]
        result[k] = existing.Append(v)
    }
    return result
}

// GroupMapReduce partitions elements, maps values, and reduces them with a combining function.
func (a Array[T]) GroupMapReduce[K comparable, V any](key func(T) K, value func(T) V, reduce func(V, V) V) map[K]V {
    var result = go_interop.MapEmpty[K, V]()
    var seen = go_interop.MapEmpty[K, bool]()
    for i := 0; i < a.length; i++ {
        val elem = a.Get(i)
        val k = key(elem)
        val v = value(elem)
        if seen[k] {
            result[k] = reduce(result[k], v)
        } else {
            result[k] = v
            seen[k] = true
        }
    }
    return result
}

// Grouped splits the array into groups of size n.
func (a Array[T]) Grouped(n int) Array[Array[T]] {
    if n <= 0 {
        go_builtins.Panic("Array.Grouped: group size must be positive")
    }
    var builder = newArrayBuilder[Array[T]]()
    for i := 0; i < a.length; i += n {
        var end = i + n
        if end > a.length {
            end = a.length
        }
        builder.Add(a.Slice(i, end))
    }
    return builder.Result()
}

// Sliding returns a sliding window over the array.
func (a Array[T]) Sliding(size int) Array[Array[T]] {
    if size <= 0 {
        go_builtins.Panic("Array.Sliding: window size must be positive")
    }
    if a.length < size {
        return EmptyArray[Array[T]]()
    }
    var builder = newArrayBuilder[Array[T]]()
    var limit = a.length - size
    for i := 0; i <= limit; i++ {
        builder.Add(a.Slice(i, i + size))
    }
    return builder.Result()
}

// ToGoSlice converts the array to a Go slice. The slice is a fresh copy the caller owns.
func (a Array[T]) ToGoSlice() []T {
    val withPrefix = go_interop.SliceAppendAll(go_interop.SliceWithCapacity[T](a.length), a.prefixElems())
    return a.root match {
        case Some(root) => appendLeaves(withPrefix, root)
        case None() => withPrefix
    }
}

// appendLeaves appends every element under node to dst in index order, a whole
// leaf at a time rather than descending from the root once per element.
func appendLeaves[T any](dst []T, node Ptr[arrayNode[T]]) []T {
    if node.isLeaf {
        return go_interop.SliceAppendAll(dst, node.values)
    }
    var out = dst
    for i := 0; i < node.children.Size(); i++ {
        out = appendLeaves(out, node.children[i])
    }
    return out
}

// ToList converts the array to a List.
func (a Array[T]) ToList() List[T] {
    var result = emptyList[T]()
    for i := a.length - 1; i >= 0; i-- {
        result = consList[T](a.Get(i), result)
    }
    return result
}

// String returns a string representation of the array.
func (a Array[T]) String() string {
    if a.length == 0 {
        return "Array()"
    }
    var result = "Array("
    for i := 0; i < a.length; i++ {
        if i > 0 {
            result = result + ", "
        }
        result = result + s"${a.Get(i)}"
    }
    return result + ")"
}

// MkString joins elements into a string with separator.
func (a Array[T]) MkString(sep string) string {
    if a.length == 0 {
        return ""
    }
    var result = ""
    for i := 0; i < a.length; i++ {
        if i > 0 {
            result = result + sep
        }
        result = result + s"${a.Get(i)}"
    }
    return result
}

// === Sorting ===

// lessToCompare orders x and y by less as a three-way comparison. If less reports
// true both ways (a non-strict comparator such as <=), x and y count as equal, so
// the sort keeps them in their original order.
func lessToCompare[T any](less func(T, T) bool, x T, y T) int =
    if (less(x, y)) (if (less(y, x)) 0 else -1) else if (less(y, x)) 1 else 0

// Sorted returns a new array with elements sorted in natural order.
// Elements must be primitive types or implement std.Ordered[T].
// The sort is stable: equal elements keep their original relative order.
func (a Array[T]) Sorted() Array[T] {
    if a.length <= 1 {
        return a
    }
    val elements = a.ToGoSlice()
    go_interop.SliceSortStable(elements, (i, j) => CompareValues(elements[i], elements[j]))
    return arrayFromOwnedSlice(elements)
}

// SortWith returns a new array sorted using the given comparison function.
// The function should return true if x should come before y; it should be a strict
// ordering (use <, not <=).
// The sort is stable: elements that compare equal keep their original relative order.
func (a Array[T]) SortWith(less func(T, T) bool) Array[T] {
    if a.length <= 1 {
        return a
    }
    val elements = a.ToGoSlice()
    go_interop.SliceSortStable(elements, (i, j) => lessToCompare(less, elements[i], elements[j]))
    return arrayFromOwnedSlice(elements)
}

// SortBy returns a new array sorted by a key extracted from each element.
// Keys must be primitive types or implement std.Ordered.
// The sort is stable: elements with equal keys keep their original relative order.
// f runs once per element: keys are computed up front, not on every comparison.
func (a Array[T]) SortBy[K comparable](f func(T) K) Array[T] {
    if a.length <= 1 {
        return a
    }
    val elements = a.ToGoSlice()
    val keys = go_interop.SliceWithSize[K](a.length)
    for i := 0; i < a.length; i++ {
        keys[i] = f(elements[i])
    }
    go_interop.SliceSortStable(elements, (i, j) => CompareValues(keys[i], keys[j]))
    return arrayFromOwnedSlice(elements)
}

// SeqDrop implements the Seq interface for sequence pattern matching.
// Returns the array with the first n elements removed.
func (a Array[T]) SeqDrop(n int) any = a.Drop(n)

// ArrayEmpty extractor for pattern matching
type ArrayEmpty struct {}
func (ae ArrayEmpty) Unapply(a any) Option[bool] = a match {
    case arr: Array[_] if arr.length == 0 => Some[bool](true)
    case _ => None[bool]()
}

// ArrayNonEmpty extractor for pattern matching
type ArrayNonEmpty struct {}
func (ane ArrayNonEmpty) Unapply(a any) Option[any] = a match {
    case arr: Array[_] if arr.length > 0 => Some[any](arr)
    case _ => None[any]()
}
-- collection_immutable/hashmap.gala --
package collection_immutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
    "martianoff/gala/go_builtins"
)

// HashMap is an immutable map with effectively constant time operations.
// It uses a Hash Array Mapped Trie (HAMT) structure similar to Scala's HashMap.
//
// Keys must be either:
// - Primitive types (int, string, bool, etc.) - hashed automatically
// - Tuple, Option and Either holding values of these kinds (std implements Hashable for them)
// - Types implementing the Hashable interface
//
// Performance characteristics (eC = effectively constant, log32(n)):
// - Put:        O(eC)
// - Get:        O(eC)
// - Remove:     O(eC)
// - Contains:   O(eC)
// - Size:       O(1) - cached

// hashMapNode represents a node in the HAMT structure.
type hashMapNode[K comparable, V any] struct {
    bitmap   uint32
    keys     []K
    values   []V
    children []Ptr[hashMapNode[K, V]]
    isLeaf   bool
}

// HashMap represents an immutable map.
//
// root is never reassigned; it is `var` for the reason List's tail is.
type HashMap[K comparable, V any] struct {
    var root   OptionPtr[hashMapNode[K, V]] // empty when the map is empty
    size   int
}

// EmptyHashMap returns an empty HashMap.
func EmptyHashMap[K comparable, V any]() HashMap[K, V] = HashMap[K, V](root = EmptyOptionPtr[hashMapNode[K, V]](), size = 0)

// IsEmpty returns true if the map is empty.
func (m HashMap[K, V]) IsEmpty() bool = m.size == 0

// NonEmpty returns true if the map is not empty.
func (m HashMap[K, V]) NonEmpty() bool = m.size > 0

// Size returns the number of entries. O(1) - cached.
func (m HashMap[K, V]) Size() int = m.size

// Length is an alias for Size.
func (m HashMap[K, V]) Length() int = m.size

// Equal reports whether other holds the same keys, each mapped to an Equal
// value, in any order. It is O(n).
func (m HashMap[K, V]) Equal(other HashMap[K, V]) bool =
    m.size == other.size && m.ForAll((k, v) => other.Get(k) match {
        case Some(w) => Equal(v, w)
        case _       => false
    })

// hashMapBitpos returns the bit position for a hash at a given level.
func hashMapBitpos(hashCode uint32, level int) uint32 {
    var shift = uint(level * 5)
    var idx = (hashCode >> shift) & 31
    return uint32(1) << idx
}

// hashMapIndex returns the array index for a bit position in a bitmap.
func hashMapIndex(bitmap uint32, bit uint32) int {
    return hashMapPopcount(bitmap & (bit - 1))
}

// hashMapPopcount returns the number of set bits in a uint32.
func hashMapPopcount(var x uint32) int {
    var count = 0
    for x != 0 {
        count++
        x = x & (x - 1)
    }
    return count
}

// Contains checks if the map contains the given key. O(eC).
func (m HashMap[K, V]) Contains(key K) bool {
    if m.root.IsEmpty() {
        return false
    }
    val hashCode = HashKeyOf(key)
    return containsKeyInNode[K, V](m.root.Get(), key, hashCode, 0)
}

// containsKeyInNode searches for a key in a node.
func containsKeyInNode[K comparable, V any](node Ptr[hashMapNode[K, V]], key K, hashCode uint32, level int) bool {
    if node.isLeaf {
        for i := 0; i < node.keys.Size(); i++ {
            if node.keys[i] == key {
                return true
            }
        }
        return KeyIndexByValue(node.keys, key) >= 0
    }

    val bit = hashMapBitpos(hashCode, level)
    if (node.bitmap & bit) == 0 {
        return false
    }

    val idx = hashMapIndex(node.bitmap, bit)
    return containsKeyInNode[K, V](node.children[idx], key, hashCode, level + 1)
}

// Get returns the value for a key wrapped in Option. O(eC).
func (m HashMap[K, V]) Get(key K) Option[V] {
    if m.root.IsEmpty() {
        return None[V]()
    }
    val hashCode = HashKeyOf(key)
    return getFromNodeMap[K, V](m.root.Get(), key, hashCode, 0)
}

// getFromNodeMap searches for a key in a node and returns its value.
func getFromNodeMap[K comparable, V any](node Ptr[hashMapNode[K, V]], key K, hashCode uint32, level int) Option[V] {
    if node.isLeaf {
        for i := 0; i < node.keys.Size(); i++ {
            if node.keys[i] == key {
                return Some[V](node.values[i])
            }
        }
        val i = KeyIndexByValue(node.keys, key)
        return if (i >= 0) Some[V](node.values[i]) else None[V]()
    }

    val bit = hashMapBitpos(hashCode, level)
    if (node.bitmap & bit) == 0 {
        return None[V]()
    }

    val idx = hashMapIndex(node.bitmap, bit)
    return getFromNodeMap[K, V](node.children[idx], key, hashCode, level + 1)
}

// GetOrElse returns the value for a key, or the default if not found. O(eC).
func (m HashMap[K, V]) GetOrElse(key K, defaultValue V) V {
    return m.Get(key).GetOrElse(defaultValue)
}

// Apply returns the value for a key. Panics if key not found. O(eC).
func (m HashMap[K, V]) Apply(key K) V {
    return m.Get(key) match {
        case Some(v) => v
        case None() => go_builtins.Panic(s"HashMap: key not found: $key")
    }
}

// Put adds or updates a key-value pair. Returns a new map. O(eC).
func (m HashMap[K, V]) Put(key K, value V) HashMap[K, V] {
    if m.root.IsEmpty() {
        val leaf = &hashMapNode[K, V](keys = go_interop.SliceOf(key), values = go_interop.SliceOf(value), isLeaf = true)
        return HashMap[K, V](root = SomePtr(leaf), size = m.size + 1)
    }
    val root = m.root.Get()
    val hashCode = HashKeyOf(key)

    // Check if key exists (to determine if size changes)
    val sizeChange = if (containsKeyInNode[K, V](root, key, hashCode, 0)) 0 else 1
    val newRoot = putToNode[K, V](root, key, value, hashCode, 0)
    return HashMap[K, V](root = SomePtr(newRoot), size = m.size + sizeChange)
}

// putToNode adds an entry to a node, returning a new node.
func putToNode[K comparable, V any](node Ptr[hashMapNode[K, V]], key K, value V, hashCode uint32, level int) Ptr[hashMapNode[K, V]] {
    if node.isLeaf {
        // Check if key already exists - update value
        val found = KeyIndex(node.keys, key)
        if found >= 0 {
            var newKeys []K
            var newValues []V
            for j := 0; j < node.keys.Size(); j++ {
                newKeys = go_interop.SliceAppend(newKeys, node.keys[j])
                if j == found {
                    newValues = go_interop.SliceAppend(newValues, value)
                } else {
                    newValues = go_interop.SliceAppend(newValues, node.values[j])
                }
            }
            return &hashMapNode[K, V](keys = newKeys, values = newValues, isLeaf = true)
        }

        // Add new entry or expand to internal node
        if level >= 6 {
            // Max depth reached, just add to entries (hash collision)
            var newKeys []K
            var newValues []V
            for i := 0; i < node.keys.Size(); i++ {
                newKeys = go_interop.SliceAppend(newKeys, node.keys[i])
                newValues = go_interop.SliceAppend(newValues, node.values[i])
            }
            newKeys = go_interop.SliceAppend(newKeys, key)
            newValues = go_interop.SliceAppend(newValues, value)
            return &hashMapNode[K, V](keys = newKeys, values = newValues, isLeaf = true)
        }

        // Create a new internal node and distribute elements
        var newNode Ptr[hashMapNode[K, V]] = &hashMapNode[K, V](bitmap = uint32(0), isLeaf = false)

        // Add existing entries
        for i := 0; i < node.keys.Size(); i++ {
            val existingHash = HashKeyOf(node.keys[i])
            newNode = insertIntoInternalNodeMap[K, V](newNode, node.keys[i], node.values[i], existingHash, level)
        }

        // Add new entry
        return insertIntoInternalNodeMap[K, V](newNode, key, value, hashCode, level)
    }

    // Internal node
    val bit = hashMapBitpos(hashCode, level)
    val idx = hashMapIndex(node.bitmap, bit)

    if (node.bitmap & bit) == 0 {
        // No child at this position, create new leaf
        var newKeys []K
        var newValues []V
        newKeys = go_interop.SliceAppend(newKeys, key)
        newValues = go_interop.SliceAppend(newValues, value)
        val newLeaf = &hashMapNode[K, V](keys = newKeys, values = newValues, isLeaf = true)

        // Copy children and insert new leaf
        var newChildren []Ptr[hashMapNode[K, V]]
        for i := 0; i < idx; i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
        newChildren = go_interop.SliceAppend(newChildren, newLeaf)
        for i := idx; i < node.children.Size(); i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }

        return &hashMapNode[K, V](bitmap = node.bitmap | bit, children = newChildren, isLeaf = false)
    }

    // Child exists, recurse
    val newChild = putToNode[K, V](node.children[idx], key, value, hashCode, level + 1)

    // Copy children with updated child
    var newChildren []Ptr[hashMapNode[K, V]]
    for i := 0; i < node.children.Size(); i++ {
        if i == idx {
            newChildren = go_interop.SliceAppend(newChildren, newChild)
        } else {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
    }

    return &hashMapNode[K, V](bitmap = node.bitmap, children = newChildren, isLeaf = false)
}

// insertIntoInternalNodeMap inserts an entry into an internal node.
func insertIntoInternalNodeMap[K comparable, V any](node Ptr[hashMapNode[K, V]], key K, value V, hashCode uint32, level int) Ptr[hashMapNode[K, V]] {
    val bit = hashMapBitpos(hashCode, level)
    val idx = hashMapIndex(node.bitmap, bit)

    if (node.bitmap & bit) == 0 {
        // No child at this position, create new leaf
        var newKeys []K
        var newValues []V
        newKeys = go_interop.SliceAppend(newKeys, key)
        newValues = go_interop.SliceAppend(newValues, value)
        val newLeaf = &hashMapNode[K, V](keys = newKeys, values = newValues, isLeaf = true)

        // Copy children and insert new leaf
        var newChildren []Ptr[hashMapNode[K, V]]
        for i := 0; i < idx; i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
        newChildren = go_interop.SliceAppend(newChildren, newLeaf)
        for i := idx; i < node.children.Size(); i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }

        return &hashMapNode[K, V](bitmap = node.bitmap | bit, children = newChildren, isLeaf = false)
    }

    // Child exists, recurse
    val newChild = putToNode[K, V](node.children[idx], key, value, hashCode, level + 1)

    // Copy children with updated child
    var newChildren []Ptr[hashMapNode[K, V]]
    for i := 0; i < node.children.Size(); i++ {
        if i == idx {
            newChildren = go_interop.SliceAppend(newChildren, newChild)
        } else {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
    }

    return &hashMapNode[K, V](bitmap = node.bitmap, children = newChildren, isLeaf = false)
}

// Remove removes a key from the map. Returns a new map. O(eC).
func (m HashMap[K, V]) Remove(key K) HashMap[K, V] {
    if m.root.IsEmpty() {
        return m
    }
    val root = m.root.Get()
    val hashCode = HashKeyOf(key)

    // Check if contains
    if !containsKeyInNode[K, V](root, key, hashCode, 0) {
        return m
    }

    if m.size == 1 {
        return EmptyHashMap[K, V]()
    }

    return HashMap[K, V](root = removeFromNodeMap[K, V](root, key, hashCode, 0), size = m.size - 1)
}

// removeFromNodeMap removes a key from a node, returning the new node, or
// empty when no entry is left under it.
func removeFromNodeMap[K comparable, V any](node Ptr[hashMapNode[K, V]], key K, hashCode uint32, level int) OptionPtr[hashMapNode[K, V]] {
    if node.isLeaf {
        var newKeys []K
        var newValues []V
        val found = KeyIndex(node.keys, key)
        for i := 0; i < node.keys.Size(); i++ {
            if i != found {
                newKeys = go_interop.SliceAppend(newKeys, node.keys[i])
                newValues = go_interop.SliceAppend(newValues, node.values[i])
            }
        }
        if newKeys.Size() == 0 {
            return EmptyOptionPtr[hashMapNode[K, V]]()
        }
        return SomePtr(&hashMapNode[K, V](keys = newKeys, values = newValues, isLeaf = true))
    }

    val bit = hashMapBitpos(hashCode, level)
    val idx = hashMapIndex(node.bitmap, bit)

    if (node.bitmap & bit) == 0 {
        return SomePtr(node)
    }

    val newChild = removeFromNodeMap[K, V](node.children[idx], key, hashCode, level + 1)

    if newChild.IsEmpty() {
        // Child is now empty, remove it
        if hashMapPopcount(node.bitmap) == 1 {
            return EmptyOptionPtr[hashMapNode[K, V]]()
        }

        var newChildren []Ptr[hashMapNode[K, V]]
        for i := 0; i < node.children.Size(); i++ {
            if i != idx {
                newChildren = go_interop.SliceAppend(newChildren, node.children[i])
            }
        }
        return SomePtr(&hashMapNode[K, V](bitmap = node.bitmap & (^bit), children = newChildren, isLeaf = false))
    }

    // Copy children with updated child
    var newChildren []Ptr[hashMapNode[K, V]]
    for i := 0; i < node.children.Size(); i++ {
        if i == idx {
            newChildren = go_interop.SliceAppend(newChildren, newChild.Get())
        } else {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
    }

    return SomePtr(&hashMapNode[K, V](bitmap = node.bitmap, children = newChildren, isLeaf = false))
}

// Updated is an alias for Put.
func (m HashMap[K, V]) Updated(key K, value V) HashMap[K, V] = m.Put(key, value)

// === Iteration ===

// ForEachKV applies a function to each key-value pair for side effects.
func (m HashMap[K, V]) ForEachKV(f func(K, V)) {
    m.root.ForEach((root) => forEachInNodeMapKV[K, V](root, f))
}

// forEachInNodeMapKV traverses a node and applies f to each entry.
func forEachInNodeMapKV[K comparable, V any](node Ptr[hashMapNode[K, V]], f func(K, V)) {
    if node.isLeaf {
        for i := 0; i < node.keys.Size(); i++ {
            f(node.keys[i], node.values[i])
        }
        return
    }

    for i := 0; i < node.children.Size(); i++ {
        forEachInNodeMapKV[K, V](node.children[i], f)
    }
}

// ForEachKey applies a function to each key for side effects.
func (m HashMap[K, V]) ForEachKey(f func(K)) {
    m.ForEachKV((k K, v V) => {
        f(k)
    })
}

// ForEachValue applies a function to each value for side effects.
func (m HashMap[K, V]) ForEachValue(f func(V)) {
    m.ForEachKV((k K, v V) => {
        f(v)
    })
}

// === Transformation ===

// MapValues applies a function to each value and returns a new map.
func (m HashMap[K, V]) MapValues[U any](f func(V) U) HashMap[K, U] {
    return m.FoldLeftKV[HashMap[K, U]](EmptyHashMap[K, U](), (acc HashMap[K, U], k K, v V) => acc.Put(k, f(v)))
}

// Filter returns a new map with only entries that satisfy the predicate.
func (m HashMap[K, V]) Filter(p func(K, V) bool) HashMap[K, V] {
    return m.FoldLeftKV[HashMap[K, V]](EmptyHashMap[K, V](), (acc HashMap[K, V], k K, v V) => {
        if p(k, v) {
            return acc.Put(k, v)
        }
        return acc
    })
}

// FilterKeys returns a new map with only entries whose keys satisfy the predicate.
func (m HashMap[K, V]) FilterKeys(p func(K) bool) HashMap[K, V] {
    return m.FoldLeftKV[HashMap[K, V]](EmptyHashMap[K, V](), (acc HashMap[K, V], k K, v V) => {
        if p(k) {
            return acc.Put(k, v)
        }
        return acc
    })
}

// FilterValues returns a new map with only entries whose values satisfy the predicate.
func (m HashMap[K, V]) FilterValues(p func(V) bool) HashMap[K, V] {
    return m.FoldLeftKV[HashMap[K, V]](EmptyHashMap[K, V](), (acc HashMap[K, V], k K, v V) => {
        if p(v) {
            return acc.Put(k, v)
        }
        return acc
    })
}

// Collect applies a partial function to each key-value pair and collects the results.
// Entries for which the function returns None are filtered out.
// Returns an Array since the result type may not be suitable for a HashMap.
func (m HashMap[K, V]) Collect[U any](pf func(K, V) Option[U]) Array[U] {
    var builder = newArrayBuilder[U]()
    m.ForEachKV((k K, v V) => {
        val opt = pf(k, v)
        if opt.IsDefined() {
            builder.Add(opt.Get())
        }
    })
    return builder.Result()
}

// FilterNot returns a new map with entries that do not satisfy the predicate.
func (m HashMap[K, V]) FilterNot(p func(K, V) bool) HashMap[K, V] {
    return m.FoldLeftKV[HashMap[K, V]](EmptyHashMap[K, V](), (acc HashMap[K, V], k K, v V) => {
        if !p(k, v) {
            return acc.Put(k, v)
        }
        return acc
    })
}

// === Reduction ===

// FoldLeftKV applies a binary operator from left to right with key-value pairs.
func (m HashMap[K, V]) FoldLeftKV[U any](initial U, f func(U, K, V) U) U {
    var acc = initial
    m.ForEachKV((k K, v V) => {
        acc = f(acc, k, v)
    })
    return acc
}

// === Predicate Operations ===

// Exists returns true if any entry satisfies the predicate.
// Uses early exit for performance.
func (m HashMap[K, V]) Exists(p func(K, V) bool) bool = m.root match {
    case Some(root) => existsInNodeMap[K, V](root, p)
    case None() => false
}

// existsInNodeMap searches for an entry satisfying p with early exit.
func existsInNodeMap[K comparable, V any](node Ptr[hashMapNode[K, V]], p func(K, V) bool) bool {
    if node.isLeaf {
        for i := 0; i < node.keys.Size(); i++ {
            if p(node.keys[i], node.values[i]) {
                return true
            }
        }
        return false
    }
    for i := 0; i < node.children.Size(); i++ {
        if existsInNodeMap[K, V](node.children[i], p) {
            return true
        }
    }
    return false
}

// ForAll returns true if all entries satisfy the predicate.
// Uses early exit for performance.
func (m HashMap[K, V]) ForAll(p func(K, V) bool) bool = m.root match {
    case Some(root) => forAllInNodeMap[K, V](root, p)
    case None() => true
}

// forAllInNodeMap checks if all entries satisfy p with early exit.
func forAllInNodeMap[K comparable, V any](node Ptr[hashMapNode[K, V]], p func(K, V) bool) bool {
    if node.isLeaf {
        for i := 0; i < node.keys.Size(); i++ {
            if !p(node.keys[i], node.values[i]) {
                return false
            }
        }
        return true
    }
    for i := 0; i < node.children.Size(); i++ {
        if !forAllInNodeMap[K, V](node.children[i], p) {
            return false
        }
    }
    return true
}

// Count returns the number of entries satisfying the predicate.
func (m HashMap[K, V]) Count(p func(K, V) bool) int {
    return m.FoldLeftKV[int](0, (acc int, k K, v V) => {
        if p(k, v) {
            return acc + 1
        }
        return acc
    })
}

// === Key/Value Access ===

// Keys returns a HashSet of all keys.
func (m HashMap[K, V]) Keys() HashSet[K] {
    return m.FoldLeftKV[HashSet[K]](EmptyHashSet[K](), (acc HashSet[K], k K, v V) => acc.Add(k))
}

// Values returns a List of all values.
func (m HashMap[K, V]) Values() List[V] {
    return m.FoldLeftKV[List[V]](emptyList[V](), (acc List[V], k K, v V) => consList[V](v, acc))
}

// KeyArray returns an Array of all keys.
func (m HashMap[K, V]) KeyArray() Array[K] {
    return m.FoldLeftKV[Array[K]](EmptyArray[K](), (acc Array[K], k K, v V) => acc.Append(k))
}

// ValueArray returns an Array of all values.
func (m HashMap[K, V]) ValueArray() Array[V] {
    return m.FoldLeftKV[Array[V]](EmptyArray[V](), (acc Array[V], k K, v V) => acc.Append(v))
}

// === Merge Operations ===

// PutAll adds all entries from another map. Returns a new map.
func (m HashMap[K, V]) PutAll(other HashMap[K, V]) HashMap[K, V] {
    return other.FoldLeftKV[HashMap[K, V]](m, (acc HashMap[K, V], k K, v V) => acc.Put(k, v))
}

// Merge merges another map with a combining function for duplicate keys.
func (m HashMap[K, V]) Merge(other HashMap[K, V], f func(V, V) V) HashMap[K, V] {
    return other.FoldLeftKV[HashMap[K, V]](m, (acc HashMap[K, V], k K, v V) => {
        return acc.Get(k) match {
            case Some(existing) => acc.Put(k, f(existing, v))
            case None() => acc.Put(k, v)
        }
    })
}

// === Conversion ===

// ToGoMap converts the map to a Go map.
func (m HashMap[K, V]) ToGoMap() map[K]V {
    var result = go_interop.MapEmpty[K, V]()
    m.ForEachKV((k K, v V) => {
        go_interop.MapPut[K, V](result, k, v)
    })
    return result
}

// ToList converts the map to a List of tuples.
func (m HashMap[K, V]) ToList() List[Tuple[K, V]] {
    return m.FoldLeftKV[List[Tuple[K, V]]](emptyList[Tuple[K, V]](), (acc List[Tuple[K, V]], k K, v V) => consList[Tuple[K, V]]((k, v), acc))
}

// String returns a string representation of the map.
func (m HashMap[K, V]) String() string {
    if m.size == 0 {
        return "HashMap()"
    }
    var result = "HashMap("
    var first = true
    m.ForEachKV((k K, v V) => {
        if !first {
            result = result + ", "
        }
        result = result + s"$k -> $v"
        first = false
    })
    return result + ")"
}

// MkString joins entries into a string with separator.
func (m HashMap[K, V]) MkString(sep string) string {
    if m.size == 0 {
        return ""
    }
    var result = ""
    var first = true
    m.ForEachKV((k K, v V) => {
        if !first {
            result = result + sep
        }
        result = result + s"$k -> $v"
        first = false
    })
    return result
}

// KeySet returns a HashSet of all keys.
func (m HashMap[K, V]) KeySet() HashSet[K] = m.Keys()

// === Sorting ===

// Sorted returns an array of key-value tuples sorted by key in natural order.
func (m HashMap[K, V]) Sorted() Array[Tuple[K, V]] = m.ToArray().SortBy((e) => e.V1)

// SortWith returns an array of key-value tuples sorted using the given comparison function.
func (m HashMap[K, V]) SortWith(less func(Tuple[K, V], Tuple[K, V]) bool) Array[Tuple[K, V]] = m.ToArray().SortWith(less)

// SortBy returns an array of key-value tuples sorted by a key extracted from each entry.
func (m HashMap[K, V]) SortBy[S comparable](f func(Tuple[K, V]) S) Array[Tuple[K, V]] = m.ToArray().SortBy(f)

// === Additional Operations ===

// Find returns the first entry satisfying the predicate.
func (m HashMap[K, V]) Find(p func(K, V) bool) Option[Tuple[K, V]] {
    return m.FoldLeftKV[Option[Tuple[K, V]]](None[Tuple[K, V]](), (acc Option[Tuple[K, V]], k K, v V) => {
        if acc.IsEmpty() && p(k, v) {
            return Some[Tuple[K, V]]((k, v))
        }
        return acc
    })
}

// Head returns the first entry. Panics if empty.
func (m HashMap[K, V]) Head() Tuple[K, V] {
    return m.HeadOption() match {
        case Some(v) => v
        case None() => go_builtins.Panic("HashMap: head of empty map")
    }
}

// HeadOption returns the first entry as Option.
func (m HashMap[K, V]) HeadOption() Option[Tuple[K, V]] {
    if m.IsEmpty() {
        return None[Tuple[K, V]]()
    }
    return m.FoldLeftKV[Option[Tuple[K, V]]](None[Tuple[K, V]](), (acc Option[Tuple[K, V]], k K, v V) => {
        if acc.IsEmpty() {
            return Some[Tuple[K, V]]((k, v))
        }
        return acc
    })
}

// ToArray returns an immutable Array of key-value tuples.
func (m HashMap[K, V]) ToArray() Array[Tuple[K, V]] {
    return m.FoldLeftKV[Array[Tuple[K, V]]](EmptyArray[Tuple[K, V]](), (acc Array[Tuple[K, V]], k K, v V) => acc.Append((k, v)))
}

// Partition partitions the map into two maps based on predicate.
func (m HashMap[K, V]) Partition(p func(K, V) bool) Tuple[HashMap[K, V], HashMap[K, V]] {
    val initial = (EmptyHashMap[K, V](), EmptyHashMap[K, V]())
    return m.FoldLeftKV[Tuple[HashMap[K, V], HashMap[K, V]]](initial, (acc Tuple[HashMap[K, V], HashMap[K, V]], k K, v V) => {
        if p(k, v) {
            return (acc.V1.Put(k, v), acc.V2)
        }
        return (acc.V1, acc.V2.Put(k, v))
    })
}

// === Factory Functions ===

// HashMapOf creates a HashMap from key-value tuples.
func HashMapOf[K comparable, V any](entries ...Tuple[K, V]) HashMap[K, V] {
    var result = EmptyHashMap[K, V]()
    for i := 0; i < entries.Size(); i++ {
        result = result.Put(entries[i].V1, entries[i].V2)
    }
    return result
}

// HashMapFromSlice creates a HashMap from a slice of tuples.
func HashMapFromSlice[K comparable, V any](entries []Tuple[K, V]) HashMap[K, V] {
    var result = EmptyHashMap[K, V]()
    for i := 0; i < entries.Size(); i++ {
        result = result.Put(entries[i].V1, entries[i].V2)
    }
    return result
}

// HashMapFromGoMap creates a HashMap from a Go map.
func HashMapFromGoMap[K comparable, V any](m map[K]V) HashMap[K, V] {
    var result = EmptyHashMap[K, V]()
    for k, v := range m {
        result = result.Put(k, v)
    }
    return result
}
-- collection_immutable/hashset.gala --
package collection_immutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
    "martianoff/gala/go_builtins"
)

// HashSet is an immutable set with effectively constant time operations.
// It uses a Hash Array Mapped Trie (HAMT) structure similar to Scala's HashSet.
//
// Elements must be either:
// - Primitive types (int, string, bool, etc.) - hashed automatically
// - Tuple, Option and Either holding values of these kinds (std implements Hashable for them)
// - Types implementing the Hashable interface
//
// Performance characteristics (eC = effectively constant, log32(n)):
// - Add:      O(eC)
// - Remove:   O(eC)
// - Contains: O(eC)
// - Size:     O(1) - cached
// - Union:    O(m) where m is the smaller set
// - Intersect: O(m) where m is the smaller set

// hashSetNode represents a node in the HAMT structure.
// Uses bitmap to track which children exist.
type hashSetNode[T comparable] struct {
    bitmap   uint32
    entries  []T                   // Direct entries at this node (for leaf collisions)
    children []Ptr[hashSetNode[T]]     // Child nodes (for internal nodes)
    isLeaf   bool
}

// HashSet represents an immutable set.
//
// root is never reassigned; it is `var` for the reason List's tail is.
type HashSet[T comparable] struct {
    var root   OptionPtr[hashSetNode[T]] // empty when the set is empty
    size   int
    // hashSum and hashXor are the sum and the XOR of the element hashes
    // (HashKey). Add and Remove keep them up to date from the hash they route
    // the element by, so Hash is O(1). They hold only when size != 1: Add
    // does not hash the first element of an empty set, so a one-element set
    // of a type HashKey cannot hash stays legal; sums hashes that element on
    // demand.
    hashSum uint32
    hashXor uint32
}

// EmptyHashSet returns an empty HashSet.
func EmptyHashSet[T comparable]() HashSet[T] =
    HashSet[T](root = EmptyOptionPtr[hashSetNode[T]](), size = 0, hashSum = uint32(0), hashXor = uint32(0))

// HashSetOf creates a HashSet from variadic arguments.
// Example: HashSetOf[int](1, 2, 3) creates HashSet(1, 2, 3)
func HashSetOf[T comparable](elements ...T) HashSet[T] {
    var result = EmptyHashSet[T]()
    for i := 0; i < elements.Size(); i++ {
        result = result.Add(elements[i])
    }
    return result
}

// HashSetFromSlice creates a HashSet from a slice.
func HashSetFromSlice[T comparable](elements []T) HashSet[T] {
    var result = EmptyHashSet[T]()
    for i := 0; i < elements.Size(); i++ {
        result = result.Add(elements[i])
    }
    return result
}

// IsEmpty returns true if the set is empty.
func (s HashSet[T]) IsEmpty() bool = s.size == 0

// NonEmpty returns true if the set is not empty.
func (s HashSet[T]) NonEmpty() bool = s.size > 0

// Size returns the number of elements. O(1) - cached.
func (s HashSet[T]) Size() int = s.size

// Length is an alias for Size.
func (s HashSet[T]) Length() int = s.size

// firstOccurrence returns a predicate that holds for each element the first
// time an Equal element is seen, for Distinct. It looks elements up in a
// HashSet when T is a type HashesByValue covers, and otherwise compares each
// one with Equal against the elements kept so far.
func firstOccurrence[T any]() func(T) bool {
    var zero T
    if HashesByValue(zero) {
        var seen = EmptyHashSet[any]()
        return (elem T) => {
            val before = seen.Size()
            seen = seen.Add(elem)
            seen.Size() > before
        }
    }
    var kept = EmptyArray[T]()
    return (elem T) => {
        if kept.Contains(elem) {
            return false
        }
        kept = kept.Append(elem)
        true
    }
}

// bitpos returns the bit position for a hash at a given level.
func bitpos(hashCode uint32, level int) uint32 {
    var shift = uint(level * 5)
    var idx = (hashCode >> shift) & 31
    return uint32(1) << idx
}

// index returns the array index for a bit position in a bitmap.
func index(bitmap uint32, bit uint32) int {
    return popcount(bitmap & (bit - 1))
}

// popcount returns the number of set bits in a uint32.
func popcount(var x uint32) int {
    var count = 0
    for x != 0 {
        count++
        x = x & (x - 1)
    }
    return count
}

// Contains checks if the set contains the given element. O(eC).
func (s HashSet[T]) Contains(elem T) bool {
    if s.root.IsEmpty() {
        return false
    }
    val hashCode = HashKeyOf(elem)
    return containsInNode[T](s.root.Get(), elem, hashCode, 0)
}

// containsInNode searches for an element in a node.
func containsInNode[T comparable](node Ptr[hashSetNode[T]], elem T, hashCode uint32, level int) bool {
    if node.isLeaf {
        for i := 0; i < node.entries.Size(); i++ {
            if node.entries[i] == elem {
                return true
            }
        }
        return KeyIndexByValue(node.entries, elem) >= 0
    }

    val bit = bitpos(hashCode, level)
    if (node.bitmap & bit) == 0 {
        return false
    }

    val idx = index(node.bitmap, bit)
    return containsInNode[T](node.children[idx], elem, hashCode, level + 1)
}

// Add adds an element to the set. Returns a new set with the element. O(eC).
func (s HashSet[T]) Add(elem T) HashSet[T] {
    if s.root.IsEmpty() {
        // Create new leaf node
        val leaf = &hashSetNode[T](entries = go_interop.SliceOf(elem), isLeaf = true)
        return HashSet[T](root = SomePtr(leaf), size = 1, hashSum = uint32(0), hashXor = uint32(0))
    }
    val root = s.root.Get()
    val hashCode = HashKeyOf(elem)

    // Check if already contains (single hash computation)
    if containsInNode[T](root, elem, hashCode, 0) {
        return s
    }
    val (sum, xor) = s.sums()
    HashSet[T](root = SomePtr(addToNode[T](root, elem, hashCode, 0)), size = s.size + 1, hashSum = sum + hashCode, hashXor = xor ^ hashCode)
}

// addToNode adds an element to a node, returning a new node.
func addToNode[T comparable](node Ptr[hashSetNode[T]], elem T, hashCode uint32, level int) Ptr[hashSetNode[T]] {
    if node.isLeaf {
        // Add to leaf's entries or expand to internal node
        if level >= 6 {
            // Max depth reached, just add to entries (hash collision)
            var newEntries []T
            for i := 0; i < node.entries.Size(); i++ {
                newEntries = go_interop.SliceAppend(newEntries, node.entries[i])
            }
            newEntries = go_interop.SliceAppend(newEntries, elem)
            return &hashSetNode[T](entries = newEntries, isLeaf = true)
        }

        // Create a new internal node and distribute elements
        var newNode Ptr[hashSetNode[T]] = &hashSetNode[T](bitmap = uint32(0), isLeaf = false)

        // Add existing entries
        for i := 0; i < node.entries.Size(); i++ {
            val existingHash = HashKeyOf(node.entries[i])
            newNode = insertIntoInternalNode[T](newNode, node.entries[i], existingHash, level)
        }

        // Add new element
        return insertIntoInternalNode[T](newNode, elem, hashCode, level)
    }

    // Internal node
    val bit = bitpos(hashCode, level)
    val idx = index(node.bitmap, bit)

    if (node.bitmap & bit) == 0 {
        // No child at this position, create new leaf
        var newEntries []T
        newEntries = go_interop.SliceAppend(newEntries, elem)
        val newLeaf = &hashSetNode[T](entries = newEntries, isLeaf = true)

        // Copy children and insert new leaf
        var newChildren []Ptr[hashSetNode[T]]
        for i := 0; i < idx; i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
        newChildren = go_interop.SliceAppend(newChildren, newLeaf)
        for i := idx; i < node.children.Size(); i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }

        return &hashSetNode[T](bitmap = node.bitmap | bit, children = newChildren, isLeaf = false)
    }

    // Child exists, recurse
    val newChild = addToNode[T](node.children[idx], elem, hashCode, level + 1)

    // Copy children with updated child
    var newChildren []Ptr[hashSetNode[T]]
    for i := 0; i < node.children.Size(); i++ {
        if i == idx {
            newChildren = go_interop.SliceAppend(newChildren, newChild)
        } else {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
    }

    return &hashSetNode[T](bitmap = node.bitmap, children = newChildren, isLeaf = false)
}

// insertIntoInternalNode inserts an element into an internal node.
func insertIntoInternalNode[T comparable](node Ptr[hashSetNode[T]], elem T, hashCode uint32, level int) Ptr[hashSetNode[T]] {
    val bit = bitpos(hashCode, level)
    val idx = index(node.bitmap, bit)

    if (node.bitmap & bit) == 0 {
        // No child at this position, create new leaf
        var newEntries []T
        newEntries = go_interop.SliceAppend(newEntries, elem)
        val newLeaf = &hashSetNode[T](entries = newEntries, isLeaf = true)

        // Copy children and insert new leaf
        var newChildren []Ptr[hashSetNode[T]]
        for i := 0; i < idx; i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
        newChildren = go_interop.SliceAppend(newChildren, newLeaf)
        for i := idx; i < node.children.Size(); i++ {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }

        return &hashSetNode[T](bitmap = node.bitmap | bit, children = newChildren, isLeaf = false)
    }

    // Child exists, recurse
    val newChild = addToNode[T](node.children[idx], elem, hashCode, level + 1)

    // Copy children with updated child
    var newChildren []Ptr[hashSetNode[T]]
    for i := 0; i < node.children.Size(); i++ {
        if i == idx {
            newChildren = go_interop.SliceAppend(newChildren, newChild)
        } else {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
    }

    return &hashSetNode[T](bitmap = node.bitmap, children = newChildren, isLeaf = false)
}

// Remove removes an element from the set. Returns a new set without the element. O(eC).
func (s HashSet[T]) Remove(elem T) HashSet[T] {
    if s.root.IsEmpty() {
        return s
    }
    val root = s.root.Get()
    val hashCode = HashKeyOf(elem)

    // Check if contains (single hash computation)
    if !containsInNode[T](root, elem, hashCode, 0) {
        return s
    }

    if s.size == 1 {
        return EmptyHashSet[T]()
    }

    // size >= 2 here, so hashSum and hashXor hold.
    HashSet[T](root = removeFromNode[T](root, elem, hashCode, 0), size = s.size - 1, hashSum = s.hashSum - hashCode, hashXor = s.hashXor ^ hashCode)
}

// removeFromNode removes an element from a node, returning the new node, or
// empty when no element is left under it.
func removeFromNode[T comparable](node Ptr[hashSetNode[T]], elem T, hashCode uint32, level int) OptionPtr[hashSetNode[T]] {
    if node.isLeaf {
        var newEntries []T
        val found = KeyIndex(node.entries, elem)
        for i := 0; i < node.entries.Size(); i++ {
            if i != found {
                newEntries = go_interop.SliceAppend(newEntries, node.entries[i])
            }
        }
        if newEntries.Size() == 0 {
            return EmptyOptionPtr[hashSetNode[T]]()
        }
        return SomePtr(&hashSetNode[T](entries = newEntries, isLeaf = true))
    }

    val bit = bitpos(hashCode, level)
    val idx = index(node.bitmap, bit)

    if (node.bitmap & bit) == 0 {
        return SomePtr(node)
    }

    val newChild = removeFromNode[T](node.children[idx], elem, hashCode, level + 1)

    if newChild.IsEmpty() {
        // Child is now empty, remove it
        if popcount(node.bitmap) == 1 {
            return EmptyOptionPtr[hashSetNode[T]]()
        }

        var newChildren []Ptr[hashSetNode[T]]
        for i := 0; i < node.children.Size(); i++ {
            if i != idx {
                newChildren = go_interop.SliceAppend(newChildren, node.children[i])
            }
        }
        return SomePtr(&hashSetNode[T](bitmap = node.bitmap & (^bit), children = newChildren, isLeaf = false))
    }

    // Copy children with updated child
    var newChildren []Ptr[hashSetNode[T]]
    for i := 0; i < node.children.Size(); i++ {
        if i == idx {
            newChildren = go_interop.SliceAppend(newChildren, newChild.Get())
        } else {
            newChildren = go_interop.SliceAppend(newChildren, node.children[i])
        }
    }

    return SomePtr(&hashSetNode[T](bitmap = node.bitmap, children = newChildren, isLeaf = false))
}

// AddAll adds all elements from another set. Returns a new set.
func (s HashSet[T]) AddAll(other HashSet[T]) HashSet[T] {
    return other.FoldLeft[HashSet[T]](s, (acc HashSet[T], elem T) => acc.Add(elem))
}

// Union returns a new set containing all elements from both sets.
func (s HashSet[T]) Union(other HashSet[T]) HashSet[T] = s.AddAll(other)

// Intersect returns a new set containing only elements present in both sets.
func (s HashSet[T]) Intersect(other HashSet[T]) HashSet[T] {
    // Iterate over the smaller set for efficiency
    var smaller HashSet[T]
    var larger HashSet[T]
    if s.size <= other.size {
        smaller = s
        larger = other
    } else {
        smaller = other
        larger = s
    }

    return smaller.FoldLeft[HashSet[T]](EmptyHashSet[T](), (acc HashSet[T], elem T) => {
        if larger.Contains(elem) {
            return acc.Add(elem)
        }
        return acc
    })
}

// Diff returns a new set containing elements in this set but not in other.
func (s HashSet[T]) Diff(other HashSet[T]) HashSet[T] {
    return s.FoldLeft[HashSet[T]](EmptyHashSet[T](), (acc HashSet[T], elem T) => {
        if !other.Contains(elem) {
            return acc.Add(elem)
        }
        return acc
    })
}

// SubsetOf returns true if this set is a subset of other.
func (s HashSet[T]) SubsetOf(other HashSet[T]) bool {
    if s.size > other.size {
        return false
    }
    return s.FoldLeft[bool](true, (acc bool, elem T) => acc && other.Contains(elem))
}

// Equal reports whether other holds the same elements, in any order. Sets
// whose element hashes differ cannot be Equal, so that is checked first.
func (s HashSet[T]) Equal(other HashSet[T]) bool =
    s.size == other.size &&
    (s.size < 2 || (s.hashSum == other.hashSum && s.hashXor == other.hashXor)) &&
    s.SubsetOf(other)

// Hash hashes the elements regardless of their order (std.Hashable), so a
// HashSet can be a HashSet element or a HashMap key. It is O(1): it combines
// the sum and the XOR of the element hashes, which do not depend on the order
// and which the set keeps as it is built. The element hashes are the ones the
// set routes its elements by (HashKey), so they agree with how it compares
// them: a pointer element without Hash hashes by its address.
func (s HashSet[T]) Hash() uint32 {
    val (sum, xor) = s.sums()
    HashCombine(HashCombine(HashInt(int64(s.size)), sum), xor)
}

// sums returns the sum and the XOR of the element hashes: hashSum and hashXor,
// or, for a one-element set, which does not keep them, its element's hash.
func (s HashSet[T]) sums() Tuple[uint32, uint32] {
    if s.size == 1 {
        val h = HashKeyOf(soleEntry(s.root.Get()))
        return (h, h)
    }
    (s.hashSum, s.hashXor)
}

// soleEntry is the element of a one-element set's node. Removal prunes empty
// nodes, so the path down to it has one child at each level; descending it
// needs no closure, unlike Head.
func soleEntry[T comparable](node Ptr[hashSetNode[T]]) T =
    if (node.isLeaf) node.entries[0] else soleEntry(node.children[0])

// ForEach applies a function to each element for side effects.
func (s HashSet[T]) ForEach(f func(T)) {
    s.root.ForEach((root) => forEachInNode[T](root, f))
}

// forEachInNode traverses a node and applies f to each element.
func forEachInNode[T comparable](node Ptr[hashSetNode[T]], f func(T)) {
    if node.isLeaf {
        for i := 0; i < node.entries.Size(); i++ {
            f(node.entries[i])
        }
        return
    }

    for i := 0; i < node.children.Size(); i++ {
        forEachInNode[T](node.children[i], f)
    }
}

// MapHashSet applies a function to each element and returns a new set.
// Note: Defined as standalone function to preserve type constraints.
func MapHashSet[T comparable, U comparable](s HashSet[T], f func(T) U) HashSet[U] {
    return s.FoldLeft[HashSet[U]](EmptyHashSet[U](), (acc HashSet[U], elem T) => acc.Add(f(elem)))
}

// FlatMapHashSet applies a function that returns a set to each element and flattens.
// Note: Defined as standalone function to preserve type constraints.
func FlatMapHashSet[T comparable, U comparable](s HashSet[T], f func(T) HashSet[U]) HashSet[U] {
    return s.FoldLeft[HashSet[U]](EmptyHashSet[U](), (acc HashSet[U], elem T) => acc.AddAll(f(elem)))
}

// Filter returns a new set with only elements that satisfy the predicate.
func (s HashSet[T]) Filter(p func(T) bool) HashSet[T] {
    return s.FoldLeft[HashSet[T]](EmptyHashSet[T](), (acc HashSet[T], elem T) => {
        if p(elem) {
            return acc.Add(elem)
        }
        return acc
    })
}

// FilterNot returns a new set with elements that do not satisfy the predicate.
func (s HashSet[T]) FilterNot(p func(T) bool) HashSet[T] = s.Filter((elem T) => !p(elem))

// Collect applies a partial function to each element and collects the results.
// Elements for which the function returns None are filtered out.
// Returns an Array since the result type may not be Hashable.
func (s HashSet[T]) Collect[U any](pf func(T) Option[U]) Array[U] {
    var builder = newArrayBuilder[U]()
    s.ForEach((elem T) => {
        val opt = pf(elem)
        if opt.IsDefined() {
            builder.Add(opt.Get())
        }
    })
    return builder.Result()
}

// Partition splits the set into two sets based on a predicate.
func (s HashSet[T]) Partition(p func(T) bool) Tuple[HashSet[T], HashSet[T]] {
    val left = s.Filter(p)
    val right = s.FilterNot(p)
    return (left, right)
}

// FoldLeft applies a binary operator from left to right.
func (s HashSet[T]) FoldLeft[U any](initial U, f func(U, T) U) U {
    var acc = initial
    s.ForEach((elem T) => {
        acc = f(acc, elem)
    })
    return acc
}

// Reduce applies a binary operator, starting with the first element.
// Panics if the set is empty.
func (s HashSet[T]) Reduce(f func(T, T) T) T {
    if s.size == 0 {
        go_builtins.Panic("HashSet.Reduce on empty set")
    }
    var first = true
    var acc T
    s.ForEach((elem T) => {
        if first {
            acc = elem
            first = false
        } else {
            acc = f(acc, elem)
        }
    })
    return acc
}

// ReduceOption is like Reduce but returns None for empty set.
func (s HashSet[T]) ReduceOption(f func(T, T) T) Option[T] {
    if s.size == 0 {
        return None[T]()
    }
    return Some[T](s.Reduce(f))
}

// Exists returns true if any element satisfies the predicate.
func (s HashSet[T]) Exists(p func(T) bool) bool {
    return s.FoldLeft[bool](false, (acc bool, elem T) => acc || p(elem))
}

// ForAll returns true if all elements satisfy the predicate.
func (s HashSet[T]) ForAll(p func(T) bool) bool {
    return s.FoldLeft[bool](true, (acc bool, elem T) => acc && p(elem))
}

// Find returns the first element that satisfies the predicate.
func (s HashSet[T]) Find(p func(T) bool) Option[T] {
    return s.FoldLeft[Option[T]](None[T](), (acc Option[T], elem T) => {
        if acc.IsEmpty() && p(elem) {
            return Some[T](elem)
        }
        return acc
    })
}

// Count returns the number of elements satisfying the predicate.
func (s HashSet[T]) Count(p func(T) bool) int {
    return s.FoldLeft[int](0, (acc int, elem T) => {
        if p(elem) {
            return acc + 1
        }
        return acc
    })
}

// Head returns an arbitrary element from the set.
// Panics if the set is empty.
func (s HashSet[T]) Head() T {
    if s.size == 0 {
        go_builtins.Panic("HashSet.Head on empty set")
    }
    var result T
    var found = false
    s.ForEach((elem T) => {
        if !found {
            result = elem
            found = true
        }
    })
    return result
}

// HeadOption returns an arbitrary element wrapped in Option.
func (s HashSet[T]) HeadOption() Option[T] {
    if s.size == 0 {
        return None[T]()
    }
    return Some[T](s.Head())
}

// ToGoSlice converts the set to a Go slice.
func (s HashSet[T]) ToGoSlice() []T {
    var result []T
    s.ForEach((elem T) => {
        result = go_interop.SliceAppend(result, elem)
    })
    return result
}

// ToList converts the set to a List.
func (s HashSet[T]) ToList() List[T] {
    return s.FoldLeft[List[T]](emptyList[T](), (acc List[T], elem T) => consList[T](elem, acc))
}

// ToArray converts the set to an Array.
func (s HashSet[T]) ToArray() Array[T] {
    return s.FoldLeft[Array[T]](EmptyArray[T](), (acc Array[T], elem T) => acc.Append(elem))
}

// String returns a string representation of the set.
func (s HashSet[T]) String() string {
    if s.size == 0 {
        return "HashSet()"
    }
    var result = "HashSet("
    var first = true
    s.ForEach((elem T) => {
        if !first {
            result = result + ", "
        }
        result = result + s"${elem}"
        first = false
    })
    return result + ")"
}

// MkString joins elements into a string with separator.
func (s HashSet[T]) MkString(sep string) string {
    if s.size == 0 {
        return ""
    }
    var result = ""
    var first = true
    s.ForEach((elem T) => {
        if !first {
            result = result + sep
        }
        result = result + s"${elem}"
        first = false
    })
    return result
}

// === Sorting ===

// Sorted returns an array of elements sorted in natural order.
func (s HashSet[T]) Sorted() Array[T] = s.ToArray().Sorted()

// SortWith returns an array of elements sorted using the given comparison function.
func (s HashSet[T]) SortWith(less func(T, T) bool) Array[T] = s.ToArray().SortWith(less)

// SortBy returns an array of elements sorted by a key extracted from each element.
func (s HashSet[T]) SortBy[K comparable](f func(T) K) Array[T] = s.ToArray().SortBy(f)

// HashSetEmpty extractor for pattern matching on empty sets.
type HashSetEmpty struct {}
func (hse HashSetEmpty) Unapply(s any) Option[bool] = s match {
    case set: HashSet[_] if set.size == 0 => Some[bool](true)
    case _ => None[bool]()
}

// HashSetNonEmpty extractor for pattern matching on non-empty sets.
type HashSetNonEmpty struct {}
func (hsne HashSetNonEmpty) Unapply(s any) Option[any] = s match {
    case set: HashSet[_] if set.size > 0 => Some[any](set)
    case _ => None[any]()
}
-- collection_immutable/list.gala --
package collection_immutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
    "martianoff/gala/go_builtins"
)

// List is an immutable linked list with the following performance characteristics:
// - Head:    O(1)
// - Tail:    O(1)
// - Prepend: O(1)
// - Append:  O(n)
// - Lookup:  O(n)
// - Update:  O(n)
// - Length:  O(1) - cached

// List represents an immutable singly-linked list.
// Every List is either Cons (non-empty) or Nil (empty).
// A List is empty exactly when its length is 0; only then is tail empty.
//
// tail is never reassigned. It is `var` so the generated Go holds the
// OptionPtr itself rather than an Immutable of it, whose methods Go would
// otherwise compile once more for every element type.
type List[T any] struct {
    head    T
    var tail OptionPtr[List[T]]
    length  int
}

// Internal helper to create empty list
func emptyList[T any]() List[T] {
    var zeroT T
    return List[T](head = zeroT, tail = EmptyOptionPtr[List[T]](), length = 0)
}

// Internal helper to prepend element to list
func consList[T any](head T, var tail List[T]) List[T] {
    return List[T](head = head, tail = SomePtr(&tail), length = tail.length + 1)
}

// Cons extractor for pattern matching on non-empty lists.
// Generic type parameter T is inferred from the matched List[T] type.
type Cons[T any] struct {}
func (c Cons[T]) Unapply(l List[T]) Option[Tuple[T, List[T]]] {
    if l.IsEmpty() {
        return None[Tuple[T, List[T]]]()
    }
    return Some[Tuple[T, List[T]]]((l.Head(), l.Tail()))
}

// Nil extractor for pattern matching on empty lists.
// Generic type parameter T is inferred from the matched List[T] type.
type Nil[T any] struct {}
func (n Nil[T]) Unapply(l List[T]) Option[bool] {
    if l.IsEmpty() {
        return Some[bool](true)
    }
    return None[bool]()
}

// ListOf creates a List from variadic arguments.
// Example: ListOf[int](1, 2, 3) creates List(1, 2, 3)
func ListOf[T any](elements ...T) List[T] {
    var result = emptyList[T]()
    for i := elements.Size() - 1; i >= 0; i-- {
        result = consList[T](elements[i], result)
    }
    return result
}

// ListFromSlice creates a List from a slice.
func ListFromSlice[T any](elements []T) List[T] {
    var result = emptyList[T]()
    for i := elements.Size() - 1; i >= 0; i-- {
        result = consList[T](elements[i], result)
    }
    return result
}

// EmptyList returns an empty list.
func EmptyList[T any]() List[T] = emptyList[T]()

// IsEmpty returns true if the list is empty.
func (l List[T]) IsEmpty() bool = l.length == 0

// NonEmpty returns true if the list is not empty.
func (l List[T]) NonEmpty() bool = l.length > 0

// Head returns the first element of the list.
// Panics if the list is empty.
func (l List[T]) Head() T {
    if l.length == 0 {
        go_builtins.Panic("List.Head on empty list")
    }
    return l.head
}

// HeadOption returns the first element wrapped in Option.
func (l List[T]) HeadOption() Option[T] {
    if l.length == 0 {
        return None[T]()
    }
    return Some[T](l.head)
}

// Tail returns all elements except the first.
// Panics if the list is empty.
func (l List[T]) Tail() List[T] {
    if l.length == 0 {
        go_builtins.Panic("List.Tail on empty list")
    }
    return *l.tail.Get()
}

// TailOption returns the tail wrapped in Option.
func (l List[T]) TailOption() Option[List[T]] {
    if l.length == 0 {
        return None[List[T]]()
    }
    return Some[List[T]](*l.tail.Get())
}

// Length returns the number of elements in the list. O(1) - cached.
func (l List[T]) Length() int = l.length

// Size is an alias for Length.
func (l List[T]) Size() int = l.length

// Equal reports whether other holds Equal elements in the same order.
func (l List[T]) Equal(other List[T]) bool {
    if l.length != other.length {
        return false
    }
    var a = l
    var b = other
    for a.length > 0 {
        if !Equal(a.head, b.head) {
            return false
        }
        a = *a.tail.Get()
        b = *b.tail.Get()
    }
    true
}

// Hash hashes the elements in order (std.Hashable), so a List can be a
// HashSet element or a HashMap key. Each element must be a primitive or
// Hashable, as a HashSet element must. It visits every element: it is O(n),
// and not cached.
func (l List[T]) Hash() uint32 = l.FoldLeft(HashInt(int64(l.length)), (h, elem) => HashCombine(h, HashOf(elem)))

// Prepend adds an element to the front of the list. O(1).
func (l List[T]) Prepend(elem T) List[T] = consList[T](elem, l)

// PrependAll prepends all elements from another list. O(m) where m is other's length.
func (l List[T]) PrependAll(other List[T]) List[T] {
    if other.length == 0 {
        return l
    }
    // Iterative implementation to avoid lambda type issues
    var result = l
    var stack = emptyList[T]()
    var current = other
    for current.length > 0 {
        stack = consList[T](current.head, stack)
        current = *current.tail.Get()
    }
    for stack.length > 0 {
        result = result.Prepend(stack.head)
        stack = *stack.tail.Get()
    }
    return result
}

// Append adds an element to the end of the list. O(n).
func (l List[T]) Append(elem T) List[T] = l.AppendAll(consList[T](elem, emptyList[T]()))

// AppendAll appends all elements from another list. O(n).
func (l List[T]) AppendAll(other List[T]) List[T] {
    if l.length == 0 {
        return other
    }
    // Iterative implementation using a stack to reverse, then prepend
    var stack = emptyList[T]()
    var current = l
    for current.length > 0 {
        stack = consList[T](current.head, stack)
        current = *current.tail.Get()
    }
    var result = other
    for stack.length > 0 {
        result = consList[T](stack.head, result)
        stack = *stack.tail.Get()
    }
    return result
}

// Get returns the element at the given index. O(n).
// Panics if index is out of bounds.
func (l List[T]) Get(index int) T {
    if (index < 0) || (index >= l.length) {
        go_builtins.Panic(f"List.Get: index $index out of bounds [0, ${l.length})")
    }
    var current = l
    for i := 0; i < index; i++ {
        current = *current.tail.Get()
    }
    return current.head
}

// GetOption returns the element at index wrapped in Option.
func (l List[T]) GetOption(index int) Option[T] {
    if (index < 0) || (index >= l.length) {
        return None[T]()
    }
    return Some[T](l.Get(index))
}

// Updated returns a new list with element at index replaced. O(n).
func (l List[T]) Updated(index int, elem T) List[T] {
    if (index < 0) || (index >= l.length) {
        go_builtins.Panic(f"List.Updated: index $index out of bounds [0, ${l.length})")
    }
    if index == 0 {
        return consList[T](elem, *l.tail.Get())
    }
    return consList[T](l.head, l.tail.Get().Updated(index - 1, elem))
}

// Last returns the last element of the list. O(n).
// Panics if the list is empty.
func (l List[T]) Last() T {
    if l.length == 0 {
        go_builtins.Panic("List.Last on empty list")
    }
    var current = l
    var next = *current.tail.Get()
    for next.length > 0 {
        current = next
        next = *current.tail.Get()
    }
    return current.head
}

// LastOption returns the last element wrapped in Option.
func (l List[T]) LastOption() Option[T] {
    if l.length == 0 {
        return None[T]()
    }
    return Some[T](l.Last())
}

// Init returns all elements except the last. O(n).
// Panics if the list is empty.
func (l List[T]) Init() List[T] {
    if l.length == 0 {
        go_builtins.Panic("List.Init on empty list")
    }
    var tail = *l.tail.Get()
    if tail.length == 0 {
        return emptyList[T]()
    }
    return consList[T](l.head, tail.Init())
}

// Take returns the first n elements. O(n).
func (l List[T]) Take(n int) List[T] {
    if n <= 0 || l.length == 0 {
        return emptyList[T]()
    }
    return consList[T](l.head, l.tail.Get().Take(n - 1))
}

// Drop returns all elements except the first n. O(n).
func (l List[T]) Drop(n int) List[T] {
    if n <= 0 || l.length == 0 {
        return l
    }
    return l.tail.Get().Drop(n - 1)
}

// TakeWhile returns the longest prefix of elements that satisfy the predicate.
func (l List[T]) TakeWhile(p func(T) bool) List[T] {
    if l.length == 0 || !p(l.head) {
        return emptyList[T]()
    }
    return consList[T](l.head, l.tail.Get().TakeWhile(p))
}

// DropWhile drops the longest prefix of elements that satisfy the predicate.
func (l List[T]) DropWhile(p func(T) bool) List[T] {
    if l.length == 0 || !p(l.head) {
        return l
    }
    return l.tail.Get().DropWhile(p)
}

// Contains checks if the list contains the given element. O(n).
func (l List[T]) Contains(elem T) bool {
    if l.length == 0 {
        return false
    }
    if Equal(l.head, elem) {
        return true
    }
    return l.tail.Get().Contains(elem)
}

// IndexOf returns the index of the first occurrence of elem, or -1 if not found. O(n).
func (l List[T]) IndexOf(elem T) int {
    var current = l
    for i := 0; current.length > 0; i++ {
        if Equal(current.head, elem) {
            return i
        }
        current = *current.tail.Get()
    }
    return -1
}

// LastIndexOf returns the index of the last occurrence of elem, or -1 if not found. O(n).
func (l List[T]) LastIndexOf(elem T) int {
    var result = -1
    var current = l
    for i := 0; current.length > 0; i++ {
        if Equal(current.head, elem) {
            result = i
        }
        current = *current.tail.Get()
    }
    return result
}

// Reverse returns a new list with elements in reverse order. O(n).
func (l List[T]) Reverse() List[T] {
    return l.FoldLeft[List[T]](emptyList[T](), (acc List[T], elem T) => consList[T](elem, acc))
}

// Map applies a function to each element and returns a new list.
func (l List[T]) Map[U any](f func(T) U) List[U] {
    if l.length == 0 {
        return emptyList[U]()
    }
    var tail = *l.tail.Get()
    return consList[U](f(l.head), tail.Map[U](f))
}

// FlatMap applies a function that returns a list to each element and flattens the result.
func (l List[T]) FlatMap[U any](f func(T) List[U]) List[U] {
    if l.length == 0 {
        return emptyList[U]()
    }
    var tail = *l.tail.Get()
    return f(l.head).AppendAll(tail.FlatMap[U](f))
}

// Collect applies a partial function to each element and collects the results.
// Elements for which the function returns None are filtered out.
func (l List[T]) Collect[U any](pf func(T) Option[U]) List[U] {
    if l.length == 0 {
        return emptyList[U]()
    }
    val tail = *l.tail.Get()
    return pf(l.head) match {
        case Some(v) => consList[U](v, tail.Collect[U](pf))
        case None() => tail.Collect[U](pf)
    }
}

// Concat returns a new list containing all elements of this list followed by
// all elements of the other iterable. O(n + m) where n = this length, m = other length.
//
// The obvious implementation — `Append`ing each other-element onto a growing
// accumulator — is O(m^2) because Append walks the accumulator every call.
// Instead, prepend each element onto `acc` (O(1)) and reverse at the end (O(m)),
// then AppendAll onto the receiver (O(n)). Net: O(n + m) with one allocation
// per input element.
func (l List[T]) Concat(other Iterable[T]) List[T] {
    var acc = emptyList[T]()
    other.ForEach((elem T) => {
        acc = acc.Prepend(elem)
    })
    return l.AppendAll(acc.Reverse())
}

// Filter returns a new list with only elements that satisfy the predicate.
func (l List[T]) Filter(p func(T) bool) List[T] {
    if l.length == 0 {
        return emptyList[T]()
    }
    if p(l.head) {
        return consList[T](l.head, l.tail.Get().Filter(p))
    }
    return l.tail.Get().Filter(p)
}

// FilterNot returns a new list with elements that do not satisfy the predicate.
func (l List[T]) FilterNot(p func(T) bool) List[T] = l.Filter((elem T) => !p(elem))

// Partition splits the list into two lists based on a predicate. O(n).
//
// The obvious implementation — `(l.Filter(p), l.FilterNot(p))` — walks the
// list twice (2n) and builds two intermediate structures. This single-pass
// version traverses once, prepending matches to `left` and non-matches to
// `right`, then reverses both for order preservation (still O(n)).
func (l List[T]) Partition(p func(T) bool) Tuple[List[T], List[T]] {
    var left = emptyList[T]()
    var right = emptyList[T]()
    var current = l
    for current.length > 0 {
        if p(current.head) {
            left = left.Prepend(current.head)
        } else {
            right = right.Prepend(current.head)
        }
        current = *current.tail.Get()
    }
    return (left.Reverse(), right.Reverse())
}

// FoldLeft applies a binary operator from left to right.
func (l List[T]) FoldLeft[U any](initial U, f func(U, T) U) U {
    var acc = initial
    var current = l
    for current.length > 0 {
        acc = f(acc, current.head)
        current = *current.tail.Get()
    }
    return acc
}

// FoldRight applies a binary operator from right to left.
func (l List[T]) FoldRight[U any](initial U, f func(T, U) U) U {
    if l.length == 0 {
        return initial
    }
    var tail = *l.tail.Get()
    return f(l.head, tail.FoldRight[U](initial, f))
}

// Reduce applies a binary operator from left to right, starting with the first element.
// Panics if the list is empty.
func (l List[T]) Reduce(f func(T, T) T) T {
    if l.length == 0 {
        go_builtins.Panic("List.Reduce on empty list")
    }
    var tail = *l.tail.Get()
    return tail.FoldLeft[T](l.head, f)
}

// ReduceOption is like Reduce but returns None for empty list.
func (l List[T]) ReduceOption(f func(T, T) T) Option[T] {
    if l.length == 0 {
        return None[T]()
    }
    return Some[T](l.Reduce(f))
}

// ForEach applies a function to each element for side effects.
func (l List[T]) ForEach(f func(T)) {
    var current = l
    for current.length > 0 {
        f(current.head)
        current = *current.tail.Get()
    }
}

// Exists returns true if any element satisfies the predicate.
func (l List[T]) Exists(p func(T) bool) bool {
    var current = l
    for current.length > 0 {
        if p(current.head) {
            return true
        }
        current = *current.tail.Get()
    }
    return false
}

// ForAll returns true if all elements satisfy the predicate.
func (l List[T]) ForAll(p func(T) bool) bool {
    var current = l
    for current.length > 0 {
        if !p(current.head) {
            return false
        }
        current = *current.tail.Get()
    }
    return true
}

// Find returns the first element that satisfies the predicate.
func (l List[T]) Find(p func(T) bool) Option[T] {
    var current = l
    for current.length > 0 {
        if p(current.head) {
            return Some[T](current.head)
        }
        current = *current.tail.Get()
    }
    return None[T]()
}

// Count returns the number of elements satisfying the predicate.
func (l List[T]) Count(p func(T) bool) int {
    return l.FoldLeft[int](0, (acc int, elem T) => {
        if p(elem) {
            return acc + 1
        }
        return acc
    })
}

// Zip combines two lists into a list of tuples. Result length is the minimum of both.
func (l List[T]) Zip[U any](other List[U]) List[Tuple[T, U]] {
    if l.length == 0 || other.length == 0 {
        return emptyList[Tuple[T, U]]()
    }
    val pair = (l.head, other.head)
    val lTail = *l.tail.Get()
    val otherTail = *other.tail.Get()
    return consList[Tuple[T, U]](pair, lTail.Zip[U](otherTail))
}

// ZipWithIndex pairs each element with its index.
func (l List[T]) ZipWithIndex() List[Tuple[T, int]] {
    var result = emptyList[Tuple[T, int]]()
    var current = l
    for i := 0; current.length > 0; i++ {
        result = consList[Tuple[T, int]]((current.head, i), result)
        current = *current.tail.Get()
    }
    return result.Reverse()
}

// Distinct returns a new list with duplicate elements removed, keeping the first
// occurrence of each element in its original position (like Array.Distinct).
// Elements are compared with Equal: through a HashSet when T is a primitive
// type (a number, string or bool), and against each kept element otherwise.
func (l List[T]) Distinct() List[T] {
    // A loop rather than Filter, whose recursion is as deep as the list.
    val isFirst = firstOccurrence[T]()
    // kept holds the kept elements in reverse order: O(1) prepends, one final Reverse.
    var kept = emptyList[T]()
    var current = l
    for current.length > 0 {
        if isFirst(current.head) {
            kept = consList[T](current.head, kept)
        }
        current = *current.tail.Get()
    }
    kept.Reverse()
}

// SplitAt splits the list at the given index.
func (l List[T]) SplitAt(n int) Tuple[List[T], List[T]] = (l.Take(n), l.Drop(n))

// Slice returns elements from index start (inclusive) to end (exclusive).
// Out-of-range bounds are clamped to [0, Length()], as for Array.Slice.
func (l List[T]) Slice(start int, end int) List[T] {
    val from = if (start < 0) 0 else start
    return l.Drop(from).Take(end - from)
}

// Span splits the list into a prefix/suffix pair according to a predicate.
// The first element contains the longest prefix of elements that satisfy p. O(n).
func (l List[T]) Span(p func(T) bool) Tuple[List[T], List[T]] {
    // Collect the prefix reversed (O(1) prepends) and reverse it once.
    var reversedPrefix = emptyList[T]()
    var current = l
    for current.length > 0 && p(current.head) {
        reversedPrefix = consList[T](current.head, reversedPrefix)
        current = *current.tail.Get()
    }
    // current is now the suffix (first element that doesn't satisfy p)
    return (reversedPrefix.Reverse(), current)
}

// PartitionMap applies a function to each element and partitions results into Left and Right. O(n).
func (l List[T]) PartitionMap[A any, B any](f func(T) Either[A, B]) Tuple[List[A], List[B]] {
    // Both sides are collected reversed (O(1) prepends) and reversed once.
    var lefts = emptyList[A]()
    var rights = emptyList[B]()
    var current = l
    for current.length > 0 {
        f(current.head) match {
            case Left(l) => lefts = consList[A](l, lefts)
            case Right(r) => rights = consList[B](r, rights)
        }
        current = *current.tail.Get()
    }
    return (lefts.Reverse(), rights.Reverse())
}

// GroupBy partitions this list into a map of lists according to a discriminator function.
// Each group keeps the input order. f runs once per element, in order. O(n).
func (l List[T]) GroupBy[K comparable](f func(T) K) map[K]List[T] = l.GroupMap(f, (elem) => elem)

// GroupMap partitions elements and maps values according to discriminator and value functions.
// Each group keeps the input order. key and value run once per element, in order. O(n).
func (l List[T]) GroupMap[K comparable, V any](key func(T) K, value func(T) V) map[K]List[V] {
    // Each group is built reversed (O(1) prepends) and reversed once at the end,
    // instead of an O(n) Append per element.
    val result = go_interop.MapEmpty[K, List[V]]()
    var current = l
    for current.length > 0 {
        val elem = current.head
        val k = key(elem)
        val group = result[k] // a missing key gives the zero List, which is empty
        result[k] = consList[V](value(elem), group)
        current = *current.tail.Get()
    }
    for k, group := range result {
        result[k] = group.Reverse()
    }
    return result
}

// GroupMapReduce partitions elements, maps values, and reduces them with a combining function.
func (l List[T]) GroupMapReduce[K comparable, V any](key func(T) K, value func(T) V, reduce func(V, V) V) map[K]V {
    var result = go_interop.MapEmpty[K, V]()
    var seen = go_interop.MapEmpty[K, bool]()
    var current = l
    for current.length > 0 {
        val elem = current.head
        val k = key(elem)
        val v = value(elem)
        if seen[k] {
            result[k] = reduce(result[k], v)
        } else {
            result[k] = v
            seen[k] = true
        }
        current = *current.tail.Get()
    }
    return result
}

// Flatten flattens a list of lists.
func Flatten[T any](ll List[List[T]]) List[T] {
    if ll.length == 0 {
        return emptyList[T]()
    }
    return ll.head.AppendAll(Flatten[T](*ll.tail.Get()))
}

// ToGoSlice converts the list to a Go slice.
func (l List[T]) ToGoSlice() []T {
    var result []T
    var current = l
    for current.length > 0 {
        result = go_interop.SliceAppend(result, current.head)
        current = *current.tail.Get()
    }
    return result
}

// String returns a string representation of the list.
func (l List[T]) String() string {
    if l.length == 0 {
        return "List()"
    }
    var result = "List("
    var current = l
    var first = true
    for current.length > 0 {
        if !first {
            result = result + ", "
        }
        result = result + s"${current.head}"
        current = *current.tail.Get()
        first = false
    }
    return result + ")"
}

// MkString joins elements into a string with separator.
func (l List[T]) MkString(sep string) string {
    if l.length == 0 {
        return ""
    }
    var result = ""
    var current = l
    var first = true
    for current.length > 0 {
        if !first {
            result = result + sep
        }
        result = result + s"${current.head}"
        current = *current.tail.Get()
        first = false
    }
    return result
}

// ToArray converts the list to an Array.
func (l List[T]) ToArray() Array[T] {
    var builder = newArrayBuilder[T]()
    var current = l
    for current.length > 0 {
        builder.Add(current.head)
        current = *current.tail.Get()
    }
    return builder.Result()
}

// === Sorting ===

// Sorted returns a new list with elements sorted in natural order.
func (l List[T]) Sorted() List[T] = l.ToArray().Sorted().ToList()

// SortWith returns a new list sorted using the given comparison function.
func (l List[T]) SortWith(less func(T, T) bool) List[T] = l.ToArray().SortWith(less).ToList()

// SortBy returns a new list sorted by a key extracted from each element.
func (l List[T]) SortBy[K comparable](f func(T) K) List[T] = l.ToArray().SortBy(f).ToList()

// SeqDrop implements the Seq interface for sequence pattern matching.
// Returns the list with the first n elements removed.
func (l List[T]) SeqDrop(n int) any = l.Drop(n)
-- collection_immutable/treemap.gala --
package collection_immutable

import (
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
    "martianoff/gala/go_builtins"
)

// TreeMap is an immutable sorted map implemented as a Red-Black tree.
// It maintains entries in sorted key order and provides O(log n) operations.
//
// Keys must be either:
// - Primitive types (int, string, float64, etc.) - compared automatically
// - Types implementing the Ordered[T] interface
//
// Performance characteristics:
// - Put:      O(log n)
// - Get:      O(log n)
// - Remove:   O(log n)
// - Contains: O(log n)
// - Min/Max:  O(log n)
// - Size:     O(1) - cached
//
// Unlike HashMap, TreeMap maintains sorted key order and supports range queries.

// Tree node colors for Red-Black tree
val treeMapRed int = 0
val treeMapBlack int = 1

// treeMapNode represents a node in the Red-Black tree.
//
// Its links and TreeMap's root are never reassigned; they are `var` for the
// reason List's tail is.
type treeMapNode[K comparable, V any] struct {
    key   K
    value V
    var left  OptionPtr[treeMapNode[K, V]]
    var right OptionPtr[treeMapNode[K, V]]
    color int
}

// TreeMap represents an immutable sorted map.
type TreeMap[K comparable, V any] struct {
    var root OptionPtr[treeMapNode[K, V]]
    size int
}

// EmptyTreeMap returns an empty TreeMap.
func EmptyTreeMap[K comparable, V any]() TreeMap[K, V] {
    return TreeMap[K, V](root = EmptyOptionPtr[treeMapNode[K, V]](), size = 0)
}

// TreeMapOf creates a TreeMap from key-value tuples.
// Example: TreeMapOf(("a", 1), ("b", 2)) creates TreeMap(a -> 1, b -> 2)
func TreeMapOf[K comparable, V any](entries ...Tuple[K, V]) TreeMap[K, V] {
    var result = EmptyTreeMap[K, V]()
    for i := 0; i < entries.Size(); i++ {
        result = result.Put(entries[i].V1, entries[i].V2)
    }
    return result
}

// TreeMapFromSlice creates a TreeMap from a slice of tuples.
func TreeMapFromSlice[K comparable, V any](entries []Tuple[K, V]) TreeMap[K, V] {
    var result = EmptyTreeMap[K, V]()
    for i := 0; i < entries.Size(); i++ {
        result = result.Put(entries[i].V1, entries[i].V2)
    }
    return result
}

// TreeMapFromGoMap creates a TreeMap from a Go map.
func TreeMapFromGoMap[K comparable, V any](m map[K]V) TreeMap[K, V] {
    var result = EmptyTreeMap[K, V]()
    for k, v := range m {
        result = result.Put(k, v)
    }
    return result
}

// === Basic Operations ===

// IsEmpty returns true if the map is empty.
func (m TreeMap[K, V]) IsEmpty() bool = m.size == 0

// NonEmpty returns true if the map is not empty.
func (m TreeMap[K, V]) NonEmpty() bool = m.size > 0

// Size returns the number of entries. O(1) - cached.
func (m TreeMap[K, V]) Size() int = m.size

// Length is an alias for Size.
func (m TreeMap[K, V]) Length() int = m.size

// Equal reports whether other holds the same keys, each mapped to an Equal
// value, however each map was built: both hold them in key order. It is O(n).
func (m TreeMap[K, V]) Equal(other TreeMap[K, V]) bool {
    if m.size != other.size {
        return false
    }
    val entries = m.FoldLeftKV(go_interop.SliceWithCapacity[Tuple[K, V]](m.size), (acc, k, v) => go_interop.SliceAppend(acc, (k, v)))
    // The fold carries the index of the next entry of m, -1 once one differs.
    other.FoldLeftKV(0, (i, k, v) => if (i >= 0 && Equal(entries[i].V1, k) && Equal(entries[i].V2, v)) i + 1 else -1) == m.size
}

// === Comparison ===

// treeMapCompare compares two keys and returns -1, 0, or 1.
func treeMapCompare[K comparable](a K, b K) int {
    val va any = a
    val vb any = b

    val result = va match {
        case ai: int => treeMapCompareIntsAny(ai, vb)
        case as: string => treeMapCompareStringsAny(as, vb)
        case ai64: int64 => treeMapCompareInt64sAny(ai64, vb)
        case ai32: int32 => treeMapCompareInt32sAny(ai32, vb)
        case af64: float64 => treeMapCompareFloat64sAny(af64, vb)
        case af32: float32 => treeMapCompareFloat32sAny(af32, vb)
        case au: uint => treeMapCompareUintsAny(au, vb)
        case au64: uint64 => treeMapCompareUint64sAny(au64, vb)
        case au32: uint32 => treeMapCompareUint32sAny(au32, vb)
        case ai16: int16 => treeMapCompareInt16sAny(ai16, vb)
        case ai8: int8 => treeMapCompareInt8sAny(ai8, vb)
        case au16: uint16 => treeMapCompareUint16sAny(au16, vb)
        case au8: uint8 => treeMapCompareUint8sAny(au8, vb)
        case ao: Ordered[K] => ao.Compare(b)
        case _ => treeMapPanicNotOrdered(va)
    }
    return result
}

// Type-specific comparison helpers
func treeMapCompareIntsAny(a int, vb any) int {
    val b = vb match { case bi: int => bi case _ => 0 }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeMapCompareStringsAny(a string, vb any) int {
    val b = vb match { case bs: string => bs case _ => "" }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeMapCompareInt64sAny(a int64, vb any) int {
    val b = vb match { case bi: int64 => bi case _ => int64(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeMapCompareInt32sAny(a int32, vb any) int {
    val b = vb match { case bi: int32 => bi case _ => int32(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

