-- examples/interpolation_nested_strings.gala --
package main

import (
    "strings"
    . "martianoff/gala/collection_immutable"
)

func classify(n int) string = n match {
    case 0            => "zero"
    case n if n < 0   => "negative"
    case _            => "positive"
}

func main() {
    // String literal inside ${...}
    Println(s"result: ${strings.Repeat("ab", 3)}")

    // Nested function call with string literal
    Println(s"classify: ${classify(0)}")

    // MkString with separator containing quotes
    val nums = ArrayOf(1, 2, 3)
    Println(s"nums: ${nums.MkString(", ")}")

    // Dollar escape still works
    val price = 42
    Println(s"Price: $$$price")

    // f-string with string inside ${...}
    Println(f"repeat: ${strings.Repeat("*", 5)}%s done")

    // Multiple string args in nested call
    Println(s"replaced: ${strings.Replace("hello world", "world", "gala", 1)}")
}
-- examples/io_effect.gala --
package main

import (
    "errors"
    "martianoff/gala/io"
)

func main() {
    // Pure value
    val pure = io.Of(42)
    val result = pure.Run()
    Println(s"Pure: ${result.Get()}")

    // Suspended computation
    val suspended = io.Suspend(() => 21 * 2)
    Println(s"Suspended: ${suspended.Run().Get()}")

    // Map and FlatMap
    val mapped = io.Map[int, int](io.Of(10), (x int) => x * 5)
    Println(s"Mapped: ${mapped.Run().Get()}")

    val chained = io.FlatMap[int, int](io.Of(10), (x int) => io.Of(x + 32))
    Println(s"Chained: ${chained.Run().Get()}")

    // Error handling
    val failing = io.Fail[int](errors.New("something went wrong"))
    val recovered = io.Recover(failing, (err) => -1)
    Println(s"Recovered: ${recovered.Run().Get()}")

    // Side effects
    val effect = io.Effect(() => {
        Println("Side effect executed!")
    })
    effect.Run()

    // AndThen - sequence effects
    val program = io.AndThen[bool, string](
        io.Effect(() => { Println("Step 1") }),
        io.Of("done"),
    )
    Println(s"Program: ${program.Run().Get()}")

    // Failure propagation
    val failChain = io.FlatMap[int, int](
        io.Fail[int](errors.New("initial error")),
        (x int) => io.Of(x * 2),
    )
    Println(s"Fail chain is failure: ${failChain.Run().IsFailure()}")

    // Laziness demonstration
    Println("Before IO creation")
    val lazy = io.Suspend(() => {
        Println("Computing...")
        return 99
    })
    Println("IO created but not run")
    Println(s"Now running: ${lazy.Run().Get()}")
}
