-- examples/lambda_explicit_return_type.gala --
package main

// Regression example: lambdas may declare an explicit return type
// between the parameter list and `=>`. Useful when storing a lambda
// in a `val` (no typed target context to drive inference) or when the
// author wants to assert the shape of the function for readability.
//
// Syntax: `(a int, b int) int => a + b`
// Grammar: `lambdaExpression: parameters type? '=>' (expression | block);`

func main() {
    // Explicit return type on a val-bound lambda.
    val concat = (l string, w string) string => l + " " + w
    Println(concat("hello", "world"))

    val add = (x int, y int) int => x + y
    Println(add(3, 4))

    // Explicit type with block body.
    val describe = (n int) string => {
        if n < 0 { return "negative" }
        if n == 0 { return "zero" }
        return "positive"
    }
    Println(describe(-5))
    Println(describe(0))
    Println(describe(42))

    // Omitting the return type still works (existing behaviour).
    val doubler = (x int) => x * 2
    Println(doubler(7))
}
-- examples/lambda_multi_return_type.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
)

// Lambda return type inference with multiple return paths.
// The multi-return type inference works correctly for same-package types.

type MyResponse struct {
    Status int
    Body string
}

func Unauthorized(msg string) MyResponse = MyResponse(Status = 401, Body = msg)
func Ok(body string) MyResponse = MyResponse(Status = 200, Body = body)

func middleware(next func(string) Future[MyResponse]) func(string) Future[MyResponse] =
    (req string) => {
        if (req == "bad") {
            return FutureOf(Unauthorized("unauthorized"))
        }
        return next(req)
    }

func handler(req string) Future[MyResponse] =
    FutureOf(Ok(s"hello $req"))

func main() {
    val mw = middleware((req string) => handler(req))
    val result = mw("good").Await()
    fmt.Println(result.Get().Body)

    val result2 = mw("bad").Await()
    fmt.Println(result2.Get().Body)
}
-- examples/lambda_multi_return_unify.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Verify that block lambdas with multiple return paths
// unify their return types correctly.

type Response struct {
    code int
    body string
}

func Unauthorized(msg string) Response = Response(code = 401, body = msg)
func Ok(msg string) Response = Response(code = 200, body = msg)

// Block lambda with multiple return paths returning the same concrete type.
// Previously the transpiler only looked at the first return and missed nested returns.
func processRequest(authorized bool) Response {
    val handler = (flag bool) => {
        if (flag) {
            return Ok("success")
        }
        return Unauthorized("not authorized")
    }
    return handler(authorized)
}

// Block lambda returning Option — both paths return Option[int].
func safeDivide(a int, b int) Option[int] {
    val divider = (x int, y int) => {
        if (y == 0) {
            return None[int]()
        }
        return Some(x / y)
    }
    return divider(a, b)
}

func main() {
    val r1 = processRequest(true)
    fmt.Println(s"Authorized: code=${r1.code} body=${r1.body}")

    val r2 = processRequest(false)
    fmt.Println(s"Unauthorized: code=${r2.code} body=${r2.body}")

    val d1 = safeDivide(10, 2)
    fmt.Println(s"10/2 = ${d1.GetOrElse(0)}")

    val d2 = safeDivide(10, 0)
    fmt.Println(s"10/0 = ${d2.GetOrElse(-1)}")
}
-- examples/lambda_return_generic.gala --
package main

import (
    "fmt"
    . "martianoff/gala/go_interop"
    . "martianoff/gala/std"
)

// Issue: Lambda return type inference fails when:
// 1. Lambda return type should be a struct defined in the same file
// 2. The struct is generic with the same type parameter as the containing function
// This mimics the stream.Suspend -> lazyStream pattern

// Best practice: Use Option[T] instead of nil for optional values in immutable fields
type Node[T any] struct {
    value T
    next func() Option[Node[T]]  // immutable, returns None at end of list
}

func (n Node[T]) GetValue() Option[T] = Some[T](n.value)
func (n Node[T]) GetNext() Option[Node[T]] = n.next()

// Takes thunks returning Node[T] - similar to lazyStream taking func() Stream[T]
func createNode[T any](headThunk func() Option[T], tailThunk func() Option[Node[T]]) Node[T] {
    return Node[T](
        value = headThunk().GetOrElse(*New[T]()),
        next = tailThunk,
    )
}

// This mimics Suspend: lambda return types should be Option[T] and Node[T]
func wrapNode[T any](thunk func() Node[T]) Node[T] {
    return createNode[T](
        () => thunk().GetValue(),  // Should be func() Option[T], not func() any
        () => thunk().GetNext(),   // Should be func() Option[Node[T]]
    )
}

func main() {
    // Build list: 42 -> 0 -> 0 -> None
    val end = Node[int](value = 0, next = () => None[Node[int]]())
    val middle = Node[int](value = 0, next = () => Some(end))
    val baseNode = Node[int](value = 42, next = () => Some(middle))

    val wrapped = wrapNode[int](() => baseNode)
    fmt.Printf("result: %d\n", wrapped.value)
}
-- examples/lambda_return_slot.gala --
package main

import (
    "errors"
    "strconv"

    . "martianoff/gala/collection_immutable"
)

// A lambda has its own return slot: a `return`, a `bind` block or a match in its
// body takes its type from the lambda, never from the enclosing function.

func apply[T any](f func() T) T = f()

func parse(s string) Try[int] = Try(strconv.Atoi(s))

func half(n int) Try[int] = if (n % 2 == 0) Success(n / 2) else Failure[int](errors.New(s"$n is odd"))

// The lambdas in the if-expression take their types from the returned value,
// not from the enclosing function's `func(string) string`.
func scaler(k int) func(string) string {
    val scale = apply(() => {
        return if (k > 0) (x int) => x * k else (x int) => x
    })
    return (s) => s"$s:${scale(5)}"
}

// `None()` infers from the lambda's other return (Option[int]), not from the
// enclosing function's Option[string].
func small(n int) Option[string] {
    val o = apply(() => {
        if (n > 5) {
            return Some(n)
        }
        return None()
    })
    return o.Map((v) => s"v=$v")
}

// A returned match takes the lambda's type.
func classify(n int) Option[string] {
    val code = apply(() => {
        return n match {
            case 0 => 10
            case _ => n + 1
        }
    })
    return Some(s"code=$code")
}

// A `bind` block in a lambda whose result type is not known takes its monad
// from its own trailing value.
func viaFlatMap(s string) Try[int] =
    parse(s).FlatMap((n) => {
        bind h = half(n)
        bind q = half(h)
        Success(q + 1)
    })

func viaThunk(s string) Try[Try[int]] = Try(() => {
    bind n = parse(s)
    bind h = half(n)
    Success(h)
})

func viaTypedLambda(s string) Try[int] {
    val f func(string) Try[int] = (x) => {
        bind n = parse(x)
        bind h = half(n)
        Success(h * 10)
    }
    return f(s)
}

// The slot is inferred from all of the body's result values, in any order: an
// early `return None()` guard takes its type from a later value.
func guard(o Option[int]) Option[int] = o.FlatMap((x) => {
    if (x < 0) {
        return None()
    }
    return Some(x + 1)
})

func guardTrailing(o Option[int]) Option[int] = o.FlatMap((x) => {
    if (x < 0) {
        return None()
    }
    Some(x * 10)
})

// `Failure(e)` has no element type of its own; it takes the bind block's.
func failFirst(s string) Try[int] = parse(s).FlatMap((n) => {
    if (n > 3) {
        return Failure(errors.New("big"))
    }
    bind m = parse(s)
    if (m == 0) {
        return Failure(errors.New("zero"))
    }
    Success(n + m)
})

// A statement-position match whose arms return is inlined: its `return`
// leaves the lambda, so it fills the lambda's slot.
func firstZero(n int) Option[string] {
    val o = apply(() => {
        n match {
            case 0 => {
                return Some(0)
            }
            case _ => {
                Println("not zero")
            }
        }
        return None()
    })
    return o.Map((v) => s"v=$v")
}

// A deferred `return None()` in such a match still makes it inlined.
func zeroIsNone(n int) Option[string] {
    val o = apply(() => {
        n match {
            case 0 => {
                return None()
            }
            case _ => {
                Println("not zero")
            }
        }
        Some(n)
    })
    return o.Map((v) => s"v=$v")
}

// The match subject does not type `None()`: the lambda's result type comes
// from `Some("x")`.
func subjectNotResult(o Option[int]) string {
    val r = apply(() => {
        o match {
            case None() => {
                return None()
            }
            case _ => {
                Println("some")
            }
        }
        return Some("x")
    })
    return s"$r"
}

// The same holds for the lambda's trailing value: inside a match over an
// Option[int], a trailing `None()` takes Option[string] from the `return`.
func trailingNone(o Option[int]) string = o match {
    case Some(v) => {
        val r = apply(() => {
            if (v > 1) {
                return Some("x")
            }
            None()
        })
        s"$r"
    }
    case _ => "none"
}

// When nothing else types the lambda, its `None()` needs its type argument.
func onlyTrailingNone(o Option[int]) string = o match {
    case Some(_) => {
        val r = apply(() => {
            Println("side effect")
            None[int]()
        })
        s"$r"
    }
    case _ => "none"
}

// A `return` in a branch of an if-expression a val is initialized with leaves
// the lambda, like any other `return` in it.
func doubledSize(s string) Option[string] {
    val o = apply(() => {
        if (s == "x") {
            return None()
        }
        val n = if (s == "") {
            return Some(0)
        } else {
            s.ByteSize()
        }
        Some(n * 2)
    })
    return o.Map((v) => s"v=$v")
}

// Inside a generic function or method, its own type parameters (and its
// receiver's) are resolved types: a value of type T or Option[T] types the
// lambda.
func identities[T any](xs Array[T]) Array[T] = xs.Map((x) => {
    return x
})

func wrapped[T any](x T) Option[T] {
    val r = apply(() => {
        return Some(x)
    })
    return r
}

struct Cell[T any](V T)

func (c Cell[T]) Read() T {
    val f = () => {
        return c.V
    }
    return f()
}

func (c Cell[T]) PairUp[U any](us Array[U]) Array[Tuple[T, U]] = us.FoldLeft(EmptyArray[Tuple[T, U]](), (acc, u) => {
    if (acc.Size() > 1) {
        return acc
    }
    acc.Append((c.V, u))
})

func (c Cell[T]) With[U any](o Option[U], skip bool) Option[Tuple[T, U]] = o.FlatMap((u) => {
    if (skip) {
        return None()
    }
    Some((c.V, u))
})

// Nested lambdas each have their own slot.
func nested(n int) string {
    val outer = apply(() => {
        val inner = apply(() => {
            return if (n > 0) n * 2 else 0
        })
        return inner > 2
    })
    return s"nested=$outer"
}

func main() {
    Println(scaler(3)("a"))
    Println(scaler(0)("b"))
    Println(small(3))
    Println(small(7))
    Println(classify(0))
    Println(classify(4))
    Println(viaFlatMap("8"))
    Println(viaFlatMap("6"))
    Println(viaThunk("4"))
    Println(viaThunk("x"))
    Println(viaTypedLambda("12"))
    Println(guard(Some(3)))
    Println(guard(Some(-1)))
    Println(guardTrailing(Some(3)))
    Println(guardTrailing(Some(-1)))
    Println(failFirst("2"))
    Println(failFirst("5"))
    Println(failFirst("0"))
    Println(firstZero(0))
    Println(firstZero(1))
    Println(zeroIsNone(0))
    Println(zeroIsNone(2))
    Println(subjectNotResult(None[int]()))
    Println(subjectNotResult(Some(1)))
    Println(trailingNone(Some(2)))
    Println(trailingNone(Some(1)))
    Println(onlyTrailingNone(Some(1)))
    Println(doubledSize("x"))
    Println(doubledSize(""))
    Println(doubledSize("abc"))
    Println(identities(ArrayOf(1, 2)))
    Println(wrapped("w"))
    Println(Cell(7).Read())
    Println(Cell("k").PairUp(ArrayOf(1, 2, 3)))
    Println(Cell(3).With(Some("u"), false))
    Println(Cell(3).With(Some("u"), true))
    Println(nested(3))
    Println(nested(-1))
}
-- examples/lambda_type_inference.gala --
package main

import (
    "fmt"
    . "martianoff/gala/go_interop"
    . "martianoff/gala/std"
)

// Minimal reproduction for lambda return type inference issue
// This reproduces the pattern where a generic method passes a lambda
// to another generic method, and the lambda's return type is not correctly inferred

// Container is a simple generic wrapper
type Container[T any] struct {
    var items []T
}

// Filter returns items matching the predicate
func (c Container[T]) Filter(p func(T) bool) Container[T] {
    var result []T
    for i := 0; i < c.items.Size(); i++ {
        if p(c.items[i]) {
            result = SliceAppend(result, c.items[i])
        }
    }
    return Container[T](items = result)
}

// FilterBy is a wrapper that delegates to Filter with a key extractor
// This is the pattern that fails: (item T) => predicate(keyFn(item))
func (c Container[T]) FilterBy[K any](keyFn func(T) K, predicate func(K) bool) Container[T] {
    // This lambda should infer return type bool from Filter's parameter type
    return c.Filter((item T) => predicate(keyFn(item)))
}

// Pair for testing
type Pair struct {
    Key   string
    Value int
}

func main() {
    var items []Pair
    items = SliceAppend(items, Pair(Key = "a", Value = 1))
    items = SliceAppend(items, Pair(Key = "b", Value = 2))
    items = SliceAppend(items, Pair(Key = "c", Value = 3))
    val container = Container[Pair](items = items)

    // This should work - FilterBy delegates to Filter
    val keyFn = (p Pair) => p.Key
    val predicate = (k string) => k != "b"
    val filtered = container.FilterBy[string](keyFn, predicate)

    fmt.Printf("Filtered count: %d\n", filtered.items.Size())
    fmt.Println("Done")
}
-- examples/language_ergonomics.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    "martianoff/gala/collection_immutable"
)

func main() {
    // === L5: Lambda parameter type inference ===
    // Type of x is inferred from Option[int].Map's parameter type
    val opt = Some(42)
    val doubled = opt.Map((x) => x * 2)
    fmt.Println("L5 - doubled:", doubled)

    // Filter with inferred param type
    val filtered = opt.Filter((x) => x > 10)
    fmt.Println("L5 - filtered:", filtered)

    // Option.Map with string
    val name = Some("hello")
    val length = name.Map((s) => s.Size())
    fmt.Println("L5 - string length:", length)

    // === L2: Void ForEach ===
    // ForEach takes func(T) — no return value needed
    fmt.Print("L2 - forEach:")
    val arr = collection_immutable.ArrayOf(1, 2, 3)
    arr.ForEach((x int) => {
        fmt.Print(" ", x)
    })
    fmt.Println()

    // Option ForEach is also void
    fmt.Print("L2 - option forEach:")
    opt.ForEach((x) => {
        fmt.Print(" ", x)
    })
    fmt.Println()

    // === L4: Boolean exhaustive match ===
    val flag = true
    val desc = flag match {
        case true => "yes"
        case false => "no"
    }
    fmt.Println("L4 - bool match:", desc)

    val flag2 = false
    val desc2 = flag2 match {
        case true => "TRUE"
        case false => "FALSE"
    }
    fmt.Println("L4 - bool match 2:", desc2)
}
-- examples/lib/generic.gala --
package lib

type Wrapper[T any] struct {
    V T
}

func (w Wrapper[T]) Map[U any](f func(T) U) Wrapper[U] = Wrapper[U](V = f(w.V))
-- examples/list_concat_partition_order.gala --
package main

import . "martianoff/gala/collection_immutable"

// Regression pin for the S2 partition rewrite in the transpiler-chief
// audit. The single-pass Partition (was O(2n) via Filter+FilterNot)
// must preserve input order — this example prints enough structure to
// catch an accidental reversal.
//
// (Concat / S1 is exercised indirectly through the existing stdlib
// tests; it cannot be called from an example at the moment because
// List's Concat signature does not line up with Iterable's interface
// method, a pre-existing transpiler/interface quirk. The algorithmic
// fix still applies; the example here focuses on what can be pinned.)
func main() {
    // Partition: split [1..6] by evenness. Left = 2,4,6 (in original order),
    // right = 1,3,5 (in original order).
    val nums = ListOf(1, 2, 3, 4, 5, 6)
    val split = nums.Partition((x) => x % 2 == 0)
    Print("evens:")
    split.V1.ForEach((x) => Print(s" $x"))
    Println("")
    Print("odds:")
    split.V2.ForEach((x) => Print(s" $x"))
    Println("")

    // AppendAll preserves element order (uses the same stack+prepend approach
    // we now use inside Concat). Assert that structure here so a regression in
    // either AppendAll or the Concat rewrite surfaces through a test.
    val a = ListOf(1, 2, 3)
    val b = ListOf(4, 5, 6)
    val joined = a.AppendAll(b)
    joined.ForEach((x) => Print(s"$x "))
    Println("")
}
-- examples/list_groupby_string_keys.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
)

// Regression test for gap #6: List.GroupBy with string keys panics in
// AppendAll: GroupBy must treat the zero-valued List[T] that a map[K]List[T]
// lookup returns for a missing key as an empty list.
//
// We stringify each bucket via FoldLeft (returns a concrete type, dodges
// a separate lambda-inference quirk on map-indexed List values) so this
// test pins the GroupBy fix on its own.
func describeString(prefix string, l List[string]) string {
    return prefix + ":" + l.FoldLeft("", (acc, w) => acc + " " + w) + " len=" + s"${l.Size()}"
}

func describeInt(prefix string, l List[int]) string {
    return prefix + ":" + l.FoldLeft("", (acc, x) => acc + " " + s"$x")
}

func main() {
    // String keys — the original panic case.
    val words = ListOf("a", "b", "a", "c", "b", "a")
    val grouped = words.GroupBy((w) => w)

    val bucketA = grouped["a"]
    val bucketB = grouped["b"]
    val bucketC = grouped["c"]
    Println(describeString("a", bucketA))
    Println(describeString("b", bucketB))
    Println(describeString("c", bucketC))

    // Int keys — baseline that must keep working.
    val nums = ListOf(1, 2, 3, 4, 5, 6)
    val byParity = nums.GroupBy((n) => n % 2)
    Println(describeInt("evens", byParity[0]))
    Println(describeInt("odds", byParity[1]))
}
-- examples/list_pattern_match.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"

func main() {
    // Create a list
    var list = ListOf[int](1, 2, 3, 4, 5)

    // Pattern match with explicit Tuple extractor
    // Cons returns Option[Tuple[any, any]] containing (head, tail)
    val res1 = list match {
        case Cons(Tuple(head, tail)) => fmt.Sprintf("Explicit Tuple: head=%v, tail=%v", head, tail)
        case Nil() => "Empty list"
        case _ => "Unknown"
    }
    fmt.Println(res1)

    // Pattern match with implicit tuple expansion (syntactic sugar)
    // Cons(head, tail) is equivalent to Cons(Tuple(head, tail))
    val res2 = list match {
        case Cons(head, tail) => fmt.Sprintf("Implicit expansion: head=%v, tail=%v", head, tail)
        case Nil() => "Empty list"
        case _ => "Unknown"
    }
    fmt.Println(res2)

    // Empty list matching
    var emptyList = EmptyList[int]()
    val res3 = emptyList match {
        case Cons(head, _) => fmt.Sprintf("Head: %v", head)
        case Nil() => "Empty!"
        case _ => "Unknown"
    }
    fmt.Println(res3)

    // List length
    fmt.Println(fmt.Sprintf("List length: %d", list.Length()))
}
-- examples/local_function_lambda.gala --
package main

import . "martianoff/gala/collection_immutable"

// Local functions are lambdas bound to a val. A named `func` inside a body is
// GALA-E0052; each shape below is what that diagnostic points at instead.

// A generic helper has no lambda form, so it lives at the top level.
func firstOr[T any](xs Array[T], fallback T) T = xs.HeadOption().GetOrElse(fallback)

func describe(scores Array[int]) string {
    // Expression body, result type written where a function would write it.
    val grade = (score int) string => score match {
        case s if s >= 90 => "A"
        case s if s >= 75 => "B"
        case _ => "C"
    }

    // Block body with early returns.
    val clamp = (score int) int => {
        if score < 0 {
            return 0
        }
        if score > 100 {
            return 100
        }
        return score
    }

    // A local helper closes over the enclosing function's values.
    val total = scores.FoldLeft(0, (acc, s) => acc + clamp(s))
    val share = (s int) int => if (total == 0) 0 else clamp(s) * 100 / total

    return scores.Map((s) => s"${clamp(s)}:${grade(clamp(s))}:${share(s)}%").MkString(", ")
}

func main() {
    Println(describe(ArrayOf(95, 80, -5, 120)))

    // Recursion: declare the function type with var, then assign the lambda.
    var fact func(int) int
    fact = (n int) => if (n <= 1) 1 else n * fact(n - 1)
    Println(s"5! = ${fact(5)}")

    Println(firstOr(ArrayOf("x", "y"), "none"))
    Println(firstOr(EmptyArray[string](), "none"))
}
-- examples/local_type_constructor.gala --
package main

// A struct type declared inside a function body is constructed with call
// syntax like a top-level one: positionally, with named arguments, with a
// subset of its fields, generically, from a nested lambda, and while it
// shadows a package-level type of the same name.

type Inner struct {
    S string
}

type Label string

func positional() int {
    type Inner struct {
        N int
    }
    val i = Inner(1)
    i.N
}

func namedArgs() int {
    type Pair struct {
        A int
        B int
    }
    val p = Pair(B = 2, A = 1)
    p.A * 10 + p.B
}

func subset() int {
    type Cfg struct {
        A int
        B int
    }
    val c = Cfg(3)
    c.A + c.B
}

func usedEverywhere() string {
    type Point struct {
        X int
        Y int
    }
    val p = Point(1, 2)
    val shift = (n int) => Point(n, n + 1)
    val q = shift(5)
    val moved = p.Copy(X = 9)
    val shown = q match {
        case Point(x, y) => s"$x/$y"
        case _ => "?"
    }
    s"${p.X},${p.Y} ${moved.X} $shown ${p == Point(1, 2)}"
}

func generic() string {
    type Box[T any] struct {
        V T
    }
    val n = Box(42)
    val s = Box("hi")
    s"${n.V} ${s.V}"
}

func shadowsAlias() int {
    type Label struct {
        Len int
    }
    Label(7).Len
}

func main() {
    Println(positional())
    Println(namedArgs())
    Println(subset())
    Println(usedEverywhere())
    Println(generic())
    Println(shadowsAlias())
    // The package-level types are untouched by the local ones.
    Println(Inner("top").S)
    Println(Label("label"))
}
-- examples/lowercase_sealed_variants.gala --
package main

// A sealed variant is a variant whatever the case of its first letter. A
// lowercase variant counts towards exhaustiveness, and a bare zero-field
// lowercase variant in pattern position matches that variant instead of
// binding a fresh variable — the same as a capitalized one.

sealed type frame {
    case lineFrame(Text string)
    case endFrame()
    case idleFrame
}

// Exhaustive without a default: every lowercase variant is covered.
func describe(f frame) string = f match {
    case lineFrame(text) => s"line $text"
    case endFrame() => "end"
    case idleFrame() => "idle"
}

// Bare zero-field variants, with or without parentheses at the declaration.
func describeBare(f frame) string = f match {
    case endFrame => "bare end"
    case idleFrame => "bare idle"
    case lineFrame(text) => s"bare line $text"
}

// A guarded arm and a catch-all binding: `other` names no variant, so it
// still binds the whole value.
func classify(f frame) string = f match {
    case lineFrame(text) if text == "" => "empty line"
    case endFrame => "end"
    case other => s"other $other"
}

// A generic sealed type with lowercase variants, matched with nested bare
// variants of another lowercase sealed type.
sealed type maybe[T any] {
    case just(Value T)
    case nothing
}

func nested(m maybe[frame]) string = m match {
    case just(endFrame) => "just end"
    case just(idleFrame) => "just idle"
    case just(lineFrame(text)) => s"just line $text"
    case nothing => "nothing"
}

// Nested inside a std extractor.
func nestedOption(o Option[frame]) string = o match {
    case Some(endFrame) => "some end"
    case Some(other) => s"some $other"
    case None => "none"
}

func show(f frame) {
    Println(s"${describe(f)} | ${describeBare(f)} | ${classify(f)}")
}

func main() {
    show(lineFrame("x"))
    show(endFrame())
    show(idleFrame())
    show(lineFrame(""))

    Println(nested(just(endFrame())))
    Println(nested(just(idleFrame())))
    Println(nested(just(lineFrame("y"))))
    Println(nested(nothing()))

    Println(nestedOption(Some(endFrame())))
    Println(nestedOption(Some(lineFrame("z"))))
    Println(nestedOption(None()))

    // Generated equality and String for lowercase variants.
    Println(lineFrame("x") == lineFrame("x"))
    Println(lineFrame("x") == lineFrame("y"))
    Println(endFrame().Equal(endFrame()))
}
-- examples/match_any_bare_sealed_case.gala --
package main

// A bare zero-field sealed case, `case Square =>`, matched against a value of
// an interface type (or of a type parameter) tests for that case, exactly as
// `case Square() =>` does and as it does against a value of the sealed type.
// A value of any other type falls through to later arms.
//
// Value is an empty interface, so it holds any value, exactly as Go's `any`
// does; naming it keeps this file in the type-erasure corpus check.

type Value interface {}

sealed type Shape {
    case Circle(R int)
    case Square()
}

sealed type Wrapped {
    case Wrap(Inner Value)
    case Empty()
}

func describe(v Value, loud bool) string = v match {
    case Square if loud => "SQUARE"
    case Square => "square"
    case Circle(r) => s"circle $r"
    case Wrap(Square) => "wrapped square"
    case Wrap(_) => "wrapped other"
    case Empty => "empty"
    case i: int => s"int $i"
    case _ => "other"
}

func describeGeneric[T any](v T) string = v match {
    case Square => "generic square"
    case _ => "generic other"
}

func main() {
    Println(describe(Square(), false))
    Println(describe(Square(), true))
    Println(describe(Circle(2), false))
    Println(describe(Wrap(Square()), false))
    Println(describe(Wrap(Circle(3)), false))
    Println(describe(Empty(), false))
    Println(describe(7, false))
    Println(describe("text", false))
    Println(describeGeneric(Square()))
    Println(describeGeneric(Circle(1)))
    Println(describeGeneric(9))
}
-- examples/match_any_sealed_case.gala --
package main

// A sealed case or a guard extractor matched against a value of an interface
// type (or of a type parameter) first checks that the value holds the type the
// extractor takes. A value of another type falls through to later arms.
//
// Value is an empty interface, so it holds any value, exactly as Go's `any`
// does; naming it keeps this file in the type-erasure corpus check.

type Value interface {}

sealed type Shape {
    case Circle(R int)
    case Square()
}

sealed type Wrapped {
    case Wrap(Inner Value)
    case Empty()
}

struct Pair(L Value, R int)

type Even struct {}

func (_ Even) Unapply(i int) bool = i % 2 == 0

func describe(v Value) string = v match {
    case Circle(r) if r > 10 => s"big circle $r"
    case Circle(r) => s"circle $r"
    case Square() => "square"
    case Wrap(Circle(r)) => s"wrapped circle $r"
    case Wrap(Square()) => "wrapped square"
    case Wrap(_) => "wrapped other"
    case Empty() => "empty"
    case Pair(Circle(r), n) => s"pair circle $r/$n"
    case Even() => "even int"
    case i: int => s"odd int $i"
    case _ => "other"
}

func describeGeneric[T any](v T) string = v match {
    case Circle(r) => s"generic circle $r"
    case _ => "generic other"
}

func main() {
    Println(describe(Circle(2)))
    Println(describe(Circle(20)))
    Println(describe(Square()))
    Println(describe(Wrap(Circle(3))))
    Println(describe(Wrap(Square())))
    Println(describe(Wrap("x")))
    Println(describe(Empty()))
    Println(describe(Pair(Circle(4), 5)))
    Println(describe(Pair("y", 5)))
    Println(describe(8))
    Println(describe(7))
    Println(describe("text"))
    Println(describeGeneric(Circle(6)))
    Println(describeGeneric(9))
}
-- examples/match_any_struct_pattern.gala --
package main

// Verifies that a plain (non-sealed) struct destructuring pattern works when the
// match subject is statically `any`. Mixing a type pattern (`case i: int`) with a
// struct pattern forces the subject to stay `any`; the transpiler must insert a
// type assertion (`v.(Person)`) before reading struct fields, otherwise the
// generated Go fails with "type any has no field or method Name".
struct Person(Name string, Age int)

func describe(v any) string = v match {
    case i: int                        => s"int: $i"
    case Person(name, age) if age < 18 => s"$name is a minor"
    case Person(name, _)               => s"$name is an adult"
    case _                             => "unknown"
}

func main() {
    Println(describe(Person("Bob", 15)))
    Println(describe(Person("Alice", 30)))
    Println(describe(42))
    Println(describe("hello"))
}
-- examples/match_arm_block_local.gala --
package main

import . "martianoff/gala/collection_immutable"

// A block that declares a local and ends in it — a match arm, a branch of
// an arm's trailing if/else, a partial-function arm: the block's value is
// that local, typed in the block's own scope.

sealed type Shape {
    case Circle(R float64)
    case Square(S float64)
}

// Every arm's value is a block local, and nothing else types the match.
func label(n int) {
    val text = n match {
        case x => {
            val tag = s"item-$x"
            tag
        }
    }
    Println(text.Size(), text)
}

// The local is accumulated by a loop before it is read.
func sumTo(n int) int = n match {
    case 0 => 0
    case x => {
        var acc = 0
        for i := 1; i <= x; i++ {
            acc = acc + i
        }
        acc
    }
}

// The default arm reads its own local.
func describe(s Shape) string = s match {
    case Circle(r) => f"circle $r%.1f"
    case _ => {
        val kind = "other"
        kind
    }
}

// A local read inside the arm's trailing if/else.
func sign(n int) {
    val word = n match {
        case x => {
            val neg = "negative"
            if (x < 0) neg else "non-negative"
        }
    }
    Println(word.Size(), word)
}

// Each branch of the arm's trailing if/else reads a local of its own.
func size(n int) {
    val word = n match {
        case x => {
            if (x > 9) {
                val big = s"big-$x"
                big
            } else {
                val small = "small"
                small
            }
        }
    }
    Println(word.Size(), word)
}

// A partial-function arm reads its own local.
func labels(xs Array[int]) Array[string] = xs.Collect({
    case x if x > 1 => {
        val tag = s"n$x"
        tag
    }
})

func main() {
    label(7)
    Println(sumTo(4))
    Println(describe(Square(2.0)), describe(Circle(1.5)))
    sign(-3)
    size(12)
    Println(labels(ArrayOf(1, 2, 3)).MkString(","))
}
-- examples/match_arm_loop_control.gala --
package main

import . "martianoff/gala/collection_immutable"

// `break` and `continue` in an arm of a match used as a statement control the
// enclosing `for` loop, in every loop form and through nested matches.

sealed type Cmd {
    case Skip()
    case Stop()
    case Say(Text string)
}

func forClause() {
    for i := 0; i < 6; i++ {
        i match {
            case 1 => continue
            case 4 => { break }
            case _ => Println(s"for-clause $i")
        }
        Println(s"after $i")
    }
}

func condition() {
    var n = 0
    for n < 10 {
        n++
        (n % 3) match {
            case 0 => {
                Println(s"skip $n")
                continue
            }
            case _ => Println(s"keep $n")
        }
        if n > 6 {
            break
        }
    }
}

func rangeLoop(cmds Array[Cmd]) {
    for _, c := range cmds.ToGoSlice() {
        c match {
            case Skip() => continue
            case Stop() => break
            case Say(t) => Println(s"say $t")
        }
        Println("next")
    }
}

func nested() {
    for i := 0; i < 3; i++ {
        for j := 0; j < 3; j++ {
            (i, j) match {
                case (_, 1) => continue
                case (2, _) => break
                case (a, b) => {
                    a match {
                        case 1 => { if b == 2 { break } }
                        case _ => Println(s"pair $a $b")
                    }
                }
            }
            Println(s"inner $i $j")
        }
    }
}

// A bare `return` in an arm leaves the function, not just the match.
func scanUntilNegative(xs Array[int]) {
    for _, x := range xs.ToGoSlice() {
        (x < 0) match {
            case true => { return }
            case _ => Println(s"scan $x")
        }
    }
    Println("no negative")
}

// A loop inside an arm of a match whose value is used keeps its own `break`.
func innerLoop() int {
    var total = 0
    for i := 0; i < 3; i++ {
        val v = i match {
            case 1 => {
                for k := 0; k < 10; k++ {
                    if k == 3 { break }
                    total += k
                }
                100
            }
            case n => n
        }
        total += v
    }
    total
}

func main() {
    forClause()
    condition()
    rangeLoop(ArrayOf[Cmd](Say("a"), Skip(), Say("b"), Stop(), Say("c")))
    nested()
    scanUntilNegative(ArrayOf(1, 2, -3, 4))
    Println(s"inner loop total ${innerLoop()}")
}
-- examples/match_arm_panic.gala --
package main

import "fmt"
import . "martianoff/gala/go_builtins"

func roleFromName(name string) Option[string] {
    return name match {
        case "admin" => Some("Administrator")
        case "user"  => Some("Regular User")
        case _       => None[string]()
    }
}

// Simple-statement panic arm: `case None() => panic(...)`.
// Pre-fix this emitted invalid `return panic(...)` Go.
func resolveRole(name string) string {
    return roleFromName(name) match {
        case Some(r) => r
        case None()  => Panic(s"unknown role '$name'")
    }
}

// Default-case panic arm: `case _ => panic(...)`. The default branch
// also went through the buggy `return <expr>` lowering before the fix.
func describeCode(code int) string {
    return code match {
        case 0 => "ok"
        case 1 => "warn"
        case _ => Panic(s"invalid code $code")
    }
}

// Block-body panic arm with a side-effect statement before the panic.
// Exercises the multi-statement block lowering path.
func mustParseRole(name string) string {
    return roleFromName(name) match {
        case Some(r) => r
        case None() => {
            Println(s"role lookup failed for '$name'")
            Panic(s"missing role '$name'")
        }
    }
}

func main() {
    fmt.Println(resolveRole("admin"))
    fmt.Println(resolveRole("user"))
    fmt.Println(describeCode(0))
    fmt.Println(describeCode(1))
    fmt.Println(mustParseRole("user"))
}
-- examples/match_block_branch.gala --
package main

import . "martianoff/gala/std"

// Test match with block branch that computes a value
func process(opt Option[int]) string {
    return opt match {
        case Some(n) => {
            val doubled = n * 2
            return s"doubled: $doubled"
        }
        case None() => "nothing"
    }
}

// Test match with block branch in default/wildcard case
func classify(n int) string {
    return n match {
        case 0 => "zero"
        case 1 => "one"
        case _ => {
            val label = s"other: $n"
            return label
        }
    }
}

func main() {
    Println(process(Some(21)))
    Println(process(None[int]()))
    Println(classify(0))
    Println(classify(1))
    Println(classify(42))
}
-- examples/match_chained_call_generic.gala --
// Regression test for a struct field that shares its name with the generic
// type it holds. Idiomatic Go does this routinely (e.g., http.Response.Header
// is of type http.Header). The transpiler used to corrupt the receiver type
// during struct-shorthand transformation: when the same value-scope entry that
// records the field name shadowed the type identifier, the second pass over
// the parameter list re-resolved the type through the polluted scope and
// emitted a doubled generic (`Palette[T][T]`) into structFieldTypes. The
// match-as-IIFE on `m.Palette.Current()` then collapsed to `Option[any]` and
// `action.Msg` became inaccessible.
//
// Expected behavior: the IIFE preserves `Option[PaletteAction[MegaMsg]]`,
// `action.Msg` resolves to `MegaMsg`, and the program prints `got: ok`.
package main

import . "martianoff/gala/collection_immutable"

struct PaletteAction[T any](Msg T)

struct Palette[T any](Actions Array[PaletteAction[T]])

func (p Palette[T]) Current() Option[PaletteAction[T]] {
    if p.Actions.IsEmpty() { return None[PaletteAction[T]]() }
    return Some[PaletteAction[T]](p.Actions.Get(0))
}

sealed type MegaMsg {
    case MQuit()
    case MAction(Name string)
}

// Field name (`Palette`) intentionally collides with the generic type name.
struct MegaModel(Palette Palette[MegaMsg])

func confirmPalette(m MegaModel) MegaMsg {
    return m.Palette.Current() match {
        case Some(action) => action.Msg
        case None()       => MQuit()
    }
}

func main() {
    val pal = Palette[MegaMsg](
        Actions = ArrayOf(PaletteAction[MegaMsg](Msg = MAction(Name = "ok"))),
    )
    val m = MegaModel(Palette = pal)
    val res = confirmPalette(m)
    res match {
        case MAction(n) => Println(s"got: $n")
        case MQuit()    => Println("quit")
    }
}
-- examples/match_extractors.gala --
package main

import "fmt"

type Even struct {}
func (e Even) Unapply(i int) Option[int] = if (i % 2 == 0) Some(i) else None[int]()

func main() {
    val number = 42

    val description = number match {
        case Even(n) => fmt.Sprintf("%d is an even number", n)
        case _       => fmt.Sprintf("%d is odd", number)
    }

    fmt.Println(description)

    // Nested patterns
    val opt = Some(10)
    val optOdd = Some(11)
    val res = opt match {
        case Some(Even(n)) => fmt.Sprintf("Found some even number %d", n)
        case Some(n)       => fmt.Sprintf("Found some odd number %d", n)
        case None()        => "Nothing found"
        case _             => "Other"
    }
    fmt.Println(res)

    val res2 = optOdd match {
        case Some(Even(n)) => fmt.Sprintf("Found some even number %d", n)
        case Some(n)       => fmt.Sprintf("Found some odd number %d", n)
        case None()        => "Nothing found"
        case _             => "Other"
    }
    fmt.Println(res2)
}
-- examples/match_generic_inference.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Minimal repro: using std Option extractor inside a generic function
func mapOption[T any, U any](o Option[T], f func(T) U) Option[U] {
    return o match {
        case Some(v) => Some[U](f(v))
        case _ => None[U]()
    }
}

func main() {
    val o1 = Some[int](10)
    val o2 = mapOption[int, string](o1, (x int) => fmt.Sprintf("num=%d", x))
    fmt.Printf("mapOption: %s\n", o2.Get())
}
-- examples/match_generic_return_dispatch.gala --
package main

import "fmt"

sealed type Event {
    case Press(Key string)
    case Release
}

// Generic dispatcher: every branch returns T (the function's type parameter).
// Regression: previously the match-as-IIFE collapsed the result
// type to `any`, so the Go compiler rejected the IIFE result with
// "cannot use ... (value of type any) as T value in return statement".
// Fix: when every branch is typed as a type parameter and the enclosing
// function declares a matching return type, the IIFE adopts that type.
func dispatch[T any](e Event, fn func(string) T) T {
    return e match {
        case Press(k)  => fn(k)
        case Release() => fn("none")
    }
}

func main() {
    val e1 = Press("ctrl+a")
    val e2 = Release()
    fmt.Println(dispatch[string](e1, (s string) => "key=" + s))
    fmt.Println(dispatch[string](e2, (s string) => "key=" + s))
    fmt.Println(dispatch[int](e1, (s string) => 42))
}
-- examples/match_go_constant.gala --
package main

import "runtime"

func main() {
    val compiler = runtime.Compiler
    val label = compiler match {
        case "gc" => "standard"
        case "gccgo" => "gcc-based"
        case _ => "other"
    }
    Println(label)
}
-- examples/match_interface_return.gala --
package main

import "fmt"

// Test case: match expression returning interface type (error)
// All branches return types that implement the same interface,
// so the result type should be the interface type.

struct CustomError(Message string)

func (e CustomError) Error() string = e.Message

struct AnotherError(Code int)

func (e AnotherError) Error() string = fmt.Sprintf("error code: %d", e.Code)

// This function should work - all branches return error interface
func toError(value any) error {
    return value match {
        case e: error => e
        case s: string => CustomError(Message = s)
        case i: int => AnotherError(Code = i)
        case _ => CustomError(Message = "unknown")
    }
}

func main() {
    val err1 = toError(CustomError(Message = "original error"))
    fmt.Println("err1:", err1.Error())

    val err2 = toError("string message")
    fmt.Println("err2:", err2.Error())

    val err3 = toError(42)
    fmt.Println("err3:", err3.Error())

    val err4 = toError(true)
    fmt.Println("err4:", err4.Error())
}
-- examples/match_lambda_arg/main.gala --
package main

import . "martianoff/gala/collection_immutable"

// Match on method call chain with lambda argument.
// Verifies that lambda arguments parse correctly when followed by a match expression.

func findConfig(items Array[Config], key string) string =
    items.Find((item) => item.key == key) match {
        case Some(cfg) => cfg.value
        case None() => "not found"
    }

func findAndTransform(items Array[Config], key string) string =
    items.Find((item) => item.key == key) match {
        case Some(cfg) => s"found: ${cfg.value}"
        case None() => "missing"
    }

func main() {
    val configs = ArrayOf(
        Config("host", "localhost"),
        Config("port", "8080"),
        Config("mode", "debug")
    )

    Println(findConfig(configs, "host"))
    Println(findConfig(configs, "port"))
    Println(findConfig(configs, "unknown"))
    Println(findAndTransform(configs, "mode"))
    Println(findAndTransform(configs, "missing"))
}
