package main

import (
    "fmt"
    "unicode"
    . "martianoff/gala/std"
    . "martianoff/gala/strings"
)

// Test examples from STRINGS.MD

// Quick Start (line 24-30)
func testQuickStart() {
    val s = S("Hello, World!")
    fmt.Printf("Original: %s\n", s.ToString())

    val result = s.Trim().ToLower().ReplaceAll(",", "").ReplaceAll("!", "")
    fmt.Printf("Cleaned: %s\n", result.ToString())
}

// Basic Operations (line 55-59)
func testBasicOps() {
    val s = S("Hello")
    fmt.Printf("Length=%d\n", s.Length())
    fmt.Printf("IsEmpty=%v\n", s.IsEmpty())
    fmt.Printf("NonEmpty=%v\n", s.NonEmpty())
}

// Slicing (line 65-69)
func testSlicing() {
    val s = S("Hello, World!")
    fmt.Printf("Take(5)=%s\n", s.Take(5).ToString())
    fmt.Printf("Drop(7)=%s\n", s.Drop(7).ToString())
    fmt.Printf("TakeRight(6)=%s\n", s.TakeRight(6).ToString())
}

// Case Transformations (line 75-78)
func testCaseTransform() {
    val s = S("hello world")
    fmt.Printf("ToUpper=%s\n", s.ToUpper().ToString())
    fmt.Printf("Capitalize=%s\n", s.Capitalize().ToString())
}

// Trimming (line 84-88)
func testTrimming() {
    val s = S("  hello  ")
    fmt.Printf("Trim='%s'\n", s.Trim().ToString())
    fmt.Printf("TrimLeft='%s'\n", s.TrimLeft().ToString())
    fmt.Printf("TrimRight='%s'\n", s.TrimRight().ToString())
}

// Replacement (line 94-95)
func testReplacement() {
    val s = S("hello world world")
    fmt.Printf("Replace=%s\n", s.Replace("world", "GALA").ToString())
    fmt.Printf("ReplaceAll=%s\n", s.ReplaceAll("world", "GALA").ToString())
}

// Functional Operations (line 161-169)
func testFunctionalOps() {
    // Map
    val shifted = S("abc").Map((r rune) => r + 1)
    fmt.Printf("Map shift=%s\n", shifted.ToString())

    // Filter - keep only lowercase letters (using unicode.IsLower returns bool)
    val isLower func(rune) bool = unicode.IsLower
    val filtered = S("Hello123").Filter(isLower)
    fmt.Printf("Filter=%s\n", filtered.ToString())

    // Fold
    val count = S("hello").Fold[int](0, (acc int, r rune) => acc + 1)
    fmt.Printf("Fold count=%d\n", count)
}

// Predicates (line 225-231)
func testPredicates() {
    fmt.Printf("IsAlpha=%v\n", S("hello").IsAlpha())
    fmt.Printf("IsNumeric=%v\n", S("12345").IsNumeric())
    fmt.Printf("IsAlphanumeric=%v\n", S("hello123").IsAlphanumeric())
}

// Search (line 143-146)
func testSearch() {
    val s = S("hello world")
    fmt.Printf("Contains=%v\n", s.Contains("world"))
    fmt.Printf("StartsWith=%v\n", s.StartsWith("hello"))
    fmt.Printf("EndsWith=%v\n", s.EndsWith("world"))
}

// Comparison (line 151-153)
func testComparison() {
    val s1 = S("hello")
    val s2 = S("HELLO")
    fmt.Printf("Equals=%v\n", s1.Equals(s2))
    fmt.Printf("EqualsIgnoreCase=%v\n", s1.EqualsIgnoreCase(s2))
}

// Pattern Matching (line 237-249)
func describe(s Str) string = s match {
    case EmptyStr() => "empty"
    case NonEmptyStr(head, tail) => {
        if (tail.IsEmpty()) {
            return "single character"
        }
        return fmt.Sprintf("starts with %c, rest: %s", head, tail.ToString())
    }
    case _ => "other"
}

func testPatternMatch() {
    fmt.Printf("Pattern match: %s\n", describe(S("hello")))
}

func main() {
    testQuickStart()
    testBasicOps()
    testSlicing()
    testCaseTransform()
    testTrimming()
    testReplacement()
    testFunctionalOps()
    testPredicates()
    testSearch()
    testComparison()
    testPatternMatch()
}
-- examples/doc_verify/time_utils_md.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    . "martianoff/gala/time_utils"
)

// Test examples from TIME_UTILS.MD

// Creating Durations (line 18-28)
func testCreatingDurations() {
    val ns = Nanoseconds(1000)
    val us = Microseconds(500)
    val ms = Milliseconds(100)
    val sec = Seconds(30)
    val min = Minutes(5)
    val hr = Hours(2)

    fmt.Printf("Nanoseconds(1000).ToNanos()=%d\n", ns.ToNanos())
    fmt.Printf("Microseconds(500).ToMicros()=%d\n", us.ToMicros())
    fmt.Printf("Milliseconds(100).ToMillis()=%d\n", ms.ToMillis())
    fmt.Printf("Seconds(30).ToSeconds()=%d\n", sec.ToSeconds())
    fmt.Printf("Minutes(5).ToMinutes()=%d\n", min.ToMinutes())
    fmt.Printf("Hours(2).ToHours()=%d\n", hr.ToHours())
}

// Duration Operations (line 40-60)
func testDurationOperations() {
    val d1 = Seconds(30)
    val d2 = Seconds(15)

    val sum = d1.Plus(d2)
    fmt.Printf("Plus=%d seconds\n", sum.ToSeconds())

    val diff = d1.Minus(d2)
    fmt.Printf("Minus=%d seconds\n", diff.ToSeconds())

    val doubled = d1.Multiply(2)
    fmt.Printf("Multiply(2)=%d seconds\n", doubled.ToSeconds())

    val halved = d1.Divide(2)
    fmt.Printf("Divide(2)=%d seconds\n", halved.ToSeconds())

    val neg = d1.Negate()
    fmt.Printf("Negate=%d seconds\n", neg.ToSeconds())

    fmt.Printf("IsZero=%v\n", d1.IsZero())
    fmt.Printf("IsPositive=%v\n", d1.IsPositive())
}

// Duration Conversions (line 66-78)
func testDurationConversions() {
    val d = Hours(2).Plus(Minutes(30))

    fmt.Printf("ToSeconds=%d\n", d.ToSeconds())
    fmt.Printf("ToMinutes=%d\n", d.ToMinutes())
    fmt.Printf("ToHours=%d\n", d.ToHours())
    fmt.Printf("String=%s\n", d.String())
}

// Creating Instants (line 88-99)
func testCreatingInstants() {
    val epoch = UnixEpoch()
    fmt.Printf("UnixEpoch.UnixSeconds=%d\n", epoch.UnixSeconds())

    val fromSecs = FromUnixSeconds(1704067200)
    fmt.Printf("FromUnixSeconds(1704067200).Year=%d\n", fromSecs.Year())
}

// Instant Operations (line 111-135)
func testInstantOperations() {
    val i1 = FromUnixSeconds(1000)
    val i2 = FromUnixSeconds(2000)

    val later = i1.Plus(Hours(1))
    fmt.Printf("Plus(1h).UnixSeconds=%d\n", later.UnixSeconds())

    val until = i1.Until(i2)
    fmt.Printf("Until=%d seconds\n", until.ToSeconds())

    fmt.Printf("IsBefore=%v\n", i1.IsBefore(i2))
    fmt.Printf("IsAfter=%v\n", i1.IsAfter(i2))

    val minInst = i1.Min(i2)
    fmt.Printf("Min.UnixSeconds=%d\n", minInst.UnixSeconds())

    val maxInst = i1.Max(i2)
    fmt.Printf("Max.UnixSeconds=%d\n", maxInst.UnixSeconds())
}

// Instant Accessors (line 140-160)
func testInstantAccessors() {
    val i = FromUnixSeconds(1718444445) // 2024-06-15 10:00:45 UTC approx
    fmt.Printf("Year=%d\n", i.Year())
    fmt.Printf("Month=%d\n", i.Month())
    fmt.Printf("Day=%d\n", i.Day())
}

// Pattern Matching (line 216-226)
func testPatternMatch() {
    val i = FromUnixSeconds(1718444445)

    i match {
        case InstantComponents(year, month, day, hour, minute, second) =>
            fmt.Printf("InstantComponents: %d-%02d-%02d %02d:%02d:%02d\n", year, month, day, hour, minute, second)
        case _ => fmt.Println("Unknown")
    }

    i match {
        case DateOnly(year, month, day) =>
            fmt.Printf("DateOnly: %d-%02d-%02d\n", year, month, day)
        case _ => fmt.Println("Unknown")
    }

    i match {
        case TimeOnly(hour, minute, second) =>
            fmt.Printf("TimeOnly: %02d:%02d:%02d\n", hour, minute, second)
        case _ => fmt.Println("Unknown")
    }
}

func main() {
    testCreatingDurations()
    testDurationOperations()
    testDurationConversions()
    testCreatingInstants()
    testInstantOperations()
    testInstantAccessors()
    testPatternMatch()
}
-- examples/either.gala --
package main

import "fmt"

func main() {
    val e1 = Left[int, string](10)
    val e2 = Right[int, string]("world")

    val res3 = e1 match {
        case Left(n)  => fmt.Sprintf("Left value: %d", n)
        case Right(s) => fmt.Sprintf("Right value: %s", s)
        case _        => "Unknown"
    }
    fmt.Println(res3)

    val res4 = e2 match {
        case Left(n)  => fmt.Sprintf("Left value: %d", n)
        case Right(s) => fmt.Sprintf("Right value: %s", s)
        case _        => "Unknown"
    }
    fmt.Println(res4)

    val mapped = e1.Map[int]((s string) => s.Size())
    fmt.Printf("Mapped e1: %v\n", mapped)

    val mapped2 = e2.Map[int]((s string) => s.Size())
    fmt.Printf("Mapped e2 length: %v\n", mapped2.GetRight())
}
-- examples/either_map_flatmap.gala --
package main

import "fmt"

func main() {
    // Map on Right applies the function
    val r1 = Right[string, int](10)
    val mapped1 = r1.Map((x int) => x * 2)
    fmt.Println(mapped1.GetRight())

    // Map on Left passes through
    val l1 = Left[string, int]("error")
    val mapped2 = l1.Map((x int) => x * 2)
    fmt.Println(mapped2.GetLeft())

    // FlatMap on Right applies the function
    val r2 = Right[string, int](5)
    val flatMapped1 = r2.FlatMap((x int) => Right[string, int](x + 100))
    fmt.Println(flatMapped1.GetRight())

    // FlatMap on Right returning Left
    val r3 = Right[string, int](0)
    val flatMapped2 = r3.FlatMap((x int) => Left[string, int]("was zero"))
    fmt.Println(flatMapped2.GetLeft())

    // FlatMap on Left passes through
    val l2 = Left[string, int]("original error")
    val flatMapped3 = l2.FlatMap((x int) => Right[string, int](x + 100))
    fmt.Println(flatMapped3.GetLeft())

    // Chaining Map and FlatMap
    val result = Right[string, int](3).Map((x int) => x * 10).FlatMap((x int) => Right[string, int](x + 1))
    fmt.Println(result.GetRight())
}
-- examples/either_match_in_lambda.gala --
package main

import "fmt"
import . "martianoff/gala/concurrent"

func main() {
    // Either match works in regular function (known working)
    val e1 = Right[string, string]("hello")
    val r1 = e1 match {
        case Right(s) => s
        case Left(err) => err
        case _ => "unknown"
    }
    fmt.Println(r1)

    // Either match inside Future(...) lambda (BUG-WP-1)
    val future = Future[string](() => {
        val result Either[string, string] = Right[string, string]("ok")
        return result match {
            case Right(output) => output
            case Left(err) => err
            case _ => "unknown"
        }
    })
    fmt.Println(future.Get())
}
-- examples/equality_value_semantics.gala --
package main

import (
    "math"

    . "martianoff/gala/collection_immutable"
)

// `a == b` is `a.Equal(b)` and `a != b` is `!a.Equal(b)`: values compare by
// value, however each was built. Pointers, interfaces and type parameters
// keep Go's ==.

struct Route(name string, stops List[string])

struct Node(v int, next *Node)

struct Reading(v float64)

sealed type Event {
    case Moved(path List[int])
    case Stopped(at int)
}

// Cell compares its value modulo 10. == uses this Equal; inside it, == on
// Cell would call it again, so there == is Go's.
struct Cell(v int)

func (c Cell) Equal(o Cell) bool = c.v % 10 == o.v % 10

// Tag declares an Equal that uses == on Tag itself: Go's ==, not a call of
// the method being defined.
struct Tag(name string)

func (t Tag) Equal(o Tag) bool = t == o

val Home = ListOf("home")

func where(stops List[string]) string = stops match {
    case Home => "home"
    case _    => "away"
}

func main() {
    // Collections built separately, in different orders.
    Println("List:", ListOf(1, 2, 3) == ListOf(3).Prepend(2).Prepend(1), ListOf(1) != ListOf(2))
    Println("Array:", ArrayOf(1, 2, 3) == ArrayOf(1).Append(2).Append(3), ArrayOf(2, 3).Prepend(1) == ArrayOf(1, 2, 3))
    Println("HashSet:", HashSetOf(1, 2, 3) == HashSetOf(3, 2, 1), HashSetOf(1) != HashSetOf(1, 2))
    Println("HashMap:", HashMapOf((1, "a"), (2, "b")) == HashMapOf((2, "b"), (1, "a")), HashMapOf((1, "a"), (2, "b")).Remove(2) == HashMapOf((1, "a")))
    Println("TreeSet:", TreeSetOf(1, 2, 3, 4, 5) == TreeSetOf(5, 4, 3, 2, 1), TreeSetOf(1, 2, 3).Remove(3) == TreeSetOf(1, 2))
    Println("TreeMap:", TreeMapOf((1, "a"), (2, "b"), (3, "c")) == TreeMapOf((3, "c"), (2, "b"), (1, "a")))

    // Values that hold collections or pointers.
    Println("struct:", Route("r", ListOf("a", "b")) == Route("r", ListOf("b").Prepend("a")), Route("r", ListOf("a")) != Route("r", ListOf("b")))
    var n1 = Node(2, nil)
    var n2 = Node(2, nil)
    Println("pointer field:", Node(1, &n1) == Node(1, &n2), &n1 == &n2)
    Println("sealed:", Moved(ListOf(1, 2)) == Moved(ListOf(1, 2)), Moved(ListOf(1)) == Stopped(1))
    Println("Option:", Some(ListOf(1)) == Some(ListOf(1)), Some(ListOf(1)) != None[List[int]]())
    Println("tuple:", (1, ListOf("x")) == (1, ListOf("x")))

    // A type's own Equal, and == inside it.
    Println("own Equal:", Cell(1) == Cell(11), Cell(1) != Cell(2), Tag("a") == Tag("a"))

    // A stable identifier compares the same way.
    Println("match:", where(ListOf("home")), where(ListOf("work")))

    // A NaN equals nothing, through Go's == and through Equal alike.
    Println("NaN:", Reading(math.NaN()) == Reading(math.NaN()), ListOf(math.NaN()) == ListOf(math.NaN()))
}
-- examples/execution_context.gala --
package main

import (
    "fmt"
    "time"
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/collection_immutable"
)

func main() {
    fmt.Println("=== ExecutionContext Examples ===")

    // Example 1: Default EC (uses GlobalEC, which is UnboundedExecutionContext)
    fmt.Println("\n--- Default ExecutionContext ---")
    val f1 = Future[int](() => 42)
    fmt.Println("Default EC result:", f1.Await().Get())

    // Example 2: Custom FixedPoolExecutionContext
    fmt.Println("\n--- FixedPool ExecutionContext ---")
    val pool = NewFixedPoolEC(4)

    val f2 = FutureOn[int](() => 50 * 2, pool)
    fmt.Println("Pool EC result:", f2.Await().Get())

    // Example 3: EC inheritance through Map/FlatMap chain
    fmt.Println("\n--- EC Inheritance Through Chain ---")
    val f3 = FutureOf[int](10, pool)
        .Map[int]((x int) => x * 2)
        .Map[int]((x int) => x + 5)
        .Filter((x int) => x > 10)
    fmt.Println("Chain result:", f3.Await().Get())

    // Example 4: Multiple concurrent computations on pool
    fmt.Println("\n--- Concurrent Computations on Pool ---")
    val futures = ArrayOf[Future[int]](
        FutureOn[int](() => 0 * 0, pool),
        FutureOn[int](() => 1 * 1, pool),
        FutureOn[int](() => 2 * 2, pool),
        FutureOn[int](() => 3 * 3, pool),
        FutureOn[int](() => 4 * 4, pool)
    )
    val results = Sequence[int](futures).Await().Get()
    fmt.Println("Concurrent results count:", results.Size())

    // Example 5: SingleThreadExecutionContext for sequential execution
    fmt.Println("\n--- SingleThread ExecutionContext ---")
    val singleEC = NewSingleThreadEC()

    val seqFutures = ArrayOf[Future[int]](
        FutureOn[int](() => 0, singleEC),
        FutureOn[int](() => 1, singleEC),
        FutureOn[int](() => 2, singleEC)
    )
    val order = Sequence[int](seqFutures).Await().Get()
    fmt.Println("Sequential order:", order.ToGoSlice())

    // Example 6: Error handling with custom EC
    fmt.Println("\n--- Error Handling with Custom EC ---")
    val f4 = FutureFailed[int](FutureError(Message = "computation error"), pool)
    val recovered = f4.Recover((e error) => -1)
    fmt.Println("Recovered result:", recovered.Await().Get())

    // Example 7: Promise with custom EC
    fmt.Println("\n--- Promise with Custom EC ---")
    val promise = NewPromise[string](pool)
    val future = promise.Future()

    // Complete promise asynchronously
    Spawn(() => {
        time.Sleep(10 * time.Millisecond)
        promise.Success("completed via promise")
    })

    fmt.Println("Promise result:", future.Await().Get())

    // Cleanup: shutdown pools
    fmt.Println("\n--- Cleanup ---")
    pool.Shutdown()
    singleEC.Shutdown()
    fmt.Println("Pools shut down gracefully")
}
-- examples/expr_as_thunk_sugar.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    "strconv"
)

// By-name / thunk sugar: when a parameter's expected type is a zero-arg
// function type `func() T`, a bare expression argument is automatically lifted
// into `() => expr`. So `f(expr)` means `f(() => expr)` wherever `f` expects a
// thunk. The expression is evaluated lazily — each time the thunk is invoked —
// exactly as if the caller had written the lambda by hand.

func double(n int) int = n * 2

// A plain (non-generic) function whose parameter is a zero-arg function.
// `runTwice(double(21))` desugars to `runTwice(() => double(21))`, so the body
// is evaluated on every call: 42 + 42 = 84.
func runTwice(body func() int) int = body() + body()

// riskyDivide panics on division by zero; Try turns that panic into a Failure.
func riskyDivide(a int, b int) int = a / b

func main() {
    // Bare expression lifted into a thunk for a non-generic function param.
    Println(runTwice(double(21)))

    // The headline case: a companion Apply whose parameter is `func() T`.
    // `Future(double(50))` means `Future(() => double(50))`, and T is inferred
    // to int from the lifted thunk's result type.
    Println(Future(double(50)).Get())

    // Try with the sugar — no explicit `() =>` needed. The expression runs
    // lazily inside Try, so a panic is caught as a Failure.
    Println(Try(riskyDivide(10, 2)).GetOrElse(-1)) // 5
    Println(Try(riskyDivide(10, 0)).GetOrElse(-1)) // -1 (panic caught)

    // Try over a Go `(T, error)` call: the error is converted to a panic and
    // caught, just as with the explicit `Try(() => strconv.Atoi(...))` form.
    Println(Try(strconv.Atoi("42")).GetOrElse(-1))  // 42
    Println(Try(strconv.Atoi("abc")).GetOrElse(-1)) // -1 (parse error caught)
}
-- examples/expr_body_multiline_lambda.gala --
package main

import "fmt"

// This file reproduces the bug where expression-bodied functions
// don't work with multi-line lambda bodies.

// Simple case - works fine (single line lambda)
func simpleExprBody() int = fold(0, (acc int, x int) => acc + x)

// Bug case - expression-bodied function with multi-line lambda body
func bugExprBody() int = fold(0, (acc int, x int) => {
    val result = acc + x
    return result
})

// Helper function
func fold(initial int, f func(int, int) int) int {
    var acc = initial
    acc = f(acc, 1)
    acc = f(acc, 2)
    acc = f(acc, 3)
    return acc
}

func main() {
    fmt.Println("Simple:", simpleExprBody())
    fmt.Println("Bug case:", bugExprBody())
}
-- examples/extractor_type_inference.gala --
package main

import (
    "fmt"
    . "martianoff/gala/concurrent"
)

// Simple wrapper type with a pointer
type Wrapper[T any] struct {
    var value T
}

func NewWrapper[T any](v T) *Wrapper[T] {
    return &Wrapper[T](value = v)
}

// Extractor for Wrapper - takes pointer type
type Unwrap[T any] struct {}

func (u Unwrap[T]) Unapply(w *Wrapper[T]) Option[T] {
    if w == nil {
        return None[T]()
    }
    return Some[T](w.value)
}

func main() {
    fmt.Println("=== Custom Wrapper Extractor ===")

    val w = NewWrapper[int](42)

    // Test 1: Explicit type parameter
    val msg1 = w match {
        case Unwrap[int](v) => fmt.Sprintf("Explicit: Got %d", v)
        case _ => "No match"
    }
    fmt.Println(msg1)

    // Test 2: Inferred type parameter - T inferred from w's type *Wrapper[int]
    val msg2 = w match {
        case Unwrap(v) => fmt.Sprintf("Inferred: Got %d", v)
        case _ => "No match"
    }
    fmt.Println(msg2)

    // Test with string type
    val ws = NewWrapper[string]("hello")

    // Test 3: Inferred string type
    val msg3 = ws match {
        case Unwrap(s) => fmt.Sprintf("Inferred string: %s", s)
        case _ => "No match"
    }
    fmt.Println(msg3)

    fmt.Println("\n=== Future Extractors ===")

    // Test 4: Future with explicit type parameter
    val f1 = FutureOf[int](100)
    val msg4 = f1 match {
        case Succeeded[int](v) => fmt.Sprintf("Explicit Succeeded: %d", v)
        case Failed[int](e) => fmt.Sprintf("Failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(msg4)

    // Test 5: Future with inferred type parameter - T inferred from f2's type Future[int]
    val f2 = FutureOf[int](200)
    val msg5 = f2 match {
        case Succeeded(v) => fmt.Sprintf("Inferred Succeeded: %d", v)
        case Failed(e) => fmt.Sprintf("Failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(msg5)

    // Test 6: Failed future with inferred type
    val f3 = FutureFailed[int](FutureError(Message = "test error"))
    val msg6 = f3 match {
        case Succeeded(v) => fmt.Sprintf("Succeeded: %d", v)
        case Failed(e) => fmt.Sprintf("Inferred Failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(msg6)

    // Test 7: Future[string] with inferred type
    val f4 = FutureOf[string]("world")
    val msg7 = f4 match {
        case Succeeded(s) => fmt.Sprintf("Inferred string Future: %s", s)
        case _ => "Unknown"
    }
    fmt.Println(msg7)

    // Test 8: Completed extractor with inferred type
    val f5 = FutureOf[int](300)
    val msg8 = f5 match {
        case Completed(Success(v)) => fmt.Sprintf("Inferred Completed Success: %d", v)
        case Completed(Failure(e)) => fmt.Sprintf("Completed Failure: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(msg8)
}
-- examples/field_named_like_type/lib/lib.gala --
package lib

// Library-side declarations whose fields and parameters share their names
// with the types they carry.

// Kind is the badge category.
sealed type Kind {
    case Primary()
    case Secondary()
}

// Badge carries an optional Kind in a field that is itself named Kind.
struct Badge(Label string, Kind Option[Kind])

// KindName renders a Kind as lower-case text.
func KindName(k Kind) string = k match {
    case Primary() => "primary"
    case Secondary() => "secondary"
}

// NewBadge builds a Badge from parameters named like its fields' types.
func NewBadge(Label string, Kind Option[Kind]) Badge = Badge(Label = Label, Kind = Kind)

// Describe renders the badge as `label:kind`, or `label:-` without a kind.
func (b Badge) Describe() string = s"${b.Label}:${b.Kind.Map(KindName).GetOrElse(\"-\")}"
-- examples/field_named_like_type/main.gala --
package main

import . "martianoff/gala/collection_immutable"
import "martianoff/gala/examples/field_named_like_type/lib"

// A binding (struct field, parameter, local, pattern bind) that shares its
// name with a type must not shadow that type in type position.

sealed type Align {
    case AlignLeft()
    case AlignRight()
}

struct Style(Bold bool)

struct Box[T any](Item T)

// Fields named like types from another package.
struct Row(Badge lib.Badge, Kind Option[lib.Kind])

// Field named like the type argument of std's Option.
struct Spec(Name string, Align Option[Align])

// Field named like the type argument of collection types and a user generic.
struct Layout(Align Array[Align], Style List[Style], Box Box[Box[int]])

// Field named like its own plain type.
struct Theme(Style Style, Align Align)

// Sealed-variant field named like its type argument.
sealed type Cell {
    case Text(Align Option[Align], Body string)
    case Empty()
}

// Parameters named like their type argument / their type.
func describe(Align Option[Align], Style Style) string =
    s"${Align.IsDefined()} ${Style.Bold}"

func alignName(a Align) string = a match {
    case AlignLeft() => "left"
    case AlignRight() => "right"
}

// Method parameter named like its type argument.
func (sp Spec) With(Align Option[Align]) Spec = sp.Copy(Align = Align)

func (sp Spec) Describe() string = sp.Align match {
    case Some(a) => s"${sp.Name}:${alignName(a)}"
    case None() => s"${sp.Name}:none"
}

func cellText(c Cell) string = c match {
    case Text(Align, body) => s"${body}/${Align.Map(alignName).GetOrElse(\"-\")}"
    case Empty() => "empty"
}

func main() {
    val spec = Spec(Name = "x", Align = Some[Align](AlignLeft()))
    Println(spec.Align.IsDefined())
    Println(spec.Describe())
    Println(spec.With(None()).Describe())

    val layout = Layout(
        Align = ArrayOf[Align](AlignLeft(), AlignRight()),
        Style = ListOf(Style(true)),
        Box = Box(Box(7)),
    )
    Println(layout.Align.Map(alignName).MkString(","))
    Println(layout.Style.Exists(_.Bold))
    Println(layout.Box.Item.Item)

    val theme = Theme(Style = Style(false), Align = AlignRight())
    Println(s"${theme.Style.Bold} ${alignName(theme.Align)}")

    Println(cellText(Text(Some[Align](AlignRight()), "hi")))
    Println(cellText(Empty()))

    Println(describe(Some[Align](AlignLeft()), Style(true)))

    // A local named like the type argument of its own initializer.
    val Align = Some[Align](AlignRight())
    Println(Align.Map(alignName).GetOrElse("-"))

    val badge = lib.NewBadge("tag", Some[lib.Kind](lib.Secondary()))
    Println(badge.Describe())
    val row = Row(Badge = badge, Kind = badge.Kind)
    Println(s"${row.Badge.Label} ${row.Kind.Map(lib.KindName).GetOrElse(\"-\")}")
}
-- examples/fix001_some_reassign.gala --
package main

import (
    "errors"
    . "martianoff/gala/std"
)

// Regression: reassigning `Some(...)` to a `var` of inferred
// `Option[string]` must inherit the LHS type so the variant is emitted
// as `Some[string]{}.Apply(...)` (not `Some{}.Apply(...)` which Go
// rejects as "generic type Some[T any] without instantiation").
func describe(opt Option[string]) string = opt match {
    case Some(s) => s
    case None()  => "<none>"
}

func main() {
    val onbErr Option[error] = Some[error](errors.New("init"))
    var failure Option[string] = onbErr.Map((e) => s"onboarding: ${e.Error()}")  // Option[string]

    // Reassignment must pick up Option[string] from the var's declared type.
    // Use a literal whose type the call-site arg-inference cannot resolve
    // (Get() on a fresh Option[string] returns string at runtime, but the
    // transpiler resolves this through Immutable wrappers): the type-arg
    // for Some must come from the LHS declared type.
    val src Option[string] = Some[string]("plain")
    failure = Some(src.Get())
    Println(describe(failure))

    // Mutate again to check the path is exercised at every site.
    failure = None[string]()
    Println(describe(failure))

    // Direct string literal — already worked, kept as a sanity check.
    failure = Some("recovered")
    Println(describe(failure))
}
-- examples/fix004_if_string_iife.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
)

// Repro: `if (cond) sStr1 else sStr2` previously produced a
// `func() any { ... }()` IIFE instead of `func() string { ... }()`, because
// the lowered `fmt.Sprintf` CallExpr was not tagged with its return type.
// When the if-expression appears in a `var` initialiser or argument position
// (rather than a return statement), the IIFE return type was widened to
// `any` and downstream callers expecting a concrete `string` failed to
// compile in the generated Go (e.g. `NewImmutable[string](...)` rejected
// the `any` value with "need type assertion").
//
// The original failing shape interpolates a value whose static type is
// `Immutable[T]` (auto-unwrapped to `.Get()` by the s-string lowering).
// HM type inference cannot reliably reach inside the lowered fmt.Sprintf
// call to recover its `string` return type, so the if-expression's
// per-branch fallback must rely on the AST-node type tag we attach in
// `buildSprintfCall`.

struct Style(Color string)

func TextStyled(label string, style Style) string =
    s"[${style.Color}] $label"

// glyph is `Immutable[string]` (val-bindings are wrapped). The s-string
// lowering inserts `glyph.Get()`, but the CallExpr's return type still
// needs to be tagged as string for the if-expression IIFE.
func render(isCursor bool, name string) string {
    val glyph = if (isCursor) ">>" else "--"
    val label = if (isCursor) s"$glyph cursor: $name" else s"$glyph: $name"
    val style = Style(Color = "blue")
    return TextStyled(label, style)
}

// f-string variant: same lowering, same expected type tagging.
func formatNum(n int) string {
    val s = if (n >= 0) f"+$n%d" else f"$n%d"
    return s
}

func main() {
    Println(render(true, "alice"))
    Println(render(false, "bob"))
    Println(formatNum(3))
    Println(formatNum(-1))
}
-- examples/fix004_repro.gala --
package main

import . "martianoff/gala/std"

sealed type Msg {
    case Boom(reason string)
    case Ok(name string)
}

// Multi-line tuple literals as match arm bodies, with trailing commas, mirror
// the Elm-style update-function pattern that returns (model, cmd). Make sure
// the parser accepts this layout — it used to choke on the trailing comma.
func dispatch(model string, msg Msg) Tuple[string, string] = msg match {
    case Boom(reason) => (
        model,
        reason,
    )
    case Ok(name) => (
        model,
        name,
    )
}

func main() {
    val (m1, c1) = dispatch("M", Boom("bang"))
    Println(s"$m1 / $c1")

    val (m2, c2) = dispatch("M", Ok("hello"))
    Println(s"$m2 / $c2")
}
-- examples/fix005_sized_field_literal.gala --
package main

// Untyped numeric literals must adopt the declared type of the immutable
// (`val`) struct field they initialise. Immutable fields are stored as
// `Immutable[T]`, and the generated `NewImmutable(...)` wrapper used to take
// its type argument from the literal's own default type (`0` → int), so any
// field wider or narrower than `int` — int64 timestamps, uint32 ports,
// float64 ratios, byte tags — failed to compile in the generated Go with
// "cannot use Immutable[int] as Immutable[int64]".
//
// Every construction spelling is exercised below: positional, named-argument,
// and Go-style composite literal.

struct Entry(value string, expireAtMs int64)

struct Sizes(i8 int8, i16 int16, i32 int32, i64 int64)

struct Unsigned(u uint, u8 uint8, u16 uint16, u32 uint32, u64 uint64)

struct Ratios(f32 float32, f64 float64)

struct Tags(b byte, r rune)

// A field genuinely declared `int` keeps the plain inferred wrapper — the
// negative case that must not regress.
struct Counter(n int, label string)

// Mutable (`var`) fields are stored unwrapped; the untyped literal converts
// through ordinary Go assignment.
struct MutableEntry(value string, var expireAtMs int64)

// A generic field's type is a type parameter, not a concrete numeric type:
// the wrapper must stay inferred so the type argument is resolved from the
// construction site.
struct Box[T any](item T)

func describeEntry(e Entry) string = s"${e.value}@${e.expireAtMs}"

func main() {
    // Positional construction.
    val positional = Entry("pos", 0)
    Println(describeEntry(positional))

    // Named-argument construction.
    val named = Entry(value = "named", expireAtMs = 1)
    Println(describeEntry(named))

    // Go-style composite literal.
    val composite = Entry{value: "composite", expireAtMs: 2}
    Println(describeEntry(composite))

    // Constant arithmetic stays untyped in Go and must convert too.
    val computed = Entry("computed", 60 * 1000)
    Println(describeEntry(computed))

    // Negative literals and parenthesised constants.
    val negative = Entry("negative", -5)
    Println(describeEntry(negative))

    // Every signed width.
    val signed = Sizes(1, 2, 3, 4)
    Println(s"${signed.i8} ${signed.i16} ${signed.i32} ${signed.i64}")

    val signedNamed = Sizes(i8 = 5, i16 = 6, i32 = 7, i64 = 8)
    Println(s"${signedNamed.i8} ${signedNamed.i16} ${signedNamed.i32} ${signedNamed.i64}")

    // Every unsigned width.
    val unsigned = Unsigned(1, 2, 3, 4, 5)
    Println(s"${unsigned.u} ${unsigned.u8} ${unsigned.u16} ${unsigned.u32} ${unsigned.u64}")

    val unsignedComposite = Unsigned{u: 6, u8: 7, u16: 8, u32: 9, u64: 10}
    Println(s"${unsignedComposite.u} ${unsignedComposite.u8} ${unsignedComposite.u16} ${unsignedComposite.u32} ${unsignedComposite.u64}")

    // Floats: an integer literal must widen, and a float literal must stay a
    // float32 where the field says so.
    val ratios = Ratios(1, 2)
    Println(s"${ratios.f32} ${ratios.f64}")

    val fractional = Ratios(f32 = 0.5, f64 = 1.25)
    Println(s"${fractional.f32} ${fractional.f64}")

    // byte / rune aliases.
    val tags = Tags(65, 66)
    Println(s"${tags.b} ${tags.r}")

    val charTag = Tags{b: 67, r: 'D'}
    Println(s"${charTag.b} ${charTag.r}")

    // Negative case: a plain `int` field is unchanged.
    val counter = Counter(7, "hits")
    Println(s"${counter.label}=${counter.n}")

    val counterNamed = Counter(n = 8, label = "misses")
    Println(s"${counterNamed.label}=${counterNamed.n}")

    // `var` field: literal converts without any wrapper.
    val mutableEntry = MutableEntry("mutable", 9)
    Println(s"${mutableEntry.value}@${mutableEntry.expireAtMs}")

    // Generic field: the type argument comes from the construction site.
    val boxed = Box(11)
    Println(boxed.item)

    val boxedTyped = Box[int64](12)
    Println(boxedTyped.item)
}
-- examples/fix006_match_in_lambda_void_arms.gala --
package main

import (
    "errors"
    . "martianoff/gala/collection_immutable"
)

// Regression: a match expression as the terminal statement of a lambda
// body, where every arm is void (`{}` block or pure assignment), made
// the lambda's analyzer-inferred return type the synthesized union of
// arm results. The lambda body was then lowered as a value-returning
// IIFE wrapping the match, but the IIFE has no value, so Go rejected
// the call site with "(no value) used as value".
//
// The fix: when a lambda body's terminal statement is an IIFE whose
// underlying match has all-void arms, the lambda's return type must
// be `void` (not the synthesized union). When a void IIFE is the
// trailing expression statement of a value-inferred lambda body, it
// must NOT be promoted to a `return <void-IIFE>` call — Go rejects.

struct Member(Name string)

func CloseSession(m Member) Try[bool] {
    if m.Name == "bad" {
        return Failure[bool](errors.New("oops"))
    }
    return Success[bool](true)
}

// Repro: a lambda body terminating in a void-arm match. The lambda is
// passed to Array.ForEach (void callback), so the lambda's expected
// return type is void — this case ALREADY works pre-fix.
func RunAll(members Array[Member]) Array[string] {
    var failures = EmptyArray[string]()
    members.ForEach((m) => {
        CloseSession(m) match {
            case Success(_)   => {}
            case Failure(err) => failures = failures.Append(err.Error())
        }
    })
    return failures
}

// Repro: lambda whose return is INFERRED from its body — the caller
// (function-typed return) does not propagate an expected type into the
// `return lambda` form. Without the fix the inferred return type
// widens to the synthesized arm union (or `void` as a literal type),
// the trailing IIFE gets promoted to `return <void-IIFE>`, and Go
// rejects with "no value used as value".
func MakeProcessor() func(Member) {
    var counter = 0
    return (m Member) => {
        CloseSession(m) match {
            case Success(_)   => counter = counter + 1
            case Failure(err) => Println(s"err: ${err.Error()}")
        }
    }
}

func main() {
    val members = ArrayOf(Member(Name = "alice"), Member(Name = "bad"), Member(Name = "charlie"))
    val errs = RunAll(members)
    Println(errs.Length())
    errs.ForEach((e) => Println(e))

    val proc = MakeProcessor()
    proc(Member(Name = "ok"))
    proc(Member(Name = "bad"))
}
-- examples/fix007_repro.gala --
package main

import (
    "errors"
    . "martianoff/gala/collection_immutable"
)

// Reproducer: tuple literal as call argument should infer concrete element types
// from the call-site expected parameter type, not collapse to `Tuple[any, error]`.
func collectFailures() Array[Tuple[string, error]] {
    var failures = EmptyArray[Tuple[string, error]]()
    val name = "session-1"
    val err = errors.New("boom")
    failures = failures.Append((name, err))
    return failures
}

func main() {
    val out = collectFailures()
    out.ForEach((p) => Println(s"${p.V1}=${p.V2.Error()}"))
}
-- examples/fix007_sealed_tuple_widen.gala --
package main

import "errors"

// Repro for sealed-type case widening inside a tuple-typed match arm result.
//
// The function below has declared return type `Tuple[AppModel, Cmd[AppMsg]]`,
// where `Cmd` is a sealed type with cases `NoCmd` and `MsgCmd`. When match
// arms differ in whether the second tuple slot carries the sealed PARENT
// (`Cmd[AppMsg]`) or the sealed CASE (`MsgCmd[AppMsg]`), match-arm
// unification must widen the case to the parent. Without widening the
// transpiler rejects the match with:
//
//   type mismatch in match expression:
//     'case Failure(e)' returns 'Tuple[AppModel, MsgCmd[AppMsg]]'
//     'case Success(s)' returns 'Tuple[AppModel, Cmd[AppMsg]]'
//
// even though every value of `MsgCmd[AppMsg]` is a value of `Cmd[AppMsg]`.

sealed type AppMsg {
    case Tick()
    case ConsultFailed(Reason string)
}

sealed type Cmd[T any] {
    case NoCmd()
    case MsgCmd(Msg T)
}

struct AppModel(Counter int)

// consultEventFutureCmd returns the sealed PARENT type Cmd[AppMsg].
func consultEventFutureCmd(s string) Cmd[AppMsg] = NoCmd[AppMsg]()


// DispatchConsult mirrors the original bug subject — a Try[T]-shaped match
// where each arm produces a tuple with a Cmd[AppMsg] in slot 2.
func DispatchConsult(n int) Try[string] =
    if (n == 0) Failure[string](errors.New("boom")) else Success("ok")

// dispatchOneConsult exercises the bug: arm 1's tuple slot 2 is bound to
// the sealed CASE `MsgCmd[AppMsg]` via a val whose RHS is a sealed-case
// constructor; arm 2's slot 2 is the sealed PARENT `Cmd[AppMsg]` from a
// function returning the parent. Both arms must unify to the declared
// return Tuple[AppModel, Cmd[AppMsg]].
func dispatchOneConsult(n int) Tuple[AppModel, Cmd[AppMsg]] {
    return DispatchConsult(n) match {
        case Failure(e) => {
            val cmd = MsgCmd[AppMsg](Msg = ConsultFailed(Reason = e.Error()))
            return (AppModel(Counter = 1), cmd)
        }
        case Success(s) => {
            return (AppModel(Counter = 2), consultEventFutureCmd(s))
        }
    }
}

func main() {
    val r1 = dispatchOneConsult(0)
    val r2 = dispatchOneConsult(7)
    Println(s"r1.counter=${r1.V1.Counter}")
    Println(s"r2.counter=${r2.V1.Counter}")
}
-- examples/fix009_eq_literal_immutable.gala --
package main

import (
    . "martianoff/gala/test"
)

// Regression: a function whose parameters are declared with the `val`
// keyword is called with bare string literals. An explicit `val` is a
// no-op marker — the parameter is a plain Go `string`, exactly like an
// unmarked one — so the literals are passed as they are.
//
// Mirrors the gala-server team_config.PolicyConfig shape: a function
// with `val` string parameters called with a literal at one of its slots.
func EqStr(t T, val actual string, val expected string) T = Eq(t, actual, expected)

func TestEqLiteralImmutable(t T) T = EqStr(t, "notify", "notify")
-- examples/fix013_named_arg_widen.gala --
package main

// Multi-arg sealed-case constructor invoked with named arguments must widen
// to the parent sealed type when used at function-return position and at
// call-arg position. The single-arg named form and the positional multi-arg
// form already widen; only the multi-arg + named-arg path was failing.

import . "martianoff/gala/examples/fix013_named_arg_widen_lib"

func makeRecovering(a int, m int) RecoveryStatus =
    Recovering(Attempt = a, Max = m)

func makeFailed(s string) RecoveryStatus =
    Failed(Reason = s)

func makeHelpWaiting(q string) RecoveryStatus =
    HelpWaiting(Question = q)

func describe(s RecoveryStatus) string = s match {
    case Recovering(_, _) => "recovering"
    case Failed(_)        => "failed"
    case HelpWaiting(_)   => "help-waiting"
    case Healthy          => "healthy"
    case Idle             => "idle"
    case Queued           => "queued"
    case Working          => "working"
    case Slow             => "slow"
    case Stuck            => "stuck"
}

func recoveringDescription(a int, m int) string =
    describe(Recovering(Attempt = a, Max = m))

func main() {
    Println(describe(makeRecovering(2, 5)))
    Println(describe(makeFailed("boom")))
    Println(describe(makeHelpWaiting("clarify?")))
    Println(describe(Healthy()))
    Println(recoveringDescription(3, 7))
}
-- examples/fix013_named_arg_widen_lib/status.gala --
package fix013_named_arg_widen_lib

// Sealed type with multi-arg, single-arg, and zero-arg cases.
// Mirrors a real-world Status enum with several no-paren cases, several
// single-arg cases, and a multi-arg case. The multi-arg + named-arg
// constructor at function-return position is the historically-failing
// path this regression test guards.
sealed type RecoveryStatus {
    case Healthy
    case Idle
    case Queued
    case Working
    case Slow
    case Stuck
    case Recovering(Attempt int, Max int)
    case HelpWaiting(Question string)
    case Failed(Reason string)
}
-- examples/fix024_match_arm_return_in_loop.gala --
package main

import . "martianoff/gala/collection_immutable"

// Regression: a `return X` inside a match-arm body, when the match is in
// statement position inside a `for` loop, was lowered to a bare `return`
// from the synthetic match-IIFE. The bare return only exits the IIFE
// lambda — not the enclosing gala function — so the surrounding for-loop
// continued to spin (the loop counter never advanced on the return path),
// producing a runtime infinite loop rather than a compile error.
//
// The fix detects a statement-position match whose arm bodies contain a
// user-written `return X` and inlines the body as a Go block (no IIFE
// wrapper). The user's `return X` then becomes a real Go return that
// exits the enclosing function.

// findFirstOver scans `values` and returns the first element greater than
// `threshold`, or -1 if none. The early-exit `return v` lives inside a
// match-arm body that is itself the only statement of a `for` loop body —
// the precise shape that used to hang.
func findFirstOver(values Array[int], threshold int) int {
    var i = 0
    val n = values.Length()
    for i < n {
        values.Get(i) match {
            case 0 => { i = i + 1 }
            case v => {
                if v > threshold { return v }
                i = i + 1
            }
        }
    }
    return -1
}

// findFirstSome exercises the `Some/None` shape from the original report:
// the early `return Some(...)` inside a `Some(opened)` arm must escape the
// enclosing function, not just the match-IIFE.
func findFirstSome(values Array[int], target int) Option[int] {
    var i = 0
    val n = values.Length()
    for i < n {
        Some(values.Get(i)) match {
            case Some(v) => {
                if v == target { return Some(v) }
                i = i + 1
            }
            case None() => { i = i + 1 }
        }
    }
    return None[int]()
}

func main() {
    val arr = ArrayOf(1, 2, 3, 200, 4, 999)
    Println(findFirstOver(arr, 100))
    Println(findFirstOver(arr, 50000))

    val opt1 = findFirstSome(arr, 200)
    opt1 match {
        case Some(v) => Println(s"found ${v}")
        case None()  => Println("none")
    }
    val opt2 = findFirstSome(arr, 50000)
    opt2 match {
        case Some(v) => Println(s"found ${v}")
        case None()  => Println("none")
    }
}
-- examples/fix_001_tuple_positional_ctor.gala --
package main

import . "martianoff/gala/std"

func main() {
    // Positional Tuple constructor — must infer type args from arg types.
    val pair = Tuple(true, "1")
    Println(pair.V1, pair.V2)

    val triple = Tuple(1, "x", 3.5)
    Println(triple.V1, triple.V2, triple.V3)
}
-- examples/fix_006_three_tuple_return.gala --
package main

import . "martianoff/gala/std"

// User-visible name `Tuple` covers all arities; the transpiler is responsible
// for rewriting Tuple[A, B, C] (>=3 args) to Tuple3[A, B, C] across BOTH
// signature emission (already correct via transformType) AND type expressions
// reconstructed from inferred transpiler.GenericType values (e.g., a match
// IIFE parameter type).
//
// The bug surfaces when a function's return type contains a 3+-tuple and
// the value flows into a match expression. The match IIFE parameter type
// is rebuilt via typeToExpr from the inferred transpiler.GenericType, and
// without the arity rewrite that path emits std.Tuple[int, int, int]
// (2-arity Tuple with 3 type args) — Go rejects it as malformed
// instantiation.

func wrap() Option[Tuple[int, int, int]] = Some((1, 2, 3))

func main() {
    wrap() match {
        case Some(_) => Println("ok")
        case _       => Println("none")
    }
}
-- examples/foldleft_method/main.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"

func main() {
    val list = ArrayOf(1, 2, 3, 4, 5)

    // With explicit types (always works)
    val sum1 = list.FoldLeft[int](0, (acc int, x int) => acc + x)
    fmt.Println(sum1)

    // With implicit return type but explicit param types
    val sum2 = list.FoldLeft(0, (acc int, x int) => acc + x)
    fmt.Println(sum2)

    // Fully implicit — accumulator type inferred from zero value
    val sum3 = list.FoldLeft(0, (acc, x) => acc + x)
    fmt.Println(sum3)

    // String accumulator inferred from zero value
    val joined = list.FoldLeft("", (acc, x) => acc + fmt.Sprint(x))
    fmt.Println(joined)
}
-- examples/foldleft_on_sequence_get.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/collection_immutable"
)

// Verification: FoldLeft on Future.Get() result uses correct namespace.
// When calling .FoldLeft() on a value from Sequence[int](...).Get(),
// the transpiler should generate Array_FoldLeft, not Future_FoldLeft.
func main() {
    val futures = ArrayOf[Future[int]](FutureOf[int](1), FutureOf[int](2), FutureOf[int](3))
    val allResults = Sequence[int](futures)
    val values = allResults.Get()
    val sum = values.FoldLeft[int](0, (acc int, v int) => acc + v)
    fmt.Println(sum)
}
-- examples/foldleft_spread_type.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"
import . "martianoff/gala/go_interop"

func join(items Array[string], sep string) string {
    return items.FoldLeft("", (acc, k) => {
        if acc == "" {
            return k
        } else {
            return acc + sep + k
        }
    })
}

func main() {
    // When using spread operator with ArrayOf, type params should
    // infer element type (string), not slice type ([]string)
    val keys = SliceOf("a", "b", "c")
    val arr = ArrayOf(keys...)

    // FoldLeft should see callback params as (string, string), not ([]string, string)
    val result = join(arr, ",")
    fmt.Println(result)

    // Also test with int spread
    val nums = SliceOf(1, 2, 3, 4, 5)
    val intArr = ArrayOf(nums...)
    val sum = intArr.FoldLeft(0, (acc, n) => acc + n)
    fmt.Println(sum)
}
-- examples/for_loops.gala --
package main

import "fmt"
import . "martianoff/gala/go_interop"

func main() {
    // Classic for loop
    fmt.Print("Classic:")
    for i := 0; i < 5; i++ {
        fmt.Printf(" %d", i)
    }
    fmt.Println()

    // Condition-only (while-style) loop
    fmt.Print("While:")
    var count = 0
    for count < 3 {
        fmt.Printf(" %d", count)
        count++
    }
    fmt.Println()

    // Range loop over slice
    val items = SliceOf(10, 20, 30)
    fmt.Print("Range:")
    for i, v := range items {
        fmt.Printf(" (%d:%d)", i, v)
    }
    fmt.Println()

    // Range loop value only
    fmt.Print("Values:")
    for _, v := range items {
        fmt.Printf(" %d", v)
    }
    fmt.Println()

    // Nested for loops
    fmt.Print("Nested:")
    for i := 0; i < 3; i++ {
        for j := 0; j < 2; j++ {
            fmt.Printf(" %d%d", i, j)
        }
    }
    fmt.Println()

    // For loop with break
    fmt.Print("Break:")
    for i := 0; i < 10; i++ {
        if i >= 3 {
            break
        }
        fmt.Printf(" %d", i)
    }
    fmt.Println()

    // For loop with continue
    fmt.Print("Continue:")
    for i := 0; i < 6; i++ {
        if i % 2 == 0 {
            continue
        }
        fmt.Printf(" %d", i)
    }
    fmt.Println()

    // Decrement loop
    fmt.Print("Decrement:")
    for i := 4; i >= 0; i-- {
        fmt.Printf(" %d", i)
    }
    fmt.Println()
}
-- examples/for_range_groupby_key_type.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"
import "martianoff/gala/go_interop"

// Verifies gap #8: `for k, v := range <func-returning-map[K]V>(...)` must
// see the key and value types coming from the generic function's return type
// `map[K]V`.
//
// Before the fix, the analyzer parsed `map[K]V` return types as a
// GenericType{Base: "<pkg>.map", Params: ...} — treating `map` as a
// package-qualified named type. This corrupted downstream type inference
// so the range key was typed as `any`, and string interpolation picked `%d`
// instead of `%s`, producing runtime garbage like `%!d(string=apple)`.
//
// `CountsOf` returns `map[K]int`. We call it with explicit [string, string]
// type arguments to isolate the range-binding bug from the separate
// (unrelated) issue where K cannot be inferred purely from a lambda's
// return type.
func CountsOf[K comparable, T any](items Array[T], keyOf func(T) K) map[K]int {
    var counts = go_interop.MapEmpty[K, int]()
    items.ForEach((elem T) => {
        val key = keyOf(elem)
        counts[key] = counts[key] + 1
    })
    return counts
}

func main() {
    val items = ArrayOf("apple", "apple", "banana", "cherry", "banana", "apple")
    val counts = CountsOf[string, string](items, (s) => s)

    var sawApple = ""
    var sawBanana = ""
    var sawCherry = ""
    for k, v := range counts {
        if k == "apple" {
            sawApple = s"$k=$v"
        }
        if k == "banana" {
            sawBanana = s"$k=$v"
        }
        if k == "cherry" {
            sawCherry = s"$k=$v"
        }
    }
    fmt.Println(sawApple)
    fmt.Println(sawBanana)
    fmt.Println(sawCherry)
}
-- examples/foreach_void_lambda.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"

func main() {
    // Block lambda with explicit type annotation
    val arr = ArrayOf("a", "b", "c")
    arr.ForEach((s string) => {
        fmt.Println(s)
    })

    // Expression lambda with explicit type annotation
    val nums = ArrayOf(1, 2, 3)
    nums.ForEach((n int) => fmt.Println(n))

    // ForEach on List
    val list = ListOf("x", "y", "z")
    list.ForEach((s string) => {
        fmt.Println(s)
    })
}
-- examples/foreign_default_dot_scope/lib/inside.gala --
package lib

import . "martianoff/gala/examples/foreign_default_dot_scope/pb"

// lib's other file dot-imports pb, not pa. The defaults of lib.gala, lowered
// here, still resolve their bare names through lib.gala's dot import of pa:
// a default means what it means where it is written. They used to resolve
// through this file's dot import and fail to compile.
func Inside() string = s"${Matched()} ${Mapped()} ${Folded()} ${Built()} ${Pick()}"
-- examples/foreign_default_dot_scope/lib/lib.gala --
package lib

import . "martianoff/gala/examples/foreign_default_dot_scope/pa"

// Each default names pa's Same, Hit, Pick and Point bare, as this file's dot import
// makes them. A caller that dot-imports pb, which declares the same names,
// still lowers them as pa's.
func Matched(s string = Some(Same()) match {
    case Some(Same()) => "same"
    case _ => "other"
}) string = s

func Mapped(n int = Some(Point(3)).Map((p) => p.X).GetOrElse(0)) int = n

func Folded(s string = Some(Pick()).Map((k) => k match {
    case Same() => "same"
    case _ => "other"
}).GetOrElse("none")) string = s

func Built(s string = Some(Hit(N = 2)) match {
    case Some(Hit(n)) => s"hit ${n + 1}"
    case _ => "other"
}) string = s
-- examples/foreign_default_dot_scope/pa/pa.gala --
package pa

// pa and pb declare the same names with different types. lib dot-imports pa,
// the test's main package dot-imports pb, and lib's defaults are lowered there.
sealed type KindA {
    case Same()
    case OtherA()
    case Hit(N int)
}

func Pick() KindA = Same()

struct Point(X int)
-- examples/foreign_default_dot_scope/pb/pb.gala --
package pb

// The same names as pa, with other types: a case Same of another sealed type,
// and a Point whose field is a string.
sealed type KindB {
    case Same()
    case OtherB()
    case Hit(N string)
}

func Pick() KindB = OtherB()

struct Point(X string)
-- examples/foreign_default_dot_scope_test.gala --
package main

import (
    . "martianoff/gala/examples/foreign_default_dot_scope/pb"
    "martianoff/gala/examples/foreign_default_dot_scope/lib"
)

// lib's defaults name Same, Pick and Point through lib's dot import of pa.
// This file dot-imports pb, which declares those names too, with other types.
// The defaults are lowered here but resolve their bare names as lib's file
// does: Some(Same()) is an Option of pa's KindA, and p.X is pa's int field.
// They used to resolve through this file's dot import first and fail to
// compile (an Option of pb's KindB, a string p.X).
func main() {
    Println(lib.Matched())
    Println(lib.Mapped())
    Println(lib.Folded())
    Println(lib.Built())
    Println(Pick(), Point("own"))
    // The same defaults, lowered in lib's own other file (see inside.gala).
    Println(lib.Inside())
}
-- examples/from_error.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    "os"
    "path/filepath"
)

// Verify FromError converts Go error returns to Try[Void],
// and that Void type works correctly.
//
// The example uses os.TempDir() instead of a hardcoded "/tmp" path so
// the test passes in Bazel sandboxes on every platform (the previous
// "/tmp/gala-test-from-error" path failed under Windows Bazel because
// the sandbox does not expose the MSYS /tmp mapping).

func main() {
    val testDir = filepath.Join(os.TempDir(), "gala-test-from-error")
    val nonexistentDir = filepath.Join(os.TempDir(), "gala-nonexistent-dir-12345")

    // FromError with a successful operation
    val result = FromError(os.Mkdir(testDir, 0755))
    fmt.Println(result.IsSuccess())

    // Clean up — also via FromError
    val cleanup = FromError(os.Remove(testDir))
    fmt.Println(cleanup.IsSuccess())

    // FromError with an error (remove non-existent dir)
    val fail = FromError(os.Remove(nonexistentDir))
    fmt.Println(fail.IsFailure())

    // Chain with OnFailure — just check it fires
    FromError(os.Remove(nonexistentDir))
        .OnFailure((err) => fmt.Println("error handled"))

    // Void type
    val u = Void{}
    fmt.Println(u.Equal(Void{}))
}
-- examples/fs_roundtrip.gala --
package main

// Verification example for the `fs` stdlib package: write a file,
// stat it, list the directory, read it back, then remove the scratch
// dir. Output is the round-trip text plus the recovered byte count and
// entry count, so the example has a stable cross-OS `.out`. ReadDir
// exercises the `entries[i].Info()` path: a Go method returning
// `(io/fs.FileInfo, error)` on an element of an `[]io/fs.DirEntry`
// slice, which the `fs` package (whose Go name collides with `io/fs`)
// must qualify correctly.

import (
    . "martianoff/gala/fs"
    . "martianoff/gala/std"
    "martianoff/gala/path"
    "os"
)

func main() {
    val dir = Try(os.MkdirTemp("", "fs_roundtrip_")).Get()

    val target = path.Join(dir, "greeting.txt")

    val payload = "hello, gala fs"
    val w = WriteFileString(target, payload, 0o644)
    Println(s"wrote: ${w.IsSuccess()}")

    val info = Stat(target)
    Println(s"stat ok: ${info.IsSuccess()} size=${info.Get().Size}")

    val entries = ReadDir(dir)
    Println(s"readdir ok: ${entries.IsSuccess()} count=${entries.Get().Size()}")

    val r = ReadFileString(target)
    Println(s"read back: ${r.Get()}")

    val cleanup = RemoveAll(dir)
    Println(s"cleanup: ${cleanup.IsSuccess()}")
    Println(s"dir gone: ${!Exists(dir)}")
}
-- examples/func_struct_field.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Test: Function types as struct fields with trailing commas
// This tests the grammar fix for trailing commas in argument lists

type Thunk[T any] struct {
    compute func() T
    name string
}

type LazyOption[T any] struct {
    thunk func() Option[T]
    evaluated bool
    cached Option[T]
}

// Single field with lambda
func simpleThunk() Thunk[int] {
    return Thunk[int](compute = () => 42, name = "simple")
}

// Multiple fields with trailing comma (multiline style)
func lazyNone[T any]() LazyOption[T] {
    return LazyOption[T](
        thunk = () => None[T](),
        evaluated = false,
        cached = None[T](),
    )
}

// Lambda returning generic function call
func lazySome[T any](v T) LazyOption[T] {
    return LazyOption[T](
        thunk = () => Some[T](v),
        evaluated = false,
        cached = None[T](),
    )
}

func main() {
    // Test simple thunk
    val t = simpleThunk()
    fmt.Printf("thunk result: %d\n", t.compute())
    fmt.Printf("thunk name: %s\n", t.name)

    // Test lazy none
    val ln = lazyNone[int]()
    fmt.Printf("lazy none evaluated: %v\n", ln.evaluated)
    fmt.Printf("lazy none thunk(): %v\n", ln.thunk())

    // Test lazy some
    val ls = lazySome[string]("hello")
    fmt.Printf("lazy some thunk(): %v\n", ls.thunk())
}
-- examples/func_typed_defaults.gala --
package main

import "martianoff/gala/examples/func_defaults_lib"

// Defaults of function type — on struct fields and on function and method
// parameters. The declared type is the default's expected type, exactly as it
// is for a value passed explicitly: an unannotated lambda takes its parameter
// and result types from it, and `nil` takes the declared type.

// Hooks covers each lambda shape: untyped, annotated, zero-argument, a void
// block body, and nil defaults for a function and a pointer.
struct Hooks(
    Name   string,
    OnOne  func(int) int       = (a) => a + 1,
    OnTwo  func(int) int       = (a int) => a * 2,
    Greet  func(string) string = (s string) => s + "?",
    Done   func() int          = () => 7,
    Report func(int, int)      = (r, c) => {
        Println(s"report $r $c")
    },
    Maybe  func(int) int       = nil,
    Target *int                = nil,
)

func greet(name string, f func(string) string = (s) => s + "!") string = f(name)

func runOrZero(f func() int = nil) int = if (f == nil) 0 else f()

// A type parameter in the declared type takes the type argument the call binds —
// here inferred from `x`.
func twice[T any](x T, combine func(T, T) T = (a, b) => a) T = combine(x, x)

// Labeled is generic: its field default takes `T` from the instantiation.
struct Labeled[T any](Value T, Show func(T) string = (v) => s"<$v>")

// Counter carries a method whose only parameter is a defaulted lambda.
struct Counter(N int)

func (c Counter) Step(by func(int) int = (n) => n + 10) int = by(c.N)

// Gauge's defaults use the receiver: at the call site it is the call's own
// receiver — unless a lambda parameter of the same name shadows it.
struct Gauge(K int)

func (g Gauge) Read(f func(int) int = (x) => x * g.K) int = f(3)

func (g Gauge) Peek(f func(Gauge) int = (g) => g.K + 1) int = f(g)

// Holder's receiver binds `T` for its method's default, also on a call with
// no arguments.
struct Holder[T any](V T)

func (h Holder[T]) Apply(f func(T) T = (a) => a) T = f(h.V)

// An explicit `nil` passed to a zero-argument function parameter is by-name
// sugar for a thunk returning nil — unlike a `nil` DEFAULT, which is the absent
// function.
func probe(f func() *int) bool = f() == nil

func main() {
    // Every hook omitted.
    val h = Hooks(Name = "local")
    Println(h.OnOne(1), h.OnTwo(3), h.Greet("why"), h.Done())
    Println(h.Maybe == nil, h.Target == nil)
    h.Report(1, 2)

    // An explicit hook still wins.
    Println(Hooks(Name = "set", OnOne = (a) => a - 1).OnOne(1))

    // Function and method parameter defaults.
    Println(greet("hi"))
    Println(greet("hi", (s) => s + "."))
    Println(runOrZero())
    Println(runOrZero(() => 5))
    Println(Counter(1).Step())
    Println(Counter(1).Step((n) => n * 100))
    Println(twice(21), twice(21, (a, b) => a + b), twice("ab", (a, b) => a + b))
    Println(Labeled[int](Value = 1).Show(5), Labeled(Value = "x").Show("y"))
    val gauge = Gauge(2)
    Println(gauge.Read(), gauge.Peek(), Holder(7).Apply(), probe(nil))

    // Declared in another package, constructed here with every hook omitted.
    val b = func_defaults_lib.Backend(Name = "tui")
    val origin = b.Origin()
    Println(origin.V1, origin.V2)
    b.CursorReport(3, 4)
    Println(b.Render(func_defaults_lib.Cell("a")).Ch)
    Println(b.Pick(Some(4)), b.Pick(None[int]()))
    Println(b.OnClose == nil, b.OnReset())
    Println(func_defaults_lib.Decorate("lib"), func_defaults_lib.Scaled(4), func_defaults_lib.Applied(5))
}
-- examples/func_value_lambda_arg.gala --
package main

// A lambda passed to a value of function type takes its parameter types from
// that value's type, whatever holds it: a val, a var, a package-level val, a
// val over a type parameter, or the result of a call.

val shout = (h func(string) string) => h("hey")

func makeApplier() func(func(int) int) int = (h) => h(2)

func describeWith[T any](x T, show func(T) string) string {
    val render = (h func(T) string) => s"<${h(x)}>"
    render((v) => show(v))
}

func main() {
    val apply = (h func(string) string) => h("x")
    Println(apply((s) => s + "!"))

    var step = (f func(int) int, x int) => f(x)
    Println(step((n) => n + 1, 5))
    step = (f func(int) int, x int) => f(f(x))
    Println(step((n) => n + 1, 5))

    val applier = makeApplier()
    Println(applier((n) => n * 10))
    Println(makeApplier()((n) => n + 40))

    Println(shout((s) => s + "?"))
    Println(describeWith(7, (n) => s"n=$n"))
}
-- examples/function_shadows_std_type.gala --
package main

import "errors"

// A function the package declares shadows a std type of the same name where
// the name is written as a value: a bare `Void()` calls the package's
// function, never constructs std's Void. A type position (`Try[Void]`) still
// names std's type, and std's own functions keep using it.

func Void() = Println("Void called as a statement")

func NoSuchElementError(msg string) string = s"no element: $msg"

func Ordered(n int) int = n * 10

func Hashable(n int) = Println(s"hash $n")

func apply(f func(int) int, n int) int = f(n)

func check(fail bool) error = if (fail) errors.New("boom") else nil

func closeAll(fail bool) Try[Void] = FromError(check(fail))

func main() {
    Void()
    Println(NoSuchElementError("x"))
    Println(Ordered(4))
    Println(apply(Ordered, 2))
    Hashable(5)
    val h = Hashable
    h(6)
    Println(closeAll(false).IsSuccess(), closeAll(true).IsFailure())
}
-- examples/future_capture_safety.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/collection_immutable"
)

// Compile-time data-race safety: a `Future` body is a `Sendable[func() T]`
// concurrency boundary, so the transpiler statically checks that the async
// closure only captures shareable values. Every capture below is a `val` of a
// deeply-immutable type (or an immutable projection of one), so the program is
// accepted and runs.
//
// The `Future(expr)` by-name / thunk sugar desugars to `Future(() => expr)`, so
// each `expr` is itself the async closure whose captures are checked.
//
// (Capturing a `var`, a collection_mutable value, or reading a `var` field off
// the boundary would be rejected at compile time with GALA-E0037 — those forms
// cannot appear in a compiling example.)

struct Point(x int, y int)

sealed type Shape {
    case Circle(r int)
    case Square(side int)
}

func sumPoint(p Point) int = p.x + p.y

func main() {
    // Capture an immutable Int val.
    val base = 41
    val f1 = Future(base + 1)
    Println(f1.Get())

    // Capture an immutable String val.
    val label = "gala"
    val f2 = Future(label.Size())
    Println(f2.Get())

    // Capture an immutable Array (collection_immutable) — deeply immutable, so
    // concurrent reads never race.
    val xs = ArrayOf(10, 20, 30)
    val f3 = Future(xs.Size())
    Println(f3.Get())

    // Capture an all-immutable struct WHOLE (passed by value into a function).
    val pt = Point(3, 4)
    val f4 = Future(sumPoint(pt))
    Println(f4.Get())

    // Capture a sealed-type value and match on it (a whole use of a
    // deeply-immutable sealed type).
    val shape = Circle(5)
    val f5 = Future(shape match {
        case Circle(r)    => r * r
        case Square(side) => side * side
    })
    Println(f5.Get())

    // Capture a nested immutable collection Array[Array[int]].
    val grid = ArrayOf(ArrayOf(1, 2), ArrayOf(3, 4, 5))
    val f6 = Future(grid.Size() + grid.Get(0).Size() + grid.Get(1).Size())
    Println(f6.Get())

    // Capture an immutable HashMap.
    val counts = HashMapOf(("a", 1), ("b", 2), ("c", 3))
    val f7 = Future(counts.Size())
    Println(f7.Get())

    // Capture a tuple and read its immutable slots.
    val pair = Tuple(7, "seven")
    val f8 = Future(pair.V1 + pair.V2.Size())
    Println(f8.Get())
}
-- examples/future_field_capture.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/collection_immutable"
)

// Field-access-sensitive data-race safety. `AppModel` is NOT shareable as a
// whole — it carries a `var attempts` field that the enclosing scope may
// reassign. But a `Future` body that reads ONLY its deeply-immutable projections
// (`team`, `statuses`) never touches that mutable state, so it is genuinely
// race-free and is accepted — with NO snapshot `val`s.
//
// This mirrors the real-world "prepare an immutable projection, hand it to an
// off-thread command" pattern: the model stays mutable where the UI needs it,
// while the async closure sees only the frozen slice of it that it reads.

struct AppModel(team string, statuses Array[int], var attempts int)

// project reads only immutable fields, off the concurrency boundary.
func project(team string, statuses Array[int]) string =
    s"$team: ${statuses.Size()} statuses"

func main() {
    val model = AppModel("qa", ArrayOf(1, 2, 3), 0)

    // The whole `model` is captured, but the closure reads only the immutable
    // `team` and `statuses` fields — accepted despite the `var attempts` field.
    val f = Future(project(model.team, model.statuses))
    Println(f.Get())
}
-- examples/future_get_type_chain.gala --
package main

import "fmt"
import . "martianoff/gala/concurrent"
import . "martianoff/gala/collection_immutable"

// Verifies that calling FoldLeft on a Future.Get() result uses the correct
// type namespace (Array_FoldLeft, not Future_FoldLeft).
// This tests that Future[Array[int]].Get() resolves to Array[int].
func main() {
    val f = Future[Array[int]](() => ArrayOf(1, 2, 3, 4, 5))
    val result = f.Get()
    val sum = result.FoldLeft[int](0, (acc int, v int) => acc + v)
    fmt.Println(sum)
}
-- examples/future_go_scalar_capture.gala --
package main

import (
    "time"
    . "martianoff/gala/concurrent"
)

// FP-1 verification: a Go scalar value type (time.Duration, whose underlying is
// int64) can be captured across a Future's Sendable boundary. A scalar is a
// self-contained value — no fields to alias, no reachable heap — so sharing it
// is safe. This mirrors the real downstream shape `Future(() => { Sleep(d) })`.
// Before the shareability predicate recognised Go scalar value types, this
// capture was wrongly rejected with GALA-E0037.
func main() {
    val d = time.Millisecond
    val f = Future(() => {
        time.Sleep(d)
        "done"
    })
    Println(f.Get())
}
-- examples/future_pattern_match.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/collection_immutable"
)

// simulateComputation simulates an async computation that may fail
func simulateComputation(value int, shouldFail bool) Future[int] {
    if shouldFail {
        return FutureFailed[int](FutureError(Message = fmt.Sprintf("computation failed for %d", value)))
    }
    return FutureOf[int](value * 2)
}

func main() {
    fmt.Println("=== Pattern Matching on Single Future ===")

    // Create successful and failed futures
    val successFuture = FutureOf[int](42)
    val failedFuture = FutureFailed[int](FutureError(Message = "something went wrong"))

    // Pattern match using Succeeded/Failed extractors with explicit type
    val msg1 = successFuture match {
        case Succeeded[int](v) => fmt.Sprintf("Success: got value %d", v)
        case Failed[int](e) => fmt.Sprintf("Failed: %s", e.Error())
        case _ => "Unknown state"
    }
    fmt.Println(msg1)

    val msg2 = failedFuture match {
        case Succeeded[int](v) => fmt.Sprintf("Success: got value %d", v)
        case Failed[int](e) => fmt.Sprintf("Failed: %s", e.Error())
        case _ => "Unknown state"
    }
    fmt.Println(msg2)

    // Pattern match using Completed extractor (access to full Try)
    fmt.Println("\n=== Pattern Matching with Completed (Try access) ===")

    val msg3 = successFuture match {
        case Completed[int](Success(v)) => fmt.Sprintf("Completed with success: %d", v)
        case Completed[int](Failure(e)) => fmt.Sprintf("Completed with failure: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(msg3)

    val msg4 = failedFuture match {
        case Completed[int](Success(v)) => fmt.Sprintf("Completed with success: %d", v)
        case Completed[int](Failure(e)) => fmt.Sprintf("Completed with failure: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(msg4)

    // Pattern match with guards
    fmt.Println("\n=== Pattern Matching with Guards ===")

    val bigValueFuture = FutureOf[int](100)
    val smallValueFuture = FutureOf[int](5)

    val classify = (f Future[int]) => f match {
        case Succeeded[int](v) if v >= 50 => fmt.Sprintf("Large value: %d", v)
        case Succeeded[int](v) if v >= 10 => fmt.Sprintf("Medium value: %d", v)
        case Succeeded[int](v) => fmt.Sprintf("Small value: %d", v)
        case Failed[int](e) => fmt.Sprintf("Error: %s", e.Error())
        case _ => "Unknown"
    }

    fmt.Println(classify(bigValueFuture))
    fmt.Println(classify(smallValueFuture))

    // Pattern matching on async computation results
    fmt.Println("\n=== Pattern Matching on Future(...) ===")

    val computeFuture = Future[int](() => 21 * 2)

    val computeResult = computeFuture match {
        case Succeeded[int](v) => fmt.Sprintf("Computation result: %d", v)
        case Failed[int](e) => fmt.Sprintf("Computation failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(computeResult)

    // === Sequence Pattern Matching ===
    fmt.Println("\n=== Pattern Matching on Sequence of Futures ===")

    // All successful futures
    val allSuccess = ArrayOf[Future[int]](
        FutureOf[int](1),
        FutureOf[int](2),
        FutureOf[int](3)
    )

    val seqMsg1 = allSuccess match {
        case AllSucceeded[int](values) => fmt.Sprintf("All succeeded with values: [%d, %d, %d]", values.Get(0), values.Get(1), values.Get(2))
        case AnyFailed[int](e) => fmt.Sprintf("One or more failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(seqMsg1)

    // One failing future in the sequence
    val withFailure = ArrayOf[Future[int]](
        FutureOf[int](1),
        FutureFailed[int](FutureError(Message = "second computation failed")),
        FutureOf[int](3)
    )

    val seqMsg2 = withFailure match {
        case AllSucceeded[int](values) => fmt.Sprintf("All succeeded with %d values", values.Size())
        case AnyFailed[int](e) => fmt.Sprintf("One or more failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(seqMsg2)

    // Using pattern matching in a function
    fmt.Println("\n=== Pattern Matching in Function ===")

    val processFutures = (futures Array[Future[int]]) => futures match {
        case AllSucceeded[int](values) => {
            val sum = values.FoldLeft[int](0, (acc int, v int) => acc + v)
            fmt.Sprintf("Sum of all values: %d", sum)
        }
        case AnyFailed[int](e) => fmt.Sprintf("Cannot compute sum, error: %s", e.Error())
        case _ => "Empty or unknown"
    }

    fmt.Println(processFutures(allSuccess))
    fmt.Println(processFutures(withFailure))

    // Combining with transformed Futures
    fmt.Println("\n=== Pattern Matching on Transformed Futures ===")

    val transformedFuture = FutureOf[int](10)
        .Map[int]((x int) => x * 2)
        .Map[string]((x int) => fmt.Sprintf("Value is %d", x))

    val transformedMsg = transformedFuture match {
        case Succeeded[string](s) => fmt.Sprintf("Transformed: %s", s)
        case Failed[string](e) => fmt.Sprintf("Transform failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(transformedMsg)

    // Pattern matching on chained Futures
    fmt.Println("\n=== Pattern Matching on Chained Futures ===")

    val chainedFuture = FutureOf[int](5)
        .FlatMap[int]((x int) => simulateComputation(x, false))
        .FlatMap[int]((x int) => simulateComputation(x, false))

    val chainedMsg = chainedFuture match {
        case Succeeded[int](v) => fmt.Sprintf("Chain completed: %d", v)
        case Failed[int](e) => fmt.Sprintf("Chain failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(chainedMsg)

    // Chain with failure in the middle
    val failingChain = FutureOf[int](5)
        .FlatMap[int]((x int) => simulateComputation(x, false))
        .FlatMap[int]((x int) => simulateComputation(x, true))
        .FlatMap[int]((x int) => simulateComputation(x, false))

    val failingChainMsg = failingChain match {
        case Succeeded[int](v) => fmt.Sprintf("Chain completed: %d", v)
        case Failed[int](e) => fmt.Sprintf("Chain failed: %s", e.Error())
        case _ => "Unknown"
    }
    fmt.Println(failingChainMsg)
}
-- examples/future_sendable_wrapper.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
)

// Sendable propagation, end-to-end. Both wrappers below take a caller-provided
// computation declared `Sendable[func() int]` and forward it into a `Future`
// (itself a `Sendable[func() T]` boundary). The `Sendable` bound propagates the
// capture-safety obligation to the CALL SITE where the real closure literal is
// written — so forwarding the vouched-safe `compute` across the further Future
// boundary is accepted. The forward is shown in BOTH the explicit-lambda form
// and the by-name thunk-sugar form; the two desugar identically.

// afterCompute forwards via an explicit closure literal.
func afterCompute(compute Sendable[func() int]) Future[int] =
    Future(() => compute() + 1)

// afterComputeThunk forwards via thunk sugar — `Future(compute() + 1)` desugars
// to `Future(() => compute() + 1)`, capturing the same Sendable `compute`.
func afterComputeThunk(compute Sendable[func() int]) Future[int] =
    Future(compute() + 1)

func main() {
    // The closure literal supplied here has ITS captures checked: it captures
    // the immutable `val base`, which is shareable.
    val base = 41
    Println(afterCompute(() => base).Get())
    Println(afterComputeThunk(() => base).Get())
}
-- examples/gap04_repro.gala --
package main

import "os"

// Positive form of gap #4 (GALA-E0015): a match-as-value that needs to early-
// exit from the outer function cannot use a bare `return` inside a branch,
// because the generated IIFE has a non-void return type. Instead, destructure
// the Try first and early-return before the match.
//
// The negative form — a bare `return` inside a value-producing match — is
// exercised as a transpile-error test in
// internal/transpiler/transformer/error_codes_test.go (GALA-E0015).

func run(path string) {
    val result = Try(() => os.ReadFile(path))
    if (result.IsFailure()) {
        Println("error: file not found")
        return
    }
    val data = string(result.Get())
    Println(data)
}

func main() {
    run("nonexistent-file.txt")
}
-- examples/gap09_group_map_reduce.gala --
package main

import . "martianoff/gala/collection_immutable"

func main() {
    val words = ArrayOf("a", "b", "a", "c", "b", "a")
    val counts = words.GroupMapReduce(
        (w) => w,
        (w) => 1,
        (a, b) => a + b,
    )
    Println(counts["a"])
    Println(counts["b"])
    Println(counts["c"])
}
-- examples/gap10_tuple_literal_append.gala --
package main

import . "martianoff/gala/collection_immutable"
import . "martianoff/gala/std"

// Map a generic array to Array[Tuple[string, int]] via FoldLeft.
// The lambda `acc` is Array[Tuple[string, int]] (from the zero value).
// When calling acc.Append((w, s)), the tuple literal must infer its element
// types from the receiver's Tuple[string, int] parameters.
func buildPairs(words Array[string], scores Array[int]) Array[Tuple[string, int]] {
    val zero Array[Tuple[string, int]] = ArrayOf[Tuple[string, int]]()
    return words.FoldLeft(zero, (acc, w) => {
        val s = scores.Length()
        return acc.Append((w, s))
    })
}

func main() {
    val words = ArrayOf("a", "b")
    val scores = ArrayOf(10, 20)
    val pairs = buildPairs(words, scores)
    pairs.ForEach((p) => {
        Println(p.V1)
        Println(p.V2)
    })
}
-- examples/gap11_none_widening.gala --
package main

import . "martianoff/gala/std"

struct User(Id int, Name string)

func find(id int) Option[User] {
    return id match {
        case 0 => None()
        case _ => Some(User(Id = id, Name = s"user-$id"))
    }
}

func main() {
    val u1 = find(0)
    val u2 = find(42)
    u1 match {
        case None() => Println("none")
        case Some(u) => Println(u.Name)
    }
    u2 match {
        case None() => Println("none")
        case Some(u) => Println(u.Name)
    }
}
-- examples/generic_alias_crosspkg/report/report.gala --
package report

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/examples/generic_alias_crosspkg/shapes"
)

// Describe matches a Result named through a dot import.
func Describe(r Result[int]) string = r match {
    case Right(v) => s"ok $v"
    case Left(e) => s"error ${e.Code}: ${e.Msg}"
}

// Doubled takes its constructors' type arguments from an imported generic
// alias of a generic alias.
func Doubled(n int) Again[int] = if (n > 0) Right(n * 2) else Left(AppError(2, "not positive"))

// Totals is an imported partially applied alias.
func Totals() StrMap[int] = HashMapOf(("a", 1), ("b", 2))
-- examples/generic_alias_crosspkg/shapes/shapes.gala --
package shapes

import . "martianoff/gala/collection_immutable"

// AppError is the error side of Result.
struct AppError(Code int, Msg string)

// Result is a generic alias of Either with a fixed error type.
type Result[T any] Either[AppError, T]

// Again is a generic alias of a generic alias.
type Again[T any] Result[T]

// Pairs is a generic alias with a constrained parameter.
type Pairs[K comparable, V any] Array[Tuple[K, V]]

// StrMap is a partially applied generic alias of HashMap.
type StrMap[V any] HashMap[string, V]

// Maybe is a generic alias of Option.
type Maybe[T any] Option[T]

// Items is a generic alias of Array.
type Items[T any] Array[T]

// Order is encoded by a codec through its generic-alias fields.
struct Order(Id int, Note Maybe[string], Lines Items[int])

// Check fails for a negative number.
func Check(n int) Result[int] = if (n < 0) Left(AppError(1, "negative")) else Right(n)

// Count is generic over the alias's parameters.
func Count[K comparable, V any](ps Pairs[K, V]) int = ps.Size()

// Span is a generic struct; Range is a generic alias of it, constructed
// without type arguments by importers.
struct Span[T any](Lo T, Hi T)

// Range is a generic alias of a generic struct.
type Range[T any] Span[T]
-- examples/generic_alias_crosspkg_test.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/concurrent"
    "martianoff/gala/json"
    "martianoff/gala/examples/generic_alias_crosspkg/report"
    "martianoff/gala/examples/generic_alias_crosspkg/shapes"
)

// Generic aliases declared in another package, used qualified here and
// through a dot import in the report package: constructors typed from them,
// matches on values of them, methods of the types they name, a codec over a
// struct whose fields are spelled with them, and a Future capturing them.

func fromZero(n int) shapes.Result[int] = if (n == 0) Left(shapes.AppError(3, "zero")) else Right(100 / n)

func noNote() shapes.Maybe[string] = None()

func main() {
    Println(report.Describe(shapes.Check(4)))
    Println(report.Describe(shapes.Check(-1)))
    Println(report.Describe(fromZero(0)))
    Println(report.Describe(fromZero(5)))
    Println(report.Describe(report.Doubled(21)))
    Println(report.Doubled(0).IsLeft())
    Println(noNote().IsEmpty())

    val ps shapes.Pairs[string, int] = ArrayOf(("a", 1), ("b", 2))
    Println(shapes.Count(ps))
    val totals = report.Totals()
    Println(totals.Get("b").GetOrElse(0))

    val order = shapes.Order(7, Some("rush"), ArrayOf(5, 6, 7))
    val codec = json.Codec[shapes.Order](json.SnakeCase())
    val body = codec.Encode(order).Get()
    Println(body)
    Println(codec.Decode(body).Map(_.Lines.Size()))

    val r = shapes.Range(2, 9)
    Println(r.Hi - r.Lo)

    val sizes = Future(s"${ps.Size()} ${totals.Size()}")
    Println(sizes.Get())
}
-- examples/generic_field_named_like_type/lib/lib.gala --
package lib

// Library-side generic declarations whose fields share their names with
// generic types declared in the sibling file types.gala.

// Harness carries a Model and a Mode in fields named like their types.
struct Harness[M any, T any](Model Model[M], Mode Mode[T])

// Step dispatches on the field that is named like its sealed type.
func (h Harness[M, T]) Step(n int, s string) T = h.Mode match {
    case Count(fn) => fn(n)
    case Text(fn) => fn(s)
}

// State reads through the field that is named like its struct type.
func (h Harness[M, T]) State() M = h.Model.State

// WithMode replaces the Mode field through Copy.
func (h Harness[M, T]) WithMode(m Mode[T]) Harness[M, T] = h.Copy(Mode = m)

// ModeName names the active mode.
func ModeName[T any](m Mode[T]) string = m match {
    case Count(_) => "count"
    case Text(_) => "text"
}

// Slot is a sealed type whose variant field is named like a generic type
// from the sibling file.
sealed type Slot[T any] {
    case Filled(Mode Mode[T])
    case Vacant()
}

// SlotName names the mode held by a slot.
func SlotName[T any](s Slot[T]) string = s match {
    case Filled(m) => ModeName(m)
    case Vacant() => "vacant"
}
-- examples/generic_field_named_like_type/lib/types.gala --
package lib

// Generic types declared in a sibling file of the declarations whose fields
// are named after them (lib.gala).

// Mode is a generic sealed type that fields in lib.gala are named after.
sealed type Mode[T any] {
    case Count(Fn func(int) T)
    case Text(Fn func(string) T)
}

// Model is a generic struct that a field of Harness is named after.
struct Model[M any](State M)
-- examples/generic_field_named_like_type/main.gala --
package main

import . "martianoff/gala/collection_immutable"
import "martianoff/gala/examples/generic_field_named_like_type/lib"

// A generic struct's field may share its name with another generic type of
// the same package: `Mode Mode[T]`. Matching on, reading, copying and
// chaining through such a field must keep the field and the type apart.

// Mode is the sealed type the fields below are named after.
sealed type Mode[T any] {
    case A(Fn func(int) T)
    case B(Fn func(string) T)
}

// Inner is a generic struct a field of Box is named after.
struct Inner[T any](X T)

// Label is a plain struct a field of Box is named after.
struct Label(Text string)

// Box has three fields, each named like its type.
struct Box[T any](Mode Mode[T], Inner Inner[T], Label Label)

// Match on the field in a method body.
func (b Box[T]) Run(i int, s string) T = b.Mode match {
    case A(fn) => fn(i)
    case B(fn) => fn(s)
}

// Match on the field in a generic function.
func kind[T any](b Box[T]) string = b.Mode match {
    case A(_) => "a"
    case B(_) => "b"
}

// The type name stays usable in type position next to the field.
func (b Box[T]) GetMode() Mode[T] = b.Mode

func (b Box[T]) Swap(m Mode[T]) Box[T] = b.Copy(Mode = m)

func (b Box[T]) Local() string {
    // Explicit annotations on purpose: the type names in type position.
    val m Mode[T] = b.Mode
    val in Inner[T] = b.Inner
    return m match {
        case A(_) => s"local-a ${in.X}"
        case B(_) => s"local-b ${in.X}"
    }
}

// Match on the field inside a lambda.
func (b Box[T]) Tags(xs Array[int]) Array[string] = xs.Map((x) => b.Mode match {
    case A(_) => s"a$x"
    case B(_) => s"b$x"
})

// Construct variants of the type while matching on the field.
func (b Box[T]) Flip() Mode[T] = b.Mode match {
    case A(fn) => B[T]((s) => fn(s.Size()))
    case B(fn) => A[T]((i) => fn(s"$i"))
}

// Field access chain through a field named like its type.
struct Outer[T any](Box Box[T])

func (o Outer[T]) Deep(i int) T = o.Box.Mode match {
    case A(fn) => fn(i)
    case B(fn) => fn("deep")
}

// Non-generic struct with a field named like a generic type.
struct Plain(Mode Mode[int])

func (p Plain) Kind() string = p.Mode match {
    case A(_) => "plain-a"
    case B(_) => "plain-b"
}

// Wrapped has a sealed-variant field named like a generic type.
sealed type Wrapped[T any] {
    case Wrap(Mode Mode[T])
    case Bare()
}

func runMode[T any](m Mode[T], i int) T = m match {
    case A(fn) => fn(i)
    case B(fn) => fn(s"$i")
}

// Eval runs the wrapped mode, if any.
func (w Wrapped[T]) Eval(i int) Option[T] = w match {
    case Wrap(m) => Some(runMode(m, i))
    case Bare() => None[T]()
}

// Field named like a generic type from another package.
struct Host[T any](Harness lib.Harness[string, T])

func (h Host[T]) Mode() string = lib.ModeName(h.Harness.Mode)

func main() {
    val b = Box[int](Mode = A[int]((x) => x * 2), Inner = Inner(X = 7), Label = Label(Text = "lbl"))
    Println(b.Run(21, "zz"))
    Println(kind(b))
    Println(b.Inner.X)
    Println(b.Label.Text)
    Println(b.GetMode() match {
        case A(fn) => fn(1)
        case B(fn) => fn("q")
    })
    Println(b.Local())
    Println(b.Tags(ArrayOf(1, 2)).MkString(","))
    Println(b.Flip() match {
        case A(fn) => fn(5)
        case B(fn) => fn("four")
    })

    val c = b.Copy(Mode = B[int]((s) => s.Size()))
    Println(c.Run(0, "hello"))
    Println(kind(c))
    Println(b.Swap(c.Mode).Local())
    Println(Outer[int](Box = c).Deep(3))
    Println(Plain(Mode = B[int]((s) => s.Size())).Kind())

    val h = lib.Harness[string, int](Model = lib.Model(State = "ready"), Mode = lib.Count[int]((n) => n + 1))
    Println(h.Step(41, "x"))
    Println(h.State())
    Println(h.Model.State)
    Println(h.Mode match {
        case lib.Count(fn) => s"count ${fn(1)}"
        case lib.Text(fn) => s"text ${fn("y")}"
    })
    val t = h.WithMode(lib.Text[int]((s) => s.Size()))
    Println(t.Step(0, "four"))
    Println(Host[int](Harness = t).Mode())

    Println(Wrap[int](b.Mode).Eval(4).GetOrElse(-1))
    Println(Wrap[int](c.Mode).Eval(1234).GetOrElse(-1))
    Println(Bare[int]().Eval(4).GetOrElse(-1))
    Println(lib.SlotName(lib.Filled[int](h.Mode)))
    Println(lib.SlotName(lib.Filled[int](t.Mode)))
    Println(lib.SlotName(lib.Vacant[int]()))
}
-- examples/generic_func_alias.gala --
package main

// A generic alias of a function type is a Go generic alias,
// `type Conv[A any, B any] = func(A) B`: a struct field, a parameter, a val or
// a binding typed `Conv[int, string]` is a `func(int) string`, and a lambda in
// its place takes those types.

type Conv[A any, B any] func(A) B
type Visitor[T any] func(func(T))

struct Step[A any, B any](In A, Run Conv[A, B])

func runStep[A any, B any](s Step[A, B]) B = s.Run(s.In)

func applyConv[A any, B any](a A, f Conv[A, B]) B = f(a)

func visitAll(visit Visitor[int]) = visit((v) => Println(s"visited $v"))

func main() {
    Println(Step[int, string](In = 3, Run = (x) => s"$x").In)
    Println(runStep(Step(In = 4, Run = (x) => x * 10)))
    Println(applyConv("gala", _.Size()))

    val shout Conv[string, string] = (s) => s + "!"
    Println(shout("hey"))

    visitAll((f) => {
        f(1)
        f(2)
    })
}
-- examples/generic_funcref_chain.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/generic_funcref_lib"
)

// A bare reference to a GENERIC function — same-package AND cross-package —
// passed to Array.Map, whose result is then consumed by something that must
// WRITE the element type down (a ForEach lambda parameter, a chained Map).
// Unless the referenced function's own type parameter is instantiated from the
// expected parameter type, Map's result type parameter never binds and its
// sentinel leaks into the generated Go.
//
// Consuming the result with only `.String()` hides the leak, which is why every
// case below feeds a consumer that names the element type.

func ident[T any](x T) T = x

func main() {
    // Same-package generic bare ref -> type-writing consumer.
    ArrayOf("a", "b").Map(ident).ForEach((g) => Println(g))

    // Same-package generic bare ref on a different element type, chained into
    // a second generic method.
    Println(ArrayOf(1, 2).Map(ident).Map(_ * 2).String())

    // Cross-package generic bare ref -> type-writing consumer.
    ArrayOf("c").Map(generic_funcref_lib.Identity).ForEach((g) => Println(g))

    // Cross-package generic bare ref whose result type has a different shape.
    ArrayOf(3).Map(generic_funcref_lib.Repeat).ForEach((g) => Println(g.String()))
}
-- examples/generic_interface.gala --
package main

import "fmt"

type Container[T any] interface {
    Get() T
}

struct MyInt(v int)

func (m MyInt) Get() int = m.v

func main() {
    val c Container[int] = MyInt(42)
    fmt.Println(c.Get())
}
-- examples/generic_method_constraint.gala --
package main

import "fmt"

// A generic type with a constraint
type Container[T comparable] struct {
    value T
}

// A generic method that introduces a new type parameter
// U must be comparable because Container[U] requires it
func (c *Container[T]) Map[U comparable](f func(T) U) *Container[U] {
    return &Container[U](value = f(c.value))
}

func main() {
    var c = &Container[int](value = 42)
    var result = c.Map[string]((x int) => fmt.Sprintf("%d", x))
    fmt.Println(result.value)
}
-- examples/generic_method_cycle.gala --
package main

import "fmt"

type Pair[A any, B any] struct {
    First A
    Second B
}

type MyList[T any] struct {
    head T
    var tail *MyList[T]
    var isEmpty bool
}

func emptyMyList[T any]() MyList[T] {
    var zero T
    var nilTail *MyList[T] = nil
    return MyList[T](head = zero, tail = nilTail, isEmpty = true)
}

func consList[T any](h T, var t MyList[T]) MyList[T] {
    return MyList[T](head = h, tail = &t, isEmpty = false)
}

// This method returns a MyList with a different type parameter
// Go has limitations with such patterns (instantiation cycle)
func (l MyList[T]) ZipWithIndex() MyList[Pair[T, int]] {
    var result = emptyMyList[Pair[T, int]]()
    var current = l
    for i := 0; !current.isEmpty; i++ {
        result = consList[Pair[T, int]](Pair[T, int](First = current.head, Second = i), result)
        current = *current.tail
    }
    return result
}

func main() {
    val list = consList[int](1, consList[int](2, emptyMyList[int]()))
    val zipped = list.ZipWithIndex()
    fmt.Println("Length test passed")
    fmt.Println(zipped.isEmpty)
}
-- examples/generic_method_named_args.gala --
package main

import . "martianoff/gala/collection_immutable"

// A generic method — one with type parameters of its own — binds named
// arguments by name and fills omitted defaults, exactly as a non-generic
// method does. Generic methods lower to standalone functions, a separate
// path through the transpiler that used to bind every argument by position.

type Box struct {
    val n int
}

func (b Box) Fold[T any](initial T, f func(T, int) T) T = f(initial, b.n)

func (b Box) Pick[T any](first T, second T, useSecond bool = false) T = if (useSecond) second else first

func (b Box) Label[T any](value T, prefix string = "#", times int = 1) string {
    var out = ""
    for i := 0; i < times; i = i + 1 {
        out = out + s"$prefix$value"
    }
    return out
}

type Wrapper[T any] struct {
    val value T
}

func (w Wrapper[T]) Convert[U any](f func(T) U, fallback U) U = f(w.value)

func main() {
    val b = Box(n = 3)

    // Named arguments in declaration order and reversed.
    Println(b.Fold(initial = 10, f = (acc, x) => acc + x))
    Println(b.Fold(f = (acc, x) => acc * x, initial = 2))

    // Omitted default, positionally and by name.
    Println(b.Pick("a", "b"))
    Println(b.Pick(second = "b", first = "a"))
    Println(b.Pick(second = "b", first = "a", useSecond = true))

    // Positional then named, skipping a default in the middle.
    Println(b.Label(7, times = 3))
    Println(b.Label(value = true, prefix = "@"))

    // Generic method on a generic receiver.
    val w = Wrapper[int](value = 21)
    Println(w.Convert(fallback = "", f = (v) => s"${v * 2}"))

    // A standard-library generic method.
    Println(ArrayOf(1, 2, 3).FoldLeft(f = (acc, x) => acc + x, initial = 100))
}
-- examples/generic_methods.gala --
package main

import "fmt"

type Box[T any] struct {
    Value T
}

func (b Box[T]) Transform[U any](f func(T) U) Box[U] = Box[U](Value = f(b.Value))

type Pair[A any, B any] struct {
    First A
    Second B
}

func (p Pair[A, B]) Swap() Pair[B, A] = Pair[B, A](First = p.Second, Second = p.First)

func (p Pair[A, B]) MapFirst[C any](f func(A) C) Pair[C, B] = Pair[C, B](First = f(p.First), Second = p.Second)

func main() {
    val b = Box[int](Value = 10)
    val res1 = b.Transform((i int) => i * 2)
    fmt.Println("Box:", res1.Value)

    val p = Pair[int, string](First = 1, Second = "hello")
    val p2 = p.Swap()
    fmt.Println("Swapped Pair:", p2.First, p2.Second)

    val p3 = p.MapFirst((i int) => i > 0)
    fmt.Println("Mapped Pair:", p3.First, p3.Second)

    // implicit types
    val p4 = Pair(First = "world", Second = 22)
    val p5 = p4.Swap()
    fmt.Println("Implicit Swapped Pair:", p5.First, p5.Second)
}
-- examples/generic_pointer_method_autoaddr.gala --
package main

// A generic method on a pointer receiver is lowered to a function that takes
// the receiver as its first argument. Called on an addressable value, it runs
// on that value through its address, as a method call does; called on a val
// or a call result, it runs on an addressed copy, so the original is unchanged.

// Box holds a value and counts the calls made on it.
struct Box[T any](var V T, var Hits int)

// Map counts the call on the box it runs on, then maps its value.
func (b *Box[T]) Map[U any](f func(T) U) U {
    b.Hits = b.Hits + 1
    f(b.V)
}

// Fold is Map on a Ptr receiver, folding the value into zero.
func (b Ptr[Box[T]]) Fold[U any](zero U, f func(U, T) U) U {
    b.Hits = b.Hits + 1
    f(zero, b.V)
}

// Touch is a generic method without arguments: it counts the call.
func (b *Box[T]) Touch[U any]() Option[U] {
    b.Hits = b.Hits + 1
    None[U]()
}

// Holder reaches a box through a field.
struct Holder(var box Box[int])

func newBox() Box[int] = Box(V = 7, Hits = 0)

// Cell is a monad whose FlatMap and Zip2 have pointer receivers.
struct Cell[T any](var V T)

// FlatMap applies f to the cell's value.
func (c *Cell[T]) FlatMap[U any](f func(T) Cell[U]) Cell[U] = f(c.V)

// Zip2 pairs the values of two cells.
func (c *Cell[T]) Zip2[U any](o Cell[U]) Cell[Tuple[T, U]] = Cell(Tuple(c.V, o.V))

// A bind over a parameter and a var: both are addressable.
func sumCells(x Cell[int]) Cell[int] {
    var y = Cell(20)
    bind a = x
    bind b = y
    Cell(a + b)
}

// An also group over call results: the Zip and its FlatMap run on copies.
func zipCells() Cell[int] {
    bind a = Cell(1)
    also b = Cell(2)
    Cell(a + b)
}

func main() {
    // A var: every call counts on the var itself.
    var b = Box(V = 1, Hits = 0)
    Println(s"map: ${b.Map(_ + 1)}")
    Println(s"fold: ${b.Fold(10, (acc, v) => acc + v)}")
    Println(s"touch: ${b.Touch[string]().IsEmpty()}")
    Println(s"var hits: ${b.Hits}")

    // A field reached through a var.
    var h = Holder(box = Box(V = 2, Hits = 0))
    Println(s"field map: ${h.box.Map(_ * 10)}")
    Println(s"field fold: ${h.box.Fold("", (acc, v) => s"$acc$v")}")
    Println(s"field hits: ${h.box.Hits}")

    // A val: each call runs on a copy, and the val keeps its count.
    val c = Box(V = 3, Hits = 0)
    Println(s"val map: ${c.Map(_ - 1)}")
    Println(s"val fold: ${c.Fold(0, (acc, v) => acc - v)}")
    Println(s"val hits: ${c.Hits}")

    // A call result: runs on a copy of it.
    Println(s"result map: ${newBox().Map((v) => v * v)}")
    Println(s"result fold: ${newBox().Fold(1, (acc, v) => acc * v)}")

    // A pointer is passed as it is.
    val p = &b
    Println(s"pointer map: ${p.Map(_ + 100)}")
    Println(s"pointer hits: ${b.Hits}")

    // bind and also lower to the same functions.
    Println(s"bind: ${sumCells(Cell(1)).V}")
    Println(s"also: ${zipCells().V}")
}
-- examples/generic_sealed_exhaustive.gala --
package main

// A generic sealed type declared in `main` must be recognized as sealed when the
// match subject's type is INFERRED from a variant constructor rather than
// declared. The variant's `Apply` return type is what carries that type, and it
// used to be built with a `main.` qualifier — a base name no registry key
// matches, since types in `main`/`test` are registered unqualified. Every check
// keyed on the matched type then concluded "not a sealed type", so a match
// listing every variant was rejected with "match expression must have a default
// case".
//
// The runtime answers are asserted, not just compilation: the exhaustive-sealed
// path lowers to a synthetic `panic("unreachable")` default, so a match that
// dispatched to the wrong arm would surface here rather than in the type checker.

sealed type Maybe[T any] {
    case Just(V T)
    case Nothing
}

sealed type Pair[A any, B any] {
    case Both(L A, R B)
    case Neither
}

// Subject type inferred from the constructor — the shape that regressed.
func describeInferred() string {
    val m = Just(42)
    return m match {
        case Just(v)   => s"just $v"
        case Nothing() => "nothing"
    }
}

func describeInferredNothing() string {
    val m = Nothing[int]()
    return m match {
        case Just(v)   => s"just $v"
        case Nothing() => "nothing"
    }
}

// Inferred subject over the second type parameter position, so the fix is not
// pinned to a single instantiation.
func describeInferredString() string {
    val m = Just("hi")
    return m match {
        case Just(v)   => s"just $v"
        case Nothing() => "nothing"
    }
}

// Declared parameter type — this path always worked, kept as the control.
func describeDeclared(m Maybe[int]) string = m match {
    case Just(v)   => s"just $v"
    case Nothing() => "nothing"
}

// Two type parameters, to prove the fix is not arity-specific.
func describePair(p Pair[int, string]) string = p match {
    case Both(l, r) => s"both $l $r"
    case Neither()  => "neither"
}

func describePairInferred() string {
    val p = Both(1, "x")
    return p match {
        case Both(l, r) => s"both $l $r"
        case Neither()  => "neither"
    }
}

func main() {
    Println(describeInferred())
    Println(describeInferredNothing())
    Println(describeInferredString())
    Println(describeDeclared(Just(7)))
    Println(describeDeclared(Nothing[int]()))
    Println(describePair(Both(2, "y")))
    Println(describePair(Neither[int, string]()))
    Println(describePairInferred())
}
-- examples/generic_struct_alias_ctor.gala --
package main

// A generic alias of a generic struct is constructed like the struct: its
// type arguments are inferred from the fields and the expected type.

struct Pair[T any](A T, B T)

struct Entry[K comparable, V any](Key K, Value V)

type Twin[T any] Pair[T]

type IntKeyed[V any] Entry[int, V]

type Flipped[V any, K comparable] Entry[K, V]

func wide() Twin[int64] = Twin(3, 4)

func main() {
    val twin = Twin(1, 2)
    Println(twin.A + twin.B)

    val named = Twin(A = "a", B = "b")
    Println(named.A + named.B)

    val keyed = IntKeyed(Key = 1, Value = "one")
    Println(keyed.Key, keyed.Value)

    val flipped = Flipped(Key = "x", Value = 2.5)
    Println(flipped.Key, flipped.Value)

    val w = wide()
    Println(w.A * w.B)
}
-- examples/generic_struct_copy.gala --
package main

// `.Copy(...)` on a generic struct yields the receiver's own instantiated
// type — the same type arguments, since Copy cannot change field types —
// whether the result is bound to a val, returned from an if-expression or a
// match arm, read through a pointer, or taken from another package.

import "martianoff/gala/examples/generic_struct_copy/boxes"
import . "martianoff/gala/collection_immutable"

struct Box[T any](Item T, N int)

struct Entry[K comparable, V any](Key K, Value V, Hits int)

sealed type Slot[T any] {
    case Filled(Value T)
    case Empty
}

sealed type Ev {
    case Inc()
    case Keep()
}

func pick[T any](b Box[T], up bool) Box[T] = if (up) b.Copy(N = b.N + 1) else b

func step[T any](b Box[T], ev Ev) Box[T] = ev match {
    case Inc()  => b.Copy(N = b.N + 1)
    case Keep() => b
}

func viaPtr[T any](b *Box[T]) Box[T] = b.Copy(N = 0)

func hit[K comparable, V any](e Entry[K, V]) Entry[K, V] = e.Copy(Hits = e.Hits + 1)

func main() {
    // val-bound, concrete type arguments
    val c = Box(Item = "x", N = 1).Copy(N = 5)
    Println(s"val: ${c.Item} ${c.N}")

    // if-expression and match arms, in a generic function and inline
    val same = if (c.N > 3) c.Copy(N = 6) else c
    Println(s"if: ${same.N} ${pick(c, true).N} ${pick(c, false).N}")
    Println(s"match: ${step(c, Inc()).N} ${step(c, Keep()).N}")

    // pointer receiver: the address of a var
    var m = Box(Item = "m", N = 1)
    Println(s"ptr: ${viaPtr(&m).N}")

    // nested and multi-parameter generics
    val nested = Box(Item = ArrayOf(1, 2, 3), N = 0).Copy(N = 3)
    Println(s"nested: ${nested.Item.Size()} ${nested.N}")
    val e = hit(Entry[string, int](Key = "k", Value = 1, Hits = 0)).Copy(Value = 2)
    Println(s"multi: ${e.Key} ${e.Value} ${e.Hits}")

    // no overrides: the copy still types as Box[string]
    val plain = c.Copy()
    Println(s"no-override: ${plain.N} ${c.Copy().N}")

    // sealed variant
    val slot = Filled(5).Copy(Value = 9)
    Println(s"sealed: ${slot}")

    // cross-package generic struct
    val p = boxes.Pair[int, string](First = 1, Second = "s", Tag = "a").Copy(Tag = "b")
    Println(s"cross-pkg: ${p.First} ${p.Second} ${p.Tag} ${boxes.Retag(p, "c").Tag}")
}
-- examples/generic_struct_copy/boxes/boxes.gala --
package boxes

// Pair is a generic struct copied from another package in
// examples/generic_struct_copy.gala.
struct Pair[A any, B any](First A, Second B, Tag string)

// Retag copies inside the declaring package; the result keeps [A, B].
func Retag[A any, B any](p Pair[A, B], tag string) Pair[A, B] =
    if (tag == "") p else p.Copy(Tag = tag)
-- examples/generic_struct_extractor.gala --
package main

import "martianoff/gala/examples/generic_struct_extractor/cell"

// Struct extractor patterns on GENERIC structs. A pattern `Box(a, b)` against a
// Box[int] reads Box's own fields, typed by their declarations with the
// subject's type arguments substituted (Md Mode[T] -> Mode[int]). Nested
// constructor patterns inside such an extractor (sealed variants, nested
// structs, literals) are patterns against that substituted field type, never
// bindings of the constructor's name.

sealed type Mode[T any] {
    case A(Fn func(int) T)
    case B(Fn func(string) T)
}

struct Inner[T any](X T)
struct Box[T any](Md Mode[T], In Inner[T])
struct Pair[K any, V any](Key K, Val V)
struct Outer[T any](P Pair[string, T])

sealed type Shape {
    case Circle(R int)
    case Square(S int)
}

struct Holder(Sh Shape, N int)

// The extracted field keeps its declared type with T substituted: `md` is a
// Mode[int], so it can be matched exhaustively on its variants.
func modeName(b Box[int]) string = b match {
    case Box(md, _) => md match {
        case A(_) => "A"
        case B(_) => "B"
    }
    case _ => "none"
}

// Nested sealed variants inside a generic struct extractor.
func run(b Box[int]) int = b match {
    case Box(A(f), _) => f(10)
    case Box(B(g), _) => g("xy")
    case _            => -1
}

// A single-field generic struct matched on a type-parameter receiver.
func (b Box[T]) Inside() T = b.In match {
    case Inner(x) => x
    case _        => b.In.X
}

// Nested generic struct with a guard.
func classify(b Box[int]) string = b match {
    case Box(_, Inner(x)) if x > 5 => s"big $x"
    case Box(_, Inner(x))          => s"small $x"
    case _                         => "none"
}

// Two type parameters, each field typed by its own argument; a literal nested
// sub-pattern compares the key.
func describePair(p Pair[string, int]) string = p match {
    case Pair("answer", v) => s"the answer is $v"
    case Pair(k, v)        => s"$k=${v + 1}"
    case _                 => "none"
}

// A generic struct nested in a generic struct, both destructured at once.
func outerKey(o Outer[bool]) string = o match {
    case Outer(Pair(k, true)) => s"$k on"
    case Outer(Pair(k, _))    => s"$k off"
    case _                    => "none"
}

// The non-generic control: a nested variant inside a plain struct extractor.
func holderArea(h Holder) int = h match {
    case Holder(Circle(r), n) => r * r * n
    case Holder(Square(s), n) => s * s * n
    case _                    => -1
}

// A tuple pattern with a nested variant.
func tupleArea(t Tuple[Shape, int]) int = t match {
    case (Circle(r), n) => r * n
    case (Square(s), n) => s + n
    case _              => -1
}

// A generic struct from another package, imported qualified.
func doubled(c cell.Cell[int]) string = c match {
    case cell.Cell(v, tag) => s"$tag:${v * 2}"
    case _                 => "none"
}

func main() {
    val a = Box[int](Md = A[int]((x) => x + 1), In = Inner(X = 7))
    val b = Box[int](Md = B[int]((s) => s.Size()), In = Inner(X = 3))

    Println(modeName(a))
    Println(modeName(b))
    Println(run(a))
    Println(run(b))
    Println(a.Inside())
    Println(Box[string](Md = A[string]((x) => s"$x"), In = Inner(X = "hi")).Inside())
    Println(classify(a))
    Println(classify(b))

    Println(describePair(Pair[string, int](Key = "answer", Val = 42)))
    Println(describePair(Pair[string, int](Key = "k", Val = 1)))
    Println(outerKey(Outer[bool](P = Pair[string, bool](Key = "lamp", Val = true))))
    Println(outerKey(Outer[bool](P = Pair[string, bool](Key = "fan", Val = false))))

    Println(holderArea(Holder(Sh = Circle(2), N = 3)))
    Println(holderArea(Holder(Sh = Square(4), N = 2)))
    Println(tupleArea((Circle(5), 2)))
    Println(tupleArea((Square(5), 2)))

    Println(doubled(cell.Of(21, "n")))
}
-- examples/generic_struct_extractor/cell/cell.gala --
package cell

// Cell is a generic struct declared in its own package and imported qualified,
// so a consumer's `case cell.Cell(v, tag)` has to resolve the struct's field
// types from package metadata and substitute the subject's type arguments.
struct Cell[T any](Value T, Tag string)

// Of builds a Cell holding v under tag.
func Of[T any](v T, tag string) Cell[T] = Cell[T](Value = v, Tag = tag)
-- examples/generic_type_alias.gala --
package main

import (
    "errors"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/concurrent"
    "martianoff/gala/json"
    "martianoff/gala/yaml"
)

// A generic type alias names every instance of a generic type at once:
// `Result[int]` is `Either[AppError, int]`, and so on. It lowers to a Go
// generic alias, so the alias and the type it names are one type, and the
// alias stands for its target everywhere: constructors typed from an
// expected type, match subjects, method calls, struct fields, collection
// elements, codecs and concurrency boundaries.

struct AppError(Code int, Msg string)

type Result[T any] Either[AppError, T]
type Res[T any] Try[T]
type Res2[T any] Res[T]
type Pairs[K comparable, V any] Array[Tuple[K, V]]
type StrMap[V any] HashMap[string, V]
type Handler[T any] func(string) Result[T]
type Maybe[T any] Option[T]
type Items[T any] Array[T]

type Labeled interface {
    Label() string
}

struct Tag(Name string)

func (t Tag) Label() string = "#" + t.Name

type Labels[L Labeled] Array[L]

struct Order(Id int, Note Maybe[string], Lines Items[int], Meta StrMap[string])

func parse(s string) Result[int] = if (s == "") Left(AppError(1, "empty")) else Right(s.Size())

func describe(r Result[int]) string = r match {
    case Right(v) => s"ok $v"
    case Left(e) => s"error ${e.Code}: ${e.Msg}"
}

func half(n int) Res2[int] = if (n % 2 == 0) Success(n / 2) else Failure(errors.New(s"$n is odd"))

func showRes[T any](r Res[T]) string = r match {
    case Success(v) => s"success $v"
    case Failure(e) => s"failure ${e.Error()}"
}

func run[T any](h Handler[T], input string) Result[T] = h(input)

func labels[L Labeled](ls Labels[L]) string = ls.Map(_.Label()).MkString(" ")

func noCounts() StrMap[int] = EmptyHashMap()

func main() {
    Println(describe(parse("four")))
    Println(describe(parse("")))
    Println(showRes(half(10)))
    Println(showRes(half(3)))

    val ps Pairs[string, int] = ArrayOf(("a", 1), ("b", 2))
    Println(ps.Map((p) => s"${p.V1}=${p.V2}").MkString(", "))

    val counts StrMap[int] = HashMapOf(("x", 1))
    Println(s"${counts.Put("y", 2).Size()} ${noCounts().IsEmpty()}")

    val results Array[Result[int]] = ArrayOf(parse("ab"), parse(""))
    Println(results.Map(describe).MkString(" | "))

    val doubled Handler[int] = (s) => parse(s + s)
    Println(describe(run(doubled, "hello")))

    val r Res[int] = Success(20)
    Println(r.Map(_ + 1).GetOrElse(0))

    Println(labels(ArrayOf(Tag("go"), Tag("gala"))))

    val order = Order(7, Some("rush"), ArrayOf(3, 4), HashMapOf(("by", "web")))
    val jsonCodec = json.Codec[Order](json.SnakeCase())
    val body = jsonCodec.Encode(order).Get()
    Println(body)
    Println(jsonCodec.Decode(body).Map(_.Lines.Size()))
    val yamlCodec = yaml.Codec[Order](yaml.SnakeCase())
    Println(yamlCodec.Encode(order).FlatMap(yamlCodec.Decode).Map(_.Note.GetOrElse("")))
    Println(json.Value[Items[int]]().Encode(ArrayOf(1, 2)))

    val shared = Future(s"${ps.Size()} ${order.Lines.Size()}")
    Println(shared.Get())
}
-- examples/generic_type_param_none.gala --
package main

// Inside a generic function or method, a bare `None()` takes its type
// argument from a result type that names the declaration's own type
// parameters (or its receiver's): `Option[U]` gives `None[U]`. Methods and
// functions behave the same.

struct Box[T any](V T, Enabled bool)

// Method: an early `return None()` guard in a FlatMap lambda whose trailing
// value calls a function-typed parameter.
func (b Box[T]) Lift[U any](f func(T) Option[U]) Option[U] = Some(b.V).FlatMap((v) => {
    if (!b.Enabled) {
        return None()
    }
    f(v)
})

// Function: the same shape.
func lift[T any, U any](
    t T,
    enabled bool,
    f func(T) Option[U],
) Option[U] = Some(t).FlatMap((v) => {
    if (!enabled) {
        return None()
    }
    f(v)
})

// Method: `return None()` typed by the receiver's type parameter.
func (b Box[T]) Value() Option[T] {
    if (!b.Enabled) {
        return None()
    }
    return Some(b.V)
}

// Function: `return None()` typed by the function's type parameter.
func firstOf[U any](enabled bool, o Option[U]) Option[U] {
    if (!enabled) {
        return None()
    }
    return o
}

// Method: `None()` in a match arm typed by the method's own type parameter.
func (b Box[T]) Keep[U any](o Option[U]) Option[U] = o match {
    case Some(u) if b.Enabled => Some(u)
    case _ => None()
}

func main() {
    val half = (x int) => When(x % 2 == 0, x / 2)
    Println(s"method lift on: ${Box(8, true).Lift(half)}")
    Println(s"method lift off: ${Box(8, false).Lift(half)}")
    Println(s"method lift odd: ${Box(7, true).Lift(half)}")
    Println(s"function lift on: ${lift(8, true, half)}")
    Println(s"function lift off: ${lift(8, false, half)}")
    Println(s"method value: ${Box("k", true).Value()} ${Box("k", false).Value()}")
    Println(s"function first: ${firstOf(true, Some(3))} ${firstOf(false, Some(3))}")
    Println(s"method keep: ${Box(1, true).Keep(Some("x"))} ${Box(1, false).Keep(Some("x"))}")
}
-- examples/generic_wrap_match.gala --
package main

import "fmt"

// 1. Define a generic type
type Wrap[T any] struct {
    Value T
}
func (w Wrap[T]) GetValue() any = w.Value

// 3. Define a generic extractor object
type Wrapper[T any] struct {}
func (w Wrapper[T]) Apply(v T) Wrap[T] = Wrap[T](Value = v)
func (w Wrapper[T]) Unapply(o Wrap[T]) Option[T] = Some[T](o.Value)

func main() {
    // Case 1: Matching specific generic type
    val w1 = Wrap[int](Value = 42)
    val res1 = w1 match {
        case w: Wrap[int] => fmt.Sprintf("Matched Wrap[int]: %d", w.Value)
        case w: Wrap[string] => "Matched Wrap[string]: " + w.Value
        case _ => "Other"
    }
    fmt.Println(res1)

    // Case 2: Matching another specific generic type
    val w2 = Wrap[string](Value = "hello")
    val res2 = w2 match {
        case w: Wrap[int] => fmt.Sprintf("Matched Wrap[int]: %d", w.Value)
        case w: Wrap[string] => "Matched Wrap[string]: " + w.Value
        case _ => "Other"
    }
    fmt.Println(res2)

    // Case 3: Matching wildcard generic type via generated interface
    val w3 = Wrap[string](Value = "hello")
    val res3 = w3 match {
        case w: Wrap[_] => fmt.Sprintf("Matched Wrap[_]: %v", w.GetValue())
        case _ => "Other"
    }
    fmt.Println(res3)

    // Case 4: Using the generic extractor
    val w4 = Wrapper(100)
    val res4 = w4 match {
        case Wrapper(i: int) => fmt.Sprintf("Extracted int: %d", i)
        case Wrapper(s: string) => "Extracted string: " + s
        case _ => "Other"
    }
    fmt.Println(res4)

    // Case 5: Using the generic extractor with another type
    val w5 = Wrapper("GALA")
    val res5 = w5 match {
        case Wrapper(i: int) => fmt.Sprintf("Extracted int: %d", i)
        case Wrapper(s: string) => "Extracted string: " + s
        case _ => "Other"
    }
    fmt.Println(res5)

    // Case 6: Using the generic extractor with wildcard generic type
    val w6 = Wrapper("GALA")
    val res6 = w6 match {
        case Wrapper(v: _) => fmt.Sprintf("Extracted %v of type %T", v, v)
        case _ => "Other"
    }
    fmt.Println(res6)
}
-- examples/get_generic_pointer_receiver.gala --
package main

// A user-defined `Get()` method on a generic receiver, called from generic code
// where the receiver's type argument is still a type parameter. The result of
// `b.Get()` is `T` — not the receiver type — for both pointer and value
// receivers, so it flows into `Some(v)`, arithmetic and string interpolation
// with its real type. A Go type's own `Get` method is typed from Go type info.

import "net/url"

struct Box[T any](Value T)

func (b *Box[T]) Get() T = b.Value

struct Cell[T any](Value T)

func (c Cell[T]) Get() T = c.Value

struct Slot[T any](Value T)

func (s *Slot[T]) Get() Option[T] = Some(s.Value)

func viaPointer[T any](b *Box[T], fallback T) T {
    val v = b.Get()
    return Some(v).GetOrElse(fallback)
}

func viaValue[T any](c Cell[T], fallback T) T {
    val v = c.Get()
    return Some(v).GetOrElse(fallback)
}

func viaPointerOption[T any](s *Slot[T]) string =
    s.Get().Map((v) => s"slot holds $v").GetOrElse("empty slot")

// url.Values.Get returns a string, so the lambda's result is the value's size.
func queryValueSize(raw string) int =
    Try(url.ParseQuery(raw)).Map((q) => q.Get("a").Size()).GetOrElse(-1)

func main() {
    var b = Box(41)
    Println(viaPointer(&b, 0) + 1)

    Println(viaValue(Cell("cell"), "fallback"))

    var s = Slot(true)
    Println(viaPointerOption(&s))

    Println(queryValueSize("a=hello&b=x"))
}
-- examples/go_call_results.gala --
package main

import (
    "fmt"
    "math"
    "net"
    "os"
    "path/filepath"
    "strconv"
    "strings"
)

// A Go function that returns several results is one GALA value:
//
//   (T, error)     -> Try[T]
//   (A, B)         -> Tuple[A, B]
//   (A, B, C)      -> Tuple3[A, B, C]
//   (A, B, error)  -> Try[Tuple[A, B]]
//
// A Go function that returns only an `error` gives that error as a value;
// Try(...) turns a non-nil one into a Failure.

// (T, error) as a match subject.
func parsePort(text string) string = strconv.Atoi(text) match {
    case Success(n) if n > 0 && n < 65536 => s"port $n"
    case Success(n) => s"out of range: $n"
    case Failure(_) => s"not a number: $text"
}

// (T, error) as a function result, and chained with Map.
func doubled(text string) Try[int] = strconv.Atoi(text).Map((n) => n * 2)

// (T, error) as an argument.
func describe(result Try[int]) string = result match {
    case Success(n) => s"ok $n"
    case Failure(_) => "failed"
}

// (A, B, error) is a Try of a Tuple, so a tuple pattern applies inside Success.
func splitAddr(addr string) string = net.SplitHostPort(addr) match {
    case Success((host, port)) => s"host=$host port=$port"
    case Failure(_) => s"bad address: $addr"
}

// (A, B, C) is a Tuple3; `val (...)` destructures it.
func setting(line string) string {
    val (key, value, found) = strings.Cut(line, "=")
    if (found) s"$key -> $value" else s"$key has no value"
}

// (A, B) is a Tuple.
func parts(x float64) string {
    val split = math.Modf(x)
    s"whole=${split.V1} frac=${split.V2}"
}

// A multi-name binding still takes the results one by one, Go-style.
func goStyle(text string) string {
    val n, err = strconv.Atoi(text)
    if (err == nil) s"n=$n" else "err"
}

// Several steps that can fail, sequenced with bind.
func sum(a string, b string) Try[int] {
    bind x = strconv.Atoi(a)
    bind y = strconv.Atoi(b)
    Success(x + y)
}

struct Parsed(Input string, Value Try[int])

func main() {
    Println(parsePort("8080"))
    Println(parsePort("70000"))
    Println(parsePort("http"))
    Println(doubled("21"))
    Println(describe(strconv.Atoi("5")))
    Println(describe(strconv.Atoi("five")))
    Println(splitAddr("localhost:8080"))
    Println(splitAddr("localhost"))
    Println(setting("mode=fast"))
    Println(setting("verbose"))
    Println(parts(3.25))
    Println(goStyle("7"))
    Println(sum("2", "3"))
    Println(sum("2", "x").IsFailure())

    // (T, error) bound to a name, then read with GetOrElse and Get.
    val n = strconv.Atoi("40")
    Println(n.GetOrElse(0) + 2)
    Println(strconv.Atoi("oops").GetOrElse(-1))

    // In an if-expression branch, a lambda body and a struct field.
    val pick = if (n.IsSuccess()) strconv.Atoi("1") else strconv.Atoi("2")
    val parse = (s string) => strconv.Atoi(s)
    Println(pick, parse("9"), Parsed("12", strconv.Atoi("12")).Value)

    // Try over a Go call is the same Try, not a Try inside a Try.
    Println(Try(strconv.Atoi("3")))

    // An error-only call: FromError or Try make it a Try[Void].
    val missing = filepath.Join(os.TempDir(), "gala-go-call-results-missing")
    Println(FromError(os.Remove(missing)).IsFailure())
    Println(Try(os.Remove(missing)).IsFailure())

    // Nothing reads a statement's value, so its Go calls are made as they
    // are: this if-expression is an if statement.
    if (n.IsSuccess()) fmt.Println("statement if") else fmt.Println("not reached")
}
-- examples/go_func_void_lambda.gala --
package main

import (
    "fmt"
    "net"
    "time"
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
)

// Lambda passed to Go function expecting func() should generate func(),
// not func() <return-type-of-body>. This verifies that the transpiler correctly
// detects void function parameters from Go type info.

func main() {
    // Case 1: go_interop.Spawn with block lambda
    go_interop.Spawn(() => {
        fmt.Println("block lambda spawn")
    })
    time.Sleep(50 * time.Millisecond)

    // Case 2: go_interop.Spawn with expression lambda
    go_interop.Spawn(() => fmt.Println("expression lambda spawn"))
    time.Sleep(50 * time.Millisecond)

    // Case 3: SpawnWithRecover via qualified call
    // First param func() is void, second param func(any) is also void
    go_interop.SpawnWithRecover(
        () => fmt.Println("spawn with recover"),
        (err any) => fmt.Println(s"recovered: $err"),
    )
    time.Sleep(50 * time.Millisecond)

    // Case 4: Spawn with FromError — the idiomatic GALA pattern for
    // Go functions returning error in void context
    go_interop.Spawn(() => {
        // net.Listen returns (net.Listener, error) — Try handles (T, error)
        // For error-only functions, use FromError
        val listener = Try(() => net.Listen("tcp", "127.0.0.1:0"))
        listener.OnSuccess((l net.Listener) => {
            FromError(l.Close()).OnFailure((err) => fmt.Println(s"close error: $err"))
            fmt.Println("listener opened and closed")
        }).OnFailure((err) => fmt.Println(s"listen error: $err"))
    })
    time.Sleep(50 * time.Millisecond)

    Println("done")
}
-- examples/go_generic_lambda_return.gala --
package main

import "martianoff/gala/go_interop"

// A lambda whose body calls a Go generic function must be annotated with the
// callee's INSTANTIATED return type. The transpiler used to copy the Go
// signature's declared return type verbatim (`map[K]V`, `[]T`), so the
// generated Go named the callee's own type parameters as undefined identifiers
// (`undefined: K`, `undefined: V`, `undefined: T`).
//
// A direct call never showed the bug because nothing forces the type into the
// output; a lambda does, because its result clause has to be written down.

func apply[A any](body func() A) A = body()

func main() {
    val m = go_interop.MapEmpty[string, int]()

    // map[K]V return inside a bare lambda
    val putOne = () => go_interop.MapPut(m, "k", 1)
    Println(go_interop.MapLen(putOne()))

    // []T return inside a bare lambda
    val xs = go_interop.SliceOf(1, 2, 3)
    val appended = () => go_interop.SliceAppend(xs, 4)
    Println(appended().Size())

    // Same shapes routed through a user generic combinator
    Println(go_interop.MapLen(apply(() => go_interop.MapPut(m, "k", 1))))
    Println(apply(() => go_interop.SliceAppend(xs, 4)).Size())

    // Nested: the element type comes from an inner generic call
    val grown = () => go_interop.SliceAppendAll(xs, go_interop.SliceOf(4, 5))
    Println(grown().Size())
}
-- examples/go_generic_multireturn_destructure.gala --
package main

import "martianoff/gala/go_interop"

// Destructuring a Go generic's multi-value return must bind each name to the
// call's INSTANTIATED return type. The transpiler used to bind the callee's
// DECLARED type parameter instead: `val v, ok = go_interop.MapGet(m, "a")` gave
// `v` the type `V` from
// `func MapGet[K comparable, V any](m map[K]V, k K) (V, bool)`.
//
// Nothing complained at the binding, and any use that does not pin a type —
// string interpolation, Println — kept working. The build broke only once the
// value reached a position needing a concrete type, naming a type parameter the
// user never wrote (`undefined: V`) at a line that was not the cause.
//
// Reading a Go map and lifting the (value, found) pair into an Option is the
// idiomatic thing to do with it, so this shape is the common one.
//
// Every route below reaches the map differently, because instantiation depends
// on the ARGUMENT's type resolving: a map read out of a struct field also
// needed `map[K]V` to survive the AST-to-type round trip, which it did not.

type Index struct {
    entries map[string]int
}

// The map comes from a receiver field.
func (ix Index) Lookup(key string) Option[int] {
    val v, ok = go_interop.MapGet(ix.entries, key)
    if ok {
        return Some(v)
    }
    return None[int]()
}

// The map is copied to a local first.
func (ix Index) LookupViaLocal(key string) Option[int] {
    val entries = ix.entries
    val v, ok = go_interop.MapGet(entries, key)
    return When(ok, v)
}

// The map comes from a struct passed as a parameter.
func lookupField(ix Index, key string) Option[int] {
    val v, ok = go_interop.MapGet(ix.entries, key)
    return When(ok, v)
}

// The map itself is the parameter.
func lookupIn(m map[string]int, key string) Option[int] {
    val v, ok = go_interop.MapGet(m, key)
    return When(ok, v)
}

func main() {
    val m = go_interop.MapPut(go_interop.MapEmpty[string, int](), "a", 1)
    val ix = Index{entries: m}

    // The reported repro: bind, then box. Boxing is what used to fail.
    val v, ok = go_interop.MapGet(m, "a")
    Println(s"interpolated: $v ok=$ok")
    Println(Some(v))

    // Explicit type arguments at the call site must instantiate the same way.
    val ev, eok = go_interop.MapGet[string, int](m, "a")
    Println(s"${Some(ev)} $eok")

    Println(ix.Lookup("a"))
    Println(ix.Lookup("missing"))
    Println(ix.LookupViaLocal("a"))
    Println(lookupField(ix, "a"))
    Println(lookupIn(m, "a"))
    Println(lookupIn(m, "missing"))

    // The bound value is a real int, not an opaque one: it has to match and
    // arithmetic on it has to type-check.
    Some(v) match {
        case Some(n) => Println(s"found ${n + 41}")
        case None()  => Println("absent")
    }
}
-- examples/go_generic_option_lambda_return.gala --
package main

import "martianoff/gala/go_interop"
import . "martianoff/gala/resource"

// `resource.WithLock(mu, () => …)` is the prescribed way to hold a mutex, and
// `go_interop.OptionFromMap` is the sanctioned nil-safe bridge for reading a
// possibly-nil Go map into an Option. Composing them is the obvious way to write
// a locked map read.
//
// OptionFromMap is a Go generic returning a GALA std sealed type
// (`std.Option[V]`), so a lambda over it forces the transpiler to write that
// return type down. It used to emit unparseable Go and abort the build.

func apply[A any](body func() A) A = body()

func main() {
    val mu = go_interop.NewMutex()
    val m = go_interop.MapPut(go_interop.MapEmpty[string, int](), "k", 7)

    // The documented lock-combinator idiom
    Println(WithLock(mu, () => go_interop.OptionFromMap(m, "k")))
    Println(WithLock(mu, () => go_interop.OptionFromMap(m, "missing")))

    // Bare lambda, no combinator
    val look = () => go_interop.OptionFromMap(m, "k")
    Println(look())

    // Routed through a user generic combinator
    Println(apply(() => go_interop.OptionFromMap(m, "missing")))

    // The recovered type must be a real Option[int], not an opaque value:
    // pattern matching over it has to bind a concrete `v`.
    apply(() => go_interop.OptionFromMap(m, "k")) match {
        case Some(v) => Println(s"found ${v}")
        case None()  => Println("absent")
    }
}
-- examples/go_generic_struct_dot_import.gala --
package main

import . "martianoff/gala/examples/go_generic_struct_bridge"

// Verifies that GALA named-argument construction works for generic
// Go-style block-form structs declared in a dot-imported package.
// Previously the validator's dot-import fallback only matched bare
// *ast.Ident, so generic call targets like `Container[int]` (an
// *ast.IndexExpr) and `Pair[string, int]` (an *ast.IndexListExpr) fell
// through to "named arguments only supported for Copy method or struct
// construction".

func main() {
    val box = Box(Title = "hello")
    Println(box.Render())

    val container = Container[int](Value = 42)
    Println(container.Render())

    val pair = Pair[string, int](First = "answer", Second = 42)
    Println(pair.Render())
}
-- examples/go_generic_struct_dot_import_only_generic.gala --
package main

import . "martianoff/gala/examples/qa_lib_bridge"

// Verifies that a dot-import is preserved in generated Go even when the
// GALA file references ONLY a generic instantiation from that package
// (no non-generic anchor). The pruning scan must descend through
// *ast.IndexExpr (`Single[int]`) wrappers; if it only matched bare
// *ast.Ident the import would be pruned and the generated Go would fail
// to compile with `undefined: Single`.

func main() {
    val s = Single[int]("g", 42)
    Println(s.Render())
}
-- examples/go_method_multi_results.gala --
package main

import "martianoff/gala/examples/warehouse_bridge"

// A Go METHOD returning several results is one GALA value, exactly like a Go
// function: (T, error) is a Try[T], (A, B) is a Tuple[A, B].

// Value receiver, (T, error), as a match subject.
func takeFrom(box warehouse_bridge.Box, qty int) string = box.Take(qty) match {
    case Success(left) => s"took $qty, $left left"
    case Failure(err) => s"cannot take: ${err.Error()}"
}

// Pointer receiver, (T, error), bound first and matched later.
func reserve(inv *warehouse_bridge.Inventory, sku string, qty int) string {
    val reserved = inv.Reserve(sku, qty)
    reserved match {
        case Success(left) => s"reserved $qty $sku, $left left"
        case Failure(err) => s"cannot reserve: ${err.Error()}"
    }
}

// Pointer receiver, (T, bool), destructured as a Tuple.
func describe(inv *warehouse_bridge.Inventory, sku string) string {
    val (item, found) = inv.Find(sku)
    if (found) s"${item.SKU} x${item.Qty}" else s"$sku not stocked"
}

// Error-only method: the error itself, turned into a Try by FromError.
func check(inv *warehouse_bridge.Inventory, sku string) string = FromError(inv.Check(sku)) match {
    case Success(_) => s"$sku is known"
    case Failure(err) => s"check failed: ${err.Error()}"
}

func main() {
    val box = warehouse_bridge.Box(N = 3)
    Println(takeFrom(box, 2))
    Println(takeFrom(box, 5))

    val inv = warehouse_bridge.New()
    Println(reserve(inv, "apple", 2))
    Println(reserve(inv, "pear", 4))
    Println(reserve(inv, "plum", 1))

    Println(describe(inv, "apple"))
    Println(describe(inv, "plum"))

    Println(check(inv, "pear"))
    Println(check(inv, "plum"))

    // A method chained off a constructor call.
    val (fresh, stocked) = warehouse_bridge.New().Find("pear")
    Println(s"fresh pear stocked=$stocked qty=${fresh.Qty}")

    // A method's (T, error) used through Try's own methods.
    Println(warehouse_bridge.New().Reserve("apple", 1).Map((left) => left * 10).GetOrElse(-1))

    // (A, B) without an error, destructured.
    val (low, high) = inv.Split("apple")
    Println(s"split apple: $low + $high")

    // The free function of the same shape, for comparison.
    Println(warehouse_bridge.FreeReserve(4).GetOrElse(-1))
}
-- examples/go_multi_result_callbacks.gala --
package main

import (
    "errors"
    "io"
    "os"
    "strconv"
    "sync"
    . "martianoff/gala/go_interop"
    "martianoff/gala/examples/callback_bridge"
)

// A lambda passed where Go expects a function with several results computes
// their one GALA value — a Try for (T, error), a Tuple for (A, B) — and Go
// receives the results. A body that is a Go call with those results returns
// them as they are.

func lookup(name string) Option[string] = name match {
    case "home" => Some("/root")
    case "shell" => Some("/bin/sh")
    case _ => None()
}

// A GALA function can take such a callback too.
func twice(f func() (int, error)) Try[int] = f().Map((n) => n * 2)

func opened(f func() (io.Reader, error)) Try[io.Reader] = f()

func main() {
    // func() (int, error), filled by a lambda
    Println(callback_bridge.RunWith(() => strconv.Atoi("5")))
    // or by a bare expression, as for any function with no parameters
    Println(callback_bridge.RunWith(strconv.Atoi("five")))
    Println(callback_bridge.RunWith(Success(7)))
    Println(callback_bridge.RunWith(() => {
        val n = strconv.Atoi("20")
        n.Map((k) => k + 1)
    }))

    // func(string) (string, bool)
    Println(callback_bridge.Describe(SliceOf("home", "shell", "editor"), (name) => lookup(name) match {
        case Some(v) => (v, true)
        case None() => ("", false)
    }))

    // func(int) (string, int, error)
    Println(callback_bridge.Retry(3, (attempt) =>
        if (attempt < 2) Failure(errors.New(s"attempt $attempt failed"))
        else Success(("ok", attempt * 10))))
    Println(callback_bridge.Retry(2, (attempt) => Failure(errors.New(s"attempt $attempt failed"))))

    // A generic Go function takes its type arguments from the lambda's results.
    val port = sync.OnceValues(() => strconv.Atoi("8080"))
    val p, err = port()
    Println(s"$p ${err == nil}")
    // A call of the function it returns is one value, like a Go call.
    Println(port().Map((n) => n + 1))
    val answer = sync.OnceValue(42)
    Println(answer())

    Println(twice(strconv.Atoi("21")))
    Println(twice(sync.OnceValues(strconv.Atoi("x"))))
    // A bare expression takes the slot's own result types, so a Go call
    // whose results are assignable to them fills it.
    Println(opened(os.Open("no-such-file")).IsFailure())
}
-- examples/go_multi_result_methods.gala --
package main

import (
    "encoding/json"
    "errors"
    "fmt"
    "strconv"
    "strings"
    . "martianoff/gala/go_interop"
)

// A function or method can declare Go's result list, so a GALA type
// implements a Go interface whose methods return several results. The body
// computes their one GALA value: (T, error) is a Try[T], (A, B) a Tuple[A, B].

// io.Writer: Write(p []byte) (n int, err error). fmt.Fprintf writes to it.
struct LineCounter(var Lines int, var Bytes int, Limit int)

func (c *LineCounter) Write(p []byte) (int, error) {
    if (c.Bytes + p.Size() > c.Limit) {
        return Failure(errors.New(s"over the ${c.Limit}-byte limit"))
    }
    c.Lines = c.Lines + 1
    c.Bytes = c.Bytes + p.Size()
    Success(p.Size())
}

// json.Marshaler: MarshalJSON() ([]byte, error). json.Marshal calls it.
struct Celsius(Degrees int)

func (c Celsius) MarshalJSON() ([]byte, error) =
    if (c.Degrees < -273) Failure(errors.New("below absolute zero"))
    else Success(ToBytes(s"\"${c.Degrees}C\""))

// A GALA interface can declare such a method too.
type Parser interface {
    Parse(s string) (int, error)
}

struct Radix(Base int)

// The body is any expression of the results' value.
func (r Radix) Parse(s string) (int, error) = strconv.ParseInt(s, r.Base, 64).Map((n) => int(n))

// (A, B): a Tuple.
func divmod(a int, b int) (int, int) = (a / b, a % b)

// (A, B, error): a Try of a Tuple.
func splitPair(s string) (string, int, error) {
    val (key, value, found) = strings.Cut(s, ":")
    if (found) strconv.Atoi(value).Map((n) => (key, n))
    else Failure(errors.New(s"no ':' in $s"))
}

// A method of a generic type, with type parameters of its own.
struct Labeled[T any](Label string, Value T)

func (l Labeled[T]) Unpack() (string, T) = (l.Label, l.Value)

func (l Labeled[T]) Zip[U any](u U) (T, U) = (l.Value, u)

func main() {
    var counter = LineCounter(0, 0, 16)
    fmt.Fprintf(&counter, "hello %s", "go")
    fmt.Fprintln(&counter, "!")
    Println(s"lines=${counter.Lines} bytes=${counter.Bytes}")
    val n, err = fmt.Fprintf(&counter, "%s", "this does not fit")
    Println(s"wrote $n, error: ${err.Error()}")

    // Called from GALA, such a method is one value, like a Go call.
    Println(counter.Write(ToBytes("ok")))

    Println(json.Marshal(Celsius(21)).Map((b) => b.Size()))
    Println(json.Marshal(Celsius(-300)) match {
        case Success(_) => "marshalled"
        case Failure(e) => s"failed: ${e.Error()}"
    })

    val p Parser = Radix(16)
    Println(p.Parse("ff"))
    Println(p.Parse("zz").IsFailure())

    val (q, r) = divmod(17, 5)
    Println(s"17 = 5 * $q + $r")
    Println(splitPair("port:8080"))
    Println(splitPair("port"))
    // Several names take the results one by one, as from a Go call.
    val key, value, splitErr = splitPair("x:1")
    Println(s"$key $value ${splitErr == nil}")
    // Held as a value, such a function is called as it is by name.
    val split = splitPair
    Println(split("y:2"))
    val parseDecimal = Radix(10).Parse
    Println(parseDecimal("42"))

    val label = Labeled("answer", 42)
    val (name, answer) = label.Unpack()
    Println(s"$name=$answer")
    Println(label.Zip(true))
}
-- examples/go_named_func_type_slots.gala --
package main

import (
    "io/fs"
    "net/http"
)

// A lambda in a slot typed by a Go named function type takes the type's
// underlying signature: a parameter, a val annotation, a result, a struct
// field, and the branches of an if-expression.

struct Walker(Fn fs.WalkDirFunc)

func visit(f fs.WalkDirFunc) bool = f(".", nil, nil) == nil

func skipAll() fs.WalkDirFunc = (path, d, err) => fs.SkipAll

func pick(skip bool) fs.WalkDirFunc = if (skip) (path, d, err) => fs.SkipAll else (path, d, err) => err

func main() {
    Println(visit((path, d, err) => err))

    val keep fs.WalkDirFunc = (path, d, err) => err
    Println(keep(".", nil, nil) == nil)

    val walker = Walker(Fn = (path, d, err) => err)
    Println(walker.Fn(".", nil, nil) == nil)

    Println(skipAll()(".", nil, nil) == fs.SkipAll)
    Println(pick(true)(".", nil, nil) == fs.SkipAll)

    val handler http.HandlerFunc = (w, r) => w.WriteHeader(204)
    Println(handler != nil)
}
-- examples/go_pkg_shares_gala_name/gala_side.gala --
package main

import (
    gs "martianoff/gala/strings"
    "martianoff/gala/io"
    "strings"
)

// GALA's `strings` (aliased) and `io` (unaliased), whose package names match
// the Go packages main.gala imports. This file also imports Go's `strings`
// after the GALA one: the generic `Fold` on GALA's `Str` must still be
// emitted against `gs`, not against Go's `strings`.

func shout(s string) string = gs.ToUpper(strings.TrimSpace(s))

func runeCount(s string) int = gs.S(s).Fold(0, (n, c) => n + 1)

func effectValue() int = io.Of(42).UnsafeRun()
-- examples/go_pkg_shares_gala_name/main.gala --
package main

import (
    "io"
    "strings"
    . "martianoff/gala/go_interop"
)

// This file uses Go's `strings` and `io` in signatures, a struct field and a
// sealed variant. The sibling gala_side.gala imports GALA's packages of the same
// names; that must not change what `strings` and `io` mean in this file.

// Report collects output in a Go strings.Builder.
struct Report(out *strings.Builder)

// Sink is where emit sends a line.
sealed type Sink {
    case ToBuilder(sb *strings.Builder)
    case Discard()
}

func appendLine(sb *strings.Builder, line string) *strings.Builder {
    sb.WriteString(line)
    sb.WriteString(";")
    return sb
}

func emit(sink Sink, line string) string = sink match {
    case ToBuilder(sb) => appendLine(sb, line).String()
    case Discard() => "(discarded)"
}

func readAll(r io.Reader) Try[string] = Try(io.ReadAll(r)).Map(ToString)

func main() {
    var out strings.Builder
    val report = Report(out = &out)
    appendLine(report.out, shout("  gala "))
    appendLine(report.out, s"runes=${runeCount("héllo")}")
    Println(report.out.String())

    var sb strings.Builder
    Println(emit(ToBuilder(&sb), "to builder"))
    Println(emit(Discard(), "dropped"))

    Println(readAll(strings.NewReader(s"io=${effectValue()}")).GetOrElse("read failed"))
}
