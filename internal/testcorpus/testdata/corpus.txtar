-- examples/if_expr_lambda_return_type.gala --
package main

import . "martianoff/gala/std"
import . "martianoff/gala/collection_immutable"

struct TickerState[T any](
    Tag  string,
    Make func() T,
)

// Method on a generic struct returning Self type. This call shape often
// trips up HM-based type inference because the receiver is the same type
// as the result.
func (st TickerState[T]) Advance() TickerState[T] =
    TickerState[T](Tag = "armed", Make = st.Make)

func (st TickerState[T]) IsDue() bool = st.Tag == "due"

// Expression-bodied if-expression where both arms have the same generic
// type but the LUB is computed on identifiers + method calls. The lambda
// is passed to a generic Map[U] whose U is inferred from the body.
func dispatchDueTicks[T any](states Array[TickerState[T]]) Array[TickerState[T]] {
    return states.Map((st) =>
        if (st.IsDue()) st.Advance() else st)
}

func main() {
    val s1 = TickerState[int](Tag = "armed", Make = () => 1)
    val s2 = TickerState[int](Tag = "due",   Make = () => 2)
    val states = ArrayOf(s1, s2)
    val next = dispatchDueTicks(states)
    next.ForEach((st) => Println(st.Tag))
}
-- examples/if_expr_return_generic.gala --
package main

import (
    "time"
    . "martianoff/gala/std"
)

func parseTime(s string) Option[time.Time] {
    val t, err = time.Parse(time.RFC3339, s)
    val ok = err == nil
    return if (ok) Some(t) else None[time.Time]()
}

func main() {
    val result = parseTime("2024-01-15T10:30:00Z")
    result match {
        case Some(t) => Println(t.Format("2006-01-02"))
        case _ => Println("invalid")
    }

    val result2 = parseTime("not-a-date")
    result2 match {
        case Some(t) => Println(t.Format("2006-01-02"))
        case _ => Println("invalid (expected)")
    }
}
-- examples/if_expr_trailing_match.gala --
package main

// An if-expression followed by a match: the match applies to the
// if-expression's value, in every position the value can be lowered in.
// tco_match_self_call covers the tail-recursive forms.

func name(c bool) string {
    val s string = if (c) { 1 } else { 2 } match {
        case 1 => "one"
        case _ => "other"
    }
    s
}

func show(s string) string = s"<$s>"

// In statement position the match is a statement-position match.
func say(c bool) {
    if (c) { 1 } else { 2 } match {
        case 1 => Println("say one")
        case _ => Println("say other")
    }
}

// A self call under an if-expression nested in an else branch and followed
// by a match is not in tail position: the match runs on every level.
func h(n int) int = if (n > 5) 1 else if (n > 0) h(n - 1) else { 0 } match {
    case 0 => 7
    case x => x
}

func main() {
    Println(name(true))
    Println(name(false))
    Println(show(if (true) { 2 } else { 1 } match {
        case 1 => "first"
        case _ => "second"
    }))
    say(true)
    say(false)
    Println(h(3))
}
-- examples/if_expr_unit_func_param.gala --
package main

// A lambda that takes a `func()` and comes out of an if-expression or a
// match: the transpiler spells the value's type, func(func()), into Go.

func main() {
    val loud = true
    val cb =
        if (loud)
            ((f func()) => f())
        else
            ((f func()) => {})
    cb(Println("called"))

    val pick = 2 match {
        case 1 => (f func(), g func()) => f()
        case _ => (f func(), g func()) => g()
    }
    pick(Println("first"), Println("second"))

    val thunk = if (loud) Some(() => Println("in option")) else Some(() => {})
    thunk.ForEach((f) => f())
}
-- examples/if_expression_block.gala --
package main

func main() {
    val x = 5

    // If-expression with bare expressions (existing syntax)
    val a = if (x > 3) "big" else "small"
    Println(a)

    // If-expression with block branches (new syntax)
    val b = if (x > 3) {
        val prefix = "very"
        s"$prefix big"
    } else {
        "small"
    }
    Println(b)

    // Mixed: one block, one expression
    val c = if (x > 10) {
        val doubled = x * 2
        s"doubled: $doubled"
    } else "not doubled"
    Println(c)

    // Block with multiple statements
    val d = if (x > 0) {
        val step1 = x + 1
        val step2 = step1 * 2
        step2
    } else {
        0
    }
    Println(d)
}
-- examples/if_iife_terminating_branches.gala --
package main

import . "martianoff/gala/collection_immutable"

struct Item(val Name string)

func emptyHint() Item = Item(Name = "empty")
func Header() Item = Item(Name = "header")

func buildRows(items Array[Item]) Array[Item] = items

func panel(items Array[Item]) Array[Item] {
    val children = if (items.IsEmpty()) {
        return ArrayOf[Item](emptyHint())
    } else {
        val rows = buildRows(items)
        return ArrayOf[Item](Header()).AppendAll(rows)
    }
    return children
}

func main() {
    val empty = panel(EmptyArray[Item]())
    Println(empty.Get(0).Name)
}
-- examples/immutable_go_json.gala --
package main

import (
    "encoding/json"

    . "martianoff/gala/go_interop"
)

// LineItem is GALA-native. Go's encoding/json sees its fields as Go does:
// every field that is not `var` is a std.Immutable[T]. The wrapper encodes and
// decodes as the value it holds, so the struct round-trips with its data.
struct LineItem(SKU string, UnitCents int64, Qty int)

// Stock uses the block form and mixes an immutable field with a `var` one,
// which Go sees as a plain field.
type Stock struct {
    SKU string
    var Count int
}

// Order nests a GALA struct inside another.
struct Order(ID string, Item LineItem)

func encode[T any](v T) string = json.Marshal(v).Map(ToString).GetOrElse("cannot encode")

func main() {
    val item = LineItem("A-1", 250, 3)
    val itemJson = encode(item)
    Println(itemJson)

    // json.Unmarshal fills a Go decode target through its address.
    var decodedItem LineItem
    Println(FromError(json.Unmarshal(ToBytes(itemJson), &decodedItem)).IsSuccess())
    Println(s"${decodedItem.SKU} ${decodedItem.UnitCents} ${decodedItem.Qty} equal=${decodedItem == item}")

    Println(encode(Stock(SKU = "box", Count = 2)))

    var decodedStock Stock
    Println(FromError(json.Unmarshal(ToBytes("{\"SKU\":\"crate\",\"Count\":7}"), &decodedStock)).IsSuccess())
    Println(s"${decodedStock.SKU} ${decodedStock.Count}")

    val order = Order("o-9", item)
    val orderJson = encode(order)
    Println(orderJson)

    var decodedOrder Order
    Println(FromError(json.Unmarshal(ToBytes(orderJson), &decodedOrder)).IsSuccess())
    Println(s"${decodedOrder.ID} ${decodedOrder.Item.SKU} equal=${decodedOrder == order}")

    // fmt prints the values too, not the wrappers.
    Println(order)

    // A value of the wrong JSON type is a decode error, as for a plain Go field.
    var bad LineItem
    Println(FromError(json.Unmarshal(ToBytes("{\"Qty\":\"three\"}"), &bad)).IsFailure())
}
-- examples/immutable_lambda_params_receivers.gala --
package main

import . "martianoff/gala/collection_immutable"

// A lambda parameter is immutable unless declared `var`, like a function
// parameter, and a receiver can never be rebound. Mutation through a receiver
// is still allowed wherever the type permits it, and a receiver that needs a
// changing copy is copied into a local `var`.

struct Counter(var N int)

// A value receiver may write its own `var` fields: the change stays on the copy.
func (c Counter) Bumped() Counter {
    c.N = c.N + 1
    c
}

// A pointer receiver writes through to the caller's value.
func (c *Counter) Bump() {
    c.N = c.N + 1
}

// Calling a mutating method through the receiver is allowed too.
func (c *Counter) BumpTwice() {
    c.Bump()
    c.Bump()
}

struct Point(X int, Y int)

// A receiver is never reassigned; a changing copy is a local `var`.
func (p Point) ClampedRight(dx int) Point {
    var q = p
    if (dx > 0) {
        q = Point(q.X + dx, q.Y)
    }
    q
}

func apply[T any](v T, f func(T) T) T = f(v)

func main() {
    var c = Counter(0)
    Println(c.Bumped().N)
    Println(c.N)
    c.BumpTwice()
    Println(c.N)

    val p = Point(1, 2)
    Println(p.ClampedRight(3).X)
    Println(p.ClampedRight(-3).X)

    // A `var` lambda parameter may be reassigned.
    val clamp = (var n int) int => {
        if (n < 0) {
            n = 0
        }
        n
    }
    Println(clamp(-4))
    Println(apply(5, (var n) => {
        n += 10
        n
    }))

    // An unmarked lambda parameter is read-only; derive a new value instead.
    Println(ArrayOf(1, 2, 3).Map((x) => x * 2))
}
-- examples/immutable_slice_field.gala --
package main

import "fmt"
import . "martianoff/gala/go_interop"

type Container struct {
    items []int
    label string
    var count int
}

func main() {
    // Test 1: Go-style struct construction with immutable slice field
    var x []int = nil
    x = SliceAppend(x, 1)
    x = SliceAppend(x, 2)
    val c1 = Container{items: x, label: "test", count: 2}
    fmt.Println("items:", c1.items)
    fmt.Println("label:", c1.label)
    fmt.Println("count:", c1.count)

    // Test 2: Functional-style struct construction with named args
    val c2 = Container(items = x, label = "named", count = 3)
    fmt.Println("items:", c2.items)
    fmt.Println("label:", c2.label)
    fmt.Println("count:", c2.count)

    // Test 3: Positional construction
    val c3 = Container(x, "positional", 4)
    fmt.Println("items:", c3.items)
    fmt.Println("label:", c3.label)
    fmt.Println("count:", c3.count)
}
-- examples/immutable_typed_field_ctor.gala --
package main

// A field declared Immutable[T] takes a T however its value is supplied:
// positionally, by name, as a Copy override or as its default. The value is
// wrapped once. A var field declared Immutable[T] takes the Immutable[T].

struct Counter(Label string, Hits Immutable[int64] = 1)

struct Cell(var Stored Immutable[int])

struct Holder[T any](Inner Immutable[T], Spare T)

func main() {
    val positional = Counter("positional", 2)
    val named = Counter(Hits = 3, Label = "named")
    val defaulted = Counter(Label = "defaulted")
    val copied = named.Copy(Hits = 4)
    Println(s"${positional.Label} ${positional.Hits}")
    Println(s"${named.Label} ${named.Hits}")
    Println(s"${defaulted.Label} ${defaulted.Hits}")
    Println(s"${copied.Label} ${copied.Hits}")

    Println(Cell(5).Stored.Get() + Cell(Stored = 6).Stored.Get())

    val inferred = Holder(Inner = "in", Spare = "spare")
    val explicit = Holder[int](Inner = 7, Spare = 8)
    Println(s"${inferred.Inner} ${explicit.Inner + explicit.Spare}")
}
