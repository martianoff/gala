package main

import "fmt"
import . "martianoff/gala/examples/match_lib"

// Match on method return where receiver type comes from imported library
func findInStore(store Store, key string) string {
    return store.Lookup(key) match {
        case Some(v) => s"Got: $v"
        case None() => "Not found"
