import (
    "strings"
)

func main() {
    // Escaped quotes inside ${} interpolation block
    Println(s"result: ${strings.TrimSpace(\"  hello  \")}")

    // Multiple escaped quotes in one expression
    Println(s"replaced: ${strings.Replace(\"hello world\", \"world\", \"gala\", 1)}")

