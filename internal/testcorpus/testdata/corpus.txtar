-- examples/type_alias_conversion.gala --
package main

// A type alias is a second name for an existing type, not a new type. The two
// are interchangeable, so `Millis(v)` is the ordinary Go-style conversion —
// the same construct as `int64(v)`.
type Millis int64
type Name string

func toMillis(v int64) Millis = Millis(v)

func toName(s string) Name = Name(s)

// An alias whose target is a struct reaches that struct's fields, so it is a
// real construction target.
struct Point(X int, Y int)

type Coord Point

func origin() Coord = Coord(1, 2)

// A method is legal through an alias when the target is declared in this
// package — the receiver base type is then local. An alias to a built-in or an
// imported type takes no methods (GALA-E0048).
func (c Coord) Sum() int = c.X + c.Y

// An alias can carry a generic instantiation; the alias already names it, so
// the type arguments are not repeated at the call site.
struct Pair[T any](A T, B T)

type IntPair Pair[int]

func firstOf(p IntPair) int = p.A

func main() {
    Println(toMillis(1500))
    Println(toName("gala"))
    val c = origin()
    Println(s"${c.X},${c.Y}")
    Println(c.Sum())
    Println(firstOf(IntPair(3, 4)))
}
-- examples/type_alias_lambda_inference.gala --
package main

import (
    . "martianoff/gala/test"
)

// Type aliases for function types — exercise lambda inference through alias resolution.
// The transpiler must resolve these to their underlying func types and propagate
// expected param/return types to lambdas in expression functions.

type Transformer func(int) string

type Processor func(string, Transformer) string

// Expression function returning a type-alias function type.
// The lambda should infer param types from the Transformer alias.
func DoubleToString() Transformer = (x) => {
    if x > 100 {
        return "big"
    }
    return "small"
}

// Multi-return-path lambda — the type should be inferred as string (from Transformer).
func ClassifySign() Transformer = (x) => {
    if x > 0 {
        return "positive"
    }
    if x < 0 {
        return "negative"
    }
    return "zero"
}

// Nested type alias — Processor takes a Transformer.
func ApplyAndWrap(prefix string) Processor = (s, tf) => {
    val result = tf(42)
    return prefix + ": " + result
}

func TestTypeAliasLambda(t T) T {
    val tf = DoubleToString()
    var t1 = Eq(t, tf(50), "small")
    var t2 = Eq(t1, tf(200), "big")

    val sign = ClassifySign()
    var t3 = Eq(t2, sign(5), "positive")
    var t4 = Eq(t3, sign(-3), "negative")
    var t5 = Eq(t4, sign(0), "zero")

    val proc = ApplyAndWrap("Result")
    return Eq(t5, proc("test", sign), "Result: positive")
}

-- examples/type_alias_lib_match/processor.gala --
package typealiaslib

import . "martianoff/gala/std"

// MakeBridgeHandler mirrors gala-server's makeBridgeHandler exactly:
// - Takes a Handler (type alias for func(Request) Future[Response])
// - Returns a function that calls through the alias and matches on .Await()
// - The match branches return BridgeResult
//
// This exercises:
// 1. Type alias resolution from sibling file (Handler -> func(Request) Future[Response])
// 2. NamedType.BaseName() package-qualification ("typealiaslib.Handler" vs "Handler")
// 3. Chained function call type inference (handler(req).Await())
// 4. Match result type inference inside a lambda
// 5. currentFuncReturnType fallback in lambda context
func MakeBridgeHandler(handler Handler) func() BridgeResult {
    return () => {
        val req = Request(Path = "/test")
        return handler(req).Await() match {
            case Success(resp) => resp.ToBridge()
            case Failure(err) => NewBridgeResult(500, s"Error: $err")
        }
    }
}
-- examples/type_alias_lib_match/types.gala --
package typealiaslib

import . "martianoff/gala/std"
import . "martianoff/gala/concurrent"

// BridgeResult is a simple output type (mirrors httpcore.BridgeResponse)
struct BridgeResult(Code int, Body string)

func NewBridgeResult(code int, body string) BridgeResult = BridgeResult(Code = code, Body = body)

// Response is the high-level response (mirrors server.Response)
struct Response(Status int, Message string)

func NewResponse(status int, message string) Response = Response(Status = status, Message = message)

func (r Response) ToBridge() BridgeResult = NewBridgeResult(r.Status, r.Message)

// Handler is a type alias for a function type (mirrors server.Handler)
// This is the critical pattern: type alias defined in one file, used in a sibling file
type Handler func(Request) Future[Response]

// Request is a simple input type
struct Request(Path string)
-- examples/type_alias_lib_match_test.gala --
package main

import . "martianoff/gala/std"
import . "martianoff/gala/concurrent"
import "martianoff/gala/examples/type_alias_lib_match"

// Handler function with explicit return type
func makeHandler(req typealiaslib.Request) Future[typealiaslib.Response] {
    return FutureOf(typealiaslib.NewResponse(200, s"OK from ${req.Path}"))
}

func main() {
    val bridge = typealiaslib.MakeBridgeHandler(makeHandler)
    val result = bridge()
    Println(s"${result.Code}: ${result.Body}")
}
-- examples/type_arg_roundtrip.gala --
package main

import (
    gostrings "strings"
    gourl "net/url"
    "martianoff/gala/strings"
    . "martianoff/gala/collection_immutable"
)

// Types that reach a lambda through a type argument keep what they are.
//
// A generic method's type arguments travel through the transformer in their
// printed form. A function type printed as `func(int) int` came back as an
// opaque name, so calling an element of Array[func(int) int] inferred nothing
// and the lambda's result fell back to `any`. A Go type written against an
// aliased import prints as `gostrings.Builder`, while Go type info knows it as
// `strings.Builder`, so its methods were not found and their results fell back
// to `any` too. Either way the generated Go failed to compile as soon as the
// result was used as the concrete type it is.

func length(s string) int = s.Size()

func main() {
    // Function-typed elements.
    val steps = ArrayOf((x int) => x + 1, (x int) => x * 2)
    val applied = steps.Map((f) => f(10))
    Println(applied.FoldLeft(0, (a, b) => a + b))

    val maybe = Some((x int) => x + 1)
    Println(maybe.Map((f) => f(1)).GetOrElse(0) + 1)

    // A Go type under an aliased import, beside the same-name GALA package.
    Println(strings.ToUpper("gala"))
    var sb gostrings.Builder
    sb.WriteString("abc")
    val builder = Some(&sb)
    val text = builder.Map((b) => b.String()).GetOrElse("none")
    Println(length(text))
    Println(builder.Map((b) => b.Len()).GetOrElse(0) + 1)

    // Both at once: a function over the aliased Go type.
    val render = ArrayOf((b *gostrings.Builder) => b.String())
    Println(length(render.Map((f) => f(&sb)).Head()))

    // A Go function and a Go named collection under an aliased import: the
    // (Values, error) call is wrapped by Try, and Size() on url.Values lowers
    // to len().
    Println(Try(gourl.ParseQuery("a=1&b=2")).Map((q) => q.Size()).GetOrElse(-1))
}
-- examples/type_match.gala --
package main

import "fmt"

func main() {
    val x = "hello"

    val res1 = x match {
        case s: string => "string: " + s
        case i: int    => "int: " + fmt.Sprintf("%d", i)
        case _         => "unknown"
    }

    fmt.Println(res1)

    val y = Some(3)
    val res2 = y match {
        case s: string => "string: " + s
        case i: int    => "int: " + fmt.Sprintf("%d", i)
        case _         => "unknown"
    }

    fmt.Println(res2)

    val b = Some(4)
    val res3 = b match {
        case v: _    => fmt.Sprintf("any: %T", v)
        case _       => "unknown"
    }

    fmt.Println(res3)
}
-- examples/type_param_shadows_std.gala --
package main

import . "martianoff/gala/collection_immutable"

// A type parameter means itself everywhere in its declaration, even when it is
// named like a std type or variant (Some, Option, Try, Tuple, Left) or like a
// type an import brings in (Array). As in Go, it shadows every outer name:
// inside `func f[Some any]`, `Some` is the type parameter, never std's Some.

func id[Some any](x Some) Some = x

func first[Some any](xs Array[Some]) Option[Some] = xs.HeadOption()

func pair[Option any, Try any](a Option, b Try) Tuple[Option, Try] = (a, b)

func firstOr[Array any](xs List[Array], d Array) Array = xs.HeadOption().GetOrElse(d)

// Each declaration binds its own names: a lambda typed from Try in one and
// from Option in the next keeps its own type parameter.
func same[Try any](xs Array[Try]) Array[Try] = xs.Map((x) => x)

func alsoSame[Option any](xs Array[Option]) Array[Option] = xs.Map((x) => x)

func annotated[Some any](x Some) Some {
    val y Some = x
    val f = (v Some) => v
    f(y)
}

// An explicit type argument names the type parameter too.
func wrapRight[Left any](a Left) Option[Left] = Some[Left](a)

// Box holds one value; its type parameter is named like std's Option.
struct Box[Option any](V Option)

// Get returns the boxed value.
func (b Box[Option]) Get() Option = b.V

// Map boxes f applied to the value; its own type parameter is named like Try.
func (b Box[Option]) Map[Try any](f func(Option) Try) Box[Try] = Box(f(b.V))

// Peek returns the boxed value; the receiver's type argument is a type
// parameter too, here named like one of Either's variants.
func (b Box[Left]) Peek() Left = b.V

// convertAll converts each element to the type parameter, which types the
// lambda's result.
func convertAll[Wrap any](xs Array[Wrap]) Array[Wrap] = xs.Map((v) => Wrap(v))

// apply's default is typed by its own A — at the call inside viaSome, by
// viaSome's Some.
func apply[A any](x A, f func(A) A = (a) => a) A = f(x)

func viaSome[Some any](v Some) Some = apply(v)

// Holder uses the block struct form, so a field type names the parameter too.
type Holder[Tuple any] struct {
    Value Tuple
}

// Twice returns the held value twice.
func (h Holder[Tuple]) Twice() Array[Tuple] = ArrayOf[Tuple](h.Value, h.Value)

// Res is a sealed type whose type parameter is named like std's Some.
sealed type Res[Some any] {
    case Ok(V Some)
    case Err(Msg string)
}

func describe[Some any](r Res[Some]) string = r match {
    case Ok(v) => s"ok $v"
    case Err(m) => s"err $m"
}

func main() {
    Println(id(3))
    Println(first(ArrayOf("w")).GetOrElse("none"))
    Println(pair(1, "b"))
    Println(firstOr(ListOf(4, 5), 0))
    Println(same(ArrayOf(9)))
    Println(alsoSame(ArrayOf("o")))
    Println(annotated("a"))
    Println(wrapRight("r").Get())
    Println(Box(2).Map((x) => s"v$x").Get())
    Println(Holder(Value = 3).Twice())
    Println(describe(Ok(1)))
    Println(describe(Err[int]("bad")))
    Println(Box(7).Peek())
    Println(convertAll(ArrayOf(5, 6)))
    Println(viaSome("s"))
}
-- examples/typed_partial_function.gala --
package main

sealed type Shape {
    case Circle(R int)
    case Rect(W int, H int)
    case Empty()
}

sealed type Box[T any] {
    case Full(V T)
    case Nothing()
}

struct Rules(Pick func(Shape) Option[int])

// A partial function takes its parameter and result types from the function
// type of the slot it fills: a typed val or var, a return value, a struct
// field or a parameter.
func describe() func(Shape) Option[string] = {
    case Circle(r) => s"circle ${r}"
    case Rect(H = 3) => "rect of height 3"
}

func applyTo(s Shape, f func(Shape) Option[int]) int = f(s).GetOrElse(-1)

func main() {
    val pf func(int) Option[int] = { case 1 => 10 case 2 => 20 }
    Println(pf(1).GetOrElse(-1), pf(2).GetOrElse(-1), pf(3).GetOrElse(-1))

    var ps func(Shape) Option[int] = { case Circle(r) => r case Empty() => 0 }
    Println(ps(Circle(3)).GetOrElse(-1), ps(Empty()).GetOrElse(-1), ps(Rect(1, 2)).GetOrElse(-1))

    val named func(Shape) Option[int] = { case Rect(H = 3) => 3 case Rect(W = w) => w }
    Println(named(Rect(7, 3)).GetOrElse(-1), named(Rect(7, 4)).GetOrElse(-1), named(Circle(1)).GetOrElse(-1))

    val boxed func(Box[Option[int]]) Option[int] = { case Full(Some(2)) => 1 case Nothing() => 2 }
    Println(boxed(Full(Some(2))).GetOrElse(-1), boxed(Nothing[Option[int]]()).GetOrElse(-1), boxed(Full(Some(5))).GetOrElse(-1))

    val pair func(Tuple[Shape, int]) Option[int] = { case (Circle(1), 2) => 1 case (Empty(), n) => n }
    Println(pair((Circle(1), 2)).GetOrElse(-1), pair((Empty(), 9)).GetOrElse(-1), pair((Circle(2), 2)).GetOrElse(-1))

    val wide func(int) Option[int64] = { case 1 => 10 }
    Println(wide(1).GetOrElse(-1), wide(2).GetOrElse(-1))

    val adder func(int) Option[func(int) int] = { case 1 => (x) => x + 1 }
    Println(adder(1).Get()(41))

    Println(describe()(Circle(4)).GetOrElse("none"), describe()(Rect(1, 3)).GetOrElse("none"), describe()(Empty()).GetOrElse("none"))

    val rules = Rules(Pick = { case Rect(w, _) => w })
    Println(rules.Pick(Rect(4, 5)).GetOrElse(-1), rules.Pick(Empty()).GetOrElse(-1))

    Println(applyTo(Circle(2), { case Circle(r) => r * 10 }), applyTo(Empty(), { case Circle(r) => r }))
}
-- examples/typed_pattern_option_ptr.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Simple struct
type MyData struct {
    Name string
    Age  int
}

type OtherData struct {
    Value string
}

// Typed pattern matching with pointer type in Option return
func findData(raw any) Option[*MyData] {
    return raw match {
        case sd: *MyData => Some(sd)
        case _ => None[*MyData]()
    }
}

func main() {
    val d *MyData = &MyData{Name: "Alice", Age: 30}
    val result = findData(d)
    result match {
        case Some(sd) => Println(fmt.Sprintf("found: %s, %d", sd.Name, sd.Age))
        case _ => Println("not found")
    }

    val d2 *OtherData = &OtherData{Value: "hello"}
    val result2 = findData(d2)
    result2 match {
        case Some(sd) => Println(fmt.Sprintf("found: %s", sd.Name))
        case _ => Println("not found (expected)")
    }
}
