package main

import lib "martianoff/gala/examples/cross_file_method_default_lib"

// Label is declared in another file than Box, and its default names ArrayOf,
// which only Label's file imports. The default resolves there, at a call in
// that file and at one in another package alike.
func main() {
    Println(lib.Describe(lib.Box(1)))
    Println(lib.Box(2).Label())
    Println(lib.Box(3).Label(5))
}
-- examples/cross_file_method_default_lib/a.gala --
package cross_file_method_default_lib

// Box is declared here; its method Label is declared in b.gala.
struct Box(N int)
-- examples/cross_file_method_default_lib/b.gala --
package cross_file_method_default_lib

import . "martianoff/gala/collection_immutable"

// Label names the box. Its default uses ArrayOf, which only this file
// imports: a default resolves through the file that declares it.
func (b Box) Label(parts int = ArrayOf("x", "y").Size()) string = s"box-${b.N}-${parts}"

// Describe calls Label from the file that declares it, with the default.
func Describe(b Box) string = b.Label()
-- examples/cross_file_unwrap/main.gala --
package main

import "fmt"
import . "martianoff/gala/go_interop"

func main() {
    val route = Route("GET", "/api/users", Handler("myHandler"))
    // Cross-file: access val field and pass to function
    val filtered = applyFilter(route.Handler, "auth")
    fmt.Println(filtered.Name)

    // Cross-file: access val field from slice element
    val routes = SliceOf(Route("GET", "/api", Handler("h1")), Route("POST", "/api", Handler("h2")))
    val r = routes[0]
    fmt.Println(r.Method)
    fmt.Println(r.Handler.Name)

    // Cross-file: pass field from slice element as function arg
    val filtered2 = applyFilter(r.Handler, "log")
    fmt.Println(filtered2.Name)
}
-- examples/cross_file_unwrap/types.gala --
package main

struct Handler(val Name string)

struct Route(val Method string, val Pattern string, val Handler Handler)

func applyFilter(h Handler, filter string) Handler = Handler(filter + ":" + h.Name)
-- examples/cross_file_unwrap_lib/ops.gala --
package cross_file_unwrap_lib

import "fmt"
import . "martianoff/gala/collection_immutable"

type Server struct {
    Routes Array[Route]
    Filters Array[string]
}

func NewServer(routes Array[Route], filters Array[string]) Server = Server(Routes = routes, Filters = filters)

func ProcessServer(server Server) string {
    val routes = server.Routes
    val filters = server.Filters
    val route = routes.Get(0)
    val handler = ApplyFilters(route.Handler, filters)
    return fmt.Sprintf("%s %s -> %s", route.Method, route.Pattern, handler.Name)
}
-- examples/cross_file_unwrap_lib/types.gala --
package cross_file_unwrap_lib

import . "martianoff/gala/collection_immutable"

struct Handler(Name string)

struct Route(Method string, Pattern string, Handler Handler)

func ApplyFilter(h Handler, filter string) Handler = Handler(filter + ":" + h.Name)

func ApplyFilters(handler Handler, filters Array[string]) Handler {
    if filters.IsEmpty() {
        return handler
    }
    var result Handler = handler
    for i := 0; i < filters.Size(); i++ {
        result = ApplyFilter(result, filters.Get(i))
    }
    return result
}
