}

func treeMapCompareFloat64sAny(a float64, vb any) int {
    val b = vb match { case bf: float64 => bf case _ => float64(0) }
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

func treeMapCompareFloat32sAny(a float32, vb any) int {
