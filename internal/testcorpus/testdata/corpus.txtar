-- examples/use_sealed_done_state.gala --
package main

// Regression: a sealed case named `Done(Body string)` lives in a
// dot-imported sub-package whose final path segment is `state`. Pattern
// matching on bare `case Done(body) =>` must resolve the case companion
// from the package the consumer actually imported, not from any unrelated
// sibling package elsewhere in the workspace that happens to share the
// name `state`.

import . "martianoff/gala/examples/sealed_done_state_pkg/state"

func describe(s Status) string = s match {
    case Done(body) => s"done($body)"
    case Help()     => "help"
    case Blocked()  => "blocked"
    case Finished() => "finished"
}

func main() {
    Println(describe(MakeDone("hello")))
    Println(describe(MakeHelp()))
    Println(describe(MakeBlocked()))
    Println(describe(MakeFinished()))
    // Also exercise the sibling-file match arm via DescribeStatus.
    Println(DescribeStatus(MakeDone("again")))
}
-- examples/use_sealed_dot_import.gala --
package main

// Consumer dot-imports a multi-file GALA library that exposes a generic
// sealed type with zero-field cases. Constructing those cases via
// Case[T]() must lower to Case[T]{}.Apply() — Go reads Case[T]() as a
// type conversion on the empty struct, so the plain function-call shape
// would fail to compile.

import . "martianoff/gala/examples/sealed_dot_import_lib"

// Generic zero-field sealed case via dot import.
func makeQuit() Cmd[int] = QuitCmd[int]()
func makeNoop() Cmd[int] = NoCmd[int]()

// Non-generic zero-field sealed case via dot import.
func makeIdle() Status = Idle()
func makeDone() Status = Done()

func describeCmd(c Cmd[int]) string = c match {
    case QuitCmd() => "quit"
    case NoCmd() => "noop"
    case MsgCmd(_) => "msg"
}

func main() {
    Println(describeCmd(makeQuit()))
    Println(describeCmd(makeNoop()))
    Println(DescribeStatus(makeIdle()))
    Println(DescribeStatus(makeDone()))
}
-- examples/use_sealed_foreign_field.gala --
package main

// Matching on a case whose fields have types of a package this file never
// imports. The generated Go must not import that package either: under Bazel
// this test depends only on sealed_foreign_field_lib, so a stray import of
// sealed_foreign_field_cmd_lib fails strict dependency checking.

import (
    . "martianoff/gala/collection_immutable"

    "martianoff/gala/examples/sealed_foreign_field_lib"
)

func target(e sealed_foreign_field_lib.Edge) int = e match {
    case sealed_foreign_field_lib.Actions(t, _) => t
    case sealed_foreign_field_lib.Eps(t) => t
    case _ => -1
}

func commandCount(e sealed_foreign_field_lib.Edge) int = e match {
    case sealed_foreign_field_lib.Actions(_, cmds) => cmds.Size()
    case _ => 0
}

func name(e sealed_foreign_field_lib.Edge) string = e match {
    case sealed_foreign_field_lib.One(c) => c.Name
    case _ => "none"
}

func targetPlus(e sealed_foreign_field_lib.Edge, k int) int = (e, k) match {
    case (sealed_foreign_field_lib.Actions(t, _), n) => t + n
    case _ => 0
}

func main() {
    val actions = sealed_foreign_field_lib.MakeActions(3, ArrayOf("a", "b"))
    val one = sealed_foreign_field_lib.MakeOne("solo")
    val eps = sealed_foreign_field_lib.MakeEps(7)

    Println(target(actions))
    Println(target(eps))
    Println(target(one))
    Println(commandCount(actions))
    Println(commandCount(eps))
    Println(name(one))
    Println(name(actions))
    Println(targetPlus(actions, 10))
    Println(targetPlus(eps, 10))
}
-- examples/use_sealed_widen_call_arg.gala --
package main

// Cross-package + dot-import variant of the sealed-widen-call-arg test.
// gala_team's Status sealed type lives in the `team` package and is dot-
// imported into `ui`; multi-arg sealed widening at call arguments was
// first reported against this exact shape.

import . "martianoff/gala/examples/sealed_widen_call_arg_lib"

func main() {
    // Zero-arg variants at call-arg site.
    Println(DescribeStatus(StIdle()))
    Println(DescribeStatus(StWorking()))

    // Single-arg positional + named.
    Println(DescribeStatus(StHelpWaiting("?")))
    Println(DescribeStatus(StHelpWaiting(Question = "why")))

    // Multi-arg positional + named.
    Println(DescribeStatus(StRecovering(1, 2)))
    Println(DescribeStatus(StRecovering(Attempt = 3, Max = 4)))

    // Sink also takes Status — same widening rules.
    Println(Sink(StRecovering(Attempt = 5, Max = 6)))
}
-- examples/use_std_shadow_lib.gala --
package main

import lib "martianoff/gala/examples/std_shadow_lib"

// main declares its own Seq, shadowing std's in this package.
struct Seq[T any](Head T, Count int)

func first[T any](s Seq[T]) T = s.Head

func main() {
    val h = lib.Make()
    Println(h.Items.Size())
    Println(lib.Total(h))
    Println(lib.FirstItem(h.Items).GetOrElse(0))
    val k = lib.Rekey(lib.Hashable("a", 3), "b")
    Println(s"${k.Key} ${lib.CodeOf(k)}")
    Println(first(Seq("seq", 1)))
    Println(Some(3).GetOrElse(0))
    Println(lib.Bump())
    Println(lib.Void(2))
}
-- examples/user_get_method_option_chain.gala --
package main

import . "martianoff/gala/collection_immutable"

// Regression: a user-defined method named `Get` that returns Option[T] must not
// collide with the builtin Option/collection `Get` handling. Chained higher-order
// Option methods (FlatMap, Map) on the result of such a `Get` must keep the
// concrete element type instead of erasing it to `any`.

sealed type Node {
    case NLeaf(Str string)
    case NList(Items Array[Node])
}

func (n Node) AsString() Option[string] = n match {
    case NLeaf(s) => Some(s)
    case _ => None[string]()
}

// User method named `Get`, no params, returns Option[Node].
func (n Node) Get() Option[Node] = n match {
    case NList(items) => items.GetOption(0)
    case _ => None[Node]()
}

// User method named `Get` with a param, returns Option[Node].
func (n Node) GetAt(i int) Option[Node] = n match {
    case NList(items) => items.GetOption(i)
    case _ => None[Node]()
}

// Chained FlatMap on the result of `Get()`.
func (n Node) FirstString() Option[string] =
    n.Get().FlatMap[string]((x) => x.AsString())

// Chained Map on the result of `Get()`.
func (n Node) FirstNodeMapped() Option[Node] =
    n.Get().Map((x) => x)

// Assigning Get() to a val first, then chaining FlatMap on the val.
func (n Node) FirstStringViaVal() Option[string] {
    val inner = n.Get()
    return inner.FlatMap[string]((x) => x.AsString())
}

// Chained FlatMap on the result of a parameterized Get.
func (n Node) StringAt(i int) Option[string] =
    n.GetAt(i).FlatMap[string]((x) => x.AsString())

func main() {
    val tree = NList(ArrayOf(NLeaf("hi"), NLeaf("bye")))
    Println(tree.FirstString().GetOrElse("none"))
    Println(tree.FirstStringViaVal().GetOrElse("none"))
    Println(tree.StringAt(1).GetOrElse("none"))
    Println(tree.FirstNodeMapped().FlatMap[string]((x) => x.AsString()).GetOrElse("none"))
    Println(NLeaf("solo").FirstString().GetOrElse("none"))
}
-- examples/val_go_interface_method.gala --
package main

import (
    "context"
)

// Verify that val variables holding Go interface types can call methods
// without spurious .Get() unwrapping on the return value.
// Bug: ctx.Err() was generated as ctx.Get().Err.Get()() because the
// fallback heuristic in isImmutableField matched "Err" from std.Try.Failure.
func main() {
    val ctx = context.Background()

    // Method call on Go interface should not have .Get() on return
    val err = ctx.Err()
    if err == nil {
        Println("context ok")
    }
}
