}
-- examples/option_array_byte.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
)

func main() {
    // Test that SliceOf[byte] correctly infers []byte (not []int)
    // and that the type flows correctly through ArrayFromSlice and Some
    val goSlice = SliceOf[byte](72, 101, 108, 108, 111)
    val arr = ArrayFromSlice(goSlice)

    // Should infer Option[Array[byte]], not Option[Array[int]] or Option[Array[[]byte]]
    val opt = Some(arr)

    val result = opt match {
        case Some(bytes) => s"Got ${bytes.Size()} bytes"
        case None() => "No bytes"
    }
    Println(result)
}
-- examples/option_complex.gala --
package main

import "fmt"

struct Product(id int, name string, price float64)

func findProduct(id int) Option[Product] {
    if (id == 1) {
        return Some(Product(1, "Laptop", 1200.0))
    }
    if (id == 2) {
        return Some(Product(2, "Mouse", 25.0))
    }
    return None[Product]()
}

func main() {
    // Explicit type using generic None[T]() call
    val noProduct Option[Product] = None[Product]()
    fmt.Println("Empty product defined:", !noProduct.IsEmpty())

    val p1 = findProduct(1)
    val p2 = findProduct(2)
    val p3 = findProduct(3)

    // Demonstrate Map
    val names = p1.Map((p Product) => p.name)
    fmt.Println("P1 name:", names.GetOrElse("Unknown"))

    // Demonstrate Filter
    val expensive = p1.Filter((p Product) => p.price > 1000.0)
    val expensive2 = p2.Filter((p Product) => p.price > 1000.0)

    fmt.Println("P1 is expensive:", !expensive.IsEmpty())
    fmt.Println("P2 is expensive:", !expensive2.IsEmpty())

    // Demonstrate GetOrElse
    val p3Name = p3.Map((p Product) => p.name).GetOrElse("Not Found")
    fmt.Println("P3 result:", p3Name)

    // Using Option in a match expression with inner value matching
    p1.Map((p Product) => p.id).ForEach((id int) => {
        fmt.Println(id match {
            case 1 => "Found first product"
            case 2 => "Found second product"
            case _ => "Found other product"
        })
    })
}
-- examples/option_exists_forall.gala --
package main

import . "martianoff/gala/collection_immutable"

// Option.Exists and Option.ForAll ask a predicate about the value an Option
// may hold: None never satisfies Exists and always satisfies ForAll.

struct User(Name string, Age Option[int])

func isAdult(age int) bool = age >= 18

func main() {
    val users = ArrayOf(User("ann", Some(34)), User("bob", Some(12)), User("cy", None[int]()))
    users.ForEach((u) => Println(s"${u.Name}: adult=${u.Age.Exists(isAdult)} notMinor=${u.Age.ForAll(isAdult)}"))
    Println(Some("gala").Exists(_.Size() == 4))
    Println(None[string]().ForAll((s) => s.Size() > 100))
}
-- examples/option_orelse_test.gala --
package main

import "fmt"

func main() {
    // Test 1: Some.OrElse(other) returns the original Some
    val some1 = Some(42)
    val some2 = Some(99)
    val result1 = some1.OrElse(some2)
    fmt.Println("Some.OrElse(Some):", result1.Get())

    // Test 2: None.OrElse(Some) returns the alternative Some
    val none1 = None[int]()
    val result2 = none1.OrElse(some1)
    fmt.Println("None.OrElse(Some):", result2.Get())

    // Test 3: None.OrElse(None) returns None
    val none2 = None[int]()
    val result3 = none1.OrElse(none2)
    fmt.Println("None.OrElse(None) isEmpty:", result3.IsEmpty())

    // Test 4: Chaining multiple OrElse calls
    val result4 = None[string]().OrElse(None[string]()).OrElse(Some("found")).OrElse(Some("other"))
    fmt.Println("Chained OrElse:", result4.Get())
}
-- examples/option_ptr.gala --
package main

// OptionPtr[T]: a pointer that may be absent, the size of one pointer. A
// field of this type left out of a brace literal is empty.

struct Node(Value int, Next OptionPtr[Node])

func sum(n Ptr[Node]) int = n.Value + n.Next.Map((next) => sum(next)).GetOrElse(0)

// An OptionPtr is matched with Option's variants through its MatchView.
func last(n Ptr[Node]) Ptr[Node] = n.Next match {
    case Some(next) => last(next)
    case None()     => n
}

// A bare `case None` is the variant, not a binding that matches everything.
func describeNext(n Ptr[Node]) string = n.Next match {
    case None                         => "no next"
    case Some(next) if next.Value > 2 => s"big next ${next.Value}"
    case Some(next)                   => s"next ${next.Value}"
}

func main() {
    val tail = &Node{Value: 3}
    val middle = &Node(2, SomePtr(tail))
    val head = &Node(1, SomePtr(middle))

    Println(s"sum: ${sum(head)}")
    Println(s"last: ${last(head).Value}")
    Println(describeNext(head))
    Println(describeNext(middle))
    Println(describeNext(tail))
    Println(s"tail next is empty: ${tail.Next.IsEmpty()}")
    Println(s"head next is defined: ${head.Next.IsDefined()}")

    head.Next.ForEach((n) => Println(s"after head: ${n.Value}"))
    Println(s"second after head: ${head.Next.FlatMap((n) => n.Next).Map((n) => n.Value).GetOrElse(0)}")
    Println(s"or else: ${tail.Next.GetOrElse(head).Value}")
    Println(s"orElse: ${tail.Next.OrElse(SomePtr(middle)).Map((n) => n.Value).GetOrElse(0)}")

    Println(s"from Go: ${OptionPtrOf(goFind(false))}")
    Println(s"from Go found: ${OptionPtrOf(goFind(true))}")
    Println(s"empty: ${EmptyOptionPtr[Node]()}")
}

var shared = Node{Value: 7}

// A Go-style lookup: nil when nothing is found.
func goFind(found bool) *Node = if (found) &shared else nil
-- examples/option_when.gala --
package main

import . "martianoff/gala/std"

func main() {
    val name = "Alice"
    val opt1 = When(name != "", name)
    val opt2 = When(name == "", name)
    val opt3 = Unless(name == "", name)
    val opt4 = Unless(name != "", name)

    Println(s"opt1 defined: ${opt1.IsDefined()}")
    Println(s"opt1 value: ${opt1.Get()}")
    Println(s"opt2 defined: ${opt2.IsDefined()}")
    Println(s"opt3 defined: ${opt3.IsDefined()}")
    Println(s"opt3 value: ${opt3.Get()}")
    Println(s"opt4 defined: ${opt4.IsDefined()}")
}
-- examples/own_go_func_multi_results/box.gala --
package own_go_func_multi_results

// A function of this package's own .go file returning several results is one
// GALA value, as for a function of an imported Go package.

struct Box(var N int)

// (T, error) as a match subject.
func Describe(n int) string = CountInt(n) match {
    case Success(count) => s"count $count"
    case Failure(err) => s"failed: ${err.Error()}"
}

// (T, error) bound, then a Try method.
func CountOr(n int, fallback int) int {
    val counted = CountInt(n)
    counted.GetOrElse(fallback)
}

// (A, B) destructured.
func Flagged(n int) string {
    val (next, even) = IntAndFlag(n)
    s"next $next, even $even"
}

// (GALA type, error) mapped.
func BoxSize(n int) int = MakeBox(n).Map((box) => box.N).GetOrElse(-1)

// Names bound one by one keep Go's raw results.
func RawCount(n int) string {
    val count, err = CountInt(n)
    if (err != nil) s"raw error: ${err.Error()}" else s"raw $count"
}
-- examples/own_go_func_multi_results_test.gala --
package main

import "martianoff/gala/examples/own_go_func_multi_results"

func main() {
    Println(own_go_func_multi_results.Describe(3))
    Println(own_go_func_multi_results.Describe(-1))
    Println(own_go_func_multi_results.CountOr(4, 0))
    Println(own_go_func_multi_results.CountOr(-4, 99))
    Println(own_go_func_multi_results.Flagged(2))
    Println(own_go_func_multi_results.Flagged(5))
    Println(own_go_func_multi_results.BoxSize(7))
    Println(own_go_func_multi_results.BoxSize(0))
    Println(own_go_func_multi_results.RawCount(1))
    Println(own_go_func_multi_results.RawCount(-1))
}
-- examples/package_tuple_destructure/main.gala --
package main

// Package-level declarations that need generated temps, in two files of a
// main package (values.gala is the other): each file's temps are named apart.

import "strings"

val (name, version) = ("gala", 1)

// Only retries changes; the pair is a `var` to cover `var (...)` too.
var (retries, timeout) = (3, 30)

val key, value, found = strings.Cut("mode=fast", "=")

func main() {
    retries = retries + 1
    level = "info"
    Println(s"$name v$version")
    Println(s"retries=$retries timeout=$timeout")
    Println(s"$host:$port")
    Println(level)
    Println(s"$key -> $value ($found)")
    Println(s"$scheme ($hasScheme)")
}
-- examples/package_tuple_destructure/values.gala --
package main

import "strings"

val (host, port) = ("localhost", 8080)

var (_, level) = (0, "debug")

val scheme, _, hasScheme = strings.Cut("https://gala.dev", "://")
-- examples/package_val_init_types.gala --
package main

import (
    . "martianoff/gala/collection_immutable"

    "martianoff/gala/examples/package_val_init_types/consts"
)

// An importer types another package's vals by that package's metadata. A
// generic call takes its type argument from it, so a wrong recorded type is
// a Go compile error here, and a missing one leaves the call uninferred.

func identity[T any](x T) T = x

func main() {
    val next = identity(consts.Next)
    val prev = identity(consts.Prev)
    Println(s"next=$next prev=$prev sum=${next + prev}")

    val label = identity(consts.Label)
    Println(s"label=$label size=${label.Size()}")

    val mask = identity(consts.Mask)
    val hexE = identity(consts.HexE)
    val bits = identity(consts.Bits)
    val perm = identity(consts.Perm)
    Println(s"mask=$mask hexE=$hexE bits=$bits perm=$perm and=${mask & 0xff}")

    val tiny = identity(consts.Tiny)
    Println(f"tiny=$tiny%.4f")

    val all = ArrayOf(consts.Next, consts.Mask, consts.HexE, consts.Bits, consts.Perm)
    Println(s"total=${all.FoldLeft(0, (acc, n) => acc + n)}")
}
-- examples/package_val_init_types/consts/consts.gala --
package consts

// Package-level vals whose element type an importer reads from this
// package's metadata: an initializer whose text looks like a number but is
// not one, a trailing match, and signed literals in every base.

// E is an int named like an exponent.
val E = 2

// Next adds to E: an int, though its text `E+1` reads like a float literal.
val Next = E + 1

// Prev subtracts from E: an int too.
val Prev = E - 1

// Label is typed by its match arms (string), not by its scrutinee (int).
val Label = 3 match {
    case 3 => "three"
    case _ => "other"
}

// Mask is a signed hex literal.
val Mask = -0x10

// HexE is a signed hex literal whose digit E is no exponent.
val HexE = -0xE

// Bits is a signed binary literal.
val Bits = -0b101

// Perm is a signed octal literal.
val Perm = +0o17

// Tiny is a signed float literal with an exponent.
val Tiny = -1e-3
-- examples/partial_ctor_type_args.gala --
package main

// A generic constructor called with only its leading type arguments binds
// those as written and infers the rest from the arguments, as a generic
// function call does.

struct Pair[A any, B any](First A, Second B)

struct Step[A any, B any](In A, Run func(A) B)

struct Make[A any, B any]()

func (m Make[A, B]) Apply(a A, b B) Pair[A, B] = Pair[A, B](a, b)

func main() {
    val positional = Pair[int64](1, "one")
    val named = Pair[float64](Second = true, First = 2)
    val step = Step[int](3, (x) => s"#${x}")
    val made = Make[int](4, "four")
    Println(s"${positional.First} ${positional.Second}")
    Println(s"${named.First} ${named.Second}")
    Println(step.Run(step.In))
    Println(s"${made.First} ${made.Second}")
}
-- examples/partial_function.gala --
package main

import "fmt"
import . "martianoff/gala/std"
import . "martianoff/gala/collection_immutable"

func main() {
    // Use with Collect - filter and transform
    val arr = ArrayOf(Some(1), None[int](), Some(2), Some(3))
    val doubled = arr.Collect({ case Some(n) => n * 2 })
    fmt.Println(doubled.ToGoSlice())  // [2, 4, 6]

    // Filter even numbers
    val nums = ArrayOf(1, 2, 3, 4, 5, 6)
    val evens = nums.Collect({ case n: int if n % 2 == 0 => n })
    fmt.Println(evens.ToGoSlice())  // [2, 4, 6]

    // Extract from nested structure
    val nested = ArrayOf(Some(Some(1)), Some(None[int]()), None[Option[int]]())
    val inner = nested.Collect({ case Some(Some(n)) => n })
    fmt.Println(inner.ToGoSlice())  // [1]

    // With Either - using explicit type params for Left/Right
    val eithers = ArrayOf(Left[string, int]("a"), Right[string, int](1), Left[string, int]("b"), Right[string, int](2))
    val rights = eithers.Collect({ case Right(n) => n * 10 })
    fmt.Println(rights.ToGoSlice())  // [10, 20]
}
-- examples/partial_function_suffix_arg.gala --
package main

sealed type Shape {
    case Circle(R int)
    case Square(S int)
}

// show takes the Option a partial function returns, not the partial function.
func show(o Option[int]) string = o match {
    case Some(x) => s"got $x"
    case None() => "none"
}

// describe takes any value, so it must see the applied result.
func describe[T any](v T) string = s"$v"

// applyTo takes a function, which `{ case ... }(_)` fills as a placeholder
// lambda that applies the partial function to its argument.
func applyTo(f func(int) Option[int], v int) Option[int] = f(v)

func main() {
    // Applying a partial function in an argument passes its Option result.
    Println(show({ case n: int if n > 0 => n * 2 }(3)))
    Println(show({ case n: int if n > 0 => n * 2 }(-1)))
    Println(describe({ case n: int => n + 1 }(4)))
    // A member on the result is applied too.
    Println({ case n: int => n * 10 }(2).GetOrElse(0))
    // A placeholder in the suffix makes the argument a lambda.
    Println(applyTo({ case n: int => n * 3 }(_), 7))

    // Untyped patterns take their parameter type from the applied argument.
    val five = 5
    Println(show({ case n if n > 0 => n * 2 }(five)))
    Println(describe({ case n => n + 1 }(4)))
    Println(applyTo({ case n if n > 0 => n * 3 }(_), 7))
    Println(show(Some(1).FlatMap({ case n => n * 3 }(_))))
    val applied = { case n => n - 1 }(10)
    Println(applied)

    // Extractor patterns are matched against the argument's type too.
    Println({ case Some(x) => x * 2 }(Some(3)))
    val shape Shape = Circle(4)
    Println({ case Circle(r) => r }(shape))
}
-- examples/path_basics.gala --
package main

// Verification example for the `path` stdlib package.
// Exercises the surface that consumers most commonly reach for from
// gala_team and similar code bases: Join, Dir, Base, Ext, IsAbs, Clean,
// ToSlash. ToSlash gives us a stable cross-OS form for printing.

import . "martianoff/gala/path"

func main() {
    val joined = Join("a", "b", "c.txt")
    Println(ToSlash(joined))           // a/b/c.txt
    Println(ToSlash(Dir(joined)))      // a/b
    Println(Base(joined))              // c.txt
    Println(Ext(joined))               // .txt
    Println(ToSlash(Clean("a//b/./c"))) // a/b/c
    Println(IsAbs("relative/path"))    // false
}
-- examples/pattern_match_filter.gala --
package main

import "fmt"

struct Person(Name string, Age int)

func main() {
    val alice = Person("Alice", 25)
    val bob = Person("Bob", 15)
    val charlie = Person("Charlie", 70)

    val p1 = alice match {
        case Person(name: string, age: int) if age < 18 => name + " is a minor"
        case Person(name: string, age: int) if age > 65 => name + " is a senior"
        case Person(name: string, _)                    => name + " is an adult"
        case _                                          => "Unknown"
    }
    fmt.Println(p1)

    val p2 = bob match {
        case Person(name: string, age: int) if age < 18 => name + " is a minor"
        case Person(name: string, age: int) if age > 65 => name + " is a senior"
        case Person(name: string, _)                    => name + " is an adult"
        case _                                          => "Unknown"
    }
    fmt.Println(p2)

    val p3 = charlie match {
        case Person(name: string, age: int) if age < 18 => name + " is a minor"
        case Person(name: string, age: int) if age > 65 => name + " is a senior"
        case Person(name: string, _)                    => name + " is an adult"
        case _                                          => "Unknown"
    }
    fmt.Println(p3)
}
-- examples/pf_repro.gala --
package main

import "fmt"
import . "martianoff/gala/std"
import . "martianoff/gala/collection_immutable"

func main() {
    // Simplest case: filter even numbers with typed pattern
    val nums = ArrayOf(1, 2, 3, 4, 5, 6)
    val evens = nums.Collect({ case n: int if n % 2 == 0 => n })
    fmt.Println(evens.ToGoSlice())
}
-- examples/placeholder_field_unwrap.gala --
package main

import . "martianoff/gala/collection_immutable"

// Shorthand struct: every field gets `val`/Immutable semantics, so field
// access must auto-unwrap the Immutable[T] wrapper via .Get().
struct Person(Name string, Age int)

func main() {
    val people = ArrayOf(Person(Name = "Alice", Age = 30), Person(Name = "Bob", Age = 25))

    // Placeholder shorthand `_.Field` MUST behave exactly like the explicit
    // lambda `(p) => p.Field`, including the Immutable auto-unwrap. Both must
    // print unwrapped values (Alice, Bob), not wrapped ({Alice}, {Bob}).
    val namesPlaceholder = people.Map(_.Name)
    val namesExplicit = people.Map((p) => p.Name)
    Println(namesPlaceholder.String())
    Println(namesExplicit.String())

    // Same for a non-string (int) field.
    val agesPlaceholder = people.Map(_.Age)
    val agesExplicit = people.Map((p) => p.Age)
    Println(agesPlaceholder.String())
    Println(agesExplicit.String())
}
-- examples/placeholder_generic_ctor.gala --
package main

// A placeholder lambda passed to a generic struct or sealed-variant
// constructor is typed like the explicit lambda it stands for: a type
// parameter a sibling argument binds types the placeholder, and one only the
// callback determines is inferred from its body.

type Conv[A any, B any] func(A) B

struct Step[A any, B any](In A, Run func(A) B)

struct AliasStep[A any, B any](In A, Run Conv[A, B])

struct Fold[A any](Zero A, Combine func(A, A) A)

struct Person(Name string, Age int)

sealed type Job[A any, B any] {
    case Mapper(Input A, Fn func(A) B)
}

func main() {
    val step = Step(In = 4, Run = _ * 10)
    Println(step.Run(step.In))

    val shout = Step("go", _ + "!")
    Println(shout.Run(shout.In))

    val aliased = AliasStep(In = 5, Run = _ * 10)
    Println(aliased.Run(aliased.In))

    val sum = Fold(Zero = 0, Combine = _ + _)
    Println(sum.Combine(3, 4))

    val name = Step(In = Person("Ann", 30), Run = _.Name)
    Println(name.Run(name.In))

    val job = Mapper(Input = 3, Fn = _ * 2)
    Println(job.Fn(job.Input))
}
-- examples/placeholder_lambda.gala --
package main

import (
    "fmt"
    . "martianoff/gala/collection_immutable"
)

// L4: Placeholder lambda shorthand — `_ * 2` desugars to `(x) => x * 2`.
// Exercises:
//   - single placeholder in a Map call
//   - single placeholder in a Filter call
//   - placeholder with method-call body (_.toString-style chaining)
//   - two placeholders in a FoldLeft → two-param lambda
//   - placeholder with nested expression (_ + 1) * 2 semantics
func main() {
    val nums = ArrayOf[int](1, 2, 3, 4, 5)

    // Single placeholder — doubles each element.
    val doubled = nums.Map(_ * 2)
    fmt.Println(doubled.Get(0), doubled.Get(1), doubled.Get(4))

    // Single placeholder — keeps only even elements.
    val evens = nums.Filter(_ % 2 == 0)
    fmt.Println(evens.Size())

    // Two placeholders — sum via FoldLeft.
    val sum = nums.FoldLeft(0, _ + _)
    fmt.Println(sum)

    // Two placeholders — product via FoldLeft.
    val product = nums.FoldLeft(1, _ * _)
    fmt.Println(product)

    // Placeholder with parenthesized nested expression.
    val plusOneDoubled = nums.Map((_ + 1) * 2)
    fmt.Println(plusOneDoubled.Get(0), plusOneDoubled.Get(4))
}
-- examples/placeholder_void_context.gala --
package main

import . "martianoff/gala/collection_immutable"

// Regression: a placeholder lambda whose expected callback returns nothing must
// lower to a result-less Go func literal (`func(s string) { shout(s) }`).
// Emitting a result type in that position produces the non-existent Go type
// `void`, which does not compile.
func shout(s string) {
    Println(s"${s}!")
}

func main() {
    // Placeholder calling a user-declared void function.
    ArrayOf("a", "b").ForEach(shout(_))

    // Placeholder calling the Println sugar (multi-return Go call, discarded).
    ArrayOf(1, 2).ForEach(Println(_))

    // Value context is unaffected: the result type is still inferred.
    Println(ArrayOf(1, 2, 3).Map(_ + 1).FoldLeft(0, _ + _))
}
-- examples/plugin_test_file.gala --
// Plugin Feature Test File
// Open this file in GoLand with the GALA plugin to verify all features.
// Each section tests a specific plugin capability.
// Expected behavior is documented in comments with [EXPECT] markers.

package main

import "fmt"
import "martianoff/gala/collection_immutable"
import ci "martianoff/gala/collection_immutable"

// ============================================================
// === 1. Syntax Highlighting ===
// ============================================================
// [EXPECT] Keywords bold/colored: val, var, func, type, match, case, if, else, for, return, sealed
// [EXPECT] Built-in types highlighted: int, string, bool, float64, error, any, byte, rune

// ============================================================
// === 2. Struct Declaration + Named Args ===
// ============================================================
type Person struct {
    val name string
    val age int
    val email string
}

// [EXPECT] Hover over Person → shows fields: val name string, val age int, val email string
// [EXPECT] Type "Person(" → suggests: name =, age =, email =

// ============================================================
// === 3. Sealed Type + Pattern Matching ===
// ============================================================
sealed type Shape {
    case Circle(radius float64)
    case Rectangle(width float64, height float64)
    case Triangle(base float64, height float64)
}

// [EXPECT] Hover over Shape → shows cases: Circle, Rectangle, Triangle

// ============================================================
// === 4. Methods with Receivers ===
// ============================================================
func (p Person) FullInfo() string {
    return s"${p.name} (age ${p.age}, ${p.email})"
}

func (p Person) IsAdult() bool {
    return p.age >= 18
}

func (s Shape) Describe() string {
    return s match {
        case Circle(r) => s"Circle r=$r"
        case Rectangle(w, h) => s"Rect ${w}x${h}"
        case Triangle(b, h) => s"Tri base=$b h=$h"
    }
}

// [EXPECT] No false "already declared" on FullInfo/IsAdult/Describe (different receivers)

// ============================================================
// === 5. Function with Return Type ===
// ============================================================
func area(s Shape) float64 {
    return s match {
        // [EXPECT] Type hints on pattern bindings:
        //   r: float64, w: float64, h: float64, b: float64
        case Circle(r) => 3.14159 * r * r
        case Rectangle(w, h) => w * h
        case Triangle(b, h) => 0.5 * b * h
    }
}

func perimeter(s Shape) float64 {
    return s match {
        case Circle(r) => 2.0 * 3.14159 * r
        case Rectangle(w, h) => 2.0 * (w + h)
        case Triangle(b, h) => b + h + b  // simplified
    }
}

// ============================================================
// === 6. Option Chaining ===
// ============================================================
func findPerson(name string) Option[Person] {
    if name == "Alice" {
        return Some(Person(name = "Alice", age = 30, email = "alice@example.com"))
    }
    return None[Person]()
}

func testOptionChaining() {

    val result = findPerson("Alice")
    // [EXPECT] result type hint: Option[Person] or Option
    // [EXPECT] Type "result." → suggests Option methods: Get(), Map(), FlatMap(), IsDefined(), etc.
    // [EXPECT] Methods show signatures: Get() Person, Map(...) Option, IsDefined() bool

    val nameOpt = result.Map((p Person) => p.name)
    // [EXPECT] nameOpt type hint: Option (from Map return type)
    // [EXPECT] Type "nameOpt." → suggests Option methods

    val upper = nameOpt.Map((s string) => s)
    // [EXPECT] Chained .Map → still Option methods

    val isDefined = result.IsDefined()
    // [EXPECT] isDefined type hint: bool

    val name = result.GetOrElse(Person(name = "Unknown", age = 0, email = ""))
    // [EXPECT] name type hint: Person
    // [EXPECT] Type "name." → suggests: name, age, email (fields) + FullInfo(), IsAdult()
}

// ============================================================
// === 7. Either Type ===
// ============================================================
func divide(a int, b int) Either[string, float64] {
    if b == 0 {
        return Left[string, float64]("division by zero")
    }
    return Right[string, float64](float64(a) / float64(b))
}

func testEither() {
    val result = divide(10, 3)
    // [EXPECT] result type hint: Either
    // [EXPECT] Type "result." → suggests Either methods: IsLeft(), IsRight(), Map(), Fold(), etc.

    val mapped = result.Map((x float64) => x * 2.0)
    // [EXPECT] mapped type hint: Either (from Map return type)
}

// ============================================================
// === 8. Try Type ===
// ============================================================
func safeParse(s string) Try[int] {
    return Success(42)  // simplified
}

func testTry() {
    val result = safeParse("42")
    // [EXPECT] result type hint: Try
    // [EXPECT] Type "result." → suggests Try methods: Get(), Map(), IsSuccess(), ToOption(), etc.

    val opt = result.ToOption()
    // [EXPECT] opt type hint: Option (from ToOption return type)
    // [EXPECT] Type "opt." → suggests Option methods
}

// ============================================================
// === 9. Method Tooltips + Auto-Parentheses ===
// ============================================================
func testMethodTooltips() {
    val opt = Some("hello")
    // [EXPECT] Type "opt." and select:
    //   IsDefined() → auto-inserts "IsDefined()" with ()
    //   Map(        → auto-inserts "Map(" without closing paren (has params)
    //   Get()       → auto-inserts "Get()" with ()
    //   GetOrElse(  → auto-inserts "GetOrElse(" (has params)
    // [EXPECT] Each method shows full signature in completion list:
    //   IsDefined() bool
    //   Map(f func(T) U) Option
    //   Get() T

    val defined = opt.IsDefined()
    val value = opt.Get()
    Println(defined)
    Println(value)
}

// ============================================================
// === 10. Type Inference — All Forms ===
// ============================================================
func testTypeInference() {
    // Literal inference
    val s = "hello"          // [EXPECT] : string
    val i = 42               // [EXPECT] : int
    val f = 3.14             // [EXPECT] : float64
    val b = true             // [EXPECT] : bool

    // Constructor inference
    val p = Person(name = "Bob", age = 25, email = "bob@test.com")
    // [EXPECT] : Person

    val circle = Circle(radius = 10.0)
    // [EXPECT] : Shape

    // Short declaration
    x := 99                  // [EXPECT] : int
    name := "test"           // [EXPECT] : string

    // Sealed constructor inference
    val opt = Some(42)       // [EXPECT] : Option (parent sealed type)
    val either = Left[string, int]("error")  // [EXPECT] : Either

    // Function call inference
    val a = area(circle)     // [EXPECT] : float64 (from area return type)

    Println(s)
    Println(i)
    Println(f)
    Println(b)
    Println(p.name)
    Println(x)
    Println(name)
    Println(opt)
    Println(either)
    Println(a)
}

// ============================================================
// === 11. String Interpolation ===
// ============================================================
func testStringInterpolation() {
    val name = "World"
    val age = 30

    // [EXPECT] $name and ${age} highlighted differently from surrounding string
    val simple = s"Hello $name"
    val expr = s"Age: ${age + 1}"
    val multi = s"${name} is ${age} years old"

    // Format strings
    val pi = 3.14159
    val formatted = f"$pi%.2f"

    // Escaped dollar
    val escaped = s"Price: $$100"
    // [EXPECT] $$ not highlighted as interpolation

    Println(simple)
    Println(expr)
    Println(multi)
    Println(formatted)
    Println(escaped)
}

// ============================================================
// === 12. Lambda Expressions ===
// ============================================================
func testLambdas() {
    val double = (x int) => x * 2
    val add = (a int, b int) => a + b

    // Block lambda
    val process = (x int) => {
        val result = x * 2
        return result + 1
    }

    Println(double(5))
    Println(add(2, 3))
    Println(process(10))

    // Lambda in method call — param type inferred from context
    val opt = Some(42)
    val mapped = opt.Map((x int) => x * 2)
    // [EXPECT] In future: (x) => should infer x: int from Option.Map signature

    Println(mapped)
}

// ============================================================
// === 13. Match Expression Variants ===
// ============================================================
func testMatch() {
    val shape = Circle(radius = 5.0)

    // Match as expression
    val desc = shape match {
        case Circle(r) => s"Circle r=$r"
        case Rectangle(w, h) => s"Rect ${w}x${h}"
        case Triangle(b, _) => s"Tri b=$b"
    }
    // [EXPECT] desc: string

    // Match with guards
    val category = shape match {
        case Circle(r) if r > 10.0 => "large circle"
        case Circle(_) => "small circle"
        case _ => "other"
    }

    // [EXPECT] No "non-exhaustive match" warning (has wildcard _)

    Println(desc)
    Println(category)
}

// ============================================================
// === 14. If Expression ===
// ============================================================
func testIfExpression() {
    val x = 42
    val result = if (x > 0) "positive" else "non-positive"
    // [EXPECT] result: string

    val abs = if (x >= 0) x else -x
    // [EXPECT] abs: int (if both branches are int)

    Println(result)
    Println(abs)
}

// ============================================================
// === 15. For Loops ===
// ============================================================
func testForLoops() {
    val nums = SliceOf(1, 2, 3, 4, 5)

    // Range loop
    for i := range nums {
        Println(i)
    }

    // Classic for loop
    for i := 0; i < 5; i++ {
        Println(i)
    }
}

// ============================================================
// === 16. Go to Definition ===
// ============================================================
func testGoToDefinition() {
    val p = Person(name = "Test", age = 1, email = "t@t.com")

    // [EXPECT] Ctrl+Click on:
    //   "Person"   → jumps to type Person struct declaration (line ~20)
    //   "area"     → jumps to func area declaration (line ~65)
    //   "p"        → jumps to val p declaration (above)
    //   "greeting" → jumps to val declaration in main()
    //   "Shape"    → jumps to sealed type Shape declaration (line ~32)
    //   "Some"     → jumps to std library (if cross-file works)

    Println(p.FullInfo())
    Println(area(Circle(radius = 1.0)))
}

// ============================================================
// === 17. Type Aliases ===
// ============================================================
type Name string
type Age int
type Email string
type PersonInfo Tuple[Name, Age]

// [EXPECT] Hover over PersonInfo → resolves through alias to Tuple[Name, Age]
// [EXPECT] Ctrl+Click on Name/Age → jumps to alias declaration

func testTypeAliases() {
    val n Name = "Alice"
    val a Age = 30
    val info = Tuple[Name, Age](n, a)
    // [EXPECT] info: Tuple[Name, Age] or PersonInfo

    Println(n)
    Println(a)
    Println(info)
}

// ============================================================
// === 18. Deep Method Chaining (A → B → C → D) ===
// ============================================================

type Order struct {
    val id int
    val items int
    val total float64
}

func (o Order) Validate() Option[Order] {
    if o.items > 0 {
        return Some(o)
    }
    return None[Order]()
}

func (o Order) ApplyDiscount(pct float64) Order {
    return Order(id = o.id, items = o.items, total = o.total * (1.0 - pct))
}

func (o Order) ToSummary() string {
    return s"Order #${o.id}: ${o.items} items, $$${o.total}"
}

func testDeepChaining() {
    val order = Order(id = 1, items = 3, total = 99.99)
    // [EXPECT] order: Order

    // Chain: Order → Option[Order] → Option (via Map) → string (via GetOrElse)
    val validated = order.Validate()
    // [EXPECT] validated: Option[Order]

    val discounted = validated.Map((o Order) => o.ApplyDiscount(0.1))
    // [EXPECT] discounted: Option (from Map return type)

    val summary = discounted.Map((o Order) => o.ToSummary())
    // [EXPECT] summary: Option (from Map return type)

    val result = summary.GetOrElse("No order")
    // [EXPECT] result type from GetOrElse

    // Direct deep chain: Order.Validate().Map(...).GetOrElse(...)
    val oneShot = order.Validate().Map((o Order) => o.ToSummary()).GetOrElse("N/A")
    // [EXPECT] Each dot in the chain should resolve:
    //   order.         → Order methods: Validate(), ApplyDiscount(), ToSummary(), id, items, total
    //   .Validate()    → Option[Order] methods: Map(), FlatMap(), Get(), IsDefined()...
    //   .Map(...)      → Option methods
    //   .GetOrElse()   → result type

    Println(result)
    Println(oneShot)

    // Either chaining: Either[string, int] → Either (Map) → Option (ToOption)
    val parsed = Right[string, int](42)
    // [EXPECT] parsed: Either[string, int]

    val doubled = parsed.Map((x int) => x * 2)
    // [EXPECT] doubled: Either

    val asOption = doubled.Map((x int) => x + 1)
    // [EXPECT] asOption: Either

    // Try → Option → value
    val tried = Success(100)
    // [EXPECT] tried: Try
    val tryOpt = tried.ToOption()
    // [EXPECT] tryOpt: Option
    val tryVal = tryOpt.GetOrElse(0)
    // [EXPECT] tryVal type from GetOrElse

    Println(doubled)
    Println(asOption)
    Println(tryVal)
}

// ============================================================
// === 19. Go Function Calls ===
// ============================================================
func testGoFunctions() {
    // Go built-in functions
    val nums = SliceOf(1, 2, 3, 4, 5)
    val size = nums.Size()               // [EXPECT] : int
    // [EXPECT] len highlighted as built-in function

    val s = "Hello, GALA!"
    val sLen = s.Size()                   // [EXPECT] : int

    // fmt package functions
    fmt.Println("direct fmt call")
    fmt.Printf("formatted: %d\n", 42)

    // String conversions
    val str = s"Number: ${size}"
    // [EXPECT] str: string

    // Slice operations
    val first = nums[0]
    // [EXPECT] Ctrl+Click on SliceOf → should recognize as built-in

    Println(size)
    Println(sLen)
    Println(str)
    Println(first)
}

// ============================================================
// === 20. Tuple Destructuring ===
// ============================================================
func swap(a int, b int) Tuple[int, int] {
    return Tuple[int, int](b, a)
}

func testTupleDestructuring() {
    val pair = Tuple[int, int](10, 20)
    // [EXPECT] pair: Tuple[int, int]

    // Tuple access
    val first = pair.First
    val second = pair.Second
    // [EXPECT] Type "pair." → suggests: First, Second (fields)

    // Tuple from function
    val swapped = swap(1, 2)
    // [EXPECT] swapped: Tuple[int, int]

    // Destructuring with val (a, b) = tuple
    val (x, y) = swap(3, 4)
    // [EXPECT] x and y are destructured — type hints may not show here

    Println(first)
    Println(second)
    Println(swapped)
    Println(x)
    Println(y)
}

// ============================================================
// === 21. Type Aliases (Advanced) ===
// ============================================================
type UserID int
type Username string
type UserMap map[UserID]Username

func createUser(id UserID, name Username) Tuple[UserID, Username] {
    return Tuple[UserID, Username](id, name)
}

func testTypeAliasesAdvanced() {
    val id UserID = 1
    val name Username = "Alice"
    // [EXPECT] id: UserID, name: Username (explicit types, no hint needed)

    val user = createUser(id, name)
    // [EXPECT] user: Tuple[UserID, Username]

    // Alias used as function param type
    val newId UserID = 42
    val greeting = s"User #${newId}: ${name}"
    // [EXPECT] greeting: string

    // Type alias in match
    val result = if (newId > 0) "valid" else "invalid"
    // [EXPECT] result: string

    Println(user)
    Println(greeting)
    Println(result)
}

// ============================================================
// === 22. Interface Implementation ===
// ============================================================
type Describable interface {
    Describe() string
}

// Person and Shape both implement Describable (Shape already has Describe)
func (p Person) Describe() string {
    return p.FullInfo()
}

func printDescription(d Describable) {
    Println(d.Describe())
}

func testInterfaces() {
    val p = Person(name = "Bob", age = 25, email = "bob@test.com")
    val s = Circle(radius = 5.0)

    // Both should work as Describable
    printDescription(p)
    printDescription(s)
    // [EXPECT] Ctrl+Click on Describable → jumps to interface declaration
    // [EXPECT] Hover on Describable → shows: Describe() string
}

// ============================================================
// === 23. Find Usages ===
// ============================================================
// [EXPECT] Right-click on "Person" → Find Usages → shows all references:
//   - Type declaration
//   - Function parameters (findPerson return type)
//   - Constructor calls
//   - Method receivers

// ============================================================
// === 18. Structure View ===
// ============================================================
// [EXPECT] Open Structure view (Alt+7) → shows:
//   - Person (type, with fields)
//   - Shape (sealed type, with Circle/Rectangle/Triangle)
//   - area, perimeter (functions)
//   - findPerson, testOptionChaining, testEither, testTry, etc.
//   - main

// ============================================================
// === MAIN ===
// ============================================================
func main() {
    Println("=== Plugin Test File ===")

    testOptionChaining()
    testEither()
    testTry()
    testMethodTooltips()
    testTypeInference()
    testStringInterpolation()
    testLambdas()
    testMatch()
    testIfExpression()
    testForLoops()
    testGoToDefinition()
    testTypeAliases()
    testDeepChaining()
    testGoFunctions()
    testTupleDestructuring()
    testTypeAliasesAdvanced()
    testInterfaces()

    testCollectionImmutable()
    testPackageAlias()
    testScopedTypeInference()

    Println("=== All tests complete ===")
}

// ============================================================
// === 20. Collection Immutable (Package Dot Completion) ===
// ============================================================
func testCollectionImmutable() {
    // [EXPECT] "collection_immutable." triggers completion showing: ArrayOf, HashMap, List, etc.
    val arr = collection_immutable.ArrayOf(1, 2, 3)

    // [EXPECT] arr. triggers completion showing: Map, Filter, ForEach, FoldLeft, Head, Tail, Size, etc.
    val doubled = arr.Map((x) => x * 2)
    val evens = arr.Filter((x) => x % 2 == 0)
    val sum = arr.FoldLeft(0, (acc, x) => acc + x)

    // [EXPECT] Type hints: arr :Array[int], doubled :Array[int], evens :Array[int], sum :int
    Println(s"arr=$arr doubled=$doubled evens=$evens sum=$sum")
}

// ============================================================
// === 21. Package Alias Completion ===
// ============================================================
func testPackageAlias() {
    // [EXPECT] "ci." triggers completion showing same types as collection_immutable.
    val list = ci.ArrayOf("hello", "world")

    // [EXPECT] list. triggers completion showing: Map, Filter, Size, Head, etc.
    val upper = list.Map((s) => s)
    val count = list.Size()

    // [EXPECT] Type hints: list :Array[string], count :int
    Println(s"list=$list upper=$upper count=$count")
}

// ============================================================
// === 22. Scoped Type Inference ===
// ============================================================
// [EXPECT] Type hints for "a" should be DIFFERENT in each function
func greetPerson(p Person) string {
    // [EXPECT] a :string (from p.name, not int from other function)
    val a = p.name
    return a
}

func isPersonAdult(p Person) bool {
    // [EXPECT] a :int (from p.age, not string from other function)
    val a = p.age
    return a >= 18
}

func testScopedTypeInference() {
    val p = Person(name = "Alice", age = 30, email = "alice@example.com")
    val greeting = greetPerson(p)
    val adult = isPersonAdult(p)
    Println(s"greeting=$greeting adult=$adult")
}
-- examples/pointer_hash_keys.gala --
package main

import (
    im "martianoff/gala/collection_immutable"
    mu "martianoff/gala/collection_mutable"
)

// A pointer whose target has no Hash method is a HashSet element or HashMap
// key by its address: two pointers are the same key only when they point to
// the same value, as == says.

struct Node(Name string)

// Person hashes by its fields, so a *Person hashes as the Person it points to.
struct Person(Name string)

func (p Person) Hash() uint32 = HashString(p.Name)

func main() {
    val a = &Node("a")
    val b = &Node("b")
    val twin = &Node("a")

    val visited = im.EmptyHashSet[*Node]().Add(a).Add(b).Add(a).Add(twin)
    Println(s"immutable set size: ${visited.Size()}")
    Println(s"contains a: ${visited.Contains(a)}, twin: ${visited.Contains(twin)}, fresh: ${visited.Contains(&Node("a"))}")
    Println(s"without a: ${visited.Remove(a).Size()}, still has twin: ${visited.Remove(a).Contains(twin)}")

    val labels = im.EmptyHashMap[*Node, string]().Put(a, "first").Put(b, "second").Put(a, "again")
    Println(s"immutable map: ${labels.Size()} ${labels.GetOrElse(a, "?")} ${labels.GetOrElse(twin, "?")}")

    // Enough keys that the trie splits its nodes and rehashes the keys there.
    val nodes = im.ArrayTabulate(200, (i) => &Node(s"n$i"))
    val many = nodes.FoldLeft(im.EmptyHashSet[*Node](), (acc, n) => acc.Add(n))
    Println(s"many: ${many.Size()}, all found: ${nodes.ForAll((n) => many.Contains(n))}")

    val seen = mu.EmptyHashSet[*Node]()
    seen.Add(a)
    seen.Add(twin)
    seen.Add(a)
    Println(s"mutable set size: ${seen.Size()}, contains b: ${seen.Contains(b)}")

    val counts = mu.EmptyHashMap[*Node, int]()
    counts.Put(a, 1)
    counts.Put(twin, 2)
    counts.Put(a, 3)
    Println(s"mutable map: ${counts.Size()} ${counts.GetOrElse(a, 0)} ${counts.GetOrElse(twin, 0)}")

    // Pointers to a primitive work the same way.
    var x = 1
    var y = 1
    Println(s"int pointers: ${im.EmptyHashSet[*int]().Add(&x).Add(&y).Add(&x).Size()}")

    // A pointer to a Hashable value hashes as that value, and == still tells
    // two pointers apart.
    val alice = &Person("alice")
    val people = im.EmptyHashSet[*Person]().Add(alice).Add(&Person("alice")).Add(alice)
    Println(s"people: ${people.Size()}, hash as value: ${HashKey(alice) == Person("alice").Hash()}")
}
-- examples/pointer_method_on_val.gala --
package main

import (
    "net/url"
)

// A pointer-receiver method needs an addressable receiver in Go. A val is read
// through a copy, so the method runs on a fresh copy and the val never changes.

struct Counter(var n int)

func (c *Counter) Bump() int {
    c.n = c.n + 1
    return c.n
}

struct Link(target url.URL, label string)

func (l Link) Render() string = s"${l.label} -> ${l.target.String()}"

func home() url.URL = url.URL(Scheme = "https", Host = "gala.dev", Path = "/")

func main() {
    // Go method with a pointer receiver (url.URL.String) on a val.
    val u = url.URL(Scheme = "https", Host = "example.com", Path = "/docs")
    val rendered = u.String()
    Println(rendered.Size())
    Println(rendered)

    // On a field reached through a val, a call result, and a literal.
    val link = Link(target = u, label = "docs")
    Println(link.target.String())
    Println(link.Render())
    Println(home().String())
    Println(url.URL(Scheme = "ftp", Host = "files.example.com").String())

    // GALA method with a pointer receiver: it mutates the copy, not the val.
    val c = Counter(n = 1)
    Println(c.Bump())
    Println(c.n)

    // A var is addressable, so the method mutates it in place.
    var m = Counter(n = 10)
    m.Bump()
    Println(m.n)
}
-- examples/pointer_receiver_generic_method_val.gala --
package main

import (
    im "martianoff/gala/collection_immutable"
    mu "martianoff/gala/collection_mutable"
)

// Generic methods on pointer-receiver (mutable) collections keep the receiver's type arguments.

struct Row(Name string, K int)

func main() {
    // Mutable Array: val bound to SortBy, then a follow-up generic call.
    val rows = mu.ArrayOf(Row("a", 2), Row("b", 0), Row("c", 1))
    val sorted = rows.SortBy((r) => r.K)
    Println(sorted.Map((r) => r.Name).MkString(","))

    // Mutable Array: val bound to Map (a type change), then a follow-up call.
    val names = rows.Map((r) => r.Name)
    Println(names.SortBy((n) => n).Reversed().MkString(","))

    // Mutable Array: val bound to Zip, whose result is built from both
    // the receiver's T and the method's U.
    val zipped = rows.Zip(names)
    Println(zipped.Map((p) => s"${p.V1.K}${p.V2}").MkString(","))

    // Mutable HashMap: SortBy returns Array[Tuple[K, V]], a different generic
    // type built from the receiver's params. Chained and val-bound forms.
    val counts = mu.HashMapOf(("x", 3), ("y", 1), ("z", 2))
    Println(counts.SortBy((e) => e.V2).Map((e) => e.V1).MkString(","))
    val byCount = counts.SortBy((e) => e.V2)
    Println(byCount.Map((e) => e.V2).FoldLeft(0, (acc, n) => acc + n))

    // Immutable Array (value receiver): same shape, as a control.
    val irows = im.ArrayOf(Row("a", 2), Row("b", 0), Row("c", 1))
    val isorted = irows.SortBy((r) => r.K)
    Println(isorted.Map((r) => r.Name).MkString(","))
    val inames = irows.Map((r) => r.Name)
    Println(inames.SortBy((n) => n).Reverse().MkString(","))
}
-- examples/pointer_semantics.gala --
package main

import "fmt"

// Node with mutable fields for full mutability
type MutableNode struct {
    var value int
    var next *MutableNode
}

// Node with immutable value but mutable pointer (common pattern)
type Node struct {
    value int          // immutable value
    var next *Node     // mutable pointer - can traverse linked structures
}

// Test: Mutable pointer field traversal with immutable values
func testImmutableValuesWithMutablePointers() {
    var node3 = Node(value = 30, next = nil)
    var node2 = Node(value = 20, next = &node3)
    var node1 = Node(value = 10, next = &node2)

    fmt.Println("Linked list (immutable values, mutable pointers):")
    var current *Node = &node1
    var i = 0
    for current != nil {
        fmt.Printf("  Node %d: value = %d\n", i, current.value)
        current = current.next
        i = i + 1
    }
}

// Test: Fully mutable node - can modify value through pointer
func testFullyMutableNodes() {
    var node2 = MutableNode(value = 20, next = nil)
    var node1 = MutableNode(value = 10, next = &node2)

    fmt.Printf("Before mutation: node1.next.value = %d\n", node1.next.value)
    node1.next.value = 999
    fmt.Printf("After mutation: node1.next.value = %d\n", node1.next.value)
}

// Test: val binding with pointer to mutable data (primitive)
func testValPointerToMutablePrimitive() {
    var data = 42
    val ptr = &data  // ptr binding is immutable, but data is mutable

    // Can modify through the pointer
    *ptr = 100
    fmt.Printf("Val pointer to mutable: *ptr = %d, data = %d\n", *ptr, data)
}

// Test: var binding with pointer - can reassign pointer
func testVarPointerReassign() {
    var data1 = 10
    var data2 = 20
    var ptr = &data1

    fmt.Printf("Before reassign: *ptr = %d\n", *ptr)
    ptr = &data2
    fmt.Printf("After reassign: *ptr = %d\n", *ptr)
}

// Test: Shared mutable node through pointers
func testSharedMutableNode() {
    var shared = MutableNode(value = 100, next = nil)
    var holder1 = MutableNode(value = 1, next = &shared)
    var holder2 = MutableNode(value = 2, next = &shared)

    fmt.Printf("Before: holder1.next.value=%d, holder2.next.value=%d\n",
        holder1.next.value, holder2.next.value)

    // Modify shared node through holder1's pointer
    holder1.next.value = 999

    fmt.Printf("After: holder1.next.value=%d, holder2.next.value=%d\n",
        holder1.next.value, holder2.next.value)
}

// Test: Pointer equality
func testPointerEquality() {
    var node = MutableNode(value = 42, next = nil)
    var ptr1 = &node
    var ptr2 = &node
    var otherNode = MutableNode(value = 42, next = nil)
    var ptr3 = &otherNode

    fmt.Printf("Same object pointers equal: %v\n", ptr1 == ptr2)
    fmt.Printf("Different object pointers equal: %v\n", ptr1 == ptr3)
}

// Test: Copy with nil pointer field (regression test for std.Copy panic)
func testCopyWithNilPointer() {
    var node = MutableNode(value = 42, next = nil)
    val copied = node.Copy()  // Should not panic

    fmt.Printf("Original: value=%d, next=%v\n", node.value, node.next)
    fmt.Printf("Copied: value=%d, next=%v\n", copied.value, copied.next)
}

// Test: Copy linked list (shallow copy)
func testCopyLinkedList() {
    var node2 = MutableNode(value = 20, next = nil)
    var node1 = MutableNode(value = 10, next = &node2)

    val copied = node1.Copy()

    fmt.Printf("Original node1.next.value: %d\n", node1.next.value)
    fmt.Printf("Copied node1.next.value: %d\n", copied.next.value)
    fmt.Printf("Same next pointer (shallow copy): %v\n", node1.next == copied.next)
}

// Test: An immutable linked list is a sealed type, not a chain of pointers.
// Its values are shared by value; nothing can change them.
sealed type IntList {
    case End()
    case Cons(head int, tail IntList)
}

func listValues(l IntList) string = l match {
    case End() => ""
    case Cons(h, End()) => s"$h"
    case Cons(h, t) => s"$h ${listValues(t)}"
}

func testImmutableList() {
    val list = Cons(10, Cons(20, Cons(30, End())))
    Println("Immutable list as a sealed type:")
    Println(s"  values = ${listValues(list)}")
}

// Test: Read-only access to a val is the val itself. A val has no address, so
// a function reads it by value and a struct holds it by value.
type Person struct {
    name string
    var age int
}

type Team struct {
    leader Person
    var memberCount int
}

func leaderName(team Team) string = team.leader.name

func testReadOnlyByValue() {
    val alice = Person(name = "Alice", age = 30)
    val team = Team(leader = alice, memberCount = 5)

    Println("Read-only access by value:")
    Println(s"  Team leader: ${team.leader.name}")
    Println(s"  Leader name via function: ${leaderName(team)}")
    Println(s"  Member count: ${team.memberCount}")
}

func main() {
    fmt.Println("=== GALA Pointer Semantics Test ===")
    fmt.Println()

    testImmutableValuesWithMutablePointers()
    fmt.Println()

    testFullyMutableNodes()
    fmt.Println()

    testValPointerToMutablePrimitive()
    fmt.Println()

    testVarPointerReassign()
    fmt.Println()

    testSharedMutableNode()
    fmt.Println()

    testPointerEquality()
    fmt.Println()

    testCopyWithNilPointer()
    fmt.Println()

    testCopyLinkedList()
    fmt.Println()

    testImmutableList()
    fmt.Println()

    testReadOnlyByValue()

    fmt.Println()
    fmt.Println("=== All tests completed ===")
}
-- examples/ptr_checked.gala --
package main

// Ptr[T]: a pointer that is never nil. `&x` is one, it erases to `*T` in the
// generated Go, and a pointer from Go becomes one only through RequirePtr.

struct Counter(var N int)

func (c Ptr[Counter]) Bump() {
    c.N = c.N + 1
}

func bumpTwice(c Ptr[Counter]) {
    c.Bump()
    c.Bump()
}

// A Go-style function: its pointer may be nil.
func goLookup(found bool, c *Counter) *Counter {
    if found {
        return c
    }
    return nil
}

// Fills a Go-style function slot: the callback may be handed a nil pointer.
func visit(f func(*Counter), c *Counter) = f(c)

func describe(t Try[int]) string = t match {
    case Success(n) => s"ok $n"
    case Failure(e) => s"panic: ${e.Error()}"
}

func main() {
    var c = Counter(0)
    val p = &c
    bumpTwice(p)
    Println(s"after bumpTwice: ${c.N}")

    // A Ptr fills a *T slot as it is.
    val back = goLookup(true, p)
    Println(s"Go pointer is nil: ${back == nil}")

    // A *T from Go is checked once, at the boundary.
    val checked = RequirePtr(back)
    checked.Bump()
    Println(s"through RequirePtr: ${c.N}")
    Println(describe(Try(RequirePtr(goLookup(false, p)).N)))

    // A lambda with a Ptr parameter, called from a slot whose parameter is a
    // *T, checks it on entry.
    visit((q Ptr[Counter]) => q.Bump(), p)
    Println(s"after visit: ${c.N}")
    Println(describe(Try(() => {
        visit((q Ptr[Counter]) => q.Bump(), goLookup(false, p))
        c.N
    })))

    // The address of a composite literal is a Ptr too.
    val fresh = &Counter(10)
    fresh.Bump()
    Println(s"fresh: ${fresh.N}")
}
-- examples/ptr_cycle_lowered_crosspkg.gala --
package main

import "martianoff/gala/examples/ptr_cycle_lowered_lib"

// Methods another package lowers to functions, because each returns its
// receiver's type with another type argument, are called as those functions
// here too: on a Ptr receiver, on a *T receiver, with a value result and with
// a Go result list, through a Ptr and on an addressable value.

func main() {
    val b = ptr_cycle_lowered_lib.NewBox(1)
    Println(s"Ptr: ${b.Wrap().V.V}")
    Println(s"*T: ${b.WrapStar().V.V}")
    Println(s"value result: ${b.Pair().V.V2}")
    Println(s"Go results: ${b.Split().Map((p) => p.V.V1).GetOrElse(0)}")

    var v = ptr_cycle_lowered_lib.Box(2)
    Println(s"on a var: ${v.Pair().V.V1}")
}
-- examples/ptr_cycle_lowered_lib/box.gala --
package ptr_cycle_lowered_lib

// Box holds one value.
struct Box[T any](V T)

// Wrap boxes the box. Its result is Box with another type argument, so it is
// lowered to a function (a Go instantiation cycle).
func (b Ptr[Box[T]]) Wrap() Ptr[Box[Ptr[Box[T]]]] = &Box(b)

// WrapStar is Wrap on a *Box receiver.
func (b *Box[T]) WrapStar() *Box[*Box[T]] = &Box(b)

// Pair boxes the value twice, by value.
func (b *Box[T]) Pair() Box[Tuple[T, T]] = Box((b.V, b.V))

// Split is Pair as a Go result list.
func (b *Box[T]) Split() (Box[Tuple[T, T]], error) = Success(Box((b.V, b.V)))

// NewBox returns a Box.
func NewBox[T any](v T) Ptr[Box[T]] = &Box(v)
-- examples/ptr_receiver.gala --
package main

// A method on a Ptr[T] receiver runs only on a pointer that is never nil.
// GALA calls it on an addressable value (through `&x`), on a Ptr, or on a Go
// pointer checked with RequirePtr, and rejects a call on a *T that may be nil
// (GALA-E0080). An exported one also checks its receiver on entry, for a nil
// that arrives from outside GALA's checks.

struct Counter(var N int)

func (c Ptr[Counter]) Bump() {
    c.N = c.N + 1
}

func (c Ptr[Counter]) Count() int = c.N

type Bumper interface {
    Bump()
}

// A type parameter constrained by Bumper takes a Ptr[Counter]; a *Counter that
// may be nil is no type argument of it (GALA-E0080).
func bumpTwice[B Bumper](b B) {
    b.Bump()
    b.Bump()
}

struct Box[T any](var V T)

func (b Ptr[Box[T]]) Set(v T) {
    b.V = v
}

// A Go-style lookup: its pointer may be nil.
func goLookup(found bool, c *Counter) *Counter = if (found) c else nil

// A method on the nullable *Counter: a *Counter that may be nil is a Named.
func (c *Counter) Name() string = "counter"

type Named interface {
    Name() string
}

// Asks a Named whether it is also a Bumper, as Go code would.
func bumpNamed(n Named) = n match {
    case b: Bumper => b.Bump()
    case _ => Println(s"${n.Name()} is not a Bumper")
}

func describe(t Try[int]) string = t match {
    case Success(n) => s"ok $n"
    case Failure(e) => s"panic: ${e.Error()}"
}

func main() {
    var c = Counter(0)
    c.Bump()
    val p = &c
    p.Bump()
    Println(s"count: ${c.Count()}")

    // A method value on a Ptr.
    val count = p.Count
    Println(s"method value: ${count()}")

    // A Go pointer is checked once, then the method runs on it.
    RequirePtr(goLookup(true, p)).Bump()
    OptionPtrOf(goLookup(false, p)).ForEach((q) => q.Bump())
    Println(s"after lookups: ${c.N}")

    // A Ptr fills an interface whose method has a Ptr receiver.
    val b Bumper = p
    b.Bump()
    Println(s"through the interface: ${c.N}")

    // A Ptr type argument, inferred.
    bumpTwice(p)
    Println(s"through a type parameter: ${c.N}")

    var box = Box(1)
    box.Set(5)
    Println(s"box: ${box.V}")

    // A nil *Counter that reaches Bump through a type test on another
    // interface is caught on entry.
    Println(describe(Try(() => {
        bumpNamed(goLookup(false, p))
        c.N
    })))
}
-- examples/ptr_receiver_bind.gala --
package main

// `bind` and `also` lower to the monad's FlatMap and ZipN calls, so a monad
// whose FlatMap or ZipN has a Ptr[T] receiver binds only a value that is never
// nil: a Ptr, `&x`, a var or val (through its address or an addressed copy),
// or the Ptr inside an OptionPtr. A *T that may be nil is rejected at the
// clause (GALA-E0080), as `find(false).FlatMap(...)` is; RequirePtr checks one
// at the clause instead of deep inside FlatMap.

struct Cell[T any](V T)

func (c Ptr[Cell[T]]) FlatMap[U any](f func(T) Cell[U]) Cell[U] = f(c.V)

func (c Ptr[Cell[T]]) Zip2[U any](o Cell[U]) Cell[Tuple[T, U]] = Cell(Tuple(c.V, o.V))

// A Zip may return a Ptr: FlatMap runs on it as it is.
func (c Ptr[Cell[T]]) Zip3[U any, V any](o Cell[U], p Cell[V]) Ptr[Cell[Tuple3[T, U, V]]] =
    &Cell(Tuple3(c.V, o.V, p.V))

// A Go-style lookup: its pointer may be nil.
func find(found bool) *Cell[int] = if (found) &Cell(1) else nil

func viaPtr(found bool) Cell[int] {
    bind a = RequirePtr(find(found))
    Cell(a + 1)
}

func viaAddress() Cell[int] {
    var c = Cell(2)
    bind a = &c
    Cell(a * 10)
}

func viaVar() Cell[int] {
    var c = Cell(3)
    bind a = c
    Cell(a * 10)
}

func viaVals() Cell[int] {
    val c = Cell(4)
    bind a = c
    bind b = Cell(5)
    Cell(a * b)
}

func viaOptionPtr(found bool) Cell[int] =
    OptionPtrOf(find(found)).Map((p) => {
        bind a = p
        Cell(a + 100)
    }).GetOrElse(Cell(-1))

func zipped() Cell[int] {
    bind a = RequirePtr(find(true))
    also b = Cell(20)
    Cell(a + b)
}

func zipped3() Cell[int] {
    bind a = Cell(1)
    also b = Cell(2)
    also c = Cell(3)
    Cell(a * 100 + b * 10 + c)
}

struct Pin[T any](V T)

func (p Pin[T]) FlatMap[U any](f func(T) Pin[U]) Pin[U] = f(p.V)

// A Zip parameter may be a Ptr: an `also` clause fills it with `&x` (or a
// RequirePtr), never with a pointer that may be nil.
func (p Ptr[Pin[T]]) Zip2[U any](o Ptr[Pin[U]]) Pin[Tuple[T, U]] = Pin(Tuple(p.V, o.V))

func pinned() Pin[int] {
    var q = Pin(4)
    bind a = Pin(3)
    also b = &q
    Pin(a * b)
}

func describe(t Try[int]) string = t match {
    case Success(n) => s"ok $n"
    case Failure(e) => s"panic: ${e.Error()}"
}

func main() {
    Println(s"Ptr: ${viaPtr(true).V}")
    Println(s"address: ${viaAddress().V}")
    Println(s"var: ${viaVar().V}")
    Println(s"vals: ${viaVals().V}")
    Println(s"OptionPtr: ${viaOptionPtr(true).V} ${viaOptionPtr(false).V}")
    Println(s"also: ${zipped().V}")
    Println(s"also through a Ptr Zip: ${zipped3().V}")
    Println(s"also into a Ptr parameter: ${pinned().V}")
    Println(describe(Try(viaPtr(false).V)))
}
-- examples/qualified_lambda_infer.gala --
package main

import (
    "martianoff/gala/io"
    "errors"
)

// Repro: lambda param types should be inferred for package-qualified function calls.
// io.Recover takes func(error) T — the lambda param type `error` should be inferred.
// io.ForEach takes func(T) — the lambda param type should be inferred from IO's type param.

func main() {
    // Single-type-param function: Recover[T](IO[T], func(error) T)
    // Lambda param `err` should infer as `error`
    val failing = io.Fail[int](errors.New("oops"))
    val recovered = io.Recover(failing, (err) => -1)
    Println(s"Recovered: ${recovered.Run().Get()}")

    // Single-type-param function: ForEach[T](IO[T], func(T))
    // Lambda param `v` should infer as `int`
    var seen = 0
    io.ForEach(io.Of(42), (v) => { seen = v }).Run()
    Println(s"Seen: $seen")
}
-- examples/receiver_type_param_rename.gala --
package main

// A method's receiver may name its type's parameters differently from the
// type's declaration. A call types its arguments, lambdas included, against
// the type arguments of the receiver it is made on.

struct Box[T any](V T)

func (b Box[U]) Twice(f func(U) U) U = f(f(b.V))
func (b Box[Elem]) Apply(f func(Elem) Elem) Elem = f(b.V)
func (b Box[U]) Map[V any](f func(U) V) Box[V] = Box(f(b.V))
func (b *Box[U]) Peek(f func(U) string) string = f(b.V)
// The method's own `T` is not the type's `T`, which this receiver calls `U`.
func (b Box[U]) Describe[T any](f func(U) T) T = f(b.V)
func (b Box[U]) OrElse(d Option[U] = None()) U = d.GetOrElse(b.V)

struct Pair[A any, B any](L A, R B)

func (p Pair[X, Y]) Swap() Pair[Y, X] = Pair(p.R, p.L)
func (p Pair[X, Y]) Both(f func(X, Y) string) string = f(p.L, p.R)

func main() {
    Println(Box(4).Twice((x) => x + 1))
    Println(Box("a").Apply((s) => s + "!"))
    Println(Box(4).Map((x) => s"n=$x").V)
    val boxed = &Box(7)
    Println(boxed.Peek((x) => s"peek $x"))
    Println(Box(5).Describe((x) => s"five is $x"))
    Println(Box(6).OrElse())
    Println(Box(6).OrElse(Some(60)))
    val swapped = Pair(1, "a").Swap()
    Println(swapped.L + swapped.L)
    Println(Pair(2, "b").Both((n, s) => s"$s$n"))
}
-- examples/regex_usage.gala --
package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/regex"
)

func main() {
    // Pattern matching with regex extractors + Array destructuring
    val dateRegex = regex.MustCompile("(\\d{4})-(\\d{2})-(\\d{2})")

    val input = "2024-01-15"
    val result = input match {
        case dateRegex(Array(year, month, day)) => s"Year: $year, Month: $month, Day: $day"
        case _ => "not a date"
    }
    Println(result)

    // Non-matching case
    val result2 = "not-a-date" match {
        case dateRegex(Array(year, _, _)) => s"Date: $year"
        case _ => "no match"
    }
    Println(result2)

    // Email extraction with destructuring
    val emailRegex = regex.MustCompile("([\\w.]+)@([\\w.]+)")
    val email = "user@example.com"
    val parts = email match {
        case emailRegex(Array(user, domain)) => s"User: $user, Domain: $domain"
        case _ => "not an email"
    }
    Println(parts)

    // Basic operations
    val digits = regex.MustCompile("\\d+")
    Println(digits.Matches("abc123"))
    Println(digits.Matches("no digits"))
    Println(digits.FindFirst("abc 123").Get())
    Println(digits.ReplaceAll("Call 555-1234", "***"))

    // Safe compilation
    val bad = regex.Compile("[invalid")
    Println(s"Bad regex is failure: ${bad.IsFailure()}")
}
-- examples/resource_combinators.gala --
package main

import . "martianoff/gala/resource"
import . "martianoff/gala/go_interop"

// Verifies the `resource` combinators for guaranteed cleanup:
//   Using    — Close() guaranteed on every exit path (Closeable resources)
//   Bracket  — general run-then-release over an eagerly-acquired resource
//   WithLock — mutex idiom (lock held for the body, released after)

// A Closeable resource: satisfies resource.Closeable via `Close() error`.
type Handle struct {
    name string
}

func (h Handle) Close() error {
    Println(s"close ${h.name}")
    return nil
}

func main() {
    // Using: body runs first, then Close() runs (guaranteed) before Using returns.
    val n = Using(Handle(name = "log.txt"), (h) => h.name.Size())
    Println(s"name length: $n")

    // Bracket: release always runs after the body; bare lambdas infer their types.
    val doubled = Bracket(
        21,
        (r) => Println(s"release $r"),
        (r) => r * 2,
    )
    Println(s"doubled: $doubled")

    // WithLock: the lock is held for the duration of body and released after.
    val mu = NewMutex()
    val guarded = WithLock(mu, () => 7 + 1)
    Println(s"guarded: $guarded")
}
-- examples/retry_backoff.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/time_utils"
)

func main() {
    // 1. Retry succeeds on third attempt
    var count1 = 0
    val result1 = Retry(5, ConstantBackoff(Milliseconds(1)), (attempt int) => {
        count1 = count1 + 1
        if count1 <= 2 {
            return Failure[string](fmt.Errorf("attempt %d failed", attempt))
        }
        return Success("hello")
    })
    Println(result1)

    // 2. All attempts fail
    val result2 = Retry(3, NoBackoff(), (_ int) => {
        return Failure[int](fmt.Errorf("always fails"))
    })
    Println(result2)

    // 3. Succeeds immediately
    val result3 = Retry(3, NoBackoff(), (_ int) => {
        return Success(42)
    })
    Println(result3)

    // 4. Exponential backoff (succeeds on attempt 2)
    var count4 = 0
    val result4 = Retry(5, ExponentialBackoff(Milliseconds(1), Milliseconds(100)), (attempt int) => {
        count4 = count4 + 1
        if count4 <= 1 {
            return Failure[string](fmt.Errorf("attempt %d failed", attempt))
        }
        return Success("recovered")
    })
    Println(result4)
}
-- examples/return_match.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Test return with match expression (simple variable)
func describe(opt Option[int]) string {
    return opt match {
        case Some(n) => fmt.Sprintf("got %d", n)
        case _ => "nothing"
    }
}

// Container struct for testing field access match (concrete type)
type IntContainer struct {
    value Option[int]
}

// Test val assignment with match on field access
func (c IntContainer) describeValue() string {
    val result = c.value match {
        case Some(v) => fmt.Sprintf("has value: %d", v)
        case _ => "empty"
    }
    return result
}

// Test return with match on field access
func (c IntContainer) describeValueDirect() string {
    return c.value match {
        case Some(v) => fmt.Sprintf("has value: %d", v)
        case _ => "empty"
    }
}

func main() {
    fmt.Println(describe(Some(42)))
    fmt.Println(describe(None[int]()))

    val c1 = IntContainer(value = Some(100))
    val c2 = IntContainer(value = None[int]())

    fmt.Println(c1.describeValue())
    fmt.Println(c2.describeValue())
    fmt.Println(c1.describeValueDirect())
    fmt.Println(c2.describeValueDirect())
}
-- examples/scientific_notation.gala --
package main

import "fmt"

func main() {
    // Basic scientific notation
    val eps = 1e-5
    val large = 1e10
    val negative = -2.5e3

    // With decimal point
    val pi_approx = 3.14e0
    val small = 1.23e-8

    // Uppercase E
    val upper = 5E+3

    // No decimal point
    val simple = 2e4

    fmt.Println("eps:", eps)
    fmt.Println("large:", large)
    fmt.Println("negative:", negative)
    fmt.Println("pi_approx:", pi_approx)
    fmt.Println("small:", small)
    fmt.Println("upper:", upper)
    fmt.Println("simple:", simple)

    // Arithmetic with scientific notation
    val result = 1e-5 + 2e-5
    fmt.Println("sum:", result)

    // Comparison
    val threshold = 1e-8
    fmt.Println("eps > threshold:", eps > threshold)
}
-- examples/sealed_bare_variants.gala --
package main

import "fmt"

// Zero-field sealed variants may be declared with or without parentheses.
// This mirrors Scala/Kotlin conventions and removes a small paper cut for users.
sealed type LogLevel {
    case Debug                  // bare identifier — no parens
    case Info()                 // explicit empty parens
    case Warn                   // bare identifier
    case Error()                // explicit empty parens
    case Custom(Name string)    // one-field variant still requires parens
}

// match patterns accept both bare-identifier and paren forms for zero-field cases.
func describe(l LogLevel) string = l match {
    case Debug         => "debug"
    case Info()        => "info"
    case Warn          => "warn"
    case Error()       => "error"
    case Custom(name)  => "custom: " + name
}

// Exhaustive match: mix and match forms to prove both work in the same match.
func level(l LogLevel) int = l match {
    case Debug        => 0
    case Info         => 1
    case Warn()       => 2
    case Error        => 3
    case Custom(_)    => 4
}

func main() {
    fmt.Println(describe(Debug()))
    fmt.Println(describe(Info()))
    fmt.Println(describe(Warn()))
    fmt.Println(describe(Error()))
    fmt.Println(describe(Custom("alert")))

    fmt.Println(level(Debug()))
    fmt.Println(level(Info()))
    fmt.Println(level(Warn()))
    fmt.Println(level(Error()))
    fmt.Println(level(Custom("x")))
}
-- examples/sealed_case_field_defaults.gala --
package main

// A sealed case's fields can declare defaults, as a function's parameters
// can: a constructor call leaves them out by position or by name, and each
// default is evaluated at the construction.

sealed type Light {
    case Off()
    default case On(Power int = 30, Room string = "Living")
}

sealed type Shape {
    case Circle(Radius int, Label string = "circle")
    case Square(Side int)
}

func describe(l Light) string = l match {
    case On(p, r) => s"on $p in $r"
    case Off()    => "off"
}

func main() {
    Println(On(), On(Power = 50), On(Room = "Hall"), On(10), On(10, "Kitchen"))
    Println(Circle(3), Circle(Radius = 4), Circle(5, Label = "big"), Square(2))
    Println(describe(On(Power = 5)), describe(Off()))
}
-- examples/sealed_case_type_param_from_context.gala --
package main

import . "martianoff/gala/collection_immutable"

sealed type Step[T any] {
    case StepA(N int)
    case StepB(Text string)
}

func main() {
    // Named-arg case constructors infer T from the enclosing
    // ArrayOf[Step[int]] element type.
    val steps = ArrayOf[Step[int]](
        StepA(N = 1),
        StepB(Text = "x"),
    )
    Println(s"named=${steps.Length()}")

    // Positional case constructors infer T the same way.
    val pos = ArrayOf[Step[int]](
        StepA(2),
        StepB("y"),
    )
    Println(s"positional=${pos.Length()}")

    // Existing behavior: explicit type args on the variant still works
    // (rewrite must not clobber an already-instantiated reference).
    val explicit = ArrayOf[Step[int]](
        StepA[int](3),
        StepB[int](Text = "z"),
    )
    Println(s"explicit=${explicit.Length()}")
}
-- examples/sealed_default_case.gala --
package main

import . "martianoff/gala/go_interop"

// A sealed type's `default case` is its zero value: a value nothing
// constructed (an uninitialized var, an omitted field, a slot of a fresh Go
// slice) is that case. Option's default case is None.

sealed type Mode {
    case On(Level int)
    default case Off()
}

struct Cfg(Name string, Opt Option[int], M Mode)

func describe(o Option[int]) string = o match {
    case Some(v) => s"some $v"
    case None() => "none"
}

func level(m Mode) string = m match {
    case On(l) => s"on $l"
    case Off() => "off"
}

func zeroOption() Option[int] {
    var o Option[int]
    return o
}

func main() {
    Println(describe(zeroOption()))
    val c = Cfg{Name: "a"}
    Println(describe(c.Opt), level(c.M))
    val slots = SliceWithSize[Option[int]](2)
    Println(describe(slots[1]))
    Println(describe(Some(3)), level(On(2)))
}
-- examples/sealed_done_state_pkg/state/helpers.gala --
package state

// Sibling file forces a multi-file batch transpile, matching the original
// reproduction shape.
func DescribeStatus(s Status) string = s match {
    case Done(body) => s"done($body)"
    case Help()     => "help"
    case Blocked()  => "blocked"
    case Finished() => "finished"
}
-- examples/sealed_done_state_pkg/state/state.gala --
package state

// Regression: a sealed type whose first non-trivial case is named
// `Done(Body string)` lives in a sub-package literally named `state`
// (i.e. the import path is `<...>/state` with `state` as the last segment).
// A consumer that dot-imports this package and writes
// `case Done(body) => ...` must resolve `Done` to this case companion,
// not be silently routed to an unrelated namesake package elsewhere
// in the workspace.
sealed type Status {
    case Done(Body string)
    case Help
    case Blocked
    case Finished
}

func MakeDone(body string) Status = Done(body)
func MakeHelp() Status            = Help()
func MakeBlocked() Status         = Blocked()
func MakeFinished() Status        = Finished()
-- examples/sealed_dot_import_lib/cmds.gala --
package sealed_dot_import_lib

// Generic sealed type with zero-field cases — mirrors gala-tui's Cmd[T].
sealed type Cmd[T any] {
    case QuitCmd()
    case NoCmd()
    case MsgCmd(M T)
}

// Non-generic sealed type with zero-field case for completeness.
sealed type Status {
    case Idle()
    case Done()
    case Active(N int)
}
-- examples/sealed_dot_import_lib/helpers.gala --
package sealed_dot_import_lib

// Sibling file ensures the lib is multi-file (forces batch transpile,
// matching the gala-tui repro shape).
func DescribeStatus(s Status) string = s match {
    case Idle() => "idle"
    case Done() => "done"
    case Active(n) => s"active($n)"
}
-- examples/sealed_equal.gala --
package main

// Verifies that Equal() is synthesized on sealed types — and dispatches
// field-wise after a _variant tag check — so the gala_team `focusEquals`
// hand-written equality helper is redundant.

sealed type FocusState {
    case FocusComposer()
    case FocusSidebar()
}

sealed type Status {
    case StIdle()
    case StRecovering(Attempt int, Max int)
    case StHelpWaiting(Question string)
}

func main() {
    // Zero-field sealed: same variant compares equal, distinct variants don't.
    val f1 FocusState = FocusComposer()
    val f2 FocusState = FocusComposer()
    val f3 FocusState = FocusSidebar()
    Println(f1.Equal(f2))
    Println(f1.Equal(f3))
    Println(f1 == f2)
    Println(f1 == f3)

    // Multi-field sealed: same variant + fields equal, distinct fields differ.
    val s1 Status = StRecovering(1, 2)
    val s2 Status = StRecovering(1, 2)
    val s3 Status = StRecovering(3, 4)
    val s4 Status = StIdle()
    val s5 Status = StHelpWaiting("why?")
    val s6 Status = StHelpWaiting("why?")
    Println(s1.Equal(s2))
    Println(s1.Equal(s3))
    Println(s1.Equal(s4))
    Println(s5.Equal(s6))
}
-- examples/sealed_field_clash.gala --
package main

import "fmt"

// Sealed type where variants share field names with different types.
// "Value" appears in IntVal (int) and StrVal (string) - requires prefixing.
// "Label" appears only in Labeled - no conflict, no prefixing.
sealed type Token {
    case IntVal(Value int)
    case StrVal(Value string)
    case Labeled(Label string, Value float64)
}

func describe(t Token) string = t match {
    case IntVal(v) => fmt.Sprintf("int:%d", v)
    case StrVal(v) => fmt.Sprintf("str:%s", v)
    case Labeled(lbl, v) => fmt.Sprintf("labeled:%s=%.1f", lbl, v)
}

func main() {
    fmt.Println(describe(IntVal(42)))
    fmt.Println(describe(StrVal("hello")))
    fmt.Println(describe(Labeled("pi", 3.14)))

    // Verify isXxx discriminators
    val a = IntVal(1)
    val b = StrVal("x")
    val c = Labeled("y", 2.0)
    fmt.Println(a.isIntVal())
    fmt.Println(a.isStrVal())
    fmt.Println(b.isStrVal())
    fmt.Println(c.isLabeled())
}
-- examples/sealed_field_named_like_method.gala --
package main

import . "martianoff/gala/collection_immutable"

// Transition is a sealed type whose method may share its name with a case
// field: the field belongs to its case, the method to the whole type.
sealed type Transition {
    case Epsilon(Target int)
    case Atom(Target int, Label int)
}

// Target is the state the transition leads to.
func (t Transition) Target() int = t match {
    case Epsilon(target) => target
    case Atom(target, _) => target
}

// Bound's Size field changes type between cases as well as naming the method.
sealed type Bound {
    case Exact(Size int)
    case Named(Size string)
}

func (b Bound) Size() string = b match {
    case Exact(n) => s"exactly $n"
    case Named(name) => s"named $name"
}

// Tagged is a generic sealed type with fields named like the String, Copy and
// Equal methods every sealed type has.
sealed type Tagged[T any] {
    case Plain(Value T)
    case Labeled(Value T, String string, Copy int, Equal bool)
}

func (t Tagged[T]) Value() T = t match {
    case Plain(v) => v
    case Labeled(v, _, _, _) => v
}

func describe(t Transition) string = t match {
    case Atom(Label = label) => s"atom $label -> ${t.Target()}"
    case Epsilon(_) => s"epsilon -> ${t.Target()}"
}

func main() {
    val ts = ArrayOf(Epsilon(1), Atom(2, 7))
    ts.ForEach((t) => Println(describe(t)))
    ts.ForEach((t) => Println(t))
    val next = ts.Map(_.Target())
    Println(next)
    val target = Atom(3, 9).Target
    Println(target())
    Println(Epsilon(1) == Epsilon(1), Atom(2, 7) == Atom(2, 8))
    Println(Atom(2, 7).Copy())

    Println(Exact(3).Size(), Named("big").Size())

    val l = Labeled(5, "five", 1, true)
    Println(l, l.Value(), Plain("x").Value())
    Println(l.Copy() == l)
    l match {
        case Labeled(v, s, c, e) => Println(v, s, c, e)
        case Plain(v) => Println(v)
    }
}
-- examples/sealed_foreign_field_cmd_lib/cmd.gala --
package sealed_foreign_field_cmd_lib

// Cmd is the field type of a case declared in another package
// (sealed_foreign_field_lib). use_sealed_foreign_field imports only that
// package, never this one.
struct Cmd(Name string)
-- examples/sealed_foreign_field_lib/edge.gala --
package sealed_foreign_field_lib

import (
    . "martianoff/gala/collection_immutable"

    cmd "martianoff/gala/examples/sealed_foreign_field_cmd_lib"
)

// Edge has cases whose fields have types of another package.
sealed type Edge {
    case Eps(Target int)
    case Actions(Target int, Commands Array[cmd.Cmd])
    case One(C cmd.Cmd)
}

// MakeActions returns an Actions edge with one command per name.
func MakeActions(target int, names Array[string]) Edge = Actions(target, names.Map(cmd.Cmd(_)))

// MakeOne returns a One edge holding the command name.
func MakeOne(name string) Edge = One(cmd.Cmd(name))

// MakeEps returns an Eps edge to target.
func MakeEps(target int) Edge = Eps(target)

// NameOf returns the name of command c.
func NameOf(c cmd.Cmd) string = c.Name

// Lookup is a generic sealed result over a type of another package.
sealed type Lookup[T any] {
    case Found(Value T)
    case Missing(Key string)
    case Linked(Value T, C cmd.Cmd)
}

// Find returns the command named name, if there is one.
func Find(name string) Option[cmd.Cmd] = if (name == "") None[cmd.Cmd]() else Some(cmd.Cmd(name))

// Parse returns the command named s, or why there is none.
func Parse(s string) Either[string, cmd.Cmd] = if (s == "") Left("empty") else Right(cmd.Cmd(s))

// LookUp returns s as a Found command, or Missing when s is empty.
func LookUp(s string) Lookup[cmd.Cmd] = if (s == "") Missing[cmd.Cmd]("empty") else Found(cmd.Cmd(s))

// LinkTo links value to the command named name.
func LinkTo(value string, name string) Lookup[string] = Linked(value, cmd.Cmd(name))
-- examples/sealed_func_field_string.gala --
package main

// Regression: sealed variants with func-typed fields must generate a go-vet-safe
// String() method. Formatting a function value with %v is rejected by `go vet`
// with "is a func value, not called", which breaks `go test` on any package
// that prints such a variant. The transpiler substitutes a literal "<fn>"
// placeholder for func-typed fields instead.
sealed type Handler {
    case Plain(Msg string)
    case Dynamic(Make func(int) string)
}

func main() {
    val p = Plain(Msg = "hello")
    Println(p)

    val d = Dynamic(Make = (n int) => s"n=$n")
    Println(d)
}
-- examples/sealed_inference_arg_context.gala --
package main

// Context (3): function argument expected-type drives downward inference.
// `runCmd(NoCmd())` should infer `Cmd[Msg]` from `runCmd`'s parameter type.

sealed type Msg {
    case Tick()
    case Quit()
}

sealed type Cmd[T any] {
    case NoCmd()
    case QuitCmd()
    case MsgCmd(M T)
}

func runCmd(c Cmd[Msg]) string = c match {
    case NoCmd() => "no"
    case QuitCmd() => "quit"
    case MsgCmd(_) => "msg"
}

func main() {
    Println(runCmd(NoCmd()))
    Println(runCmd(QuitCmd()))
    Println(runCmd(MsgCmd(Tick())))
}
-- examples/sealed_inference_container_context.gala --
package main

import . "martianoff/gala/collection_immutable"

// Context (4): elements of a container with a concrete element type
// (Array[Cmd[Msg]]) drive downward inference for unannotated case
// constructors. Bare `NoCmd()` etc. should infer T from the slot's type.

sealed type Msg {
    case Tick()
    case Quit()
}

sealed type Cmd[T any] {
    case NoCmd()
    case QuitCmd()
    case MsgCmd(M T)
}

func main() {
    val cmds = ArrayOf[Cmd[Msg]](
        NoCmd(),
        QuitCmd(),
        MsgCmd(Tick()),
    )
    Println(s"length=${cmds.Length()}")
    cmds.ForEach((c) => Println(c))
}
-- examples/sealed_inference_match_arm.gala --
package main

// Context (5): match-arm inference. When a match expression's result type
// is constrained externally (e.g. assigned to a typed val or returned from
// a typed function), each arm's expression should resolve unannotated
// case constructors against that expected type.

sealed type Msg {
    case Tick()
    case Quit()
}

sealed type Cmd[T any] {
    case NoCmd()
    case QuitCmd()
    case MsgCmd(M T)
}

func updateMsg(m Msg) Cmd[Msg] = m match {
    case Tick() => NoCmd()
    case Quit() => QuitCmd()
}

func main() {
    val a Cmd[Msg] = Tick() match {
        case Tick() => NoCmd()
        case Quit() => QuitCmd()
    }
    Println(a)

    Println(updateMsg(Tick()))
    Println(updateMsg(Quit()))
}
-- examples/sealed_inference_return_type.gala --
package main

// Context (2): function return-type drives downward inference.
// When a function declares `Cmd[MegaMsg]` as return, a tail-position
// `NoCmd()` (or `(model, NoCmd())`) should infer `[MegaMsg]` without
// explicit type-args on the variant.

sealed type Msg {
    case Tick()
    case Quit()
}

sealed type Cmd[T any] {
    case NoCmd()
    case QuitCmd()
    case MsgCmd(M T)
}

func makeNoCmd() Cmd[Msg] = NoCmd()

func makeQuitCmd() Cmd[Msg] = QuitCmd()

func updateBlock(n int) Tuple[int, Cmd[Msg]] {
    val next = n + 1
    return (next, NoCmd())
}

func main() {
    Println(makeNoCmd())
    Println(makeQuitCmd())
    val (n, c) = updateBlock(0)
    Println(s"n=$n cmd=$c")
}
-- examples/sealed_inference_val_explicit_type.gala --
package main

// Context (1): direct val assignment with an explicit type.
// `val c Cmd[int] = NoCmd()` should resolve T -> int from the
// declared variable type rather than requiring `NoCmd[int]()`.
sealed type Cmd[T any] {
    case NoCmd()
    case QuitCmd()
    case MsgCmd(M T)
}

func main() {
    val c1 Cmd[int] = NoCmd()
    Println(c1)

    val c2 Cmd[string] = QuitCmd()
    Println(c2)

    val c3 Cmd[int] = MsgCmd(42)
    Println(c3)
}
-- examples/sealed_option_map_method_body.gala --
package main

import "errors"

// Regression: when a sealed-type case constructor named arg accepts an
// Option[T], and the value at the call site is `errOpt.Map((e) => e.Error())`,
// the lambda's body is a method call on a Go universe type (`error.Error()`)
// whose method signature is not registered in goTypeInfo. Without driving the
// `Map` method's type-arg U from the call-site expected type, U falls back to
// `any` and the resulting `Option_Map` returns `Option[any]` — incompatible
// with the target slot `Option[string]`.
//
// The fix: when the immediately-enclosing typed slot supplies a concrete
// expected return type (here `Option[string]` from the Ended.ErrText field),
// unify it against the method's declared return shape `Option[U]` to bind
// U=string before transforming the lambda body. The lambda then sees a
// concrete expected return and emits `func(error) string` instead of
// `func(error) any`.

sealed type AppMsg {
    case Ended(Name string, ErrText Option[string])
    case Started(Name string)
}

func describe(m AppMsg) string = m match {
    case Started(name)        => s"started: $name"
    case Ended(name, errText) => errText match {
        case Some(s) => s"ended[$name] err=$s"
        case None()  => s"ended[$name] ok"
    }
}

// The transform that triggered the bug: the named arg ErrText receives an
// Option.Map whose lambda body is a method call on an Option[error] element.
func makeEnded(name string, errOpt Option[error]) AppMsg =
    Ended(Name = name, ErrText = errOpt.Map((e) => e.Error()))

func main() {
    val ok = makeEnded("topic-a", None[error]())
    Println(describe(ok))

    val err = makeEnded("topic-b", Some(errors.New("oops")))
    Println(describe(err))

    val started = Started(Name = "topic-c")
    Println(describe(started))
}
-- examples/sealed_recursive.gala --
package main

import "fmt"

// Recursive sealed type: Expr contains fields of type Expr
sealed type Expr {
    case Num(Value float64)
    case Add(Left Expr, Right Expr)
    case Mul(Left Expr, Right Expr)
}

// Evaluate an expression tree recursively
func eval(e Expr) float64 = e match {
    case Num(v) => v
    case Add(l, r) => eval(l) + eval(r)
    case Mul(l, r) => eval(l) * eval(r)
}

func main() {
    // Simple number
    val n = Num(42.0)
    fmt.Println(eval(n))

    // 1 + 2
    val sum = Add(Num(1.0), Num(2.0))
    fmt.Println(eval(sum))

    // (3 + 4) * 2
    val expr = Mul(Add(Num(3.0), Num(4.0)), Num(2.0))
    fmt.Println(eval(expr))

    // Verify isXxx discriminators
    fmt.Println(n.isNum())
    fmt.Println(n.isAdd())
    fmt.Println(sum.isAdd())
    fmt.Println(expr.isMul())
}
-- examples/sealed_recursive_list.gala --
package main

import "fmt"

// T1: Generic recursive sealed type — MyList[T] modelled as Cons / Nil.
// Exercises (a) sealed types with type params, (b) self-referential variants,
// (c) recursive pattern match folds.
sealed type MyList[T any] {
    case Cons(Head T, Tail MyList[T])
    case Nil()
}

// Length folds via pattern matching over the recursive tail.
func length[T any](l MyList[T]) int = l match {
    case Nil() => 0
    case Cons(_, rest) => 1 + length(rest)
}

// Sum only makes sense for numeric lists — keep it for int.
func sum(l MyList[int]) int = l match {
    case Nil() => 0
    case Cons(h, rest) => h + sum(rest)
}

// Convert a MyList[int] to a comma-separated string via recursive match.
func stringify(l MyList[int]) string = l match {
    case Nil() => ""
    case Cons(h, Nil()) => fmt.Sprintf("%d", h)
    case Cons(h, rest) => fmt.Sprintf("%d,%s", h, stringify(rest))
}

func main() {
    // Nil and single-element constructions.
    val empty = Nil[int]()
    val one = Cons[int](1, Nil[int]())

    // Multi-element: 1 -> 2 -> 3 -> Nil
    val l = Cons[int](1, Cons[int](2, Cons[int](3, Nil[int]())))

    fmt.Println(length(empty))
    fmt.Println(length(one))
    fmt.Println(length(l))
    fmt.Println(sum(empty))
    fmt.Println(sum(l))
    fmt.Println(stringify(l))
}
-- examples/sealed_shared_fields.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Sealed type with shared field names across variants (same type allowed)
sealed type KVResult {
    case Ok(Message string)
    case NotFound(Key string)
    case Expired(Key string)
}

func formatResult(r KVResult) string = r match {
    case Ok(msg) => fmt.Sprintf("[OK] %s", msg)
    case NotFound(key) => fmt.Sprintf("[NOT FOUND] key=%s", key)
    case Expired(key) => fmt.Sprintf("[EXPIRED] key=%s", key)
}

func main() {
    fmt.Println(formatResult(Ok("stored")))
    fmt.Println(formatResult(NotFound("missing")))
    fmt.Println(formatResult(Expired("old")))

    // Verify isXxx discriminators work
    val ok = Ok("done")
    val nf = NotFound("k1")
    val exp = Expired("k2")
    fmt.Printf("ok.isOk=%v ok.isNotFound=%v ok.isExpired=%v\n", ok.isOk(), ok.isNotFound(), ok.isExpired())
    fmt.Printf("nf.isOk=%v nf.isNotFound=%v nf.isExpired=%v\n", nf.isOk(), nf.isNotFound(), nf.isExpired())
    fmt.Printf("exp.isOk=%v exp.isNotFound=%v exp.isExpired=%v\n", exp.isOk(), exp.isNotFound(), exp.isExpired())
}
-- examples/sealed_types.gala --
package main

import "fmt"

sealed type Color {
    case Red()
    case Green()
    case Blue()
}

sealed type Shape {
    case Circle(Radius float64)
    case Rectangle(Width float64, Height float64)
    case Point()
}

func describe(s Shape) string = s match {
    case Circle(r) => fmt.Sprintf("Circle with radius %.1f", r)
    case Rectangle(w, h) => fmt.Sprintf("Rectangle %0.fx%0.f", w, h)
    case Point() => "A point"
}

func main() {
    // Constructor calls via companion Apply
    val c = Circle(3.14)
    val r = Rectangle(10.0, 20.0)
    val p = Point()

    // isXxx() methods (private)
    fmt.Println(c.isCircle())
    fmt.Println(c.isRectangle())
    fmt.Println(r.isRectangle())
    fmt.Println(p.isPoint())

    // Pattern matching
    fmt.Println(describe(c))
    fmt.Println(describe(r))
    fmt.Println(describe(p))

    // Color (0-field variants)
    val red = Red()
    fmt.Println(red.isRed())
    fmt.Println(red.isGreen())

    // String() method
    fmt.Println(c)
    fmt.Println(r)
    fmt.Println(p)
    fmt.Println(red)
}
-- examples/sealed_variant_max_width.gala --
package main

// A sealed variant can have up to 10 fields, the widest std tuple its
// extractor returns. Every field is matched by position, by name, and inside a
// nested pattern.

sealed type Row {
    case Wide(A int, B int, C int, D int, E int, F int, G int, H int, I int, J string)
    case Narrow(Label string)
}

func sum(r Row) int = r match {
    case Wide(a, b, c, d, e, f, g, h, i, _) => a + b + c + d + e + f + g + h + i
    case Narrow(_) => 0
}

func label(r Row) string = r match {
    case Wide(J = j) => j
    case Narrow(l) => l
}

func describe(r Option[Row]) string = r match {
    case Some(Wide(1, _, _, _, _, _, _, _, _, j)) => s"wide from one: $j"
    case Some(Wide(_, _, _, _, _, _, _, _, _, j)) => s"wide: $j"
    case Some(Narrow(l)) => s"narrow: $l"
    case None() => "none"
}

func main() {
    val w = Wide(1, 2, 3, 4, 5, 6, 7, 8, 9, "ten")
    Println(sum(w))
    Println(label(w))
    Println(label(Narrow("n")))
    Println(describe(Some(w)))
    Println(describe(Some(w.Copy(A = 0))))
    Println(describe(Some(Narrow("n"))))
    Println(describe(None()))
}
-- examples/sealed_view_match.gala --
package main

import . "martianoff/gala/collection_immutable"

// A type with a method `MatchView() S`, where S is a sealed type, can be
// matched with S's variants: the match tests `subject.MatchView()`. These cases
// assert the RUNTIME answer — a bare `case None` read as a binding would match
// every value and still compile.

// MaybeInt is a maybe-absent int stored without Option's tag: a negative raw
// value is absent.
struct MaybeInt(raw int)

func (m MaybeInt) MatchView() Option[int] = When(m.raw >= 0, m.raw)

// Found is a generic type viewed as Option[T].
struct Found[T any](ok bool, value T)

func (f Found[T]) MatchView() Option[T] = When(f.ok, f.value)

// Level is the user sealed type Reading is viewed as.
sealed type Level {
    case Low()
    case Mid(N int)
    case High()
}

// Reading is viewed as a Level.
struct Reading(v int)

func (r Reading) MatchView() Level = if (r.v < 10) Low() else if (r.v < 100) Mid(r.v) else High()

// Sensor is viewed as an Option whose Some carries a Level, for nested
// patterns.
struct Sensor(raw int)

func (s Sensor) MatchView() Option[Level] = When(s.raw >= 0, Reading(s.raw).MatchView())

// Counter is viewed through a pointer receiver.
type Counter struct {
    var hits int
}

func (c *Counter) MatchView() Option[int] = When(c.hits != 0, c.hits)

// Exhaustive without a default: the match is over Option[int].
func describe(m MaybeInt) string = m match {
    case Some(n) => s"some $n"
    case None()  => "none"
}

// A bare `case None` names the variant; it is not a catch-all binding.
func describeBare(m MaybeInt) string = m match {
    case None    => "none"
    case Some(n) => s"some $n"
}

// Guards, and a default after them.
func sign(m MaybeInt) string = m match {
    case Some(n) if n == 0 => "zero"
    case Some(n) if n > 50 => "big"
    case _                 => "other"
}

func found[T any](f Found[T]) string = f match {
    case Some(v) => s"found $v"
    case None()  => "missing"
}

func level(r Reading) string = r match {
    case Low() | High() => "edge"
    case Mid(n)         => s"mid $n"
}

func sensor(s Sensor) string = s match {
    case Some(Mid(n)) => s"sensor mid $n"
    case Some(Low())  => "sensor low"
    case Some(High()) => "sensor high"
    case None()       => "sensor off"
}

func counter(c *Counter) string = c match {
    case Some(n) => s"hits $n"
    case None()  => "no hits"
}

// A sub-pattern reads the view of its own value; a binding beside it binds
// the value itself.
func pair(a MaybeInt, b MaybeInt) string = (a, b) match {
    case (Some(x), Some(y)) => s"both $x $y"
    case (Some(x), None)    => s"first $x"
    case (_, other)         => s"second: ${describe(other)}"
}

func wrapped(o Option[MaybeInt]) string = o match {
    case Some(Some(n)) => s"wrapped $n"
    case Some(None)    => "wrapped none"
    case None()        => "no wrapper"
}

var reads = 0

// The subject is evaluated, and viewed, once.
func next() MaybeInt {
    reads = reads + 1
    MaybeInt(reads)
}

func main() {
    Println(describe(MaybeInt(7)))
    Println(describe(MaybeInt(-1)))
    Println(describeBare(MaybeInt(3)))
    Println(describeBare(MaybeInt(-1)))
    Println(sign(MaybeInt(0)))
    Println(sign(MaybeInt(99)))
    Println(sign(MaybeInt(5)))
    Println(sign(MaybeInt(-1)))
    Println(found(Found(true, "x")))
    Println(found(Found(false, 0)))
    Println(level(Reading(1)))
    Println(level(Reading(42)))
    Println(level(Reading(500)))
    Println(sensor(Sensor(42)))
    Println(sensor(Sensor(3)))
    Println(sensor(Sensor(1000)))
    Println(sensor(Sensor(-1)))
    Println(pair(MaybeInt(1), MaybeInt(2)))
    Println(pair(MaybeInt(1), MaybeInt(-1)))
    Println(pair(MaybeInt(-1), MaybeInt(2)))
    Println(pair(MaybeInt(-1), MaybeInt(-1)))
    Println(wrapped(Some(MaybeInt(5))))
    Println(wrapped(Some(MaybeInt(-5))))
    Println(wrapped(None()))
    val c = &Counter{}
    Println(counter(c))
    c.hits = 2
    Println(counter(c))
    Println(next() match {
        case Some(n) => s"read $n"
        case None()  => "nothing"
    })
    Println(s"reads $reads")
    // A statement-position match.
    MaybeInt(4) match {
        case Some(n) => Println(s"statement $n")
        case None()  => Println("statement none")
    }
    // A partial function views its argument the same way.
    val present = ArrayOf(MaybeInt(1), MaybeInt(-1), MaybeInt(2)).Collect({ case Some(n) => n * 10 })
    Println(present.MkString(","))
}
-- examples/sealed_widen_call_arg.gala --
package main

// Regression: a sealed-case constructor used as a function-call argument
// must widen to the parent sealed type, the same way `return SomeCase(...)`
// does. Both positional and named-arg construction must widen consistently.
//
// Pre-fix the named-arg multi-arg form (`StRecovering(Attempt = a, Max = m)`)
// failed to widen at call-arg sites and gala_team had to wrap construction
// in a return-typed helper (mkRecoveringStatus).

sealed type Status {
    case StIdle()
    case StWorking()
    case StRecovering(Attempt int, Max int)
    case StHelpWaiting(Question string)
}

func describe(s Status) string = s match {
    case StIdle()              => "idle"
    case StWorking()           => "working"
    case StRecovering(a, m)    => s"recovering $a/$m"
    case StHelpWaiting(q)      => s"help: $q"
}

func main() {
    // Zero-arg case at call-arg site
    Println(describe(StIdle()))
    Println(describe(StWorking()))

    // Single-arg positional case at call-arg site
    Println(describe(StHelpWaiting("?")))
    // Single-arg named-args case at call-arg site
    Println(describe(StHelpWaiting(Question = "why")))

    // Multi-arg positional case at call-arg site
    Println(describe(StRecovering(1, 2)))
    // Multi-arg named-args case at call-arg site (used to fail to widen)
    Println(describe(StRecovering(Attempt = 3, Max = 4)))
}
-- examples/sealed_widen_call_arg_lib/sink.gala --
package sealed_widen_call_arg_lib

// Sink ensures the lib is multi-file (forces batch transpilation).
// The cross-package + multi-file shape is what originally broke
// multi-arg sealed widening at call arguments.
func Sink(s Status) string = DescribeStatus(s)
-- examples/sealed_widen_call_arg_lib/status.gala --
package sealed_widen_call_arg_lib

sealed type Status {
    case StIdle()
    case StWorking()
    case StRecovering(Attempt int, Max int)
    case StHelpWaiting(Question string)
}

func DescribeStatus(s Status) string = s match {
    case StIdle()           => "idle"
    case StWorking()        => "working"
    case StRecovering(a, m) => s"recovering $a/$m"
    case StHelpWaiting(q)   => s"help: $q"
}
-- examples/sealed_wildcard.gala --
package main

import "fmt"

sealed type Animal {
    case Dog(Name string)
    case Cat(Name string)
    case Bird(Name string)
    case Fish(Name string)
}

// Match only specific cases, catch rest with wildcard
func greet(a Animal) string = a match {
    case Dog(name) => "Woof! I'm " + name
    case Cat(name) => "Meow! I'm " + name
    case _ => "I'm some other animal"
}

// Match a single case, wildcard for rest
func isDog(a Animal) bool = a match {
    case Dog(_) => true
    case _ => false
}

func main() {
    val dog = Dog("Rex")
    val cat = Cat("Whiskers")
    val bird = Bird("Tweety")
    val fish = Fish("Nemo")

    fmt.Println(greet(dog))
    fmt.Println(greet(cat))
    fmt.Println(greet(bird))
    fmt.Println(greet(fish))

    fmt.Println(isDog(dog))
    fmt.Println(isDog(cat))
    fmt.Println(isDog(bird))
}
-- examples/semicolon_statement_separator.gala --
package main

// Regression example: ';' is accepted as an optional statement separator
// inside block bodies, enabling Go-style one-liners such as
//   if v < 0 { neg = true; v = -v }
// without forcing the user to break the block across multiple lines.

func abs(x int) int {
    var v = x
    if v < 0 { v = -v }
    return v
}

func absAndSign(x int) int {
    var v = x
    var neg = 0
    if v < 0 { neg = 1; v = -v }
    Println(neg)
    return v
}

func main() {
    Println(abs(-7))
    Println(absAndSign(-5))
    Println(absAndSign(3))
    // Trailing ';' after a single statement should also be tolerated.
    if true { Println("ok"); }
}
-- examples/seq_pattern_match.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"

func main() {
    // Test Array sequence pattern matching
    val arr = ArrayOf[int](1, 2, 3, 4, 5)

    // Case 1: Extract first two elements, ignore rest
    val res1 = arr match {
        case Array(first, second, _...) => fmt.Sprintf("First: %d, Second: %d", first, second)
        case _ => "Not enough elements"
    }
    fmt.Println(res1)

    // Case 2: Extract first element and capture rest
    val res2 = arr match {
        case Array(head, tail...) => fmt.Sprintf("Head: %d, Tail size: %d", head, tail.Size())
        case _ => "Empty"
    }
    fmt.Println(res2)

    // Case 3: Match empty array
    val emptyArr = ArrayOf[int]()
    val res3 = emptyArr match {
        case Array(first, _...) => fmt.Sprintf("First: %d", first)
        case _ => "Empty array"
    }
    fmt.Println(res3)

    // Test List sequence pattern matching
    val list = ListOf[string]("a", "b", "c", "d")

    // Case 4: Extract first two elements from list
    val res4 = list match {
        case List(first, second, rest...) => fmt.Sprintf("First: %s, Second: %s, Rest size: %d", first, second, rest.Size())
        case _ => "Not enough elements"
    }
    fmt.Println(res4)

    // Case 5: Just check if list has at least 3 elements
    val res5 = list match {
        case List(_, _, _, _...) => "Has at least 3 elements"
        case _ => "Less than 3 elements"
    }
    fmt.Println(res5)
}
-- examples/seq_rest_edge.gala --
package main

import "fmt"
import . "martianoff/gala/collection_immutable"

// B3: Edge cases for rest-pattern seq matching:
//  - rest-only: Array(all...)                   (matches anything including empty)
//  - wildcard-rest-only: Array(_...)            (matches anything, no binding)
//  - single-elem + rest-at-end
//  - empty + rest-only should still match
func main() {
    val empty = ArrayOf[int]()
    val one = ArrayOf[int](42)
    val many = ArrayOf[int](1, 2, 3, 4)

    // rest-only named — matches everything
    val r1 = empty match {
        case Array(all...) => fmt.Sprintf("empty.size=%d", all.Size())
        case _ => "no"
    }
    fmt.Println(r1)

    val r2 = many match {
        case Array(all...) => fmt.Sprintf("many.size=%d", all.Size())
        case _ => "no"
    }
    fmt.Println(r2)

    // wildcard-rest-only — always matches
    val r3 = empty match {
        case Array(_...) => "matched-empty"
        case _ => "no"
    }
    fmt.Println(r3)

    // single-elem + rest-at-end on a 1-element array (rest should be empty)
    val r4 = one match {
        case Array(head, rest...) => fmt.Sprintf("head=%d rest.size=%d", head, rest.Size())
        case _ => "no"
    }
    fmt.Println(r4)

    // single-elem + rest-at-end on a 4-element array
    val r5 = many match {
        case Array(head, rest...) => fmt.Sprintf("head=%d rest.size=%d", head, rest.Size())
        case _ => "no"
    }
    fmt.Println(r5)

    // Ensure empty array does NOT match a pattern requiring one fixed element
    val r6 = empty match {
        case Array(head, _...) => fmt.Sprintf("head=%d", head)
        case _ => "empty-no-head"
    }
    fmt.Println(r6)
}
-- examples/sequence_pattern_exact_length.gala --
package main

// A sequence pattern without a rest matches exactly as many elements as it
// lists; with a rest (`_...` or `name...`) it matches at least as many.

import . "martianoff/gala/collection_immutable"

func describe(a Array[int]) string = a match {
    case Array() => "empty"
    case Array(x) => s"one: $x"
    case Array(x, y) => s"two: $x $y"
    case Array(x, y, rest...) => s"two and ${rest.Size()} more: $x $y"
    case _ => "unreachable"
}

func firstOfAtLeastOne(l List[string]) string = l match {
    case List(h, _...) => h
    case _ => "none"
}

func main() {
    Println(describe(ArrayOf[int]()))
    Println(describe(ArrayOf(1)))
    Println(describe(ArrayOf(1, 2)))
    Println(describe(ArrayOf(1, 2, 3)))
    Println(describe(ArrayOf(1, 2, 3, 4)))
    Println(firstOfAtLeastOne(ListOf("a", "b")))
    Println(firstOfAtLeastOne(ListOf[string]()))
}
-- examples/sequence_pattern_nested_ctor.gala --
package main

import . "martianoff/gala/collection_immutable"

// Nested constructor patterns inside a sequence pattern, typed element
// patterns, and generic struct patterns against an `any` subject.
//
// A sub-pattern such as `Square(s)` in `case Array(Square(s), _)` is a pattern
// against the element, never a binding of the name `Square`; the bindings it
// declares (`s`) are visible to the arm. The arm is still gated on the size
// check, so a too-short sequence falls through to the next case.

sealed type Shape {
    case Circle(R int)
    case Square(S int)
}

struct Box[T any](V T, Tag string)
struct Pair[K any, V any](Key K, Val V)
struct Plain(N int)

func firstSquare(xs Array[Shape]) string = xs match {
    case Array(Square(s), _)       => s"square $s first of two"
    case Array(Circle(r), rest...) => s"circle $r then ${rest.Size()} more"
    case _                         => "no match"
}

func nestedOption(xs Array[Option[Shape]]) int = xs match {
    case Array(Some(Square(s)), rest...) => s + rest.Size()
    case Array(None(), _)                => -1
    case _                               => 0
}

func literalHead(xs List[int]) string = xs match {
    case List(0, second, _...) => s"zero then $second"
    case List(first, _...)     => s"starts with $first"
    case _                     => "empty"
}

func typedHead(xs Array[any]) string = xs match {
    case Array(n: int, _)    => s"int $n"
    case Array(s: string, _) => s"string $s"
    case _                   => "other"
}

func describe(x any) string = x match {
    case Box[int](v, tag)        => s"int box $tag ${v + 1}"
    case Box[string](v, _)       => s"string box ${v + "!"}"
    case Pair[string, int](k, v) => s"pair $k=${v * 2}"
    case Plain(n)                => s"plain $n"
    case _                       => "other"
}

// A sub-pattern only runs once its guard holds: on an empty sequence (or an
// empty Option) the element is never read, so a struct pattern on a pointer
// element does not dereference nil and a user extractor is not invoked.
struct Node(V int)

var probes = 0

struct Probe()

func (p Probe) Unapply(n int) Option[int] {
    probes = probes + 1
    return Some(n)
}

func firstNode(xs Array[*Node]) string = xs match {
    case Array(Node(v), rest...) => s"node $v then ${rest.Size()}"
    case _                       => "none"
}

func probed(xs Array[int]) string = xs match {
    case Array(Probe(x), y) => s"probe $x $y"
    case _                  => "short"
}

func payload(o Option[*Node]) string = o match {
    case Some(Node(v)) => s"some $v"
    case _             => "empty"
}

func main() {
    Println(firstSquare(ArrayOf[Shape](Square(4), Circle(1))))
    Println(firstSquare(ArrayOf[Shape](Circle(2), Square(1), Square(3))))
    Println(firstSquare(ArrayOf[Shape](Square(4))))
    Println(firstSquare(EmptyArray[Shape]()))

    Println(nestedOption(ArrayOf[Option[Shape]](Some(Square(5)), None())))
    Println(nestedOption(ArrayOf[Option[Shape]](None(), None())))
    Println(nestedOption(EmptyArray[Option[Shape]]()))

    Println(literalHead(ListOf(0, 7, 8)))
    Println(literalHead(ListOf(3)))
    Println(literalHead(EmptyList[int]()))

    Println(typedHead(ArrayOf[any](1, "two")))
    Println(typedHead(ArrayOf[any]("one", 2)))
    Println(typedHead(EmptyArray[any]()))

    Println(describe(Box(V = 41, Tag = "b")))
    Println(describe(Box(V = "hi", Tag = "s")))
    Println(describe(Pair[string, int](Key = "k", Val = 21)))
    Println(describe(Plain(N = 3)))
    Println(describe(Box(V = true, Tag = "x")))

    Println(firstNode(ArrayOf(&Node(V = 1), &Node(V = 2))))
    Println(firstNode(EmptyArray[*Node]()))
    Println(probed(ArrayOf(1)))
    Println(s"probes after the short sequence: $probes")
    Println(probed(ArrayOf(1, 2)))
    Println(s"probes after the match: $probes")
    Println(payload(Some(&Node(V = 5))))
    Println(payload(None[*Node]()))
}
-- examples/shadowed_function.gala --
package main

// A local binding named like a package-level function shadows it, as in Go:
// the call is to the binding and is typed from the binding.

func label(n int) int = n + 1

func apply(g func(int) int) int = g(1)

func shout(label func(string) string) string = label("param")

func twice(apply func(func(string) string) string) string = apply((s) => s + s)

func main() {
    val viaLambda = (label func(string) string) => label("lambda")
    Println(viaLambda((s string) => s + "!"))
    Println(shout((s) => s + "?"))
    Println(twice((h) => h("ab")))
    if true {
        val label = (b bool) => !b
        Println(label(true))
    }
    Println(label(41))
    Println(apply((n) => n * 10))
}
-- examples/short_var_decl_multi_value.gala --
package main

import "strings"
import . "martianoff/gala/collection_immutable"

// `a, b, c := f()` binds a Go multi-value return across several names in the
// short spelling — the same construct as `val a, b, c = f()`. The call is
// evaluated once into temporaries and each name takes its own result.
func describe(email string) string {
    user, host, found := strings.Cut(email, "@")
    return if (found) s"$user at $host" else s"no host in $email"
}

// The same form inside a lambda body.
func hosts(items Array[string]) Array[string] =
    items.Map((e) => {
        user, host, found := strings.Cut(e, "@")
        if (found) host else s"($user)"
    })

func main() {
    Println(describe("ada@lovelace.dev"))
    Println(describe("nobody"))
    Println(hosts(ArrayOf("a@b.com", "plain")))
}
-- examples/single_letter_type_names.gala --
package main

import (
    "testing"
    . "martianoff/gala/collection_immutable"
)

// Types whose names are a single capital letter are ordinary types. Only a
// generic declaration's own type parameters are type parameters, and those
// shadow a same-named package type inside that declaration.

struct A(Name string)

struct T(N int)

sealed type V {
    case Small(n int)
    case Big(n int)
}

func size(v V) int = v match {
    case Small(n) => n
    case Big(n) => n * 10
}

func pick(xs Array[T]) Option[T] = xs.Find((t) => t.N > 1)

// A match whose arms yield a Go type named B.
func benchN(bs Array[*testing.B], fallback *testing.B) int {
    val b = bs.HeadOption() match {
        case Some(first) => first
        case None() => fallback
    }
    return b.N
}

// The type parameter A shadows the package struct A.
func firstOr[A any](xs Array[A], d A) A = xs.Find((x) => true) match {
    case Some(a) => a
    case None() => d
}

// A multi-letter type parameter.
func countIf[Elem any](xs Array[Elem], p func(Elem) bool) int = xs.Count((x) => p(x))

func main() {
    val as = ArrayOf(A(Name = "x"), A(Name = "yy"))
    Println(as.Find((a) => a.Name.Size() > 1).Map((a) => a.Name).GetOrElse("none"))
    Println(as.Filter((a) => a.Name == "x").Size())

    val ts = ArrayOf(T(1), T(2), T(3))
    Println(pick(ts).Map((t) => t.N).GetOrElse(-1))
    Println(ts.ForAll((t) => t.N > 0))

    val vs = ArrayOf[V](Small(1), Big(100))
    Println(vs.Find((v) => size(v) > 5).Map((v) => size(v)).GetOrElse(0))

    val ot Option[T] = Some(T(5))
    Println(ot.Filter((t) => t.N > 1).IsDefined())

    val m = HashMapOf(("k", T(9)))
    Println(m.Get("k").Map((t) => t.N).GetOrElse(0))

    var fallback = testing.B(N = 7)
    Println(benchN(ArrayOf[*testing.B](), &fallback))

    Println(firstOr(as, A(Name = "d")).Name)
    Println(firstOr(ArrayOf[int](), 42))
    Println(countIf(ts, (t) => t.N >= 2))
}
-- examples/size_method.gala --
package main

import . "martianoff/gala/go_interop"

// Verifies the .Size() / .ByteSize() sugar for Go primitives:
//   string.Size()     -> utf8.RuneCountInString  (character count)
//   string.ByteSize() -> len                      (raw byte count)
//   []T.Size()        -> len
func main() {
    // "héllo": 5 characters but 6 bytes ('é' is 2 bytes in UTF-8).
    val word = "héllo"
    Println(word.Size())     // 5  (characters)
    Println(word.ByteSize()) // 6  (bytes)

    val xs = SliceOf(10, 20, 30, 40)
    Println(xs.Size())       // 4

    val empty = ""
    Println(empty.Size())    // 0
}
-- examples/slice_element_unwrap.gala --
package main

import "fmt"
import . "martianoff/gala/go_interop"

struct Route(val Method string, val Path string)

func workingVariadic(routes ...Route) {
    val r = routes[0]
    fmt.Println(r.Method)
    fmt.Println(r.Path)
}

func brokenSlice(routes []Route) {
    val r = routes[0]
    fmt.Println(r.Method)
    fmt.Println(r.Path)
}

func directIndex(routes []Route) {
    fmt.Println(routes[0].Method)
    fmt.Println(routes[0].Path)
}

func main() {
    val routes = SliceOf(Route("GET", "/api/users"), Route("POST", "/api/users"))
    workingVariadic(Route("GET", "/api/users"), Route("POST", "/api/users"))
    brokenSlice(routes)
    directIndex(routes)
}
-- examples/slice_type_param.gala --
package main


// Test case for slice as generic type parameter

type Box[T any] struct {
    Value T
}

func BoxOf[T any](value T) Box[T] {
    return Box[T](Value = value)
}

// Function that takes slice type parameter
func WrapSlice[T any](items []T) Box[[]T] {
    return Box[[]T](Value = items)
}

// Function returning Box of slice
func CreateSliceBox[T any]() Box[[]T] {
    return BoxOf[[]T](SliceEmpty[T]())
}

func main() {
    // Create box with slice
    val wrapped = WrapSlice[int](SliceOf(1, 2, 3))
    Println("Wrapped slice length:", wrapped.Value.Size())

    // Create empty slice box
    val emptyBox = CreateSliceBox[string]()
    Println("Empty box length:", emptyBox.Value.Size())
}
