-- examples/struct_lambda_inference.gala --
package main

import "fmt"

type Handler struct {
    val Name string
    val Fn func(string) string
}

type Processor struct {
    val Transform func(int) int
    val Combine func(int, int) int
}

func main() {
    // Lambda (s) should infer type from Fn field: func(string) string
    val h = Handler("greet", (s) => s"Hello, $s!")
    fmt.Println(h.Name)
    fmt.Println(h.Fn("World"))

    // Multiple function fields with different signatures
    val p = Processor((x) => x * 2, (a, b) => a + b)
    fmt.Println(p.Transform(5))
    fmt.Println(p.Combine(3, 7))
}
-- examples/struct_mixed_args.gala --
package main

// Struct construction binds the leading positional arguments to the first
// fields and the named ones by name; the fields given neither way take their
// defaults. It is the rule a function call follows. The cross-package case is
// in struct_field_defaults_crosspkg.gala.
struct Cfg(Name string, Tries int = 3, Loud bool = false)

struct Box[T any](Value T, Label string = "box", Count int = 1)

func connect(host string, port int = 8080, tls bool = true) string = s"$host:$port tls=$tls"

func main() {
    Println(connect("localhost", tls = false))

    val a = Cfg("a", Loud = true)
    Println(s"${a.Name} ${a.Tries} ${a.Loud}")
    val b = Cfg("b", 5, Loud = true)
    Println(s"${b.Name} ${b.Tries} ${b.Loud}")
    val c = Cfg("c", Tries = 7)
    Println(s"${c.Name} ${c.Tries} ${c.Loud}")

    val n = Box(42, Count = 2)
    Println(s"${n.Value} ${n.Label} ${n.Count}")
    val s = Box("x", Label = "named")
    Println(s"${s.Value} ${s.Label} ${s.Count}")
}
-- examples/struct_pattern_interface_subject.gala --
package main

import "fmt"

// A struct extractor pattern matches a value whose static type is an
// interface — `error`, an interface the program declares, or a Go interface —
// or a type parameter, when the value holds that struct, at the top level and
// nested inside another pattern.
type Shape interface {
    Area() float64
}

struct Square(Side float64)

func (s Square) Area() float64 = s.Side * s.Side

struct Circle(R float64)

func (c Circle) Area() float64 = 3.0 * c.R * c.R

func (c Circle) String() string = s"circle ${c.R}"

struct NotFound(Key string)

func (e NotFound) Error() string = s"not found: ${e.Key}"

struct Coded[T any](Code T)

func (e Coded[T]) Error() string = "coded"

func describeErr(err error) string = err match {
    case NotFound(k) if k == "x" => "x is missing"
    case NotFound(k) => s"key $k"
    case Coded[int](c) => s"code $c"
    case _ => s"other: ${err.Error()}"
}

func describeShape(sh Shape) string = sh match {
    case Square(side) => s"square $side"
    case Circle(r) => s"circle $r"
    case _ => "unknown shape"
}

func describeStringer(st fmt.Stringer) string = st match {
    case Circle(r) => s"stringer circle $r"
    case _ => "other stringer"
}

func describeAny[T any](x T) string = x match {
    case Square(side) => s"generic square $side"
    case _ => "generic other"
}

func main() {
    Println(describeErr(NotFound(Key = "k")))
    Println(describeErr(NotFound(Key = "x")))
    Println(describeErr(Coded(7)))
    Println(describeErr(fmt.Errorf("plain")))
    Println(describeShape(Square(2.0)))
    Println(describeShape(Circle(1.0)))
    Println(describeStringer(Circle(2.0)))
    Println(describeAny(Square(5.0)))
    Println(describeAny("text"))

    Println(Failure[int](NotFound(Key = "f")) match {
        case Failure(NotFound(k)) => s"failed on $k"
        case _ => "no failure"
    })

    val found Option[error] = Some(NotFound(Key = "o"))
    Println(found match {
        case Some(NotFound(k)) => s"some $k"
        case _ => "none"
    })
}
-- examples/struct_shorthand_generic.gala --
package main

// Shorthand generic struct declaration: type params between name and (.
// Mirrors the block-form `type Box[T any] struct { Value T }` but concise.
struct Box[T any](Value T)

// Multiple type parameters.
struct Pair[A any, B any](First A, Second B)

func main() {
    val b = Box[int](Value = 42)
    Println(b.Value)

    // Implicit type-parameter inference on construction.
    val s = Box(Value = "hello")
    Println(s.Value)

    val p = Pair[int, string](First = 1, Second = "two")
    Println(p.First)
    Println(p.Second)
}
-- examples/subprocess_async.gala --
package main

import (
    "runtime"
    . "martianoff/gala/subprocess"
    "martianoff/gala/go_interop"
)

// Verifies the subprocess async operations end to end:
//  - ReadLineAsync: spawn a child that echoes one known line, read it
//    OFF-THREAD via the returned Future, and print it.
//  - WriteLineAsync + CloseStdinAsync: feed a line to a `sort` filter
//    OFF-THREAD, close its stdin OFF-THREAD so it reaches EOF and emits, then
//    read the echoed line back — never capturing the Process handle into a
//    goroutine by hand.
// Commands are chosen so the program is deterministic on both Windows (cmd /
// sort) and Unix (sh / sort).

func shellOpts(script string) SpawnOpts {
    val cmd = if (runtime.GOOS == "windows") "cmd" else "sh"
    val flag = if (runtime.GOOS == "windows") "/c" else "-c"
    return SpawnOpts(
        Cmd = cmd,
        Args = go_interop.SliceOf(flag, script),
        Env = go_interop.SliceEmpty[string](),
        Dir = "",
    )
}

// sortOpts runs the platform `sort` filter (present on both Windows and Unix),
// which echoes a single stdin line back once stdin closes.
func sortOpts() SpawnOpts = SpawnOpts(
    Cmd = "sort",
    Args = go_interop.SliceEmpty[string](),
    Env = go_interop.SliceEmpty[string](),
    Dir = "",
)

func main() {
    val p = Spawn(shellOpts("echo hello-async")).Get()
    // ReadLineAsync returns Future[Try[string]]: the outer .Get() awaits the
    // Future off the calling goroutine, the inner .Get() unwraps the line.
    val line = p.ReadLineAsync().Get().Get()
    Println(line)
    p.Wait()

    // Write / close off-thread, then read the echoed line back.
    val f = Spawn(sortOpts()).Get()
    f.WriteLineAsync("written-async").Get().Get()
    f.CloseStdinAsync().Get().Get()
    val echoed = f.ReadLineAsync().Get().Get()
    Println(echoed)
    f.Wait()
}
-- examples/tco_deep_sum.gala --
package main

// sumTo adds every integer from n down to 1 onto acc using direct
// self-tail-recursion. Called with a large n, this would overflow a naive
// recursion's call stack; guaranteed TCO turns it into a constant-stack loop.
func sumTo(n int, acc int) int = if (n <= 0) acc else sumTo(n - 1, acc + n)

func main() {
    Println(sumTo(1000000, 0))
}
-- examples/tco_factorial.gala --
package main

func factorial(n int, acc int) int = if (n <= 0) acc else factorial(n - 1, n * acc)

func main() {
    Println(factorial(10, 1))
}
-- examples/tco_match_self_call.gala --
package main

// doubling counts n down to 0 and doubles the result once per level. The
// match is applied to the self-call's result, so the call is not in tail
// position: every level must run its match, giving 2^n.
func doubling(n int) int = if (n <= 0) 1 else doubling(n - 1) match { case r => r * 2 }

// loop is the self-call with an accumulator and a match on its result: the
// match still runs once per level.
func loop(n int, acc int) int = if (n <= 0) acc else loop(n - 1, acc + 1) match { case r => r * 2 }

// wholeIf has a block else branch, so the match applies to the whole
// if-expression, not to a branch: its result is doubled.
func wholeIf(n int) int = if (n > 0) n else { 1 } match { case r => r * 2 }

// recurIf is wholeIf with a self-call in the then branch: the match runs on
// every level's result, so it is not a tail call either.
func recurIf(n int) int = if (n > 0) recurIf(n - 1) else { 1 } match { case r => r * 2 }

// countUp is a real tail self-call. It is still rewritten into a loop, so a
// million levels run in constant stack.
func countUp(n int, acc int) int = if (n <= 0) acc else countUp(n - 1, acc + 1)

func main() {
    Println(doubling(10))
    Println(loop(3, 0))
    Println(wholeIf(3))
    Println(recurIf(3))
    Println(countUp(1000000, 0))
}
-- examples/trailing_comma_params.gala --
package main

// Multi-line function with trailing comma
func greetMultiline(
    name string,
    greeting string = "Hello",
    punctuation string = "!",
) string =
    s"$greeting, $name$punctuation"

// Multi-line struct with trailing comma
struct Config(
    Host string,
    Port int,
    Debug bool,
)

func NewConfig() Config = Config("localhost", 8080, true)

func main() {
    Println(greetMultiline("World"))
    Println(greetMultiline("World", "Hi", "?"))

    val cfg = NewConfig()
    Println(cfg.Host)
    Println(cfg.Port)
    Println(cfg.Debug)
}
-- examples/trailing_if_expression.gala --
package main

import . "martianoff/gala/collection_immutable"

// A block used as a value returns its trailing expression, and the
// if-expression form counts. Written with block branches it parses as a
// statement, so the value is carried by each branch's trailing expression
// rather than by an IIFE — in a block lambda and in a match arm alike.
func sumScaled(items Array[int]) int =
    items.FoldLeft(0, (acc, x) => {
        val scaled = x * 2
        if (scaled > acc) { acc + scaled } else { acc - scaled }
    })

// An else-if chain promotes through every branch.
func classify(items Array[int]) Array[string] =
    items.Map((x) => {
        if (x < 0) {
            "negative"
        } else if (x == 0) {
            "zero"
        } else {
            "positive"
        }
    })

// A branch that already returns explicitly is left as written.
func orPlaceholder(items Array[string]) Array[string] =
    items.Map((s) => {
        if (s == "") {
            return "(empty)"
        } else {
            s
        }
    })

// A match arm's block body follows the same rule — both the pattern arms and
// the default arm.
func describe(n int) string = n match {
    case 0 => {
        val label = "none"
        if (label == "none") { "zero" } else { label }
    }
    case _ => {
        val doubled = n * 2
        if (doubled > 10) { "big" } else { "small" }
    }
}

func main() {
    Println(sumScaled(ArrayOf(1, -2, 3, -4)))
    Println(classify(ArrayOf(-1, 0, 5)))
    Println(orPlaceholder(ArrayOf("hi", "")))
    Println(describe(0))
    Println(describe(9))
    Println(describe(2))
}
-- examples/trailing_if_values.gala --
package main

// A trailing `if`/`else` chain is the value of the block it ends: a `bind`
// block, a branch of an if-expression, a match arm or a lambda body. Each
// branch's value takes its type from what the block fills, so `None()` needs
// no type argument.

import . "martianoff/gala/std"

func half(n int) Option[int] = When(n % 2 == 0, n / 2)

// A `bind` block ending in an if/else chain.
func scaled(n int) Option[int] {
    bind h = half(n)
    if (h > 10) {
        None()
    } else if (h > 2) {
        Some(h * 100)
    } else {
        Some(h)
    }
}

// A branch of an if-expression ending in an if/else chain.
func bucket(n int) string {
    val b = if (n >= 0) {
        val tens = n / 10
        if (tens == 0) { "units" } else { "tens" }
    } else {
        "negative"
    }
    b
}

// A `bind` in an if-expression branch, ending in an if/else chain that holds
// another `bind`.
func nested(n int) Option[int] {
    val o = if (n > 0) {
        bind h = half(n)
        if (h > 1) { bind q = half(h); Some(q + h) } else { Some(h) }
    } else {
        None()
    }
    o
}

// A match arm and a lambda body ending in an if/else chain with a `None()`
// branch.
func armValue(n int) Option[int] {
    val r Option[int] = n match {
        case 0 => Some(0)
        case _ => {
            if (n > 5) { None() } else { Some(n * 2) }
        }
    }
    r
}

func lambdaValue(n int) Option[int] {
    val pick = (m int) Option[int] => {
        if (m > 5) { None() } else { Some(m + 1) }
    }
    pick(n)
}

// A match lowered as statements (one arm returns), whose other arm is a
// `bind` block: the chain is typed by the match, not by the function.
func early(n int) string {
    val r = n match {
        case 0 => { return "zero" }
        case _ => {
            bind h = half(n)
            Some(h > 2)
        }
    }
    s"$r"
}

func main() {
    Println(s"${scaled(2)} ${scaled(8)} ${scaled(40)} ${scaled(3)}")
    Println(s"${bucket(4)} ${bucket(42)} ${bucket(-1)}")
    Println(s"${nested(8)} ${nested(2)} ${nested(3)} ${nested(-2)}")
    Println(s"${armValue(0)} ${armValue(3)} ${armValue(9)}")
    Println(s"${lambdaValue(1)} ${lambdaValue(9)}")
    Println(s"${early(0)} ${early(8)} ${early(2)} ${early(3)}")
}
-- examples/trailing_nil_result.gala --
package main

import "errors"

// A `nil` that is a function's or lambda's result value takes the declared
// result type however it is written: as `return nil`, as the expression body,
// as a branch of an if-expression or an arm of a match, or as the trailing
// value of a block body.

// Node is the value the Go-style lookups below find, or not.
struct Node(Value int)

var shared = Node{Value: 7}

func describe(n *Node) string = if (n == nil) "nil" else s"node ${n.Value}"

func none() *Node = nil

func byIf(found bool) *Node = if (found) &shared else nil

func byMatch(found bool) *Node = found match {
    case true => &shared
    case _    => nil
}

func byTrailing(found bool) *Node {
    if found {
        return &shared
    }
    nil
}

func byTrailingIf(found bool) *Node {
    val ok = found
    if (ok) &shared else nil
}

func byTrailingMatch(found bool) *Node {
    val ok = found
    ok match {
        case true => &shared
        case _    => nil
    }
}

func byNestedBlock(found bool) *Node = if (found) &shared else {
    Println("not found")
    nil
}

func validate(n int) error {
    if n < 0 {
        return errors.New("negative")
    }
    nil
}

func main() {
    Println(describe(none()))
    Println(s"${describe(byIf(true))} ${describe(byIf(false))}")
    Println(s"${describe(byMatch(true))} ${describe(byMatch(false))}")
    Println(s"${describe(byTrailing(true))} ${describe(byTrailing(false))}")
    Println(s"${describe(byTrailingIf(true))} ${describe(byTrailingIf(false))}")
    Println(s"${describe(byTrailingMatch(true))} ${describe(byTrailingMatch(false))}")
    Println(describe(byNestedBlock(false)))

    val pick = (found bool) *Node => {
        val ok = found
        if (ok) &shared else nil
    }
    Println(s"${describe(pick(true))} ${describe(pick(false))}")

    Println(s"${validate(1) == nil} ${validate(-1)}")
}
-- examples/treemap.gala --
package main

import (
    "fmt"
    im "martianoff/gala/collection_immutable"
    mu "martianoff/gala/collection_mutable"
    . "martianoff/gala/std"
)

// This example demonstrates both immutable and mutable TreeMap usage in GALA.

func main() {
    fmt.Println("=== GALA TreeMap Examples ===\n")

    demonstrateImmutableTreeMap()
    demonstrateMutableTreeMap()
    demonstrateSortedAPI()
    demonstrateRangeQueries()
    demonstrateFunctionalOperations()
}

func demonstrateImmutableTreeMap() {
    fmt.Println("--- Immutable TreeMap ---")

    // Creating an immutable TreeMap
    val m1 = im.EmptyTreeMap[string, int]()
    val m2 = m1.Put("cherry", 3)
    val m3 = m2.Put("apple", 1)
    val m4 = m3.Put("banana", 2)

    fmt.Printf("Original map size: %d\n", m1.Size())
    fmt.Printf("After adding 3 items: %d\n", m4.Size())

    // Entries are in sorted key order
    fmt.Printf("String: %s\n", m4.String())

    // Immutability demonstration
    val m5 = m4.Put("apple", 10)
    fmt.Printf("m4 apple value: %d\n", m4.GetOrElse("apple", 0))
    fmt.Printf("m5 apple value: %d\n", m5.GetOrElse("apple", 0))

    // Min/Max
    fmt.Printf("Min key: %s\n", m4.MinKey())
    fmt.Printf("Max key: %s\n", m4.MaxKey())

    // Get
    fmt.Printf("Get banana: %v\n", m4.Get("banana"))
    fmt.Printf("Get grape: %v\n", m4.Get("grape"))

    // Remove
    val m6 = m4.Remove("banana")
    fmt.Printf("After remove banana: %s\n", m6.String())
    fmt.Println()
}

func demonstrateMutableTreeMap() {
    fmt.Println("--- Mutable TreeMap ---")

    // Creating a mutable TreeMap
    val m = mu.EmptyTreeMap[string, int]()
    m.Put("cherry", 3)
    m.Put("apple", 1)
    m.Put("banana", 2)
    fmt.Printf("Size: %d\n", m.Size())
    fmt.Printf("String: %s\n", m.String())

    // Update existing key
    m.Put("apple", 10)
    fmt.Printf("After update apple: %d\n", m.GetOrElse("apple", 0))

    // PutIfAbsent
    m.PutIfAbsent("apple", 99)
    fmt.Printf("After PutIfAbsent apple: %d\n", m.GetOrElse("apple", 0))
    m.PutIfAbsent("date", 4)
    fmt.Printf("After PutIfAbsent date: %d\n", m.GetOrElse("date", 0))

    // PopMinEntry
    val min = m.PopMinEntry()
    fmt.Printf("Popped min: %v -> %v\n", min.V1, min.V2)
    fmt.Printf("Size after pop: %d\n", m.Size())

    // Clear
    m.Clear()
    fmt.Printf("After clear: %s\n", m.String())
    fmt.Println()
}

func demonstrateSortedAPI() {
    fmt.Println("--- Sorted API ---")

    // Immutable TreeMap - Sorted (no-op, already sorted by key)
    val im1 = im.EmptyTreeMap[string, int]().Put("c", 30).Put("a", 10).Put("b", 20)
    val sorted = im1.Sorted()
    fmt.Printf("Sorted by key: %s\n", sorted.MkString(", "))

    // SortWith - custom ordering (sort by value)
    val sortedByValue = im1.SortWith((a Tuple[string, int], b Tuple[string, int]) => a.V2 < b.V2)
    fmt.Printf("Sorted by value: %s\n", sortedByValue.MkString(", "))

    // SortBy - sort by extracted key
    val sortedByValueDesc = im1.SortBy[int]((entry Tuple[string, int]) => -entry.V2)
    fmt.Printf("Sorted by value desc: %s\n", sortedByValueDesc.MkString(", "))
    fmt.Println()
}

func demonstrateRangeQueries() {
    fmt.Println("--- Range Queries ---")

    var m = im.EmptyTreeMap[int, string]()
    for i := 1; i <= 10; i++ {
        m = m.Put(i, fmt.Sprintf("val%d", i))
    }

    // Range [3, 7]
    val range1 = m.Range(3, 7)
    fmt.Printf("Range [3,7]: %s\n", range1.String())

    // RangeFrom >= 8
    val range2 = m.RangeFrom(8)
    fmt.Printf("RangeFrom 8: %s\n", range2.String())

    // RangeTo <= 3
    val range3 = m.RangeTo(3)
    fmt.Printf("RangeTo 3: %s\n", range3.String())
    fmt.Println()
}

func demonstrateFunctionalOperations() {
    fmt.Println("--- Functional Operations ---")

    val m = im.EmptyTreeMap[string, int]().Put("a", 1).Put("b", 2).Put("c", 3).Put("d", 4).Put("e", 5)

    // Filter
    val even = m.Filter((k string, v int) => v % 2 == 0)
    fmt.Printf("Even values: %s\n", even.String())

    // MapValues
    val doubled = m.MapValues[int]((v int) => v * 2)
    fmt.Printf("Doubled values: %s\n", doubled.String())

    // FoldLeftKV
    val sum = m.FoldLeftKV[int](0, (acc int, k string, v int) => acc + v)
    fmt.Printf("Sum of values: %d\n", sum)

    // Merge
    val m2 = im.EmptyTreeMap[string, int]().Put("c", 30).Put("f", 6)
    val merged = m.Merge(m2, (v1 int, v2 int) => v1 + v2)
    fmt.Printf("Merged: %s\n", merged.String())

    // Convert to HashMap
    val hm = m.ToHashMap()
    fmt.Printf("HashMap size: %d\n", hm.Size())

    // Convert to GoMap
    val gm = m.ToGoMap()
    fmt.Printf("Go map[a]: %d\n", gm["a"])
    fmt.Println()
}
-- examples/try_basic.gala --
package main

import "fmt"

// divide performs division, returning a Failure if divisor is zero.
func divide(a int, b int) Try[int] {
	if b == 0 {
		return Failure[int](NoSuchElementError(Message = "division by zero"))
	}
	return Success[int](a / b)
}

// parsePositive returns a Success if the number is positive, Failure otherwise.
func parsePositive(n int) Try[int] {
	if n <= 0 {
		return Failure[int](NoSuchElementError(Message = "number must be positive"))
	}
	return Success[int](n)
}

func main() {
	// Basic Try creation - type inferred from value
	val success = Success[int](42)
	val failure Try[int] = Failure[int](NoSuchElementError(Message = "something went wrong"))

	// Pattern matching
	val msg1 = success match {
		case Success(n) => fmt.Sprintf("Got value: %d", n)
		case Failure(e) => fmt.Sprintf("Error: %s", e.Error())
		case _ => "Unknown"
	}
	fmt.Println(msg1)

	val msg2 = failure match {
		case Success(n) => fmt.Sprintf("Got value: %d", n)
		case Failure(e) => fmt.Sprintf("Error: %s", e.Error())
		case _ => "Unknown"
	}
	fmt.Println(msg2)

	// Using methods
	fmt.Println("success.IsSuccess():", success.IsSuccess())
	fmt.Println("failure.IsFailure():", failure.IsFailure())
	fmt.Println("success.Get():", success.Get())
	fmt.Println("failure.GetOrElse(0):", failure.GetOrElse(0))

	// Map operation - type inferred
	val doubled = success.Map((n int) => n * 2)
	fmt.Println("doubled.Get():", doubled.Get())

	// FlatMap operation (chaining)
	val result = divide(10, 2).FlatMap((n int) => divide(n, 2))
	fmt.Println("10 / 2 / 2 =", result.Get())

	// Filter operation
	val filtered = success.Filter((n int) => n > 50)
	fmt.Println("filtered (>50):", filtered.IsSuccess())

	// OrElse operation
	val recovered = failure.OrElse(Success[int](100))
	fmt.Println("recovered.Get():", recovered.Get())

	// Conversion to Option
	val opt = success.ToOption()
	fmt.Println("toOption.IsDefined():", opt.IsDefined())

	// Conversion to Either
	val either = failure.ToEither()
	fmt.Println("toEither.IsLeft():", either.IsLeft())

	// FromOption conversion - type inferred from Some(99)
	val fromSome = FromOption[int](Some[int](99))
	val fromNone = FromOption[int](None[int]())
	fmt.Println("fromSome.Get():", fromSome.Get())
	fmt.Println("fromNone.IsFailure():", fromNone.IsFailure())
}
-- examples/try_block_lambda_generic_method.gala --
package main

import (
    . "martianoff/gala/std"
)

// Repro for lambda-return-type inference bug with block lambdas inside a
// concrete Try[X] constructor called from within a generic method.
//
// Before the fix: the transpiler emitted `func()` (no return type) for the
// inner lambda because Section 6 (argument transformation) didn't see the
// Apply method's param types; those were resolved only in Section 10 after
// the lambda had already been transformed with no expected type.
//
// After the fix: collectFunctionCallContext detects the `Type[T](args)`
// shape and threads Apply's param-types + type-substitutions through as
// callContext.applyMethodMeta / applyTypeSubst, so lambda args see the
// substituted `func() string` as their expected type.

type Wrap[T any] struct {}

func (w Wrap[T]) Run(v T) Try[string] {
    return Try[string](() => {
        val prefix = "hi-"
        val suffix = "-end"
        return prefix + suffix
    })
}

func main() {
    val w = Wrap[int]{}
    val result = w.Run(0)
    Println(result.Get())
}
-- examples/try_chain_dot_import_std_matrix/axis_a1_auto_import.gala --
package try_chain_dot_import_std_matrix

// Axis A1: std is auto-imported (no `std` in import block, no `import .`).
// Try / Success / Failure resolve via the auto-import path. These cells must
// stay green to confirm the fix does not regress the working baseline.

// A1 + B1 + C1 + D2 + E1 + F2: bare param + same-package + FlatMap-Map +
// Try + asymmetric type args.
func A1_B1_C1_D2_E1_F2(p ProcA1) Try[bool] =
    p.Kill().FlatMap((_) => p.Wait().Map((_) => true))

// A1 + B1 + C1 + D1 + E1: bare param, just .Map.
func A1_B1_C1_D1_E1(p ProcA1) Try[bool] =
    p.Kill().Map((_) => true)

// A1 + B1 + C1 + D5 + E1: match-arm form (cross-arm consistency).
func A1_B1_C1_D5_E1(p ProcA1) Try[bool] = p.Kill() match {
    case Success(_)   => p.Wait().Map((_) => true)
    case Failure(err) => Failure[bool](err)
}
-- examples/try_chain_dot_import_std_matrix/axis_a3_dot_import.gala --
package try_chain_dot_import_std_matrix

// Axis A3: std is dot-imported. This is the trigger axis. The synthesized
// FlatMap closure return type must spell out the inner type argument.
// collection_immutable is dot-imported too so the F3 (nested generic) cell
// can use Array[int].
import (
    . "martianoff/gala/std"
    . "martianoff/gala/collection_immutable"
)

// A3 + B1 + C1 + D2 + E1 + F2: the original failing repro shape.
func A3_B1_C1_D2_E1_F2(p ProcA1) Try[bool] =
    p.Kill().FlatMap((_) => p.Wait().Map((_) => true))

// A3 + B1 + C1 + D5 + E1: match-arm form. Both arms must agree on Try[bool].
func A3_B1_C1_D5_E1(p ProcA1) Try[bool] = p.Kill() match {
    case Success(_)   => p.Wait().Map((_) => true)
    case Failure(err) => Failure[bool](err)
}

// A3 + B1 + C1 + D3 + E1: depth-3 chain to confirm type-arg propagation
// holds at multiple nesting levels.
func A3_B1_C1_D3_E1(p ProcA1) Try[bool] =
    p.Kill().FlatMap((_) =>
        p.Wait().FlatMap((_) =>
            p.Kill().Map((_) => true)))

// A3 + B1 + C1 + D4 + E1: FlatMap whose closure is a typed match expression.
func A3_B1_C1_D4_E1(p ProcA1) Try[bool] =
    p.Kill().FlatMap((_) => p.Wait() match {
        case Success(_)   => Success[bool](true)
        case Failure(err) => Failure[bool](err)
    })

// A3 + B2 + C1 + D2 + E1: struct-field receiver (auto-Get on Immutable).
func A3_B2_C1_D2_E1(h HolderA1) Try[bool] =
    h.Proc.Kill().FlatMap((_) => h.Proc.Wait().Map((_) => true))

// A3 + B3 + C1 + D2 + E1: function-return receiver. Note: GALA's parser
// chains method calls onto the call expression directly.
func A3_B3_C1_D2_E1() Try[bool] =
    MakeProcA1().Kill().FlatMap((_) => MakeProcA1().Wait().Map((_) => true))

// A3 + B1 + C1 + D2 + E1 + F1: same outer/inner type (Try[int] → Try[int]).
func A3_B1_C1_D2_E1_F1(p ProcA1) Try[int] =
    p.Wait().FlatMap((_) => p.Wait().Map((_) => 42))

// A3 + B1 + C1 + D2 + E1 + F3: nested generic inner type (Try[Array[int]]).
func A3_B1_C1_D2_E1_F3(p ProcA1) Try[Array[int]] =
    p.Kill().FlatMap((_) => p.Wait().Map((_) => ArrayOf(1, 2, 3)))
-- examples/try_chain_dot_import_std_matrix/axis_c_cross_pkg.gala --
package try_chain_dot_import_std_matrix

// Axis C2 / C3: receiver type Process lives in a sibling GALA package. Both
// the std-as-dot-import and std-as-explicit-qualifier shapes must preserve
// the inner type argument.
import (
    . "martianoff/gala/std"
    . "martianoff/gala/examples/try_chain_dot_import_std_matrix_proc"
)

// C3 + A3 + B1 + D2 + E1 + F2: Process from a different GALA package
// (dot-imported), receiver chain under dot-imported std.
func C3_A3_B1_D2_E1_F2(p Process) Try[bool] =
    p.Kill().FlatMap((_) => p.Wait().Map((_) => true))

// C3 + A3 + B1 + D5 + E1: match-arm form, cross-pkg receiver, dot-imported std.
func C3_A3_B1_D5_E1(p Process) Try[bool] = p.Kill() match {
    case Success(_)   => p.Wait().Map((_) => true)
    case Failure(err) => Failure[bool](err)
}

// Holder used by C3 + B2 (struct field) cell.
struct HolderC3(Proc Process)

// C3 + A3 + B2 + D2 + E1 + F2: struct field with cross-package value type
// under dot-imported std.
func C3_A3_B2_D2_E1_F2(h HolderC3) Try[bool] =
    h.Proc.Kill().FlatMap((_) => h.Proc.Wait().Map((_) => true))
-- examples/try_chain_dot_import_std_matrix/axis_e2_option.gala --
package try_chain_dot_import_std_matrix

// Axis E2: Option[T] under the dot-import-of-std trigger. The same erasure
// path that dropped Try[bool] would drop Option[bool] without the fix.
import (
    . "martianoff/gala/std"
)

// Cells use a local Source whose methods return Option[bool] / Option[int].
// Source lives in this file so the auto-import siblings (A1) don't share it.

struct Source(Tag string)

func (s Source) Find()  Option[bool] = Some(true)
func (s Source) Count() Option[int]  = Some(0)

// E2 + A3 + B1 + C1 + D2 + F2: FlatMap-Map under dot-import.
func E2_A3_B1_C1_D2_F2(s Source) Option[bool] =
    s.Find().FlatMap((_) => s.Count().Map((_) => true))

// E2 + A3 + B1 + C1 + D5: match-arm form for Option (Some/None).
func E2_A3_B1_C1_D5(s Source) Option[bool] = s.Find() match {
    case Some(_) => s.Count().Map((_) => true)
    case None()  => None[bool]()
}

// E2 + A3 + B1 + C1 + D3: depth-3 chain.
func E2_A3_B1_C1_D3(s Source) Option[bool] =
    s.Find().FlatMap((_) =>
        s.Count().FlatMap((_) =>
            s.Find().Map((_) => true)))
-- examples/try_chain_dot_import_std_matrix/axis_e3_either.gala --
package try_chain_dot_import_std_matrix

// Axis E3: Either[E, T] under the dot-import-of-std trigger.
import (
    . "martianoff/gala/std"
)

struct Lookup(Tag string)

func (l Lookup) Read()  Either[string, bool] = Right[string, bool](true)
func (l Lookup) Count() Either[string, int]  = Right[string, int](0)

// E3 + A3 + B1 + C1 + D2 + F2: Either FlatMap-Map under dot-import.
func E3_A3_B1_C1_D2_F2(l Lookup) Either[string, bool] =
    l.Read().FlatMap((_) => l.Count().Map((_) => true))

// E3 + A3 + B1 + C1 + D5: match-arm form for Either (Left/Right).
func E3_A3_B1_C1_D5(l Lookup) Either[string, bool] = l.Read() match {
    case Right(_)   => l.Count().Map((_) => true)
    case Left(err)  => Left[string, bool](err)
}
-- examples/try_chain_dot_import_std_matrix/types.gala --
package try_chain_dot_import_std_matrix

// Local fixtures used by the matrix. Defined here (without dot-importing std)
// so axis A1 (auto-import std) cells have a same-package receiver that does
// NOT route Try / Option / Either through a dot-import resolution path.

struct ProcA1(Pid int)

func (p ProcA1) Kill() Try[bool] = Success[bool](true)
func (p ProcA1) Wait() Try[int]  = Success[int](0)

// Holder is used by axis B2 (struct field receiver) cells under A1.
struct HolderA1(Proc ProcA1)

// MakeProcA1 is used by axis B3 (function-return receiver) cells under A1.
func MakeProcA1() ProcA1 = ProcA1(Pid = 1)
-- examples/try_chain_dot_import_std_matrix_main/main.gala --
package main

// Driver for the Try-chain dot-import-of-std test matrix. Each function in
// the matrix library returns a typed monad; the driver invokes a
// representative cell from each axis combination and asserts the resulting
// success branch carries a bool true (or the corresponding sentinel for
// other element types).

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/try_chain_dot_import_std_matrix"
    "martianoff/gala/examples/try_chain_dot_import_std_matrix_proc"
)

func reportTry(label string, t Try[bool]) {
    t match {
        case Success(b) => Println(s"$label: $b")
        case Failure(e) => Println(s"$label err: ${e.Error()}")
    }
}

func reportTryInt(label string, t Try[int]) {
    t match {
        case Success(i) => Println(s"$label: $i")
        case Failure(e) => Println(s"$label err: ${e.Error()}")
    }
}

func reportTryArray(label string, t Try[Array[int]]) {
    t match {
        case Success(arr) => Println(s"$label: ${arr.Length()}")
        case Failure(e) => Println(s"$label err: ${e.Error()}")
    }
}

func reportOption(label string, o Option[bool]) {
    o match {
        case Some(b) => Println(s"$label: $b")
        case None()  => Println(s"$label: none")
    }
}

func reportEither(label string, ei Either[string, bool]) {
    ei match {
        case Right(b)  => Println(s"$label: $b")
        case Left(err) => Println(s"$label err: $err")
    }
}

func main() {
    val pa1 = try_chain_dot_import_std_matrix.ProcA1(Pid = 1)
    val ha1 = try_chain_dot_import_std_matrix.HolderA1(Proc = pa1)

    // Axis A1 (auto-import std)
    reportTry("a1_b1_c1_d2_e1_f2", try_chain_dot_import_std_matrix.A1_B1_C1_D2_E1_F2(pa1))
    reportTry("a1_b1_c1_d1_e1",    try_chain_dot_import_std_matrix.A1_B1_C1_D1_E1(pa1))
    reportTry("a1_b1_c1_d5_e1",    try_chain_dot_import_std_matrix.A1_B1_C1_D5_E1(pa1))

    // Axis A3 (dot-imported std) — the trigger axis.
    reportTry("a3_b1_c1_d2_e1_f2", try_chain_dot_import_std_matrix.A3_B1_C1_D2_E1_F2(pa1))
    reportTry("a3_b1_c1_d5_e1",    try_chain_dot_import_std_matrix.A3_B1_C1_D5_E1(pa1))
    reportTry("a3_b1_c1_d3_e1",    try_chain_dot_import_std_matrix.A3_B1_C1_D3_E1(pa1))
    reportTry("a3_b1_c1_d4_e1",    try_chain_dot_import_std_matrix.A3_B1_C1_D4_E1(pa1))
    reportTry("a3_b2_c1_d2_e1",    try_chain_dot_import_std_matrix.A3_B2_C1_D2_E1(ha1))
    reportTry("a3_b3_c1_d2_e1",    try_chain_dot_import_std_matrix.A3_B3_C1_D2_E1())
    reportTryInt("a3_b1_c1_d2_e1_f1", try_chain_dot_import_std_matrix.A3_B1_C1_D2_E1_F1(pa1))
    reportTryArray("a3_b1_c1_d2_e1_f3", try_chain_dot_import_std_matrix.A3_B1_C1_D2_E1_F3(pa1))

    // Axis E2 (Option) under dot-imported std.
    val src = try_chain_dot_import_std_matrix.Source(Tag = "src")
    reportOption("e2_a3_b1_c1_d2_f2", try_chain_dot_import_std_matrix.E2_A3_B1_C1_D2_F2(src))
    reportOption("e2_a3_b1_c1_d5",    try_chain_dot_import_std_matrix.E2_A3_B1_C1_D5(src))
    reportOption("e2_a3_b1_c1_d3",    try_chain_dot_import_std_matrix.E2_A3_B1_C1_D3(src))

    // Axis E3 (Either) under dot-imported std.
    val lk = try_chain_dot_import_std_matrix.Lookup(Tag = "lk")
    reportEither("e3_a3_b1_c1_d2_f2", try_chain_dot_import_std_matrix.E3_A3_B1_C1_D2_F2(lk))
    reportEither("e3_a3_b1_c1_d5",    try_chain_dot_import_std_matrix.E3_A3_B1_C1_D5(lk))

    // Axis C3 (cross-package Process via dot-imported pkg) under dot-imported std.
    val pc3 = try_chain_dot_import_std_matrix_proc.Process(Pid = 1)
    val hc3 = try_chain_dot_import_std_matrix.HolderC3(Proc = pc3)
    reportTry("c3_a3_b1_d2_e1_f2", try_chain_dot_import_std_matrix.C3_A3_B1_D2_E1_F2(pc3))
    reportTry("c3_a3_b1_d5_e1",    try_chain_dot_import_std_matrix.C3_A3_B1_D5_E1(pc3))
    reportTry("c3_a3_b2_d2_e1_f2", try_chain_dot_import_std_matrix.C3_A3_B2_D2_E1_F2(hc3))
}
-- examples/try_chain_dot_import_std_matrix_proc/proc.gala --
package try_chain_dot_import_std_matrix_proc

// Cross-package source of Process used by axis C2 / C3 cells. Defined in a
// separate package so the test matrix can exercise both same-package and
// cross-package receivers under the dot-import-of-std trigger.

struct Process(Pid int)

func (p Process) Kill() Try[bool] = Success[bool](true)
func (p Process) Wait() Try[int]  = Success[int](0)
-- examples/try_chain_dot_import_std_repro/proc.gala --
package try_chain_dot_import_std_repro

// ProcessLocal exercises the Try chain repro at the same-package level so the
// runtime.gala chain calls method on a bare-named ProcessLocal value (not a
// cross-package qualifier). Kill returns Try[bool], Wait returns Try[int] —
// the asymmetric element types let runtime.gala build the
// FlatMap((_) => Map((_) => v)) shape whose synthesized closure return type
// must preserve the [bool] type argument.

struct ProcessLocal(Pid int)

func (p ProcessLocal) Kill() Try[bool] = Success[bool](true)
func (p ProcessLocal) Wait() Try[int]  = Success[int](0)
-- examples/try_chain_dot_import_std_repro/runtime.gala --
package try_chain_dot_import_std_repro

import (
    . "martianoff/gala/std"
)

// The dot import of std is the trigger axis: Try, Success, and Failure
// resolve unqualified through the dot-imported std namespace. The chain
// p.Kill().FlatMap((_) => p.Wait().Map((_) => true)) must emit the inner
// FlatMap closure's return type as Try[bool] — without the [bool] type
// argument the call instantiates Try[T any] without arguments and Go
// rejects the program.

func CloseSessionLocalRepro(p ProcessLocal) Try[bool] =
    p.Kill().FlatMap((_) => p.Wait().Map((_) => true))
-- examples/try_chain_typeparam_repro/proc.gala --
package try_chain_typeparam_repro

// Process.Kill() returns Try[bool] and Process.Wait() returns Try[int] — the
// asymmetric element types let session.gala exercise a chained
// FlatMap((_) => Map((_) => v)) whose synthesized closure return type must
// preserve the [bool] type argument across both Try methods.

struct Process(Pid int)

func (p Process) Kill() Try[bool] = Success[bool](true)
func (p Process) Wait() Try[int]  = Success[int](0)
-- examples/try_chain_typeparam_repro/session.gala --
package try_chain_typeparam_repro

// Session wraps a Process and exercises the chained Try.FlatMap/Map pattern
// in batch transpilation context. The FlatMap chain must propagate the inner
// Try[bool] type argument through the synthesized closure return type so the
// generated Go signature reads `func(_ bool) Try[bool]` and not bare `Try`.

struct Session(Proc Process)

// CloseSession exercises Try[bool].FlatMap((_) => Try[int].Map((_) => true)).
// Generated Go must spell the outer closure return type as Try[bool].
func CloseSession(s Session) Try[bool] =
    s.Proc.Kill().FlatMap((_) => s.Proc.Wait().Map((_) => true))

// CloseSessionMatch covers the same propagation through a match expression:
// both arms must agree on Try[bool], so Wait().Map((_) => true) must be typed
// as Try[bool] when the analyzer compares branch types.
func CloseSessionMatch(s Session) Try[bool] = s.Proc.Kill() match {
    case Success(_)   => s.Proc.Wait().Map((_) => true)
    case Failure(err) => Failure[bool](err)
}
-- examples/try_chain_typeparam_repro_main/main.gala --
package main

// Driver for the cross-package chained Try.FlatMap repro. The actual
// FlatMap/Map chain lives in the try_chain_typeparam_repro library so the
// closure-signature synthesis runs in batch transpilation context.

import (
    "martianoff/gala/examples/try_chain_typeparam_repro"
)

func main() {
    val s = try_chain_typeparam_repro.Session(
        Proc = try_chain_typeparam_repro.Process(Pid = 1))
    try_chain_typeparam_repro.CloseSession(s) match {
        case Success(b) => Println(s"flatmap: $b")
        case Failure(e) => Println(s"flatmap err: ${e.Error()}")
    }
    try_chain_typeparam_repro.CloseSessionMatch(s) match {
        case Success(b) => Println(s"match: $b")
        case Failure(e) => Println(s"match err: ${e.Error()}")
    }
}
-- examples/try_chained_method.gala --
package main

import "bytes"
import "strconv"
import "strings"

// Test: (T, error) destructuring for chained method calls in Try lambda.
func main() {
    // Standalone call — already works (baseline)
    val result1 = Try(() => strconv.Atoi("123")) match {
        case Success(n) => s"standalone: $n"
        case Failure(err) => s"Error: ${err.Error()}"
    }
    Println(result1)

    // Chained method call
    // bytes.NewBufferString("hello world") returns *bytes.Buffer
    // .ReadString(' ') on *bytes.Buffer returns (string, error)
    val result2 = Try(() => bytes.NewBufferString("hello world").ReadString(' ')) match {
        case Success(s) => s"chained: ${strings.TrimSpace(s)}"
        case Failure(err) => s"Error: ${err.Error()}"
    }
    Println(result2)

    // Chained method call — error case
    val result3 = Try(() => bytes.NewBufferString("").ReadString('\n')) match {
        case Success(s) => s"got: $s"
        case Failure(_) => "chained error caught"
    }
    Println(result3)
}
-- examples/try_func_ref.gala --
package main

import "os"

func getAnswer() int = 42

// Test: Try with function reference (no lambda wrapper needed)
// Try(os.TempDir) should work the same as Try(() => os.TempDir())
func main() {
    // Go function reference
    val result1 = Try(os.TempDir)
    Println(result1.IsSuccess())

    // Lambda syntax (existing)
    val result2 = Try(() => os.TempDir())
    Println(result2.IsSuccess())

    // Both should produce the same result
    Println(result1.Get() == result2.Get())

    // GALA function reference (type inferred from function signature)
    val result3 = Try(getAnswer)
    Println(result3.IsSuccess())
    Println(result3.Get())
}
-- examples/try_go_interop.gala --
package main

import "net"
import "os"
import "strconv"

// Test: Try type param inference from lambda return type.
// Test: Go multi-return (T, error) inside Try lambda.
func main() {
    // Try should infer T=string from lambda return type (single-return Go func)
    val dirResult = Try(() => os.TempDir()) match {
        case Success(_) => "ok"
        case Failure(err) => s"Error: ${err.Error()}"
    }
    Println(dirResult)

    // Try with Go function returning (int, error) - auto error panic wrapping
    val intResult = Try(() => strconv.Atoi("42")) match {
        case Success(n) => s"Parsed: $n"
        case Failure(err) => s"Error: ${err.Error()}"
    }
    Println(intResult)

    // Try with Go function returning (T, error) that actually fails
    val failResult = Try(() => strconv.Atoi("not_a_number")) match {
        case Success(n) => s"Parsed: $n"
        case Failure(_) => "parse error caught"
    }
    Println(failResult)

    // Try with os.MkdirTemp (string, error) - verify type inferred as string
    val tmpResult = Try(() => os.MkdirTemp("", "gala-test-*")) match {
        case Success(dir) => {
            os.RemoveAll(dir)
            "temp dir created and cleaned"
        }
        case Failure(_) => "failed"
    }
    Println(tmpResult)

    // Tuple: Go function returning (string, string, error) -> Tuple[string, string]
    val hostPort = Try(() => net.SplitHostPort("localhost:8080")) match {
        case Success(hp) => s"host=${hp.V1} port=${hp.V2}"
        case Failure(err) => s"Error: ${err.Error()}"
    }
    Println(hostPort)

    // Tuple: error case
    val badHostPort = Try(() => net.SplitHostPort("invalid")) match {
        case Success(hp) => s"host=${hp.V1} port=${hp.V2}"
        case Failure(_) => "split error caught"
    }
    Println(badHostPort)
}
