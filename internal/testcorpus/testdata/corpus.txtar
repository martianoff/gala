package main

import "fmt"

struct Person(Name string, Age int)

sealed type Shape {
    case Circle(Radius float64)
    case Rectangle(Width float64, Height float64)
}

func describe(s Shape) string = s match {
    case Circle(r) => fmt.Sprintf("Circle with radius %.1f", r)
    case Rectangle(w, h) => fmt.Sprintf("Rectangle %.0fx%.0f", w, h)
}

func (p Person) Greet() string = fmt.Sprintf("Hi, I'm %s, age %d", p.Name, p.Age)
-- examples/multi_vars.gala --
package main

import "fmt"

func main() {
    // Multiple val declaration
    val a, b = 10, 20
    fmt.Println("a =", a, "b =", b)

    // Multiple var declaration
    var x, y int = 30, 40
    fmt.Println("x =", x, "y =", y)
    x = 35
    y = 45
    fmt.Println("x =", x, "y =", y)

    // Short variable declaration (immutable)
    z1, z2 := 50, 60
    fmt.Println("z1 =", z1, "z2 =", z2)
    // z1 = 55 // Error: cannot assign to immutable variable z1
}
-- examples/multifile_lib_regress/bare_variant.gala --
package multifile_lib_regress

// Bare-identifier arms over sealed types, exercised through the multi-file
// BatchAnalyzer path rather than a single-file `gala_test`.
//
// A bare identifier in pattern position is a variable binding, and a binding
// matches every value. When the identifier names a zero-field variant of the
// type being matched it must be lowered as that variant's pattern instead —
// otherwise the arm becomes a silent catch-all: the program compiles, exits 0,
// and answers with the wrong arm. Sealed-variant metadata reaches the
// transformer differently under batch analysis than in single-file mode, so the
// shape is worth covering on both paths.

// Cursor is generic, so `AtEnd`'s companion carries a type parameter that has
// to be resolved from the matched type before the extractor can be called.
sealed type Cursor[T any] {
    case AtItem(Item T)
    case AtEnd
}

// Marker is the non-generic control.
sealed type Marker {
    case Named(Label string)
    case Anonymous
}

func DescribeCursor(c Cursor[string]) string = c match {
    case AtEnd      => "cursor-end"
    case AtItem(it) => s"cursor-item $it"
}

func DescribeMarker(m Marker) string = m match {
    case Anonymous  => "marker-anon"
    case Named(lbl) => s"marker-named $lbl"
}

// The bare arm listed FIRST must not swallow the arms after it.
func DescribeOption(o Option[int]) string = o match {
    case None    => "opt-none"
    case Some(n) => s"opt-some $n"
}

func ItemCursor(v string) Cursor[string] = AtItem(v)

func EndCursor() Cursor[string] = AtEnd[string]()

func NamedMarker(label string) Marker = Named(label)

func AnonymousMarker() Marker = Anonymous()
-- examples/multifile_lib_regress/codec_meta_a.gala --
package multifile_lib_regress

// This file and codec_meta_b.gala use the same codecs. Point's StructMeta is
// declared once, here, where Point is; a ValueMeta describes a value shape no
// file declares, so each file declares the one it uses under a file-specific
// name — with shared names both declared _ValueMeta_int and the package did
// not compile ("redeclared in this block").

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/json"
)

// Point is encoded by both files: directly through Codec[Point] here, and
// as an element of Value[Array[Point]] in codec_meta_b.gala.
struct Point(X int, Y int)

// CodecMetaA encodes a Point and an int.
func CodecMetaA() string {
    val p = json.Codec[Point](json.SnakeCase()).Encode(Point(1, 2)).GetOrElse("<failure>")
    val n = json.Value[int]().Encode(3).GetOrElse("<failure>")
    s"$p $n"
}
-- examples/multifile_lib_regress/codec_meta_b.gala --
package multifile_lib_regress

// The second file of the codec_meta_a.gala pair: the same metadata again.

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/json"
)

// CodecMetaB decodes an int and encodes an array of Points.
func CodecMetaB() string {
    val n = json.Value[int]().Decode("4").GetOrElse(-1)
    val ps = json.Value[Array[Point]]().Encode(ArrayOf(Point(5, 6))).GetOrElse("<failure>")
    val p = json.Codec[Point](json.SnakeCase()).Decode("{\"x\":7,\"y\":8}").Map(_.X).GetOrElse(-1)
    s"$n $ps $p"
}
-- examples/multifile_lib_regress/consult_end.gala --
package multifile_lib_regress

import (
    . "martianoff/gala/examples/multifile_lib_regress/proc_pkg"
)

// --- Regression: cross-package Option.Map lambda body returns method call.
// ConsultEvent is sealed with cases ConsultChunk / ConsultEnd defined in
// proc_pkg (a sibling GALA package). The ConsultEnd case carries an
// Option[error] field. Pattern-matching on a ConsultEvent in this package
// binds errOpt to that Option[error]; calling errOpt.Map((e) => e.Error())
// must yield Option[string] — the lambda body's return type is a method
// call on the bound element name, and the method's return type (`string`)
// has to be propagated back through the .Map's result type even though
// the receiver Option[error] is constructed in another package.
//
// Before the fix the generated Go was:
//   Option_Map(errOpt, func(e error) any { return e.Error() })
// which Go rejects because Option_Map's result Option[any] cannot satisfy
// the surrounding Option[string] context.

sealed type AppMsg {
    case ChunkArrived(Name string, Line string)
    case Ended(Name string, ErrText Option[string])
}

func ToAppMsg(ev ConsultEvent) AppMsg = ev match {
    case ConsultChunk(name, line) =>
        ChunkArrived(Name = name, Line = line)
    case ConsultEnd(name, errOpt) =>
        Ended(Name = name, ErrText = errOpt.Map((e) => e.Error()))
}

func DescribeAppMsg(m AppMsg) string = m match {
    case ChunkArrived(name, line) => s"chunk[$name]=$line"
    case Ended(name, errText)     => errText match {
        case Some(msg) => s"end[$name] err=$msg"
        case None()    => s"end[$name] ok"
    }
}
-- examples/multifile_lib_regress/cross_file_methods.gala --
package multifile_lib_regress

// --- Regression: methods on one type spread across files of a package ---
// Ledger is declared here and carries one of its methods; the rest live in
// cross_file_methods_ext.gala. The analyzer merges a package's files into a
// single method set per type, and the duplicate-method check that guards
// that set must count a sibling's contribution as one declaration, not two.
// This only exercises the batch (--package-files) path, so a single-file
// test cannot stand in for it.
struct Ledger(Owner string)

func (l Ledger) OwnedBy() string = l.Owner
-- examples/multifile_lib_regress/cross_file_methods_ext.gala --
package multifile_lib_regress

// Continuation of Ledger's method set, in a different file of the same
// package than the struct declaration (see cross_file_methods.gala).

func (l Ledger) Tagged() string = s"ledger:${l.Owner}"

func LedgerFor(owner string) Ledger = Ledger(Owner = owner)
-- examples/multifile_lib_regress/directive_chain.gala --
package multifile_lib_regress

import (
    "martianoff/gala/examples/multifile_lib_regress/directive_pkg"
    . "martianoff/gala/collection_immutable"
)

// --- Regression: chained accessor through Immutable wrapper ---
//
// These helpers re-export directive_pkg fixtures so the test driver
// can exercise them through dot-imports. The pre-existing failure
// mode: when the consumer's on-disk pkgAST cache predates the
// transitive-type-merge in scanImports, `collection_immutable.Array`
// is missing from the consumer's typeMetas. Then `dirs.Get(0)` (where
// `dirs` was a val storing `Array[Directive]`) inferred its type via
// `inferGetMethodType` → `getTypeMeta("collection_immutable.Array")`
// → nil → fall through to `return xType` (the Array receiver itself,
// not the .Get(0) return type).
//
// Downstream:
//   - `val firstD = dirs.Get(0)` stored `firstD` as `Array[Directive]`
//     instead of `Directive`.
//   - `firstD match { case Dispatch(...) => ... }` typed the IIFE
//     param as `Array[Directive]` and `Dispatch{}.Unapply(obj)` was
//     rejected because Unapply expects `Directive`, not the array.
//
// The fix invalidates that stale cache by mixing the gala compiler
// binary's content hash into the cache directory key.

// ParseDirectives returns Array[Directive] for the consumer to chain
// .Get(N) and match against. Routes through directive_pkg so the
// match site sits across a package boundary.
func ParseDirectives(msg string) Array[directive_pkg.Directive] =
    directive_pkg.Parse(msg)

// LoadCfg is the cross-package container access helper.
func LoadCfg() directive_pkg.Cfg = directive_pkg.SampleCfg()

// LoadCfgs is the 3-deep chain test helper. The driver does
// `cfgs.Get(N).Lead.Name` which traverses
//   `Array[Cfg] → Cfg → Member → string`
// where each hop is wrapped/unwrapped through Immutable.
func LoadCfgs() Array[directive_pkg.Cfg] = directive_pkg.SampleCfgs()
-- examples/multifile_lib_regress/directive_pkg/directive.gala --
package directive_pkg

import (
    . "martianoff/gala/collection_immutable"
)

// directive_pkg mirrors the real-world shape that hit the chained
// auto-unwrap regressions in production: a sealed type plus a
// `Parse(string) Array[Sealed]` function that returns an Array from a
// transitively-imported library (collection_immutable). The consumer
// dot-imports this package and exercises:
//
//   - `dirs.Get(N) match { case Foo(...) => ... }` — match-IIFE over a
//     chained-accessor result whose type comes from Array[T].Get → T,
//     where T is a sealed type defined here.
//   - `cfg.Items.Get(N).Field match { ... }` — match over a deep chain
//     ending at an `Immutable[Option[T]]` field.
//   - `Eq(t, x.Get(N).Field, "lit")` — literal lift through chained
//     accessors that return `Immutable[string]`.
//   - `.Size()` / `.IsDefined()` / `.GetOrElse(...)` on chained
//     accessors that return `Immutable[Array[T]]` / `Immutable[Option[T]]`.
//
// All of these failed when the on-disk analyzer cache was poisoned
// with a pre-merge pkgAST for this package — the consumer would load
// only the local types and miss `collection_immutable.Array`'s method
// metadata, falling back to the receiver type for `dirs.Get(0)` and
// then typing match subjects as `Array[Directive]` instead of
// `Directive`. The fix invalidates that cache when the gala compiler
// binary itself changes.

sealed type Directive {
    case Dispatch(Target string, Body string)
    case Summary(Body string)
}

// Parse synthesises a fixed sequence of directives. The two-Dispatch
// shape exercises Array.Get(0) / Array.Get(1) returning `Directive`,
// the consumer's match arms then bind `target` and `body`.
func Parse(msg string) Array[Directive] = ArrayOf(
    Dispatch(Target = "first",  Body = msg),
    Dispatch(Target = "second", Body = msg),
)

// Member is a struct whose Model field is `Option[string]`. The
// consumer reaches it via `cfg.Members.Get(N).Model.IsDefined()` —
// a 3-deep chain (Cfg → Array[Member] → Member → Option[string]).
struct Member(
    Name  string,
    Model Option[string],
)

// Hook holds an Array[string]. The consumer reaches `.Args.Size()`
// via `cfg.Hooks.Get(0).Args.Size()` to exercise method dispatch on
// `Immutable[Array[string]]`.
struct Hook(
    Name string,
    Cmd  string,
    Args Array[string],
)

// Cfg is the top-level container the consumer pulls everything from.
// Members → Array[Member]; Hooks → Array[Hook]; Lead → Member (3-deep
// chain via Cfg → Array[Cfg] → Cfg → Member → field).
struct Cfg(
    Members Array[Member],
    Hooks   Array[Hook],
    Lead    Member,
)

// SampleCfg builds a fixture Cfg with mixed `None` / `Some` members
// and a hook with no args. The consumer test driver matches against
// this exact shape.
func SampleCfg() Cfg = Cfg(
    Members = ArrayOf(
        Member(Name = "Iris",  Model = None[string]()),
        Member(Name = "Felix", Model = Some("opus-4")),
    ),
    Hooks = ArrayOf(
        Hook(Name = "lint", Cmd = "go", Args = EmptyArray[string]()),
    ),
    Lead = Member(Name = "Theo", Model = Some("sonnet-4")),
)

// SampleCfgs returns an Array[Cfg] so the consumer can exercise the
// 3-deep chain `cfgs.Get(N).Lead.Name` (returns `Immutable[string]`).
func SampleCfgs() Array[Cfg] = ArrayOf(SampleCfg(), SampleCfg())
-- examples/multifile_lib_regress/events_pipe.gala --
package multifile_lib_regress

import . "martianoff/gala/collection_immutable"

// --- Regression: generic-method lambda over a Go-declared local element type ---
// Event and MakeEvents are declared in events.go in this same package. When the
// transpiler analyzed the GALA file alone, it never scanned events.go, so the
// type of `arr` collapsed to Array[T] and FoldLeft/Map/Filter/Find/Exists/ForAll
// lambdas emitted `e T` as the parameter type instead of `e Event`.

func EventStatusSum() int {
    val arr = ArrayFromSlice(MakeEvents())
    return arr.FoldLeft(0, (acc, e) => acc + e.Status)
}

func EventStatuses() Array[int] {
    val arr = ArrayFromSlice(MakeEvents())
    return arr.Map((e) => e.Status)
}

func EventOkCount() int {
    val arr = ArrayFromSlice(MakeEvents())
    return arr.Filter((e) => e.Status < 400).Length()
}

func EventFirstGet() Option[int] {
    val arr = ArrayFromSlice(MakeEvents())
    return arr.Find((e) => e.Method == "GET").Map((e) => e.Status)
}

func EventAnyError() bool {
    val arr = ArrayFromSlice(MakeEvents())
    return arr.Exists((e) => e.Status >= 500)
}

func EventAllPositive() bool {
    val arr = ArrayFromSlice(MakeEvents())
    return arr.ForAll((e) => e.Status > 0)
}

// Nested generic case: chain Filter -> Map -> FoldLeft. Each lambda binds its
// element type from the receiver carrying the Go-declared element type.
func EventOkSum() int {
    val arr = ArrayFromSlice(MakeEvents())
    return arr.Filter((e) => e.Status < 400).Map((e) => e.Status).FoldLeft(0, (acc, n) => acc + n)
}
-- examples/multifile_lib_regress/generic_funcref.gala --
package multifile_lib_regress

// Regression: a bare reference to a same-package GENERIC function in a NAMED
// package. Function metadata of a named package is keyed "pkg.Name" (only
// `main` and `test` use bare names), so a lookup by the bare identifier missed
// it: the function's type parameter was never instantiated, Map's result type
// parameter stayed unbound, and its sentinel leaked into the generated Go as
// soon as the chained lambda had to write the element type down.

import . "martianoff/gala/collection_immutable"

func echoValue[T any](x T) T = x

// MapEchoSizes passes echoValue as a value, then consumes Map's result with a
// lambda whose parameter type must be concrete.
func MapEchoSizes(items Array[string]) Array[int] =
    items.Map(echoValue).Map((s) => s.Size())

// FlattenSizes passes a DOT-IMPORTED generic function (collection_immutable's
// Flatten, keyed "collection_immutable.Flatten") as a value. It must be
// instantiated the same way as a same-package one.
func FlattenSizes(lists Array[List[List[int]]]) Array[int] =
    lists.Map(Flatten).Map((l) => l.Size())
-- examples/multifile_lib_regress/generic_sealed.gala --
package multifile_lib_regress

// Generic sealed types whose match subject's type is INFERRED from a variant
// constructor rather than declared, exercised through the multi-file
// BatchAnalyzer path.
//
// The subject's type comes from the variant companion's `Apply` return type. A
// package-qualified base name there only resolves when the qualifier is also
// the registry key — true for a named package like this one, but not for
// `main`/`test`, whose types are registered unqualified. Batch analysis merges
// sibling metadata on a different route than single-file analysis, so the
// named-package direction is worth pinning too: it is what proves the fix did
// not simply drop the qualifier everywhere.

sealed type Reply[T any] {
    case Answered(Body T)
    case Silent
}

sealed type Outcome[A any, B any] {
    case Ok(Value A)
    case Bad(Err B)
}

// Subject type inferred from the constructor.
func InferredReply() string {
    val r = Answered("hi")
    return r match {
        case Answered(b) => s"reply-answered $b"
        case Silent()    => "reply-silent"
    }
}

func InferredSilent() string {
    val r = Silent[string]()
    return r match {
        case Answered(b) => s"reply-answered $b"
        case Silent()    => "reply-silent"
    }
}

// Declared parameter type — the control that always worked.
func DescribeReply(r Reply[int]) string = r match {
    case Answered(b) => s"reply-int $b"
    case Silent()    => "reply-silent"
}

func MakeAnsweredInt(v int) Reply[int] = Answered(v)

// Two type parameters.
func InferredOutcome() string {
    val o = Ok[int, string](3)
    return o match {
        case Ok(v)  => s"outcome-ok $v"
        case Bad(e) => s"outcome-bad $e"
    }
}

func DescribeOutcome(o Outcome[int, string]) string = o match {
    case Ok(v)  => s"outcome-ok $v"
    case Bad(e) => s"outcome-bad $e"
}

func MakeBad(e string) Outcome[int, string] = Bad(e)
-- examples/multifile_lib_regress/go_interop.gala --
package multifile_lib_regress

import (
    "martianoff/gala/examples/go_struct_bridge"
    "martianoff/gala/go_interop"
    . "martianoff/gala/std"
)

// --- Regression: Go struct named-arg wraps fields in Immutable ---
// When a GALA struct and a Go struct share the same name (Cookie), the transpiler
// must use the package qualifier to distinguish them:
//   Cookie(Name = "x")              → local GALA Cookie → Immutable wrapping
//   go_struct_bridge.Cookie(Name = "x") → Go Cookie     → plain Go literal

// GALA struct named Cookie — same name as go_struct_bridge.Cookie
struct Cookie(Name string, Value string, Path string, Secure bool)

// Construct a GALA Cookie (should wrap in Immutable — correct)
func MakeGalaCookie(name string, value string) Cookie =
    Cookie(Name = name, Value = value, Path = "/", Secure = false)

// Construct a Go Cookie using qualified name (should NOT wrap in Immutable)
func MakeGoCookie(name string, value string) go_struct_bridge.Cookie =
    go_struct_bridge.Cookie(Name = name, Value = value, Path = "/")

func GoCookieString(name string, value string) string =
    MakeGoCookie(name, value).String()

func GalaCookieName(name string, value string) string =
    MakeGalaCookie(name, value).Name

// --- Regression: method call on Go struct's func-typed field (issue #326).
// `p.Process(42)` where Process is `func(int) (string, error)` must infer
// the call's return type from the field's declared results. Without the
// fix the call's return type collapsed to NilType, and the multi-return
// destructure `var s, err = p.Process(x)` produced untyped slots that Go
// then rejected at the consumer site (string concat, error nil-check).
func ProcessorRun(x int) string {
    val p = go_struct_bridge.NewProcessor()
    var s, err = p.Process(x)
    if err != nil { return "<error>" }
    return s
}

// Single-return shape that exercises GALA-level method dispatch on the
// call's result: `.Build(s)` returns a Go Cookie, and `.String()` is
// resolved against that Cookie's Go method set. With NilType leaking as
// the call's result type the second-stage method lookup has no receiver
// type to consult and the transpiler can't synthesise the chained call.
func CookieBuilderDescribe(s string) string {
    val b = go_struct_bridge.NewCookieBuilder()
    return b.Build(s).String()
}

// Wrapping the call result in Some(...) exercises GALA-level generic
// inference: the function's declared return is Option[Cookie], so
// `Some(b.Build(s))` must infer T=Cookie from the argument. Without the
// fix the call typed as NilType, Some inferred T=NilType, and the result
// failed to satisfy the declared Option[Cookie] return type.
func CookieBuilderOption(s string) Option[go_struct_bridge.Cookie] {
    val b = go_struct_bridge.NewCookieBuilder()
    return Some(b.Build(s))
}

// --- Regression: a lambda over a Go GENERIC call must be annotated with the
// callee's instantiated return type, not its declared one.
//
// `go_interop.MapPut[K, V](m map[K]V, k K, v V) map[K]V` and
// `go_interop.SliceAppend[T](s []T, v T) []T` are Go generics. A direct call
// hides the defect (nothing forces the type into the output), but a lambda has
// to write its result clause down — and the transpiler used to emit the
// declared `map[K]V` / `[]T`, producing Go that referenced the callee's own
// type parameters as undefined identifiers.
//
// This lives in the multi-file library because the batch (BatchAnalyzer) path
// resolves Go signatures through the on-disk analysis cache rather than a fresh
// go/types run, so the type-parameter names have to survive serialization too.
func GoGenericLambdaMapSize(key string, value int) int {
    val m = go_interop.MapEmpty[string, int]()
    val put = () => go_interop.MapPut(m, key, value)
    return go_interop.MapLen(put())
}

func GoGenericLambdaSliceSize(extra int) int {
    val xs = go_interop.SliceOf(1, 2, 3)
    val appended = () => go_interop.SliceAppend(xs, extra)
    return appended().Size()
}

// Routing the same shape through a generic combinator: `A` binds to the
// lambda's result, so the lambda's own annotation is what must be concrete.
func GoGenericLambdaViaCombinator(extra int) int {
    val xs = go_interop.SliceOf(1, 2)
    return applyThunk(() => go_interop.SliceAppend(xs, extra)).Size()
}

func applyThunk[A any](body func() A) A = body()

// --- Regression: a Go generic whose return type is a GALA type.
//
// `go_interop.OptionFromMap[K, V](m map[K]V, key K) std.Option[V]` is the only
// go_interop function returning a GALA std sealed type. `std.Option` exists as Go
// only after the std package is transpiled, but the analyzer type-checks
// hand-written .go against the UN-transpiled tree, so go/types resolved that
// return to Invalid. The transpiler then wrote go/types' display string for it
// into the lambda's result clause — `func() invalid type` — which is not even
// parseable Go, so the build aborted with an internal error naming no user
// construct.
//
// The recovered type must be a genuine Option[int]: matching over the result and
// binding `v` proves the type argument survived, not just that the file compiled.
func GoGenericOptionLambda(key string) string {
    val m = go_interop.MapPut(go_interop.MapEmpty[string, int](), "k", 7)
    val look = () => go_interop.OptionFromMap(m, key)
    return applyThunk(look) match {
        case Some(v) => s"found ${v}"
        case None()  => "absent"
    }
}

// --- Regression: destructuring a Go generic's MULTI-VALUE return.
//
// `go_interop.MapGet[K, V](m map[K]V, k K) (V, bool)` binds two names at once.
// The binding used to take the callee's DECLARED return types, so `v` was typed
// `V` — a type parameter that exists only inside the callee's signature. The
// binding itself never complained and any use that does not pin a type kept
// working; the build broke wherever the value was first boxed, naming `V` at a
// line that was not the cause.
//
// Batch mode matters here for the same reason as the lambda case above: the
// signature (and its type-parameter names) is rehydrated from the analysis
// cache rather than a fresh go/types run.
func GoGenericDestructureOption(key string) string {
    val m = go_interop.MapPut(go_interop.MapEmpty[string, int](), "k", 7)
    val v, ok = go_interop.MapGet(m, key)
    return When(ok, v) match {
        case Some(n) => s"found ${n}"
        case None()  => "absent"
    }
}

// Same binding, reached through a struct field rather than a local, and boxed
// directly with Some rather than through When.
func GoGenericDestructureFromField(key string) Option[int] {
    val idx = GoMapIndex{entries: go_interop.MapPut(go_interop.MapEmpty[string, int](), "k", 7)}
    val v, ok = go_interop.MapGet(idx.entries, key)
    if ok {
        return Some(v)
    }
    return None[int]()
}

type GoMapIndex struct {
    entries map[string]int
}
-- examples/multifile_lib_regress/logic.gala --
package multifile_lib_regress

import (
    "errors"
    "time"
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/go_struct_bridge"
)

// --- Regression: if-expression with non-primitive generic return type ---
// Uses Go multi-return method call followed by if-expression,
// mirroring gala-server's `val t, ok = r.bridge.ContextDeadline()`

func DeadlineFromString(s string) Option[time.Time] {
    var t, err = time.Parse(time.RFC3339, s)
    val ok = err == nil
    return if (ok) Some(t) else None[time.Time]()
}

func CountIfPositive(n int) Option[int] {
    val ok = n > 0
    return if (ok) Some(n) else None[int]()
}

func SessionValueIfExists(session *go_struct_bridge.SessionData, key string) Option[string] {
    var v, found = session.Get(key)
    return if (found) Some(v) else None[string]()
}

// --- Regression: When[T] inside generic lambda generates undefined: T ---
// Mirrors gala-server's SessionGet: FlatMap with Go method call inside lambda.

// NOTE: When inside FlatMap with Go pointer type param (*SessionData) is a known
// remaining edge case — the current fix handles GALA types but not Go pointer types.
// Verified against gala-server. Using workaround here:
func SessionLookup(session *go_struct_bridge.SessionData, key string) Option[string] {
    var v, found = session.Get(key)
    if found { return Some(v) }
    return None[string]()
}

func LookupSimple(key string) Option[string] {
    val opt = Some("session-data")
    return opt.FlatMap((data) => {
        val found = key != ""
        val v = s"value-for-$key"
        return When(found, v)
    })
}

// Use Array from collection_immutable to exercise cross-package type resolution
func UserNames() Array[string] = ArrayOf("alice", "bob", "charlie")

// --- Regression: lambda with multi-statement block body in generic Map[U] ---
// The trailing struct literal should be the lambda's implicit return value
// and U must be inferred to LabeledCell. Previously the block lambda was
// emitted as void (`func(...) { Cell{...} }`) which broke generic inference
// in batch transpile.
struct LabeledCell(Width int, Label string)

func BuildLabeledCells(headers Array[string], widths Array[int]) Array[LabeledCell] {
    return headers.ZipWithIndex().Map((pair) => {
        val w = if (pair.V2 < widths.Length()) widths.Get(pair.V2) else 0
        LabeledCell(Width = w, Label = pair.V1)
    })
}

// --- Regression: val-bound trailing identifier in Map / FlatMap block lambda ---
// The trailing `result` identifier must be promoted to a return statement
// even when its static type compiles down to `result.Get()` on an Immutable
// wrapper (which made the original type-name gate too conservative).
func DoubleEach(xs Array[int]) Array[int] {
    return xs.Map((x) => {
        val doubled = x * 2
        doubled
    })
}

func ExpandPairs(xs Array[int]) Array[int] {
    return xs.FlatMap((x) => {
        val pair = ArrayOf(x, x * 10)
        pair
    })
}

// --- Regression: positional Tuple constructor must infer type args ---
// `Tuple(a, b)` and `Tuple(a, b, c)` (no explicit type args, no named-arg
// form) previously emitted bare `std.Tuple{V1, V2}` literals — Go rejected
// these as "cannot use generic type without instantiation". The 3-arity
// form additionally lost its third arg because the Tuple→TupleN arity
// rewrite was missing on this path.
func MakeFlagPair(flag bool, label string) Tuple[bool, string] = Tuple(flag, label)

func MakeTriple(n int, label string, ratio float64) Tuple3[int, string, float64] =
    Tuple(n, label, ratio)

// --- Regression: tuple literal as call argument inherits element types from
// the call-site's expected parameter type (bidirectional inference).
// Without this the `(name, err)` literal had its first element collapse to
// `any` because `getExprTypeName` of the val-bound `name` did not resolve
// to a concrete `string` from the call-site context, and Append was rejected
// with `cannot use Tuple[any, error] as Tuple[string, error]`.
func CollectFailures(names Array[string]) Array[Tuple[string, error]] {
    var failures = EmptyArray[Tuple[string, error]]()
    names.ForEach((name) => {
        val err = NoSuchElement(s"failed-$name")
        failures = failures.Append((name, err))
    })
    return failures
}

// --- Regression: expression-bodied if-expression inside Map lambda whose
// arms reference methods on a user-defined generic type. HM type inference
// can't model methods on generics (env only carries top-level functions
// and current-scope vals), so the if-expression's IIFE return type must
// fall back to per-branch inference. Both arms are State[T], so the lambda
// must emit `func(State[T]) State[T]` rather than widening to `any`.
struct State[T any](Tag string, Make func() T)

func (s State[T]) Advance() State[T] = State[T](Tag = "armed", Make = s.Make)
func (s State[T]) IsDue() bool = s.Tag == "due"

func DispatchStates[T any](items Array[State[T]]) Array[State[T]] {
    return items.Map((it) => if (it.IsDue()) it.Advance() else it)
}

// --- Regression: expression-bodied if-expression inside Map lambda over a
// generic element type. Both arms return T, so the lambda's inferred return
// type must be T (and Map's U must be inferred to T). Previously the
// if-expression's IIFE return type was widened to `any` and the result
// became Array[any], breaking downstream Array[T] use sites.
func IfMapEcho[T any](items Array[T], pred func(T) bool, advance func(T) T) Array[T] {
    return items.Map((it) => if (pred(it)) advance(it) else it)
}

// --- Regression: downward inference of generic sealed-type case constructors.
// `NoCmd()` and `QuitCmd()` should resolve their type parameter from the
// enclosing context (val with explicit type, function return type, function
// argument expected type, container element type, match arm result type).
// Without inference these constructors emit uninstantiated `NoCmd{}.Apply()`
// literals which Go rejects with "cannot use generic type without
// instantiation".
sealed type Effect[T any] {
    case NoEffect()
    case Halt()
    case Yield(Value T)
}

// Context (1): val with explicit type drives downward inference.
val effectOne Effect[int] = NoEffect()

// Context (2): function return type drives downward inference.
func makeHalt() Effect[string] = Halt()

// Context (3): argument expected type drives downward inference.
func runEffect(e Effect[int]) string = e match {
    case NoEffect() => "noop"
    case Halt() => "halt"
    case Yield(_) => "yield"
}

func runDefaultNoEffect() string = runEffect(NoEffect())

// Context (4): container element type drives downward inference.
func defaultEffects() Array[Effect[int]] =
    ArrayOf[Effect[int]](NoEffect(), Halt(), Yield(7))

// Context (5): match arm result drives downward inference.
func selectEffect(n int) Effect[int] = n match {
    case 0 => NoEffect()
    case 1 => Halt()
    case _ => Yield(n)
}

// --- Regression: statement-position match with mixed value/void arms ---
// Lint suggested rewriting an explicit `if/else if/else` chain as a
// `match { ... }` used as a *statement* (its value discarded). When one
// arm called a function returning a typed value (e.g. bool from a Go
// method) and another arm called a void-returning function, the
// generated IIFE inherited the typed return type and the void arm was
// emitted as `return d.Skip()` — Go rejects that with "no value used as
// value". The fix lowers the IIFE as void in statement position so the
// void arms are emitted as bare expression statements.

func emitInfo() bool {
    Println("info")
    return true
}

func emitWarn() {
    Println("warn")
}

// EmitLevel uses match as a statement with mixed value/void arms.
// `info` arm calls a value-returning function; `warn` arm calls a void
// function; default arm is an assignment (statement). The match value
// is discarded — only the side effects matter.
func EmitLevel(level string) int {
    var unhandled = 0
    level match {
        case "info" => emitInfo()
        case "warn" => emitWarn()
        case _      => unhandled = unhandled + 1
    }
    return unhandled
}

// --- Regression: void-arm match terminating a lambda body inferred as
// value-returning lowered to `return <void-IIFE>`, producing Go's
// "(no value) used as value" error. The lambda is the trailing
// expression of `MakeProcessor`'s `return` statement; that path does
// not propagate an expected lambda return type, so the lambda's
// return type was inferred from its body. With every match arm void,
// the void IIFE was promoted to a return statement — invalid Go.
//
// The fix: void IIFEs are NOT promoted to `return` statements at the
// trailing position of a value-inferred lambda body; the lambda's
// inferred return type is left as void. Multi-file BatchAnalyzer path
// exercises the bug under cross-package import resolution, which the
// single-file fixture wouldn't otherwise verify.
struct ProcMember(Name string)

func ProcOutcome(m ProcMember) Try[bool] {
    if m.Name == "bad" {
        return Failure[bool](errors.New("oops"))
    }
    return Success[bool](true)
}

func MakeProcessor() func(ProcMember) {
    var counter = 0
    return (m ProcMember) => {
        ProcOutcome(m) match {
            case Success(_)   => counter = counter + 1
            case Failure(err) => Println(s"err: ${err.Error()}")
        }
    }
}

// --- Regression: two-param lambda passed to HashMap[K, V].ForEachKV must
// bind both K and V from the receiver's type arguments. Without the fix,
// the lambda's `(name, m)` parameters were inferred as (any, any), and the
// next call expecting a concrete Member value rejected the `any`-typed v
// with "cannot use m (variable of interface type any) as Member value in
// argument to memberKey: need type assertion".
struct Member(Name string, Email string)

// memberKey takes a concrete Member by value (not any). This call only
// compiles when the lambda binds v to V=Member.
func memberKey(m Member) string = s"${m.Name}<${m.Email}>"

func MembersByName(members HashMap[string, Member]) Array[string] {
    var out = EmptyArray[string]()
    members.ForEachKV((name, m) => {
        // `name` must be string (key type), `m` must be Member (value type).
        // Concatenate name with a member-derived string to exercise both.
        out = out.Append(s"$name => ${memberKey(m)}")
    })
    return out
}

// HashMap whose value type is a Go-declared struct (Event from events.go).
// The two-param lambda must bind `e` to the Go type Event, not any, so
// that field access `e.Status` compiles.
func EventStatusByMethod(events HashMap[string, Event]) Array[int] {
    var out = EmptyArray[int]()
    events.ForEachKV((m, e) => {
        // m: string, e: Event — accessing .Status only compiles when the
        // value type plumbed through to the lambda.
        out = out.Append(e.Status)
    })
    return out.Sorted()
}

// Two-param lambda whose body is a single statement-position match —
// mirrors the original failing shape from the bug report. The lambda
// must still bind v to V=Member.
sealed type CloseResult { case Closed() case CloseFailed(Err string) }

func tryClose(m Member) CloseResult = Closed()

func CloseAllMembers(members HashMap[string, Member]) Array[string] {
    var failures = EmptyArray[string]()
    members.ForEachKV((name, m) => {
        tryClose(m) match {
            case Closed()        => {}
            case CloseFailed(_)  => failures = failures.Append(s"$name=${memberKey(m)}")
        }
    })
    return failures.Sorted()
}

// --- Regression: reassigning `Some(...)` to an Option[T] var must propagate
// the LHS variable's declared type-arg into the RHS sealed-variant
// constructor so the variant is emitted as `Some[T]{}.Apply(...)` (not the
// uninstantiated `Some{}.Apply(...)` which Go rejects).
//
// Mirrors the gala-server runtime-error fallback shape: an Option[string]
// var is initialised from a cross-package mapping and later reassigned
// inside a loop. Without LHS-type propagation, the per-iteration `Some(...)`
// erases to Some[any] and downstream uses of `failure` (passed to a function
// expecting Option[string]) fail Go compile.
func RuntimeFailure(seeds Array[string], cap int) Option[string] {
    val onbErr Option[error] = Some[error](errors.New("seed missing"))
    var failure = onbErr.Map((e) => s"onboarding: ${e.Error()}")
    var i = 0
    seeds.ForEach((s) => {
        if i < cap {
            failure = Some(s"runtime[$i]: $s")
        }
        i = i + 1
    })
    return failure
}

// --- Regression: nested sealed-case pattern inside Success(...) inside a
// returned-lambda whose parameter type is implicit (driven by the enclosing
// function's `func(Try[Msg]) string` return type). Without expected-param
// propagation through the `return` statement, the lambda's `t` parameter
// dropped to `any` and the match's matched type degraded to `Try[any]`.
// Then `Success.Unapply(obj)` returned `any`, the inner `WireChunk.Unapply`
// required `WireMsg`, and Go rejected with "need type assertion".
sealed type WireMsg {
    case WireChunk(Index int, Line string)
    case WireSessionFailed(Index int, Err string)
    case WireOther
}

func MakeWireHandler() func(Try[WireMsg]) string {
    return (t) => t match {
        case Failure(err) => s"fail: ${err.Error()}"
        case Success(WireChunk(_, line)) => s"chunk: $line"
        case Success(WireSessionFailed(_, e))   => s"sessfail: $e"
        case _ => "other"
    }
}

// --- Regression: if-expression with both arms producing s-string
// interpolations must lower to `func() string { ... }()`, not
// `func() any { ... }()`. The if-expression sits in `var` initialiser
// position (not a return), which exercises the IIFE-typing fallback
// path. The lowered `fmt.Sprintf` CallExpr's return type was not
// recognised as `string` by the per-branch type oracle, so the IIFE
// widened to `func() any` and the consumer of `label` (here
// TextStyled, which expects a concrete `string`) failed to compile.
struct LabelStyle(Color string)

func TextStyled(label string, style LabelStyle) string =
    s"[${style.Color}] $label"

func RenderRow(isCursor bool, glyph string, name string) string {
    val label = if (isCursor) s">> $glyph $name" else s"   $glyph $name"
    val style = LabelStyle(Color = "blue")
    return TextStyled(label, style)
}

// --- Regression: sealed-case → sealed-parent widening inside a tuple-typed
// match-arm result. When a function returns `Tuple[A, Cmd[T]]`, one match
// arm produces `(a, MsgCmd[T](...))` (sealed CASE constructor in slot 2)
// and another produces `(a, otherCmdReturningFunc())` (sealed PARENT). The
// transpiler must widen the case to the parent so both arms agree on the
// declared `Tuple[A, Cmd[T]]`. Without widening the transpiler rejected the
// match with a "type mismatch" error even though every value of the case
// type is a value of the parent type via the case's Apply method.
sealed type DispatchMsg {
    case TickMsg()
    case FailMsg(Reason string)
}

sealed type DispatchCmd[T any] {
    case NoDispatch()
    case SendDispatch(Payload T)
}

struct DispatchModel(Counter int)

// dispatchParent returns the sealed PARENT type DispatchCmd[DispatchMsg].
func dispatchParent(seed string) DispatchCmd[DispatchMsg] = NoDispatch[DispatchMsg]()

// dispatchByOutcome: arm 1's tuple slot 2 is bound to the sealed CASE via a
// val whose RHS is a sealed-case constructor; arm 2's slot 2 is the sealed
// PARENT from a function returning the parent. Both arms unify to the
// declared return Tuple[DispatchModel, DispatchCmd[DispatchMsg]].
func DispatchByOutcome(outcome Try[string]) Tuple[DispatchModel, DispatchCmd[DispatchMsg]] {
    return outcome match {
        case Failure(e) => {
            val cmd = SendDispatch[DispatchMsg](Payload = FailMsg(Reason = e.Error()))
            return (DispatchModel(Counter = 1), cmd)
        }
        case Success(s) => {
            return (DispatchModel(Counter = 2), dispatchParent(s))
        }
    }
}

// --- Regression: bare T literal lift to Immutable[T] at val-param sites.
// MatchPolicyName takes a `val expected string` parameter (so the Go
// signature is `expected std.Immutable[string]`). Calling it with a bare
// string literal must lift the literal to NewImmutable[string] — Go
// rejects "cannot use \"notify\" (untyped string constant) as
// std.Immutable[string] value" without that promotion.
func MatchPolicyName(val expected string, val actual string) bool = expected == actual

func PolicyMatches(name string) bool = MatchPolicyName("notify", name)
-- examples/multifile_lib_regress/lowercase_variant_match.gala --
package multifile_lib_regress

// Matches over `signal` (lowercase_variant_types.gala). The lowercase variants
// count towards exhaustiveness — there is no default arm — and the bare
// `stop`/`pause` arms match their variants rather than binding a variable.

func describeSignal(s signal) string = s match {
    case tick(n) => s"tick $n"
    case pause => "pause"
    case stop => "stop"
}

// SignalSummary describes one value of each `signal` variant.
func SignalSummary() string =
    s"${describeSignal(tick(3))}, ${describeSignal(pause())}, ${describeSignal(stop())}"
-- examples/multifile_lib_regress/lowercase_variant_types.gala --
package multifile_lib_regress

// A sealed type with lowercase (unexported) variants, declared in one file of
// the package and matched in another (lowercase_variant_match.gala): its
// variants reach the other file only through package metadata.
sealed type signal {
    case tick(N int)
    case pause()
    case stop
}
-- examples/multifile_lib_regress/opaque_a.gala --
package multifile_lib_regress

// --- Regression: an opaque type declared in one file of a package ---
// Seat is declared here with one method; opaque_b.gala, another file of the
// package, gives it a second method, converts to it, sorts it and keys a
// HashMap by it. The type, its methods and its generated Hash / Compare must
// be one declaration across the files.

// Seat is a seat number: row times ten plus the place in the row.
opaque type Seat int

// Row is the row the seat is in.
func (s Seat) Row() int = int(s) / 10
-- examples/multifile_lib_regress/opaque_b.gala --
package multifile_lib_regress

import . "martianoff/gala/collection_immutable"

// Continuation of Seat (see opaque_a.gala), in a different file.

// Label renders the seat for display.
func (s Seat) Label() string = s"row ${s.Row()} seat ${int(s) % 10}"

// SeatOf converts a seat number.
func SeatOf(n int) Seat = Seat(n)

// SeatSummary keys a HashMap by Seat and sorts seats.
func SeatSummary() string {
    val taken = EmptyHashMap[Seat, string]().Put(Seat(12), "ada").Put(Seat(31), "bo")
    val first = ArrayOf(Seat(31), Seat(12)).Sorted().Head()
    s"${taken.Get(Seat(12)).GetOrElse("-")} ${first.Label()} ${taken.Size()}"
}
-- examples/multifile_lib_regress/pkg_name_collision.gala --
package multifile_lib_regress

// Regression: a GALA package imported by ONE file of a package must not rebind
// that package name for its SIBLING files.
//
// GALA ships packages whose names collide with Go stdlib ones — strings, io,
// path, json, crypto, fs. Function metadata is keyed by package NAME
// ("strings.SplitN") and merged across every file in a package, so once any file
// imported GALA's `strings`, a sibling file's Go `strings.SplitN` resolved
// against GALA's signature (returning Array[string]) while codegen still emitted
// the Go import (returning []string). Inference and emission disagreed, and the
// error surfaced in the innocent file naming types it never wrote.
//
// This file imports GALA's strings. Its sibling pkg_name_collision_go.gala
// imports Go's. Both must resolve to their own.

import gstr "martianoff/gala/strings"
import gtime "martianoff/gala/examples/multifile_lib_regress/time_pkg"

// GalaStringsUpper goes through GALA's strings package.
func GalaStringsUpper(s string) string = gstr.ToUpper(s)

// GalaStringsSplitSize proves GALA's SplitN returns an Array (element count via
// .Size()), which is exactly the signature that used to leak into the sibling.
func GalaStringsSplitSize(s string) int = gstr.SplitN(s, ":", 2).Size()

// GalaTimeNow calls a user GALA package named `time`; its default is injected.
func GalaTimeNow() string = gtime.Now()

// GalaTimeAfterFunc passes a lambda typed by that package's signature.
func GalaTimeAfterFunc() string = gtime.AfterFunc("tick", (s) => s + "!")

// Clock has a Now method with no parameters.
struct Clock(Label string)

// Now names the clock.
func (c Clock) Now() string = s"clock:${c.Label}"

// ShadowedTimeQualifier's parameter shadows the gtime import, so gtime.Now()
// is Clock's method: the package function's default must not be injected.
func ShadowedTimeQualifier(gtime Clock) string = gtime.Now()
-- examples/multifile_lib_regress/pkg_name_collision_go.gala --
package multifile_lib_regress

// Sibling of pkg_name_collision.gala. That file imports GALA's `strings`; this
// one imports GO's. Before the fix, the sibling's import rebound the qualifier
// package-wide and this file's strings.SplitN was typed as returning
// Array[string] instead of []string — so `parts` below became
// Array[Array[string]] and the match subject came out as an Array rather than a
// string.
//
// The match matters: the failure only surfaced where a concrete type was
// required. Assigning parts.Get(0) straight to a string return type happened to
// compile, so a weaker test would pass while the bug was live.

import . "martianoff/gala/collection_immutable"
import "strings"
import "time"

// GoStringsClassify uses GO's strings.SplitN (returns []string), spreads it into
// an Array, and matches on an element. Both the element type and the match arms
// must be string.
func GoStringsClassify(s string) string {
    val parts = ArrayOf(strings.SplitN(s, ":", 2)...)
    if parts.Size() != 2 {
        return "malformed"
    }
    return parts.Get(0) match {
        case "header" => s"header=${parts.Get(1)}"
        case "query"  => s"query=${parts.Get(1)}"
        case _        => "other"
    }
}

// GoStringsUpper is the Go-side counterpart of GalaStringsUpper, so both
// packages are exercised for the same operation in one build.
func GoStringsUpper(s string) string = strings.ToUpper(s)

// GoFieldsCounts passes GO's strings.Fields as a function VALUE rather than
// calling it. The reference's type decides Map's result type, so it must be
// Go's func(string) []string, not the signature of the GALA strings.Fields
// (func(string) Array[string]) that the sibling file imports. The chained
// lambda spreads the element, which only compiles if it is a []string.
func GoFieldsCounts(lines Array[string]) Array[int] =
    lines.Map(strings.Fields).Map((f) => ArrayOf(f...).Size())

// GoTimeNowSet calls GO's time.Now with no arguments. The sibling imports a
// GALA package named `time` whose Now has a defaulted parameter; that default
// must not be injected into this call.
func GoTimeNowSet() bool = !time.Now().IsZero()

// GoTimeAfterFuncStopped passes a zero-argument callback to GO's
// time.AfterFunc. The lambda must be typed from Go's signature (func()), not
// from the sibling's GALA AfterFunc (func(string) string).
func GoTimeAfterFuncStopped() bool = time.AfterFunc(time.Hour, () => Println("fired")).Stop()
-- examples/multifile_lib_regress/pointer_method_field.gala --
package multifile_lib_regress

// --- Regression: cross-file pointer-receiver method return field access ---
// When a method is defined with a pointer receiver in a sibling file and its
// return type has an immutable field, chained field access must auto-unwrap
// the inner Immutable[T] wrapper. Previously the method-return type
// inference bailed out for *Buffer (PointerType over non-generic named type)
// because the fallback only retried for generic receivers, leaving xType
// NilType at the .Bold access site and defeating isImmutableField.

type StyleInfo struct {
    Bold   bool
    Italic bool
}

type Canvas struct {
    Width  int
    Height int
}

func (c *Canvas) StyleAt(x int, y int) StyleInfo = StyleInfo(Bold = true, Italic = false)

func NewCanvas(w int, h int) *Canvas = &Canvas(Width = w, Height = h)

// Exposes the chained access for the regression test to call from main.
func BoldAt(c *Canvas, x int, y int) bool = c.StyleAt(x, y).Bold
-- examples/multifile_lib_regress/proc_pkg/events.gala --
package proc_pkg

import "errors"

// Sealed type whose ConsultEnd case carries an Option[error] field. This
// mirrors the original failing report (see issue #290): a sealed-type case
// constructed in a sibling package that holds Option[T] / Try[T], so that
// the pattern-bound name in a consumer file points at a generic value
// whose receiver-package metadata is not local.

sealed type ConsultEvent {
    case ConsultChunk(Name string, Line string)
    case ConsultEnd(Name string, Err Option[error])
}

// Constructors that build sample values from the cross-package side. The
// consumer pattern-matches on these and chains .Map on the Option[error]
// field — without the fix, the Map lambda's body type erases to `any`.

func MakeChunk(name string, line string) ConsultEvent =
    ConsultChunk(Name = name, Line = line)

func MakeEndOk(name string) ConsultEvent =
    ConsultEnd(Name = name, Err = None[error]())

func MakeEndErr(name string, msg string) ConsultEvent =
    ConsultEnd(Name = name, Err = Some(errors.New(msg)))
-- examples/multifile_lib_regress/proc_pkg/proc.gala --
package proc_pkg

// Sub-library imported by multifile_lib_regress to exercise the
// cross-package chained Try.FlatMap synthesis pattern. Process lives
// here; a Session wrapping it lives in multifile_lib_regress next door.
// The chained s.Proc.Kill().FlatMap((_) => s.Proc.Wait().Map((_) => true))
// must propagate the inner Try[bool] through the synthesized closure
// return type even though Process is imported from another package.

struct Process(Pid int)

func (p Process) Kill() Try[bool] = Success[bool](true)
func (p Process) Wait() Try[int]  = Success[int](0)
-- examples/multifile_lib_regress/proc_session.gala --
package multifile_lib_regress

import (
    "martianoff/gala/examples/multifile_lib_regress/proc_pkg"
)

// --- Regression: cross-package chained Try.FlatMap synthesis ---
// ProcSession wraps a Process imported from a sibling GALA package.
// The chained s.Proc.Kill().FlatMap((_) => s.Proc.Wait().Map((_) => true))
// must propagate the inner Try[bool] type argument through the synthesized
// closure return type, even though Process and its Kill()/Wait() methods
// live in proc_pkg (a different GALA package than this consumer). Without
// the fix the generated Go reads `func(_ bool) Try` instead of
// `func(_ bool) Try[bool]`, and Go rejects with
// "cannot use generic type std.Try[T any] without instantiation".

struct ProcSession(Proc proc_pkg.Process)

// FlatMap form. Generated Go must spell the outer closure return type
// as Try[bool], not bare Try.
func CloseProcSession(s ProcSession) Try[bool] =
    s.Proc.Kill().FlatMap((_) => s.Proc.Wait().Map((_) => true))

// Match-arm form. The Success arm's s.Proc.Wait().Map(...) must be
// typed as Try[bool] so both arms agree on the match result type.
func CloseProcSessionMatch(s ProcSession) Try[bool] = s.Proc.Kill() match {
    case Success(_)   => s.Proc.Wait().Map((_) => true)
    case Failure(err) => Failure[bool](err)
}

// Manual two-arm match without .Map — compiles cleanly even when the
// Map-driven forms above fail. Kept as a baseline that proves the
// surrounding plumbing is otherwise healthy.
func CloseProcSessionWorkaround(s ProcSession) Try[bool] = s.Proc.Kill() match {
    case Success(_)   => Success[bool](true)
    case Failure(err) => Failure[bool](err)
}
-- examples/multifile_lib_regress/shadow_func/shadow.gala --
package shadow_func

// Snapshot is intentionally a top-level function whose name shadows the
// `Snapshot` struct in the sibling multifile_lib_regress package. Consumers
// dot-import this package alongside the qualified import of
// multifile_lib_regress; the qualified constructor call
// `multifile_lib_regress.Snapshot(ProjectName = ...)` must resolve to the
// struct, not to this function.
func Snapshot(width int, height int) string = "tui-snap"

// ShadowMarker is a non-clashing helper used by consumers that need to refer
// to *something* exported from this package — keeps the dot-import live so
// the consumer test file actually exercises the shadow scenario.
func ShadowMarker() string = "shadow-marker"
-- examples/multifile_lib_regress/symbol_scope.gala --
package multifile_lib_regress

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/multifile_lib_regress/team_pkg"
)

// Regression coverage for the analyzer's undefined-symbol check
// (GALA-E0023), which must NOT fire on any of the resolution paths a
// multi-file package relies on. Every identifier below resolves through a
// different route, and each route is one the check could plausibly get wrong:
//
//   - NewUser / Snapshot: declared in the sibling types.gala, so they reach
//     this file only through the sibling-metadata pass;
//   - CountIfPositive: declared in the sibling logic.gala;
//   - scopePrefix / scopeSuffix: package-level `val`s in this file, read from
//     other functions (package vals live in their own metadata map, not in
//     Types or Functions);
//   - team_pkg.Team: a qualified reference through a named import;
//   - ArrayOf / Some / None: a dot import and the implicit std prelude;
//   - scopeLocalHelper / scopeDouble: declared *below* their call sites, so
//     package-level forward references must resolve;
//   - scopeLocalHelper is called from inside a lambda, and ScopeLambdaCapture's
//     lambda parameter shadows an outer `val` of the same name;
//   - every `match` arm binds names in its pattern that the arm body reads.
//
// This case only has teeth in multi-file batch transpilation
// (`--package-files`), which is why it lives here rather than in a
// single-file example.

val scopePrefix = "scope"

val scopeSuffix = "ok"

// ScopeReport exercises sibling declarations, package vals, forward
// references, dot imports and the std prelude from one expression.
func ScopeReport(n int) string {
    val user = NewUser("dana", "dana@example.com")
    val counted = CountIfPositive(n) match {
        case Some(v) => v
        case None() => 0
    }
    val labels = ArrayOf(1, 2, 3).Map((i) => scopeLocalHelper(i + counted))
    val joined = labels.MkString(",")
    return s"$scopePrefix:${user.Name}:$joined:$scopeSuffix"
}

// ScopeLambdaCapture pins the case a naive scope model gets wrong: a lambda
// parameter shadowing an outer binding of the same name, calling a
// package-level function declared further down the file.
func ScopeLambdaCapture(n int) int {
    val base = n
    val f = (base int) => scopeDouble(base)
    return f(base) + f(0)
}

// scopeDouble reads a sibling-declared function (logic.gala) through a match.
func scopeDouble(v int) int = CountIfPositive(v) match {
    case Some(x) => x * 2
    case None() => -1
}

// ScopeQualifiedImport reads a symbol from a named-imported subpackage.
func ScopeQualifiedImport(name string) string =
    team_pkg.Team(Key = "k", Name = name).Name

// ScopeSnapshotLabel constructs a sibling-declared struct and reads a
// package-level val from this file in the same expression.
//
// SavedAt is declared int64, and the conversion around the literal is
// required: a named-argument struct construction does not currently widen an
// untyped integer literal to the field's declared width, so a bare `7` fails
// to compile here. Keep the explicit `int64(...)` until that widening lands.
func ScopeSnapshotLabel() string {
    val snap = Snapshot(ProjectName = scopePrefix, SavedAt = int64(7))
    return s"${snap.ProjectName}-${snap.SavedAt}-$scopeSuffix"
}

// Declared after every use above on purpose.
func scopeLocalHelper(v int) string = s"v$v"
-- examples/multifile_lib_regress/team_lookup.gala --
package multifile_lib_regress

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/multifile_lib_regress/team_pkg"
    . "martianoff/gala/examples/multifile_lib_regress/team_pkg"
)

// --- Regression: cross-package struct field auto-unwrap in equality ---
// FindTeamByKey is the gala_team consult dispatch shape: a lambda compares
// a struct field (`t.Key`) against a value, where the struct is defined
// in a *different* GALA package (team_pkg) than the comparison site.
// Same-package transpilation correctly inserts `.Get()` on the field;
// cross-package previously emitted `Immutable[T] == T` (Go reject).

func FindTeamByKey(teams Array[team_pkg.Team], key string) Option[team_pkg.Team] =
    teams.Find((t) => t.Key == key)

// Same shape but using dot-imported name (qualifier-free).
func FindTeamByKeyDotImport(teams Array[Team], key string) Option[Team] =
    teams.Find((t) => t.Key == key)

// Variant using a Go-style explicit lambda parameter type.
func FindTeamByKeyTypedLambda(teams Array[team_pkg.Team], key string) Option[team_pkg.Team] =
    teams.Find((t team_pkg.Team) => t.Key == key)
-- examples/multifile_lib_regress/team_pkg/team.gala --
package team_pkg

// Team is a simple struct used to verify cross-package struct field
// auto-unwrap in equality comparisons (see team_lookup.gala).
struct Team(val Key string, val Name string)
-- examples/multifile_lib_regress/time_pkg/time.gala --
package time

// A GALA package whose NAME collides with Go's `time`. Only
// pkg_name_collision.gala imports it; its sibling pkg_name_collision_go.gala
// calls Go's `time` and must not see these signatures.

// Now has a defaulted parameter that Go's time.Now does not have.
func Now(zone string = "UTC") string = s"now@$zone"

// AfterFunc takes a callback whose shape differs from Go's time.AfterFunc.
func AfterFunc(label string, f func(string) string) string = f(label)
-- examples/multifile_lib_regress/tuple_vals_a.gala --
package multifile_lib_regress

// Package-level declarations that need generated temps, in two files of one
// package (tuple_vals_b.gala is the other). Each file's temps must have their
// own names: the package is one Go scope.

import "strings"

// TupleHost and TuplePort are the host and port of the address.
val (TupleHost, TuplePort) = ("localhost", 8080)

// Only tupleHits changes; the pair is a `var` to cover `var (...)` too.
var (tupleHits, tupleMisses) = (0, 0)

val cutKey, cutValue, cutKeyFound = strings.Cut("mode=fast", "=")

// TupleRecordHit counts a hit in the package-level `var` pair.
func TupleRecordHit() {
    tupleHits = tupleHits + 1
}

// TupleAddress joins the pairs destructured in both files.
func TupleAddress() string = s"$TupleScheme://$TupleHost:$TuplePort$TuplePath hits=$tupleHits misses=$tupleMisses"

// TupleCuts joins the multi-value Go results bound in both files.
func TupleCuts() string = s"$cutKey=$cutValue $cutKeyFound $cutHost $cutHostFound"
-- examples/multifile_lib_regress/tuple_vals_b.gala --
package multifile_lib_regress

// The second file of the tuple_vals_a.gala pair.

import "strings"

// TupleScheme and TuplePath are the scheme and path of the address.
val (TupleScheme, _, TuplePath) = ("http", 0, "/api")

val cutHost, _, cutHostFound = strings.Cut("db:5432", ":")
-- examples/multifile_lib_regress/types.gala --
package multifile_lib_regress

import "time"

// Second file in package to force multi-file batch transpilation.
// Several bugs only manifest with --package-files.

type UserInfo struct {
    Name  string
    Email string
}

func NewUser(name string, email string) UserInfo = UserInfo(Name = name, Email = email)

// Snapshot exists ALSO as a function in the sibling shadow_func package below.
// At call sites that import the shadow_func package via dot-import, the
// qualified `multifile_lib_regress.Snapshot(Field = ...)` constructor must
// resolve to this struct — not silently match the dot-imported function and
// emit "unknown parameter" errors. Verifies the qualifier-anchored resolution
// path.
struct Snapshot(ProjectName string, SavedAt int64)

// Untyped numeric literals initialising immutable (`val`) fields must adopt
// the field's declared type instead of the literal's own default type (`int`).
// The immutable field is stored as `Immutable[T]`, so an `Immutable[int]`
// wrapper is not assignable to an `Immutable[int64]` field and the generated
// Go fails to compile. Batch transpilation resolves the field types from
// sibling/imported metadata rather than the current file, so each construction
// spelling is exercised here and again from the consumer package.
struct Reading(Label string, TakenAtMs int64, Port uint32, Ratio float64, Tag byte)

func NewReadingPositional(label string) Reading = Reading(label, 0, 8080, 1, 7)

func NewReadingNamed(label string) Reading =
    Reading(Label = label, TakenAtMs = 60 * 1000, Port = 9090, Ratio = 0.5, Tag = 8)

func NewReadingComposite(label string) Reading =
    Reading{Label: label, TakenAtMs: -2, Port: 443, Ratio: 2, Tag: 9}

func DescribeReading(r Reading) string =
    s"${r.Label}/${r.TakenAtMs}/${r.Port}/${r.Ratio}/${r.Tag}"

// time.Parse is a Go function returning (time.Time, error)
-- examples/multifile_lib_regress/var_field_match.gala --
package multifile_lib_regress

// Matches Caret, declared in var_field_types.gala: only the non-`var` Col may
// be unwrapped with `.Get()`; the `var` Line is read as a plain field.
func DescribeCaret(c Caret) string = c match {
    case Caret(0, col) => s"caret-top col $col"
    case Caret(line, col) if line == col => s"caret-diagonal $line"
    case Caret(line, col) => s"caret $line:$col"
    case _ => "caret-unreachable"
}

func CaretAt(line int, col int) Caret = Caret(line, col)
-- examples/multifile_lib_regress/var_field_types.gala --
package multifile_lib_regress

// A struct mixing a `var` field (a plain Go field) with a non-`var` one (a
// std.Immutable[T]). It is matched in var_field_match.gala, a sibling file, so
// the pattern lowering has to read each field's mutability from package
// metadata rather than from the declaration in the file being transformed.
struct Caret(var Line int, Col int)
-- examples/multifile_lib_regress/variant_pkg/variant.gala --
package variant_pkg

// Sealed types whose zero-field variants are matched with the bare form from
// ANOTHER package (the consumer dot-imports this one). Variant metadata for an
// imported sealed type is resolved through the import graph rather than from
// the file being transformed, so the bare-identifier lowering has to work off
// the matched type's metadata rather than anything local to the match.

// Generic parent — the zero-field variant's companion carries a type parameter
// that must be recovered from the matched type.
sealed type Slot[T any] {
    case Holds(Value T)
    case Vacant
}

// Non-generic control.
sealed type Flag {
    case On(Label string)
    case Off
}

func MakeSlot(v string) Slot[string] = Holds(v)

func EmptySlot() Slot[string] = Vacant[string]()

func MakeFlag(on bool) Flag = on match {
    case true  => On("lit")
    case false => Off()
}

// A struct with `var` fields, matched from the consumer: its plain Go fields
// must not be unwrapped with `.Get()`, while the non-`var` Name must be. The
// mutability reaches the consumer through cross-package metadata.
struct Pin(var Row int, var Col int, Name string)

func MakePin(row int, col int, name string) Pin = Pin(row, col, name)
-- examples/multifile_lib_regress_test.gala --
package main

import (
    "errors"
    "martianoff/gala/examples/multifile_lib_regress"
    "martianoff/gala/examples/multifile_lib_regress/proc_pkg"
    . "martianoff/gala/examples/multifile_lib_regress/directive_pkg"
    . "martianoff/gala/examples/multifile_lib_regress/shadow_func"
    . "martianoff/gala/examples/multifile_lib_regress/variant_pkg"
    "martianoff/gala/examples/go_struct_bridge"
    . "martianoff/gala/collection_immutable"
    "time"
)

func main() {
    // if-expression with time.Time
    val deadline = multifile_lib_regress.DeadlineFromString("2024-01-15T10:30:00Z")
    deadline match {
        case Some(t) => Println(t.Format("2006-01-02"))
        case _ => Println("no deadline")
    }

    // if-expression with int
    val count = multifile_lib_regress.CountIfPositive(42)
    count match {
        case Some(n) => Println(n)
        case _ => Println("no count")
    }

    val noCount = multifile_lib_regress.CountIfPositive(-1)
    noCount match {
        case Some(n) => Println(n)
        case _ => Println("negative (expected)")
    }

    // if-expression with Go method multi-return
    val session = go_struct_bridge.NewSessionData()
    val value052 = multifile_lib_regress.SessionValueIfExists(session, "user")
    value052 match {
        case Some(v) => Println(v)
        case _ => Println("no value")
    }

    // When inside FlatMap lambda (workaround for Go pointer type edge case)
    val user = multifile_lib_regress.SessionLookup(session, "user")
    user match {
        case Some(v) => Println(v)
        case _ => Println("no user")
    }

    val missing = multifile_lib_regress.SessionLookup(session, "missing")
    missing match {
        case Some(v) => Println(v)
        case _ => Println("key not found (expected)")
    }

    // When inside FlatMap lambda with simple types
    val simple = multifile_lib_regress.LookupSimple("test-key")
    simple match {
        case Some(v) => Println(v)
        case _ => Println("no value")
    }

    // Go struct named-arg (qualified) — should NOT wrap in Immutable
    Println(multifile_lib_regress.GoCookieString("session", "abc123"))

    // GALA struct named-arg — should wrap in Immutable (correct)
    Println(multifile_lib_regress.GalaCookieName("session", "abc123"))

    // Cross-file pointer-receiver method return field access: the call site
    // `canvas.StyleAt(0, 0).Bold` must auto-unwrap the Immutable[bool] wrapper
    // around .Bold. Before the fix, method-return type inference for *Canvas
    // returned NilType (non-generic PointerType fallback missing), so
    // isImmutableField on .Bold saw an unknown xType and emitted plain .Bold.
    val canvas = multifile_lib_regress.NewCanvas(80, 24)
    Println(multifile_lib_regress.BoldAt(canvas, 0, 0))

    // Block-body lambda inside Array.Map must infer the result type from the
    // trailing struct literal in the block. Verifies the regression in batch
    // transpile (where U was previously left unresolved/void).
    val hdr = ArrayOf("a", "bb", "ccc")
    val wid = ArrayOf(1, 2, 3)
    val cells = multifile_lib_regress.BuildLabeledCells(hdr, wid)
    cells.ForEach((c) => Println(s"${c.Label}=${c.Width}"))

    // Block-body lambda whose trailing expression is a val-bound identifier:
    // `Map((x) => { val doubled = x * 2; doubled })`. The promotion to a
    // return statement must fire even though the trailing identifier compiles
    // to a `.Get()` on the Immutable wrapper (whose static type is opaque to
    // the trivial type-name oracle).
    val nums = ArrayOf(1, 2, 3)
    multifile_lib_regress.DoubleEach(nums).ForEach((n) => Println(n))
    multifile_lib_regress.ExpandPairs(nums).ForEach((n) => Println(n))

    // Map with expression-bodied if-expression body over a generic element T:
    // both arms must unify to T so Map[U] resolves to T (not any). Otherwise
    // Array[any] leaks into downstream Array[T] use sites at the call site.
    val ifEcho = multifile_lib_regress.IfMapEcho(ArrayOf(1, 2, 3, 4), (x) => x % 2 == 0, (x) => x * 10)
    ifEcho.ForEach((n) => Println(n))

    // Map with expression-bodied if-expression body whose arms invoke
    // methods on a user-defined generic type. The IIFE is typed from its
    // branches; otherwise the lambda return widens to `any` and Array[any]
    // leaks into Array[State[T]] use sites.
    val s1 = multifile_lib_regress.State[int](Tag = "armed", Make = () => 1)
    val s2 = multifile_lib_regress.State[int](Tag = "due",   Make = () => 2)
    val nextStates = multifile_lib_regress.DispatchStates(ArrayOf(s1, s2))
    nextStates.ForEach((s) => Println(s.Tag))

    // Generic-method lambdas over a Go-declared local element type: Event is
    // defined in events.go alongside the GALA sources. The lambdas must bind
    // their element parameter to Event (not to the literal type-parameter name)
    // so the body can read e.Status / e.Method.
    Println(multifile_lib_regress.EventStatusSum())
    multifile_lib_regress.EventStatuses().ForEach((s) => Println(s))
    Println(multifile_lib_regress.EventOkCount())
    multifile_lib_regress.EventFirstGet() match {
        case Some(s) => Println(s)
        case _ => Println("no GET")
    }
    Println(multifile_lib_regress.EventAnyError())
    Println(multifile_lib_regress.EventAllPositive())
    Println(multifile_lib_regress.EventOkSum())

    // Positional Tuple constructor across packages — verify the cross-package
    // import sees the typed Tuple[bool, string] / Tuple3[int, string, float64]
    // signature and the call site receives the inferred values intact.
    val fp = multifile_lib_regress.MakeFlagPair(true, "ready")
    Println(fp.V1, fp.V2)

    val tr = multifile_lib_regress.MakeTriple(7, "label", 1.5)
    Println(tr.V1, tr.V2, tr.V3)

    // Tuple literal in call-argument position inherits element types from
    // the call-site's expected parameter type (bidirectional inference).
    // Without this the `(name, err)` literal was emitted as
    // Tuple[any, error] and Array.Append rejected the mismatch.
    val fails = multifile_lib_regress.CollectFailures(ArrayOf("alpha", "beta"))
    fails.ForEach((p) => Println(s"${p.V1}=${p.V2.Error()}"))
    // Cross-package chained Try.FlatMap synthesis: ProcSession wraps a
    // Process imported from a sibling GALA package (proc_pkg). The
    // chained Kill().FlatMap((_) => Wait().Map((_) => true)) form must
    // propagate the inner Try[bool] type argument through the synthesized
    // closure return type, even though Process and its methods live in
    // a different package than the consumer.
    val ps = multifile_lib_regress.ProcSession(Proc = proc_pkg.Process(Pid = 1))
    multifile_lib_regress.CloseProcSession(ps) match {
        case Success(b) => Println(s"flatmap: $b")
        case Failure(e) => Println(s"flatmap err: ${e.Error()}")
    }
    multifile_lib_regress.CloseProcSessionMatch(ps) match {
        case Success(b) => Println(s"match: $b")
        case Failure(e) => Println(s"match err: ${e.Error()}")
    }
    multifile_lib_regress.CloseProcSessionWorkaround(ps) match {
        case Success(b) => Println(s"workaround: $b")
        case Failure(e) => Println(s"workaround err: ${e.Error()}")
    }

    // Statement-position match with mixed value/void arms (regression).
    // EmitLevel runs `level match { ... }` as a statement; one arm calls
    // a value-returning function, another calls a void function, and
    // the default is a bare assignment. Without the fix the transpiler
    // wrapped the void arm in `return <voidCall>`, breaking Go compile.
    Println(multifile_lib_regress.EmitLevel("info"))
    Println(multifile_lib_regress.EmitLevel("warn"))
    Println(multifile_lib_regress.EmitLevel("other"))

    // Void-arm match terminating an inferred-return lambda body
    // (regression). MakeProcessor returns a lambda whose body ends in a
    // match-on-Try with all-void arms. Without the fix the inferred
    // return type leaked the synthesized arm union (or `void` literal),
    // and the trailing void IIFE was promoted to `return <void-IIFE>` —
    // Go rejected with "(no value) used as value".
    val proc = multifile_lib_regress.MakeProcessor()
    proc(multifile_lib_regress.ProcMember(Name = "ok"))
    proc(multifile_lib_regress.ProcMember(Name = "bad"))
    // HashMap.ForEachKV two-param lambda must bind both K and V from
    // the receiver's type args. The lambda calls memberKey(m) which
    // takes a concrete Member by value — this only compiles when the
    // lambda binds m to V=Member, not to any.
    val mm0 = EmptyHashMap[string, multifile_lib_regress.Member]()
    val mm1 = mm0.Put("alice", multifile_lib_regress.Member(Name = "Alice", Email = "a@x"))
    val mm2 = mm1.Put("bob",   multifile_lib_regress.Member(Name = "Bob",   Email = "b@x"))
    multifile_lib_regress.MembersByName(mm2).Sorted().ForEach((s) => Println(s))

    // Same shape but the lambda body is a single statement-position match
    // (mirrors the original failing report). The lambda must still bind
    // v to V=Member.
    multifile_lib_regress.CloseAllMembers(mm2).ForEach((s) => Println(s))

    // Qualified named-arg struct constructor must anchor the lookup to the
    // explicit package qualifier even when a dot-imported sibling exports a
    // function with the same identifier. Before the fix, the resolver would
    // strip the qualifier and match the dot-imported `shadow_func.Snapshot`
    // function — its (width, height) parameters did not match the struct's
    // (ProjectName, SavedAt) field names and a misleading "unknown
    // parameter" error fired at the call site.
    // The `SavedAt` literal is written bare on purpose: an untyped numeric
    // literal must take the declared `int64` field type through the
    // NewImmutable wrapper the immutable field is stored in.
    val snap = multifile_lib_regress.Snapshot(
        ProjectName = "demo",
        SavedAt = 1234,
    )
    Println(s"snap: ${snap.ProjectName}=${snap.SavedAt}")

    // --- Regression: untyped numeric literals into immutable struct fields
    // declared with a non-`int` numeric type (int64/uint32/float64/byte).
    // Constructed both inside the library (all three spellings) and here,
    // across the package boundary, where the field types come from the
    // imported package's metadata.
    Println(multifile_lib_regress.DescribeReading(multifile_lib_regress.NewReadingPositional("pos")))
    Println(multifile_lib_regress.DescribeReading(multifile_lib_regress.NewReadingNamed("named")))
    Println(multifile_lib_regress.DescribeReading(multifile_lib_regress.NewReadingComposite("composite")))
    val xpkgPositional = multifile_lib_regress.Reading("xpos", 5, 1, 3, 4)
    Println(multifile_lib_regress.DescribeReading(xpkgPositional))
    val xpkgNamed = multifile_lib_regress.Reading(
        Label = "xnamed",
        TakenAtMs = 6,
        Port = 2,
        Ratio = 4,
        Tag = 5,
    )
    Println(multifile_lib_regress.DescribeReading(xpkgNamed))
    // Reference a non-clashing helper from the shadow package so the
    // dot-import is actually exercised at compile time.
    Println(ShadowMarker())

    // --- Regression: cross-package Option.Map lambda whose body is a method
    // call on the bound element name. ConsultEvent is sealed with cases
    // defined in proc_pkg; ConsultEnd carries an Option[error]. The transform
    // function pattern-matches on a ConsultEvent and chains
    // errOpt.Map((e) => e.Error()) — the lambda body must keep its inferred
    // string return type even though the receiver Option's metadata lives in
    // another GALA package and the body is a method call (not an identifier).
    val chunkEv = proc_pkg.MakeChunk("topic", "first line")
    val endOkEv = proc_pkg.MakeEndOk("topic")
    val endErrEv = proc_pkg.MakeEndErr("topic", "boom")
    Println(multifile_lib_regress.DescribeAppMsg(multifile_lib_regress.ToAppMsg(chunkEv)))
    Println(multifile_lib_regress.DescribeAppMsg(multifile_lib_regress.ToAppMsg(endOkEv)))
    Println(multifile_lib_regress.DescribeAppMsg(multifile_lib_regress.ToAppMsg(endErrEv)))

    // --- Regression: `failure = Some(...)` reassignment to an Option[T] var
    // must inherit the LHS type-arg so the variant is emitted as
    // `Some[T]{}.Apply(...)`. Exercises the cross-package shape with the
    // helper defined in multifile_lib_regress/logic.gala.
    val seeds = ArrayOf("alpha", "beta", "gamma")
    multifile_lib_regress.RuntimeFailure(seeds, 2) match {
        case Some(msg) => Println(s"runtime failure: $msg")
        case None()    => Println("runtime failure: <none>")
    }

    // --- Regression: nested Success(InnerCase) match inside a returned
    // lambda. The lambda parameter has no explicit type — it is driven by
    // the enclosing function's `func(Try[WireMsg]) string` return type.
    // Without expected-param propagation through the `return` statement,
    // the matched type erased to `Try[any]`, and the inner sealed-case
    // Unapply rejected with "need type assertion".
    val handler = multifile_lib_regress.MakeWireHandler()
    Println(handler(Failure[multifile_lib_regress.WireMsg](errors.New("boom"))))
    Println(handler(Success[multifile_lib_regress.WireMsg](multifile_lib_regress.WireChunk(Index = 1, Line = "hi"))))
    Println(handler(Success[multifile_lib_regress.WireMsg](multifile_lib_regress.WireSessionFailed(Index = 2, Err = "x"))))
    Println(handler(Success[multifile_lib_regress.WireMsg](multifile_lib_regress.WireOther())))

    // --- Regression: if-expression in var-initialiser whose arms are both
    // s-string interpolations must lower to `func() string`, not
    // `func() any`. Otherwise the call to TextStyled (which takes a
    // concrete `string` first param) rejects the `any` value with
    // "cannot use ... as string".
    Println(multifile_lib_regress.RenderRow(true, "G", "alice"))
    Println(multifile_lib_regress.RenderRow(false, "g", "bob"))

    // --- Regression: sealed-case → sealed-parent widening inside a
    // tuple-typed match-arm result. The function's declared return is
    // Tuple[DispatchModel, DispatchCmd[DispatchMsg]]; one arm produces the
    // tuple with a sealed-CASE constructor (SendDispatch[DispatchMsg]) in
    // slot 2 via a val binding, and the sibling arm produces the parent
    // (DispatchCmd[DispatchMsg]) from a function returning the parent.
    // Both arms must unify against the declared return.
    val okOutcome = Success("hello")
    val errOutcome = Failure[string](errors.New("nope"))
    val r1 = multifile_lib_regress.DispatchByOutcome(okOutcome)
    val r2 = multifile_lib_regress.DispatchByOutcome(errOutcome)
    Println(s"DispatchByOutcome ok counter=${r1.V1.Counter}")
    Println(s"DispatchByOutcome err counter=${r2.V1.Counter}")

    // --- Regression: bare string literal at a val (Immutable[string]) param
    // slot must auto-lift to NewImmutable[string]. PolicyMatches calls a
    // helper declared `val expected string, val actual string`; passing the
    // literal "notify" used to fail Go compile with "cannot use \"notify\"
    // (untyped string constant) as std.Immutable[string]".
    Println(multifile_lib_regress.PolicyMatches("notify"))
    Println(multifile_lib_regress.PolicyMatches("retry"))

    // --- Regression: chained accessor `dirs.Get(N) match` over a
    // cross-package sealed type + Array indirection.
    //
    // `Parse(msg)` returns `Array[Directive]` from the dot-imported
    // directive_pkg. The val `dirs` therefore stores `Array[Directive]`.
    // `dirs.Get(N)` should yield `Directive`. The match arms then bind
    // case fields. Before the cache-invalidation fix this regressed
    // when a stale on-disk pkgAST for directive_pkg was reused — the
    // collection_immutable.Array typeMeta was missing from the
    // consumer's lookup table, so `inferGetMethodType` fell through to
    // returning the receiver type, and `firstD` was stored as
    // `Array[Directive]` instead of `Directive`. The match-IIFE then
    // typed `obj` as `Array[Directive]` and Go rejected the
    // `Dispatch{}.Unapply` call.
    val dirs = multifile_lib_regress.ParseDirectives("payload")
    val firstD  = dirs.Get(0)
    val secondD = dirs.Get(1)
    Println(firstD match {
        case Dispatch(target, _) => s"first dispatch -> $target"
        case Summary(body)       => s"first summary  -> $body"
    })
    Println(secondD match {
        case Dispatch(target, _) => s"second dispatch -> $target"
        case Summary(body)       => s"second summary  -> $body"
    })

    // --- Regression: chained accessor `cfg.Members.Get(N).Model match`
    // Cfg.Members is `Array[Member]`,
    // .Get(N) returns `Member`, .Model is `Option[string]`. The match
    // subject must be typed as `Option[string]` — not `Option[any]`,
    // and the match-IIFE param must accept the Immutable wrapper unwrap.
    val cfg = multifile_lib_regress.LoadCfg()
    Println(cfg.Members.Get(0).Model match {
        case None()  => "member 0: no model (expected)"
        case Some(m) => s"member 0: $m"
    })
    Println(cfg.Members.Get(1).Model match {
        case Some(m) => s"member 1: $m"
        case None()  => "member 1: no model"
    })

    // --- Regression: `.IsDefined()` / `.GetOrElse(...)` on
    // `Immutable[Option[T]]` reached through a chained accessor
    // The auto-unwrap codegen must dispatch through
    // the Immutable wrapper before the method lookup.
    Println(s"hasModel(0)=${cfg.Members.Get(0).Model.IsDefined()}")
    Println(s"hasModel(1)=${cfg.Members.Get(1).Model.IsDefined()}")
    Println(s"modelOr(0)=${cfg.Members.Get(0).Model.GetOrElse(\"<none>\")}")

    // --- Regression: `.Size()` on `Immutable[Array[T]]` reached
    // through a chained accessor. cfg.Hooks.Get(0)
    // returns `Immutable[Hook]`, .Args returns `Immutable[Array[string]]`,
    // .Size() must auto-unwrap before dispatching the method.
    Println(s"hook0.args.size=${cfg.Hooks.Get(0).Args.Size()}")

    // --- Regression: 3-deep chain `cfgs.Get(N).Lead.Name` compared
    // against a string literal. The chain goes Cfg → Array[Cfg] → Cfg → Member → string,
    // each traversed through Immutable wrappers. .Name on
    // `Immutable[Member]` must resolve to the field's `Immutable[string]`
    // and Go must accept a bare string literal at the Eq site.
    val cfgs = multifile_lib_regress.LoadCfgs()
    Println(s"cfgs(1).Lead=${cfgs.Get(1).Lead.Name}")

    // --- Regression: method call on Go struct's func-typed field (issue #326).
    // `p.Process(42)` where Process is `func(int) (string, error)` must infer
    // the call's return type from the field's declared results. Without the
    // fix the call typed as NilType and the `var s, err = ...` destructure
    // produced untyped slots that downstream code rejected.
    Println(multifile_lib_regress.ProcessorRun(42))
    // Single-return shape: `b.Build(s).String()` requires the GALA-level
    // type tracker to know `b.Build(s)` returns a Cookie so the chained
    // `.String()` call resolves to Cookie.String. Without the fix the
    // inner call typed as NilType, the second-stage lookup had no receiver
    // type, and the chained call could not be synthesised.
    Println(multifile_lib_regress.CookieBuilderDescribe("session"))
    multifile_lib_regress.CookieBuilderOption("opt") match {
        case Some(c) => Println(c.String())
        case None()  => Println("<no cookie>")
    }

    // --- Regression: one type's methods declared across two files of the
    // package. Ledger and OwnedBy live in cross_file_methods.gala, Tagged
    // and LedgerFor in cross_file_methods_ext.gala. Both methods must reach
    // the generated Go exactly once: the duplicate-method check runs over
    // the merged sibling metadata, so a sibling contributing a method to a
    // type declared elsewhere must not read as a redefinition.
    val ledger = multifile_lib_regress.LedgerFor("nina")
    Println(s"ledger=${ledger.OwnedBy()}/${ledger.Tagged()}")
    // --- Regression: the analyzer's undefined-symbol check (GALA-E0023)
    // must not fire on legal cross-file resolution. Each call below is
    // built from a different resolution route (sibling declarations,
    // package-level vals, forward references, dot imports, the std
    // prelude, a named subpackage import, lambda-parameter shadowing).
    // A regression that over-fires the check turns these into a hard
    // analyzer error instead of a wrong result, so this case fails loudly.
    // See multifile_lib_regress/symbol_scope.gala.
    // --- Regression: lambda over a Go GENERIC call, resolved through the
    // multi-file batch path. The lambda's synthesized result clause must carry
    // the callee's INSTANTIATED return type (map[string]int, []int), not the
    // declared map[K]V / []T — those name the Go callee's own type parameters,
    // which do not exist at the call site.
    // See multifile_lib_regress/go_interop.gala.
    Println(multifile_lib_regress.GoGenericLambdaMapSize("k", 7))
    Println(multifile_lib_regress.GoGenericLambdaSliceSize(4))
    Println(multifile_lib_regress.GoGenericLambdaViaCombinator(9))
    // Same path, but the Go generic returns a GALA std type (Option[V]) that
    // go/types cannot resolve against the un-transpiled tree. It must be
    // recovered as a concrete Option[int], not degraded to `any` or to
    // go/types' unparseable "invalid type" display string.
    Println(multifile_lib_regress.GoGenericOptionLambda("k"))
    Println(multifile_lib_regress.GoGenericOptionLambda("nope"))
    // Same instantiation gap, reached by destructuring a Go generic's
    // MULTI-VALUE return (`val v, ok = go_interop.MapGet(m, k)`). Each bound
    // name must take the call's instantiated return type; binding the declared
    // `V` deferred the failure to the first use that pinned a type.
    Println(multifile_lib_regress.GoGenericDestructureOption("k"))
    Println(multifile_lib_regress.GoGenericDestructureOption("nope"))
    Println(multifile_lib_regress.GoGenericDestructureFromField("k"))
    Println(multifile_lib_regress.GoGenericDestructureFromField("nope"))

    Println(multifile_lib_regress.ScopeReport(1))
    Println(multifile_lib_regress.ScopeLambdaCapture(3))
    Println(multifile_lib_regress.ScopeQualifiedImport("gamma"))
    Println(multifile_lib_regress.ScopeSnapshotLabel())

    // --- Regression: a generic sealed type must be recognized as sealed when
    // the match subject's type is INFERRED from a variant constructor. The
    // subject's type comes from the companion's Apply return type, and a
    // qualified base name there only resolves when the qualifier is also the
    // registry key. A miss made every check keyed on the matched type stand
    // down, so an exhaustive match was rejected with "must have a default
    // case". See multifile_lib_regress/generic_sealed.gala.
    Println(multifile_lib_regress.InferredReply())
    Println(multifile_lib_regress.InferredSilent())
    Println(multifile_lib_regress.DescribeReply(multifile_lib_regress.MakeAnsweredInt(9)))
    Println(multifile_lib_regress.InferredOutcome())
    Println(multifile_lib_regress.DescribeOutcome(multifile_lib_regress.MakeBad("nope")))
    // --- Regression: a bare identifier naming a zero-field variant of the
    // matched type is that variant's pattern, not a fresh binding. A binding
    // matches everything, so the historic behaviour turned each of these arms
    // into a silent catch-all — compiling, exiting 0, and answering with the
    // wrong arm. The library-side functions live in
    // multifile_lib_regress/bare_variant.gala; the calls below pin the runtime
    // answer, which is the only thing that catches a reintroduction.
    Println(multifile_lib_regress.DescribeCursor(multifile_lib_regress.ItemCursor("k")))
    Println(multifile_lib_regress.DescribeCursor(multifile_lib_regress.EndCursor()))
    Println(multifile_lib_regress.DescribeMarker(multifile_lib_regress.NamedMarker("m")))
    Println(multifile_lib_regress.DescribeMarker(multifile_lib_regress.AnonymousMarker()))
    Println(multifile_lib_regress.DescribeOption(Some(5)))
    Println(multifile_lib_regress.DescribeOption(None[int]()))
    // Same shape resolved at the consumer, over sealed types dot-imported from
    // a sibling package: cross-package variant metadata travels a different
    // route than same-package metadata. Both the generic (`Slot[T]`) and the
    // non-generic (`Flag`) parents are covered.
    MakeSlot("q") match {
        case Vacant     => Println("slot-vacant")
        case Holds(v)   => Println(s"slot-holds $v")
    }
    EmptySlot() match {
        case Vacant   => Println("slot-vacant")
        case Holds(v) => Println(s"slot-holds $v")
    }
    MakeFlag(true) match {
        case Off    => Println("flag-off")
        case On(lb) => Println(s"flag-on $lb")
    }
    MakeFlag(false) match {
        case Off    => Println("flag-off")
        case On(lb) => Println(s"flag-on $lb")
    }
    // A struct pattern over `var` fields reads them as plain Go fields, both
    // for a struct declared in a sibling file and for one dot-imported from
    // another package; only the non-`var` fields are unwrapped.
    Println(multifile_lib_regress.DescribeCaret(multifile_lib_regress.CaretAt(0, 4)))
    Println(multifile_lib_regress.DescribeCaret(multifile_lib_regress.CaretAt(2, 2)))
    Println(multifile_lib_regress.DescribeCaret(multifile_lib_regress.CaretAt(3, 8)))
    MakePin(1, 2, "home") match {
        case Pin(0, _, name) => Println(s"pin-top $name")
        case Pin(row, col, name) => Println(s"pin $name at $row,$col")
        case _ => Println("pin-unreachable")
    }
    // --- Regression: a GALA package imported by one file of a package must not
    // rebind that package name for its siblings. pkg_name_collision.gala imports
    // GALA's strings; pkg_name_collision_go.gala imports Go's. Each must resolve
    // to its own. The match in GoStringsClassify is load-bearing: the old bug only
    // surfaced where a concrete type was required.
    Println(multifile_lib_regress.GalaStringsUpper("gala"))
    Println(s"${multifile_lib_regress.GalaStringsSplitSize("a:b")}")
    Println(multifile_lib_regress.GoStringsClassify("header:X-Api-Key"))
    Println(multifile_lib_regress.GoStringsClassify("query:q"))
    Println(multifile_lib_regress.GoStringsClassify("nope"))
    Println(multifile_lib_regress.GoStringsClassify("cookie:c"))
    Println(multifile_lib_regress.GoStringsUpper("go"))
    // The same collision for a Go function passed as a VALUE (strings.Fields
    // handed to Map): its signature must be Go's, not the sibling's GALA one.
    Println(multifile_lib_regress.GoFieldsCounts(ArrayOf("a b c", "d", "")).String())
    // A same-package GENERIC function passed as a value in a NAMED package,
    // consumed by a lambda that writes the element type down.
    Println(multifile_lib_regress.MapEchoSizes(ArrayOf("ab", "cde")).String())
    // A user GALA package named `time` next to Go's `time` in a sibling file:
    // each call resolves against its own package's signature.
    Println(multifile_lib_regress.GalaTimeNow())
    Println(multifile_lib_regress.GalaTimeAfterFunc())
    Println(multifile_lib_regress.GoTimeNowSet())
    Println(multifile_lib_regress.GoTimeAfterFuncStopped())
    // A parameter shadowing the GALA `time` import: its method, not the package function.
    Println(multifile_lib_regress.ShadowedTimeQualifier(multifile_lib_regress.Clock("wall")))
    // A dot-imported GENERIC function passed as a value in a named package.
    Println(multifile_lib_regress.FlattenSizes(ArrayOf(ListOf(ListOf(1, 2)), ListOf(ListOf(3)))).String())
    // Two files of the package use the same codecs; each declares its own
    // codec metadata types.
    Println(multifile_lib_regress.CodecMetaA())
    Println(multifile_lib_regress.CodecMetaB())
    // Package-level tuple destructuring in two files of the package.
    multifile_lib_regress.TupleRecordHit()
    Println(multifile_lib_regress.TupleAddress())
    Println(multifile_lib_regress.TupleCuts())
    // An opaque type declared in one file of the package, with methods in two.
    val seat = multifile_lib_regress.SeatOf(47)
    Println(seat.Row(), seat.Label(), int(seat), multifile_lib_regress.SeatSummary())
    // A sealed type with lowercase variants, declared in one file of the package
    // and matched exhaustively, with bare zero-field arms, in another.
    Println(multifile_lib_regress.SignalSummary())
}
-- examples/multipackage_subpkg/main.gala --
package main

import . "martianoff/gala/std"
import "martianoff/gala/examples/multipackage_subpkg/state"

// Verifies that a project with one root package and one sub-directory package
// (`state/state.gala`) is transpiled cleanly. Previously, feeding the two
// files through a single batch analyzer tripped an ANTLR nil-pointer panic;
// this example keeps that regression out.
func main() {
    val s = state.NewState("root")
    Println(s.Greet())
}
-- examples/multipackage_subpkg/state/state.gala --
package state

import . "martianoff/gala/std"

// Simple library in a subpackage — exercises library-with-sublibrary layouts,
// which used to panic the analyzer. The root consumer at
// examples/multipackage_subpkg/main.gala imports this file and prints values
// returned from it.
struct AppState(Count int, Label string)

func NewState(label string) AppState = AppState(Count = 0, Label = label)

func (s AppState) Greet() string = s"Hello from state/${s.Label} with count ${s.Count}"
-- examples/mutable_collections.gala --
package main

import (
    "fmt"
    . "martianoff/gala/collection_mutable"
    . "martianoff/gala/std"
)

// Example: Pattern matching with mutable Array
func describeArray[T any](arr Ptr[Array[T]]) string {
    return arr match {
        case a if a.IsEmpty() => "empty array"
        case a if a.Length() == 1 => fmt.Sprintf("single: %v", a.Head())
        case _ => fmt.Sprintf("array[%d]", arr.Length())
    }
}

// Example: Option pattern matching with Find
func findAndDescribe(arr Ptr[Array[int]], pred func(int) bool) string {
    var found = arr.Find(pred)
    return found match {
        case Some(v) => fmt.Sprintf("found: %d", v)
        case _ => "not found"
    }
}

// Example: Processing with guards
func analyzeNumbers(arr Ptr[Array[int]]) string {
    return arr match {
        case a if a.IsEmpty() => "no numbers"
        case a if a.ForAll((x int) => x > 0) => "all positive"
        case a if a.ForAll((x int) => x < 0) => "all negative"
        case a if a.Exists((x int) => x == 0) => "has zero"
        case _ => "mixed"
    }
}

// Example: Tuple pattern matching with arrays
func compareSizes(a1 Ptr[Array[int]], a2 Ptr[Array[int]]) string {
    var sizes = (a1.Length(), a2.Length())
    return sizes match {
        case (0, 0) => "both empty"
        case (0, _) => "first empty"
        case (_, 0) => "second empty"
        case (n1, n2) if n1 == n2 => fmt.Sprintf("equal: %d", n1)
        case (n1, n2) if n1 > n2 => "first larger"
        case _ => "second larger"
    }
}

// Example: List with pattern matching
func describeList[T any](list Ptr[List[T]]) string {
    return list match {
        case l if l.IsEmpty() => "empty list"
        case l if l.Length() == 1 => "singleton"
        case _ => fmt.Sprintf("list[%d]", list.Length())
    }
}

// Example: Sequence pattern matching on Array
func describeArraySeq(arr Ptr[Array[int]]) string {
    return arr match {
        case Array(first, second, _...) => fmt.Sprintf("starts with %d, %d", first, second)
        case Array(only, _...) => fmt.Sprintf("starts with %d", only)
        case _ => "empty"
    }
}

// Example: Extract head and tail from List
func sumListSeq(list Ptr[List[int]]) int {
    return list match {
        case List(head, tail...) => head + sumListSeq(tail)
        case _ => 0
    }
}

// Example: Building and transforming
func buildSquares(n int) Ptr[Array[int]] {
    var arr = ArrayWithCapacity[int](n)
    for i := 1; i <= n; i++ {
        arr.Append(i * i)
    }
    return arr
}

// Example: Queue operations with List
func runQueue() {
    var queue = EmptyList[string]()

    // Enqueue
    queue.Append("task1")
    queue.Append("task2")
    queue.Append("task3")

    fmt.Println("Queue:", queue.String())

    // Dequeue
    for queue.NonEmpty() {
        var task = queue.RemoveFirst()
        fmt.Printf("  Processing: %s\n", task)
    }
}

// Example: Stack operations with Array
func runStack() {
    var stack = EmptyArray[int]()

    // Push
    stack.Append(1)
    stack.Append(2)
    stack.Append(3)

    fmt.Println("Stack:", stack.String())

    // Pop
    for stack.NonEmpty() {
        var item = stack.RemoveLast()
        fmt.Printf("  Popped: %d\n", item)
    }
}

func main() {
    fmt.Println("=== Mutable Collections Examples ===")
    fmt.Println()

    // Array pattern matching
    fmt.Println("--- Array Pattern Matching ---")
    var empty = EmptyArray[int]()
    var single = ArrayOf[int](42)
    var multi = ArrayOf[int](1, 2, 3, 4, 5)

    fmt.Println(describeArray[int](empty))   // empty array
    fmt.Println(describeArray[int](single))  // single: 42
    fmt.Println(describeArray[int](multi))   // array[5]
    fmt.Println()

    // Option pattern matching
    fmt.Println("--- Find with Pattern Matching ---")
    var isEven = (x int) => x % 2 == 0
    var isNegative = (x int) => x < 0
    fmt.Println(findAndDescribe(multi, isEven))     // found: 2
    fmt.Println(findAndDescribe(multi, isNegative)) // not found
    fmt.Println()

    // Number analysis
    fmt.Println("--- Number Analysis ---")
    var positive = ArrayOf[int](1, 2, 3)
    var negative = ArrayOf[int](-1, -2, -3)
    var mixed = ArrayOf[int](-1, 0, 1)
    var withZero = ArrayOf[int](1, 0, 2)

    fmt.Println("positive:", analyzeNumbers(positive))   // all positive
    fmt.Println("negative:", analyzeNumbers(negative))   // all negative
    fmt.Println("mixed:", analyzeNumbers(mixed))         // has zero
    fmt.Println("withZero:", analyzeNumbers(withZero))   // has zero
    fmt.Println()

    // Compare sizes
    fmt.Println("--- Size Comparison ---")
    var a1 = ArrayOf[int](1, 2, 3)
    var a2 = ArrayOf[int](4, 5, 6)
    var a3 = ArrayOf[int](1, 2)

    fmt.Println(compareSizes(a1, a2))  // equal: 3
    fmt.Println(compareSizes(a1, a3))  // first larger
    fmt.Println(compareSizes(a3, a1))  // second larger
    fmt.Println()

    // List pattern matching
    fmt.Println("--- List Pattern Matching ---")
    var emptyList = EmptyList[string]()
    var singleList = ListOf[string]("hello")
    var multiList = ListOf[string]("a", "b", "c")

    fmt.Println(describeList[string](emptyList))   // empty list
    fmt.Println(describeList[string](singleList))  // singleton
    fmt.Println(describeList[string](multiList))   // list[3]
    fmt.Println()

    // Building with capacity
    fmt.Println("--- Build and Transform ---")
    var squares = buildSquares(5)
    fmt.Println("Squares:", squares.String())  // Array(1, 4, 9, 16, 25)

    var evens = squares.Filter((x int) => x % 2 == 0)
    fmt.Println("Even squares:", evens.String())  // Array(4, 16)

    var doubled = squares.Map[int]((x int) => x * 2)
    fmt.Println("Doubled:", doubled.String())  // Array(2, 8, 18, 32, 50)
    fmt.Println()

    // Queue example
    fmt.Println("--- Queue (List) ---")
    runQueue()
    fmt.Println()

    // Stack example
    fmt.Println("--- Stack (Array) ---")
    runStack()
    fmt.Println()

    // Grouped
    fmt.Println("--- Grouped ---")
    var nums = ArrayOf[int](1, 2, 3, 4, 5, 6, 7, 8, 9)
    var groups = nums.Grouped(3)
    fmt.Println("Groups of 3:")
    groups.ForEach((g) => {
        fmt.Printf("  %s\n", g.String())
    })
    fmt.Println()

    // Distinct
    fmt.Println("--- Distinct ---")
    var withDups = ArrayOf[int](1, 2, 2, 3, 3, 3, 4)
    fmt.Println("Original:", withDups.String())
    fmt.Println("Distinct:", withDups.Distinct().String())
    fmt.Println()

    // Sequence pattern matching
    fmt.Println("--- Sequence Pattern Matching ---")
    fmt.Println(describeArraySeq(multi))    // starts with 1, 2
    fmt.Println(describeArraySeq(single))   // starts with 42
    fmt.Println(describeArraySeq(empty))    // empty

    var numList = ListOf[int](1, 2, 3, 4, 5)
    fmt.Println("Sum:", sumListSeq(numList))  // Sum: 15
}
-- examples/named_arg_sealed.gala --
package main

import "fmt"

// Constructs sealed type variants using named arguments from a DIFFERENT file.
// Previously, this would silently drop all field values.
func makeSuccess() MyResult {
    return MySuccess(SuccessValue = 42, SuccessMsg = "hello")
}

func makeFailure() MyResult {
    return MyFailure(FailureCode = 500, FailureMsg = "error")
}

func describe(r MyResult) string = r match {
    case MySuccess(v, msg) => fmt.Sprintf("Success: %d %s", v, msg)
    case MyFailure(code, msg) => fmt.Sprintf("Failure: %d %s", code, msg)
}

func main() {
    fmt.Println(describe(makeSuccess()))
    fmt.Println(describe(makeFailure()))
}
-- examples/named_arg_sealed_model.gala --
package main

// Defines a sealed type with multi-field variants in a separate file
// from where it's constructed. Verifies named-arg construction works
// across file boundaries.

sealed type MyResult {
    case MySuccess(SuccessValue int, SuccessMsg string)
    case MyFailure(FailureCode int, FailureMsg string)
}
-- examples/named_args.gala --
package main

func describe(name string, age int, role string) string =
    s"$name ($role, age $age)"

func divide(dividend int, divisor int) int = dividend / divisor

func main() {
    // Positional
    Println(describe("Alice", 30, "engineer"))

    // Named, any order
    Println(describe(role = "designer", name = "Bob", age = 25))

    // Named reordering
    Println(divide(divisor = 4, dividend = 20))

    // All named, same order
    Println(divide(dividend = 100, divisor = 10))
}
-- examples/named_args_defaults_generics.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// T9: Deep matrix mixing named args, default values, and generic parameters.
// Exercises:
//   - generic function with multiple type params
//   - defaults on the trailing parameters (GALA requires required-first)
//   - call sites using named args to override select defaults
//   - type inference through the required arguments
func wrap[A any, B any](value A, tag B, suffix string = "!", times int = 1) Tuple[string, B] {
    var out = ""
    for i := 0; i < times; i = i + 1 {
        out = out + fmt.Sprintf("%v%s", value, suffix)
    }
    return (out, tag)
}

func main() {
    // All defaults (explicit type args).
    val r1 = wrap[int, string](42, "a")
    fmt.Println(r1.V1)
    fmt.Println(r1.V2)

    // Override times via named arg.
    val r2 = wrap[int, string](7, "b", times = 3)
    fmt.Println(r2.V1)
    fmt.Println(r2.V2)

    // Override suffix only.
    val r3 = wrap[string, int]("ok", 99, suffix = "?")
    fmt.Println(r3.V1)
    fmt.Println(r3.V2)

    // Named args out of declaration order.
    val r4 = wrap[int, bool](5, true, times = 2, suffix = "-")
    fmt.Println(r4.V1)
    fmt.Println(r4.V2)
}
-- examples/named_args_variadic_omitted.gala --
package main

import . "martianoff/gala/collection_immutable"

// A call with named arguments may leave a variadic parameter out: it then
// takes no values, as it does in a positional call.

struct Counter(N int)

// Plus adds x and every value of xs to the counter.
func (c Counter) Plus(x int, xs ...int) int = ArrayOf(xs...).FoldLeft(c.N + x, (acc, n) => acc + n)

// Label joins a prefix and any number of parts.
func Label(prefix string, parts ...string) string = prefix + ArrayOf(parts...).MkString(",")

func main() {
    Println(Label(prefix = "parts:"))
    Println(Label(prefix = "parts:", parts = "a"))
    Println(Counter(1).Plus(x = 2))
    Println(Counter(1).Plus(x = 2, xs = 3))
}
-- examples/named_sub_patterns.gala --
package main

// Named sub-patterns: `Field = p` matches p against the field of that name.
// Fields left out match anything.

sealed type Shape {
    case Circle(Radius int)
    case Rect(Width int, Height int)
}

struct Point(X int, Y int)

func height(s Shape) int = s match {
    case Circle(Radius = r)          => 2 * r
    case Rect(Height = h, Width = _) => h
}

func flat(s Shape) bool = s match {
    case Rect(Height = 0) => true
    case _                => false
}

func square(s Shape) string = s match {
    case Rect(1, Height = 1)           => "unit square"
    case Rect(w, Height = h) if w == h => "square"
    case Rect(_, _)                    => "rect"
    case Circle(_)                     => "circle"
}

func axis(p Point) string = p match {
    case Point(Y = 0) => "on the x axis"
    case Point(X = 0) => "on the y axis"
    case _            => s"(${p.X}, ${p.Y})"
}

func main() {
    Println(height(Rect(1, 2)), height(Circle(3)))
    Println(flat(Rect(5, 0)), flat(Rect(0, 5)))
    Println(square(Rect(1, 1)), square(Rect(2, 2)), square(Rect(2, 3)), square(Circle(1)))
    Println(axis(Point(4, 0)), axis(Point(0, 4)), axis(Point(1, 2)))
}
-- examples/nested_generic_flatmap.gala --
package main

import . "martianoff/gala/std"

// Validated is a two-type-param generic whose FlatMap/Map result type params
// (named B) intentionally reuse the letter used by the enclosing generic
// functions below. This exercises method-result-type inference when the
// method's own type param collides in name with a receiver type argument.
type Validated[E any, A any] struct {
    Err E
    Val A
    Ok bool
}

func (v Validated[E, A]) FlatMap[B any](f func(A) Validated[E, B]) Validated[E, B] {
    if v.Ok {
        return f(v.Val)
    }
    return Validated[E, B]{Err: v.Err, Ok: false}
}

func (v Validated[E, A]) Map[B any](f func(A) B) Validated[E, B] {
    if v.Ok {
        return Validated[E, B]{Val: f(v.Val), Ok: true}
    }
    return Validated[E, B]{Err: v.Err, Ok: false}
}

func ok[E any, A any](value A) Validated[E, A] = Validated[E, A]{Val: value, Ok: true}

// Repro A: FlatMap's result type param must be inferred from the inner Map
// lambda's return type (Tuple[A, B]), not collapse to the enclosing B.
func pair[A any, B any](va Validated[string, A], vb Validated[string, B]) Validated[string, Tuple[A, B]] =
    va.FlatMap((a) => vb.Map((b) => Tuple(a, b)))

// Repro B: mapping over a nested-generic receiver keeps the element type
// Tuple[B, C] intact for the lambda parameter.
func flatten[A any, B any, C any](vbc Validated[string, Tuple[B, C]], a A) Validated[string, Tuple3[A, B, C]] =
    vbc.Map((bc) => Tuple(a, bc.V1, bc.V2))

func main() {
    val p = pair(ok[string, int](1), ok[string, string]("x"))
    Println(p.Val)
    val f = flatten(ok[string, Tuple[int, bool]](Tuple(2, true)), "a")
    Println(f.Val)
}
-- examples/nested_match.gala --
package main

import "fmt"

// Test nested void match expressions.
// When a void match (all branches are side-effects) is nested inside another match,
// the transpiler must correctly detect the void IIFE and not wrap it in a return statement.

func main() {
    // Nested void match with Option
    val outer = Some(Some("hello"))
    outer match {
        case Some(inner) => inner match {
            case Some(v) => fmt.Println("nested value:", v)
            case None() => fmt.Println("inner is none")
        }
        case None() => fmt.Println("outer is none")
    }

    // Nested void match with boolean
    val flag = true
    val check = Some(42)
    flag match {
        case true => check match {
            case Some(n) => fmt.Println("flag=true, value:", n)
            case None() => fmt.Println("flag=true, no value")
        }
        case false => fmt.Println("flag is false")
    }

    // Three-level nesting
    val a = Some(Some(Some("deep")))
    a match {
        case Some(b) => b match {
            case Some(c) => c match {
                case Some(v) => fmt.Println("deep value:", v)
                case None() => fmt.Println("c is none")
            }
            case None() => fmt.Println("b is none")
        }
        case None() => fmt.Println("a is none")
    }
}
-- examples/nested_tuple_destruct.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

func main() {
    // Test 1: Basic nested tuple destructuring
    val nested = ((1, 2), (3, 4))
    val (left, right) = nested
    fmt.Printf("left=(%d, %d), right=(%d, %d)\n", left.V1, left.V2, right.V1, right.V2)

    // Test 2: Deeply nested tuple
    val deep = (((10, 20), (30, 40)), ((50, 60), (70, 80)))
    val (topLeft, topRight) = deep
    val (a, b) = topLeft
    val (c, d) = topRight
    fmt.Printf("a=(%d, %d), b=(%d, %d)\n", a.V1, a.V2, b.V1, b.V2)
    fmt.Printf("c=(%d, %d), d=(%d, %d)\n", c.V1, c.V2, d.V1, d.V2)

    // Test 3: Mixed tuple types
    val mixed = ((1, "hello"), (2, "world"))
    val (first, second) = mixed
    fmt.Printf("first=(%d, %s), second=(%d, %s)\n", first.V1, first.V2, second.V1, second.V2)

    // Test 4: Tuple with Option
    val withOption = (Some(42), None[int]())
    val (someVal, noneVal) = withOption
    fmt.Printf("someVal=%d, noneVal=%v\n", someVal.Get(), noneVal.IsEmpty())

    // Test 5: Function returning nested tuple
    val result = makeNestedTuple()
    val (p1, p2) = result
    fmt.Printf("p1=(%d, %d), p2=(%d, %d)\n", p1.V1, p1.V2, p2.V1, p2.V2)
}

func makeNestedTuple() Tuple[Tuple[int, int], Tuple[int, int]] {
    return ((100, 200), (300, 400))
}
-- examples/nested_tuple_pattern.gala --
package main

import . "martianoff/gala/collection_immutable"

// Parenthesized tuple patterns nested inside other patterns. `(n, s)` in
// `Some((n, s))` is ONE argument of Some — a pattern against its tuple payload —
// not two, and not zero.

sealed type Msg {
    case Move(Pos Tuple[int, int], Label string)
    case Quit()
}

struct Holder(Pair Tuple[string, int], Tag string)

func optionTuple(o Option[Tuple[int, string]]) string = o match {
    case Some((n, s)) => s"some $n $s"
    case _            => "none"
}

func eitherTuple(e Either[string, Tuple[int, int]]) string = e match {
    case Right((a, b)) => s"right ${a + b}"
    case Left(err)     => s"left $err"
}

func tryTuple(t Try[Tuple[string, bool]]) string = t match {
    case Success((s, true))  => s"ok $s"
    case Success((s, false)) => s"off $s"
    case Failure(e)          => s"failed ${e.Error()}"
}

func userVariant(m Msg) string = m match {
    case Move((x, 0), label) => s"$label along x to $x"
    case Move((x, y), label) => s"$label to ($x, $y)"
    case Quit()              => "quit"
}

func structField(h Holder) string = h match {
    case Holder(("k", v), tag) => s"$tag has k=$v"
    case Holder((k, v), _)     => s"$k=${v * 2}"
    case _                     => "other"
}

func sequenceElement(xs Array[Tuple[string, int]]) string = xs match {
    case Array((k, v), rest...) => s"first $k=$v, ${rest.Size()} more"
    case _                      => "empty"
}

func tupleInTuple(t Tuple[Tuple[int, int], string]) string = t match {
    case ((a, b), s) => s"$s ${a * b}"
    case _           => "never"
}

func main() {
    Println(optionTuple(Some((1, "a"))))
    Println(optionTuple(None()))
    Println(eitherTuple(Right[string, Tuple[int, int]]((2, 3))))
    Println(eitherTuple(Left[string, Tuple[int, int]]("bad")))
    Println(tryTuple(Success(("x", true))))
    Println(tryTuple(Success(("y", false))))
    Println(userVariant(Move(Pos = (4, 0), Label = "slide")))
    Println(userVariant(Move(Pos = (1, 2), Label = "jump")))
    Println(userVariant(Quit()))
    Println(structField(Holder(Pair = ("k", 7), Tag = "h")))
    Println(structField(Holder(Pair = ("z", 5), Tag = "h")))
    Println(sequenceElement(ArrayOf(("a", 1), ("b", 2))))
    Println(sequenceElement(EmptyArray[Tuple[string, int]]()))
    Println(tupleInTuple(((3, 4), "area")))
}
-- examples/nested_type_match.gala --
package main

import "fmt"

func main() {
    val opt = Some("hello")

    val res = opt match {
        case Some(s: string) => "Found string: " + s
        case Some(i: int)    => "Found int: " + fmt.Sprintf("%d", i)
        case None()          => "Nothing"
        case _               => "Other"
    }

    fmt.Println(res)

    val opt2 = Some(42)
    val res2 = opt2 match {
        case Some(s: string) => "Found string: " + s
        case Some(i: int)    => fmt.Sprintf("Found int: %d", i)
        case _               => "Other"
    }
    fmt.Println(res2)
}
-- examples/nested_wildcard_type_pattern.gala --
package main

import . "martianoff/gala/collection_immutable"

// A wildcard type pattern, `e: Tagged[_]`, matches every instantiation of
// Tagged, at the top level and nested inside another pattern: in a Failure, in
// a Some, in a tuple element, in a struct field and in a sequence element. A
// typed pattern in a tuple element tests the element's type and binds it.
struct Tagged[T any](Tag T)

func (e Tagged[T]) Error() string = s"tag ${e.Tag}"

struct NotTagged()

struct Holder[T any](V T)

struct Report(Err error)

func (e NotTagged) Error() string = "plain"

func describe(t Try[int]) string = t match {
    case Failure(e: Tagged[_]) => s"tagged failure: $e"
    case Failure(e) => s"other failure: ${e.Error()}"
    case Success(v) => s"success $v"
}

func main() {
    Println(describe(Failure(Tagged(Tag = "x"))))
    Println(describe(Failure(Tagged(Tag = 7))))
    Println(describe(Failure(NotTagged())))
    Println(describe(Success(1)))

    val some = Some(Tagged(Tag = 3)) match {
        case Some(e: Tagged[_]) => s"some ${e.Tag}"
        case _ => "none"
    }
    Println(some)

    val pair = (Tagged(Tag = 1.5), 2) match {
        case Tuple(e: Tagged[_], n) => s"tuple ${e.Tag} $n"
        case _ => "no"
    }
    Println(pair)

    val typed = (Tagged(Tag = "k"), 2) match {
        case Tuple(e: Tagged[string], n) => s"typed ${e.Tag} $n"
        case _ => "no"
    }
    Println(typed)

    val held = Holder(Tagged(Tag = 4)) match {
        case Holder(e: Tagged[_]) => s"holder ${e.Tag}"
        case _ => "no"
    }
    Println(held)

    val report = Report(Tagged(Tag = "r")) match {
        case Report(e: Tagged[_]) => s"report: $e"
        case _ => "no"
    }
    Println(report)

    val seq = ArrayOf(Tagged(Tag = 5), Tagged(Tag = 6)) match {
        case Array(e: Tagged[_], _) => s"array ${e.Tag}"
        case _ => "no"
    }
    Println(seq)

    val err error = Tagged(Tag = "y")
    val top = err match {
        case e: Tagged[_] => s"top $e"
        case _ => "other"
    }
    Println(top)
}
-- examples/newimmutable_nil.gala --
package main

import (
    "fmt"
    . "martianoff/gala/std"
)

// Demonstrates that val fields use Option[T] for optional values (not nil).

struct Config(
    name string,
    port Option[int],
)

func main() {
    val c1 = Config(name = "dev", port = None[int]())
    fmt.Println(c1.name)
    fmt.Println(c1.port)

    val c2 = Config(name = "prod", port = Some(8080))
    fmt.Println(c2.name)
    fmt.Println(c2.port)
}
-- examples/newline_deref_statement.gala --
package main

// Inside a block, a '*' or '&' that starts a line written directly against its
// operand (`*p`, `&n`), right after a line that ends in a name, a literal, ')',
// ']' or '}', begins a new statement. It never multiplies or bitwise-ands the
// line before. With a space after it (`* b`), or where no statement can begin
// (inside '(' or '[', a composite literal, match arms, or at the top level),
// it is still a binary operator that continues the line before.

// A deref expression after a val: `&n` and `*p + 1` are two statements, not
// `&n * p + 1`. The address is taken of a var.
func derefAfterVal() int {
    var n = 1
    val p = &n
    *p + 1
}

// A deref assignment after a call.
func derefAssignAfterCall() int {
    var n = 1
    val p = &n
    Println(s"before $n")
    *p = 5
    n
}

// A deref as the trailing value of a block, right after a val.
func derefTrailing(var n int) int {
    Println(s"doubled ${n * 2}")
    val p = &n
    *p
}

// An address-of as the trailing value of a block, after a call. The result is
// a plain pointer, so the target is a var.
func addressTrailing() *int {
    var n = 9
    Println("addr")
    &n
}

func main() {
    Println(derefAfterVal())
    Println(derefAssignAfterCall())
    Println(derefTrailing(7))
    Println(*addressTrailing())

    // An operator followed by a space at line start still continues.
    val width = 6
    val area = width
        * 7
    val mask = area
        & 15
    Println(area)
    Println(mask)
}
-- examples/newline_paren_statement.gala --
package main

import . "martianoff/gala/collection_immutable"

// A '(' that starts a line, right after a line that ends in a name, a literal,
// ')', ']' or '}', begins a new statement. It never calls the line before, so a
// parenthesised trailing value can follow any statement.

// The trailing tuple follows a typed val: `1` and `(a, 2)` are two statements,
// not the call `1(a, 2)`.
func pair() Tuple[int64, int] {
    val a int64 = 1
    (a, 2)
}

// The trailing tuple follows a call: `Println(...)` and `(n, label)` are two
// statements, not the call `Println(...)(n, label)`.
func labelled(n int) Tuple[int, string] {
    val label = s"n=$n"
    Println(s"labelling $n")
    (n, label)
}

// A parenthesised grouping starts the trailing value after a statement.
func doubledSum(a int, b int) int {
    Println(s"summing $a and $b")
    (a + b) * 2
}

// A trailing lambda after a statement that ends in ')'.
func adder(n int) func(int) int {
    Println(s"adder $n")
    (x) => x + n
}

// The trailing tuple follows an if statement's closing '}'.
func clamp(n int) Tuple[int, bool] {
    val clamped = n > 10
    if (clamped) { Println(s"clamping $n") }
    (if (clamped) 10 else n, clamped)
}

func main() {
    Println(pair())
    Println(labelled(7))
    Println(doubledSum(2, 3))
    Println(adder(5)(1))
    Println(clamp(42))

    // What still continues across a line break: call arguments on their own
    // lines, a method chain with leading dots, and an operator at line start.
    val sum = add(
        1,
        (2 + 3),
    )
    val total = sum
        + 10
    val words = ArrayOf("b", "a", "c")
        .Sorted()
        .Map(_ + "!")
        .MkString(" ")
    Println(total)
    Println(words)
}

func add(a int, b int) int = a + b
-- examples/newline_split_header.gala --
package main

// A func, if or for header split across lines still opens a block. A line in
// that block that starts with `*p`, `&n` or '(' begins a new statement, just
// as in a block whose header is on one line. It never continues the line
// before.

// The '{' on its own line after the result type.
func derefAfterBraceOnNextLine(var n int) int
{
    val p = &n
    val k = 1
    *p + k
}

// The parameters on the line after the name, the result on the line after
// them. The result is a plain pointer, so the target is a var.
func addressAfterWrappedHeader
(n int)
    *int {
    var m = n
    Println(s"wrapped $m")
    &m
}

// A wrapped receiver header: the method name on the line after the receiver.
struct Counter(start int)

func (c Counter)
    plus(n int) int {
    var total = c.start
    val p = &total
    *p = total + n
    total
}

// A for whose '{' is on its own line.
func sumBelow(limit int) int {
    var i = 0
    var sum = 0
    for i < limit
    {
        val p = &sum
        *p = sum + i
        i = i + 1
    }
    sum
}

// An if whose condition is wrapped and whose '{' is on its own line.
func pairIf(a bool, b bool) Tuple[int, int] {
    var x = 0
    if (a &&
        b)
    {
        val p = &x
        *p = 1
    }
    (x, 2)
}

func main() {
    Println(derefAfterBraceOnNextLine(4))
    Println(*addressAfterWrappedHeader(3))
    Println(Counter(10).plus(5))
    Println(sumBelow(5))
    Println(pairIf(true, true))
}
-- examples/none_branch_result_type.gala --
package main

// A bare `None()` that is the value of a match arm or an if/else branch takes
// the type of the value the match or if produces, never the type of the
// matched value. With an expected type (a typed val, a result type, an
// argument) that type is used; without one, the type the other arms or
// branches produce, whichever order they come in.

struct Drag(X int)

func describe(d Option[Drag]) string = d match {
    case Some(Drag(x)) => s"drag at $x"
    case _ => "no drag"
}

// Typed by the sibling arm `Some(v)`: Option[T], not the subject's Option[int].
func pick[T comparable](o Option[int], v T, fallback T) T {
    val m = o match {
        case Some(_) => Some(v)
        case None() => None()
    }
    m.GetOrElse(fallback)
}

// The same with the `None()` arm first.
func pickReversed[T comparable](o Option[int], v T, fallback T) T {
    val m = o match {
        case None() => None()
        case Some(_) => Some(v)
    }
    m.GetOrElse(fallback)
}

// The sibling arm wins over the enclosing result type (Option[int]).
func labelLength(o Option[int]) Option[int] {
    val m = o match {
        case Some(n) => Some(s"n=$n")
        case _ => {
            Println("  (empty)")
            None()
        }
    }
    m.Map(_.Size())
}

// A typed val.
func flipped(o Option[int]) string {
    val m Option[string] = o match {
        case Some(_) => None()
        case _ => Some("was empty")
    }
    m.GetOrElse("was full")
}

// A result type.
func flip(o Option[int]) Option[string] = o match {
    case Some(_) => None()
    case _ => Some("was empty")
}

// An argument.
func dragOf(o Option[int]) string = describe(o match {
    case Some(_) => None()
    case _ => Some(Drag(3))
})

// If/else branches, either order.
func choose[T comparable](b bool, v T, fallback T) T {
    val m = if (b) Some(v) else None()
    m.GetOrElse(fallback)
}

func chooseReversed[T comparable](b bool, v T, fallback T) T {
    val m = if (b) None() else Some(v)
    m.GetOrElse(fallback)
}

func main() {
    Println(pick(Some(1), "x", "fallback"))
    Println(pick(None(), "x", "fallback"))
    Println(pickReversed(Some(1), 2.5, 0.5))
    Println(pickReversed(None(), 2.5, 0.5))
    Println(labelLength(Some(42)))
    Println(labelLength(None()))
    Println(flipped(Some(1)))
    Println(flipped(None()))
    Println(flip(Some(1)).IsEmpty())
    Println(flip(None()).GetOrElse("?"))
    Println(dragOf(Some(1)))
    Println(dragOf(None()))
    Println(choose(true, "yes", "no"))
    Println(choose(false, "yes", "no"))
    Println(chooseReversed(true, 1, 0))
    Println(chooseReversed(false, 1, 0))
}
-- examples/none_downward_inference.gala --
package main

import . "martianoff/gala/std"
import . "martianoff/gala/collection_immutable"

// A bare `None()` infers its element type from context, so callers never need
// to spell out `None[Array[JField]]()` when the type is predictable.

sealed type JField {
    case JF(Name string)
}

sealed type JsonValue {
    case JObj(Fields Array[JField])
    case JNull()
}

// Match arm: `Some(fields)` pins the element type; the `None()` arm inherits it
// via the method's declared return type.
func (v JsonValue) AsObject() Option[Array[JField]] = v match {
    case JObj(fields) => Some(fields)
    case _ => None()
}

// Plain function return type pins the element type directly.
func firstName(v JsonValue) Option[string] = v.AsObject() match {
    case Some(fields) => fields.HeadOption().Map((f) => f.Name)
    case None() => None()
}

func main() {
    val obj = JObj(ArrayOf(JF("id"), JF("name")))
    val empty = JNull()

    Println(obj.AsObject().IsDefined())
    Println(empty.AsObject().IsDefined())
    Println(firstName(obj).GetOrElse("<none>"))
    Println(firstName(empty).GetOrElse("<none>"))
}
-- examples/none_generic_call_arg.gala --
package main

// A bare `None()` passed as an argument takes its type from the parameter it
// fills, whether the callee is generic or not. A parameter that names none of
// the callee's type parameters (`Option[Drag]`) is typed as declared; one that
// does (`Option[T]`) is typed once T is fixed by explicit type arguments or by
// the other arguments. Positional and named arguments, functions and methods
// all behave the same.

struct Drag(X int)

func describe(d Option[Drag]) string = d match {
    case Some(Drag(x)) => s"drag at $x"
    case _ => "no drag"
}

func take[T comparable](d Option[Drag], v T) string = s"${describe(d)}, v=$v"

func orElse[T comparable](d Option[T], v T) T = d.GetOrElse(v)

struct Board(Name string)

func (b Board) Take[T comparable](d Option[Drag], v T) string = s"${b.Name}: ${describe(d)}, v=$v"

func (b Board) OrElse[T comparable](d Option[T], v T) T = d.GetOrElse(v)

struct Cell[T comparable](V T)

func (c Cell[T]) Put(d Option[Drag]) string = s"${describe(d)}, cell=${c.V}"

func (c Cell[T]) Or(d Option[T]) T = d.GetOrElse(c.V)

// The parameter's type wins over the enclosing result type (Option[string]).
func label(v int) Option[string] = Some(take(None(), v))

func main() {
    Println(take[int](None(), 1))
    Println(take(None(), 2))
    Println(take(Some(Drag(7)), 3))
    Println(orElse[int](None(), 4))
    Println(orElse(None(), "five"))
    Println(take(v = 6, d = None()))
    Println(orElse(v = 7.5, d = None()))

    val board = Board("main")
    Println(board.Take(None(), 8))
    Println(board.Take[string](None(), "nine"))
    Println(board.OrElse(None(), true))

    Println(Cell(10).Put(None()))
    Println(Cell("eleven").Or(None()))

    Println(label(12).GetOrElse("none"))
}
-- examples/none_positional_struct_arg.gala --
package main

// A bare None() passed positionally to a struct constructor takes its type
// from the field it fills, as it does for a named argument or a function
// argument.

import . "martianoff/gala/collection_immutable"

struct Address(Street string, Zip Option[string])

struct Member(Id int, Nickname Option[string], Tags List[string], Home Address)

struct Slot[T any](Value Option[T], Fallback T)

func describe(m Member) string {
    val nick = m.Nickname.GetOrElse("-")
    val zip = m.Home.Zip.GetOrElse("-")
    s"${m.Id} ${nick} ${m.Tags.Size()} ${m.Home.Street} ${zip}"
}

func main() {
    val bare = Member(1, None(), EmptyList[string](), Address("", None()))
    val named = Member(2, Some("bo"), ListOf("a"), Address("Main St", Some("123")))
    Println(describe(bare))
    Println(describe(named))
    val slot = Slot[string](None(), "fallback")
    Println(slot.Value.GetOrElse(slot.Fallback))
}
-- examples/octal_binary_literals.gala --
package main

// Regression example: modern Go-style integer literal prefixes parse.
//   0o / 0O — octal, introduced in Go 1.13 (file mode literals)
//   0b / 0B — binary
//   0<digits> — classic implicit octal, retained for compatibility
//   0x / 0X — hex (already supported)

func main() {
    val modeNew = 0o644     // Go 1.13+ explicit octal
    val modeOld = 0644      // classic implicit octal — same value
    val modeCaps = 0O755    // uppercase 0O
    val mask = 0b10101010   // binary
    val maskCaps = 0B1111   // uppercase 0B
    val addr = 0xdeadbeef   // hex

    Println(modeNew)
    Println(modeOld)
    Println(modeCaps)
    Println(mask)
    Println(maskCaps)
    Println(addr)
    Println(modeNew == modeOld)
}
-- examples/opaque_type_basic.gala --
package main

import "time"

// Opaque types: distinct types over a scalar, lowered to Go defined types.
// Construction and unwrapping are conversions, operators come from the
// underlying type, untyped constants mix, and methods are declared like on
// any other type. Nothing is inherited from the underlying type.

// UserID identifies a user.
opaque type UserID int64

// Millis is a duration in milliseconds.
opaque type Millis int64

// Email is an e-mail address (not validated: see GALA.MD for private-field
// structs when it must be).
opaque type Email string

// Enabled is a feature switch.
opaque type Enabled bool

// Label is a display label.
type Label string

// Name is declared over an alias of string.
opaque type Name Label

// Timeout is declared over a Go named scalar; it does not inherit
// time.Duration's methods.
opaque type Timeout time.Duration

// Seconds converts the duration to seconds.
func (m Millis) Seconds() float64 = float64(m) / 1000.0

// Plus adds two durations.
func (m Millis) Plus(other Millis) Millis = m + other

// String renders the address in angle brackets.
func (e Email) String() string = s"<${string(e)}>"

// Duration converts back to the Go type it is declared over.
func (t Timeout) Duration() time.Duration = time.Duration(t)

func lookup(id UserID) string = s"user #${int64(id)}"

func slowest(a Millis, b Millis) Millis = if (a > b) a else b

// Session holds opaque-typed fields.
struct Session(User UserID, Took Millis, Mail Email)

func main() {
    // Construct and unwrap.
    val id = UserID(42)
    val raw = int64(id)
    Println(lookup(id), raw)

    // Operators of the underlying type, on the opaque type itself.
    val took = Millis(1500) + 500
    Println(took, took > Millis(1000), took.Seconds(), took.Plus(Millis(250)))
    Println(slowest(Millis(10), Millis(20)), took * 2, took / Millis(4))

    // Untyped constants mix, as in Go.
    val zero Millis = 0
    Println(id == 42, zero, lookup(7), took - 1)

    // String() makes it a fmt.Stringer, used by Println and interpolation.
    val mail = Email("ada@example.com")
    Println(mail, s"mail: $mail")

    // Over an alias, a bool and a Go named scalar.
    Println(Name("ada"), Enabled(true) == Enabled(false), !bool(Enabled(true)))
    Println(Timeout(time.Second).Duration(), int64(Timeout(5)))

    // A struct field of an opaque type.
    val session = Session(id, took, mail)
    Println(session.User, session.Took.Seconds(), session.Mail)

    // The generated Hash and Compare.
    Println(id.Hash() == UserID(42).Hash(), took.Compare(zero), zero.Compare(took), took.Compare(Millis(2000)))
}
-- examples/opaque_type_codec.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/json"
    "martianoff/gala/yaml"
    "time"
)

// A JSON or YAML codec writes an opaque type as its underlying value: as a
// struct field, inside an Option, Array or List, and as a HashMap key or
// value. Every shape round-trips through both formats.

// UserID identifies a user.
opaque type UserID int64

// Email is an e-mail address.
opaque type Email string

// Score is a rating.
opaque type Score float64

// Active says whether the profile is active.
opaque type Active bool

// Wait is a retry backoff.
opaque type Wait time.Duration

// Handle is a user-chosen name.
type Handle string

// Nick is declared over an alias of string.
opaque type Nick Handle

// Profile holds an opaque type in every codec position.
struct Profile(
    Id UserID,
    Mail Email,
    Rating Score,
    On Active,
    Backoff Wait,
    Nick Nick,
    Friends Array[UserID],
    History List[Score],
    Backup Option[Email],
    Owner Option[UserID],
    ByMail HashMap[Email, UserID],
)

func sample() Profile = Profile(
    Id = UserID(42),
    Mail = Email("ada@example.com"),
    Rating = Score(4.5),
    On = Active(true),
    Backoff = Wait(5),
    Nick = Nick("ada"),
    Friends = ArrayOf(UserID(1), UserID(2)),
    History = ListOf(Score(3.5), Score(4.0)),
    Backup = Some(Email("backup@example.com")),
    Owner = None(),
    ByMail = EmptyHashMap[Email, UserID]().Put(Email("bo@example.com"), UserID(7)),
)

func main() {
    val p = sample()

    val jsonCodec = json.Codec[Profile](json.SnakeCase())
    val encoded = jsonCodec.Encode(p).Get()
    Println(encoded)
    val fromJson = jsonCodec.Decode(encoded).Get()
    Println(s"json round-trip equal: ${fromJson.Equal(p)}")
    Println(fromJson.ByMail.Get(Email("bo@example.com")), fromJson.Friends, fromJson.Owner)

    val yamlCodec = yaml.Codec[Profile](yaml.SnakeCase())
    val yamlText = yamlCodec.Encode(p).Get()
    Println(yamlText)
    Println(s"yaml round-trip equal: ${yamlCodec.Decode(yamlText).Get().Equal(p)}")

    // OmitEmpty treats an opaque type's zero value as empty.
    val omit = json.Codec[Profile](json.AsIs()).OmitEmpty("Id").OmitEmpty("Mail").OmitEmpty("Rating").OmitEmpty("On").OmitEmpty("Backoff")
    val empty = p.Copy(
        Id = 0,
        Mail = "",
        Rating = 0,
        On = false,
        Backoff = 0,
        Nick = "",
        Friends = EmptyArray(),
        History = EmptyList(),
        Backup = None(),
        ByMail = EmptyHashMap(),
    )
    Println(omit.Encode(empty).Get())

    // Decoding reads the bare underlying value back into the opaque type.
    val decoded = jsonCodec.Decode("{\"id\":9,\"mail\":\"x@y\",\"friends\":[3],\"by_mail\":{\"k@y\":4}}").Get()
    Println(decoded.Id, decoded.Mail, decoded.Friends, decoded.ByMail.Get(Email("k@y")))
}
-- examples/opaque_type_collections.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    cm "martianoff/gala/collection_mutable"
)

// Opaque types as collection keys and sorted elements. A Go defined type
// matches none of the collections' primitive cases, so without the generated
// Hash and Compare a HashMap key panics ("must implement std.Hashable") and
// Sorted panics ("does not support ordering").

// UserID identifies a user.
opaque type UserID int64

// Email is an e-mail address.
opaque type Email string

// Score is a rating.
opaque type Score float64

// Port is a TCP port.
opaque type Port uint16

// Flag is a feature switch.
opaque type Flag bool

// Priority declares its own Compare (highest first), which replaces the
// generated one.
opaque type Priority int

// Compare orders higher priorities first.
func (p Priority) Compare(other Priority) int = int(other) - int(p)

func main() {
    // HashMap and HashSet keys.
    val names = EmptyHashMap[UserID, string]().Put(UserID(2), "bo").Put(UserID(1), "al")
    Println(names.Get(UserID(1)), names.Get(UserID(3)), names.Size())
    val mails = HashSetOf(Email("a@x"), Email("b@x"), Email("a@x"))
    Println(mails.Size(), mails.Contains(Email("b@x")), mails.Contains(Email("c@x")))
    val flags = HashSetOf(Flag(true), Flag(false), Flag(true))
    Println(flags.Size())

    // Sorted, TreeSet and TreeMap.
    Println(ArrayOf(UserID(3), UserID(1), UserID(2)).Sorted())
    Println(TreeSetOf(Score(0.5), Score(0.25), Score(1.5)).ToArray())
    Println(TreeMapOf((Port(8080), "http"), (Port(22), "ssh")).Keys())
    Println(ListOf(Email("c@x"), Email("a@x"), Email("b@x")).Sorted())

    // A user-declared Compare is the one used.
    Println(ArrayOf(Priority(1), Priority(3), Priority(2)).Sorted())

    // Grouping by an opaque key.
    val visits = ArrayOf(UserID(1), UserID(2), UserID(1), UserID(1))
    val counts = visits.FoldLeft(EmptyHashMap[UserID, int](), (acc, u) => acc.Put(u, acc.Get(u).GetOrElse(0) + 1))
    Println(counts.Get(UserID(1)), counts.Get(UserID(2)))

    // Mutable collections too.
    val seen = cm.EmptyHashMap[Email, int]()
    seen.Put(Email("a@x"), 1)
    seen.Put(Email("a@x"), 2)
    Println(seen.Get(Email("a@x")), seen.Size())
}
-- examples/opaque_type_cross_pkg/billing/billing.gala --
package billing

import "time"

// Opaque types another package uses: in signatures, as struct fields of its
// own structs, as HashMap keys and through a codec.

// CustomerID identifies a customer.
opaque type CustomerID int64

// Cents is an amount of money.
opaque type Cents int64

// Sku names a product.
opaque type Sku string

type Code string

// Region is declared over an alias of this package; an importer encoding it
// reads the underlying type from this package.
opaque type Region Code

// Timeout is a wait, over a Go named type an importer need not import.
opaque type Timeout time.Duration

// Ref refers to an entity of type T by number.
opaque type Ref[T any] int64

// Dollars renders the amount.
func (c Cents) Dollars() string = f"$$${float64(c) / 100.0}%.2f"

// Charge describes a charge of amount to a customer.
func Charge(id CustomerID, amount Cents) string = s"charge #${int64(id)} ${amount.Dollars()}"

// Total adds up amounts.
func Total(a Cents, b Cents) Cents = a + b
-- examples/opaque_type_cross_pkg/main.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/json"
    "martianoff/gala/yaml"
    "martianoff/gala/examples/opaque_type_cross_pkg/billing"
)

// Opaque types declared in another package: converted, passed, compared,
// used as map keys and sorted, and encoded as struct fields of this package.

// Order holds opaque types declared in billing.
struct Order(
    Buyer billing.CustomerID,
    Total billing.Cents,
    Lines HashMap[billing.Sku, billing.Cents],
    Region billing.Region,
)

func main() {
    val buyer = billing.CustomerID(7)
    val total = billing.Total(billing.Cents(1250), 55)
    Println(billing.Charge(buyer, total), int64(buyer), total > billing.Cents(1000))

    val byCustomer = EmptyHashMap[billing.CustomerID, string]().Put(buyer, "ada")
    Println(byCustomer.Get(billing.CustomerID(7)))
    Println(ArrayOf(billing.Cents(300), billing.Cents(100), billing.Cents(200)).Sorted())

    val order = Order(buyer, total,
        EmptyHashMap[billing.Sku, billing.Cents]().Put(billing.Sku("pen"), billing.Cents(300)),
        billing.Region("eu"))
    val jsonCodec = json.Codec[Order](json.SnakeCase())
    val encoded = jsonCodec.Encode(order).Get()
    Println(encoded)
    Println(s"json round-trip equal: ${jsonCodec.Decode(encoded).Get().Equal(order)}")
    val yamlCodec = yaml.Codec[Order](yaml.SnakeCase())
    Println(s"yaml round-trip equal: ${yamlCodec.Decode(yamlCodec.Encode(order).Get()).Get().Equal(order)}")

    // The opaque-type pattern works across the package boundary too.
    Println(
        describe(buyer),
        describe(billing.CustomerID(0)),
        json.Value[billing.Sku]().Encode(billing.Sku("pen")),
    )
    Println(region(billing.Region("eu")), wait(billing.Timeout(2000000000)))

    // A phantom-typed opaque type of another package, as a field and a root.
    val link = Link(billing.Ref[Order](4))
    val linkCodec = json.Codec[Link](json.SnakeCase())
    val linked = linkCodec.Encode(link)
    Println(linked, linked.FlatMap((s) => linkCodec.Decode(s)).Map((l) => l.Equal(link)))
    Println(json.Value[billing.Ref[Order]]().Decode("9"))
}

// Link refers to an order through billing's phantom-typed Ref.
struct Link(Target billing.Ref[Order])

func region(r billing.Region) string = r match {
    case billing.Region(code) => s"region $code"
    case _ => "unreachable"
}

func wait(t billing.Timeout) string = t match {
    case billing.Timeout(d) => s"wait ${d.String()}"
    case _ => "unreachable"
}

func describe(id billing.CustomerID) string = id match {
    case billing.CustomerID(0) => "guest"
    case billing.CustomerID(n) => s"customer $n"
    case _ => "unreachable"
}
-- examples/opaque_type_match.gala --
package main

// Pattern matching on opaque types: the `case UserID(n)` extractor unwraps
// the underlying value, literal patterns compare it, stable identifiers name
// constants of the type, and a type pattern tells an opaque value apart from
// a value of its underlying type. Opaque types are not sealed, so a match on
// one ends in `case _`.

// UserID identifies a user.
opaque type UserID int64

// Email is an e-mail address.
opaque type Email string

// Level is a log level, an open enum over int.
opaque type Level int

// Debug is the most verbose level.
val Debug Level = 0

// Error is the least verbose level.
val Error Level = 2

// Account pairs an owner with an address.
struct Account(Owner UserID, Mail Email)

func describe(id UserID) string = id match {
    case UserID(0) => "nobody"
    case 42 => "the answer"
    case UserID(n) if n < 0 => s"invalid $n"
    case UserID(n) => s"user $n"
    case _ => "unreachable"
}

func levelName(l Level) string = l match {
    case Debug => "debug"
    case Error => "error"
    case Level(n) => s"level $n"
    case _ => "unreachable"
}

func kind(v any) string = v match {
    case UserID(n) => s"a UserID holding $n"
    case n: int64 => s"a plain int64 $n"
    case e: Email => s"an Email $e"
    case _ => "something else"
}

// label matches a value of any type: the pattern checks it holds a UserID.
func label[T any](v T) string = v match {
    case UserID(n) => s"id $n"
    case _ => "not an id"
}

// isID only checks the value is a UserID.
func isID(v any) bool = v match {
    case UserID(_) => true
    case _ => false
}

// first unwraps a UserID nested in an Option.
func first(o Option[UserID]) string = o match {
    case Some(UserID(n)) => s"first $n"
    case _ => "none"
}

func owner(a Account) string = a match {
    case Account(UserID(0), _) => "unowned"
    case Account(UserID(n), Email(m)) if m != "" => s"$n <$m>"
    case Account(UserID(n), _) => s"$n (no mail)"
    case _ => "unreachable"
}

func main() {
    Println(
        describe(UserID(0)), "|", describe(UserID(42)), "|",
        describe(UserID(-3)), "|", describe(UserID(7)),
    )
    Println(levelName(Debug), levelName(Error), levelName(Level(5)))
    Println(kind(UserID(1500)), "|", kind(int64(1500)), "|", kind(Email("a@b")), "|", kind("x"))
    Println(label(UserID(9)), "|", label(int64(9)))
    Println(isID(UserID(1)), isID(int64(1)), first(Some(UserID(3))), first(None()))
    Println(
        owner(Account(UserID(0), Email("root@x"))), "|",
        owner(Account(UserID(5), Email("ada@x"))), "|",
        owner(Account(UserID(6), Email(""))),
    )
}
-- examples/opaque_type_mixed/ids/ids.gala --
package ids

// Opaque types of a package that mixes GALA and hand-written Go. value.go
// gives AccountID a database/sql/driver Valuer, a signature GALA cannot
// spell; hash.go declares AccountID's Hash, so the transpiler does not
// generate one (it would be a duplicate method). Its Compare is still
// generated.

// AccountID identifies an account.
opaque type AccountID int64

// Ticket is an opaque type with nothing hand-written in Go.
opaque type Ticket string

// Label renders the account for display.
func (a AccountID) Label() string = s"acct-${int64(a)}"

// Next is the following account number.
func Next(a AccountID) AccountID = a + 1
-- examples/opaque_type_mixed/main.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/opaque_type_mixed/ids"
)

// Opaque types of a mixed GALA + Go package: a method declared in Go
// (Value, through ids.Stored) and one declared in GALA (Label) on the same
// type, a hand-written Hash used by HashMap, and the generated Compare used
// by Sorted.

func main() {
    val acct = ids.AccountID(1042)
    Println(acct.Label(), ids.Stored(acct), acct.Hash())
    val owners = EmptyHashMap[ids.AccountID, string]().Put(acct, "ada").Put(ids.Next(acct), "bo")
    Println(owners.Get(ids.AccountID(1043)), owners.Size())
    Println(ArrayOf(ids.AccountID(3), ids.AccountID(1), ids.AccountID(2)).Sorted())
    Println(HashSetOf(ids.Ticket("t-1"), ids.Ticket("t-1")).Size())
}
-- examples/opaque_type_phantom.gala --
package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/json"
    "martianoff/gala/yaml"
)

// Phantom type parameters: one `opaque type Id[T any] int64` gives every
// entity its own ID type. Id[User] and Id[Order] are both an int64 at run
// time, but neither passes for the other; a deliberate change of kind goes
// through the underlying type. Each instantiation keeps the generated Hash
// and Compare, and encodes as the bare number.

// User is an account holder.
struct User(Name string)

// Order is a purchase.
struct Order(Total int)

// Id identifies an entity of type T.
opaque type Id[T any] int64

// Next is the following ID of the same kind.
func (i Id[T]) Next() Id[T] = i + 1

func userName(id Id[User], names HashMap[Id[User], string]) string = names.Get(id).GetOrElse("?")

func orderTotal(id Id[Order]) int = int(id) * 10

// Receipt refers to a user and an order by ID.
struct Receipt(Buyer Id[User], Item Id[Order])

func main() {
    val ada = Id[User](1)
    val bo = ada.Next()
    val names = EmptyHashMap[Id[User], string]().Put(ada, "ada").Put(bo, "bo")
    Println(userName(ada, names), userName(bo, names), userName(Id[User](9), names))

    val order = Id[Order](7)
    Println(orderTotal(order), orderTotal(order.Next()))

    // Converting one kind of ID into another is explicit.
    val reused = Id[Order](int64(ada))
    Println(orderTotal(reused))

    Println(ArrayOf(Id[User](3), ada, bo).Sorted(), TreeSetOf(order, Id[Order](2)).ToArray())

    val receipt = Receipt(ada, order)
    val codec = json.Codec[Receipt](json.SnakeCase())
    val encoded = codec.Encode(receipt)
    Println(encoded, encoded.FlatMap((s) => codec.Decode(s)).Map((r) => r.Equal(receipt)))

    // The root value of a codec can be an opaque type too.
    Println(json.Value[Id[User]]().Encode(ada), json.Value[Id[User]]().Decode("5"))
    Println(yaml.Value[Array[Id[Order]]]().Encode(ArrayOf(order, Id[Order](8))))
}
