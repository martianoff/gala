package main

struct Item(Name string, Price int)

func findItem(name string) Option[Item] {
    if name == "apple" { return Some(Item(name, 100)) }
    return None[Item]()
}
-- examples/multi_file_option/main.gala --
package main

import "fmt"

func describeItem(opt Option[Item]) string {
    return opt match {
        case Some(item) => fmt.Sprintf("Found: %s ($%d)", item.Name, item.Price)
        case None() => "Not found"
    }
}

func main() {
    val r = findItem("apple")
    fmt.Println(r.IsDefined())
    fmt.Println(describeItem(r))

    val r2 = findItem("banana")
    fmt.Println(r2.IsDefined())
    fmt.Println(describeItem(r2))
}
-- examples/multi_file_types/main.gala --
package main

import "fmt"

func main() {
    // Use struct from sibling file
    val alice = Person("Alice", 30)
    fmt.Println(alice.Greet())

    // Use sealed type from sibling file
    val c = Circle(3.14)
    val r = Rectangle(10.0, 20.0)
    fmt.Println(describe(c))
    fmt.Println(describe(r))

    // Pattern match on sealed type from sibling file
    val shape Shape = Circle(2.5)
    val result = shape match {
        case Circle(radius) => fmt.Sprintf("Matched circle: %.1f", radius)
        case Rectangle(w, h) => fmt.Sprintf("Matched rect: %.0fx%.0f", w, h)
    }
    fmt.Println(result)
}
