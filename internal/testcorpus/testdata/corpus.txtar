-- examples/stable_identifier_pattern.gala --
package main

// A capitalized identifier in pattern position that names an in-scope value is
// a stable identifier: the arm compares the subject for equality with that
// value, as in Scala. It is NOT a fresh binding — a binding matches every value,
// so the first such arm would silently swallow all the others. These cases
// assert the RUNTIME answer, because that failure mode compiles and exits 0.

type Environment string

val Development Environment = "development"
var Production Environment = "production"

func describe(env Environment) string = env match {
    case Development => "dev"
    case Production  => "prod"
    case _           => s"other: $env"
}

val Answer = 42

// Stable identifiers nest inside extractors, tuples and struct patterns.
func probe(o Option[int]) string = o match {
    case Some(Answer) => "the answer"
    case Some(n)      => s"some $n"
    case None()       => "none"
}

func pair(p Tuple[int, string]) string = p match {
    case (Answer, s) => s"answer with $s"
    case _           => "no answer"
}

struct Point(X int, Y int)

val Origin = 0

func axis(p Point) string = p match {
    case Point(Origin, y) => s"on the y axis at $y"
    case Point(x, Origin) => s"on the x axis at $x"
    case _                => "off both axes"
}

func main() {
    Println(describe(Production))
    Println(describe(Development))
    Println(describe(Environment("staging")))

    Println(probe(Some(42)))
    Println(probe(Some(7)))
    Println(probe(None[int]()))

    Println(pair((42, "a")))
    Println(pair((7, "b")))

    Println(axis(Point(0, 5)))
    Println(axis(Point(3, 0)))
    Println(axis(Point(3, 5)))

    // A local capitalized val is a stable identifier too.
    val Limit = 10
    val hits = 10 match {
        case Limit => "at the limit"
        case _     => "not at the limit"
    }
    Println(hits)

    // A lowercase identifier always binds a fresh variable, shadowing any
    // outer value of the same name. Compare against a lowercase value with a
    // guard.
    val limit = 10
    val below = 3 match {
        case n if n == limit => "at the lowercase limit"
        case n               => s"bound $n"
    }
    Println(below)
}
-- examples/std_shadow_lib/types.gala --
package std_shadow_lib

import . "martianoff/gala/collection_immutable"

// Each type below is named like a std type. A package's own declarations
// shadow the implicitly imported std names, so every bare reference in this
// package means the declaration here.

// Seq is this package's sequence of ints; it shadows std's Seq.
type Seq Array[int]

// Holder carries a Seq.
struct Holder(Items Seq)

// Make returns a Holder of 1, 2, 3.
func Make() Holder = Holder(ArrayOf(1, 2, 3))

// Hashable is a key with a precomputed code; it shadows std's Hashable.
struct Hashable(Key string, Code int)

// CodeOf returns the code of h.
func CodeOf(h Hashable) int = h.Code
-- examples/std_shadow_lib/use.gala --
package std_shadow_lib

// A sibling file sees the package's own Seq and Hashable too.

// Total adds up the items of h.
func Total(h Holder) int = h.Items.FoldLeft(0, (acc, x) => acc + x)

// Rekey returns h under the key k, keeping its code.
func Rekey(h Hashable, k string) Hashable = Hashable(k, h.Code)

// FirstItem returns the first item of s; std's Option stays in scope.
func FirstItem(s Seq) Option[int] = s.HeadOption()

// Void is a function named like std's Void type; a bare `Void(...)` in this
// package calls it.
func Void(n int) int = n + 100

// Bump defaults n to a call of the package's Void, lowered at each use site.
func Bump(n int = Void(1)) int = n
-- examples/std_type_in_lambda.gala --
// Regression test: std types like Tuple and Option should be auto-qualified
// with std. prefix when used in lambda parameter types.
package main

import (
    "fmt"
)

// Uses Tuple in a function parameter type - should be qualified with std.
func processTuple(t Tuple[int, string]) string {
    val res = t match {
        case (a, b) => fmt.Sprintf("(%d, %s)", a, b)
        case _ => "Unknown"
    }
    return res
}

// Uses Option in a function parameter type - should be qualified with std.
func processOption(opt Option[int]) string {
    val res = opt match {
        case Some(v) => fmt.Sprintf("Some(%d)", v)
        case _ => "None"
    }
    return res
}

// Uses std types in generic container callback
type Container[T any] struct {
    Value T
}

func (c Container[T]) MapToString(f func(T) string) string {
    return f(c.Value)
}

func main() {
    // Test Tuple in function parameter
    val t = (42, "answer")
    fmt.Println(processTuple(t))

    // Test Option in function parameter
    val opt = Some(100)
    fmt.Println(processOption(opt))

    // Test Tuple in a lambda parameter - the main regression case
    val tupleContainer = Container[Tuple[int, int]](Value = (1, 2))
    val result = tupleContainer.MapToString((tup Tuple[int, int]) => {
        val res = tup match {
            case (a, b) => fmt.Sprintf("sum=%d", a + b)
            case _ => "Unknown"
        }
        return res
    })
    fmt.Println(result)

    // Test Option in a lambda parameter
    val optContainer = Container[Option[string]](Value = Some("hello"))
    val result2 = optContainer.MapToString((o Option[string]) => {
        val res = o match {
            case Some(s) => s
            case _ => "empty"
        }
        return res
    })
    fmt.Println(result2)

    fmt.Println("Done")
}
-- examples/std_type_qualified.gala --
package main

import (
    lib "martianoff/gala/examples/std_shadow_lib"
    "martianoff/gala/std"
)

// std_shadow_lib declares `func Void(n int)`, a name std declares as a type.
// Dot-imported, a bare `Void` would name both (GALA-E0087), so each side is
// written with its qualifier: `lib.Void` for the function, `std.Void` for
// std's type. A type position (`Try[Void]`) names std's type unqualified.

func done() Try[Void] = Success(std.Void())

func main() {
    Println(lib.Void(1))
    Println(std.NoSuchElementError("gone").Error())
    Println(done().IsSuccess())
}
-- examples/string_builder.gala --
package main

import (
    "fmt"
    . "martianoff/gala/strings"
)

func main() {
    // Basic construction and appending
    val sb = NewStringBuilder()
    sb.AppendString("Hello")
    sb.AppendString(", ")
    sb.AppendString("World!")
    fmt.Println(sb.ToString())

    // Chaining
    val result = NewStringBuilder()
        .AppendString("a")
        .AppendString("b")
        .AppendString("c")
        .ToString()
    fmt.Println(result)

    // From Str
    val sb2 = NewStringBuilderFrom(S("start"))
    sb2.AppendString("-end")
    fmt.Println(sb2.ToString())

    // AppendLine
    val sb3 = NewStringBuilder()
    sb3.AppendStringLine("line1")
    sb3.AppendStringLine("line2")
    fmt.Print(sb3.ToString())

    // Reset
    val sb4 = NewStringBuilderFromString("data")
    fmt.Println(sb4.NonEmpty())
    sb4.Reset()
    fmt.Println(sb4.IsEmpty())

    // Length counts characters, ByteSize counts UTF-8 bytes
    val sb5 = NewStringBuilderFromString("héllo").AppendString(" 日本")
    fmt.Println(sb5.Length())
    fmt.Println(sb5.ByteSize())

    // ToStr
    val sb6 = NewStringBuilderFromString("gala")
    val s = sb6.ToStr()
    fmt.Println(s.ToString())
}
-- examples/string_escapes.gala --
package main

// Verification for GALA's string escape set.
//
// A literal's raw text is copied verbatim into the generated Go, so GALA
// accepts exactly the escapes Go accepts inside an interpreted literal:
//
//     \a \b \f \n \r \t \v \\ \" \xHH \uHHHH \UHHHHHHHH \OOO
//
// An unrecognised escape - "\d", a regular expression whose backslash was not
// doubled, is the usual offender - is a compile-time error (GALA-E0038)
// reported at the offending escape, rather than Go source that does not
// compile. This example exercises the accepted set end to end.
func main() {
    // Printable escapes.
    Println("quote:[\"] backslash:[\\]")

    // Hex and octal escapes both denote 'A'.
    Println("hex:[\x41] octal:[\101]")

    // A regular expression needs its backslash doubled.
    Println("regex:[\\d{4}]")

    // A backtick raw string has no escapes at all: every backslash is literal.
    Println(`raw:[\d{4}]`)

    // The seven control escapes, one byte each.
    val controls = "\a\b\f\n\r\t\v"
    Println(controls.ByteSize())

    // Unicode escapes, measured in bytes so the output stays ASCII.
    val eacute = "\u00e9"
    val grin = "\U0001F600"
    Println(s"eacute:[${eacute.ByteSize()}] grin:[${grin.ByteSize()}]")

    // Interpolated and format strings share the same escape set.
    val year = 2026
    Println(s"year:[$year] quote:[\"] backslash:[\\]")
    Println(f"padded:[${year}%06d]")

    // Rune literals take the single-character escapes, printed as code points.
    Println('\n')
    Println('\t')
    Println('\\')
    Println('\'')
}
-- examples/string_interpolation.gala --
package main

func main() {
    val name = "Alice"
    val age = 30
    val pi = 3.14159
    val flag = true

    // s-string: auto-inferred format verbs
    Println(s"Hello $name!")
    Println(s"$name is $age years old")
    Println(s"Pi is approximately $pi")
    Println(s"Flag is $flag")

    // Expression interpolation
    Println(s"Next year: ${age + 1}")
    Println(s"Name length: ${name.Size()}")

    // Literal dollar sign
    Println(s"Price: $$99")

    // f-string: explicit format specs
    Println(f"Padded: $age%05d")
    Println(f"Fixed point: $pi%.2f")
    Println(f"Hex: $age%x")

    // No interpolation — plain string
    Println(s"No interpolation here")

    // Mixed
    val x = 42
    val y = 3.7
    Println(s"x=$x, y=$y, sum=${x + int(y)}")
}
-- examples/strings_basics.gala --
package main

import (
    . "martianoff/gala/strings"
    . "martianoff/gala/collection_immutable"
)

// Verifies the free-function surface of the unified `strings` package
// (the `Str` wrapper has its own example in `string_builder.gala`).
// Names mirror Go's `strings.X` exactly so migration from `strings.X`
// is a one-line import swap with no logic change.

func main() {
    // Predicates — the heavy hitters in consumer code.
    Println(s"contains: ${Contains("hello world", "world")}")     // true
    Println(s"hasPrefix: ${HasPrefix("/api/v1/users", "/api/")}") // true
    Println(s"hasSuffix: ${HasSuffix("file.gala", ".gala")}")     // true
    Println(s"equalFold: ${EqualFold("Foo", "FOO")}")             // true
    Println(s"lastIndex: ${LastIndex("a/b/c", "/")}")             // 3

    // Trim family — no more reaching for go strings imports.
    Println(s"trimSpace: '${TrimSpace("   spaced   ")}'")         // 'spaced'
    Println(s"trimPrefix: ${TrimPrefix("/api/v1", "/api")}")      // /v1
    Println(s"trimSuffix: ${TrimSuffix("file.gala", ".gala")}")   // file
    Println(s"trim: ${Trim("xxhelloxx", "x")}")                   // hello
    Println(s"trimLeft: ${TrimLeft("xxhelloxx", "x")}")           // helloxx
    Println(s"trimRight: ${TrimRight("xxhelloxx", "x")}")         // xxhello

    // Case folding.
    Println(s"toLower: ${ToLower("HELLO World")}")                // hello world
    Println(s"toUpper: ${ToUpper("hello World")}")                // HELLO WORLD

    // Build-up.
    Println(s"repeat: ${Repeat("-", 5)}")                         // -----
    Println(s"replace: ${Replace("a-a-a-a", "a", "b", 2)}")       // b-b-a-a
    Println(s"replaceAll: ${ReplaceAll("a/b/c", "/", ".")}")      // a.b.c

    // Split / Fields / Join — return GALA Array[string].
    val parts = Split("alpha,beta,gamma", ",")
    Println(s"split: ${parts.MkString("|")}")                     // alpha|beta|gamma

    val twoTokens = SplitN("alpha,beta,gamma,delta", ",", 2)
    Println(s"splitN(2): ${twoTokens.MkString("|")}")             // alpha|beta,gamma,delta

    val tokens = Fields("  hello   world  ")
    Println(s"fields: ${tokens.MkString("|")}")                   // hello|world

    val joined = Join(ArrayOf("a", "b", "c"), " · ")
    Println(s"join: ${joined}")                                   // a · b · c
}
-- examples/struct_expected_type/units/units.gala --
package units

// Quantity is an amount tagged with its unit. The unit is a phantom type
// parameter: no field names it, so a construction takes it from its expected
// type.
struct Quantity[U any](Amount float64)

// Meters tags a Quantity measured in meters.
struct Meters()

// Seconds tags a Quantity measured in seconds.
struct Seconds()

// Distance is a Quantity of meters.
type Distance Quantity[Meters]

// Of builds a Quantity whose unit is this function's result type.
func Of(amount float64) Quantity[Seconds] = Quantity(amount)

// Measure builds a Quantity through its companion Apply; the unit comes from
// the expected type, matched against the Quantity Apply returns.
struct Measure[U any]()

// Apply builds a Quantity of amount in the unit U.
func (m Measure[U]) Apply(amount float64) Quantity[U] = Quantity[U](amount)
-- examples/struct_expected_type_test.gala --
package main

import "martianoff/gala/examples/struct_expected_type/units"

// A generic struct construction takes the type arguments its fields leave
// open from the expected type: `Tag("x")` in a function returning `Tag[int]`
// is a `Tag[int]`. That holds in every position an expected type reaches it
// from, through an alias of the struct type, and for structs of another
// package.

struct Tag[T any](Name string)

struct Pair[A any, B any](First A)

type Field[T any] struct {
    Label string
}

type IntTag Tag[int]

func (t Tag[T]) Describe() string = s"tag ${t.Name}"

func (p Pair[A, B]) Describe() string = s"pair ${p.First}"

func exprBody() Tag[int] = Tag("expr")

func blockValue(n int) Tag[int] {
    val name = s"block $n"
    Tag(name)
}

func earlyReturn(n int) Tag[int] {
    if (n < 0) {
        return Tag("negative")
    }
    Tag(Name = "non-negative")
}

func branches(flag bool) Tag[string] = if (flag) Tag("then") else Tag("else")

func arms(n int) Tag[bool] = n match {
    case 0 => Tag("zero")
    case _ => {
        val name = s"n=$n"
        Tag(name)
    }
}

func viaAlias() IntTag = Tag("alias")

func partly(n int) Pair[int, string] = Pair(n)

func typeStruct() Field[int] = Field(Label = "field")

struct Marker[T any]()

struct Boxed[T any](Value T)

func marker() Marker[string] = Marker()

func widened() Boxed[int64] = Boxed(1)

func takeTag(t Tag[int]) string = t.Describe()

func build(f func(int) Tag[int]) Tag[int] = f(7)

struct Holder(Inner Tag[int])

func remote(amount float64) units.Quantity[units.Meters] = units.Quantity(amount)

func remoteAlias(amount float64) units.Distance = units.Quantity(amount)

// A companion Apply construction follows the same rule, matching the expected
// type against what Apply returns. Only the construction that is the result
// value takes the result type: the helper below writes its own.
struct MkTag[T any]()

func (m MkTag[T]) Apply(name string) Tag[T] = Tag[T](name)

func viaApply() Tag[int] = MkTag("apply")

func applyBlock(n int) Tag[bool] {
    val helper = MkTag[string](s"helper $n")
    MkTag(s"${helper.Name} done")
}

func variantArms(n int) Either[string, int] = n match {
    case 0 => Left("zero")
    case _ => Right(n)
}

func remoteApply(amount float64) units.Quantity[units.Meters] = units.Measure(amount)

// A generic function whose type parameter only its result mentions takes it
// from the slot its call fills, under the same rule.
func emptyTag[T any]() Tag[T] = Tag[T]("empty")

func namedTag[T any](name string) Tag[T] = Tag[T](name)

func viaCall() Tag[int] = emptyTag()

func viaCallBranches(n int) Tag[string] = if (n > 0) namedTag(s"call $n") else emptyTag()

func takeBoolTag(t Tag[bool]) string = t.Describe()

// A branch with no type argument of its own takes it from its siblings.
func siblings(flag bool) string {
    val marker = if (flag) Marker[int]() else Marker()
    val tag = if (flag) MkTag("sibling") else Tag[bool]("other")
    val called = if (flag) emptyTag() else Tag[int]("other")
    s"$marker ${takeBoolTag(tag)} ${takeTag(called)}"
}

// So does a generic method, with or without arguments, in every slot: the
// result, an argument and an annotated val. Only the call that fills the slot
// takes its type; the receiver the call is made on does not.
func (t Tag[T]) Retag[U any]() Tag[U] = Tag[U](t.Name)

func (t Tag[T]) Rename[U any](name string) Tag[U] = Tag[U](name)

func retagged() Tag[int] = Tag[string]("retag").Retag()

func methodSlots() string {
    val renamed Tag[bool] = Tag[int]("x").Rename("renamed")
    s"${takeTag(Tag[string]("arg").Retag())} ${takeBoolTag(renamed)}"
}

func main() {
    Println(exprBody().Describe())
    Println(blockValue(2).Describe())
    Println(earlyReturn(-1).Describe())
    Println(earlyReturn(1).Describe())
    Println(branches(true).Describe())
    Println(branches(false).Describe())
    Println(arms(0).Describe())
    Println(arms(3).Describe())
    Println(viaAlias().Name)
    Println(partly(5).Describe())
    Println(typeStruct().Label)
    Println(s"${marker()}")
    Println(widened().Value)

    val annotated Tag[float64] = Tag("annotated")
    Println(annotated.Describe())
    Println(takeTag(Tag("argument")))
    Println(Holder(Tag("field")).Inner.Describe())
    Println(build((n) => Tag(s"lambda $n")).Describe())

    Println(remote(3.5).Amount)
    Println(remoteAlias(2.5).Amount)
    Println(units.Of(1.5).Amount)

    Println(viaApply().Describe())
    Println(applyBlock(4).Describe())
    Println(variantArms(0))
    Println(variantArms(2))
    Println(remoteApply(4.5).Amount)
    val measured units.Quantity[units.Seconds] = units.Measure(5.5)
    Println(measured.Amount)

    Println(viaCall().Describe())
    Println(viaCallBranches(1).Describe())
    Println(viaCallBranches(0).Describe())
    Println(siblings(true))
    Println(siblings(false))
    Println(retagged().Describe())
    Println(methodSlots())
}
-- examples/struct_features.gala --
package main

import "fmt"

type Point struct {
    var X int
    var Y int
}

func createPoint(x int, y int) Point {
    var p Point
    p.X = x
    p.Y = y
    return p
}

type Person struct {
    Name string
    var Age int
}

func main() {
    val p1 = createPoint(10, 20)
    val p2 = p1.Copy()

    fmt.Println("p1:", p1)
    fmt.Println("p2 (copy of p1):", p2)
    fmt.Println("p1 == p2?", p1.Equal(p2))

    val p3 = createPoint(10, 21)
    fmt.Println("p3:", p3)
    fmt.Println("p1 == p3?", p1.Equal(p3))

    // Test with immutable fields
    // Since we don't have struct literals, we can't easily initialize immutable fields
    // unless they are passed in constructor or something.
    // In GALA, default for field is immutable.
}
-- examples/struct_field_defaults.gala --
package main

// Shorthand struct fields may carry a default. A construction that omits the
// field takes that default — the field list reuses the grammar's parameter
// rule, so `= value` means what it means on a function parameter.
//
// Omitting a field that has NO default is GALA-E0045, so a literal cannot
// quietly leave a zero where a value belongs. Go-style literals (`Cfg{...}`)
// keep Go's semantics and stay partial.

struct Cfg(
    Name  string,
    Mask  rune = '•',
    Tries int  = 3,
)

// Defaults may reference other declarations, and are evaluated at each
// construction rather than once at declaration.
func defaultLabel() string = "unnamed"

struct Labeled(Id int, Label string = defaultLabel())

func main() {
    // Named construction omitting both defaulted fields.
    val a = Cfg(Name = "a")
    Println(a.Name, int(a.Mask), a.Tries)

    // Positional construction stopping after the required field.
    val b = Cfg("b")
    Println(b.Name, int(b.Mask), b.Tries)

    // Explicit values win over the defaults.
    val c = Cfg(Name = "c", Mask = 'x', Tries = 9)
    Println(c.Name, int(c.Mask), c.Tries)

    // Copy carries fields forward from the receiver — it does not re-default.
    val d = c.Copy(Name = "d")
    Println(d.Name, int(d.Mask), d.Tries)

    // A default that calls a function.
    val e = Labeled(Id = 7)
    Println(e.Id, e.Label)

    // A brace literal leaves fields out as a call does: they take their
    // declared defaults. The brace form is deliberate here: that both
    // spellings give the same value is what this example pins.
    val f = Cfg{Name: "f"}
    Println(f.Name, int(f.Mask), f.Tries)
}
-- examples/struct_field_defaults_crosspkg.gala --
package main

import (
    "martianoff/gala/examples/struct_defaults_lib"
)

// Field defaults declared in one package, applied at a construction site in
// another. The default is source text on the declaring package's metadata and
// is transformed where the construction happens, so every name it borrows has
// to be re-qualified for that scope: `EmptyArray[Entry]()` must reach Go as
// `EmptyArray[struct_defaults_lib.Entry]()`, and `DefaultTag()` as
// `struct_defaults_lib.DefaultTag()`.

func main() {
    // Omits all three defaulted fields.
    val a = struct_defaults_lib.Config(Name = "a")
    Println(a.Name, a.Entries.Size(), a.Tag, a.Retries)

    // Positional, stopping after the required field.
    val b = struct_defaults_lib.Config("b")
    Println(b.Name, b.Entries.Size(), b.Tag, b.Retries)

    // Explicit values still win.
    val c = struct_defaults_lib.Config(Name = "c", Tag = "set", Retries = 9)
    Println(c.Name, c.Entries.Size(), c.Tag, c.Retries)

    // Positional, then named: the rest take their defaults.
    val d = struct_defaults_lib.Config("d", Retries = 5)
    Println(d.Name, d.Entries.Size(), d.Tag, d.Retries)
}
-- examples/struct_field_unwrap/main.gala --
package main

import "fmt"

func printPair(key string, value int) {
    fmt.Println(key, value)
}

func describe(p Pair) string = fmt.Sprintf("%s=%d", p.Key, p.Value)

func main() {
    val p = Pair("hello", 42)
    printPair(p.Key, p.Value)
    fmt.Println(p.Key, p.Value)
    fmt.Println(describe(p))
}
