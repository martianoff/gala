"""stdlib_gala_packages: whether each stdlib package is a GALA package to Bazel.

Under go_export_data, the transpile rules hand the transpiler the compiled Go
export data of every library a GALA target reaches, except GALA packages, whose
types it reads from their .gala source. rules_go has no notion of a GALA
package, so rules_gala decides it per library with gala_go_deps_aspect: a
library is GALA when it embeds a target carrying GalaLibraryInfo. Every
gala_library does that itself; a hand-wired one (gala_bootstrap_transpile plus
a plain go_library) must embed :gala_package from stdlib_gala_package().

This rule applies that same aspect to each stdlib library, notes whether the
package ships .gala sources, and writes both out as Go for
gala_packages_test.go. The aspect and its provider are loaded from rules_gala's
private API on purpose: the check must ask exactly what the transpile rules ask.
If rules_gala moves them, this load breaks the build instead of the check going
quiet. The load lives in this package alone, so it can break nothing else.
"""

load("@rules_gala//gala/private:go_exports.bzl", "GalaGoExportsInfo", "gala_go_deps_aspect")

def _impl(ctx):
    if len(ctx.attr.libraries) != len(ctx.attr.sources):
        fail("libraries and sources must list the same packages, in order")
    lines = [
        "// Code generated by //%s:%s. DO NOT EDIT." % (ctx.label.package, ctx.label.name),
        "",
        "package galapackages",
        "",
        "var stdlibPackages = []stdlibPackage{",
    ]
    for lib, srcs in zip(ctx.attr.libraries, ctx.attr.sources):
        has_gala = any([f.extension == "gala" for f in srcs.files.to_list()])
        lines.append('\t{dir: "%s", hasGala: %s, isGala: %s},' % (
            lib.label.package,
            "true" if has_gala else "false",
            "true" if lib[GalaGoExportsInfo].is_gala else "false",
        ))
    lines.append("}")
    ctx.actions.write(ctx.outputs.out, "\n".join(lines) + "\n")

_stdlib_gala_packages = rule(
    implementation = _impl,
    attrs = {
        "libraries": attr.label_list(aspects = [gala_go_deps_aspect], mandatory = True),
        "sources": attr.label_list(allow_files = True, mandatory = True),
        "out": attr.output(mandatory = True),
    },
)

def stdlib_gala_packages(name, packages, out, **kwargs):
    """Writes `out`: for each package, whether it has .gala sources and whether its go_library is GALA.

    Args:
        name: The target name.
        packages: Stdlib package directories; each has a go_library named after
            it and a :shipped_sources filegroup.
        out: The Go file to write.
        **kwargs: Common rule attributes.
    """
    _stdlib_gala_packages(
        name = name,
        libraries = ["//" + p for p in packages],
        sources = ["//%s:shipped_sources" % p for p in packages],
        out = out,
        **kwargs
    )
