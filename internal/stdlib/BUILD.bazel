load("@rules_go//go:def.bzl", "go_library", "go_test")

# Generate embedded stdlib Go file from transpiled sources and GALA source files.
# This uses gala_bootstrap (not gala) to avoid circular dependency.
# GALA source files are included so the analyzer can extract type metadata.
genrule(
    name = "generate_embedded",
    srcs = [
        # std package - transpiled Go
        "//std:option_go",
        "//std:immutable_go",
        "//std:tuple_go",
        "//std:either_go",
        "//std:iterable_go",
        "//std:seq_go",
        "//std:hashable_go",
        "//std:ordered_go",
        "//std:try_go",
        "//std:errors_go",
        "//std:constptr_go",
        "//std:types.go",
        "//std:interfaces.go",
        "//std:embedded_fs.go",
        # std package - GALA source (for analyzer)
        "//std:option.gala",
        "//std:immutable.gala",
        "//std:tuple.gala",
        "//std:either.gala",
        "//std:iterable.gala",
        "//std:seq.gala",
        "//std:hashable.gala",
        "//std:ordered.gala",
        "//std:try.gala",
        "//std:errors.gala",
        "//std:constptr.gala",
        "//std:meta_go",
        "//std:meta.gala",
        # json package
        "//json:json_go",
        "//json:codec_go",
        "//json:naming_go",
        "//json:json.gala",
        "//json:codec.gala",
        "//json:helpers_go",
        "//json:helpers.gala",
        "//json:naming.gala",
        "//json:byte_utils.go",
        # yaml package
        "//yaml:yaml_go",
        "//yaml:naming_go",
        "//yaml:helpers_go",
        "//yaml:yaml.gala",
        "//yaml:naming.gala",
        "//yaml:helpers.gala",
        "//yaml:codec.go",
        # go_interop package
        "//go_interop:types.go",
        # go_builtins package (dependency-free leaf: Panic)
        "//go_builtins:builtins.go",
        # resource package (Bracket/Using/WithLock) - transpiled Go + GALA source
        "//resource:resource_go",
        "//resource:resource.gala",
        # collection_immutable package - transpiled Go
        "//collection_immutable:array_go",
        "//collection_immutable:list_go",
        "//collection_immutable:hashmap_go",
        "//collection_immutable:hashset_go",
        "//collection_immutable:treeset_go",
        "//collection_immutable:treemap_go",
        # collection_immutable package - GALA source
        "//collection_immutable:array.gala",
        "//collection_immutable:list.gala",
        "//collection_immutable:hashmap.gala",
        "//collection_immutable:hashset.gala",
        "//collection_immutable:treeset.gala",
        "//collection_immutable:treemap.gala",
        # collection_mutable package - transpiled Go
        "//collection_mutable:array_go",
        "//collection_mutable:list_go",
        "//collection_mutable:hashmap_go",
        "//collection_mutable:hashset_go",
        "//collection_mutable:treeset_go",
        "//collection_mutable:treemap_go",
        # collection_mutable package - GALA source
        "//collection_mutable:array.gala",
        "//collection_mutable:list.gala",
        "//collection_mutable:hashmap.gala",
        "//collection_mutable:hashset.gala",
        "//collection_mutable:treeset.gala",
        "//collection_mutable:treemap.gala",
        # concurrent package - transpiled Go
        "//concurrent:future_go",
        "//concurrent:retry_go",
        "//concurrent:event_bus_go",
        "//concurrent:execution_context.go",
        # concurrent package - GALA source
        "//concurrent:future.gala",
        "//concurrent:retry.gala",
        "//concurrent:event_bus.gala",
        # validation package - transpiled Go
        "//validation:validated_go",
        # validation package - GALA source
        "//validation:validated.gala",
        # stream package - transpiled Go
        "//stream:stream_go",
        # stream package - GALA source
        "//stream:stream.gala",
        # lazy package - transpiled Go
        "//lazy:lazy_go",
        # lazy package - GALA source
        "//lazy:lazy.gala",
        # strings package - transpiled Go
        "//strings:strings_go",
        # strings package - GALA source
        "//strings:strings.gala",
        # time_utils package - transpiled Go
        "//time_utils:time_utils_go",
        # time_utils package - GALA source
        "//time_utils:time_utils.gala",
        # regex package - transpiled Go
        "//regex:regex_go",
        # regex package - GALA source
        "//regex:regex.gala",
        # io package - transpiled Go
        "//io:io_go",
        # io package - GALA source
        "//io:io.gala",
        # path package - transpiled Go
        "//path:path_go",
        # path package - GALA source
        "//path:path.gala",
        # fs package - transpiled Go
        "//fs:fs_go",
        "//fs:dir_ops_go",
        "//fs:streaming_go",
        # fs package - GALA source
        "//fs:fs.gala",
        "//fs:dir_ops.gala",
        "//fs:streaming.gala",
        # subprocess package - GALA surface + Go-side helpers (errors.As / scanner buffer)
        "//subprocess:subprocess_go",
        "//subprocess:async_go",
        "//subprocess:subprocess.gala",
        "//subprocess:async.gala",
        "//subprocess:subprocess.go",
        # test package - transpiled Go
        "//test:assertions_go",
        "//test:bench_go",
        "//test:framework_go",
        "//test:table_go",
        # test package - GALA source
        "//test:assertions.gala",
        "//test:bench.gala",
        "//test:framework.gala",
        "//test:table.gala",
        # crypto package - transpiled Go
        "//crypto:crypto_go",
        # crypto package - GALA source
        "//crypto:crypto.gala",
    ],
    outs = ["embedded_gen.go"],
    cmd = "$(location //cmd/stdlib_gen) -output $@ $(SRCS)",
    tools = ["//cmd/stdlib_gen"],
    visibility = ["//visibility:private"],
)

# The stdlib source tree as it exists in the repo: every non-test .gala and
# hand-written .go file of every embedded package (each package's
# :shipped_sources glob), rendered as a Go list. embed_completeness_test.go
# compares it against EmbeddedPackages, so a file added to a stdlib package but
# forgotten in generate_embedded above fails `bazel test` — repo-source builds
# cannot notice the omission; only the released CLI would.
genrule(
    name = "source_tree_files",
    srcs = [
        "//collection_immutable:shipped_sources",
        "//collection_mutable:shipped_sources",
        "//concurrent:shipped_sources",
        "//crypto:shipped_sources",
        "//fs:shipped_sources",
        "//go_builtins:shipped_sources",
        "//go_interop:shipped_sources",
        "//io:shipped_sources",
        "//json:shipped_sources",
        "//lazy:shipped_sources",
        "//path:shipped_sources",
        "//regex:shipped_sources",
        "//resource:shipped_sources",
        "//std:shipped_sources",
        "//stream:shipped_sources",
        "//strings:shipped_sources",
        "//subprocess:shipped_sources",
        "//test:shipped_sources",
        "//time_utils:shipped_sources",
        "//validation:shipped_sources",
        "//yaml:shipped_sources",
    ],
    outs = ["source_tree_files_gen_test.go"],
    cmd = """
{
  echo '// Code generated by //internal/stdlib:source_tree_files. DO NOT EDIT.'
  echo ''
  echo 'package stdlib'
  echo ''
  echo '// sourceTreeFiles lists every shipped stdlib source file in the repo,'
  echo '// as workspace-relative paths (e.g. "concurrent/future.gala").'
  echo 'var sourceTreeFiles = []string{'
  for f in $(SRCS); do echo "    \\"$$f\\","; done
  echo '}'
} > $@
""",
    visibility = ["//visibility:private"],
)

go_library(
    name = "stdlib",
    srcs = [
        "embedded_gen.go",
        "fingerprint.go",
        "stdlib.go",
    ],
    importpath = "martianoff/gala/internal/stdlib",
    visibility = ["//visibility:public"],
)

go_test(
    name = "stdlib_test",
    srcs = [
        "embed_collections_test.go",
        "embed_completeness_test.go",
        "fingerprint_test.go",
        "source_tree_files_gen_test.go",
    ],
    embed = [":stdlib"],
    deps = ["@com_github_stretchr_testify//require"],
)
