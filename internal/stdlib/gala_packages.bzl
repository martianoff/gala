"""stdlib_gala_packages: which stdlib go_library targets Bazel treats as GALA packages.

Under go_export_data, the transpile rules hand the transpiler the compiled Go
export data of every library a GALA target reaches, except GALA packages, whose
types it reads from their .gala source. rules_go has no notion of a GALA
package, so rules_gala decides it per library with gala_go_deps_aspect: a
library is GALA when it embeds a target carrying GalaLibraryInfo. Every
gala_library does that itself; a hand-wired one (gala_bootstrap_transpile plus
a plain go_library) must embed :gala_package from stdlib_gala_package().

This rule applies that same aspect to each stdlib library and writes the
verdicts out as Go, so gala_packages_test.go can hold them against the source
tree: a package with .gala sources must be GALA, a pure-Go one must not. The
aspect and its provider are loaded from rules_gala's private API on purpose: the
check must ask exactly what the transpile rules ask. If rules_gala moves them,
this load breaks the build instead of the check going quiet.
"""

load("@rules_gala//gala/private:go_exports.bzl", "GalaGoExportsInfo", "gala_go_deps_aspect")

def _stdlib_gala_packages_impl(ctx):
    lines = [
        "// Code generated by //internal/stdlib:%s. DO NOT EDIT." % ctx.label.name,
        "",
        "package stdlib",
        "",
        "// bazelGalaPackages maps each stdlib package's directory to whether its",
        "// go_library is a GALA package to rules_gala's gala_go_deps_aspect.",
        "var bazelGalaPackages = map[string]bool{",
    ]
    for lib in ctx.attr.libraries:
        is_gala = lib[GalaGoExportsInfo].is_gala
        lines.append('\t"%s": %s,' % (lib.label.package, "true" if is_gala else "false"))
    lines.append("}")
    ctx.actions.write(ctx.outputs.out, "\n".join(lines) + "\n")

stdlib_gala_packages = rule(
    implementation = _stdlib_gala_packages_impl,
    doc = "Writes a Go map from each library's package to whether rules_gala treats it as a GALA package.",
    attrs = {
        "libraries": attr.label_list(
            aspects = [gala_go_deps_aspect],
            doc = "The go_library of every stdlib package.",
            mandatory = True,
        ),
        "out": attr.output(mandatory = True),
    },
)
