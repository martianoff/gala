        "cache.go",
        "cache_codec.go",
        "collect.go",
        "collect_native.go",
        "default_scope.go",
        "dot_import_collision.go",
        "field_method_names.go",
        "go_export_importer.go",
        "go_keyword_names.go",
        "go_nocopy.go",
        "go_types.go",
        "infer_native.go",
        "opaque.go",
        "package_siblings.go",
        "path_cache.go",
        "qualifiers.go",
        "receiver_type_params.go",
        "undefined_symbol.go",
        "undefined_symbol_scope.go",
        "validation.go",
    ],
    importpath = "martianoff/gala/internal/transpiler/analyzer",
    visibility = ["//:__subpackages__"],
    deps = [
        "//galaerr",
        "//internal/parser",
        "//internal/parser/grammar",
        "//internal/parser/native",  # keep: generated, gazelle cannot resolve it
        "//internal/transpiler",
