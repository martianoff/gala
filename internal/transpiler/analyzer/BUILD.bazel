go_test(
    name = "analyzer_test",
    srcs = [
        "analyzed_pkgs_invariant_test.go",
        "analyzer_test.go",
        "batch_reuse_test.go",
        "cache_codec_test.go",
        "cache_e2e_test.go",
        "cache_test.go",
        "companion_objects_e2e_test.go",
        "companion_objects_test.go",
        "concurrent_sibling_parse_test.go",
        "cross_file_method_import_test.go",
        "default_source_test.go",
        "doc_metadata_test.go",
        "foreign_gen_go_test.go",
        "go_cgo_test.go",
        "go_export_importer_test.go",
        "go_exports_scan_test.go",
        "go_qualifier_import_test.go",
        "go_sdk_bazel_test.go",
        "go_src_dirs_test.go",
        "go_types_debug_test.go",
        "go_types_test.go",
        "import_name_test.go",
        "internal_import_test.go",
        "multipackage_panic_test.go",
        "opaque_base_test.go",
        "own_go_files_test.go",
        "package_siblings_test.go",
        "package_val_infer_test.go",
        "parallel_parse_test.go",
        "parsedfile_cache_test.go",
        "path_cache_test.go",
        "prelude_selfanalysis_test.go",
        "receiver_type_params_test.go",
        "redefinition_cross_file_test.go",
        "shorthand_field_type_test.go",
        "test_exports_test.go",
        "test_helper_test.go",
        "undefined_symbol_scope_test.go",
        "undefined_symbol_test.go",
        "validation_test.go",
    ],
    data = [
        # The undefined-symbol negative cases must genuinely resolve names
        # from these packages rather than have the check stand down on an
        # unloadable import, so their sources have to be in runfiles.
        # strings (with its collection_mutable and lazy imports) backs the
        # GALA-E0025 cases where a GALA package shares a Go package's name.
        "//collection_immutable:gala_sources",
        "//collection_mutable:gala_sources",
        "//go_interop:types.go",
        "//io:gala_sources",
        "//lazy:gala_sources",
        "//std:gala_sources",
        "//strings:gala_sources",
        # std dot-imports go_builtins, so loading std pulls it in. If it is
        # not staged, that import fails under the Linux sandbox, which now
        # stands the undefined-symbol check down for every file — silently
        # turning the positive tests below into no-ops.
        "//go_builtins:builtins.go",
    ],
    embed = [":analyzer"],
    deps = [
        "//galaerr",
        "//internal/parser",
        "//internal/parser/grammar",
        "//internal/transpiler",
        "//internal/transpiler/genheader",
        "//internal/transpiler/module",
        "//internal/transpiler/registry",
        "@com_github_antlr4_go_antlr_v4//:antlr",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/tools/bazel",
    ],
)

# The collection of declarations on the native tree, held to ANTLR's over the
# GALA sources TestEnginesAgree parses and the examples of the error reference
# pages. A target of its own: staging all of them would load packages that
# analyzer_test's cases rely on not loading. Gazelle leaves the file out of
# analyzer_test (the exclude directive) and keeps this rule as written.
# gazelle:exclude collect_native_test.go
go_test(
    # keep
    name = "collect_native_test",
    srcs = ["collect_native_test.go"],
    data = [
        "//:all_gala_sources",
        "//docs/errors:error_docs",
        "//examples:all_gala_sources",
        "//go_builtins:builtins.go",
        "//go_interop:types.go",
        "//lazy:gala_sources",
        "//resource:gala_sources",
        "//std:gala_sources",
        "//stream:gala_sources",
        "//subprocess:gala_sources",
        "//test:gala_sources",
    ],
    embed = [":analyzer"],
    deps = [
        "//internal/parser",
        "//internal/parser/grammar",
        "//internal/parser/native",
        "//internal/transpiler",
        "@rules_go//go/tools/bazel",
    ],
)
