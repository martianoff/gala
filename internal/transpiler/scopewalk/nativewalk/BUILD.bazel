load("@rules_go//go:def.bzl", "go_library", "go_test")

# The scope walk on galop's native tree.
go_library(
    name = "nativewalk",
    srcs = ["nativewalk.go"],
    importpath = "martianoff/gala/internal/transpiler/scopewalk/nativewalk",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/parser",
        "//internal/parser/native",  # keep: generated, gazelle cannot resolve it
        "//internal/transpiler/scopewalk",
    ],
)

go_test(
    name = "nativewalk_test",
    srcs = [
        "nativewalk_test.go",
        "walk_golden_test.go",
    ],
    data = ["testdata/walks.golden"],
    embed = [":nativewalk"],
    deps = [
        "//internal/digestgolden",
        "//internal/parser",
        "//internal/parser/native",  # keep
        "//internal/testcorpus",
        "//internal/transpiler/scopewalk",
    ],
)

# gazelle:exclude no_antlr_test.go
go_test(
    # keep
    name = "no_antlr_test",
    srcs = ["no_antlr_test.go"],
    data = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ) + ["BUILD.bazel"],
    deps = ["//internal/noantlr"],
)
