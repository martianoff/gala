    # Gala source files needed by the analyzer for type resolution in tests.
    # Linux CI uses a sandbox so only declared data deps are accessible.
    # If a test references types from another package (e.g. HashMap from
    # collection_immutable), add its gala_sources here or the type will
    # widen to "any" on CI while passing locally on Windows (no sandbox).
    data = [
        # Error-code reference pages read by the doc-verification guard
        # (error_docs_guard_test.go), which asserts each page quotes the
        # compiler's real output verbatim.
        "//docs/errors:error_docs",
        # Parsed by error_docs_completeness_test.go to enumerate the declared
        # error codes, so a new code without a page fails the build.
        "//galaerr:errors_src",
        "//collection_immutable:gala_sources",
        "//collection_mutable:gala_sources",
        "//examples:single_file_gala_sources",
        "//std:gala_sources",
        "//time_utils:gala_sources",
        # go_interop is a pure-Go stdlib package (no .gala). The Sendable
        # capture tests import it to build genuinely-opaque Go values (Mutex,
        # CancelToken, slices, maps) and assert they are rejected as
        # unshareable. The analyzer resolves it from types.go alone (regex
        # export scan; same as the embedded-CLI snapshot), so its source must be
        # on the sandbox search path or the import fails to resolve on Linux CI.
        "//go_interop:types.go",
        # go_builtins is the same shape as go_interop — a pure-Go stdlib
        # package the analyzer resolves from builtins.go alone. It is not
        # imported by any fixture directly; std dot-imports it, so it is
        # pulled in whenever std is loaded, and `Panic` (the sanctioned form —
        # bare `panic` is GALA-E0035) resolves through that closure. Without
        # it staged, std's import of go_builtins fails under the Linux sandbox
        # and every fixture using `Panic` loses the name.
        "//go_builtins:builtins.go",
    ],
    embed = [":transformer"],
    deps = [
        "//galaerr",
        "//internal/transpiler",
        "//internal/transpiler/analyzer",
        "//internal/transpiler/generator",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/tools/bazel",
    ],
)
