load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "concurrency",
    srcs = [
        "capture.go",
        "capture_native.go",
        "helpers.go",
        "shareable.go",
    ],
    importpath = "martianoff/gala/internal/transpiler/concurrency",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/parser/native",  # keep: generated, gazelle cannot resolve it
        "//internal/transpiler",
        "//internal/transpiler/scopewalk",
        "//internal/transpiler/scopewalk/nativewalk",
