)

go_test(
    name = "concurrency_test",
    srcs = [
        "capture_test.go",
        "shareable_test.go",
    ],
    embed = [":concurrency"],
    deps = [
        "//internal/parser",
        "//internal/parser/native",  # keep: generated, gazelle cannot resolve it
        "//internal/transpiler",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
