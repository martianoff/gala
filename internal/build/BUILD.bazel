load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "build",
    srcs = [
        "builder.go",
        "cachekey.go",
        "config.go",
        "deptranspiler.go",
        "errors.go",
        "generate.go",
        "gomod.go",
        "lock.go",
        "stdlibver.go",
        "testgen.go",
        "testmangle.go",
        "workspace.go",
    ],
    importpath = "martianoff/gala/internal/build",
    visibility = ["//:__subpackages__"],
    deps = [
        "//galaerr",
        "//internal/depman/fetch",
        "//internal/depman/mod",
        "//internal/depman/version",
        "//internal/stdlib",
        "//internal/transpiler",
        "//internal/transpiler/analyzer",
        "//internal/transpiler/generator",
        "//internal/transpiler/genheader",
        "//internal/transpiler/profiler",
        "//internal/transpiler/transformer",
        "@org_golang_x_mod//modfile",
    ],
)

go_test(
    name = "build_test",
    # Most of these tests run a real gala build or gala test, Go compile
    # included. On a CI runner the package takes 150-280s, so the default
    # medium timeout (300s) fails it intermittently.
    size = "large",
    srcs = [
        "aliased_go_subpackage_test.go",
        "apex_perf_test.go",
        "bom_test.go",
        "builder_test.go",
        "cache_dir_test.go",
        "cache_rebuild_test.go",
        "cachekey_test.go",
        "config_test.go",
        "contention_perf_test.go",
        "dep_go_types_test.go",
        "deptranspiler_test.go",
        "foreign_gen_go_test.go",
        "go_cmd_main_test.go",
        "go_subpackage_test.go",
        "go_toolchain_test.go",
        "generate_test.go",
        "gomod_test.go",
        "main_go_sibling_test.go",
        "main_package_test.go",
        "main_root_subpackage_test_test.go",
        "module_cache_immutable_test.go",
        "nested_subpackage_test.go",
        "sourcehash_test.go",
        "sourcemap_stacktrace_test.go",
        "stdlib_extract_race_test.go",
        "transpile_batch_static_test.go",
        "test_decls_scope_test.go",
        "testmangle_test.go",
        "transpile_perf_test.go",
        "tree_shape_cache_test.go",
        "workspace_isolation_test.go",
    ],
    data = [
        "builder.go",  # transpile_batch_static_test.go does AST analysis
        "//std:gala_sources",  # transpile_perf_test.go needs std for analyzer
    ],
    embed = [":build"],
    deps = [
        "//internal/depman/fetch",
        "//internal/depman/mod",
        "//internal/depman/sum",
        "//internal/stdlib",
        "//internal/transpiler",
        "//internal/transpiler/analyzer",
        "//internal/transpiler/generator",
        "//internal/transpiler/genheader",
        "//internal/transpiler/transformer",
        "@com_github_antlr4_go_antlr_v4//:antlr",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@rules_go//go/tools/bazel",
    ],
)
