# Bazel build files are written by Gazelle with LF line endings. Pin them to LF
# so a `bazel run //:gazelle` run is stable (idempotent) on Windows checkouts
# instead of showing every file as fully rewritten by CRLF<->LF churn.
*.bazel text eol=lf
*.bzl text eol=lf
BUILD text eol=lf
WORKSPACE text eol=lf
WORKSPACE.bazel text eol=lf
MODULE.bazel text eol=lf
# Shell scripts run on Linux CI; a CRLF checkout breaks the shebang line.
*.sh text eol=lf
# Go fuzz corpus entries are parsed line by line; a CRLF checkout would add a
# stray \r to every value, so a seed would no longer replay the input it holds.
internal/transpiler/fuzz/testdata/fuzz/** -text
