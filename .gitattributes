# Bazel build files are written by Gazelle with LF line endings. Pin them to LF
# so a `bazel run //:gazelle` run is stable (idempotent) on Windows checkouts
# instead of showing every file as fully rewritten by CRLF<->LF churn.
*.bazel text eol=lf
*.bzl text eol=lf
BUILD text eol=lf
WORKSPACE text eol=lf
WORKSPACE.bazel text eol=lf
MODULE.bazel text eol=lf
# Shell scripts run on Linux CI; a CRLF checkout breaks the shebang line.
*.sh text eol=lf
# Go fuzz corpus entries are parsed line by line; a CRLF checkout would add a
# stray \r to every value, so a seed would no longer replay the input it holds.
**/testdata/fuzz/** -text
# The golden tests' frozen corpus: its byte offsets must not depend on the checkout.
*.txtar text eol=lf
# The tree-sitter grammar's generated parser is checked against a fresh
# `tree-sitter generate` byte for byte, and its corpus tests compare text: keep
# the whole directory LF on every checkout.
ide/tree-sitter-gala/** text eol=lf
ide/tree-sitter-gala/src/parser.c linguist-generated
ide/tree-sitter-gala/src/grammar.json linguist-generated
ide/tree-sitter-gala/src/node-types.json linguist-generated
ide/tree-sitter-gala/src/tree_sitter/** linguist-generated
