load("@rules_go//go:def.bzl", "go_library")

exports_files(["builtins.go"])

go_library(
    name = "go_builtins",
    srcs = ["builtins.go"],
    importpath = "martianoff/gala/go_builtins",
    visibility = ["//visibility:public"],
)

# Every non-test source file this package ships. The released CLI embeds a
# snapshot of the stdlib (//internal/stdlib:generate_embedded); its
# completeness test compares that snapshot against this glob, so a new file
# here that is not added to the embed fails bazel test, not the released CLI.
filegroup(
    name = "shipped_sources",
    srcs = glob(
        [
            "*.gala",
            "*.go",
        ],
        # A pure-Go or pure-GALA package leaves one pattern empty.
        allow_empty = True,
        exclude = [
            "*_test.gala",
            "*_test.go",
            "*.gen.go",
        ],
    ),
    visibility = ["//internal/stdlib:__pkg__"],
)
