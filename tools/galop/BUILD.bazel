load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_gala//galop:toolchain.bzl", "galop_toolchain")

# galop toolchains backed by the release binaries MODULE.bazel downloads, one
# per exec platform galop publishes a binary for. galop_parser (from
# rules_gala) resolves them through @rules_gala//galop:toolchain_type.

[
    (
        native_binary(
            name = "galop_" + platform,
            src = "@galop_" + platform + "//file",
            out = "galop_" + platform + (".exe" if platform.startswith("windows") else ""),
        ),
        galop_toolchain(
            name = platform + "_impl",
            galop = ":galop_" + platform,
        ),
        toolchain(
            name = platform,
            exec_compatible_with = constraints,
            toolchain = ":" + platform + "_impl",
            toolchain_type = "@rules_gala//galop:toolchain_type",
        ),
    )
    for platform, constraints in [
        ("darwin_arm64", ["@platforms//os:macos", "@platforms//cpu:arm64"]),
        ("linux_amd64", ["@platforms//os:linux", "@platforms//cpu:x86_64"]),
        ("windows_amd64", ["@platforms//os:windows", "@platforms//cpu:x86_64"]),
    ]
]
