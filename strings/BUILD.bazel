load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_gala//gala:defs.bzl", "gala_binary", "gala_bootstrap_transpile", "gala_test")

exports_files([
    "strings.gala",
])

filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

# Bootstrap transpile for stdlib embedding.
gala_bootstrap_transpile(
    name = "strings_go",
    src = "strings.gala",
    out = "strings.gen.go",
)

go_library(
    name = "strings",
    srcs = ["strings.gen.go"],
    importpath = "martianoff/gala/strings",
    visibility = ["//visibility:public"],
    deps = [
        "//collection_immutable",  # keep
        "//collection_mutable",  # keep
        "//lazy",  # keep
        "//std",  # keep
    ],
)

gala_test(
    name = "strings_test",
    srcs = ["strings_test.gala"],
    deps = [
        ":strings",
        "//collection_immutable",
    ],
)

# Side-by-side perf benchmarks: GALA Str/StringBuilder vs Go-native
# `strings`/`strings.Builder`. Used for the table in docs/STRINGS.MD.
gala_binary(
    name = "perf_gala",
    src = "perf_test.gala",
    deps = [":strings"],
)

go_binary(
    name = "perf_go",
    srcs = ["go_native_perf_test.go"],
)
