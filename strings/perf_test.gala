package main

import (
    "unicode"
    "time"
    . "martianoff/gala/std"
    . "martianoff/gala/strings"
)

// Helper functions to work around lambda return type inference limitation
// (see docs/BUG_LAMBDA_TYPE_INFERENCE.MD)
func toUpperRune(r rune) rune = unicode.ToUpper(r)
func isLetterRune(r rune) bool = unicode.IsLetter(r)

var globalCount = 0
func countIfLetter(r rune) {
    if unicode.IsLetter(r) {
        globalCount = globalCount + 1
    }
}

// Performance test utilities
func measureNs(iterations int, f func()) int64 {
    val start = time.Now()
    for i := 0; i < iterations; i++ {
        f()
    }
    val elapsed = time.Since(start)
    return elapsed.Nanoseconds() / int64(iterations)
}

func printResult(name string, nsPerOp int64) {
    Print(f"${name}%-55s ${nsPerOp}%12d ns/op\n")
}

// ============ TEST DATA ============

val shortStr = S("Hello, World!")
val mediumStr = S(Repeat("abcdefghij", 100))
val longStr = S(Repeat("abcdefghij", 10000))
val wordsStr = S("hello world foo bar baz qux quux corge grault garply")

// ============ CREATION ============

func benchCreation() {
    val ns = measureNs(100000, () => {
        S(Repeat("abcdefghij", 100))
    })
    printResult("Str.S(1000)", ns)
}

func benchCreationLong() {
    val ns = measureNs(1000, () => {
        S(Repeat("abcdefghij", 10000))
    })
    printResult("Str.S(100000)", ns)
}

// ============ LENGTH ============

func benchLength() {
    val ns = measureNs(10000000, () => {
        mediumStr.Length()
    })
    printResult("Str.Length(1000)", ns)
}

// ============ CASE TRANSFORMATIONS ============

func benchToUpper() {
    val ns = measureNs(10000, () => {
        mediumStr.ToUpper()
    })
    printResult("Str.ToUpper(1000)", ns)
}

func benchToLower() {
    val ns = measureNs(10000, () => {
        mediumStr.ToLower()
    })
    printResult("Str.ToLower(1000)", ns)
}

// ============ TRIMMING ============

func benchTrim() {
    val padded = S("   " + Repeat("abcdefghij", 100) + "   ")
    val ns = measureNs(100000, () => {
        padded.Trim()
    })
    printResult("Str.Trim(1000)", ns)
}

// ============ REPLACE ============

func benchReplaceAll() {
    val ns = measureNs(10000, () => {
        mediumStr.ReplaceAll("abc", "xyz")
    })
    printResult("Str.ReplaceAll(1000)", ns)
}

// ============ CONTAINS / SEARCH ============

func benchContains() {
    val ns = measureNs(1000000, () => {
        mediumStr.Contains("fghij")
    })
    printResult("Str.Contains(1000)", ns)
}

func benchIndex() {
    val ns = measureNs(1000000, () => {
        mediumStr.IndexOf("fghij")
    })
    printResult("Str.IndexOf(1000)", ns)
}

// ============ SPLIT ============

func benchSplit() {
    val ns = measureNs(100000, () => {
        wordsStr.Split(" ")
    })
    printResult("Str.Split(10 words)", ns)
}

func benchSplitLong() {
    val longWords = S(Repeat("word ", 1000))
    val ns = measureNs(1000, () => {
        longWords.Split(" ")
    })
    printResult("Str.Split(1000 words)", ns)
}

// ============ REVERSE ============

func benchReverse() {
    val ns = measureNs(10000, () => {
        mediumStr.Reverse()
    })
    printResult("Str.Reverse(1000)", ns)
}

// ============ FUNCTIONAL OPS ============

func benchMap() {
    val ns = measureNs(10000, () => {
        mediumStr.Map(toUpperRune)
    })
    printResult("Str.Map(1000)", ns)
}

func benchFilter() {
    val ns = measureNs(10000, () => {
        mediumStr.Filter(isLetterRune)
    })
    printResult("Str.Filter(1000)", ns)
}

func benchForEachCount() {
    val ns = measureNs(100000, () => {
        globalCount = 0
        mediumStr.ForEach(countIfLetter)
    })
    printResult("Str.ForEach+Count(1000)", ns)
}

// ============ COMPARISON ============

func benchEquals() {
    val other = S(Repeat("abcdefghij", 100))
    val ns = measureNs(1000000, () => {
        mediumStr.Equals(other)
    })
    printResult("Str.Equals(1000)", ns)
}

// ============ CONCAT ============

func benchConcat() {
    val a = mediumStr.Take(500)
    val b = mediumStr.Drop(500)
    val ns = measureNs(100000, () => {
        a.Concat(b)
    })
    printResult("Str.Concat(500+500)", ns)
}

// ============ PREDICATES ============

func benchIsAlpha() {
    val alpha = S(Repeat("abcdefghij", 100))
    val ns = measureNs(10000, () => {
        alpha.IsAlpha()
    })
    printResult("Str.IsAlpha(1000)", ns)
}

// ============ SUBSTRING ============

func benchSubstring() {
    val ns = measureNs(100000, () => {
        mediumStr.Substring(100, 500)
    })
    printResult("Str.Substring(100,500)", ns)
}

// ============ RUNE CONVERSION ============
// Each iteration builds a fresh Str, so these include the one-time conversion
// of the string into its rune Array that the cached-Str benchmarks above skip.

val line80 = Repeat("abcdefghij", 8)
val text10k = Repeat("abcdefghij", 1000)

func benchToChars80() {
    val ns = measureNs(100000, () => {
        S(line80).ToChars()
    })
    printResult("S(80).ToChars()", ns)
}

func benchToChars10k() {
    val ns = measureNs(1000, () => {
        S(text10k).ToChars()
    })
    printResult("S(10000).ToChars()", ns)
}

func benchDrop80() {
    val ns = measureNs(100000, () => {
        S(line80).Drop(40)
    })
    printResult("S(80).Drop(40)", ns)
}

func benchSplitAt80() {
    val ns = measureNs(100000, () => {
        S(line80).SplitAt(40)
    })
    printResult("S(80).SplitAt(40)", ns)
}

func benchCapitalize80() {
    val ns = measureNs(100000, () => {
        S(line80).Capitalize()
    })
    printResult("S(80).Capitalize()", ns)
}

// ============ STRINGBUILDER ============

func benchBuilderAppend100() {
    val ns = measureNs(100000, () => {
        val sb = NewStringBuilder()
        for i := 0; i < 100; i++ {
            sb.AppendString("hello")
        }
        sb.ToString()
    })
    printResult("StringBuilder.Append(100x\"hello\")", ns)
}

func benchBuilderAppend10000() {
    val ns = measureNs(1000, () => {
        val sb = NewStringBuilder()
        for i := 0; i < 10000; i++ {
            sb.AppendString("hello")
        }
        sb.ToString()
    })
    printResult("StringBuilder.Append(10000x\"hello\")", ns)
}

func benchBuilderAppendRune() {
    val ns = measureNs(1000, () => {
        val sb = NewStringBuilder()
        for i := 0; i < 10000; i++ {
            sb.AppendRune(rune(120))
        }
        sb.ToString()
    })
    printResult("StringBuilder.AppendRune(10000x'x')", ns)
}

// ============ MAIN ============

func main() {
    Println("=== GALA Str Performance ===")
    Println("")

    Println("--- Creation / Conversion ---")
    benchCreation()
    benchCreationLong()
    Println("")

    Println("--- Length ---")
    benchLength()
    Println("")

    Println("--- Case Transformations ---")
    benchToUpper()
    benchToLower()
    Println("")

    Println("--- Trimming ---")
    benchTrim()
    Println("")

    Println("--- Replace ---")
    benchReplaceAll()
    Println("")

    Println("--- Contains / Search ---")
    benchContains()
    benchIndex()
    Println("")

    Println("--- Split ---")
    benchSplit()
    benchSplitLong()
    Println("")

    Println("--- Reverse ---")
    benchReverse()
    Println("")

    Println("--- Functional Operations ---")
    benchMap()
    benchFilter()
    benchForEachCount()
    Println("")

    Println("--- Comparison ---")
    benchEquals()
    Println("")

    Println("--- Concat ---")
    benchConcat()
    Println("")

    Println("--- Predicates ---")
    benchIsAlpha()
    Println("")

    Println("--- Substring ---")
    benchSubstring()
    Println("")

    Println("--- Rune Conversion (fresh Str) ---")
    benchToChars80()
    benchToChars10k()
    benchDrop80()
    benchSplitAt80()
    benchCapitalize80()
    Println("")

    Println("--- StringBuilder ---")
    benchBuilderAppend100()
    benchBuilderAppend10000()
    benchBuilderAppendRune()
}
