load("@rules_go//go:def.bzl", "go_library")
load("@rules_gala//gala:defs.bzl", "gala_bootstrap_transpile", "gala_test")

exports_files([
    "fs.gala",
    "streaming.gala",
    "dir_ops.gala",
])

filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

gala_bootstrap_transpile(
    name = "fs_go",
    src = "fs.gala",
    out = "fs.gen.go",
    package_files = [
        "dir_ops.gala",
        "streaming.gala",
    ],
)

gala_bootstrap_transpile(
    name = "streaming_go",
    src = "streaming.gala",
    out = "streaming.gen.go",
    package_files = [
        "dir_ops.gala",
        "fs.gala",
    ],
)

gala_bootstrap_transpile(
    name = "dir_ops_go",
    src = "dir_ops.gala",
    out = "dir_ops.gen.go",
    package_files = [
        "fs.gala",
        "streaming.gala",
    ],
)

go_library(
    name = "fs",
    srcs = [
        "dir_ops.gen.go",
        "fs.gen.go",
        "streaming.gen.go",
    ],
    importpath = "martianoff/gala/fs",
    visibility = ["//visibility:public"],
    deps = [
        "//collection_immutable",
        "//go_interop",
        "//resource",
        "//std",
        "//time_utils",
    ],
)

gala_test(
    name = "fs_test",
    srcs = ["fs_test.gala"],
    deps = [
        ":fs",
        "//collection_immutable",
        "//resource",
        "//time_utils",
    ],
)

gala_test(
    name = "streaming_test",
    srcs = ["streaming_test.gala"],
    deps = [
        ":fs",
        "//collection_immutable",
        "//resource",
    ],
)

gala_test(
    name = "dir_ops_test",
    srcs = ["dir_ops_test.gala"],
    deps = [
        ":fs",
        "//collection_immutable",
        "//resource",
        "//time_utils",
    ],
)

# Every non-test source file this package ships. The released CLI embeds a
# snapshot of the stdlib (//internal/stdlib:generate_embedded); its
# completeness test compares that snapshot against this glob, so a new file
# here that is not added to the embed fails bazel test, not the released CLI.
filegroup(
    name = "shipped_sources",
    srcs = glob(
        [
            "*.gala",
            "*.go",
        ],
        exclude = [
            "*_test.gala",
            "*_test.go",
            "*.gen.go",
        ],
        # A pure-Go or pure-GALA package leaves one pattern empty.
        allow_empty = True,
    ),
    visibility = ["//internal/stdlib:__pkg__"],
)
