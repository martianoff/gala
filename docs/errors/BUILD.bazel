load("@rules_go//go:def.bzl", "go_library", "go_test")

# The error-code reference pages are consumed as test data by the
# doc-verification guard in //internal/transpiler/transformer, which asserts
# each page quotes the compiler's real output byte-for-byte. Linux CI sandboxes
# tests, so the pages must be declared as data to be readable there.
filegroup(
    name = "error_docs",
    srcs = glob(["GALA-E*.md"]),
    visibility = ["//visibility:public"],
)

# The same pages, compiled into the CLI so `gala explain GALA-E0044` works
# offline. The Go file lives here rather than under internal/ because
# //go:embed can only reach files in its own package directory; keeping it
# beside the content is what guarantees the served page and the published page
# are the same bytes.
#
# The targets are named for the directory, not for the Go package (`errdocs`),
# because that is the name gazelle derives from the importpath: matching it is
# what makes `bazel run //:gazelle` merge into these rules instead of appending
# a second, broken pair beside them.
go_library(
    name = "errors",
    srcs = ["errdocs.go"],
    # The glob is what makes a newly added page reachable without regenerating
    # this file; gazelle would otherwise expand the //go:embed pattern into a
    # fixed list.
    # keep
    embedsrcs = glob(["GALA-E*.md"]),
    importpath = "martianoff/gala/docs/errors",
    visibility = ["//visibility:public"],
)

go_test(
    name = "errors_test",
    srcs = ["errdocs_test.go"],
    embed = [":errors"],
    deps = ["@com_github_stretchr_testify//require"],
)
