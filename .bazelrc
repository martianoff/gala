# This tells Bazel how to interact with the version control system
common --enable_bzlmod
common --noenable_workspace

# Resolve the rules_gala module from the registry hosted in
# github.com/martianoff/rules-gala. Order matters — list this first so it
# wins for the rules_gala module name.
common --registry=https://raw.githubusercontent.com/martianoff/rules-gala/main/
common --registry=https://bcr.bazel.build
build --java_runtime_version=remotejdk_17 --enable_runfiles

# Platform-specific workspace status command for version stamping
build:windows --workspace_status_command=tools/workspace_status.cmd
build:linux --workspace_status_command=tools/workspace_status.sh
build:macos --workspace_status_command=tools/workspace_status.sh

#startup --windows_enable_symlinks

# Go type inference: pass GOROOT and PATH to genrules so the transpiler
# can use go/importer to resolve Go package types (function signatures,
# struct fields, method sets, etc.).
build --action_env=GOROOT
build --action_env=PATH

# Recycle persistent workers between builds. Workers stay alive only
# for the duration of a single `bazel build`; the next invocation
# spawns a fresh pool. This loses the across-build analyzer cache
# warm-up but eliminates a Windows-specific failure mode where a
# previous build's running worker holds an exclusive lock on
# gala_worker.exe and the next build's relink step fails with
# "Permission denied" trying to overwrite the in-use binary file.
# (Linux can overwrite an executable while it runs; Windows can't.)
# In-build worker reuse — which is where the analyzer warm cache
# pays off most — is unaffected.
build --worker_quit_after_build

# The Lean spec in formal/ (rules_lean). Its targets are skipped unless this
# config is on, so a plain `bazel build //...` / `bazel test //...` never
# downloads the Lean toolchain (about 600 MB, 3.3 GB unpacked per output base).
#   bazel test --config=formal //formal/...
# See formal/README.md.
common:formal --//formal:lean

# Disk usage. Bazel keys its output base on the *path* of the workspace, so
# every git worktree of this repo gets its own multi-gigabyte output base and
# nothing reclaims it when the worktree goes away. Two things keep that in
# check:
#
#   * The exact pin in //.bazelversion, which keeps the Bazel version from
#     drifting with whatever Bazelisk considers latest and keeps a stray
#     Bazel 8 from rewriting MODULE.bazel.lock (v28) back to v16. That is a
#     reproducibility measure, not a disk one — Bazel 9's repo contents cache
#     is a fetch-time optimisation that costs disk rather than saving it.
#   * tools/bazel_gc.sh, which reports every output base with its size and
#     owning workspace and prunes the ones whose workspace is gone.
#
# See docs/BUILD_DISK_USAGE.MD.

# Machine-specific Bazel settings — a shared --disk_cache in particular. Kept
# out of the checked-in config because the path differs per developer and per
# CI runner; see docs/BUILD_DISK_USAGE.MD for what belongs here.
try-import %workspace%/.bazelrc.user
