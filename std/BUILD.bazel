load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_gala//gala:defs.bzl", "gala_bootstrap_transpile", "gala_test")

exports_files([
    "constptr.gala",
    "either.gala",
    "errors.gala",
    "hashable.gala",
    "immutable.gala",
    "iterable.gala",
    "meta.gala",
    "option.gala",
    "ordered.gala",
    "seq.gala",
    "try.gala",
    "tuple.gala",
    # Go source files for stdlib embedding
    "types.go",
    "interfaces.go",
    "embedded_fs.go",
])

# Filegroup for all GALA source files in std - used by tests
filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

gala_bootstrap_transpile(
    name = "option_go",
    src = "option.gala",
    out = "option.gen.go",
)

gala_bootstrap_transpile(
    name = "immutable_go",
    src = "immutable.gala",
    out = "immutable.gen.go",
)

gala_bootstrap_transpile(
    name = "tuple_go",
    src = "tuple.gala",
    out = "tuple.gen.go",
)

gala_bootstrap_transpile(
    name = "either_go",
    src = "either.gala",
    out = "either.gen.go",
)

gala_bootstrap_transpile(
    name = "iterable_go",
    src = "iterable.gala",
    out = "iterable.gen.go",
)

gala_bootstrap_transpile(
    name = "seq_go",
    src = "seq.gala",
    out = "seq.gen.go",
)

gala_bootstrap_transpile(
    name = "hashable_go",
    src = "hashable.gala",
    out = "hashable.gen.go",
)

gala_bootstrap_transpile(
    name = "ordered_go",
    src = "ordered.gala",
    out = "ordered.gen.go",
)

gala_bootstrap_transpile(
    name = "try_go",
    src = "try.gala",
    out = "try.gen.go",
)

gala_bootstrap_transpile(
    name = "errors_go",
    src = "errors.gala",
    out = "errors.gen.go",
)

gala_bootstrap_transpile(
    name = "constptr_go",
    src = "constptr.gala",
    out = "constptr.gen.go",
)

gala_bootstrap_transpile(
    name = "meta_go",
    src = "meta.gala",
    out = "meta.gen.go",
)

go_library(
    name = "std",
    srcs = [
        "constptr.gen.go",
        "either.gen.go",
        "embedded_fs.go",
        "errors.gen.go",
        "hashable.gen.go",
        "immutable.gen.go",
        "interfaces.go",
        "iterable.gen.go",
        "meta.gen.go",
        "option.gen.go",
        "ordered.gen.go",
        "seq.gen.go",
        "try.gen.go",
        "tuple.gen.go",
        "types.go",
    ],
    importpath = "martianoff/gala/std",
    visibility = ["//visibility:public"],
    deps = ["//go_builtins"],
)

go_test(
    name = "std_go_test",
    srcs = [
        "as_test.go",
        "unapply_test.go",
    ],
    embed = [":std"],
    deps = ["@com_github_stretchr_testify//assert"],
)

gala_test(
    name = "std_test",
    srcs = ["std_test.gala"],
)

# Every non-test source file this package ships. The released CLI embeds a
# snapshot of the stdlib (//internal/stdlib:generate_embedded); its
# completeness test compares that snapshot against this glob, so a new file
# here that is not added to the embed fails bazel test, not the released CLI.
filegroup(
    name = "shipped_sources",
    srcs = glob(
        [
            "*.gala",
            "*.go",
        ],
        exclude = [
            "*_test.gala",
            "*_test.go",
            "*.gen.go",
        ],
        # A pure-Go or pure-GALA package leaves one pattern empty.
        allow_empty = True,
    ),
    visibility = ["//internal/stdlib:__pkg__"],
)
