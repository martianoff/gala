package std

import (
    . "martianoff/gala/go_builtins"
    "math"
)

// Hashable is an interface that types can implement to provide custom hash functions.
// Used by HashSet and HashMap for efficient hashing.
//
// Primitive types (int, string, bool, etc.) are handled automatically, and the
// std value types Tuple (every arity), Option and Either implement Hashable by
// combining the hashes of the values they hold, and the immutable List and
// HashSet by hashing their elements. Custom types should implement this
// interface for use in hash-based collections.
//
// HashSet and HashMap compare keys with ==, and keys that are not == by their
// Equal method when they have one (KeysEqualByValue), so a List or a struct
// holding one is a key by value. A Hash method must agree with that: keys that
// are equal must hash alike.
//
// Example:
//   type Person struct {
//       Name string
//       Age  int
//   }
//   func (p Person) Hash() uint32 {
//       return HashCombine(HashString(p.Name), HashInt(int64(p.Age)))
//   }
type Hashable interface {
    Hash() uint32
}

// HashInt hashes an int64 value using FNV-1a bit mixing.
func HashInt(n int64) uint32 {
    var h uint32 = 2166136261
    h = h ^ uint32(n&255)
    h = h * 16777619
    h = h ^ uint32((n>>8)&255)
    h = h * 16777619
    h = h ^ uint32((n>>16)&255)
    h = h * 16777619
    h = h ^ uint32((n>>24)&255)
    h = h * 16777619
    h = h ^ uint32((n>>32)&255)
    h = h * 16777619
    h = h ^ uint32((n>>40)&255)
    h = h * 16777619
    h = h ^ uint32((n>>48)&255)
    h = h * 16777619
    h = h ^ uint32((n>>56)&255)
    h = h * 16777619
    return h
}

// HashUint hashes a uint64 value using FNV-1a bit mixing.
func HashUint(n uint64) uint32 {
    var h uint32 = 2166136261
    h = h ^ uint32(n&255)
    h = h * 16777619
    h = h ^ uint32((n>>8)&255)
    h = h * 16777619
    h = h ^ uint32((n>>16)&255)
    h = h * 16777619
    h = h ^ uint32((n>>24)&255)
    h = h * 16777619
    h = h ^ uint32((n>>32)&255)
    h = h * 16777619
    h = h ^ uint32((n>>40)&255)
    h = h * 16777619
    h = h ^ uint32((n>>48)&255)
    h = h * 16777619
    h = h ^ uint32((n>>56)&255)
    h = h * 16777619
    return h
}

// HashString hashes a string value using FNV-1a.
func HashString(s string) uint32 {
    var h uint32 = 2166136261
    for i := 0; i < s.ByteSize(); i++ {
        h = h ^ uint32(s[i])
        h = h * 16777619
    }
    return h
}

// HashFloat hashes a float64 by its bits, so fractions spread over the buckets
// instead of truncating to a handful of integers. The two zeros are == and
// hash alike; a NaN equals nothing, so where it lands does not matter.
func HashFloat(f float64) uint32 = if (f == 0) HashUint(0) else HashUint(math.Float64bits(f))

// HashBool hashes a boolean value.
func HashBool(b bool) uint32 {
    if b {
        return 1231
    }
    return 1237
}

// HashCombine combines two hash values into one.
// Useful for hashing structs with multiple fields.
// Example: HashCombine(HashString(name), HashInt(age))
func HashCombine(h1 uint32, h2 uint32) uint32 {
    // 0x9e3779b9 = 2654435769 (golden ratio constant)
    return h1 ^ (h2 + 2654435769 + (h1 << 6) + (h1 >> 2))
}

// HashValue hashes a value held inside a key: a value of a predeclared
// primitive type by its value, any other value through its Hashable Hash
// method. It panics for a value that is neither. The std value types hash the
// values they hold through it, so a Tuple of Tuples, or an Option of a
// Hashable type, hashes all the way down. A caller that knows the value's
// type hashes it with HashOf, which does not box a primitive.
func HashValue(v any) uint32 = hashOf(v, false)

// HashKey hashes a HashSet element or HashMap key: as HashValue does, and a
// pointer that is not Hashable, and has no Equal method another key could be
// passed to, by its address. HashSet and HashMap tell such pointers apart by
// identity (==), so the address is the hash that agrees with their equality.
//
// HashValue does not hash such a pointer: a Tuple, Option, List or struct
// holding one compares it by its target (std.Equal), which its address does
// not agree with.
func HashKey(v any) uint32 = hashOf(v, true)

// HashOf hashes v exactly as HashValue(v) does, without boxing it into an
// any: hashing a value of a predeclared primitive type, an int, a string or a
// float64, allocates nothing.
//
// Example:
//   val h = HashOf(1000) // HashValue(1000), without an allocation
func HashOf[T any](v T) uint32 = hashOf(v, false)

// HashKeyOf hashes a HashSet element or HashMap key exactly as HashKey(v)
// does, without boxing it into an any, as HashOf does HashValue.
func HashKeyOf[T any](v T) uint32 = hashOf(v, true)

// hashOf is HashOf, and HashKeyOf when key is set.
func hashOf[T any](v T, key bool) uint32 = hashPrimitive(v) match {
    case Some(h) => h
    case _ => v match {
        case h: Hashable => h.Hash()
        case _ if key => hashKeyByIdentity(v)
        case _ => panicNotHashable(v)
    }
}

// hashPrimitive hashes v by its value when it is of a predeclared primitive
// type, and is None otherwise: the one list of the types HashValue hashes by
// value. Its type patterns lower to one Go type switch, which boxes v without
// an allocation.
func hashPrimitive[T any](v T) Option[uint32] = v match {
    case i: int => Some(HashInt(int64(i)))
    case s: string => Some(HashString(s))
    case i: int64 => Some(HashInt(i))
    case i: int32 => Some(HashInt(int64(i)))
    case u: uint => Some(HashUint(uint64(u)))
    case u: uint64 => Some(HashUint(u))
    case u: uint32 => Some(HashUint(uint64(u)))
    case b: bool => Some(HashBool(b))
    case i: int8 => Some(HashInt(int64(i)))
    case i: int16 => Some(HashInt(int64(i)))
    case u: uint8 => Some(HashUint(uint64(u)))
    case u: uint16 => Some(HashUint(uint64(u)))
    case f: float64 => Some(HashFloat(f))
    case f: float32 => Some(HashFloat(float64(f)))
    case _ => None()
}

// HashesByValue reports whether v is of a predeclared primitive type that
// HashValue hashes by its value. For those types == is Equal, so a HashSet
// holding them tells values apart exactly as Equal does. A named type is left
// out: it may declare an Equal of its own.
func HashesByValue(v any) bool = hashPrimitive(v).IsDefined()


// panicNotHashable panics for a value HashValue cannot hash.
func panicNotHashable(v any) uint32 {
    Panic(f"cannot hash type ${v}%T: a HashSet element or HashMap key, and every value inside a Tuple, Option or Either one, must be a primitive or implement std.Hashable interface")
}
