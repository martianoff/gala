package std

// FieldEncoder is the format-neutral interface used by the transpiler-generated
// StructMeta[T].EncodeFields method to serialize a struct's fields.
//
// Format-specific encoders (JsonWriter, YamlWriter, etc.) implement this
// interface. The transpiler emits fully-typed per-field dispatch against this
// interface — no `any`, no reflection, no runtime type assertions on user data.
//
// (At Phase 4 cleanup, this supersedes the legacy FieldWriter in codec.gala.)
type FieldEncoder interface {
    WriteKey(name string)
    WriteString(v string)
    WriteInt(v int)
    WriteInt64(v int64)
    WriteFloat64(v float64)
    WriteBool(v bool)
    WriteRune(v rune)
    WriteNull()
    WriteStartArray()
    WriteEndArray()
    WriteStartObject()
    WriteEndObject()
}

// FieldDecoder is the format-neutral interface used by the transpiler-generated
// StructMeta[T].DecodeFields method to reconstruct a struct from a stream.
//
// Format-specific decoders (JsonReader, YamlReader, etc.) implement this
// interface. Unlike the legacy FieldReader, method return types are the raw
// primitive values (not Try[T]), so the transpiler emits straight-line typed
// field reads. Errors surface through the decoder's own state (implementation
// decides: panic, sticky error flag, etc.) — reading from a failed decoder
// must be safe.
//
// (At Phase 4 cleanup, this supersedes the legacy FieldReader in codec.gala.)
type FieldDecoder interface {
    ReadKey() string
    ReadString() string
    ReadInt() int
    ReadInt64() int64
    ReadFloat64() float64
    ReadBool() bool
    ReadRune() rune
    IsNull() bool
    ReadNull()
    StartArray()
    EndArray()
    HasMoreElements() bool
    StartObject()
    EndObject()
    HasMoreFields() bool
    Skip()
}
