package std

// Traversable is the root trait for all traversable collections.
// It provides the most basic way to traverse elements: the ForEach method.
// Any collection that can be traversed element by element should implement this interface.
type Traversable[T any] interface {
    // ForEach applies a function to each element for side effects.
    ForEach(f func(T))
    // Size returns the number of elements in this collection.
    Size() int
    // IsEmpty returns true if the collection contains no elements.
    IsEmpty() bool
    // NonEmpty returns true if the collection contains at least one element.
    NonEmpty() bool
    // MkString joins elements into a string with separator.
    MkString(sep string) string
}

// Iterable is a trait for collections that can produce an Iterator.
// It extends the concept of Traversable by providing rich iteration capabilities
// similar to Scala's Iterable trait.
//
// C is the collection's own type, a self type as in Scala's collection design.
// The methods that return a sub-collection (Tail, Filter, Take, SplitAt, ...)
// return C rather than Iterable: Go has no covariant result types, so this is what
// lets a collection implement the interface while keeping its concrete results.
// The immutable `Array[T]` implements `Iterable[T, Array[T]]` and `List[T]`
// implements `Iterable[T, List[T]]`; the mutable ones implement it through their
// pointer, `Ptr[Array[T]]` as `Iterable[T, Ptr[Array[T]]]`. Generic code bounds
// the self type by the interface, chains the sub-collection methods and gets
// the caller's concrete collection back; T and C are inferred from the argument:
//
//     func evensAfterFirst[T any, C Iterable[T, C]](xs C, even func(T) bool) C =
//         xs.Tail().Filter(even)
//
// HashSet, TreeSet, the maps and stream.Stream do not implement Iterable: sets
// have no positional methods, maps traverse key-value pairs, and a Stream's
// Head and Reduce return an Option.
//
// Note: Generic methods (Map, FlatMap, Collect, FoldLeft, FoldRight, PartitionMap,
// GroupBy, GroupMap, GroupMapReduce) are implemented on concrete collection types
// because Go interfaces do not support methods with additional type parameters.
// Concat is not part of Iterable either: Array, List and Stream each define it
// taking and returning their own type (`Array[T].Concat(Array[T]) Array[T]`).
type Iterable[T any, C any] interface {
    // Traversable methods
    ForEach(f func(T))
    Size() int
    IsEmpty() bool
    NonEmpty() bool

    // Element access
    Head() T
    Last() T
    HeadOption() Option[T]
    LastOption() Option[T]

    // Search operations
    Find(p func(T) bool) Option[T]
    Exists(p func(T) bool) bool
    ForAll(p func(T) bool) bool
    Count(p func(T) bool) int

    // Reduction (same-type only)
    Reduce(f func(T, T) T) T

    // Sub-collection retrieval
    Tail() C
    Init() C
    Slice(from int, until int) C
    Take(n int) C
    Drop(n int) C
    TakeWhile(p func(T) bool) C
    DropWhile(p func(T) bool) C
    Filter(p func(T) bool) C
    FilterNot(p func(T) bool) C

    // Subdivision operations
    SplitAt(n int) Tuple[C, C]
    Span(p func(T) bool) Tuple[C, C]
    Partition(p func(T) bool) Tuple[C, C]

    // String representation
    String() string
    MkString(sep string) string
}
