package std

import (
    "encoding/json"
)

// toJsonBytes converts a string to a byte slice for JSON unmarshalling.
func toJsonBytes(s string) []byte = json.RawMessage(s)

// JsonParse deserializes a JSON string into a value of type T.
// Returns Success[T] if parsing succeeds, Failure[T] if JSON is invalid.
//
// Usage:
//   val result = JsonParse[User](jsonStr)
//   result.Map((user) => user.Name)
func JsonParse[T any](data string) Try[T] {
    var result T
    val err = json.Unmarshal(toJsonBytes(data), &result)
    if err != nil {
        return Failure[T](err)
    }
    return Success[T](result)
}

// JsonStringify serializes a value to a JSON string.
// Returns Success[string] on success, Failure[string] on error.
func JsonStringify[T any](value T) Try[string] {
    val data, err = json.Marshal(value)
    if err != nil {
        return Failure[string](err)
    }
    return Success[string](string(data))
}

// JsonStringifyPretty serializes a value to a pretty-printed JSON string.
func JsonStringifyPretty[T any](value T) Try[string] {
    val data, err = json.MarshalIndent(value, "", "  ")
    if err != nil {
        return Failure[string](err)
    }
    return Success[string](string(data))
}

// Json[T] is a type-safe JSON extractor for pattern matching.
// It attempts to parse a JSON string into a value of type T.
//
// Usage in pattern matching:
//   val jsonStr = `{"Name":"Alice","Age":30}`
//   val result = jsonStr match {
//       case Json[Person](person) => s"Found: ${person.Name}"
//       case _ => "invalid JSON"
//   }
type Json[T any] struct {}

// Unapply attempts to parse a JSON string into type T.
// Returns Some[T] if parsing succeeds, None if it fails.
func (j Json[T]) Unapply(s string) Option[T] {
    var result T
    val err = json.Unmarshal(toJsonBytes(s), &result)
    if err != nil {
        return None[T]()
    }
    return Some(result)
}
