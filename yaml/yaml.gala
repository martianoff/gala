package yaml

import (
    . "martianoff/gala/std"
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/go_interop"
)

// Codec[T] is a type-safe, zero-reflection YAML codec.
// Mirrors json.Codec[T] — same builder API, same auto-injected StructMeta[T],
// same Encode/Decode/Unapply surface — but emits and parses block-style YAML
// instead of JSON.
//
// The transpiler auto-injects StructMeta[T] when Codec[T]'s Apply method
// declares StructMeta[T] as its first parameter. This means the user
// writes Codec[Person](SnakeCase()) and the transpiler expands it to:
//
//     Codec[Person]{}.Apply(_StructMeta_Person{}, SnakeCase())
//
// Usage:
//   val codec = Codec[Person](SnakeCase())
//       .Omit("Password")
//       .Rename("Email", "email_address")
//       .OmitEmpty("Bio")
//
//   codec.Encode(person)   // Try[string]
//   codec.Decode(yamlStr)  // Try[Person]
//
//   yamlStr match {
//       case codec(p) => s"Hello ${p.Name}"
//       case _ => "invalid"
//   }
//
// Supported subset: block-style mappings, block-style sequences, scalars
// (string/int/float/bool/null), literal block scalars (`|`), comments,
// nested structures. Out of scope (until needed): anchors, aliases, flow
// style, custom tags. See docs (coming) for the full grammar.
type Codec[T any] struct {}

// Apply creates a typed YamlEncoder[T].
// The first parameter (meta StructMeta[T]) is auto-injected by the transpiler
// when the user calls Codec[T](naming).
func (c Codec[T]) Apply(meta StructMeta[T], naming Naming) YamlEncoder[T] {
    val config = NewKeyConfig().WithNaming(naming)
    return YamlEncoder[T](
        Meta = meta,
        Config = config,
        Keys = BuildKeysSimple(meta.NumFields(), meta.FieldName, naming),
    )
}

// YamlEncoder[T] is a fully typed YAML codec instance.
// Created by Codec[T](naming) and configured via builder methods.
// All methods return new instances — YamlEncoder is immutable.
type YamlEncoder[T any] struct {
    Meta   StructMeta[T]
    Config KeyConfig
    Keys   KeysConfig
}

// Naming sets the field naming strategy and returns a new encoder.
func (c YamlEncoder[T]) Naming(n Naming) YamlEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithNaming(n))

// Omit excludes a field from serialization/deserialization.
func (c YamlEncoder[T]) Omit(field string) YamlEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithOmit(field))

// Rename maps a GALA field name to a custom YAML key.
func (c YamlEncoder[T]) Rename(field string, key string) YamlEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithRename(field, key))

// OmitEmpty leaves a field out of the encoded output whenever its value is
// empty: "" for a string kind, 0 for a numeric kind, false for bool, None for
// an Option, and no elements for an Array, List or HashMap. A nested struct is
// never empty. Decoding a document without the field gives it that empty
// value, so an omitted field round-trips.
func (c YamlEncoder[T]) OmitEmpty(field string) YamlEncoder[T] =
    rebuildEncoder[T](c.Meta, c.Config.WithOmitEmpty(field))

func rebuildEncoder[T any](meta StructMeta[T], config KeyConfig) YamlEncoder[T] =
    YamlEncoder[T](
        Meta = meta,
        Config = config,
        Keys = BuildKeys(meta.NumFields(), meta.FieldName, config.NamingStrategy, config),
    )

func nameFnFromKeys(keys Array[string]) func(int) string =
    (i int) => keys.GetOption(i).GetOrElse("")

func omitFnFromKeys(keys Array[string]) func(int) bool =
    (i int) => keys.GetOption(i).GetOrElse("") == ""

// namingFn is the codec's naming strategy as the key converter StructMeta
// threads into nested structs.
func namingFn(n Naming) func(string) string = (name) => ApplyNaming(name, n)

// writer returns the function that writes one T as a YAML mapping, with the
// codec's Naming/Rename/Omit/OmitEmpty applied. Array() and List() call it per
// element. Omit is settled once per codec; OmitEmpty depends on the value, so
// it is tested per value written.
func (c YamlEncoder[T]) writer() func(FieldEncoder, T) {
    val nameFn = nameFnFromKeys(c.Keys.Keys)
    val omitFn = omitFnFromKeys(c.Keys.Keys)
    val naming = namingFn(c.Config.NamingStrategy)
    val omitIfEmpty = c.Keys.OmitIfEmpty
    if !omitIfEmpty.Exists((b) => b) {
        return (w, v) => c.Meta.EncodeFields(w, v, nameFn, omitFn, naming)
    }
    (w, v) => {
        val omitValueFn = (i int) => omitFn(i) || (omitIfEmpty.Get(i) && c.Meta.FieldIsEmpty(v, i))
        c.Meta.EncodeFields(w, v, nameFn, omitValueFn, naming)
    }
}

// reader returns the function that reads one T from a YAML mapping. The key
// lookup is built once, so decoding a sequence of T pays for it once.
func (c YamlEncoder[T]) reader() func(FieldDecoder) T {
    val lookup = buildLookup(c.Keys.ReverseKeys, c.Meta.NumFields(), c.Meta.FieldName)
    val naming = namingFn(c.Config.NamingStrategy)
    (r) => c.Meta.DecodeFields(r, lookup, naming)
}

// encodeYaml runs write against a fresh encoder and returns the document.
func encodeYaml(write func(FieldEncoder)) Try[string] = Try(() => {
    val w = NewYamlEncoder()
    write(w)
    w.String()
})

// decodeYaml parses s and runs read over it. A parser or decoder panic
// (malformed input, wrong shape, out-of-range number) becomes a Failure.
func decodeYaml[V any](s string, read func(FieldDecoder) V) Try[V] = Try(() => read(NewYamlDecoder(s)))

// Encode serializes a value to a YAML string (block-style, zero-reflection).
func (c YamlEncoder[T]) Encode(v T) Try[string] {
    val write = c.writer()
    encodeYaml((w) => write(w, v))
}

// Decode deserializes a YAML string into Try[T] (zero-reflection).
// DecodeFields panics on malformed input; Try() catches the panic and
// surfaces it as a Failure.
func (c YamlEncoder[T]) Decode(s string) Try[T] = decodeYaml(s, (r) => {
    // Built inside the Try: a codec without metadata fails, not panics.
    val read = c.reader()
    read(r)
})

// Unapply attempts to decode a YAML string using the codec's naming config.
// Returns Option[T] for pattern matching support.
func (c YamlEncoder[T]) Unapply(s string) Option[T] = c.Decode(s).ToOption()

// Array returns a codec for a YAML document whose root is a sequence of T
// mappings, with this codec's Naming/Rename/Omit/OmitEmpty applied to every element.
func (c YamlEncoder[T]) Array() YamlArrayEncoder[T] = YamlArrayEncoder[T](Elem = c)

// List is Array for a List[T].
func (c YamlEncoder[T]) List() YamlListEncoder[T] = YamlListEncoder[T](Elem = c)

// YamlArrayEncoder[T] encodes and decodes a root YAML sequence of T mappings.
// Created by Codec[T](naming).Array(); configure the element codec first.
type YamlArrayEncoder[T any] struct {
    Elem YamlEncoder[T]
}

// encodeElems writes the elements as a YAML sequence.
func (c YamlEncoder[T]) encodeElems(vs Traversable[T]) Try[string] {
    val write = c.writer()
    encodeYaml((w) => {
        w.WriteStartArray()
        vs.ForEach((v) => write(w, v))
        w.WriteEndArray()
    })
}

// readElems reads a YAML sequence of mappings, in order. Like the generated
// decoder of an Array or List field, it collects into a Go slice and builds
// the collection once, instead of a persistent Append per element.
func readElems[T any](r FieldDecoder, read func(FieldDecoder) T) []T {
    r.StartArray()
    // A pull parser: the element count is unknown until the decoder reports
    // the end of the sequence, so there is no combinator to fold over.
    var buf = go_interop.SliceEmpty[T]()
    for r.HasMoreElements() {
        buf = go_interop.SliceAppend(buf, read(r))
    }
    r.EndArray()
    buf
}

// Encode serializes the elements as a block-style sequence (`[]` when empty).
func (c YamlArrayEncoder[T]) Encode(vs Array[T]) Try[string] = c.Elem.encodeElems(vs)

// Decode reads a sequence of mappings. Anything else at the root — a
// mapping, a scalar — is a Failure.
func (c YamlArrayEncoder[T]) Decode(s string) Try[Array[T]] =
    decodeYaml(s, (r) => ArrayFromSlice(readElems(r, c.Elem.reader())))

// Unapply decodes for pattern matching.
func (c YamlArrayEncoder[T]) Unapply(s string) Option[Array[T]] = c.Decode(s).ToOption()

// YamlListEncoder[T] is YamlArrayEncoder[T] over List[T].
// Created by Codec[T](naming).List().
type YamlListEncoder[T any] struct {
    Elem YamlEncoder[T]
}

// Encode serializes the elements as a block-style sequence.
func (c YamlListEncoder[T]) Encode(vs List[T]) Try[string] = c.Elem.encodeElems(vs)

// Decode reads a sequence of mappings into a List.
func (c YamlListEncoder[T]) Decode(s string) Try[List[T]] =
    decodeYaml(s, (r) => ListFromSlice(readElems(r, c.Elem.reader())))

// Unapply decodes for pattern matching.
func (c YamlListEncoder[T]) Unapply(s string) Option[List[T]] = c.Decode(s).ToOption()

// Value[T] is a codec for a YAML document of any shape a codec field can
// have — a scalar (`42`, `abc`, `true`), an Option (None is `null`), an Array
// or List (a block sequence), a HashMap[string, _], a struct, nested to any
// depth. Mirrors json.Value[T]; the transpiler auto-injects ValueMeta[T].
//
// To Rename or Omit fields of a struct element, use Codec[T](naming).Array().
type Value[T any] struct {}

// Apply creates a YamlValueEncoder[T]. The meta parameter is auto-injected by
// the transpiler when the user calls Value[T]().
func (c Value[T]) Apply(meta ValueMeta[T]) YamlValueEncoder[T] =
    YamlValueEncoder[T](Meta = meta, NamingStrategy = AsIs())

// YamlValueEncoder[T] is a fully typed YAML codec for a value of any codec
// shape. Created by Value[T](); immutable.
type YamlValueEncoder[T any] struct {
    Meta           ValueMeta[T]
    NamingStrategy Naming
}

// Naming sets the key naming for structs reached inside the value.
func (c YamlValueEncoder[T]) Naming(n Naming) YamlValueEncoder[T] = c.Copy(NamingStrategy = n)

// Encode serializes the value to YAML.
func (c YamlValueEncoder[T]) Encode(v T) Try[string] =
    encodeYaml((w) => c.Meta.EncodeValue(w, v, namingFn(c.NamingStrategy)))

// Decode reads a YAML document of T's shape. A document of another shape, or
// a number outside T's range, is a Failure.
func (c YamlValueEncoder[T]) Decode(s string) Try[T] =
    decodeYaml(s, (r) => c.Meta.DecodeValue(r, namingFn(c.NamingStrategy)))

// Unapply decodes for pattern matching.
func (c YamlValueEncoder[T]) Unapply(s string) Option[T] = c.Decode(s).ToOption()

// buildLookup turns the precomputed reverseKeys map (serialized key → GALA
// field name) into the index-lookup function DecodeFields expects.
func buildLookup(
    reverseKeys HashMap[string, string],
    numFields int,
    fieldName func(int) string,
) func(string) int {
    var nameToIdx = EmptyHashMap[string, int]()
    var i = 0
    for i < numFields {
        nameToIdx = nameToIdx.Put(fieldName(i), i)
        i = i + 1
    }
    return (key string) =>
        reverseKeys.Get(key).FlatMap((gName) => nameToIdx.Get(gName)).GetOrElse(-1)
}
