{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gala",
      "camelcase": "Gala",
      "title": "GALA",
      "scope": "source.gala",
      "path": ".",
      "file-types": [
        "gala"
      ],
      "injection-regex": "^gala$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "GALA grammar for tree-sitter",
    "authors": [
      {
        "name": "GALA contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/martianoff/gala"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
