package billing

import "time"

// Opaque types another package uses: in signatures, as struct fields of its
// own structs, as HashMap keys and through a codec.

// CustomerID identifies a customer.
opaque type CustomerID int64

// Cents is an amount of money.
opaque type Cents int64

// Sku names a product.
opaque type Sku string

type Code string

// Region is declared over an alias of this package; an importer encoding it
// reads the underlying type from this package.
opaque type Region Code

// Timeout is a wait, over a Go named type an importer need not import.
opaque type Timeout time.Duration

// Ref refers to an entity of type T by number.
opaque type Ref[T any] int64

// Dollars renders the amount.
func (c Cents) Dollars() string = f"$$${float64(c) / 100.0}%.2f"

// Charge describes a charge of amount to a customer.
func Charge(id CustomerID, amount Cents) string = s"charge #${int64(id)} ${amount.Dollars()}"

// Total adds up amounts.
func Total(a Cents, b Cents) Cents = a + b
