package std_shadow_lib

import . "martianoff/gala/collection_immutable"

// Each type below is named like a std type. A package's own declarations
// shadow the implicitly imported std names, so every bare reference in this
// package means the declaration here.

// Seq is this package's sequence of ints; it shadows std's Seq.
type Seq Array[int]

// Holder carries a Seq.
struct Holder(Items Seq)

// Make returns a Holder of 1, 2, 3.
func Make() Holder = Holder(ArrayOf(1, 2, 3))

// Void is a pair of ints; it shadows std's Void.
struct Void(First int, Second int)

// Sum adds the two halves of v.
func Sum(v Void) int = v.First + v.Second

// Ordered is a message or a number; it shadows std's Ordered.
sealed type Ordered {
    case Less(Msg string)
    case More(N int)
}

// Describe names the variant of o and its value.
func Describe(o Ordered) string = o match {
    case Less(m) => s"less $m"
    case More(n) => s"more $n"
}
