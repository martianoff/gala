package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/concurrent"
    . "martianoff/gala/collection_immutable"
)

// Compile-time data-race safety: a `Future` body is a `Sendable[func() T]`
// concurrency boundary, so the transpiler statically checks that the async
// closure only captures immutable, shareable values. Every capture below is a
// `val` of a deeply-immutable type, so the program is accepted and runs.
//
// The `Future(expr)` by-name / thunk sugar desugars to `Future(() => expr)`, so
// each `expr` is itself the async closure whose captures are checked.
//
// (Capturing a `var`, a collection_mutable value, or a struct with a `var`
// field would be rejected at compile time with GALA-E0037 — those forms cannot
// appear in a compiling example.)

func main() {
    // Capture an immutable Int val.
    val base = 41
    val f1 = Future(base + 1)
    Println(f1.Get())

    // Capture an immutable String val.
    val label = "gala"
    val f2 = Future(label.Size())
    Println(f2.Get())

    // Capture an immutable Array (collection_immutable) — deeply immutable, so
    // concurrent reads never race.
    val xs = ArrayOf(10, 20, 30)
    val f3 = Future(xs.Size())
    Println(f3.Get())
}
