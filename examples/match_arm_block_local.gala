package main

import . "martianoff/gala/collection_immutable"

// A block that declares a local and ends in it — a match arm, a branch of
// an arm's trailing if/else, a partial-function arm: the block's value is
// that local, typed in the block's own scope.

sealed type Shape {
    case Circle(R float64)
    case Square(S float64)
}

// Every arm's value is a block local, and nothing else types the match.
func label(n int) {
    val text = n match {
        case x => {
            val tag = s"item-$x"
            tag
        }
    }
    Println(text.Size(), text)
}

// The local is accumulated by a loop before it is read.
func sumTo(n int) int = n match {
    case 0 => 0
    case x => {
        var acc = 0
        for i := 1; i <= x; i++ {
            acc = acc + i
        }
        acc
    }
}

// The default arm reads its own local.
func describe(s Shape) string = s match {
    case Circle(r) => f"circle $r%.1f"
    case _ => {
        val kind = "other"
        kind
    }
}

// A local read inside the arm's trailing if/else.
func sign(n int) {
    val word = n match {
        case x => {
            val neg = "negative"
            if (x < 0) neg else "non-negative"
        }
    }
    Println(word.Size(), word)
}

// Each branch of the arm's trailing if/else reads a local of its own.
func size(n int) {
    val word = n match {
        case x => {
            if (x > 9) {
                val big = s"big-$x"
                big
            } else {
                val small = "small"
                small
            }
        }
    }
    Println(word.Size(), word)
}

// A partial-function arm reads its own local.
func labels(xs Array[int]) Array[string] = xs.Collect({
    case x if x > 1 => {
        val tag = s"n$x"
        tag
    }
})

func main() {
    label(7)
    Println(sumTo(4))
    Println(describe(Square(2.0)), describe(Circle(1.5)))
    sign(-3)
    size(12)
    Println(labels(ArrayOf(1, 2, 3)).MkString(","))
}
