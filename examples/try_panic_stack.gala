package main

import "errors"
import "fmt"
import "strings"

// A Failure made by Try from a panic carries the panic's stack trace, read
// back with PanicStack. Its frames point at this .gala file, so a program
// using Try as a safety boundary can log where a recovered panic happened.

// NotFound is an error type, to show that type patterns see a panic's own error.
struct NotFound(Key string)

// Error returns the error message.
func (e NotFound) Error() string = s"not found: ${e.Key}"

func divide(a int, b int) int = a / b

func explode() int {
    Panic("boom")
    0
}

func missing() int {
    Panic(NotFound(Key = "id"))
    0
}

func describe(stack Option[string]) string = stack match {
    case Some(s) => {
        val namesFrame = strings.Contains(s, "main.explode")
        val galaSource = strings.Contains(s, "try_panic_stack.gala")
        s"stack names explode: $namesFrame, points at .gala source: $galaSource"
    }
    case None() => "no stack"
}

func main() {
    // A recovered panic: the message is unchanged and the stack is kept.
    val failed = Try(explode())
    val err = failed.GetError()
    Println(err.Error())
    Println(describe(PanicStack(err)))

    // A runtime panic, such as an integer division by zero.
    val byZero = Try(divide(1, 0))
    Println(PanicStack(byZero.GetError()).IsDefined())

    // The stack is not part of the message, printing or equality.
    Println(failed)
    Println(Try(explode()).Equal(failed))
    Println(failed.Equal(Failure[int](errors.New("boom"))))
    Println(Failure[int](errors.New("boom")).Equal(failed))

    // A wrapped panic error still has its stack; errors.Is sees through it.
    val wrapped = fmt.Errorf("handler: %w", err)
    Println(PanicStack(wrapped).IsDefined())

    // Type patterns and errors.As see the panic's own error.
    val typed = Try(missing()) match {
        case Failure(e: NotFound) => s"key ${e.Key}"
        case _ => "other"
    }
    Println(typed)
    var target NotFound
    Println(errors.As(Try(missing()).GetError(), &target), target.Key)

    // A re-raised Failure keeps the stack of the original panic.
    val nested = Try(failed.Get())
    Println(PanicStack(nested.GetError()) == PanicStack(err))

    // Errors that are not panics have no stack.
    Println(describe(PanicStack(FromError(errors.New("plain")).GetError())))
    Println(describe(PanicStack(Failure[int](errors.New("plain")).GetError())))
}
