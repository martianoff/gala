package main

import (
    "fmt"
    "net/url"
)

// A Go call that is the whole expression body of a function, method or lambda
// Go calls with several results passes its results through as they are, as
// Go's `return url.Parse(raw)` does: url.Parse's (*url.URL, error) fills
// (fmt.Stringer, error), each result only assignable to its Go result.

func parse(raw string) (fmt.Stringer, error) = url.Parse(raw)

struct Site(Base string)

func (s Site) Page(path string) (fmt.Stringer, error) = url.Parse(s.Base + path)

func show(link Try[fmt.Stringer]) string = link.Map((l) => l.String()).GetOrElse("invalid")

func describe(f func() (fmt.Stringer, error)) string = show(f())

func main() {
    Println(show(parse("https://example.com/a")))
    Println(show(parse("://bad")))
    Println(show(Site("https://example.com").Page("/b")))

    // The lambda form is the one under test here, next to the by-name form.
    Println(describe(() => url.Parse("https://example.com/c")))
    Println(describe(() => url.Parse("://bad")))
    Println(describe(url.Parse("https://example.com/d")))
}
