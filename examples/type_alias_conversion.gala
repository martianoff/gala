package main

// A type alias is a second name for an existing type, not a new type. The two
// are interchangeable, so `Millis(v)` is the ordinary Go-style conversion —
// the same construct as `int64(v)`.
type Millis int64
type Name string

func toMillis(v int64) Millis = Millis(v)

func toName(s string) Name = Name(s)

// An alias whose target is a struct reaches that struct's fields, so it is a
// real construction target.
struct Point(X int, Y int)

type Coord Point

func origin() Coord = Coord(1, 2)

// A method is legal through an alias when the target is declared in this
// package — the receiver base type is then local. An alias to a built-in or an
// imported type takes no methods (GALA-E0048).
func (c Coord) Sum() int = c.X + c.Y

// An alias can carry a generic instantiation; the alias already names it, so
// the type arguments are not repeated at the call site.
struct Pair[T any](A T, B T)

type IntPair Pair[int]

func firstOf(p IntPair) int = p.A

func main() {
    Println(toMillis(1500))
    Println(toName("gala"))
    val c = origin()
    Println(s"${c.X},${c.Y}")
    Println(c.Sum())
    Println(firstOf(IntPair(3, 4)))
}
