package main

func main() {
    val x = Some(42)

    // A branch returning None() takes its type from its sibling branch:
    // Some(v * 2) is an Option[int], so None() is None[int]()
    val result = x match {
        case Some(v) => Some(v * 2)
        case None() => None()
    }

    Println(result)

    // Verify None() branch works correctly when None is matched
    val y = result match {
        case Some(_) => None()
        case None() => Some(0)
    }

    Println(y)
}
