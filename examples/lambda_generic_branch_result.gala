package main

// A lambda passed to a generic function whose type parameters only the lambda
// binds returns its trailing value also when it is parenthesized, or a branch
// of an if or match argument.

func run[A any, B any](f func(A) B) func(A) B = f

func widen[A any](f func(A) int64) func(A) int64 = f

func main() {
    val grouped = run(((k int) => {
        val q = k + 1
        q * q
    }))
    Println(grouped(3))

    val up = true
    val chosen = run(if (up) (s string) => {
        val t = s + "!"
        t + t
    } else (s string) => {
        val t = s + "?"
        t
    })
    Println(chosen("hi"))

    // A match whose value no typed slot fixes, one arm a block ending in
    // the lambda.
    val n = 2
    val matched = run(n match {
        case 1 => (k int) => {
            val q = k + 1
            q * q
        }
        case _ => {
            Println("other arm")
            (k int) => {
                val q = k * n
                q + 1
            }
        }
    })
    Println(matched(3))

    val wide = widen(if (up) (k int) => {
        Println(s"widen $k")
        1 << 40
    } else (k int) => {
        Println(k)
        0
    })
    Println(wide(1))
}
