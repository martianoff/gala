package main

// OptionPtr[T]: a pointer that may be absent, the size of one pointer. A
// field of this type left out of a brace literal is empty.

struct Node(Value int, Next OptionPtr[Node])

func sum(n Ptr[Node]) int = n.Value + n.Next.Map((next) => sum(next)).GetOrElse(0)

func last(n Ptr[Node]) Ptr[Node] = n.Next.ToOption() match {
    case Some(next) => last(next)
    case None() => n
}

func main() {
    val tail = &Node{Value: 3}
    val middle = &Node(2, SomePtr(tail))
    val head = &Node(1, SomePtr(middle))

    Println(s"sum: ${sum(head)}")
    Println(s"last: ${last(head).Value}")
    Println(s"tail next is empty: ${tail.Next.IsEmpty()}")
    Println(s"head next is defined: ${head.Next.IsDefined()}")

    head.Next.ForEach((n) => Println(s"after head: ${n.Value}"))
    Println(s"second after head: ${head.Next.FlatMap((n) => n.Next).Map((n) => n.Value).GetOrElse(0)}")
    Println(s"or else: ${tail.Next.GetOrElse(head).Value}")
    Println(s"orElse: ${tail.Next.OrElse(SomePtr(middle)).Map((n) => n.Value).GetOrElse(0)}")

    Println(s"from Go: ${OptionPtrOf(goFind(false))}")
    Println(s"from Go found: ${OptionPtrOf(goFind(true))}")
    Println(s"empty: ${EmptyOptionPtr[Node]()}")
}

var shared = Node{Value: 7}

// A Go-style lookup: nil when nothing is found.
func goFind(found bool) *Node {
    if found {
        return &shared
    }
    return nil
}
