package main

import (
    "martianoff/gala/examples/regress_052"
    "martianoff/gala/examples/go_struct_bridge"
)

func main() {
    // BUG-052: if-expression with time.Time
    Println(regress_052.DeadlineFromString("2024-01-15T10:30:00Z").IsDefined())

    // BUG-052: if-expression with int
    Println(regress_052.CountIfPositive(42).GetOrElse(0))
    Println(regress_052.CountIfPositive(-1).IsDefined())

    // BUG-052: if-expression with Go method return
    val session = go_struct_bridge.NewSessionData()
    Println(regress_052.SessionValueIfExists(session, "user").GetOrElse("none"))
    Println(regress_052.SessionValueIfExists(session, "missing").IsDefined())
}
