package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/go_interop"
)

// An untyped constant shifted by a value (`1 << n`) takes its type where it is
// used. As an argument it keeps that type when the call evaluates its
// arguments in the order they are written, and when a default reads it again.
// Each argument prints its name when it is evaluated.

struct Box[T any](V T)

func (b Box[T]) Pick[U any](u U, w int, z U = u) U = z

func half(u int64, w int, z float64 = float64(u) / 2) float64 = z

func (b Box[T]) Fold[U any](u U, f func(U, int) U, z U = u) U = f(z, 1)

func t(name string, v int) int {
    Print(name)
    v
}

func mk64() func(int64, int) int64 {
    Print("f")
    (acc, x) => acc + int64(x)
}

var shift = 2

func bump() func(int64, int) int64 {
    Print("f")
    shift = 5
    (acc, x) => acc + int64(x)
}

func bumpInt() int {
    shift = 5
    1
}

func sum(a int64, b int) int64 = a + int64(b)

func main() {
    // U is the int64 of mk64's accumulator, which the shift takes in place.
    Println(" ", ListOf(1, 2).FoldLeft(f = mk64(), initial = 1 << t("s", 3)))
    val w int64 = ListOf(1, 2).FoldLeft(f = mk64(), initial = 1 << t("s", 3))
    Println(" ", w)
    // The shift reads its count after f has run.
    Println(" ", ListOf(1, 2).FoldLeft(f = bump(), initial = 1 << shift))
    shift = 2
    Println(" ", sum(1 << shift, bumpInt()))
    shift = 2
    // A default reading the argument reads the same value, of U's type.
    val bx = Box(0)
    var n = 2
    val r int64 = bx.Pick(w = t("w", 1), u = 1 << n)
    Println(" ", r)
    val r2 int64 = bx.Pick(w = t("w", 1), u = (1 << t("s", 2)) + 1)
    Println(" ", r2)
    // U is mk64's int64, which the default's read takes too.
    Println(" ", bx.Fold(f = mk64(), u = 1 << n))
    // The default reads the parameter's int64 value in a float64 conversion.
    Println(" ", half(w = t("w", 1), u = 1 << n))
    // A map key keeps the key type, read before the right side's call.
    val counts = go_interop.MapEmpty[int64, int]()
    counts[1 << shift] += bumpInt()
    Println(counts[4], counts[32])
}
