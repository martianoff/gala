package main

import "net"
import . "martianoff/gala/collection_immutable"
import . "martianoff/gala/go_interop"

// A variadic method with a type parameter of its own takes it from every
// argument its variadic parameter receives, not only the first:
// `c.Last(0, 2.5)` is a float64, as in Go. A spread argument binds the
// element of its slice, whatever slice type it is.

struct C(N int)

func (c C) Last[U any](xs ...U) U = ArrayOf(xs...).Last()

func (c C) Tag[K any, U any](k K, xs ...U) Tuple[K, U] = (k, ArrayOf(xs...).Last())

func lastOf[T any](xs ...T) T = ArrayOf(xs...).Last()

type Floats []float64

func main() {
    val c = C(1)
    val x float64 = 3.5
    val mixed = () => c.Last(0, 2.5)
    val typed = () => c.Last(1, x)
    val tagged = () => c.Tag("k", 1, 2.5)
    val one = () => c.Last(7)
    Println(mixed(), typed(), tagged(), one())
    val ys = SliceOf(1.5, 4.5)
    val fs Floats = SliceOf(5.5, 6.5)
    val ip = net.ParseIP("1.2.3.4")
    val spread = () => c.Last(ys...)
    val defined = () => c.Last(fs...)
    val goDefined = () => c.Last(ip...)
    val fn = () => lastOf(fs...)
    Println(spread(), defined(), goDefined(), fn())
}
