package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/json"
)

struct Person(Name string, Age int)

func main() {
    val codec = Codec[Person](AsIs())

    // Encode
    val person = Person("Alice", 30)
    val jsonStr = codec.Encode(person).Get()
    Println(jsonStr)

    // Decode — returns Try[Person]
    val decoded = codec.Decode(jsonStr)
    decoded.ForEach((p Person) => {
        Println(s"Decoded: ${p.Name}, age ${p.Age}")
    })

    // Pattern matching via Unapply
    val result = jsonStr match {
        case codec(p) => s"Matched: ${p.Name}, age ${p.Age}"
        case _ => "no match"
    }
    Println(result)

    // Invalid JSON pattern matching
    val result2 = "invalid json" match {
        case codec(p) => s"Matched: ${p.Name}"
        case _ => "no match"
    }
    Println(result2)
}
