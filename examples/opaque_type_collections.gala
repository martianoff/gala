package main

import (
    . "martianoff/gala/collection_immutable"
    cm "martianoff/gala/collection_mutable"
)

// Opaque types as collection keys and sorted elements. A Go defined type
// matches none of the collections' primitive cases, so without the generated
// Hash and Compare a HashMap key panics ("must implement std.Hashable") and
// Sorted panics ("does not support ordering").

// UserID identifies a user.
opaque type UserID int64

// Email is an e-mail address.
opaque type Email string

// Score is a rating.
opaque type Score float64

// Port is a TCP port.
opaque type Port uint16

// Flag is a feature switch.
opaque type Flag bool

// Priority declares its own Compare (highest first), which replaces the
// generated one.
opaque type Priority int

// Compare orders higher priorities first.
func (p Priority) Compare(other Priority) int = int(other) - int(p)

func main() {
    // HashMap and HashSet keys.
    val names = EmptyHashMap[UserID, string]().Put(UserID(2), "bo").Put(UserID(1), "al")
    Println(names.Get(UserID(1)), names.Get(UserID(3)), names.Size())
    val mails = HashSetOf(Email("a@x"), Email("b@x"), Email("a@x"))
    Println(mails.Size(), mails.Contains(Email("b@x")), mails.Contains(Email("c@x")))
    val flags = HashSetOf(Flag(true), Flag(false), Flag(true))
    Println(flags.Size())

    // Sorted, TreeSet and TreeMap.
    Println(ArrayOf(UserID(3), UserID(1), UserID(2)).Sorted())
    Println(TreeSetOf(Score(0.5), Score(0.25), Score(1.5)).ToArray())
    Println(TreeMapOf((Port(8080), "http"), (Port(22), "ssh")).Keys())
    Println(ListOf(Email("c@x"), Email("a@x"), Email("b@x")).Sorted())

    // A user-declared Compare is the one used.
    Println(ArrayOf(Priority(1), Priority(3), Priority(2)).Sorted())

    // Grouping by an opaque key.
    val visits = ArrayOf(UserID(1), UserID(2), UserID(1), UserID(1))
    val counts = visits.FoldLeft(EmptyHashMap[UserID, int](), (acc, u) => acc.Put(u, acc.Get(u).GetOrElse(0) + 1))
    Println(counts.Get(UserID(1)), counts.Get(UserID(2)))

    // Mutable collections too.
    val seen = cm.EmptyHashMap[Email, int]()
    seen.Put(Email("a@x"), 1)
    seen.Put(Email("a@x"), 2)
    Println(seen.Get(Email("a@x")), seen.Size())
}
