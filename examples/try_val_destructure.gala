package main

import (
    "os"
    "path/filepath"

    . "martianoff/gala/go_interop"
)

// A Go call returning (T, error) is a Try[T] when used as a value: `.Get()`
// takes the value and panics on the error, `match` handles both outcomes.
func main() {
    val tmpDir = os.MkdirTemp("", "gala-test-*").Get()
    val path = filepath.Join(tmpDir, "test.txt")
    val f = os.Create(path).Get()
    f.WriteString("hello from gala")
    f.Close()

    os.ReadFile(path) match {
        case Success(data) => Println(ToString(data))
        case Failure(err) => Println(s"read failed: $err")
    }

    os.RemoveAll(tmpDir)
}
