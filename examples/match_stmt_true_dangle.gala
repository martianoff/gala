package main

// Regression: a `subject match { ... }` used as a *statement* (its value
// discarded) whose arms end in an assignment, with no value of their own.
//
// In statement position the match is lowered as void, so arms that produce
// no value are fine. An arm that ends in a plain value instead — a literal or
// a name, as in `case Read() => { seen = 1; true }` — is rejected as evaluated
// but not used, like any other value written as a statement.

sealed type Mode {
    case Read()
    case Write()
    case Append()
}

func observeSeen(m Mode) int {
    var seen = 0
    m match {
        case Read() => {
            seen = 1
        }
        case Write() => {
            seen = 2
        }
        case Append() => {
            seen = 3
        }
    }
    seen
}

func observePicked(m Mode) string {
    var picked = ""
    m match {
        case Read() => {
            picked = "r"
        }
        case Write() => {
            picked = "w"
        }
        case Append() => {
            picked = "a"
        }
    }
    picked
}

func main() {
    Println(observeSeen(Read()))
    Println(observeSeen(Write()))
    Println(observeSeen(Append()))
    Println(observePicked(Read()))
    Println(observePicked(Write()))
    Println(observePicked(Append()))
}
