package billing

import (
    . "martianoff/gala/collection_immutable"
    "strings"
)

// Structs another package encodes. Their codec metadata is emitted here, in
// the package that declares them: only this package can read and construct
// unexported fields.

// Email has an exported field.
struct Email(V string)

// Uses counts how often a Secret was used. An importer encoding a Secret has
// to see through this alias to the int it names.
type Uses int

// Secret has only unexported fields, one of them typed by an alias.
struct Secret(token string, uses Uses)

// line is an unexported struct type, reached through Invoice.
struct line(Sku string, qty int)

// Invoice mixes exported and unexported fields, one of them a collection of
// an unexported struct type.
struct Invoice(Number int, To Email, lines Array[line])

// ParseEmail returns s as an Email when it contains an "@".
func ParseEmail(s string) Option[Email] = When(strings.Contains(s, "@"), Email(s))

// NewSecret builds a Secret, whose fields only this package can set.
func NewSecret(token string, uses int) Secret = Secret(token, Uses(uses))

// Describe renders the secret's token and use count.
func (s Secret) Describe() string = s"${s.token}x${s.uses}"

// NewInvoice builds an invoice to `to` with two fixed lines.
func NewInvoice(number int, to Email) Invoice =
    Invoice(number, to, ArrayOf(line("pen", 2), line("ink", 1)))

// Describe renders the invoice number, recipient and lines.
func (i Invoice) Describe() string =
    s"#${i.Number} to ${i.To.V}: " + i.lines.Map((l) => s"${l.Sku}x${l.qty}").MkString(", ")
