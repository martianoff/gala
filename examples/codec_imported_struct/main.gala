package main

import (
    . "martianoff/gala/std"
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/json"
    "martianoff/gala/yaml"
    "martianoff/gala/examples/codec_imported_struct/billing"
)

// Encodes and decodes structs whose fields are structs declared in another
// package, imported by name: one with exported fields, one with only
// unexported fields, and one nesting an unexported struct type. Each must
// round-trip through JSON and YAML, nested directly, inside Option, Array,
// List and HashMap, and as the codec's root type. A struct with unexported
// fields is decoded through its Validate method, so input it rejects fails the
// decode with the error Validate returned.

struct User(Name string, Mail billing.Email, Key billing.Secret)

struct Account(
    Owner User,
    Backup Option[billing.Email],
    Others Array[billing.Email],
    Keys List[billing.Secret],
    ByLabel HashMap[string, billing.Secret],
    Bill billing.Invoice,
)

func describe(a Account) string {
    val keys = a.Keys.Map(_.Describe()).MkString(",")
    val labelled = a.ByLabel.Get("ci").Map(_.Describe()).GetOrElse("-")
    val backup = a.Backup.Map(_.V).GetOrElse("-")
    val others = a.Others.Map(_.V).MkString(",")
    s"${a.Owner.Name} <${a.Owner.Mail.V}> key=${a.Owner.Key.Describe()} backup=$backup others=$others keys=$keys ci=$labelled bill=${a.Bill.Describe()}"
}

func main() {
    val mail = billing.ParseEmail("ada@example.com").Get()
    val account = Account(
        User("Ada", mail, billing.NewSecret("s3cr3t", 3)),
        billing.ParseEmail("backup@example.com"),
        ArrayOf(billing.Email("a@x"), billing.Email("b@x")),
        ListOf(billing.NewSecret("k1", 1), billing.NewSecret("k2", 2)),
        EmptyHashMap[string, billing.Secret]().Put("ci", billing.NewSecret("ci-token", 9)),
        billing.NewInvoice(7, mail),
    )
    Println(describe(account))

    val jsonCodec = json.Codec[Account](json.SnakeCase())
    val encoded = jsonCodec.Encode(account).Get()
    Println(encoded)
    val fromJson = jsonCodec.Decode(encoded).Get()
    Println(describe(fromJson))
    Println(s"json round-trip equal: ${fromJson.Equal(account)}")

    val yamlCodec = yaml.Codec[Account](yaml.SnakeCase())
    val fromYaml = yamlCodec.Decode(yamlCodec.Encode(account).Get()).Get()
    Println(describe(fromYaml))
    Println(s"yaml round-trip equal: ${fromYaml.Equal(account)}")

    // An imported struct with unexported fields as the codec root.
    val secretCodec = json.Codec[billing.Secret](json.CamelCase())
    val secretJson = secretCodec.Encode(billing.NewSecret("root", 5)).Get()
    Println(secretJson)
    Println(secretCodec.Decode(secretJson).Get().Describe())

    val invoiceCodec = yaml.Codec[billing.Invoice](yaml.AsIs())
    Println(invoiceCodec.Decode(invoiceCodec.Encode(billing.NewInvoice(8, mail)).Get()).Get().Describe())

    decodeChecks()
}

// outcome renders a decode result: the value's description, or the error a
// Validate method rejected the input with.
func outcome[T any](result Try[T], describe func(T) string) string = result match {
    case Success(v) => describe(v)
    case Failure(err) => s"rejected: ${err.Error()}"
}

func decodeChecks() {
    // A struct with unexported fields is decoded through its Validate method,
    // as the root, nested, inside a collection, and under an array root.
    val secretCodec = json.Codec[billing.Secret](json.CamelCase())
    Println(outcome(secretCodec.Decode("{\"token\":\"ok\",\"uses\":1}"), _.Describe()))
    Println(outcome(secretCodec.Decode("{\"token\":\"\",\"uses\":1}"), _.Describe()))
    Println(outcome(secretCodec.Array().Decode("[{\"token\":\"a\",\"uses\":1},{\"uses\":2}]"), (ss) => ss.Map(_.Describe()).MkString(",")))

    val jsonCodec = json.Codec[Account](json.SnakeCase())
    val badKey = "{\"owner\":{\"name\":\"Ada\",\"mail\":{\"v\":\"a@x\"},\"key\":{\"token\":\"t\",\"uses\":1}}," +
        "\"keys\":[{\"token\":\"\",\"uses\":1}]," +
        "\"bill\":{\"number\":1,\"to\":{\"v\":\"a@x\"},\"lines\":[{\"sku\":\"pen\",\"qty\":1}]}}"
    Println(outcome(jsonCodec.Decode(badKey), describe))

    // An absent field holding such a struct is its empty value, and that is
    // checked too: an empty Secret has no token.
    Println(outcome(jsonCodec.Decode("{}"), describe))

    // YAML: an unexported struct type inside a collection of the root.
    val invoiceCodec = yaml.Codec[billing.Invoice](yaml.AsIs())
    Println(outcome(invoiceCodec.Decode("Number: 3\nTo:\n  V: a@x\nlines:\n  - Sku: pen\n    qty: 0\n"), _.Describe()))
    Println(outcome(invoiceCodec.Decode("Number: 4\nTo:\n  V: a@x\nlines: []\n"), _.Describe()))
    Println(outcome(invoiceCodec.Decode("Number: 5\nTo:\n  V: a@x\nlines:\n  - Sku: ink\n    qty: 2\n"), _.Describe()))
}
