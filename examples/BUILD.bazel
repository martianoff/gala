# file dot-imports std (`import . "martianoff/gala/std"`). The dot import is
# the trigger axis — it routes the lambda's expected return type through a
# code path that emitted bare `Try` instead of `Try[bool]`, producing
# generated Go that Go rejects with "cannot use generic type Try[T any]
# without instantiation".
gala_library(
    name = "try_chain_dot_import_std_repro_lib",
    srcs = [
        "try_chain_dot_import_std_repro/proc.gala",
        "try_chain_dot_import_std_repro/runtime.gala",
    ],
    importpath = "martianoff/gala/examples/try_chain_dot_import_std_repro",
    visibility = ["//visibility:public"],
)

# Multi-axis regression matrix for the same erasure path. Axes covered:
# A: std import shape (auto-import baseline A1; dot-import trigger A3 — A2
#    explicit-qualifier was excluded because that import shape currently
#    surfaces a separate duplicate-import emission quirk unrelated to this
#    fix and would otherwise mask the matrix's real coverage)
# B: receiver shape (bare param / struct field / function return)
# C: package boundary (same / cross via dot-imported sibling)
# D: chain shape (Map only / FlatMap-Map / depth-3 / FlatMap-to-match / match-arm)
# E: monad type (Try / Option / Either)
# F: type-arg shape (same / asymmetric / nested generic)
gala_library(
    name = "try_chain_dot_import_std_matrix_proc",
    srcs = ["try_chain_dot_import_std_matrix_proc/proc.gala"],
    importpath = "martianoff/gala/examples/try_chain_dot_import_std_matrix_proc",
    visibility = ["//visibility:public"],
)

# receiver methods come from a *different* GALA package than the consumer.
# This is the cross-package counterpart of try_chain_typeparam_repro_lib —
# it forces the cross-package method-return-type lookup path through the
# same closure-return-synthesis logic. Generated Go must spell out the
# outer closure return type as `Try[bool]` (not bare `Try`), otherwise it
# fails with `cannot use generic type std.Try[T any] without instantiation`.
gala_library(
    name = "cross_pkg_try_chain_proc",
    srcs = ["cross_pkg_try_chain/pkg_proc/proc.gala"],
    importpath = "martianoff/gala/examples/cross_pkg_try_chain/pkg_proc",
    visibility = ["//visibility:public"],
)

gala_library(
    name = "try_chain_dot_import_std_matrix_lib",
    srcs = [
        "try_chain_dot_import_std_matrix/axis_a1_auto_import.gala",
        "try_chain_dot_import_std_matrix/axis_a3_dot_import.gala",
        "try_chain_dot_import_std_matrix/axis_c_cross_pkg.gala",
        "try_chain_dot_import_std_matrix/axis_e2_option.gala",
        "try_chain_dot_import_std_matrix/axis_e3_either.gala",
        "try_chain_dot_import_std_matrix/types.gala",
    ],
    importpath = "martianoff/gala/examples/try_chain_dot_import_std_matrix",
    visibility = ["//visibility:public"],
    deps = [
        ":try_chain_dot_import_std_matrix_proc",
        "//collection_immutable",
    ],
)

gala_exec_test(
    name = "try_chain_dot_import_std_matrix",
    src = "try_chain_dot_import_std_matrix_main/main.gala",
    expected = "try_chain_dot_import_std_matrix_main/main.out",
    deps = [
        ":try_chain_dot_import_std_matrix_lib",
        ":try_chain_dot_import_std_matrix_proc",
        "//collection_immutable",
    ],
)

gala_library(
    name = "cross_pkg_try_chain_session",
    srcs = ["cross_pkg_try_chain/pkg_session/session.gala"],
    importpath = "martianoff/gala/examples/cross_pkg_try_chain/pkg_session",
    visibility = ["//visibility:public"],
    deps = [":cross_pkg_try_chain_proc"],
)

gala_exec_test(
    name = "cross_pkg_try_chain",
    src = "cross_pkg_try_chain/main/main.gala",
    expected = "cross_pkg_try_chain/main/main.out",
    deps = [
        ":cross_pkg_try_chain_proc",
        ":cross_pkg_try_chain_session",
    ],
)
