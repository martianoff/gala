# Verification: dot-import is preserved in generated Go even when the
# consumer references ONLY generic instantiations from that package (no
# non-generic anchor). The pruning scan must descend into *ast.IndexExpr
# wrappers (`Single[int]("g", 42)` is *ast.CallExpr{Fun: *ast.IndexExpr})
# otherwise the dot import is dropped and the file fails to compile with
# `undefined: Single`.
gala_test(
    name = "go_generic_struct_dot_import_only_generic",
    src = "go_generic_struct_dot_import_only_generic.gala",
    expected = "go_generic_struct_dot_import_only_generic.out",
    deps = ["//examples/qa_lib_bridge"],
)

