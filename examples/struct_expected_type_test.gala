package main

import "martianoff/gala/examples/struct_expected_type/units"

// A generic struct construction takes the type arguments its fields leave
// open from the expected type: `Tag("x")` in a function returning `Tag[int]`
// is a `Tag[int]`. That holds in every position an expected type reaches it
// from, through an alias of the struct type, and for structs of another
// package.

struct Tag[T any](Name string)

struct Pair[A any, B any](First A)

type Field[T any] struct {
    Label string
}

type IntTag Tag[int]

func (t Tag[T]) Describe() string = s"tag ${t.Name}"

func (p Pair[A, B]) Describe() string = s"pair ${p.First}"

func exprBody() Tag[int] = Tag("expr")

func blockValue(n int) Tag[int] {
    val name = s"block $n"
    Tag(name)
}

func earlyReturn(n int) Tag[int] {
    if (n < 0) {
        return Tag("negative")
    }
    Tag(Name = "non-negative")
}

func branches(flag bool) Tag[string] = if (flag) Tag("then") else Tag("else")

func arms(n int) Tag[bool] = n match {
    case 0 => Tag("zero")
    case _ => {
        val name = s"n=$n"
        Tag(name)
    }
}

func viaAlias() IntTag = Tag("alias")

func partly(n int) Pair[int, string] = Pair(n)

func typeStruct() Field[int] = Field(Label = "field")

struct Marker[T any]()

struct Boxed[T any](Value T)

func marker() Marker[string] = Marker()

func widened() Boxed[int64] = Boxed(1)

func takeTag(t Tag[int]) string = t.Describe()

func build(f func(int) Tag[int]) Tag[int] = f(7)

struct Holder(Inner Tag[int])

func remote(amount float64) units.Quantity[units.Meters] = units.Quantity(amount)

func remoteAlias(amount float64) units.Distance = units.Quantity(amount)

// A companion Apply construction follows the same rule, matching the expected
// type against what Apply returns. Only the construction that is the result
// value takes the result type: the helper below writes its own.
struct MkTag[T any]()

func (m MkTag[T]) Apply(name string) Tag[T] = Tag[T](name)

func viaApply() Tag[int] = MkTag("apply")

func applyBlock(n int) Tag[bool] {
    val helper = MkTag[string](s"helper $n")
    MkTag(s"${helper.Name} done")
}

func variantArms(n int) Either[string, int] = n match {
    case 0 => Left("zero")
    case _ => Right(n)
}

func remoteApply(amount float64) units.Quantity[units.Meters] = units.Measure(amount)

// A generic function whose type parameter only its result mentions takes it
// from the slot its call fills, under the same rule.
func emptyTag[T any]() Tag[T] = Tag[T]("empty")

func namedTag[T any](name string) Tag[T] = Tag[T](name)

func viaCall() Tag[int] = emptyTag()

func viaCallBranches(n int) Tag[string] = if (n > 0) namedTag(s"call $n") else emptyTag()

func takeBoolTag(t Tag[bool]) string = t.Describe()

// A branch with no type argument of its own takes it from its siblings.
func siblings(flag bool) string {
    val marker = if (flag) Marker[int]() else Marker()
    val tag = if (flag) MkTag("sibling") else Tag[bool]("other")
    val called = if (flag) emptyTag() else Tag[int]("other")
    s"$marker ${takeBoolTag(tag)} ${takeTag(called)}"
}

// So does a generic method, with or without arguments, in every slot: the
// result, an argument and an annotated val. Only the call that fills the slot
// takes its type; the receiver the call is made on does not.
func (t Tag[T]) Retag[U any]() Tag[U] = Tag[U](t.Name)

func (t Tag[T]) Rename[U any](name string) Tag[U] = Tag[U](name)

func retagged() Tag[int] = Tag[string]("retag").Retag()

func methodSlots() string {
    val renamed Tag[bool] = Tag[int]("x").Rename("renamed")
    s"${takeTag(Tag[string]("arg").Retag())} ${takeBoolTag(renamed)}"
}

func main() {
    Println(exprBody().Describe())
    Println(blockValue(2).Describe())
    Println(earlyReturn(-1).Describe())
    Println(earlyReturn(1).Describe())
    Println(branches(true).Describe())
    Println(branches(false).Describe())
    Println(arms(0).Describe())
    Println(arms(3).Describe())
    Println(viaAlias().Name)
    Println(partly(5).Describe())
    Println(typeStruct().Label)
    Println(s"${marker()}")
    Println(widened().Value)

    val annotated Tag[float64] = Tag("annotated")
    Println(annotated.Describe())
    Println(takeTag(Tag("argument")))
    Println(Holder(Tag("field")).Inner.Describe())
    Println(build((n) => Tag(s"lambda $n")).Describe())

    Println(remote(3.5).Amount)
    Println(remoteAlias(2.5).Amount)
    Println(units.Of(1.5).Amount)

    Println(viaApply().Describe())
    Println(applyBlock(4).Describe())
    Println(variantArms(0))
    Println(variantArms(2))
    Println(remoteApply(4.5).Amount)
    val measured units.Quantity[units.Seconds] = units.Measure(5.5)
    Println(measured.Amount)

    Println(viaCall().Describe())
    Println(viaCallBranches(1).Describe())
    Println(viaCallBranches(0).Describe())
    Println(siblings(true))
    Println(siblings(false))
    Println(retagged().Describe())
    Println(methodSlots())
}
