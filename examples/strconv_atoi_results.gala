package main

import "strconv"

// strconv.Atoi's results and errors: signs, a leading zero, int64's bounds,
// and the errors Go builds for bad input, which quote it.

func parsed(text string) string {
    val n, err = strconv.Atoi(text)
    if (err == nil) s"$n" else s"$n $err"
}

func main() {
    Println(parsed("0"), parsed("42"), parsed("-7"), parsed("+15"), parsed("007"), parsed("-0"))
    Println(parsed("9223372036854775807"), parsed("-9223372036854775808"), parsed("123456789012345678"))
    Println(parsed("x"))
    Println(parsed(""))
    Println(parsed("-"))
    Println(parsed("1_000"))
    Println(parsed("99999999999999999999"))
    Println(parsed("12a"))
    Println(parsed("héllo\n"))
}
