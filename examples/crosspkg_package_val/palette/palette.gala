package palette

import "martianoff/gala/examples/crosspkg_package_val/colors"

// Dot-imported by the consumer, so these are read as bare names there. Their
// initializers also reach into another package, so their element types come
// from that package's metadata.

// Blue is a val built from another package's sealed-variant constructor.
val Blue = colors.NamedColor(4)

// Accent re-exports another package's struct-typed val.
val Accent = colors.Default

// Label is a string val.
val Label = "palette"
