package main

import (
    "errors"
    "fmt"
    "unicode/utf8"
)

// errors.New and unicode/utf8.RuneCountInString from Go: each New is a new
// error, though the text is the same, and runes are counted, not bytes.

val errBoom = errors.New("boom")

func main() {
    val again = errors.New("x")
    Println(errBoom, errBoom == errBoom, errors.New("x") == again, again == again)
    fmt.Printf("[%8v] [%s]\n", errBoom, errors.New("hé"))
    Println(utf8.RuneCountInString(""), utf8.RuneCountInString("go"), utf8.RuneCountInString("héllo"))
    Println(utf8.RuneCountInString("日本語"), utf8.RuneCountInString("aé\U0001F600"))
}
