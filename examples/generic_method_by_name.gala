package main

// By-name arguments to a method with type parameters of its own: the plain
// expression is lifted to a thunk, so it runs only when the method calls it,
// as it does for a generic function or a method using only its receiver's
// type parameter. Each side effect prints a marker, `[n]` or `<s>`, when it
// runs.

struct Box[T any](V T)

func (b Box[T]) Lazy[U any](d func() U, on bool) Option[U] = if (on) Some(d()) else None()

func (b Box[T]) LazyT(d func() T, on bool) Option[T] = if (on) Some(d()) else None()

func (b Box[T]) OrElse[U any](o Option[U], d func() U) U = o match {
    case Some(v) => v
    case None() => d()
}

func (b Box[T]) Pair[A any, B any](a A, d func() B) Tuple[A, B] = (a, d())

func (b Box[T]) Get[U any](d func() Option[U], seed U) U = d().GetOrElse(seed)

func (b Box[T]) Run[U any](f Sendable[func() U]) U = f()

func lazy[U any](d func() U, on bool) Option[U] = if (on) Some(d()) else None()

var cnt = 0

func side() int {
    cnt = cnt + 1
    Print(s"[$cnt]")
    cnt
}

func label(s string) string {
    Print(s"<$s>")
    s
}

func main() {
    val b = Box(1)
    Println(lazy(side(), false), lazy(side(), true))
    Println(b.LazyT(side(), false), b.LazyT(side(), true))
    Println(b.Lazy(side(), false), b.Lazy(side(), true))
    Println(b.Lazy(on = false, d = label("x")), b.Lazy(on = true, d = label("y")))
    Println(b.Lazy[int](side(), false), b.Lazy[int](side(), true))
    Println(b.Pair[string](label("k"), side()))
    Println(b.Get(None[int](), 7), b.Get(Some(side()), 0))
    Println(b.Run(side()))
    Println(b.OrElse(Some("set"), label("unused")), b.OrElse(None[string](), label("fallback")))
    Println(b.OrElse(None[int64](), 5))
}
