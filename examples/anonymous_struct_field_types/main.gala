package main

import "martianoff/gala/examples/anonymous_struct_field_types/bridge"

// A Go function can return an anonymous struct type. GALA cannot write that
// type (GALA-E0090), but it types the value: the value can be bound with
// `val` and its fields read with their own types, whether a field is a
// fixed-length array, a generic type instance or an inline interface. A
// field's own type has a GALA spelling, so a field value fits in an Option.
func main() {
    val g = bridge.Grid()
    Println(g.Name, g.Cells)
    Println(Some(g.Cells).Get())

    val inner = bridge.Boxed().Inner
    Println(inner.Value + 1)
    Println(Some(inner).Map((b) => b.Value * 2).Get())

    val shape = bridge.Shaped().Shape
    Println(shape.Area())
    Println(Some(bridge.Shaped().Shape.Area()).Map((a) => a + 1).Get())
}
