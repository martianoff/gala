package main

import "fmt"
import . "martianoff/gala/go_interop"

func main() {
    val route = Route("GET", "/api/users", Handler("myHandler"))
    // Cross-file: access val field and pass to function
    val filtered = applyFilter(route.Handler, "auth")
    fmt.Println(filtered.Name)

    // Cross-file: access val field from slice element
    val routes = SliceOf(Route("GET", "/api", Handler("h1")), Route("POST", "/api", Handler("h2")))
    val r = routes[0]
    fmt.Println(r.Method)
    fmt.Println(r.Handler.Name)

    // Cross-file: pass field from slice element as function arg
    val filtered2 = applyFilter(r.Handler, "log")
    fmt.Println(filtered2.Name)
}
