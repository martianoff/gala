package go_struct_named_arg_regress

// MakeShelf builds a Shelf, a Go struct of this package's own shelf.go, with
// named arguments: a Go composite literal of plain fields, an unexported one
// included, and a lambda typed by its func field.
func MakeShelf(label string) Shelf = Shelf(Label = label, Scale = _ * 10, count = 2)

// ShelfString renders the Shelf MakeShelf builds for label.
func ShelfString(label string) string = MakeShelf(label).String()
