package go_struct_named_arg_regress

import "martianoff/gala/examples/go_struct_bridge"

// Go struct named-arg construction wraps fields in Immutable.
// The bug triggers when a GALA struct has the SAME NAME as a Go struct in another package.
//
// FULL REPRODUCTION of the named-arg fix requires external Go packages.
// Verified against gala-server (httpcore.SSEEvent). This test verifies:
// 1. GALA struct named-arg correctly wraps in Immutable
// 2. Go struct construction via Go bridge function works (no GALA interference)

// GALA struct named Cookie — same name as go_struct_bridge.Cookie
struct Cookie(Name string, Value string, Path string, Secure bool)

// Construct a GALA Cookie (should wrap in Immutable — correct)
func MakeGalaCookie(name string, value string) Cookie =
    Cookie(Name = name, Value = value, Path = "/", Secure = false)

func GalaCookieName(name string, value string) string =
    MakeGalaCookie(name, value).Name

// Construct a Go Cookie via Go bridge function (avoids GALA struct resolution)
func GoCookieString(name string, value string) string =
    go_struct_bridge.MakeCookie(name, value, "/").String()
