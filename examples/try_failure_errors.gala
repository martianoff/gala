package main

import (
    "errors"
    "fmt"
    "martianoff/gala/go_builtins"
)

// A Try records a panic as a Failure whose error prints as the panic's own: a
// string panic becomes an error with that text, an error panic is kept, and a
// Failure's error that Get raises again inside another Try is the same error.

func failWith(v any) int = go_builtins.Panic(v)

func main() {
    val fromString = Try(() => failWith("boom"))
    val fromError = Try(() => failWith(errors.New("bad input")))
    val reRaised = Try(() => fromError.Get() + 1)
    Println(fromString)
    Println(fromError)
    Println(reRaised)
    Println(fromError.GetError())
    Println(reRaised.GetError().Error())
    fmt.Printf("[%-12v] [%14s]\n", fromError.GetError(), reRaised.GetError())
    Println(fromError.GetOrElse(7), reRaised.IsFailure())
}
