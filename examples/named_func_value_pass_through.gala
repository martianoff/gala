package main

// A value of a named function type whose function type is the slot's is the
// function itself, however it is reached: a field, a call, a conversion. The
// callee runs it, as it would run a value of the function type as written.

type Action func()

type Getter func() int

struct Holder(act Action)

func call(f func() int) int = f() + f()

func one() int = 1

func mkGetter() Getter {
    Println("made getter")
    one
}

func callTwice(f func()) {
    f()
    f()
}

func mkAction() Action {
    Println("made")
    () => Println("made action")
}

func main() {
    val h = Holder(() => Println("field action"))
    callTwice(h.act)

    callTwice(mkAction())

    callTwice(Action(() => Println("converted action")))

    Println(call(mkGetter()))
    Println(call(Getter(one)))
}
