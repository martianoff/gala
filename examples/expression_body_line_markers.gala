package main

import "reflect"
import "regexp"

// A panic in an expression body, of a function, method, lambda or thunk,
// an if-expression or a match, reports the GALA line it is on.

struct Counter(x int)

func div(n int) int = 100 / n

func (c Counter) Div(n int) int = c.x / n

func divTwoLines(n int) int =
    100 / n

func report(n int) = Println(100 / n)

func divider() func(int) int = (n) => 100 / n

func applyTo(f func(int) int, n int) int = f(n)

// panicsAt reports whether the first GALA frame of the stack of the panic
// err came from, the one that panicked, is at the given .gala line. The file
// name is not matched, so the example can be run under any name.
func panicsAt(err error, line int) bool = PanicStack(err).Exists((stack) =>
    regexp.MustCompile(s"^(runtime\\.[^\\n]*\\n\\t[^\\n]*\\n)*main\\.[^\\n]*\\n\\t[^\\n]*\\.gala:$line\\n").MatchString(stack))

func main() {
    val lambda = (n int) => 100 / n
    Println(s"function: ${panicsAt(Try(div(0)).GetError(), 11)}")
    Println(s"method: ${panicsAt(Try(Counter(1).Div(0)).GetError(), 13)}")
    Println(s"expression on the next line: ${panicsAt(Try(divTwoLines(0)).GetError(), 16)}")
    Println(s"function returning nothing: ${panicsAt(TryApply(() => { report(0); 0 }).GetError(), 18)}")
    Println(s"returned lambda: ${panicsAt(Try(divider()(0)).GetError(), 20)}")
    Println(s"lambda: ${panicsAt(Try(lambda(0)).GetError(), 31)}")
    Println(s"placeholder lambda: ${panicsAt(Try(applyTo(100 / _, 0)).GetError(), 38)}")
    Println(s"argument of Try: ${panicsAt(Try(100 / zero()).GetError(), 39)}")
    Println(s"by-name argument: ${panicsAt(Try(later(100 / zero())).GetError(), 40)}")
    Println(s"block body with Go results: ${panicsAt(Try(firstStatement()).GetError(), 68)}")
    Println(s"self-tail-call loop: ${panicsAt(Try(countdown(3, 0)).GetError(), 72)}")
    var z = 0
    Println(s"lambda with a Ptr parameter: ${panicsAt(Try(each((p Ptr[int]) => 100 / *p, &z)).GetError(), 44)}")
    Println(s"self-tail-call loop on several lines: ${panicsAt(Try(countdownLines(3, 0)).GetError(), 78)}")
    val ifLambda = (n int) => if (n == 0) 100 / n else 1
    Println(s"lambda with an if-expression body: ${panicsAt(Try(ifLambda(0)).GetError(), 46)}")
    Println(s"if-expression body: ${panicsAt(Try(ifBody(0)).GetError(), 82)}")
    Println(s"if-expression body on several lines: ${panicsAt(Try(ifLines(0)).GetError(), 86)}")
    Println(s"match body: ${panicsAt(Try(matchBody(0)).GetError(), 92)}")
    Println(s"function returning nothing with an if-expression body: ${panicsAt(TryApply(() => { ifVoid(0); 0 }).GetError(), 95)}")
    Println(s"recursion that is not a tail call: ${panicsAt(Try(countdownNonTail(3, 0)).GetError(), 97)}")
    Println(s"if-expression condition: ${panicsAt(Try(ifCond(0)).GetError(), 99)}")
    Println(s"match subject: ${panicsAt(Try(matchSubject(0)).GetError(), 101)}")
    Println(s"else-if condition: ${panicsAt(Try(elseIf(0)).GetError(), 106)}")
    Println(s"else-if condition on several lines: ${panicsAt(Try(elseIfLines(0)).GetError(), 111)}")
    Println(s"else-if condition of a discarded if-expression: ${panicsAt(TryApply(() => { elseIfVoid(0); 0 }).GetError(), 116)}")
    Println(s"subject of a type-switch match: ${panicsAt(Try(dispatch(0)).GetError(), 120)}")
    Println(s"code after an if-expression: ${panicsAt(Try(afterIf(0)).GetError(), 125)}")
    Println(s"code after a match: ${panicsAt(Try(afterMatch(0)).GetError(), 130)}")
}

func zero() int = 0

func later(f func() int) int = f()

func firstStatement() (int, error) {
    val q = 100 / zero()
    Success(q)
}

func countdown(n int, acc int) int = if (n == 0) 100 / acc else countdown(n - 1, acc)

func each(f func(*int) int, x *int) int = f(x)

func countdownLines(n int, acc int) int =
    if (n == 0)
        100 / acc
    else
        countdownLines(n - 1, acc)

func ifBody(n int) int = if (n == 0) 100 / n else 1

func ifLines(n int) int =
    if (n == 0)
        100 / n
    else
        1

func matchBody(n int) int = n match {
    case 1 => 1
    case _ => 100 / n
}

func ifVoid(n int) = if (n == 0) Println(100 / n) else Println(1)

func countdownNonTail(n int, acc int) int = if (n == 0) 100 / acc else 0 + countdownNonTail(n - 1, acc)

func ifCond(n int) int = if (100 / n > 1) 1 else 2

func matchSubject(n int) int = (100 / n) match {
    case 1 => 1
    case _ => 2
}

func elseIf(n int) int = if (n == 1) 1 else if (100 / n == 2) 2 else 3

func elseIfLines(n int) int =
    if (n == 1)
        1
    else if (100 / n == 2)
        2
    else
        3

func elseIfVoid(n int) = if (n == 1) Println(1) else if (100 / n == 2) Println(2) else Println(3)


// dispatch's subject has Go's empty interface type, so a type switch matches it.
func dispatch(n int) string = reflect.ValueOf(100 / n).Interface() match {
    case i: int => s"int $i"
    case _ => "other"
}

func afterIf(n int) int = (if (n == 1) 1 else 2) + 100 / n

func afterMatch(n int) int = (n match {
    case 1 => 1
    case _ => 2
}) + 100 / n
