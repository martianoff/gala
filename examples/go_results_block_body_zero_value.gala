package main

import (
    "strconv"
    "sync"
)

// A block body that gives a Go call's results as one GALA value — a Try —
// spreads it over the results: on a failure Go receives the zero value with
// the error, not whatever the Go call returned alongside its error
// (strconv.Atoi returns the largest int with its range error).

func parse(s string) (int, error) {
    strconv.Atoi(s)
}

func main() {
    val tooBig = "99999999999999999999"

    val get = sync.OnceValues(() => {
        strconv.Atoi(tooBig)
    })
    val m, getErr = get()
    Println(s"block lambda: $m, failed: ${getErr != nil}")

    val viaFunc = sync.OnceValues(() => parse(tooBig))
    val k, funcErr = viaFunc()
    Println(s"function: $k, failed: ${funcErr != nil}")
}
