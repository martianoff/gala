package main

// An if-expression followed by a match: the match applies to the
// if-expression's value, in every position the value can be lowered in.
// tco_match_self_call covers the tail-recursive forms.

func name(c bool) string {
    val s string = if (c) { 1 } else { 2 } match {
        case 1 => "one"
        case _ => "other"
    }
    s
}

func show(s string) string = s"<$s>"

// In statement position the match is a statement-position match.
func say(c bool) {
    if (c) { 1 } else { 2 } match {
        case 1 => Println("say one")
        case _ => Println("say other")
    }
}

// A self call under an if-expression nested in an else branch and followed
// by a match is not in tail position: the match runs on every level.
func h(n int) int = if (n > 5) 1 else if (n > 0) h(n - 1) else { 0 } match {
    case 0 => 7
    case x => x
}

func main() {
    Println(name(true))
    Println(name(false))
    Println(show(if (true) { 2 } else { 1 } match {
        case 1 => "first"
        case _ => "second"
    }))
    say(true)
    say(false)
    Println(h(3))
}
