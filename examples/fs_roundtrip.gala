package main

// Verification example for the `fs` stdlib package: write a file,
// stat it, list the directory, read it back, then remove the scratch
// dir. Output is the round-trip text plus the recovered byte count and
// entry count, so the example has a stable cross-OS `.out`. ReadDir
// exercises the `entries[i].Info()` path: a Go method returning
// `(io/fs.FileInfo, error)` on an element of an `[]io/fs.DirEntry`
// slice, which the `fs` package (whose Go name collides with `io/fs`)
// must qualify correctly.

import (
    . "martianoff/gala/fs"
    . "martianoff/gala/std"
    "martianoff/gala/path"
    "os"
)

func main() {
    val dir = Try(os.MkdirTemp("", "fs_roundtrip_")).Get()

    val target = path.Join(dir, "greeting.txt")

    val payload = "hello, gala fs"
    val w = WriteFileString(target, payload, 0o644)
    Println(s"wrote: ${w.IsSuccess()}")

    val info = Stat(target)
    Println(s"stat ok: ${info.IsSuccess()} size=${info.Get().Size}")

    val entries = ReadDir(dir)
    Println(s"readdir ok: ${entries.IsSuccess()} count=${entries.Get().Size()}")

    val r = ReadFileString(target)
    Println(s"read back: ${r.Get()}")

    val cleanup = RemoveAll(dir)
    Println(s"cleanup: ${cleanup.IsSuccess()}")
    Println(s"dir gone: ${!Exists(dir)}")
}
