package main

// Literal-only arithmetic is a constant expression, evaluated exactly as in Go: an
// intermediate result may exceed int, only the final value has to fit.

struct Box(v int)

sealed type Shape {
    case Sq(side int)
    case Other()
}

func id(n int) int = n

func four() int = (1 << 70) >> 68

func main() {
    Println((1 << 70) >> 68)
    Println(9223372036854775807 * 2 / 4)
    Println(((1 << 64) - 1) / (1 << 62), -(1 << 63))
    Println(id((1 << 70) >> 68))
    Println(s"v=${(1 << 70) >> 68}")
    if ((1 << 70) >> 68 == 4) {
        Println("condition")
    }
    Println(((1 << 70) >> 68) match {
        case 4 => "subject"
        case _ => "other"
    })
    Println(4 match {
        case n if n == (1 << 70) >> 68 => "guard"
        case _ => "no guard"
    })
    Println(Box((1 << 70) >> 68), Sq((1 << 70) >> 68))
    Println(four())
    // A constant operand of a non-constant expression is folded on its own.
    val x = 3
    Println(x + (1 << 70) >> 68)
    Println((-7) / 2, (-7) % 3, (-5) >> 1, ^5)
}
