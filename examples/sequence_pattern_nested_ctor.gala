package main

import . "martianoff/gala/collection_immutable"

// Nested constructor patterns inside a sequence pattern, typed element
// patterns, and generic struct patterns against an `any` subject.
//
// A sub-pattern such as `Square(s)` in `case Array(Square(s), _)` is a pattern
// against the element, never a binding of the name `Square`; the bindings it
// declares (`s`) are visible to the arm. The arm is still gated on the size
// check, so a too-short sequence falls through to the next case.

sealed type Shape {
    case Circle(R int)
    case Square(S int)
}

struct Box[T any](V T, Tag string)
struct Pair[K any, V any](Key K, Val V)
struct Plain(N int)

func firstSquare(xs Array[Shape]) string = xs match {
    case Array(Square(s), _)       => s"square $s first of two"
    case Array(Circle(r), rest...) => s"circle $r then ${rest.Size()} more"
    case _                         => "no match"
}

func nestedOption(xs Array[Option[Shape]]) int = xs match {
    case Array(Some(Square(s)), rest...) => s + rest.Size()
    case Array(None(), _)                => -1
    case _                               => 0
}

func literalHead(xs List[int]) string = xs match {
    case List(0, second, _...) => s"zero then $second"
    case List(first, _...)     => s"starts with $first"
    case _                     => "empty"
}

func typedHead(xs Array[any]) string = xs match {
    case Array(n: int, _)    => s"int $n"
    case Array(s: string, _) => s"string $s"
    case _                   => "other"
}

func describe(x any) string = x match {
    case Box[int](v, tag)        => s"int box $tag ${v + 1}"
    case Box[string](v, _)       => s"string box ${v + "!"}"
    case Pair[string, int](k, v) => s"pair $k=${v * 2}"
    case Plain(n)                => s"plain $n"
    case _                       => "other"
}

func main() {
    Println(firstSquare(ArrayOf[Shape](Square(4), Circle(1))))
    Println(firstSquare(ArrayOf[Shape](Circle(2), Square(1), Square(3))))
    Println(firstSquare(ArrayOf[Shape](Square(4))))
    Println(firstSquare(EmptyArray[Shape]()))

    Println(nestedOption(ArrayOf[Option[Shape]](Some(Square(5)), None())))
    Println(nestedOption(ArrayOf[Option[Shape]](None(), None())))
    Println(nestedOption(EmptyArray[Option[Shape]]()))

    Println(literalHead(ListOf(0, 7, 8)))
    Println(literalHead(ListOf(3)))
    Println(literalHead(EmptyList[int]()))

    Println(typedHead(ArrayOf[any](1, "two")))
    Println(typedHead(ArrayOf[any]("one", 2)))
    Println(typedHead(EmptyArray[any]()))

    Println(describe(Box(V = 41, Tag = "b")))
    Println(describe(Box(V = "hi", Tag = "s")))
    Println(describe(Pair[string, int](Key = "k", Val = 21)))
    Println(describe(Plain(N = 3)))
    Println(describe(Box(V = true, Tag = "x")))
}
