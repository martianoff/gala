package main

import "fmt"
import . "martianoff/gala/strings"

func main() {
    val s = S("hello")

    // Lambda param type inferred from non-generic Str.Exists(func(rune) bool).
    // Without this inference, (r) would generate as func(r any) any — compile error.
    val hasE = s.Exists((r) => r == 'e')
    fmt.Println(hasE)

    // Lambda param type inferred from non-generic Str.ForAll(func(rune) bool)
    val allLower = s.ForAll((r) => r >= 'a' && r <= 'z')
    fmt.Println(allLower)
}
