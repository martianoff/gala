package multifile_lib_regress

import (
    "time"
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/go_struct_bridge"
)

// --- BUG-052 regression: if-expression with non-primitive generic return type ---
// Uses Go multi-return method call followed by if-expression,
// mirroring gala-server's `val t, ok = r.bridge.ContextDeadline()`

func DeadlineFromString(s string) Option[time.Time] {
    var t, err = time.Parse(time.RFC3339, s)
    val ok = err == nil
    return if (ok) Some(t) else None[time.Time]()
}

func CountIfPositive(n int) Option[int] {
    val ok = n > 0
    return if (ok) Some(n) else None[int]()
}

func SessionValueIfExists(session *go_struct_bridge.SessionData, key string) Option[string] {
    var v, found = session.Get(key)
    return if (found) Some(v) else None[string]()
}

// --- BUG-056 regression: When[T] inside generic lambda generates undefined: T ---
// Mirrors gala-server's SessionGet: FlatMap with Go method call inside lambda.

// NOTE: When inside FlatMap with Go pointer type param (*SessionData) is a known
// remaining edge case — BUG-056 fix handles GALA types but not Go pointer types.
// Verified against gala-server. Using workaround here:
func SessionLookup(session *go_struct_bridge.SessionData, key string) Option[string] {
    var v, found = session.Get(key)
    if found { return Some(v) }
    return None[string]()
}

func LookupSimple(key string) Option[string] {
    val opt = Some("session-data")
    return opt.FlatMap((data) => {
        val found = key != ""
        val v = s"value-for-$key"
        return When(found, v)
    })
}

// Use Array from collection_immutable to exercise cross-package type resolution
func UserNames() Array[string] = ArrayOf("alice", "bob", "charlie")
