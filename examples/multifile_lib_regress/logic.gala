package multifile_lib_regress

import (
    "errors"
    "time"
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/examples/go_struct_bridge"
)

// --- Regression: if-expression with non-primitive generic return type ---
// Uses Go multi-return method call followed by if-expression,
// mirroring gala-server's `val t, ok = r.bridge.ContextDeadline()`

func DeadlineFromString(s string) Option[time.Time] {
    var t, err = time.Parse(time.RFC3339, s)
    val ok = err == nil
    return if (ok) Some(t) else None[time.Time]()
}

func CountIfPositive(n int) Option[int] {
    val ok = n > 0
    return if (ok) Some(n) else None[int]()
}

func SessionValueIfExists(session *go_struct_bridge.SessionData, key string) Option[string] {
    var v, found = session.Get(key)
    return if (found) Some(v) else None[string]()
}

// --- Regression: When[T] inside generic lambda generates undefined: T ---
// Mirrors gala-server's SessionGet: FlatMap with Go method call inside lambda.

// NOTE: When inside FlatMap with Go pointer type param (*SessionData) is a known
// remaining edge case — the current fix handles GALA types but not Go pointer types.
// Verified against gala-server. Using workaround here:
func SessionLookup(session *go_struct_bridge.SessionData, key string) Option[string] {
    var v, found = session.Get(key)
    if found { return Some(v) }
    return None[string]()
}

func LookupSimple(key string) Option[string] {
    val opt = Some("session-data")
    return opt.FlatMap((data) => {
        val found = key != ""
        val v = s"value-for-$key"
        return When(found, v)
    })
}

// Use Array from collection_immutable to exercise cross-package type resolution
func UserNames() Array[string] = ArrayOf("alice", "bob", "charlie")

// --- Regression: lambda with multi-statement block body in generic Map[U] ---
// The trailing struct literal should be the lambda's implicit return value
// and U must be inferred to LabeledCell. Previously the block lambda was
// emitted as void (`func(...) { Cell{...} }`) which broke generic inference
// in batch transpile.
struct LabeledCell(Width int, Label string)

func BuildLabeledCells(headers Array[string], widths Array[int]) Array[LabeledCell] {
    return headers.ZipWithIndex().Map((pair) => {
        val w = if (pair.V2 < widths.Length()) widths.Get(pair.V2) else 0
        LabeledCell(Width = w, Label = pair.V1)
    })
}

// --- Regression: val-bound trailing identifier in Map / FlatMap block lambda ---
// The trailing `result` identifier must be promoted to a return statement
// even when its static type compiles down to `result.Get()` on an Immutable
// wrapper (which made the original type-name gate too conservative).
func DoubleEach(xs Array[int]) Array[int] {
    return xs.Map((x) => {
        val doubled = x * 2
        doubled
    })
}

func ExpandPairs(xs Array[int]) Array[int] {
    return xs.FlatMap((x) => {
        val pair = ArrayOf(x, x * 10)
        pair
    })
}

// --- Regression: positional Tuple constructor must infer type args ---
// `Tuple(a, b)` and `Tuple(a, b, c)` (no explicit type args, no named-arg
// form) previously emitted bare `std.Tuple{V1, V2}` literals — Go rejected
// these as "cannot use generic type without instantiation". The 3-arity
// form additionally lost its third arg because the Tuple→TupleN arity
// rewrite was missing on this path.
func MakeFlagPair(flag bool, label string) Tuple[bool, string] = Tuple(flag, label)

func MakeTriple(n int, label string, ratio float64) Tuple3[int, string, float64] =
    Tuple(n, label, ratio)

// --- Regression: tuple literal as call argument inherits element types from
// the call-site's expected parameter type (bidirectional inference).
// Without this the `(name, err)` literal had its first element collapse to
// `any` because `getExprTypeName` of the val-bound `name` did not resolve
// to a concrete `string` from the call-site context, and Append was rejected
// with `cannot use Tuple[any, error] as Tuple[string, error]`.
func CollectFailures(names Array[string]) Array[Tuple[string, error]] {
    var failures = EmptyArray[Tuple[string, error]]()
    names.ForEach((name) => {
        val err = NoSuchElement(s"failed-$name")
        failures = failures.Append((name, err))
    })
    return failures
}

// --- Regression: expression-bodied if-expression inside Map lambda whose
// arms reference methods on a user-defined generic type. HM type inference
// can't model methods on generics (env only carries top-level functions
// and current-scope vals), so the if-expression's IIFE return type must
// fall back to per-branch inference. Both arms are State[T], so the lambda
// must emit `func(State[T]) State[T]` rather than widening to `any`.
struct State[T any](Tag string, Make func() T)

func (s State[T]) Advance() State[T] = State[T](Tag = "armed", Make = s.Make)
func (s State[T]) IsDue() bool = s.Tag == "due"

func DispatchStates[T any](items Array[State[T]]) Array[State[T]] {
    return items.Map((it) => if (it.IsDue()) it.Advance() else it)
}

// --- Regression: expression-bodied if-expression inside Map lambda over a
// generic element type. Both arms return T, so the lambda's inferred return
// type must be T (and Map's U must be inferred to T). Previously the
// if-expression's IIFE return type was widened to `any` and the result
// became Array[any], breaking downstream Array[T] use sites.
func IfMapEcho[T any](items Array[T], pred func(T) bool, advance func(T) T) Array[T] {
    return items.Map((it) => if (pred(it)) advance(it) else it)
}

// --- Regression: downward inference of generic sealed-type case constructors.
// `NoCmd()` and `QuitCmd()` should resolve their type parameter from the
// enclosing context (val with explicit type, function return type, function
// argument expected type, container element type, match arm result type).
// Without inference these constructors emit uninstantiated `NoCmd{}.Apply()`
// literals which Go rejects with "cannot use generic type without
// instantiation".
sealed type Effect[T any] {
    case NoEffect()
    case Halt()
    case Yield(Value T)
}

// Context (1): val with explicit type drives downward inference.
val effectOne Effect[int] = NoEffect()

// Context (2): function return type drives downward inference.
func makeHalt() Effect[string] = Halt()

// Context (3): argument expected type drives downward inference.
func runEffect(e Effect[int]) string = e match {
    case NoEffect() => "noop"
    case Halt() => "halt"
    case Yield(_) => "yield"
}

func runDefaultNoEffect() string = runEffect(NoEffect())

// Context (4): container element type drives downward inference.
func defaultEffects() Array[Effect[int]] =
    ArrayOf[Effect[int]](NoEffect(), Halt(), Yield(7))

// Context (5): match arm result drives downward inference.
func selectEffect(n int) Effect[int] = n match {
    case 0 => NoEffect()
    case 1 => Halt()
    case _ => Yield(n)
}

// --- Regression: statement-position match with mixed value/void arms ---
// Lint suggested rewriting an explicit `if/else if/else` chain as a
// `match { ... }` used as a *statement* (its value discarded). When one
// arm called a function returning a typed value (e.g. bool from a Go
// method) and another arm called a void-returning function, the
// generated IIFE inherited the typed return type and the void arm was
// emitted as `return d.Skip()` — Go rejects that with "no value used as
// value". The fix lowers the IIFE as void in statement position so the
// void arms are emitted as bare expression statements.

func emitInfo() bool {
    Println("info")
    return true
}

func emitWarn() {
    Println("warn")
}

// EmitLevel uses match as a statement with mixed value/void arms.
// `info` arm calls a value-returning function; `warn` arm calls a void
// function; default arm is an assignment (statement). The match value
// is discarded — only the side effects matter.
func EmitLevel(level string) int {
    var unhandled = 0
    level match {
        case "info" => emitInfo()
        case "warn" => emitWarn()
        case _      => unhandled = unhandled + 1
    }
    return unhandled
}

// --- Regression: void-arm match terminating a lambda body inferred as
// value-returning lowered to `return <void-IIFE>`, producing Go's
// "(no value) used as value" error. The lambda is the trailing
// expression of `MakeProcessor`'s `return` statement; that path does
// not propagate an expected lambda return type, so the lambda's
// return type was inferred from its body. With every match arm void,
// the void IIFE was promoted to a return statement — invalid Go.
//
// The fix: void IIFEs are NOT promoted to `return` statements at the
// trailing position of a value-inferred lambda body; the lambda's
// inferred return type is left as void. Multi-file BatchAnalyzer path
// exercises the bug under cross-package import resolution, which the
// single-file fixture wouldn't otherwise verify.
struct ProcMember(Name string)

func ProcOutcome(m ProcMember) Try[bool] {
    if m.Name == "bad" {
        return Failure[bool](errors.New("oops"))
    }
    return Success[bool](true)
}

func MakeProcessor() func(ProcMember) {
    var counter = 0
    return (m ProcMember) => {
        ProcOutcome(m) match {
            case Success(_)   => counter = counter + 1
            case Failure(err) => Println(s"err: ${err.Error()}")
        }
    }
}

// --- Regression: two-param lambda passed to HashMap[K, V].ForEachKV must
// bind both K and V from the receiver's type arguments. Without the fix,
// the lambda's `(name, m)` parameters were inferred as (any, any), and the
// next call expecting a concrete Member value rejected the `any`-typed v
// with "cannot use m (variable of interface type any) as Member value in
// argument to memberKey: need type assertion".
struct Member(Name string, Email string)

// memberKey takes a concrete Member by value (not any). This call only
// compiles when the lambda binds v to V=Member.
func memberKey(m Member) string = s"${m.Name}<${m.Email}>"

func MembersByName(members HashMap[string, Member]) Array[string] {
    var out = EmptyArray[string]()
    members.ForEachKV((name, m) => {
        // `name` must be string (key type), `m` must be Member (value type).
        // Concatenate name with a member-derived string to exercise both.
        out = out.Append(s"$name => ${memberKey(m)}")
    })
    return out
}

// HashMap whose value type is a Go-declared struct (Event from events.go).
// The two-param lambda must bind `e` to the Go type Event, not any, so
// that field access `e.Status` compiles.
func EventStatusByMethod(events HashMap[string, Event]) Array[int] {
    var out = EmptyArray[int]()
    events.ForEachKV((m, e) => {
        // m: string, e: Event — accessing .Status only compiles when the
        // value type plumbed through to the lambda.
        out = out.Append(e.Status)
    })
    return out.Sorted()
}

// Two-param lambda whose body is a single statement-position match —
// mirrors the original failing shape from the bug report. The lambda
// must still bind v to V=Member.
sealed type CloseResult { case Closed() case CloseFailed(Err string) }

func tryClose(m Member) CloseResult = Closed()

func CloseAllMembers(members HashMap[string, Member]) Array[string] {
    var failures = EmptyArray[string]()
    members.ForEachKV((name, m) => {
        tryClose(m) match {
            case Closed()        => {}
            case CloseFailed(_)  => failures = failures.Append(s"$name=${memberKey(m)}")
        }
    })
    return failures.Sorted()
}

// --- Regression: chained `arr.Get(N).Field` match where Field has a
// generic type-arg (Option[string]). The match-IIFE param must keep the
// type-arg `string` — not erase to `Option[any]`. Cross-package batch
// mode is the path that originally surfaced the type-arg loss.
struct ConfigEntry(Name string, Model Option[string])

func ConfigEntries() Array[ConfigEntry] = ArrayOf[ConfigEntry](
    ConfigEntry(Name = "alpha", Model = Some("a-model")),
    ConfigEntry(Name = "beta",  Model = None[string]()),
)

// Direct chained accessor: `entries.Get(0).Model match { ... }`. Without
// the fix, the IIFE wrapper expected `Option[any]` but received
// `Immutable[Option[string]]`.
func DescribeFirstConfigModel() string = ConfigEntries().Get(0).Model match {
    case Some(m) => s"first-model:$m"
    case None()  => "first-no-model"
}

// Same shape with a val binding for the chained accessor result. Without
// an explicit annotation `Option[string]`, the val type-arg must still
// be preserved.
func DescribeFirstConfigModelVal() string {
    val entries = ConfigEntries()
    val model0  = entries.Get(0).Model
    return model0 match {
        case Some(m) => s"first-model:$m"
        case None()  => "first-no-model"
    }
}
