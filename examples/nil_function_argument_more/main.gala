package main

import (
    "time"
    "martianoff/gala/examples/nil_function_argument_bridge"
)

// `nil` for a zero-argument function parameter whose result nil cannot be is
// the function itself (#1448), also for a Go named array or an alias of one,
// a Go alias of a struct, a complex number, a Go `struct{}`, and a
// parenthesized `(nil)` (#1466), a Go alias of an unnamed array or a Go
// `func() [4]byte` parameter (#1476), and an instance of a generic Go alias
// whose target nil cannot be (#1478). For a Go alias of a pointer, which nil
// can be, by-name sugar still lifts `nil` into a thunk returning nil.

struct state(n int)

func viaArray(f func() nil_function_argument_bridge.ID, n int) int = if (f == nil) n else 0

func viaArrayAlias(f func() nil_function_argument_bridge.IDAlias, n int) int = if (f == nil) n else 0

func viaKey(f func() nil_function_argument_bridge.Key, n int) int = if (f == nil) n else 0

func viaAlias(f func() nil_function_argument_bridge.Stamp, n int) int = if (f == nil) n else f().Year()

func viaRef(f func() nil_function_argument_bridge.StampRef) string =
    if (f == nil) "nil function" else if (f() == nil) "nil pointer" else "pointer"

func viaId(f func() nil_function_argument_bridge.Id[int], n int) int = if (f == nil) n else f()

func viaQuad(f func() nil_function_argument_bridge.Quad[int], n int) int = if (f == nil) n else 0

func viaMoment(f func() nil_function_argument_bridge.Moment[string], n int) int = if (f == nil) n else 0

func viaComplex(f func() complex128, n int) int = if (f == nil) n else 0

func viaParen(f func() state, n int) int = if (f == nil) n else f().n

func main() {
    Println(viaArray(nil, 1))
    Println(viaArrayAlias(nil, 2))
    Println(viaAlias(nil, 3))
    Println(viaAlias(time.Date(2026, time.March, 1, 0, 0, 0, 0, time.UTC), 3))
    Println(viaRef(nil))
    Println(viaComplex(nil, 4))
    Println(nil_function_argument_bridge.Run(nil, 5))
    Println(viaParen((nil), 6))
    Println(viaParen(state(7), 6))
    Println(nil_function_argument_bridge.Pair((nil), 8))
    Println(viaKey(nil, 9))
    Println(nil_function_argument_bridge.RunArr(nil, 10))
    Println(viaId(nil, 13))
    Println(viaId(() => 11, 13))
    Println(viaMoment(nil, 14))
    Println(viaQuad(nil, 12))
}
