package main

import . "martianoff/gala/go_interop"

// A package-level val's `.Get()` changes nothing, so it does not count as a
// call that could change an earlier operand. A local binding that shares the
// val's name is a different value, and a `Get` method on it may change
// anything: the operand to its left is still read first. Each line prints the
// value the left-to-right order gives.

var hits = 0

struct Tally(n int)

func (t Tally) Get() int {
    hits = hits + 1
    hits * 10
}

val tally = 7

val viaParam = (tally Tally) => hits + tally.Get()

func viaFuncParam(tally Tally) int = hits + tally.Get()

val viaLambdaBody = (k int) int => {
    val tally = Tally(k)
    hits + tally.Get()
}

// A range variable named like the package var hides it only in its loop:
// the read after the loop is still the var's.
func afterRange() int {
    for _, hits := range SliceOf(0) {
        Println(s"range variable named like a var: ${hits}")
    }
    hits + Tally(0).Get()
}

struct Cell(var n int)

func (c *Cell) Add(k int) int {
    c.n = c.n + k
    c.n
}

var origin = Cell(100)
var cell = &origin

// A range variable named like a package var is the receiver of a
// pointer-receiver method: the method takes the range variable itself.
func rangeReceiver() int {
    var total = 0
    for _, cell := range SliceOf(Cell(1)) {
        total = cell.Add(Tally(0).Get())
    }
    total
}

func main() {
    val tally = Tally(0)
    Println(s"local val: ${hits + tally.Get()}")
    Println(s"lambda parameter of a package val: ${viaParam(Tally(0))}")
    Println(s"function parameter: ${viaFuncParam(Tally(0))}")
    for _, tally := range SliceOf(Tally(0)) {
        Println(s"range variable: ${hits + tally.Get()}")
    }
    Println(s"local val in a package-level lambda: ${viaLambdaBody(0)}")
    Println(s"var read after a range variable of its name: ${afterRange()}")
    Println(s"range variable as a pointer-method receiver: ${rangeReceiver()} ${origin.n}")
}
