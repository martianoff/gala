package main

import (
    "runtime"
    . "martianoff/gala/subprocess"
    "martianoff/gala/go_interop"
)

// Verifies subprocess.ReadLineAsync end to end: spawn a child that echoes one
// known line, read it OFF-THREAD via the returned Future, and print it. The
// command is selected per-platform so the program is deterministic on both
// Windows (cmd) and Unix (sh).

func shellOpts(script string) SpawnOpts {
    val cmd = if (runtime.GOOS == "windows") "cmd" else "sh"
    val flag = if (runtime.GOOS == "windows") "/c" else "-c"
    return SpawnOpts(
        Cmd = cmd,
        Args = go_interop.SliceOf(flag, script),
        Env = go_interop.SliceEmpty[string](),
        Dir = "",
    )
}

func main() {
    val p = Spawn(shellOpts("echo hello-async")).Get()
    // ReadLineAsync returns Future[Try[string]]: the outer .Get() awaits the
    // Future off the calling goroutine, the inner .Get() unwraps the line.
    val line = p.ReadLineAsync().Get().Get()
    Println(line)
    p.Wait()
}
