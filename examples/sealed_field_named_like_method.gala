package main

import . "martianoff/gala/collection_immutable"

// A sealed type's method may share its name with a case field: the field
// belongs to its case, the method to the whole type.

sealed type Transition {
    case Epsilon(Target int)
    case Atom(Target int, Label int)
}

// Target is the state the transition leads to.
func (t Transition) Target() int = t match {
    case Epsilon(target) => target
    case Atom(target, _) => target
}

// Size's field changes type between cases as well as naming the method.
sealed type Bound {
    case Exact(Size int)
    case Named(Size string)
}

func (b Bound) Size() string = b match {
    case Exact(n) => s"exactly $n"
    case Named(name) => s"named $name"
}

// A generic sealed type, and fields named like the String, Copy and Equal
// methods every sealed type has.
sealed type Tagged[T any] {
    case Plain(Value T)
    case Labeled(Value T, String string, Copy int, Equal bool)
}

func (t Tagged[T]) Value() T = t match {
    case Plain(v) => v
    case Labeled(v, _, _, _) => v
}

func describe(t Transition) string = t match {
    case Atom(Label = label) => s"atom $label -> ${t.Target()}"
    case Epsilon(_) => s"epsilon -> ${t.Target()}"
}

func main() {
    val ts = ArrayOf(Epsilon(1), Atom(2, 7))
    ts.ForEach((t) => Println(describe(t)))
    ts.ForEach((t) => Println(t))
    val next = ts.Map((t) => t.Target())
    Println(next)
    val target = Atom(3, 9).Target
    Println(target())
    Println(Epsilon(1) == Epsilon(1), Atom(2, 7) == Atom(2, 8))
    Println(Atom(2, 7).Copy())

    Println(Exact(3).Size(), Named("big").Size())

    val l = Labeled(5, "five", 1, true)
    Println(l, l.Value(), Plain("x").Value())
    Println(l.Copy() == l)
    l match {
        case Labeled(v, s, c, e) => Println(v, s, c, e)
        case Plain(v) => Println(v)
    }
}
