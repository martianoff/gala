package main

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/collection_mutable"
)

// Iterable[T, C] carries the collection's own type C, so generic code over any
// iterable gets the concrete collection back from Filter, Tail and the other
// sub-collection methods. T and C are inferred from the argument.

// evens keeps the even elements. The result is the caller's own collection
// type: an Array for an Array, a List for a List.
func evens[C any](xs Iterable[int, C]) C = xs.Filter((x) => x % 2 == 0)

// rest drops the first element, whatever the element type.
func rest[T any, C any](xs Iterable[T, C]) C = xs.Tail()

// halves splits any iterable at its middle into two collections of its type.
func halves[T any, C any](xs Iterable[T, C]) Tuple[C, C] = xs.SplitAt(xs.Size() / 2)

// describe uses only the element-level methods.
func describe[T any, C any](xs Iterable[T, C]) string =
    s"size=${xs.Size()} head=${xs.HeadOption()} [${xs.MkString(", ")}]"

func main() {
    val arr = evens(rest(ArrayOf(1, 2, 3, 4, 5, 6)))
    val list = evens(ListOf(2, 4, 5, 8))
    // The results are the concrete collections, with their own methods.
    Println(arr, arr.Get(0))
    Println(list, list.Prepend(0))
    Println(rest(ListOf("x", "y", "z")).Head())

    val (front, back) = halves(ArrayOf("a", "b", "c"))
    Println(front, back, back.Last())
    Println(halves(ListOf(1.5, 2.5)))

    // A value of the concrete type fills an Iterable slot directly.
    val it Iterable[int, Array[int]] = ArrayOf(7, 8, 9)
    val (small, large) = it.Partition((x) => x < 8)
    Println(small, large)
    Println(describe(it.Drop(1)))
    Println(describe(EmptyList[string]()))

    // The mutable collections implement it through their pointer,
    // Ptr[Array[T]] as Iterable[T, Ptr[Array[T]]].
    val buf = collection_mutable.ArrayOf(1, 2, 3, 4)
    val even = evens(buf)
    even.Append(10)
    Println(even, buf)
    val queue = collection_mutable.ListOf(3, 4, 5)
    val (odd, others) = queue.Span((x) => x % 2 == 1)
    Println(odd, others, halves(queue))
}
