package main

// An untyped constant binds a method's type parameter only weakly, as in Go:
// a later typed argument replaces the binding, a constant of a wider kind
// widens it, and the slot the call fills fixes it over all of them. This
// holds when the later argument is passed by name (`func() U`) too.

struct Cell[T any](V T)

func (c Cell[T]) Both[U any](d func() U, e func() U) U = e()

func (c Cell[T]) Or[U any](a U, b func() U) U = b()

func (c Cell[T]) Pick[U any](a U, b U) U = a

func main() {
    val x64 int64 = 3
    val x32 float32 = 1.5
    val c = Cell(0)
    // U is int64, from x64.
    Println(c.Both(5, x64) + x64)
    // U widens to float64.
    Println(c.Both(5, 2.5))
    Println(c.Or(0, 2.5))
    // U is float32, from x32.
    Println(c.Or(0, x32) + x32)
    // The int slot fixes U, though the first constant is a float.
    val n int = c.Pick(1.0, 2)
    Println(n)
}
