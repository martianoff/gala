package main

import (
    "fmt"
    . "martianoff/gala/collection_immutable"
)

// L4: Placeholder lambda shorthand — `_ * 2` desugars to `(x) => x * 2`.
// Exercises:
//   - single placeholder in a Map call
//   - single placeholder in a Filter call
//   - placeholder with method-call body (_.toString-style chaining)
//   - two placeholders in a FoldLeft → two-param lambda
//   - placeholder with nested expression (_ + 1) * 2 semantics
func main() {
    val nums = ArrayOf[int](1, 2, 3, 4, 5)

    // Single placeholder — doubles each element.
    val doubled = nums.Map(_ * 2)
    fmt.Println(doubled.Get(0), doubled.Get(1), doubled.Get(4))

    // Single placeholder — keeps only even elements.
    val evens = nums.Filter(_ % 2 == 0)
    fmt.Println(evens.Size())

    // Two placeholders — sum via FoldLeft.
    val sum = nums.FoldLeft(0, _ + _)
    fmt.Println(sum)

    // Two placeholders — product via FoldLeft.
    val product = nums.FoldLeft(1, _ * _)
    fmt.Println(product)

    // Placeholder with parenthesized nested expression.
    val plusOneDoubled = nums.Map((_ + 1) * 2)
    fmt.Println(plusOneDoubled.Get(0), plusOneDoubled.Get(4))
}
