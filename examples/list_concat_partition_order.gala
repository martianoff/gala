package main

import . "martianoff/gala/collection_immutable"

// Regression pin for the single-pass Partition (was O(2n) via
// Filter+FilterNot): it must preserve input order — this example prints
// enough structure to catch an accidental reversal. Concat is pinned in
// concat_collections.
func main() {
    // Partition: split [1..6] by evenness. Left = 2,4,6 (in original order),
    // right = 1,3,5 (in original order).
    val nums = ListOf(1, 2, 3, 4, 5, 6)
    val split = nums.Partition((x) => x % 2 == 0)
    Print("evens:")
    split.V1.ForEach((x) => Print(s" $x"))
    Println("")
    Print("odds:")
    split.V2.ForEach((x) => Print(s" $x"))
    Println("")

    // AppendAll, which Concat is, preserves element order.
    val a = ListOf(1, 2, 3)
    val b = ListOf(4, 5, 6)
    val joined = a.AppendAll(b)
    joined.ForEach((x) => Print(s"$x "))
    Println("")
}
