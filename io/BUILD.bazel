load("@rules_gala//gala:defs.bzl", "gala_bootstrap_transpile", "gala_library", "gala_test")

exports_files(["io.gala"])

gala_bootstrap_transpile(
    name = "io_go",
    src = "io.gala",
    out = "io.gen.go",
)

filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

gala_library(
    name = "io",
    src = "io.gala",
    importpath = "martianoff/gala/io",
    visibility = ["//visibility:public"],
)

gala_test(
    name = "io_test",
    srcs = ["io_test.gala"],
    deps = [":io"],
)
