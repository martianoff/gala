load("@rules_gala//gala:defs.bzl", "gala_bootstrap_transpile", "gala_library", "gala_test")

exports_files(["io.gala"])

gala_bootstrap_transpile(
    name = "io_go",
    src = "io.gala",
    out = "io.gen.go",
)

filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

gala_library(
    name = "io",
    src = "io.gala",
    importpath = "martianoff/gala/io",
    visibility = ["//visibility:public"],
)

gala_test(
    name = "io_test",
    srcs = ["io_test.gala"],
    deps = [":io"],
)

# Every non-test source file this package ships. The released CLI embeds a
# snapshot of the stdlib (//internal/stdlib:generate_embedded); its
# completeness test compares that snapshot against this glob, so a new file
# here that is not added to the embed fails bazel test, not the released CLI.
filegroup(
    name = "shipped_sources",
    srcs = glob(
        [
            "*.gala",
            "*.go",
        ],
        exclude = [
            "*_test.gala",
            "*_test.go",
            "*.gen.go",
        ],
        # A pure-Go or pure-GALA package leaves one pattern empty.
        allow_empty = True,
    ),
    visibility = ["//internal/stdlib:__pkg__"],
)
