load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_gala//gala:defs.bzl", "gala_bootstrap_transpile", "gala_library", "gala_test")
load("//internal/stdlib:shipped_sources.bzl", "stdlib_shipped_sources")

exports_files([
    "stream.gala",
])

filegroup(
    name = "gala_sources",
    srcs = glob(
        ["*.gala"],
        exclude = ["*_test.gala"],
    ),
    visibility = ["//visibility:public"],
)

gala_bootstrap_transpile(
    name = "stream_go",
    src = "stream.gala",
    out = "stream.gen.go",
)

go_library(
    name = "stream",
    srcs = ["stream.gen.go"],
    importpath = "martianoff/gala/stream",
    visibility = ["//visibility:public"],
    deps = [
        "//collection_immutable",
        "//std",
    ],
)

gala_test(
    name = "stream_test",
    srcs = ["stream_test.gala"],
    deps = [
        ":stream",
        "//collection_immutable",
    ],
)

# Go benchmarks (time and allocations per op). Run with:
#   bazel run //stream:stream_bench -- -test.bench=. -test.benchmem -test.run='^$'
go_test(
    name = "stream_bench",
    srcs = ["stream_bench_test.go"],
    embed = [":stream"],
    deps = [
        "//collection_immutable",
        "//std",
    ],
)

# Declares :shipped_sources for the stdlib embed completeness test.
stdlib_shipped_sources()
