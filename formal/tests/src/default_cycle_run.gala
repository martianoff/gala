package main

// A default that calls its own function and leaves itself out, evaluated:
// the call recurses forever, so the run ends out of fuel like any endless
// recursion. (gala build overflows its stack on this program, #1199.)
func f(a int, b int = f(1)) int = a + b

func main() {
    Println("before")
    Println(f(0))
}
