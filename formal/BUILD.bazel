# The Lean spec, built with rules_lean under --config=formal; see README.md,
# "Building with Bazel". Hand-written (gazelle skips formal/). Load the Lean
# rules from :lean.bzl, which keeps every Lean target behind the config.

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":lean.bzl", "lean_binary", "lean_library", "lean_proof_test", "lean_runtime")

# Set by --config=formal in //.bazelrc.
bool_flag(
    name = "lean",
    build_setting_default = False,
)

config_setting(
    name = "lean_enabled",
    flag_values = {":lean": "True"},
    # For targets outside formal/ that use a Lean target only under the config
    # (the differential test's data, and the generator's check against T2).
    visibility = [
        "//internal/formal:__subpackages__",
        "//internal/transpiler/fuzz:__pkg__",
    ],
)

