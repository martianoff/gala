# The Lean spec, built with rules_lean under --config=formal; see README.md,
# "Building with Bazel". Hand-written (gazelle skips formal/). Load the Lean
# rules from :lean.bzl, which keeps every Lean target behind the config.

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":lean.bzl", "lean_binary", "lean_library", "lean_proof_test")

# Set by --config=formal in //.bazelrc.
bool_flag(
    name = "lean",
    build_setting_default = False,
)

config_setting(
    name = "lean_enabled",
    flag_values = {":lean": "True"},
    # For targets outside formal/ that use a Lean target only under the config
    # (the differential test's data).
    visibility = ["//internal/formal:__subpackages__"],
)

# The theorems COVERAGE.md calls proved: the same list as requiredTheorems in
# scripts/ProofCheck.lean, which tools/check_repo_policy.sh keeps in step.
REQUIRED_THEOREMS = [
    "Gala.MatchLowering.compile_correct",
    "Gala.MatchLowering.program_correct",
    "Gala.MatchLowering.leaky_not_correct",
    "Gala.Spec.run_deterministic",
    "Gala.Spec.eval_deterministic",
    "Gala.Spec.lookup_bind_self",
    "Gala.Spec.lookup_bind_other",
    "Gala.Spec.update_length",
    "Gala.Spec.exitScope_push",
    "Gala.Spec.lookup_rename",
    "Gala.Spec.update_rename",
    "Gala.Spec.exitScope_rename",
    "Gala.Spec.evalList_cons",
    "Gala.Spec.evalList_nil",
    "Gala.Spec.capturedEnv_captured",
    "Gala.Spec.lookup_captured",
    "Gala.Spec.defaultFrame_other",
    "Gala.Spec.defaultFrame_last",
]

# The modules under Gala/, in dependency order: a module may import only the
# modules listed before it (in its own list or in a library it depends on).
# This file is the module root, so module names are Gala.X, as with Lake.

# The interpreter: what galaspec and its tests link.
GALASPEC_SRCS = [
    "Gala/Syntax.lean",
    "Gala/Json.lean",
    "Gala/Scope.lean",
    "Gala/Print.lean",
    "Gala/Eval.lean",
    "Gala/Cli.lean",
]

# galaspec's `main`, apart so that the test binary has only its own `main`.
GALASPEC_MAIN = "Gala/Main.lean"

# Models and theorems, and Gala.lean, which imports every module and stays last.
GALA_SRCS = [
    "Gala/MatchLowering.lean",
    "Gala/Theorems.lean",
    "Gala.lean",
]

# A module Lake builds but Bazel doesn't would go unchecked here.
[
    fail(("formal/{} is not in formal/BUILD.bazel; add it to GALASPEC_SRCS (interpreter) " +
          "or GALA_SRCS (models and theorems, before Gala.lean), after the modules it " +
          "imports").format(f))
    for f in glob(["Gala/**/*.lean"])
    if f not in GALASPEC_SRCS + [GALASPEC_MAIN] + GALA_SRCS
]

lean_library(
    name = "galaspec_lib",
    srcs = GALASPEC_SRCS,
)

lean_library(
    name = "galaspec_main",
    srcs = [GALASPEC_MAIN],
    deps = [":galaspec_lib"],
)

# The `Gala` library as Lake's `import Gala` sees it (every module but Main).
lean_library(
    name = "gala",
    srcs = GALA_SRCS,
    visibility = ["//visibility:public"],
    deps = [":galaspec_lib"],
)

# Like scripts/ProofCheck.lean under Lake: fails on sorry and on axioms other
# than Lean's standard three, in every declaration (private ones included) of
# every module under Gala/ (Main included), and when a theorem COVERAGE.md
# calls proved is missing.
lean_proof_test(
    name = "proofs",
    allowed_axioms = [
        "propext",
        "Quot.sound",
        "Classical.choice",
    ],
    required_theorems = REQUIRED_THEOREMS,
    deps = [
        ":gala",
        ":galaspec_lib",
        ":galaspec_main",
    ],
)

# The reference interpreter (`galaspec run prog.json`), for the differential
# harness. A development and CI tool only; it never ships.
lean_binary(
    name = "galaspec",
    visibility = ["//internal/formal:__subpackages__"],
    deps = [":galaspec_main"],
)

# The command-line contract the differential harness relies on, for this
# binary (formal.yml checks the Lake-built one the same way).
sh_test(
    name = "galaspec_cli_test",
    srcs = ["galaspec_cli_test.sh"],
    args = [
        "$(rootpath :galaspec)",
        "$(rootpath tests/panic_divide.json)",
        "$(rootpath tests/ex_tco_deep_sum.json)",
    ],
    data = [
        "tests/ex_tco_deep_sum.json",
        "tests/panic_divide.json",
        ":galaspec",
    ],
)

lean_library(
    name = "galaspec_tests_main",
    srcs = ["tests/GalaTests.lean"],
    strip_prefix = "tests",
    deps = [":galaspec_lib"],
)

lean_binary(
    name = "galaspec_tests_bin",
    deps = [":galaspec_tests_main"],
)

# `lake exe galaspec-tests`: runs the Core JSON fixtures in tests/. The binary
# reads them from ./tests, so the wrapper runs it from formal/ in the runfiles
# tree (which needs --enable_runfiles, set in //.bazelrc; tests/GalaTests.lean
# takes no fixture directory). It depends on a Lean target, so it is skipped
# without --config=formal too.
sh_test(
    name = "galaspec_tests",
    srcs = ["galaspec_tests.sh"],
    args = ["$(rootpath :galaspec_tests_bin)"],
    data = [":galaspec_tests_bin"] + glob([
        "tests/*.json",
        "tests/*.out",
        "tests/*.outcome",
    ]),
)
