# The modules under Gala/, in dependency order: a module may import only the
# modules listed before it (in its own list or in a library it depends on).
# This file is the module root, so module names are Gala.X, as with Lake.

# What both semantics share, importing neither: exact constant arithmetic.
SHARED_SRCS = [
    "Gala/Exact.lean",
]

# The interpreter: what galaspec and its tests link.
GALASPEC_SRCS = [
    "Gala/Syntax.lean",
    "Gala/Const.lean",
    "Gala/Json.lean",
    "Gala/Scope.lean",
    "Gala/Print.lean",
    "Gala/Eval.lean",
    "Gala/AlphaCheck.lean",
    "Gala/Cli.lean",
]

# galaspec's `main`, apart so that the test binary has only its own `main`.
GALASPEC_MAIN = "Gala/Main.lean"

# GoCore for whole programs (M4): the Lean model of the Go the transpiler emits,
# which the `gocore` binary runs on the Go AST exporter's output.
GOCORE_SRCS = [
    "Gala/GoCore/Syntax.lean",
    "Gala/GoCore/Json.lean",
    "Gala/GoCore/Value.lean",
    "Gala/GoCore/Float.lean",
    "Gala/GoCore/Prog.lean",
    "Gala/GoCore/Ops.lean",
    "Gala/GoCore/GcRuntime.lean",
    "Gala/GoCore/Eval.lean",
    "Gala/GoCore/Hoist.lean",
    "Gala/GoCore/Run.lean",
    "Gala/GoCore/Cli.lean",
]

# Models and theorems, and Gala.lean, which imports every module and stays last.
GALA_SRCS = [
    "Gala/GoCore.lean",
    "Gala/Gala2Lean/Prelude.lean",
    "Gala/Gala2Lean/Examples/Match.lean",
    "Gala/Gala2Lean/Theorems.lean",
    "Gala/Theorems.lean",
    "Gala/Fuel.lean",
    "Gala/Defaults.lean",
    "Gala/Order.lean",
    "Gala/Alpha.lean",
    "Gala/AlphaStep.lean",
    "Gala/MatchLower.lean",
    "Gala/AlphaEval.lean",
    "Gala/AlphaConst.lean",
    "Gala/AlphaProg.lean",
    "Gala/M5/SpecPure.lean",
    "Gala/M5/Bits.lean",
    "Gala/M5/Expr.lean",
    "Gala/M5/Stmt.lean",
    "Gala/M5/StmtOrder.lean",
    "Gala/M5/Call.lean",
    "Gala/M5/CallOrder.lean",
    "Gala/M5/CallInst.lean",
    "Gala/M5/IifeInst.lean",
    "Gala/Statements.lean",
    "Gala.lean",
]

# A module Lake builds but Bazel doesn't would go unchecked here.
[
    fail(("formal/{} is not in formal/BUILD.bazel; add it to GALASPEC_SRCS (interpreter) " +
          "or GALA_SRCS (models and theorems, before Gala.lean), after the modules it " +
          "imports").format(f))
    for f in glob(["Gala/**/*.lean"])
    if f not in SHARED_SRCS + GALASPEC_SRCS + [GALASPEC_MAIN] + GOCORE_SRCS + GALA_SRCS
]

lean_library(
    name = "shared_lib",
    srcs = SHARED_SRCS,
)

lean_library(
    name = "galaspec_lib",
    srcs = GALASPEC_SRCS,
    deps = [":shared_lib"],
)

lean_library(
    name = "galaspec_main",
    srcs = [GALASPEC_MAIN],
    deps = [":galaspec_lib"],
)

lean_library(
    name = "gocore_lib",
    srcs = GOCORE_SRCS,
    deps = [":shared_lib"],
)

# gocore's `main`, outside Gala/ so that the proof check, which imports every
# module there together, does not see two `main`s.
lean_library(
    name = "gocore_main",
    srcs = ["GoCoreMain.lean"],
    deps = [":gocore_lib"],
)

# The `Gala` library as Lake's `import Gala` sees it (every module but Main).
lean_library(
    name = "gala",
    srcs = GALA_SRCS,
    visibility = ["//visibility:public"],
    deps = [
        ":galaspec_lib",
        ":gocore_lib",
    ],
)

# Like scripts/ProofCheck.lean under Lake: fails on sorry and on axioms other
# than Lean's standard three, in every declaration (private ones included) of
# every module under Gala/ (Main included), and when a theorem COVERAGE.md
# calls proved is missing.
lean_proof_test(
    name = "proofs",
    allowed_axioms = [
        "propext",
        "Quot.sound",
        "Classical.choice",
    ],
    required_theorems = REQUIRED_THEOREMS,
    deps = [
        ":gala",
        ":galaspec_lib",
        ":galaspec_main",
        ":gocore_lib",
        ":shared_lib",
    ],
)

# The reference interpreter (`galaspec run prog.json`), for the differential
# harness. A development and CI tool only; it never ships.
lean_binary(
    name = "galaspec",
    visibility = [
        "//internal/formal:__subpackages__",
        "//internal/transpiler/fuzz:__pkg__",
    ],
    deps = [":galaspec_main"],
)

# The command-line contract the differential harness relies on, for this
# binary (formal.yml checks the Lake-built one the same way).
sh_test(
    name = "galaspec_cli_test",
    srcs = ["galaspec_cli_test.sh"],
    args = [
        "$(rootpath :galaspec)",
        "$(rootpath tests/panic_divide.json)",
        "$(rootpath tests/ex_tco_deep_sum.json)",
    ],
    data = [
        "tests/ex_tco_deep_sum.json",
        "tests/panic_divide.json",
        ":galaspec",
    ],
)

# GoCore, the Lean model of the Go the transpiler emits (`gocore run
# prog.json`), for the differential harness. A development and CI tool only.
lean_binary(
    name = "gocore",
    visibility = ["//internal/formal:__subpackages__"],
    deps = [":gocore_main"],
)

# GoCore's fixtures: Go programs whose output, outcome and panic text come
# from a real `go run` (tests/gocore/regen.sh), run through gocore.
sh_test(
    name = "gocore_tests",
    srcs = ["gocore_tests.sh"],
    args = ["$(rootpath :gocore)"] + ["$(rootpath {})".format(f) for f in glob(
        ["tests/gocore/*.json"],
        exclude = ["tests/gocore/fuel.json"],
    )],
    data = [":gocore"] + glob(
        [
            "tests/gocore/*.json",
            "tests/gocore/*.out",
            "tests/gocore/*.outcome",
            "tests/gocore/*.panic",
        ],
        exclude = ["tests/gocore/fuel.*"],
    ),
)

# The fuel fixture on its own: GoCore runs an unbounded recursion until its
# default fuel (Cli.defaultFuel, what the differential run uses) runs out, which
# alone takes most of a minute. It checks that a run of the full budget ends
# `fuel`, never crashes, so it keeps that budget, in a target of its own.
sh_test(
    name = "gocore_fuel_test",
    srcs = ["gocore_tests.sh"],
    # About 52 s locally, more on a shared CI runner.
    timeout = "long",
    args = [
        "$(rootpath :gocore)",
        "$(rootpath tests/gocore/fuel.json)",
    ],
    data = [
        ":gocore",
        "tests/gocore/fuel.json",
        "tests/gocore/fuel.out",
        "tests/gocore/fuel.outcome",
    ],
)

lean_library(
    name = "galaspec_tests_main",
    srcs = ["tests/GalaTests.lean"],
    strip_prefix = "tests",
    deps = [":galaspec_lib"],
)

lean_binary(
    name = "galaspec_tests_bin",
    deps = [":galaspec_tests_main"],
)

# `lake exe galaspec-tests`: runs the Core JSON fixtures in tests/. The binary
# reads them from ./tests, so the wrapper runs it from formal/ in the runfiles
# tree (which needs --enable_runfiles, set in //.bazelrc; tests/GalaTests.lean
# takes no fixture directory). It depends on a Lean target, so it is skipped
# without --config=formal too.
sh_test(
    name = "galaspec_tests",
    srcs = ["galaspec_tests.sh"],
    args = ["$(rootpath :galaspec_tests_bin)"],
    data = [":galaspec_tests_bin"] + glob([
        "tests/*.json",
        "tests/*.out",
        "tests/*.outcome",
    ]),
)

# gala2lean (internal/formal/gala2lean): the prelude every translated program
# imports, and the translation Gala/Gala2Lean/Theorems.lean proves things
# about, which a test there keeps equal to the translator's output; and the
# decoder, whose Go standard-library import list a test keeps equal to
# gala2lean's, and GoCore's initialization, whose list of quiet packages it
# keeps equal to the same list.
exports_files(
    [
        "Gala/Gala2Lean/Prelude.lean",
        "Gala/Gala2Lean/Examples/Match.lean",
        "Gala/GoCore/Run.lean",
        "Gala/Json.lean",
    ],
    visibility = ["//internal/formal:__subpackages__"],
)

# GoCore's fixtures, sources and documents, which a gocoreexport test keeps
# equal to what the exporter writes for the sources.
filegroup(
    name = "gocore_fixtures",
    srcs = glob([
        "tests/gocore/src/*.go",
        "tests/gocore/*.json",
    ]),
    visibility = ["//internal/formal:__subpackages__"],
)

# The galaspec fixtures' GALA sources and expected output, which gala2lean's
# tests run through the translation too.
filegroup(
    name = "fixture_sources",
    srcs = glob([
        "tests/src/*.gala",
        "tests/*.out",
        "tests/*.outcome",
    ]),
    visibility = ["//internal/formal:__subpackages__"],
)

# The toolchain's `lean`, for tests that elaborate and run the Lean gala2lean
# writes. Like every Lean target, only under --config=formal.
lean_runtime(
    name = "lean_runtime",
    visibility = ["//internal/formal:__subpackages__"],
)
