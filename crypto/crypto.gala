package crypto

import (
    "crypto/hmac"
    "crypto/md5"
    "crypto/rand"
    "crypto/sha1"
    "crypto/sha256"
    "crypto/sha512"
    "crypto/subtle"
    "encoding/base64"
    "encoding/hex"
    "errors"
    "hash"
    . "martianoff/gala/std"
    "martianoff/gala/go_interop"
)

// Bytes is an opaque, immutable byte container.
// The internal `data` field is unexported; the public surface accepts and
// returns only Bytes / string / int / bool / Try / Option values.
type Bytes struct {
    data []byte
}

// HashAlgo selects the hash algorithm used by Bytes.Hash and Hmac.
sealed type HashAlgo {
    case AlgoSha256()
    case AlgoSha512()
    // Legacy. Cryptographically broken — do not use for new code.
    case AlgoSha1()
    // Legacy. Cryptographically broken — do not use for new code.
    case AlgoMd5()
}

// Construction

func BytesEmpty() Bytes = Bytes(data = go_interop.SliceEmpty[byte]())

func BytesFromString(s string) Bytes = Bytes(data = go_interop.ToBytes(s))

func BytesFromHex(s string) Try[Bytes] {
    val decoded, err = hex.DecodeString(s)
    if err != nil {
        return Failure[Bytes](err)
    }
    return Success[Bytes](Bytes(data = decoded))
}

func BytesFromBase64(s string) Try[Bytes] {
    val decoded, err = base64.StdEncoding.DecodeString(s)
    if err != nil {
        return Failure[Bytes](err)
    }
    return Success[Bytes](Bytes(data = decoded))
}

func BytesFromBase64Url(s string) Try[Bytes] {
    val decoded, err = base64.URLEncoding.DecodeString(s)
    if err != nil {
        return Failure[Bytes](err)
    }
    return Success[Bytes](Bytes(data = decoded))
}

// Querying

func (b Bytes) Length() int = len(b.data)

func (b Bytes) IsEmpty() bool = len(b.data) == 0

// Equal is auto-generated by the transpiler (deep equality on data).

// ConstEqual returns true iff b and other are byte-identical, in
// constant time relative to length. Returns false on length mismatch
// (subtle.ConstantTimeCompare contract).
func (b Bytes) ConstEqual(other Bytes) bool = subtle.ConstantTimeCompare(b.data, other.data) == 1

func (b Bytes) Concat(other Bytes) Bytes {
    val copied = go_interop.SliceCopy(b.data)
    return Bytes(data = go_interop.SliceAppendAll(copied, other.data))
}

// Xor returns the elementwise XOR of b and other. Fails when lengths differ.
func (b Bytes) Xor(other Bytes) Try[Bytes] {
    if b.Length() != other.Length() {
        return Failure[Bytes](errors.New("crypto: Xor length mismatch"))
    }
    var out = go_interop.SliceWithSize[byte](b.Length())
    var i = 0
    for ; i < b.Length() ; {
        out[i] = b.data[i] ^ other.data[i]
        i = i + 1
    }
    return Success[Bytes](Bytes(data = out))
}

// Encoding

func (b Bytes) Hex() string = hex.EncodeToString(b.data)

func (b Bytes) Base64() string = base64.StdEncoding.EncodeToString(b.data)

func (b Bytes) Base64Url() string = base64.URLEncoding.EncodeToString(b.data)

func (b Bytes) ToString() string = string(b.data)

func (b Bytes) String() string {
    val n = b.Length()
    if n <= 8 {
        return s"Bytes(hex=${b.Hex()}, len=$n)"
    }
    val full = b.Hex()
    return s"Bytes(hex=${full[:16]}..., len=$n)"
}

// newHasher returns a fresh hash.Hash for the given algorithm.
func newHasher(algo HashAlgo) hash.Hash = algo match {
    case AlgoSha256() => sha256.New()
    case AlgoSha512() => sha512.New()
    case AlgoSha1()   => sha1.New()
    case AlgoMd5()    => md5.New()
}

// hasherCtor returns a constructor function for the given algorithm.
// Used by hmac.New, which needs a fresh hash.Hash per HMAC operation.
func hasherCtor(algo HashAlgo) func() hash.Hash = algo match {
    case AlgoSha256() => sha256.New
    case AlgoSha512() => sha512.New
    case AlgoSha1()   => sha1.New
    case AlgoMd5()    => md5.New
}

// Hash applies the selected algorithm to the bytes.
func (b Bytes) Hash(algo HashAlgo) Bytes {
    val h = newHasher(algo)
    h.Write(b.data)
    return Bytes(data = h.Sum(nil))
}

func Sha256(b Bytes) Bytes = b.Hash(AlgoSha256())
func Sha512(b Bytes) Bytes = b.Hash(AlgoSha512())
// Legacy. Cryptographically broken — do not use for new code.
func Sha1(b Bytes) Bytes   = b.Hash(AlgoSha1())
// Legacy. Cryptographically broken — do not use for new code.
func Md5(b Bytes) Bytes    = b.Hash(AlgoMd5())

// HMAC

func Hmac(algo HashAlgo, key Bytes, msg Bytes) Bytes {
    val h = hmac.New(hasherCtor(algo), key.data)
    h.Write(msg.data)
    return Bytes(data = h.Sum(nil))
}

func HmacSha256(key Bytes, msg Bytes) Bytes = Hmac(AlgoSha256(), key, msg)
func HmacSha512(key Bytes, msg Bytes) Bytes = Hmac(AlgoSha512(), key, msg)

// Streaming Hasher — incremental hashing without materializing the full
// input as a single Bytes. Build with NewHasher, feed via Update (chainable),
// finalize with Finalize.
type Hasher struct {
    h hash.Hash
}

func NewHasher(algo HashAlgo) Hasher = Hasher(h = newHasher(algo))

func (hr Hasher) Update(b Bytes) Hasher {
    hr.h.Write(b.data)
    return hr
}

func (hr Hasher) Finalize() Bytes = Bytes(data = hr.h.Sum(nil))

// CSPRNG

func RandomBytes(n int) Try[Bytes] {
    if n < 0 {
        return Failure[Bytes](errors.New("crypto: negative byte count"))
    }
    var buf = go_interop.SliceWithSize[byte](n)
    val _, err = rand.Read(buf)
    if err != nil {
        return Failure[Bytes](err)
    }
    return Success[Bytes](Bytes(data = buf))
}
